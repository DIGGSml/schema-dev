<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.0.0">

    <!-- Uncomment to clear validation errors without a master file -->
    <include schemaLocation="../Diggs.xsd"/>


    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/1999/xlink" schemaLocation="xlinks.xsd"/>

    <element name="RIFoundationSystem" type="diggs:RIFoundationSystemType"
        substitutionGroup="diggs:AbstractPlanarSamplingFeature">
        <annotation>
            <documentation>A top-level, complex sampling feature describing the components of a rigid inclusion foundation system. It consists of child sampling features describing the load transfer platforms and individual rigid inclusion columns constructed within the soil below the LTP. Each of these sampling features can be individually referenced by observations, measurements and construction activities.</documentation>
        </annotation>
    </element>
    <complexType name="RIFoundationSystemType">
        <complexContent>
            <extension base="diggs:AbstractPlanarSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The date range spanning construction of the foundation system (MC's and LTP's.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string"/>
                    <element minOccurs="0" name="totalArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>The total area of the site occupying the RI Foundation System. This should correspont to the area of the featureExten property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="workingPlatformLevel" type="diggs:ElevationType">
                        <annotation>
                            <documentation>The elevation of the temporary, heavy-duty layer of compacted granular material installed across the site before ground improvement begins.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="workingPlatformBearingCapacity"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The design bearing capacity of the working platform, sufficient to handle expected track pressures of the drilling rigs, grout pumps, and support equipment used to install the rigid inclusions. Is this actually a measured value or a design specification for the working platform? If design, then probably should be placed in program element somewhere.
</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averageExistingGL" type="diggs:ElevationType">
                        <annotation>
                            <documentation>The average elevation of the existing ground level below the working platform.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="averageWTLevel"
                        type="diggs:ElevationType">
                        <annotation>
                            <documentation>The average elevation of the water table beneath the site.</documentation>
                        </annotation>
                    </element>
                    <element name="loadTransferPlatforms" type="diggs:LTPArrayPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LTPArrayPropertyType">
        <sequence minOccurs="1" maxOccurs="unbounded">
            <element ref="diggs:LoadTransferPlatform"/>
        </sequence>
    </complexType>
    <element name="LoadTransferPlatform" type="diggs:LoadTransferPlatformType"/>
    <complexType name="LoadTransferPlatformType">
        <complexContent>
            <extension base="diggs:AbstractPlanarSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Time during which the LTP was constructed.
</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>The total area of the LTP.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>Contains a Specification object that is used to describe the method of LTP construction.
</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEquipment"
                        type="diggs:EquipmentPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Time during which the LTP was constructed.
</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="materialType" type="diggs:LithologyPropertyType"/>
                    <element minOccurs="0" name="elevationTopLTP" type="diggs:ElevationType">
                        <annotation>
                            <documentation>The elevation of the top of the load transfer platform</documentation>
                        </annotation>
                    </element>
                    <element name="impliedLTPThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The thickness of the load transfer platform, inferred from the LTP top and workding platform elevations.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="geosynthetics"
                        type="diggs:GeosyntheticArrayPropertyType">
                        <annotation>
                            <documentation>A property that holds the Geosyntheic objects installed within this LTP.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="rigidInclusions"
                        type="diggs:RIArrayPropertyType">
                        <annotation>
                            <documentation>A property that holds the rigid inclusions (CMC) that underlie this LTP</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Geosynthetic" type="diggs:GeosyntheticType"/>
    <complexType name="GeosyntheticType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>Identifies the type of geosynthetic used, for example, "geotextile", "geogrid", "geomembrane", etc. Intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="heightAboveWorkingPlatform"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The measured height of the geosynthetic above the working platform.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="elevation" type="diggs:ElevationType">
                        <annotation>
                            <documentation>The elevation of the geosynthetic within the LTP. Use srsName to specify absolute vertical CRS and/or datumReference to specify local datum type.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extent" type="diggs:PlanarSurfacePropertyType">
                        <annotation>
                            <documentation>A planar surface (polygon) whose geospatial coordinates mark the lateral extent of the geosynthetic within the LTP. If this element is not present, it is assumeed that the geosynthetic extends across the entire LTP.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GeosyntheticArrayPropertyType">
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:Geosynthetic"/>
        </sequence>
    </complexType>
    <element name="CMCSubmittedDesign" type="diggs:CMCArrayType"/>
    <element name="RigidInclusion" type="diggs:RigidInclusionType">
        <annotation>
            <documentation>A sampling feature describing the location and properties of a single rigid inclusion element (CMC).</documentation>
        </annotation>
    </element>
    <complexType name="RigidInclusionType">
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="columnType" type="gml:CodeType"/>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time when the hole is constructed. This
                                should include the entire time the drill rig is on
                                site.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionMethod"
                        type="diggs:RIConstructionMethodPropertyType">
                        <annotation>
                            <documentation>Information regarding construction of the rigid inclusion over
                                different depth and/or time 
                               intervals</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionEvent"
                        type="diggs:RIEventPropertyType">
                        <annotation>
                            <documentation>Information about events recorded during construction of
                                the rigid inclusion.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="columnLength" type="diggs:LengthMeasureType"/>
                    <element minOccurs="0" name="columnDiameter" type="diggs:LengthMeasureType"/>
                    <element minOccurs="0" name="theoreticalGroutVolume"
                        type="diggs:VolumeMeasureType"/>
                    <element minOccurs="0" name="placedGroutVolume" type="diggs:VolumeMeasureType"/>
                    <element minOccurs="0" name="cutoffMethod"
                        type="diggs:SpecificationPropertyType"/>
                    <element minOccurs="0" name="columnCapheadPresent" type="boolean"/>
                    <element minOccurs="0" name="meetsVerticality" type="boolean">
                        <annotation>
                            <documentation>True when verticality of the rigid inclusion meets specified verticality tolerances. Such tolerances should be specified in the ColumnSpec object of RIDesignSpec.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="waterStrike"
                        type="diggs:WaterStrikePropertyType">
                        <annotation>
                            <documentation>Information on when ground water is struck during
                                drilling of the hole.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="RIArrayPropertyType">
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:RigidInclusion"/>
        </sequence>
    </complexType>
    <complexType name="RIConstructionMethodType">
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The location within the sampling feature that corresponds
                                to the particular construction method being referenced here. If
                                omitted, it is assumed that the procedures specified apply to the
                                entire extent of the sampling feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time during which the construction event is
                                occurring</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeStability" type="string">
                        <annotation>
                            <documentation>Uncontrolled string describing stability conditions of
                                the hole during this interval</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>Contains a Specification object that may be used to
                                describe any details regarding the method of construction. It should
                                not be used to simply provide a name for the construction method.
                                That value should be entered in the gml:name property for this
                                object.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>A property element that contains an Equipment feature (or
                                reference to one) that details the construction equipment
                                used.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cuttingToolInfo"
                        type="diggs:CuttingToolArrayPropertyType">
                        <annotation>
                            <documentation>The cutting tool info property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="drillPipeInfo"
                        type="diggs:DrillPipeArrayPropertyType">
                        <annotation>
                            <documentation>The drill pipe info property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydraulicFluidFlowRate"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>The flow rate of the hydraulic fluid.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:groutRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RIConstructionMethod" type="diggs:RIConstructionMethodType"/>
    <complexType name="RIConstructionMethodPropertyType">
        <sequence minOccurs="0" maxOccurs="1">
            <element ref="diggs:RIConstructionMethod"/>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="RIEvent" type="diggs:RIEventType"/>
    <complexType name="RIEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="riDepth" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured Depth to the base of the rigid inclusion at this event time,
                                reported in the RI's linear referencing system.</documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element minOccurs="0" name="depthToWater"
                            type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>Depth to Water Surface as measured at this event
                                    time, recorded in the hole's linear referencing
                                    system.</documentation>
                            </annotation>
                        </element>
                        <element fixed="true" minOccurs="0" name="isDry" type="boolean">
                            <annotation>
                                <documentation>Indicates whether dry.</documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="RIEventPropertyType">
        <sequence minOccurs="0" maxOccurs="1">
            <element ref="diggs:RIEvent"/>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <complexType name="CMCArrayType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="columnIds" type="gml:NCNameList">
                        <annotation>
                            <documentation>A list of id's for te columns in this zone. The id's must conform with XML NCName convention.Values for any columns in this list that have a discrete RigidInclusion object defined, should match the gml:id of the corresponding RigidInclusion.</documentation>
                        </annotation>
                    </element>
                    <element name="columnTopLocations" type="diggs:MultiPointPropertyType">
                        <annotation>
                            <documentation>A list of coordinates, within a geospatial CRS (2D or 3D), that defines the locations of the top of the columns installed in this zone. For 3D coordinates, the height coordinate shall correspond to the cutoff elevation for the column. The order of coordinate tuples must follow the order of columnids to allow for location/id assignment.</documentation>
                        </annotation>
                    </element>
                    <element name="columnLengths" type="diggs:LengthDoubleListMeasureType"/>
                    <element minOccurs="0" name="placedGroutVolumes"
                        type="diggs:VolumeDoubleListMeasureType"/>
                    <element minOccurs="0" name="columnDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Could be converted to an enum type with the following enumerations:
1) simple bored
2) bored with casing
3) bored with slurry
4) continuous flight hollow auger
5) micropile
6) cast-in-place, vibro-driven
7) cast=in-place, driven
8) prefabricated, vibro-driven
9) prefabricated, driven
10) soil mixin11)
11) jet grouting</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="columnType" type="gml:CodeType"/>
                    <element minOccurs="0" name="installationType" type="gml:CodeType">
                        <annotation>
                            <documentation>Could be converted to an enum type with the following enumerations:
1) simple bored
2) bored with casing
3) bored with slurry
4) continuous flight hollow auger
5) micropile
6) cast-in-place, vibro-driven
7) cast=in-place, driven
8) prefabricated, vibro-driven
9) prefabricated, driven
10) soil mixin11)
11) jet grouting</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="installationEquipment"
                        type="diggs:EquipmentPropertyType"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="cuttingEquipment"
                        type="diggs:EquipmentPropertyType"/>
                    <element minOccurs="0" name="cutoffMethod"
                        type="diggs:SpecificationPropertyType"/>
                    <element minOccurs="0" name="columnCapheadPresent" type="boolean"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CMCArrayPropertyType">
        <sequence>
            <element ref="diggs:CMCSubmittedDesign"/>
        </sequence>
    </complexType>
    <element name="CMCConstructionActivity" type="diggs:CMCConstructionActivityType"/>
    <complexType name="CMCConstructionActivityType">
        <complexContent>
            <extension base="diggs:AbstractConstructionActivityType">
                <sequence>
                    <element minOccurs="0" name="torqueApplied"
                        type="diggs:MomentOfForceMeasureType"/>
                    <element minOccurs="0" name="penetrationPerRevolution"
                        type="diggs:LengthMeasureType"/>
                    <element minOccurs="0" name="penetrationRate"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>The rate that the drill is advanced into the ground; also known as driliing speed.
</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="withdrawalRate"
                        type="diggs:LengthPerTimeMeasureType"/>
                    <element minOccurs="0" name="rotationSpeeed"
                        type="diggs:AngularVelocityMeasureType"/>
                    <element minOccurs="0" name="groutPressure" type="diggs:PressureMeasureType"/>
                    <element minOccurs="0" name="groutFlowRate"
                        type="diggs:VolumePerTimeMeasureType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RigidInclusionProgram" substitutionGroup="diggs:AbstractProgram"
        type="diggs:RigidInclusionProgramType"/>
    <complexType name="RigidInclusionProgramType">
        <complexContent>
            <extension base="diggs:AbstractProgramType">
                <sequence>
                    <element minOccurs="0" name="explorationPhaseDesign"/>
                    <element minOccurs="0" name="riPerformanceSpec"/>
                    <element minOccurs="0" name="riFeasibility"/>
                    <element minOccurs="0" name="riConcept"/>
                    <element minOccurs="0" name="riDesignSpec"/>
                    <element minOccurs="0" name="riSystemDesign"
                        type="diggs:RISystemDesignPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RISystemDesign" type="diggs:RISystemDesignType"/>
    <complexType name="RISystemDesignType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="columnDesign"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="groutDesign"
                        type="diggs:GroutingProgramDesignPropertyType"/>
                    <element minOccurs="0" name="ltpDesign"/>
                    <element minOccurs="0" name="predictedPerformance"/>
                    <element minOccurs="0" name="globalStability"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="RISystemDesignPropertyType">
        <sequence>
            <element ref="diggs:RISystemDesign"/>
        </sequence>
    </complexType>
</schema>
