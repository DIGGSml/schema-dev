            <sequence>
                <annotation>
                    <appinfo>
                        <diggs:deprecated since="3.1.0" replacedBy="diggs:PressureFlowCurveData" note="the other branch of this choice"/>
                    </appinfo>
                    <documentation>DEPRECATED. Use the PressureFlowCurveData branch of this choice.
                        Pressure-flow curve data given as units followed by index, pressure and
                        flow-rate values.</documentation>
                </annotation>
                <element name="pressureUOM" type="diggs:PressureUomEnumType">
                    <annotation>
                        <documentation>The UOM symbol for the pressure measurements that make up
                                the data of the pressure-flow rate curve</documentation>
                    </annotation>
                </element>
                <element name="flowRateUOM" type="diggs:VolumePerTimeUomEnumType">
                    <annotation>
                        <documentation>The UOM symbol for the flow rate measurements that make
                                up the data of the pressure-flow rate curve</documentation>
                    </annotation>
                </element>
                <sequence maxOccurs="unbounded" minOccurs="2">
                    <element name="index" type="positiveInteger">
                        <annotation>
                            <documentation>The index property.</documentation>
                        </annotation>
                    </element>
                    <element name="measuredPressure" type="double">
                        <annotation>
                            <documentation>The measured pressure property.</documentation>
                        </annotation>
                    </element>
                    <element name="measuredFlowRate" type="double">
                        <annotation>
                            <documentation>The measured flow rate property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </sequence>
            <sequence maxOccurs="unbounded" minOccurs="2">
                <element ref="diggs:PressureFlowCurveData"/>
            </sequence>
        </choice>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <element name="PressureFlowCurveData" type="diggs:PressureFlowCurveDataType"/>
    <complexType name="PressureFlowCurveDataType">
        <annotation>
            <documentation/>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="index" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>The index property.</documentation>
                        </annotation>
                    </element>
                    <element name="measuredPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The measured pressure property.</documentation>
                        </annotation>
                    </element>
                    <element name="measuredFlowRate" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>The measured flow rate property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroutTrenchCutoffWallType">
        <annotation>
            <documentation>Extended type based on AbstractLinearSamplingFeatureType. Adds elements for grout trench cutoff wall type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Time ot time interval during when the feature was constructed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cutoffWallWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The width of the trench cutoff wall - this is typically
                                the same as the thickness of the cutting tool or backhoe
                                shovel</documentation>
                        </annotation>
                    </element>
                    <element name="wallSectionDepths"
                        type="diggs:WallSectionDepthsArrayPropertyType">
                        <annotation>
                            <documentation>The wall section depths property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="GroutTrenchCutoffWall" substitutionGroup="diggs:AbstractLinearSamplingFeature"
        type="diggs:GroutTrenchCutoffWallType">
        <annotation>
            <documentation>The grout trench cutoff wall property.</documentation>
        </annotation>
    </element>
    <complexType name="WallSectionDepthsArrayPropertyType">
        <annotation>
            <documentation>Property type for wall section depths array references. Used to wrap wall section depths array objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:CutoffWallSectionDepth"/>
        </sequence>
    </complexType>
    <element name="CutoffWallSectionDepth" type="diggs:CutoffWallSectionDepthType">
        <annotation>
            <documentation>The cutoff wall section depth property.</documentation>
        </annotation>
    </element>
    <complexType name="CutoffWallSectionDepthType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectBaseType. Adds elements for cutoff wall section depth type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="sectionLocation" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>The section location property.</documentation>
                        </annotation>
                    </element>
                    <element name="wallDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The wall depth property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CutterSoilMixingToolType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for cutter soil mixing tool type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="diameterCuttingWheels"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>External diameter of each of the cutting
                                wheels</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="panelLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length (long dimension) of the soil panel cut by the deep
                                soil mixing tool</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="panelWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Width (short dimension) of the soil panel cut by the deep
                                soil mixing tool</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="CutterSoilMixingTool" type="diggs:CutterSoilMixingToolType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>The cutter soil mixing tool property.</documentation>
        </annotation>
    </element>
    <complexType name="DeepSoilMixingToolType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for deep soil mixing tool type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="diameterMixingBlades"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>External diameter of each of the cutting
                                wheels</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberBladesPerShaft" type="positiveInteger">
                        <annotation>
                            <documentation>The total number of blades on each deep mixing tool
                                shaft</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberShafts" type="positiveInteger">
                        <annotation>
                            <documentation>The total number of shafts on the deep mixing
                                tool</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixingToolHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Height of the tool, eg. the length of the mixing tool
                                shaft(s)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="panelLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length (long dimension) of the soil panel cut by the deep
                                soil mixing tool</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="panelWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Width (short dimension) of the soil panel cut by the deep
                                soil mixing tool</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DeepSoilMixingTool" type="diggs:DeepSoilMixingToolType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>The deep soil mixing tool property.</documentation>
        </annotation>
    </element>
    <element name="GroutSpecimenConditions" type="diggs:GroutSpecimenConditionsType">
        <annotation>
            <documentation>An object that describes the measured physical condition of a
                diggs:GroutSpecimen before testing.</documentation>
        </annotation>
    </element>
    <complexType name="GroutSpecimenConditionsType">
        <annotation>
            <documentation>Type for diggs:GroutSpecimenConditions.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" nillable="false"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Date and (optionally) time or interval of time during
                                which this specimen condition evaluation was made.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bulkUnitWeight"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>Initial bulk density or unit weight</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenPlumb" type="boolean">
                        <annotation>
                            <documentation>If true, specimen formed in mold has vertical and/or
                                horizontal sides. Any slumping of specimen after extracting from
                                mold should have this property set as false.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dimensionMeasurementTechnique"
                        type="diggs:DimensionMeasurementTechniqueType">
                        <annotation>
                            <documentation>Technique used to measure specimen lengths and diameters.
                                Enumerated list. - 1) Calipers, 2) PI-tape, 3) Other: (uncontrolled
                                string after colon)</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element minOccurs="0" name="diameter" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>For cylindrical specimens, a measure of the
                                    cylinder's diameter</documentation>
                            </annotation>
                        </element>
                        <sequence minOccurs="0">
                            <element minOccurs="0" name="length" type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>A measure of one of the cross-sectional, or
                                        horizontal, dimensions of the prepared
                                        sample.</documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="width" type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>A measure of the other of the cross-sectional, or
                                        horizontal, dimensions of the prepared
                                        sample</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="height" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The vertical dimension of the specimen</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shape" type="diggs:SpecimenShapeType">
                        <annotation>
                            <documentation>The shape of the specimen being tested, defined by the
                                following controlled terms: 1) cylinder; 2) cube 3) cuboid - a
                                square cylinder or cube with uneven sides; 4) non-solid - sample is
                                a paste, liquid, or gas with no defined shape; 5)
                                sphere</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>The total surface area of the specimen, computed in
                                various ways dependent on specimen shape.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="temperature"
                        type="diggs:TemperatureMeasurementPropertyType">
                        <annotation>
                            <documentation>Temperature of the specimen, stored in the
                                TemperatureMeasurement object with optional dateTime that identifies
                                specific time instant for the measurement. Multiple temperature
                                measurements are permitted.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The volume of the specimen.</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="wetWeight" type="diggs:ForceMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:wetMass"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use wetMass; only one of the two may be
                                    given. The weight of the specimen prior to
                                    drying.</documentation>
                            </annotation>
                        </element>
                        <element name="wetMass" type="diggs:MassMeasureType">
                            <annotation>
                                <documentation>The mass of the specimen before testing, with any
                                    surface moisture removed. Only one of this and wetWeight may be
                                    given.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="wtBleedWater" type="diggs:ForceMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:bleedWaterMass"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use bleedWaterMass; only one of the two
                                    may be given. The weight of bleed water that occurs during
                                    curing.</documentation>
                            </annotation>
                        </element>
                        <element name="bleedWaterMass" type="diggs:MassMeasureType">
                            <annotation>
                                <documentation>The mass of bleed water that occurs during curing,
                                    generally determined by weighing the specimen before and after
                                    draining the bleed water off the sample. Only one of this and
                                    wtBleedWater may be given.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="crossSectionalArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>Cross-sectional area of the specimen on which the load
                                acts. May be computed from the average of diameters measured on
                                this specimen, or on a group of specimens from the same mold
                                lot.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="heightDiameterRatio" type="double">
                        <annotation>
                            <documentation>For cylindrical specimens, the specimen height divided
                                by the specimen diameter (H/D, also written L/D): the ratio that
                                compressive strength standards use to decide whether a correction
                                to the measured strength applies. To facilitate processing, where
                                relevant, this value should be provided even if the specimen
                                diameter and height are also provided.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bulkDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>Bulk density of the specimen before testing, from its
                                mass and dimensions or by submerged weighing.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dimensionBasis" type="gml:CodeType">
                        <annotation>
                            <documentation>Whether the dimensions recorded are the designated
                                (nominal) size of the mold or specimen, or the actual measured
                                dimensions. Intended to come from a controlled list of
                                terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="moistureConditionAtTest"
                        type="diggs:MoistureConditionAtTestEnumExtType">
                        <annotation>
                            <documentation>Moisture condition of the specimen when tested (e.g.
                                moist, dry, soaked). </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="conditionOnReceipt"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>Defects or damage noted in the specimen, or in its caps,
                                before testing (e.g. damaged, honeycombed). Intended to come from a
                                controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherConditionProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The other condition property property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroutSpecimenConditionsPropertyType">
        <annotation>
            <documentation>Property type for grout specimen conditions references. Used to wrap grout specimen conditions objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:GroutSpecimenConditions"/>
        </sequence>
    </complexType>
    <simpleType name="MoistureConditionAtTestEnumType">
        <annotation>
            <documentation>The moisture condition of a specimen when it is tested.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="moist">
                <annotation>
                    <documentation>Tested in the moist condition: moist-cured specimens are kept moist between
                        removal from moist storage and testing. Source: ASTM C39/C39M-09a 7.1-7.2.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="soaked">
                <annotation>
                    <documentation>Soaked at the time of loading. Source: ASTM C39/C39M-09a Note 11.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="dry">
                <annotation>
                    <documentation>Dry at the time of loading. Source: ASTM C39/C39M-09a Note 11.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="MoistureConditionAtTestEnumExtType">
        <annotation>
            <documentation>One of the values of MoistureConditionAtTestEnumType, or a value outside the list
                stated as "Other: name".</documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:MoistureConditionAtTestEnumType"/>
    </simpleType>
    <simpleType name="SpecimenOriginEnumType">
        <annotation>
            <documentation>How a specimen of manufactured cementitious material was made.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="molded">
                <annotation>
                    <documentation>Molded from fresh material in a mold and cured. Source: ASTM C31/C31M,
                        C192/C192M; EN 12390-2; ISO 1920-3.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="cast in place">
                <annotation>
                    <documentation>Molded in place in a special mold attached to the formwork, so that the
                        specimen cures within the structure. Source: ASTM C873/C873M.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="cored">
                <annotation>
                    <documentation>A core drilled from hardened material. Source: ASTM C42/C42M; EN 12504-1;
                        ISO 1920-6; JIS A 1107.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="sawed">
                <annotation>
                    <documentation>Sawed from hardened material. Source: ASTM C42/C42M; ISO 1920-4.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="SpecimenOriginEnumExtType">
        <annotation>
            <documentation>One of the values of SpecimenOriginEnumType, or a value outside the list stated as
                "Other: name".</documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:SpecimenOriginEnumType"/>
    </simpleType>
</schema>
