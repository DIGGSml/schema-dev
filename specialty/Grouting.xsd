<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">



    <!-- Uncomment to clear validation errors without a master file
    <include schemaLocation="../Diggs.xsd"/>
-->
    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element name="Admixture" type="diggs:GroutComponentCharacteristicsType">
        <annotation>
            <documentation>An object containing properties of the admixture component of a grout
                mix, including the supplier, specific gravity, type, volume, and weight of the
                component used.</documentation>
        </annotation>
    </element>
    <complexType name="AdmixturePropertyType">
        <annotation>
            <documentation>Property type for admixture references. Used to wrap admixture objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Admixture">
                <annotation>
                    <documentation>An object that describes the type, volume, and weight of
                        admixture used in the mix.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <element name="Binder" type="diggs:GroutComponentCharacteristicsType">
        <annotation>
            <documentation>An object containing properties of the binder component of a grout mix,
                including the supplier, specific gravity, type, volume, and weight of the component
                used. Binder here refers to binding components of a grout mix exclusive of cement,
                such as fly ash or lime.</documentation>
        </annotation>
    </element>
    <complexType name="BinderPropertyType">
        <annotation>
            <documentation>Property type for binder references. Used to wrap binder objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Binder">
                <annotation>
                    <documentation>An object that describes the type, volume, and weight of binder
                        used in the mix.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <element name="BleedTest" type="diggs:BleedTestType"
        substitutionGroup="diggs:AbstractMaterialTestProcedure">
        <annotation>
            <documentation>A test to measure the degree to which solid particles from a grout mix
                separates from the fluid, resulting in a layer of clear water at the surface of the
                grout..</documentation>
        </annotation>
    </element>
    <complexType name="BleedTestType">
        <annotation>
            <documentation>Concrete type extending AbstractMaterialTestProcedureType. Provides implementation for bleed test type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractMaterialTestProcedureType"/>
        </complexContent>
    </complexType>
    <element name="Cement" type="diggs:GroutComponentCharacteristicsType">
        <annotation>
            <documentation>An object containing properties of the cement component of a grout mix,
                including the supplier, specific gravity, type, volume, and weight of the component
                used.</documentation>
        </annotation>
    </element>
    <complexType name="CementPropertyType">
        <annotation>
            <documentation>Property type for cement references. Used to wrap cement objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Cement"/>
        </sequence>
    </complexType>
    <element name="Chemical" type="diggs:GroutComponentCharacteristicsType">
        <annotation>
            <documentation>An object that describes the type, volume, and weight of chemical used in
                the mix.</documentation>
        </annotation>
    </element>
    <complexType name="ChemicalPropertyType">
        <annotation>
            <documentation>Property type for chemical references. Used to wrap chemical objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Chemical"/>
        </sequence>
    </complexType>
    <element name="GroutBatchFormulation" type="diggs:GroutBatchFormulationType">
        <annotation>
            <documentation>
                The formulation of a grout batch: the constituents of the mix, the proportions they are
                batched in and the values those proportions were calculated from. A trial batch gives
                the formulation it was made to; a grout mix design gives its own formulation, or cites
                the formulation of the trial batch adopted for the design.
            </documentation>
        </annotation>
    </element>
    <complexType name="GroutBatchFormulationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" name="admixture"
                        type="diggs:AdmixturePropertyType">
                        <annotation>
                            <documentation>
                                An admixture used in the mix. Repeat for each admixture.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="binder"
                        type="diggs:BinderPropertyType">
                        <annotation>
                            <documentation>
                                A binder used in the mix, such as fly ash or lime, excluding cement,
                                which is recorded in cement. Repeat for each binder.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="cement"
                        type="diggs:CementPropertyType">
                        <annotation>
                            <documentation>
                                A cement used in the mix. Repeat for each cement.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="chemical"
                        type="diggs:ChemicalPropertyType">
                        <annotation>
                            <documentation>
                                A chemical used in the mix. Repeat for each chemical.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="filler"
                        type="diggs:FillerPropertyType">
                        <annotation>
                            <documentation>
                                A filler used in the mix. Aggregate is a filler, as is the soil in a
                                soil-cement mixture used to determine the appropriate slurry-soil mixes
                                for deep soil mixing. Repeat for each filler.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityWater"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>
                                The specific gravity of water used for the mix proportions, whether
                                assumed or measured.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="theoreticalYield" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of grout the mix formula yields. Contrast
                                diggs:TrialGroutBatchType/totalBatchVolume, the volume actually
                                produced.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="typeMix" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of grout mix, for example cement, chemical or soil-cement. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volumeWater" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of water in the mix.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterCementRatio"
                        type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The ratio of the mass of water mixed with the cement to the mass of
                                cement. Contrast waterCementRatioOfMix, which counts all the water in
                                the mix.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterCementRatioOfMix"
                        type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The ratio of the mass of all the water in the mix to the mass of cement.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wtCementPerGalH2O"
                        type="diggs:ForcePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The weight of cement used per unit volume of water.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="binderFactor"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The weight of cement divided by the volume of soil in a soil-cement mix.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="binderContent"
                        type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The binder content of mixed soil, equal to the ratio of the dry unit
                                weights of the soil and slurry times the volume ratio.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volumeRatio"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The ratio of the combined volume of cement and water in the cement
                                slurry to the volume of soil in a cement-soil mix.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroutBatchFormulationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:GroutBatchFormulation object inline or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:GroutBatchFormulation"/>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="DesignGroutMix" substitutionGroup="diggs:DesignSample"
        type="diggs:DesignGroutMixType">
        <annotation>
            <documentation>
                The design of a grout mix: its formulation and the design values the grout is to
                achieve. It specializes diggs:DesignSample for a manufactured sample, so the inherited
                sampleScope has no use here and stays absent.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignGroutMixType">
        <complexContent>
            <extension base="diggs:DesignSampleType">
                <sequence>
                    <element minOccurs="0" name="placementDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the general location of the grout mix on the project
                                site.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="formulation"
                        type="diggs:GroutBatchFormulationPropertyType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:GroutBatchFormulation</appinfo>
                            <documentation>
                                The formulation of the grout mix. Give it inline, or refer by xlink:href
                                to the formulation of the trial batch adopted for the design.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bleedDesign"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout bleed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filtrateVolumeDesign"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The design filtrate volume from the pressure filtration test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="gelTimeDesign" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout gel time.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="marshFunnelTimeDesign" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout Marsh funnel time.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="modulusDesign" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The design value for the elastic modulus of the grout or concrete. It is
                                independent of strengthDesign.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mudBalanceDensityDesign"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout unit weight.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureFiltrationCoefficientDesign"
                        type="diggs:ReciprocalSquareRootTimeMeasureType">
                        <annotation>
                            <documentation>
                                The design pressure filtration coefficient from the pressure filtration
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shrinkageDesign"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout shrinkage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="slumpDesign" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout slump.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityMixDesign"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout specific gravity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="strengthDesign" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout unconfined compressive strength.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="syneresisDesign"
                        type="diggs:VolumeOrMassLossMeasureType">
                        <annotation>
                            <documentation>
                                The design value for grout syneresis.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroutingPerformanceSpecificationType">
        <annotation>
            <documentation>Extended type based on AbstractProgramSpecificationType. Adds elements for grouting performance specification type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" name="groutedSoilPermeabilityAverage"
                        type="diggs:PermeabilityRockMeasureType">
                        <annotation>
                            <documentation>Minimum average permeability allowable for all post-grout
                                tests.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilPermeability90Percent"
                        type="diggs:PermeabilityRockMeasureType">
                        <annotation>
                            <documentation>The highest permeability limit that 90% of in-situ and/or
                                sample tests must fall at or below.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilPermeabilityMaximum"
                        type="diggs:PermeabilityRockMeasureType">
                        <annotation>
                            <documentation>Maximum allowable permeablilty measured from a sample or
                                in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilUnconfinedCompressiveStrengthAverage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum average strength allowed for all grouted samples
                                or measured in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilUnconfinedCompressiveStrength90Percent"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The minimum strength that 90% of grouted samples or
                                measurements in-situ must fall at or above.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilUnconfinedCompressiveStrengthMinimum"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum allowable strength of grouted samples or
                                measurements in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilConfinedCompressiveStrengthAverage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum average strength allowed for all grouted samples
                                or measured in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilConfinedCompressiveStrength90Percent"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The minimum strength that 90% of grouted samples or
                                measurements in-situ must fall at or above.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilConfinedCompressiveStrengthMinimum"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum allowable strength of grouted samples or
                                measurements in-situ</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilShearStrengthAverage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum average strength allowed for all grouted samples
                                or measured in-situ</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilShearStrength90Percent"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The minimum strength that 90% of grouted samples or
                                measurements in-situ must fall at or above. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilShearStrengthMinimum"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum allowable strength of grouted samples or
                                measurements in-situ</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilCompressibilityAverage"
                        type="diggs:ReciprocalPressureMeasureType">
                        <annotation>
                            <documentation>Maximum average compressibility allowed for all grouted
                                samples or measured in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedCompressibility90Percent"
                        type="diggs:ReciprocalPressureMeasureType">
                        <annotation>
                            <documentation>The maximum compressibility that 90% of grouted samples
                                or measurements in-situ must fall at or below.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilCompressibilityMaximum"
                        type="diggs:ReciprocalPressureMeasureType">
                        <annotation>
                            <documentation>Maximum allowable compressiblity of grouted samples or
                                measurements in-situ</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSPTAverage" type="double">
                        <annotation>
                            <documentation>Minimum average SPT N value allowed for all measurements
                                in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSPT90Percent" type="double">
                        <annotation>
                            <documentation>The minimum SPT N value that 90% of measurements in-situ
                                must meet or exceed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSPTMinimum" type="double">
                        <annotation>
                            <documentation>Minimum allowable SPT N value allowed for all
                                measurements in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilCPTTipAverage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum average CPT tip value allowed where measured
                                in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilCPTTip90Percent"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The minimum CPT tip value that 90% of measurements
                                in-situ must meet or exceed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilCPTTipMinimum"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Minimum allowable CPT tip value measured
                                in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilDensityAverage"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>Minimum average density allowed for all grouted samples
                                or measured in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilDensity90Percent"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>The minimum density that 90% of grouted samples or
                                measurements in-situ must fall at or above.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilDensityMinimum"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>Minimum allowable density of grouted samples or
                                measurements in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSWaveVelocityAverage"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>Minimum average shear wave velocity value allowed where
                                measured in-situ.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSWaveVelocity90Percent"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>The minimum shear wave velocity that 90% of measurements
                                in-situ must meet or exceed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutedSoilSWaveVelocityMinimum"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>Minimum allowable shear wave velocity measured
                                in-situ.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Filler" type="diggs:GroutComponentCharacteristicsType">
        <annotation>
            <documentation>An object containing properties of the filler component of a grout mix,
                including the supplier, specific gravity, type, volume, and weight of the component
                used. Aggregate is a common filler component in grout.</documentation>
        </annotation>
    </element>
    <complexType name="FillerPropertyType">
        <annotation>
            <documentation>Property type for filler references. Used to wrap filler objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Filler"/>
        </sequence>
    </complexType>
    <complexType name="GroutComponentCharacteristicsType">
        <annotation>
            <documentation>Extended type based on AbstractNamedRoleObjectType. Adds elements for grout component characteristics type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" name="specificGravity"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>Specific gravity of grout component </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of grout component; preferably from a controlled
                                list</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>Volume of grout component used</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="weight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Weight of grout component used</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the grout component used. Contrast weight, which states
                                the quantity as a force. Give whichever the batch record reports,
                                or both.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FlowConeTest" type="diggs:FlowConeTestType"
        substitutionGroup="diggs:AbstractMaterialTestProcedure">
        <annotation>
            <documentation>A test that measures the consistency of a grout mixture by measuring the
                amount of time for a fixed volume of grout to move through a flow
                cone.</documentation>
        </annotation>
    </element>
    <complexType name="FlowConeTestType">
        <annotation>
            <documentation>Concrete type extending AbstractMaterialTestProcedureType. Provides implementation for flow cone test type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractMaterialTestProcedureType"/>
        </complexContent>
    </complexType>
    <element name="FlowReading" type="diggs:FlowReadingType">
        <annotation>
            <documentation>An object that carries properties for a flow reading </documentation>
        </annotation>
    </element>
    <complexType name="FlowReadingPropertyType">
        <annotation>
            <documentation>Property type for flow reading references. Used to wrap flow reading objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:FlowReading"/>
        </sequence>
    </complexType>
    <complexType name="FlowReadingType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for flow reading type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" name="time" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>Elapsed time from start of stage</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="flowReading" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The flow reading property.</documentation>
                        </annotation>
                    </element>
                    <element name="gaugePressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The gauge pressure property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroutSpecimenPropertyType">
        <annotation>
            <documentation>Property type for grout specimen references. Used to wrap grout specimen objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:GroutSpecimen"/>
        </sequence>
    </complexType>
    <element abstract="true" name="AbstractTrialGroutBatch" substitutionGroup="diggs:AbstractSample"
        type="diggs:TrialGroutBatchType">
        <annotation>
            <documentation>The abstract trial grout batch property.</documentation>
        </annotation>
    </element>
    <element name="GroutInjectionEquipment" type="diggs:GroutInjectionEquipmentType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>Extends the generic Equipment object to contain properties for tubes,
                lancets or manchettes used in grout injection. .</documentation>
        </annotation>
    </element>
    <complexType name="GroutInjectionEquipmentType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for grout injection equipment type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="lanceOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Outer diameter of lance</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lanceLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length of lance</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="packerSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Distance between packer seals for straddle-type
                                packers</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="packerType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of packers used (eg. slide,inflatable,straddle
                                or single-element, manual). Intended to come from a controlled list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutPipeInnerDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Inner diameter of the grout pipe or packer
                                rod.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="headerRadius" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Radius of curvature of the grout header.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="headerSize" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Size of the grout header. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="riserRadius" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Radius of curvature of the riser.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lengthOfOCSP" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For rock grouting, length of the overburden casing as
                                sleeve pipe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="portSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Distance between ports in manchette or
                                lance.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sealType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of seals used in the packer (eg. hourglass or
                                wirewound). Intended to come from a controlled list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tubeInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Inner diameter of manchette tube</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tubeType" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of manchette or other tube used, eg. standard PVC,
                                recessed rubber PVC, metal, etc. Intended to come from a controlled
                                list.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="GroutPlant" type="diggs:GroutPlantType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>Extends the generic Equipment object to include properties for a grout
                plant - a combined equipment type containing a grout mixer and a grout
                pump.</documentation>
        </annotation>
    </element>
    <complexType name="GroutPlantType">
        <annotation>
            <documentation>Extends property type to include properties for a grout plant - a
                combined equipment type containing a grout mixer and a grout pump.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="mixer" type="diggs:GroutMixerPropertyType">
                        <annotation>
                            <documentation>The mixer property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pump" type="diggs:GroutPumpPropertyType">
                        <annotation>
                            <documentation>The pump property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="GroutBatch" substitutionGroup="diggs:AbstractTrialGroutBatch"
        type="diggs:GroutBatchType">
        <annotation>
            <documentation>A specialization of Sample that contains properties describing the
                characteristics of a batch of grout used for production purposes. This object is
                expected to reference the diggs:DesignGroutMix it was produced to through its
                sampling activity's programDesignRef (diggs:AbstractSamplingActivityType) - a
                batching activity that mixed to more than one design over time is stated as separate
                SamplingActivity instances, one per design, each citing the batches it
                produced.</documentation>
        </annotation>
    </element>
    <complexType name="GroutBatchType">
        <annotation>
            <documentation>Extended type based on TrialGroutBatchType. Adds nothing of its
                own.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:TrialGroutBatchType"/>
        </complexContent>
    </complexType>
    <element name="GroutPump" type="diggs:GroutPumpType" substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>Extends the generic Equipment object to include properties for a grout
                pump.</documentation>
        </annotation>
    </element>
    <complexType name="GroutPumpPropertyType">
        <annotation>
            <documentation>Property type for grout pump references. Used to wrap grout pump objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:GroutPump"/>
        </sequence>
    </complexType>
    <complexType name="GroutPumpType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for grout pump type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="inletPipeSize" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>ID of the inlet pipe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxFlow" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>Rated maximum flow output of the pump</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxGrainsize" type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>Rated maximum grain size for the pump.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Rated maximum pressure for the pump</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberOfPistons" type="positiveInteger">
                        <annotation>
                            <documentation>Number of pistons (for piston pumps)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outletPipeSize" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>ID of the inlet pipe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diameter of piston(s)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonStroke" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Stroke length of piston(s)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cylinderVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The rated cylinder volume, which would equate to the
                                maximum volume of grout pumped per piston stroke.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of pump, ie. piston, plunger, pneumatic, screw, twin
                                stream, rocker, etc. Intended to come from a controlled list of
                                terms</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="enginePower" type="diggs:PowerMeasureType">
                        <annotation>
                            <documentation>The rated power of the grout pump engine.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pumpTransportWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>The rated power of the grout pump engine.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureFlowCurveData"
                        type="diggs:PressureFlowCurveDataArrayPropertyType">
                        <annotation>
                            <documentation>The pressure flow curve data property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="JetGroutingMonitor" type="diggs:JetGroutingMonitorType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>Extends the generic Equipment object to contain properties for a jet
                grouting monitor.</documentation>
        </annotation>
    </element>
    <complexType name="JetGroutingMonitorPropertyType">
        <annotation>
            <documentation>Property type for jet grouting monitor references. Used to wrap jet grouting monitor objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:JetGroutingMonitor"/>
        </sequence>
    </complexType>
    <complexType name="JetGroutingMonitorType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for jet grouting monitor type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="numberOfGroutNozzles" type="positiveInteger">
                        <annotation>
                            <documentation>Number of grout nozzles on the monitor</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="diameterOfGroutNozzles"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diameter of the grout nozzles</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberOfFluid_2Nozzles" type="positiveInteger">
                        <annotation>
                            <documentation>Number of fluid 2 nozzles on the monitor</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element minOccurs="1" name="diameterOfFluid_2Nozzles"
                            type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>Diameter of the fluid 1 nozzles</documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element minOccurs="1" name="innerDiameterOfFluid_2Nozzles"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>Where the fluid nozzle is a shroud around another
                                        nozzle, this value represents the inner diameter of the
                                        shroud (eg. the outer diameter of the interior
                                        nozzle</documentation>
                                </annotation>
                            </element>
                            <element minOccurs="1" name="outerDiameterOfFluid_2Nozzles"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>Where the fluid nozzle is a shroud around another
                                        nozzle, this value represents the outer diameter of the
                                        shroud.</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="numberOfFluid_3Nozzles" type="positiveInteger">
                        <annotation>
                            <documentation>Number of fluid_3 nozzles on the monitor</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element minOccurs="1" name="diameterOfFluid_3Nozzles"
                            type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>Diameter of the fluid 2 nozzles</documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element minOccurs="1" name="innerDiameterOfFluid_3Nozzles"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>Where the fluid nozzle is a shroud around another
                                        nozzle, this value represents the inner diameter of the
                                        shroud (eg. the outer diameter of the interior
                                        nozzle</documentation>
                                </annotation>
                            </element>
                            <element minOccurs="1" name="outerDiameterOfFluid_3Nozzles"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>Where the fluid nozzle is a shroud around another
                                        nozzle, this value represents the outer diameter of the
                                        shroud.</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="xJet" type="boolean">
                        <annotation>
                            <documentation>Value is true if nozzle configuration is angles so that
                                the fluid from the nozzles form an X pattern</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TrialGroutBatch" substitutionGroup="diggs:AbstractTrialGroutBatch"
        type="diggs:TrialGroutBatchType">
        <annotation>
            <documentation>A specialization of Sample that also contains properties describing the
                characteristics of a batch of grout developed for testing to determine a grout
                design mix. </documentation>
        </annotation>
    </element>
    <element name="GroutMixer" type="diggs:GroutMixerType"
        substitutionGroup="diggs:AbstractEquipment">
        <annotation>
            <documentation>Extends the generic Equipment object to contain properties for a grout
                mixer.</documentation>
        </annotation>
    </element>
    <complexType name="GroutMixerPropertyType">
        <annotation>
            <documentation>Property type for grout mixer references. Used to wrap grout mixer objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:GroutMixer">
                <annotation>
                    <documentation>An object with properties othat describes grout mixing
                        equipment.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="GroutMixerType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for grout mixer type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="outletPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Pressure measured at the mixer outlet</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outputRate" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>Rate of output from the mixer
                                (volume/time)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="agitatorVolume" type="diggs:VolumeMeasureType"
                        maxOccurs="1">
                        <annotation>
                            <documentation>Maximum capacity of the agitator.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixerVolume" maxOccurs="unbounded"
                        type="diggs:MixerVolumeMeasureType">
                        <annotation>
                            <documentation>Maximum capacity of the mixer. The optional attribute
                                atSpecificGravity may be used to specify the maximum capacity of the
                                mixer for a particular specific gravity of the grout
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="agitatorSpeed"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>Rotational speed of the agitator</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="impellerSpeed"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>Speed of the mixing impeller</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TrialGroutBatchType">
        <annotation>
            <documentation>
                Type for a batch of grout: its formulation and the properties of the batch as produced.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSampleType">
                <sequence>
                    <element minOccurs="0" name="formulation"
                        type="diggs:GroutBatchFormulationPropertyType">
                        <annotation>
                            <documentation>
                                The formulation the batch was made to. A grout mix design adopting the
                                batch cites this formulation by reference.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityMix"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>
                                The specific gravity of the grout mix as produced.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalBatchVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The total volume of the batch produced.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="binderFactorInPlace"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The weight of cement divided by the volume of the soil-cement mixture,
                                which equals the sum of the volumes of the cement, soil and water.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deliveryToPlacementTime"
                        type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The elapsed time between the batch's delivery to the point of use, for
                                example off a ready-mix truck, and its placement. The transport window
                                governs whether the batch is still placeable.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bindingMaterialContent"
                        type="diggs:MassPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The mass of binding material per unit volume of the batch as produced:
                                the cement plus any binders recorded as binder components (fly ash,
                                slag, silica fume and the like), excluding fillers and admixtures. It is
                                the quantity a minimum binder content requirement is stated against.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterSolubleChlorideContent"
                        type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The water-soluble chloride ion (Cl-) content of the hardened grout or
                                concrete of the batch, as a mass fraction of the cement. It is the
                                chloride that dissolves in water under the conditions of the test (ASTM
                                C1218/C1218M), a different quantity from acidSolubleChlorideContent; a
                                specification may limit them separately. The chloride content of the
                                surrounding soil or groundwater is a separate quantity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="acidSolubleChlorideContent"
                        type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The acid-soluble chloride ion (Cl-) content of the hardened grout or
                                concrete of the batch, as a mass fraction of the cement. It is the
                                chloride that dissolves in acid under the conditions of the test (ASTM
                                C1152/C1152M), which in most concretes approximates the total chloride,
                                a different quantity from waterSolubleChlorideContent; a specification
                                may limit them separately.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="groutRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:GroutBatch</appinfo>
            <appinfo source="urn:x-gml:targetElement">diggs:TrialGroutBatch</appinfo>
            <documentation>A reference to a GroutBatch or TrialGroutBatch feature that is associated with this feature. </documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="GroutSpecimen" substitutionGroup="diggs:AbstractSpecimen"
        type="diggs:GroutSpecimenType">
        <annotation>
            <documentation>A specimen of manufactured cementitious material - concrete, grout, mortar,
                or soil-cement and other cement-stabilized soil - molded, cast, cored or otherwise
                prepared from a sample or batch of that material for testing. Records how the
                specimen was made and cured and, through specimenCondition, its measured physical
                condition before testing.</documentation>
        </annotation>
    </element>
    <complexType name="GroutSpecimenType">
        <annotation>
            <documentation>Type for diggs:GroutSpecimen.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="specimenCondition"
                        type="diggs:GroutSpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>The measured physical condition of the specimen before
                                testing: dimensions, weight or density, temperature and
                                similar.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="componentRef"
                        type="gml:ReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Admixture</appinfo>
                            <appinfo source="urn:x-gml:targetElement">diggs:Binder</appinfo>
                            <appinfo source="urn:x-gml:targetElement">diggs:Cement</appinfo>
                            <appinfo source="urn:x-gml:targetElement">diggs:Chemical</appinfo>
                            <appinfo source="urn:x-gml:targetElement">diggs:Filler</appinfo>
                            <appinfo>diggs:Admixture or diggs:Binder or diggs:Cement or
                                diggs:Chemical or diggs:Filler</appinfo>
                            <documentation>Pointer to the id of the specific grout batch component
                                tested. More than one reference is allowed where more than one
                                component of a specific type is included together in the specimen
                                tested. In this case each componentRef will point to the components
                                used.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="componentType" type="diggs:GroutComponentTypeType">
                        <annotation>
                            <documentation>Where the specimen is a single component of a grout mix
                                rather than the mix itself, the type of component tested: Admixture,
                                Binder, Cement, Chemical or Filler (see the component objects of
                                diggs:GroutBatch), or Other: followed by a description.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="formMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>Material of the mold in which the specimen was formed.
                                Intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="curingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>Duration of curing before the test. Not necessarily the
                                specimen's age at test, which is counted from when water was added to
                                the mix.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutSpecimenExtractionLocation"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>Point in the mixing and delivery process from which the
                                material for the specimen was taken (e.g. mixer, plant, pump, riser).
                                Intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityOfSolids"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>Specific gravity of grout solids (Gs) is the ratio of the
                                density of a substance to the density of a reference substance,
                                usually water at 4 deg C; equivalently, it is the ratio of the mass
                                of a substance to the mass of a reference substance for the same
                                given volume.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ageAtTest" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>Age of the specimen when tested, counted from the time
                                water was added to the mix. Distinct from curingTime, the duration
                                of curing.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="curingMethod"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>How the specimen was cured (e.g. water immersion,
                                humidity chamber, sealed, cured in the field alongside the
                                structure). More than one may be given where the curing changed
                                during the curing period. Intended to come from a controlled list of
                                terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="curingTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>Temperature at which the specimen was cured.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenOrigin"
                        type="diggs:SpecimenOriginEnumExtType">
                        <annotation>
                            <documentation>How the specimen was made: molded from fresh material,
                                cast in place in the structure, cored from hardened material, or
                                sawed. </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="endPreparation"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>Preparation of the loaded end faces before testing (e.g.
                                as molded, sawed, ground, capped, unbonded caps). More than one may
                                be given where the ends were prepared in more than one way.
                                Intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="GroutComponentTypeType">
        <annotation>
            <documentation>Union type for grout component type. Accepts values from OtherNameType or
                GroutComponentTypeEnumType.</documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:GroutComponentTypeEnumType"/>
    </simpleType>
    <simpleType name="GroutComponentTypeEnumType">
        <annotation>
            <documentation>Enumeration of the types of component of a grout mix. Contains 5 allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Admixture">
                <annotation>
                    <documentation>An admixture component of the grout mix.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Binder">
                <annotation>
                    <documentation>A binder component of the grout mix.</documentation>
                </annotation>
            </enumeration>
