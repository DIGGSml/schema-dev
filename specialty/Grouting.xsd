    <element name="LinearGroutingActivity" substitutionGroup="diggs:AbstractConstructionActivity"
        type="diggs:LinearGroutingActivityType">
        <annotation>
            <documentation>A feature that contains properties associated with grouting that occurs
                within a single linear sampling feature, typically a borehole or sounding. A
                grouting activity feature can accommodate all grouting within a sampling feature,
                where the grouting setup is the same for all grout stages. Otherwise, multiple
                grouting actvities can be assigned to a sampling feature to accommodate variations
                in grout setup, equipment, mix types, or where there is significant time between
                various grouting activities.</documentation>
        </annotation>
    </element>
    <complexType name="LinearGroutingActivityType">
        <annotation>
            <documentation>Extended type based on AbstractConstructionActivityType. Adds elements for linear grouting activity type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractConstructionActivityType">
                <sequence>
                    <element minOccurs="1" name="groutingType" type="diggs:GroutingTypesEnumType">
                        <annotation>
                            <documentation>Specifies the grouting treatment solution for this
                                activity. Allowed values are: Compaction - injecting a very stiff
                                homogeneous grout mix under relatively high-pressures and at low
                                injection rates to subsurface locations in pre-designed patterns in
                                order to displace and compact soils. Compensation - also know as
                                fracture grouting, is the injection of a cement slurry grout,
                                hydrofracturing soil, creating lenses. The lenses compact
                                surrounding soil and then lift the overlying soil and structures.
                                Jet - consists of breaking up the soil with a high-pressure jet in a
                                predrilled borehole and mixing the loosened soil with a cement grout
                                alone or mixed with air and/or water. Permeation - Introduction of
                                cement or chemical-based grout into soil pores without an essential
                                change in the original soil volume and structure, changing the
                                support capability of granular soils without disturbing them Rock -
                                the injection of specially formulated cement-based mixes into the
                                ground to improve its strength or reduce permeability.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cavity_depth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For grouting in a borehole, typically done for jet or
                                deep soil mixing, the length of the top of the hole that is
                                pre-drilled out completely to form a cavity to contain the
                                additional volume of soil and grout generated by the activity. For a
                                grout trench cutoff wall, this value is the depth of excavation of
                                the trench made from the surface to contain the additional volume of
                                soil and grout generated by the activity.</documentation>
                        </annotation>
                    </element>
                    <element name="distanceToWater" type="diggs:PointLocationPropertyType"
                        minOccurs="0" form="qualified">
                        <annotation>
                            <documentation>Location of water as measured in the sampling feature's
                                linear reference system</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="geoUnit"
                        type="diggs:GeoUnitObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Property type containing the
                                geologic/geotechnical units or contacts of interest to the grouting
                                activity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutingInterval"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>Total depth interval of the borehole being grouted as
                                measured along borehole centerline.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="overburdenInterval"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>Total interval of overburden measured along borehole
                                centerline.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="overburdenVerticalThickness"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Vertical thickness of overburden (eg. vertical depth to
                                base of overburden).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:groutRef">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:GroutBatch</appinfo>
                            <documentation>A property that references GroutBatch objects that are
                                used within this LinearGroutingActivity</documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element minOccurs="0" name="groutStage" type="diggs:GroutStagePropertyType"
                            maxOccurs="unbounded">
                            <annotation>
                                <documentation>Property type containing information about individual
                                    grout stages </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="continuousGrouting"
                            type="diggs:ContinuousGroutingPropertyType" maxOccurs="1">
                            <annotation>
                                <documentation>Property type containing information about continuous
                                    grouting as part of a jet grouting or deep soil mixing
                                    activity</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="totalGroutVolumeActivity"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The total volume of grout injected by this
                                activity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalGroutVolumeAtFeature"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The total volume of grout injected into the
                                samplingFeature of which this activity is a part. Where there is
                                only one activity in a samplingFeature. this value will equal
                                totalGroutVolumeActivity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wasteVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>An estimate of the volume of spoils (grout and soil
                                waster) produced by the jet or deep soil mixing grouting
                                activity.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
