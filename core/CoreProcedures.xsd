    <simpleType name="SieveProcedureEnumType">
        <restriction base="string">
            <enumeration value="wet">
                <annotation>
                    <documentation>
                        Wet sieving on the No. 40 screen (0.425 mm) was performed.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="dry">
                <annotation>
                    <documentation>
                        Dry sieving on the No. 40 screen (0.425 mm) was performed.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>
                        No sieving was performed: the sample is all finer than 0.425 mm, or the
                        coarser particles were picked out.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="unknown">
                <annotation>
                    <documentation>
                        It is not known whether sieving was performed.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="AtterbergInitialConditionEnumType">
        <union memberTypes="diggs:OtherNameType">
            <simpleType>
                <restriction base="string">
                    <enumeration value="Wet">
                        <annotation>
                            <documentation>
                                The specimen was kept wet.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Dry (air)">
                        <annotation>
                            <documentation>
                                The specimen was air dried.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Dry (oven &lt;60degC)">
                        <annotation>
                            <documentation>
                                The specimen was oven dried at a temperature below 60 degrees C.
                            </documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <annotation>
                    <documentation>
                        Legacy form. Values of the form "other:xx" (lower-case "o", no space) are still accepted;
                        use "Other: xx" instead.
                    </documentation>
                </annotation>
                <restriction base="string">
                    <pattern value="other:\w{2,}"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <element abstract="false" name="ConsolidationIncrement"
        substitutionGroup="diggs:AbstractProcedureTrial" type="diggs:ConsolidationIncrementType">
        <annotation>
            <documentation>
                A single consolidation increment within the consolidation stage of a triaxial test
                procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConsolidationIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ConsolidationIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:ConsolidationIncrement"/>
        </sequence>
    </complexType>
    <complexType name="ConsolidationIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="deformationIndicatorReading"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The reading on the deformation indicator at the beginning of the
                                consolidation increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the start of the consolidation stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="volumeChange" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The change in volume obtained from the volume change device at the
                                observed elapsed time.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="ConsolidationTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure" type="diggs:ConsolidationTestType">
        <annotation>
            <documentation>
                The procedure of a consolidation test, which determines the magnitude and rate of
                volume decrease of a laterally confined soil specimen under different vertical
                pressures. The consolidation curve (pressure-void ratio relationship) from the
                measured data gives the compression index (slope of the virgin curve), the
                recompression index (slope of the recompression curve) and the preconsolidation
                pressure (maximum past pressure), and also the coefficient of consolidation and the
                coefficient of secondary compression.
            </documentation>
        </annotation>
    </element>
    <element abstract="false" name="ConsolidationTestTrial" type="diggs:ConsolidationTestTrialType">
        <annotation>
            <documentation>
                A trial within a consolidation test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConsolidationTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ConsolidationTestTrial object inline. It is
                the required parent element that holds the trials.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:ConsolidationTestTrial"/>
        </sequence>
    </complexType>
    <complexType name="ConsolidationTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element name="trialNo" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:timeInterval"/>
                    <element minOccurs="0" name="averageTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The average temperature over the loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="appliedLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The load applied for this consolidation loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="loadingStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The stress applied for this consolidation loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="consolidationIncrement"
                        type="diggs:CTConsolidationIncrementPropertyType">
                        <annotation>
                            <documentation>
                                The elapsed time and deformation recorded during this loading
                                increment. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="finalaxialDeformation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The normal deformation of the sample at the end of the loading
                                increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="finalStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The loading stress measured at the end of the loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialVoidRatio" type="double">
                        <annotation>
                            <documentation>
                                The initial void ratio.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="finalVoidRatio" type="double">
                        <annotation>
                            <documentation>
                                The final void ratio.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientOfConsolidationLogTime" type="double">
                        <annotation>
                            <documentation>
                                The coefficient of consolidation from the log-time method for this
                                stress increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientOfConsolidationRootTime" type="double">
                        <annotation>
                            <documentation>
                                The coefficient of consolidation from the root-time method for this
                                stress increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientOfConsolidation" type="double">
                        <annotation>
                            <documentation>
                                The coefficient of consolidation for this stress increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientOfSecondaryCompression" type="double">
                        <annotation>
                            <documentation>
                                The coefficient of secondary compression over the stress increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientTertiaryCompression" type="double">
                        <annotation>
                            <documentation>
                                The coefficient of tertiary compression over the stress increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coefficientOfVolumeCompressibility" type="double">
                        <annotation>
                            <documentation>
                                The reported coefficient of volume compressibility over the stress
                                increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ConsolidationTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element default="false" minOccurs="0" name="consolidationTestType"
