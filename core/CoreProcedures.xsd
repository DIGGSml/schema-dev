    <complexType name="ShrinkageLimitTrialType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="trialNo" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterContentWetSoil" type="diggs:WaterContentMeasureType">
                        <annotation>
                            <documentation>
                                The water content of the wet soil paste.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="volumeWetSoil" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the wet soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="volumeDrySoil" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the dry soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="massDrySoil" type="diggs:MassMeasureType">
