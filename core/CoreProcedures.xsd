<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.w3.org/2001/XMLSchema"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element name="DrivenPenetrationTest" type="diggs:DrivenPenetrationTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                The procedure of a driven penetration test: any method that drives a rod, with or
                without a sampler, by impact hammer. The most common tests of this type are the
                Standard Penetration Test and the Becker Hammer Test.
            </documentation>
        </annotation>
    </element>
    <complexType name="DrivenPenetrationTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="penetrationTestType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of penetration test performed, for example Standard
                                Penetration Test or Becker Hammer Test. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of hammer used for the sampling and penetration, including
                                the mechanism that lifts and drops the hammer assembly. Further
                                details of the sampler, such as cathead diameter or number of turns,
                                can be given in the equipment object. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerMass" type="diggs:MassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The mass of the hammer used to drive the sampler.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerDropHeight" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The drop height of the hammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerEfficiency" type="diggs:DimensionlessMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The energy efficiency of the hammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The length of the sampler barrel.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerInternalDiameter" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The inside diameter of the sampler.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerLinerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the liner, if used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerRetainerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the basket retainer, if used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of sampling rods used for penetration. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodExternalDiameter" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The external diameter of the sampling rods.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodSectionLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The length of one section of drive rod.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodWeight" type="diggs:ForcePerLengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The drive rod weight per unit length.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthCasing" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The casing depth at the time of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="selfWeightPenetration" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The distance the sampler penetrates the soil under its own weight
                                before hammer blows are applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to water at the time of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="totalPenetration" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The total distance the sampler penetrated the soil by the end of the
                                procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="driveSet"
                        type="diggs:DriveSetPropertyType">
                        <annotation>
                            <documentation>
                                A drive set of the test. Repeat for each drive set.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DelayEvent" type="diggs:DelayEventType" abstract="false">
        <annotation>
            <documentation>
                A time delay between activities of a driven penetration or vane test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="DelayEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DelayEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DelayEvent" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="DelayEventType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice>
                        <element name="timeOfDelay" type="diggs:TimeIntervalPropertyType"
                            minOccurs="1" maxOccurs="1">
                            <annotation>
                                <documentation>
                                    The time interval of the delay. It needs an absolute start time
                                    for the delay and either an end time or a duration.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="delayDuration" type="diggs:TimeMeasureType">
                            <annotation>
                                <documentation>
                                    The duration of the delay.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="delayType" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The type of delay, for example mechanical, operational or
                                soil-response. Use the DIGGS dictionary delayType.xml for the list
                                of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DriveSet" type="diggs:DriveSetType" abstract="false">
        <annotation>
            <documentation>
                The blow counts for tests where samplers or instruments are driven by impact
                methods.
            </documentation>
        </annotation>
    </element>
    <complexType name="DriveSetType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="remark"
                        type="diggs:RemarkPropertyType">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="index" type="positiveInteger">
                        <annotation>
                            <documentation>
                                An integer that gives the position of the drive set in the test: the
                                first, seating drive has index 1, the next drive set index 2, and so
                                on. Use index 1 only for the seating drive.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="blowCount" type="nonNegativeInteger">
                        <annotation>
                            <documentation>
                                The number of hammer blows in this drive set.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="penetration" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance the sampler is driven into the soil in this drive set.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="delay" type="diggs:DelayEventPropertyType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The delay before the increment started.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="torque" type="diggs:MomentOfForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The maximum torque required to rotate the rods.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DriveSetPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DriveSet object inline. It satisfies the GML
                object-property rule when diggs:DriveSet is used as an element in another test.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DriveSet" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="InsituDensityTest" type="diggs:InsituTestProcedureType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                The procedure to determine the in-place density and unit weight of soils using a
                sand cone apparatus.
            </documentation>
        </annotation>
    </element>
    <element name="MWDProcedure" type="diggs:MWDProcedureType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                The procedure object of a diggs:MeasurementWhileDrilling measurement.
            </documentation>
        </annotation>
    </element>
    <complexType name="MWDProcedureType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="dataCaptureSoftware"
                        type="diggs:SoftwareApplicationPropertyType">
                        <annotation>
                            <documentation>
                                The software that captured the data.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MWDProcedurePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MWDProcedure object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:MWDProcedure"/>
        </sequence>
    </complexType>
    <element name="PorePressureDissipationTest" type="diggs:PorePressureDissipationTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure" abstract="false">
        <annotation>
            <documentation>
                The procedure of a pore pressure dissipation test. The test occurs as part of a
                static cone penetration test: the probe stops advancing and the excess pore
                pressures are recorded over time. It measures the equilibrium pore pressure and
                estimates the in situ horizontal coefficient of consolidation (ch) and horizontal
                coefficient of permeability (kh).
            </documentation>
        </annotation>
    </element>
    <complexType name="PorePressureDissipationTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="estimatedIr"
                        type="diggs:PressurePerPressureMeasureType">
                        <annotation>
                            <documentation>
                                The estimated rigidity index used to compute the horizontal
                                coefficient of consolidation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="estimatedU0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The equilibrium pore pressure (u0) estimated before the test, where
                                u0 is not determined directly.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="estimatedU50" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The u50 pore pressure computed from the estimated u0 and the
                                starting pore pressure, used to determine the t50 value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="estimatedWaterDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The estimated depth from land surface to the hydrostatic water
                                table, used to estimate u0.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="dissipationTimeSeries"
                        type="diggs:DissipationTimeSeriesPropertyType">
                        <annotation>
                            <documentation>
                                The pore pressures recorded over time, as a diggs:TemporalResult.
                                Repeat for each series.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DissipationTimeSeriesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemporalResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TemporalResult"/>
        </sequence>
    </complexType>
    <element name="StaticConePenetrationTest" type="diggs:StaticConePenetrationTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                The procedure of an in-situ static cone penetration test, used to determine the
                geotechnical engineering properties of soils and to delineate soil stratigraphy. An
                instrumented cone, tip facing down, is pushed into the ground at a controlled rate.
            </documentation>
        </annotation>
    </element>
    <complexType name="StaticConePenetrationTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="penetrometerType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of static cone penetrometer used. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="distanceTipToSleeve" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance between the tip and the center of the friction sleeve.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="estimatedWaterDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The estimated depth to water from land surface at the time of the
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionReducer" type="string">
                        <annotation>
                            <documentation>
                                A description of the type, size and location of the friction reducer
                                behind the base of the cone, if used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionSleeveArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The surface area of the friction sleeve immediately behind the
                                penetrometer tip.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="netAreaRatioCorrection" type="double">
                        <annotation>
                            <documentation>
                                The correction to the cone resistance for water pressures acting
                                behind the cone tip.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="penetrationRate"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The rate of advance of the penetrometer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="piezoconeType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of piezocone, defined in part by the location of the filter
                                element. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="porePressureElementInfo"
                        type="diggs:PorePressureElementPropertyType">
                        <annotation>
                            <documentation>
                                A pore pressure element of the cone. Repeat for each element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pushRodType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of pushing rods used for penetration. Standard nomenclature
                                such as A-rod or N-rod can be used. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tipCapacity" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The capacity of the tip load cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sleeveCapacity" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The capacity of the sleeve load cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceCapacity" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The capacity of the surface load cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tipApexAngle" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The apex angle of the conical point of the penetrometer tip.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tipArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The conical base area of the penetrometer tip.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PorePressureElement" type="diggs:PorePressureElementType">
        <annotation>
            <documentation>
                The metadata of a pore pressure sensor.
            </documentation>
        </annotation>
    </element>
    <complexType name="PorePressureElementType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="cellId" type="string">
                        <annotation>
                            <documentation>
                                The identifier of the filter element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterElementLocation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The location of the filter element, as the distance from the cone
                                tip.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="poreCapacity"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The capacity of the pore pressure load cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="porousElementType"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of material used as the porous filter element. Typical
                                materials are plastic, sintered bronze, sintered steel and ceramic.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="saturationFluid" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The fluid used to saturate the porous filter element. Typical
                                deaired fluids are water, glycerin and silicon oil. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <choice maxOccurs="1" minOccurs="0">
                        <element minOccurs="0" name="saturationMethod"
                            type="diggs:SpecificationPropertyType">
                            <annotation>
                                <documentation>
                                    A description of the procedure used to saturate the porous
                                    filter element.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="saturationMethodRef"
                            type="diggs:FeatureReferenceType">
                            <annotation>
                                <appinfo>diggs:Specification</appinfo>
                                <documentation>
                                    The saturation method followed. Given by reference only.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PorePressureElementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PorePressureElement object inline. It
                satisfies the GML object-property rule when diggs:PorePressureElement is used as an
                element in another test.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:PorePressureElement"/>
        </sequence>
    </complexType>
    <element name="WaterLevelMonitoring" type="diggs:WaterLevelMonitoringType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                The procedure of monitoring water levels in a piezometer or well, either automated
                with a pressure transducer or other sensor, or manual with a tape or sensor lowered
                down the casing.
            </documentation>
        </annotation>
    </element>
    <complexType name="WaterLevelMonitoringType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="referencePoints" type="diggs:ReferencePointArrayPropertyType">
                        <annotation>
                            <documentation>
                                The reference points from which water levels were measured.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ReferencePointArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:ReferencePoint objects inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:ReferencePoint"/>
        </sequence>
    </complexType>
    <element name="ReferencePoint" type="diggs:ReferencePointType">
        <annotation>
            <documentation>
                A reference point from which water levels were measured.
            </documentation>
        </annotation>
    </element>
    <complexType name="ReferencePointType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element name="time" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The start time, with an optional end time or duration, during which
                                the reference point elevation was used in computing fluid levels.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rpLocation" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The position of the reference point from which the water level was
                                measured. A point location is used so that the measurement datum is
                                preserved.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="datumDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the feature used as the datum for the reference
                                point elevation, for example top of casing or vault lid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateSlakeDurabilityTest" type="diggs:AggregateSlakeDurabilityTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a slake durability test. The slake durability index predicts the
                long-term durability of rock specimens, to establish the weathering and degradation
                characteristics of each rock type and to assess the impact of water on degradation.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateSlakeDurabilityTestType" mixed="false">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="drumMass" type="diggs:MassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The mass of the drum used for the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fragmentsRetainedDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                The appearance of the fragments retained in the drum after the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fragmentsPassingDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                The appearance of the fragments passing through the drum after the
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="index1" type="diggs:MassPerMassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The first-cycle slake durability index.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="averageFluidTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The average temperature of the trough fluid during the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="maximumFluidTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The maximum temperature of the trough fluid during the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="minimumFluidTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The minimum temperature of the trough fluid during the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="slakingFluidDescription" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of slaking fluid. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AtterbergLimitsTest" type="diggs:AtterbergLimitsTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of an Atterberg limits test. The Atterberg limits are a basic measure
                of the nature of a fine-grained soil, which may appear in four states depending on
                its water content: solid, semi-solid, plastic and liquid. The boundary between each
                state is defined by a change in the behavior of the soil, and the limits distinguish
                silt from clay and different types of silts and clays.
            </documentation>
        </annotation>
    </element>
    <complexType name="AtterbergLimitsTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="ovenDriedBeforeTest" type="boolean">
                        <annotation>
                            <documentation>
                                True if the sample was oven dried at 100 degrees C or hotter before
                                testing, otherwise false. A true value should produce a
                                liquid_limit_oven_dried reportable result.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sieveProcedure" type="diggs:SieveProcedureEnumType">
                        <annotation>
                            <documentation>
                                The sieving done on the No. 40 screen (0.425 mm). If the value is
                                none, use handRemoved. Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="handRemoved" type="boolean">
                        <annotation>
                            <documentation>
                                True if particles retained on the No. 40 screen were removed from
                                the sample by hand, false if not. It is required if no sieving is
                                performed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentRetainedNo40" type="string">
                        <annotation>
                            <documentation>
                                The estimated percentage of the sample retained on the No. 40
                                screen, as a string. If no sieving is performed, it holds the
                                estimated percentage of plus-40 particles removed by hand, if
                                applicable.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenInitialState"
                        type="diggs:AtterbergInitialConditionEnumType">
                        <annotation>
                            <documentation>
                                The state of the specimen at the start of the test: wet, air dried,
                                or oven dried below 60 degrees C. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="multiPointLLmethod" type="boolean">
                        <annotation>
                            <documentation>
                                True if the liquid limit method is multi-point, false if the liquid
                                limit is calculated from a single-point test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterDensity"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>
                                The density of water, usually 1.0, which can be modified to account
                                for temperature differences as indicated in the attributes of the
                                type.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waxDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                For the determination of the shrinkage limit, the density of the wax
                                used to seal the soil pat. It may be an assigned value, a value from
                                the manufacturer, or one determined by a test procedure such as ASTM
                                D4943.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casagrandeTrial"
                        type="diggs:CasagrandeTrialPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A Casagrande liquid limit trial. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fallConeTrial"
                        type="diggs:FallConeTrialPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A fall cone liquid limit trial. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plasticLimitTrial"
                        type="diggs:PlasticLimitTrialPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A plastic limit trial. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shrinkageLimitTrial"
                        type="diggs:ShrinkageLimitTrialPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A shrinkage limit trial. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="CasagrandeTrial" type="diggs:CasagrandeTrialType"
        substitutionGroup="diggs:AbstractProcedureTrial">
        <annotation>
            <documentation>
                A Casagrande liquid limit trial of an Atterberg limits test procedure.
            </documentation>
        </annotation>
