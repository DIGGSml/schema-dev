            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DirectShearConsolidationLoadingIncrement"/>
        </sequence>
    </complexType>
    <complexType name="DirectShearConsolidationTrialType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="appliedLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The load applied for this consolidation loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="consolidationIncrement"
                        type="diggs:DSConConsolidationIncrementPropertyType">
                        <annotation>
                            <documentation>
                                The elapsed time and deformation recorded during this loading
                                increment. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="finalNormalDisplacement"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The normal deformation of the sample at the end of the loading
                                increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" ref="diggs:timeInterval"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="DirectShearTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure" type="diggs:DirectShearTestType">
        <annotation>
            <documentation>
                The procedure of a direct shear test, also known as a shearbox test, which
                determines the consolidated drained (or undrained) shear strength of soils by
                deforming a specimen at a controlled rate on or near a single shear plane.
            </documentation>
        </annotation>
    </element>
    <element abstract="false" name="DirectShearTestIncrement"
        type="diggs:DirectShearTestIncrementType">
        <annotation>
            <documentation>
                A single increment within a direct shear test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="DirectShearTestIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DirectShearTestIncrement object inline. It is
                the required parent element that holds the increments.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:DirectShearTestIncrement"/>
        </sequence>
    </complexType>
    <complexType name="DirectShearTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="areaShearBox" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the shear box.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0"
                        name="consolidationLoadingIncrement"
                        type="diggs:ConsolidationLoadingIncrementPropertyType">
                        <annotation>
                            <documentation>
                                A consolidation loading increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element default="false" minOccurs="0" name="directShearTestType"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of shear box test. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="displacementRatePeakStressStage"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The displacement rate during the peak stress stage of shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="displacementRateResidualStressStage"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The displacement rate during the residual stress stage of shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="failureCriteria" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The failure or residual strength criterion used. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="HorizDisplPeakShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:horizDisplPeakShear"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use horizDisplPeakShear; element names begin with a
                                    lower-case letter. The horizontal displacement at peak shear
                                    stress.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="horizDisplPeakShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The horizontal displacement at peak shear stress. Use this
                                    element, not the deprecated HorizDisplPeakShear.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="HorizDisplResidualShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:horizDisplResidualShear"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use horizDisplResidualShear; element names begin
                                    with a lower-case letter. The horizontal displacement at
                                    residual shear stress.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="horizDisplResidualShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The horizontal displacement at residual shear stress. Use this
                                    element, not the deprecated HorizDisplResidualShear.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="normalForcePriorToShearing"
                        type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The normal (or axial) load on the specimen after the final
                                consolidation increment, before shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="normalStressApplied"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The normal stress applied to the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="peakShearStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The peak shear stress during this trial.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="relativeLaterallDisplacementPriorToShearing" type="diggs:LengthPerLengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:relativeLateralDisplacementPriorToShearing"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use relativeLateralDisplacementPriorToShearing; this
                                    name is a misspelling of it. The relative lateral displacement
                                    of the specimen after the final consolidation increment, before
                                    shearing, as a percentage of the specimen diameter.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="relativeLateralDisplacementPriorToShearing" type="diggs:LengthPerLengthMeasureType">
                            <annotation>
                                <documentation>
                                    The relative lateral displacement of the specimen after the
                                    final consolidation increment, before shearing, as a percentage
                                    of the specimen diameter. Use this element, not the deprecated
                                    relativeLaterallDisplacementPriorToShearing.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="residualShearStress"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The residual shear stress during this trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shearForcePriorToShearing"
                        type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The initial shear force on the specimen after the final
                                consolidation increment, before shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDisplacementPriorToShearing"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The normal displacement of the specimen after the final
                                consolidation increment, before shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="VertDisplPeakShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:vertDisplPeakShear"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use vertDisplPeakShear; element names begin with a
                                    lower-case letter. The vertical displacement at peak shear
                                    stress.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="vertDisplPeakShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The vertical displacement at peak shear stress. Use this
                                    element, not the deprecated VertDisplPeakShear.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="VertDisplResidualShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:vertDisplResidualShear"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use vertDisplResidualShear; element names begin with
                                    a lower-case letter. The vertical displacement at residual shear
                                    stress.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="vertDisplResidualShear" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The vertical displacement at residual shear stress. Use this
                                    element, not the deprecated VertDisplResidualShear.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="unbounded" minOccurs="0"
                        name="shearingIncrementPeakStressStage"
                        type="diggs:DirectShearTestIncrementPropertyType">
                        <annotation>
                            <documentation>
                                An increment of the peak stress stage of shearing. Repeat for each
                                increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0"
                        name="shearingIncrementResidualStressStage"
                        type="diggs:DirectShearTestIncrementPropertyType">
                        <annotation>
                            <documentation>
                                An increment of the residual stress stage of shearing. Repeat for
                                each increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DirectShearTestIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The elapsed time of the shearing increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="normalForce" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The normal force measured.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="normalStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The normal stress computed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shearForce" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The shear force applied for the shearing increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shearStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The shear stress computed for the shearing increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lateralDisplacement" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The lateral displacement of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="relativeLateralDisplacement"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The relative lateral displacement, as a percentage of the specimen
                                diameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDisplacement"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The vertical displacement of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LabCBRTest" type="diggs:LabCBRTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory California Bearing Ratio (CBR) test, a penetration
                test for evaluating the mechanical strength of road subgrades and basecourses. The
                pressure required to penetrate a soil sample with a plunger of standard area is
                divided by the pressure required for an equal penetration of a standard crushed rock
                material.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabCBRTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="targetMaxDryDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The maximum dry density (MDD) of the sample from a Modified Proctor
                                compaction test on the same sample, against which the CBR is
                                determined, for example CBR at 95% MDD.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="targetPctMaxDryDensity" type="double">
                        <annotation>
                            <documentation>
                                The percentage of the Modified Proctor maximum dry density used for
                                this CBR determination, as a whole-number percentage. It is
                                generally between 90 and 100, with 95% the most typical value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="targetOptWaterContent"
                        type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The optimum moisture content of the sample from a Modified Proctor
                                compaction test on the same sample, at which the maximum dry density
                                is achieved. It is the target moisture content for the specimens
                                tested for CBR.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadCellCalibrationConstant" type="double">
                        <annotation>
                            <documentation>
                                The calibration constant of the proving ring (or load ring or load
                                cell) used to apply and measure force. In a mechanical CBR frame the
                                plunger load is read as a dial gauge deflection on the proving ring,
                                and this constant converts that reading into a load.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature of the water used for the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="trial" type="diggs:LabCBRTestTrialPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A trial of the test. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LabCBRTestTrial" type="diggs:LabCBRTestTrialType" abstract="false">
        <annotation>
            <documentation>
                A single trial within a laboratory California Bearing Ratio test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabCBRTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LabCBRTestTrial object inline. It is the
                required parent element that holds the trials.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LabCBRTestTrial" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="LabCBRTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="trialNo" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>
                                The number of the test cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element name="waterContentSpecimenRef" type="diggs:FeatureReferenceType"
                        minOccurs="0">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:SoilSpecimen</appinfo>
                            <documentation>
                                The soil specimen used to determine the water content for the CBR
                                test, to compare against the optimum water content. Given by
                                reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="bottomWaterContent" type="diggs:VolumePerVolumeMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture content of the bottom 1 in. of the specimen after the
                                test, if soaked.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cbr_0.1" type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The corrected CBR at 0.100 in. (2.54 mm) penetration for this
                                specimen trial. Repeat the value in the test results if this is the
                                only CBR trial for the sample. If other CBRs at different compaction
                                and water content are run, the overall test CBR value (as an average
                                or otherwise) is reported in the test result.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cbr_0.2" type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The corrected CBR at 0.200 in. (5.08 mm) penetration for this
                                specimen trial. Repeat the value in the test results if this is the
                                only CBR trial for the sample. If other CBRs at different compaction
                                and water content are run, the overall test CBR value (as an average
                                or otherwise) is reported in the test result.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="penetrationIncrement"
                        type="diggs:CBRIncrementPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A penetration increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the penetration piston or plunger.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The area of the penetration piston or plunger.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="seatingForce" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The force on the piston when seated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="soaking" type="boolean" minOccurs="0">
                        <annotation>
                            <documentation>
                                True if the specimen was soaked before the test, otherwise false.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="soakingDetails" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the soaking, for example the soaking time and
                                fluid.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="surchargePressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The load imposed by surcharge from the test equipment.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="swellFromSoaking" type="diggs:LengthPerLengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The swell recorded during soaking, if applicable, as a percentage of
                                the initial height. Record the initial height in the pre-test
                                conditions of the diggs:SoilSpecimen associated with this trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="topWaterContent" type="diggs:VolumePerVolumeMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture content of the top 1 in. of the specimen after the
                                test, if soaked.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="wtPercentRetained19mm" type="diggs:VolumePerVolumeMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The percentage of the specimen retained on a 19 mm sieve, where
                                scalping and replacement is used.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="CBRIncrement" type="diggs:CBRIncrementType">
        <annotation>
            <documentation>
                A single increment within a California Bearing Ratio test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="CBRIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="calculatedStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The stress calculated from the measured load for this penetration
                                increment: the total load (usually measured in kgf) divided by the
                                piston or plunger area.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measuredLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The measured load on the piston at this penetration increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="measuredPenetration" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measured penetration for this increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CBRIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:CBRIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:CBRIncrement"/>
        </sequence>
    </complexType>
    <element name="LabCompactionTest" type="diggs:LabCompactionTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory compaction test, which experimentally determines the
                optimum moisture content at which a soil becomes most dense and achieves its maximum
                dry density.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabCompactionTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="compactionTestType"
                        type="diggs:CompactionTestEnumType">
                        <annotation>
                            <documentation>
                                The type of compaction test. Values come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not a
                                synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fieldWetDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The wet density of the soil sample from an in-situ density test
                                (ASTM D5080).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fieldDryDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The dry density of the soil sample from an in-situ density test
                                (ASTM D5080).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fieldWaterContent"
                        type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The water content of the in-place soil sample (ASTM D5080).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="mouldDiameter" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:mouldDiameter"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use mouldDiameter of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                diameter of the mold used for reconstituting the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="mouldVolume" type="diggs:VolumeMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:mouldVolume"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use mouldVolume of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                specimen volume within the mold.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rammerDiameter" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:rammerDiameter"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use rammerDiameter of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                diameter of the rammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rammerMass" type="diggs:MassMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:rammerMass"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use rammerMass of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                mass of the rammer (hammer) used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rammerDrop" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:rammerDrop"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use rammerDrop of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                drop height of the rammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rammerIsManual" type="boolean" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:rammerIsManual"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use rammerIsManual of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. True if
                                the rammer is operated manually, false if automatic.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="numberOfLayers" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:numberOfLifts"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use numberOfLifts of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                number of layers (lifts) used in reconstituting the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="blowsPerLayer" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:blowsPerLift"
                                    note="in diggs:SoilSpecimen/diggs:reconstitutedSpecimenPreparationInfo/diggs:ReconstitutedSpecimenPreparationInfo"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use blowsPerLift of
                                diggs:ReconstitutedSpecimenPreparationInfoType, held in
                                diggs:SoilSpecimenType/reconstitutedSpecimenPreparationInfo. The
                                number of rammer blows per lift (layer) used to compact the specimen
                                in the mold.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="trial" type="diggs:LabCompactionTestTrialPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A trial of the test. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LabCompactionTestTrial" type="diggs:LabCompactionTestTrialType" abstract="false">
        <annotation>
            <documentation>
                A single trial increment within a laboratory compaction test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabCompactionTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LabCompactionTestTrial object inline. It is
                the required parent element that holds the trials.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LabCompactionTestTrial" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="LabCompactionTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="trialNo" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>
                                The number of the test cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element name="waterContentSpecimenRef" type="diggs:FeatureReferenceType"
                        minOccurs="0">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:SoilSpecimen</appinfo>
                            <documentation>
                                The soil specimen used to determine the water content for the
                                compaction test, to compare against the optimum water content. Given
                                by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterContent" type="diggs:WaterContentMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The water content measured in this trial. If a specimen record
                                exists for this trial, the value equals
                                diggs:SpecimenConditionsType/waterContent in the conditionPreTest of
                                the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="wetDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The density or unit weight measured in this trial at the specimen
                                moisture content. If a specimen record exists for this trial, the
                                value equals diggs:SpecimenConditionsType/bulkDensity in the
                                conditionPreTest of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dryDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The dry density measured in this trial. If a specimen record exists
                                for this trial, the value equals
                                diggs:SpecimenConditionsType/dryDensity in the conditionPreTest of
                                the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="convertedWetDensityDensity"
                        type="diggs:DensityOrUnitWeightMeasureType" minOccurs="0">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:convertedWetDensity"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use convertedWetDensity; this name is a misspelling of
                                it. The wet density of the specimen converted to field moisture
                                (ASTM D5080).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="convertedWetDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The wet density of the specimen converted to field moisture (ASTM
                                D5080).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="moistureAdjustment" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The weight of water added to or subtracted from this trial specimen
                                (California Test 216).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="tamperReading" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The tamper reading (California Test 216).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherTrialProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A trial property not provided elsewhere in this type. Repeat for
                                each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="CompactionTestEnumType">
        <union memberTypes="diggs:OtherNameType">
            <simpleType>
                <restriction base="string">
                    <enumeration value="Proctor">
                        <annotation>
                            <documentation>
                                ASTM D698, laboratory compaction with standard effort (12,400
                                ft-lbf/ft3, 600 kN-m/m3): a 5.5-lbf (24.5 N) rammer dropped 12 in.
                                (305 mm) onto soil compacted in three layers in a 4-in. or 6-in.
                                mold, depending on the method (A, B or C). Commonly called the
                                Standard Proctor test. Use it where the specific method is not
                                distinguished; otherwise prefer Proctor Method A, B or C.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Modified Proctor">
                        <annotation>
                            <documentation>
                                ASTM D1557, laboratory compaction with modified effort (56,000
                                ft-lbf/ft3, 2,700 kN-m/m3): the procedure of ASTM D698 with a
                                heavier 10-lbf (44.5 N) rammer dropped from 18 in. (457 mm) onto
                                soil compacted in five layers instead of three, roughly 4.5 times
                                the compactive energy. Use it where the specific method is not
                                distinguished; otherwise prefer Modified Proctor Method A, B or C.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Proctor Method A">
                        <annotation>
                            <documentation>
                                ASTM D698 Method A: a 4-in. (101.6 mm) mold, material passing the
                                No. 4 (4.75 mm) sieve, three layers, 25 blows per layer. It may be
                                used if 25% or less by mass of the material is retained on the No. 4
                                sieve. It is not AASHTO T99 Method A, which has a different
                                applicability threshold (40%).
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Proctor Method B">
                        <annotation>
                            <documentation>
                                ASTM D698 Method B: a 4-in. (101.6 mm) mold, material passing the
                                3/8-in. (9.5 mm) sieve, three layers, 25 blows per layer. It may be
                                used if 25% or less by mass of the material is retained on the
                                3/8-in. sieve. D698 has no counterpart pairing a 6-in. mold with the
                                3/8-in. sieve and prohibits the 6-in. mold with Method A or B.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Proctor Method C">
                        <annotation>
                            <documentation>
                                ASTM D698 Method C: a 6-in. (152.4 mm) mold, material passing the
                                3/4-in. (19.0 mm) sieve, three layers, 56 blows per layer. It may be
                                used if 30% or less by mass of the material is retained on the
                                3/4-in. sieve, the coarsest material D698 covers. It is
                                apparatus-equivalent to AASHTO T99 Method D.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Modified Proctor Method A">
                        <annotation>
                            <documentation>
                                ASTM D1557 Method A: a 4-in. (101.6 mm) mold, material passing the
                                No. 4 (4.75 mm) sieve, five layers, 25 blows per layer. It may be
                                used if 20% or less by mass of the material is retained on the No. 4
                                sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Modified Proctor Method B">
                        <annotation>
                            <documentation>
                                ASTM D1557 Method B: a 4-in. (101.6 mm) mold, material passing the
                                3/8-in. (9.5 mm) sieve, five layers, 25 blows per layer. It shall be
                                used if more than 20% by mass of the material is retained on the No.
                                4 sieve and 20% or less is retained on the 3/8-in. sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Modified Proctor Method C">
                        <annotation>
                            <documentation>
                                ASTM D1557 Method C: a 6-in. (152.4 mm) mold, material passing the
                                3/4-in. (19.0 mm) sieve, five layers, 56 blows per layer. It shall
                                be used if more than 20% by mass of the material is retained on the
                                3/8-in. sieve and less than 30% is retained on the 3/4-in. sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="California Test 216">
                        <annotation>
                            <documentation>
                                Caltrans California Test 216, Method of Test for Relative Compaction
                                of Untreated and Treated Soils and Aggregates. It uses the apparatus
                                family of ASTM D1557 (a 10-lb, 4.54 kg, rammer dropped 18 in., 457
                                mm) to establish a laboratory maximum wet density, against which an
                                in-place wet density is expressed as a percentage, the relative
                                compaction.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="Porter static">
                        <annotation>
                            <documentation>
                                A static (pressure-applied) laboratory compaction method, unlike
                                every other value in this list, which compacts by repeated dynamic
                                rammer blows. It is associated with O.J. Porter of the California
                                Division of Highways. No current ASTM or AASHTO designation is known
                                for it; cite the governing project or agency specification through
                                the testProcedureMethod property of the procedure.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AASHTO Method A">
                        <annotation>
                            <documentation>
                                AASHTO T99 or T180 Method A: a 4-in. (101.6 mm) mold, material
                                passing the No. 4 (4.75 mm) sieve, 25 blows per layer, with three
                                layers under T99 (standard effort, 5.5-lb rammer, 12 in.) or five
                                layers under T180 (modified effort, 10-lb rammer, 18 in.). AASHTO
                                letters its methods A to D as an independent matrix of mold size and
                                sieve size (A: 4-in. and No. 4, B: 6-in. and No. 4, C: 4-in. and
                                3/4-in., D: 6-in. and 3/4-in.). It is apparatus-equivalent to ASTM
                                Proctor Method A and Modified Proctor Method A but applies over a
                                coarser gradation: Methods A and B are permitted where 40% or less
                                by mass is retained on the No. 4 sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AASHTO Method B">
                        <annotation>
                            <documentation>
                                AASHTO T99 or T180 Method B: a 6-in. (152.4 mm) mold, material
                                passing the No. 4 (4.75 mm) sieve, 56 blows per layer, with three
                                layers under T99 or five layers under T180. This pairing of the
                                larger mold with the finer material has no ASTM D698 or D1557
                                counterpart. It applies, with Method A, where 40% or less by mass is
                                retained on the No. 4 sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AASHTO Method C">
                        <annotation>
                            <documentation>
                                AASHTO T99 or T180 Method C: a 4-in. (101.6 mm) mold, material
                                passing the 3/4-in. (19.0 mm) sieve, 25 blows per layer, with three
                                layers under T99 or five layers under T180. This pairing of the
                                smaller mold with the coarser material has no ASTM D698 or D1557
                                counterpart. It applies, with Method D, where 30% or less by mass is
                                retained on the 3/4-in. sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="AASHTO Method D">
                        <annotation>
                            <documentation>
                                AASHTO T99 or T180 Method D: a 6-in. (152.4 mm) mold, material
                                passing the 3/4-in. (19.0 mm) sieve, 56 blows per layer, with three
                                layers under T99 (standard effort) or five layers under T180
                                (modified effort). It is apparatus-equivalent to ASTM Proctor Method
                                C and Modified Proctor Method C. It applies, with Method C, where
                                30% or less by mass is retained on the 3/4-in. sieve.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="ASTM D5080">
                        <annotation>
                            <documentation>
                                ASTM D5080, Standard Test Method for Rapid Determination of Percent
                                Compaction. Unlike every other value in this list, it is not a
                                method of establishing a full moisture-density curve on a
                                representative sample: it is a field earthwork-control check that
                                derives an abbreviated three-point curve at the in-place water
                                content of the soil, typically within one to two hours, to express
                                an already-measured in-place density as a percentage of the local
                                maximum.
                            </documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <annotation>
                    <documentation>
                        Legacy form. Values of the form "other:xx" (lower-case "o", no space) are still accepted;
                        use "Other: xx" instead.
                    </documentation>
                </annotation>
                <restriction base="string">
                    <pattern value="other:\w{2,}"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <element name="LabChemicalTest" substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:LabChemicalTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory test that determines a chemical component.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabChemicalTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="LabDensityTest" type="diggs:LabDensityTestType"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory density test, which produces density values (mass per
                volume).
            </documentation>
        </annotation>
    </element>
    <complexType name="LabDensityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LabPermeabilityTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:LabPermeabilityTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory permeability test, which determines the coefficient of
                permeability of a soil. Several laboratory methods can be used, including
                constant-head and falling-head types.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabPermeabilityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="backPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The magnitude of the total back pressure used for the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="drainDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the drain for radial permeability in a hydraulic
                                cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="drainMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method of forming the central drain, for example bored using a
                                mandrel and filled with saturated sand. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveConsolidationStress"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The mean effective stress at which permeability was measured, when
                                measured in a triaxial or hydraulic cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effluentArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the reservoir containing the effluent
                                (outflow) liquid, the tailwater tube.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="influentArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the reservoir containing the influent
                                liquid, the headwater tube.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="methodOfSaturation" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method used for saturation, for example specimen soaking or back
                                pressure. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="permeantLiquidType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of liquid used, for example water, including constituent
                                information that may affect fluid density and viscosity, such as
                                salinity. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testType" type="diggs:LabPermEnumExtType">
                        <annotation>
                            <documentation>
                                The type of test conducted. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="permeationTrial"
                        type="diggs:LabPermeationTrialPropertyType">
                        <annotation>
                            <documentation>
                                A permeation trial. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LabPermeationTrial" type="diggs:LabPermeationTrialType">
        <annotation>
            <documentation>
                An individual permeation trial of a laboratory permeability test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabPermeationTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LabPermeationTrial object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LabPermeationTrial"/>
        </sequence>
    </complexType>
    <complexType name="LabPermeationTrialType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="averageInflowVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The average inflow during the whole permeation trial: the average of
                                the incremental inflow measurements.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averageHeadLoss" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The average head loss during the whole permeation trial, generally
                                the average of the head loss at the start and at the end of the
                                trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averageOutflowVolume"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The average outflow during the whole permeation trial: the average
                                of the incremental outflow measurements.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaHg1" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The peak-to-peak height of mercury between the headwater and
                                tailwater tubes at the start of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaHg2" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The difference in elevation of mercury in the headwater and
                                tailwater tubes of the manometer at the end of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaHgC" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The difference in elevation of mercury in the headwater and
                                tailwater tubes of the manometer with equal pressures applied to
                                both tubes. It is positive if the inside diameter of the headwater
                                tube is larger than that of the tailwater tube, and negative if the
                                opposite is true.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaHgTail" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The change in elevation of the mercury level in the tailwater tube
                                during the permeation trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="finalHydraulicGradient" type="double">
                        <annotation>
                            <documentation>
                                The hydraulic gradient at the end of the permeation trial. For the
                                constant head method it is empty or equal to
                                initialHydraulicGradient.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="gHg" type="double">
                        <annotation>
                            <documentation>
                                The ratio of the density of mercury to the density of water (the
                                specific gravity of mercury) at the trial temperature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="headLossStartOfTrial"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The head difference of water on the manometers at the start of the
                                trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialHydraulicGradient" type="double">
                        <annotation>
                            <documentation>
                                The hydraulic gradient at the start of the permeation trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="headLossEndOfTrial" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The head difference of water on the manometers at the end of the
                                trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydraulicConductivity"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The hydraulic conductivity (coefficient of permeability) computed
                                for this trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydraulicConductivity20C"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The hydraulic conductivity computed for this trial, corrected to 20
                                degrees C.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tempStartOfTrial"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The test temperature at the start of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tempEndOfTrial"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The test temperature at the end of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:timeInterval">
                        <annotation>
                            <documentation>
                                The time at the beginning and end of the trial, and the duration of
                                the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalFlowVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The total quantity of flow during the permeation trial: the average
                                of all inflow and outflow measurements.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="LabPermEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LabPermEnumType"/>
    </simpleType>
    <simpleType name="LabPermEnumType">
        <restriction base="string">
            <enumeration value="constant head">
                <annotation>
                    <documentation>
                        A constant head test.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="falling head, constant tailwater elevation">
                <annotation>
                    <documentation>
                        A falling head test with a constant tailwater elevation.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="falling head, rising tailwater elevation">
                <annotation>
                    <documentation>
                        A falling head test with a rising tailwater elevation.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="constant rate of flow">
                <annotation>
                    <documentation>
                        A constant rate of flow test.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="constant volume-constant head (by mercury)">
                <annotation>
                    <documentation>
                        A constant volume, constant head test, using mercury.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration
                value="constant volume-falling head (by mercury), rising tailwater elevation">
                <annotation>
                    <documentation>
                        A constant volume, falling head test, using mercury, with a rising tailwater
                        elevation.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element abstract="false" name="LabResistivityTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:LabResistivityTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory resistivity test, which determines the resistivity of
                a soil in the laboratory.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabResistivityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="electrodeType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type or classification of the electrode. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodeDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the electrode.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodeLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the electrode.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodePenetration"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The penetration of the electrode into the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterResistivity"
                        type="diggs:ElectricalResistivityMeasureType">
                        <annotation>
                            <documentation>
                                The resistivity of the water used.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LabThermalConductivityTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:LabThermalConductivityTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory thermal needle probe test performed on a specimen
                removed from a sampling feature (ASTM D5334, IEEE Std 442). A long, small-diameter
                needle containing a heating element and a temperature sensor is inserted into the
                specimen; a known current is passed through the heater and the resulting temperature
                rise is monitored over time. Thermal conductivity and its reciprocal, thermal
                resistivity, are computed from the rate of temperature rise per logarithmic time
                cycle and are reported as diggs:Property values (propertyClass thermal_conductivity
                or thermal_resistivity) in the outcome of the test, not as elements of this
                procedure; one determination results per test. It is not for in-situ measurement:
                the field-probe variant that ASTM D5334 and IEEE Std 442 also describe is out of
                scope. Whether the specimen is undisturbed or remolded is recorded by
                diggs:SoilSpecimenType/specimenType.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabThermalConductivityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="probeLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the needle probe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="probeDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the needle probe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="heatingDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The total duration the heater element was energized for this
                                determination.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="temperatureRiseOverLogCycle"
                        type="diggs:TemperatureIntervalMeasureType">
                        <annotation>
                            <documentation>
                                The temperature rise per logarithmic cycle of elapsed time (delta-T
                                in the governing thermal needle probe formula), read from the slope
                                of the temperature versus log(time) heating curve over its linear
                                portion.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="reading"
                        type="diggs:ThermalProbeReadingPropertyType">
                        <annotation>
                            <documentation>
                                An individual temperature versus time reading making up the heating
                                curve for this determination. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ThermalProbeReading" type="diggs:ThermalProbeReadingType">
        <annotation>
            <documentation>
                A single temperature reading within a thermal needle probe heating curve.
            </documentation>
        </annotation>
    </element>
    <complexType name="ThermalProbeReadingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ThermalProbeReading object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:ThermalProbeReading"/>
        </sequence>
    </complexType>
    <complexType name="ThermalProbeReadingType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the heater element was energized.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="temperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature reading of the needle probe at elapsedTime.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LabVaneTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure" type="diggs:LabVaneTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory vane shear test. A four-bladed vane is inserted in the
                end of an intact tube sample or a remolded sample and rotated at a constant rate to
                determine the torque required to shear a cylindrical surface. The torque is
                converted to a unit shearing resistance of the cylindrical surface area, and is
                measured by a calibrated torque spring or torque transducer attached directly to the
                vane.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabVaneTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="intactVaneTest" type="diggs:VaneTestPropertyType">
                        <annotation>
                            <documentation>
                                The vane shear test parameters in intact soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="remoldedVaneTest" type="diggs:VaneTestPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The vane shear test parameters in remolded soil. Repeat for each
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="torqueMeasuringDevice" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of torque measuring device, for example a conventional
                                torque spring or an electrical torque transducer. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the vane.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="VaneTestMeasurementData" type="diggs:VaneTestMeasurementDataType">
        <annotation>
            <documentation>
                The data recorded in a vane test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="VaneTestMeasurementDataType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="delay" type="diggs:DelayEventPropertyType" minOccurs="0">
                        <annotation>
                            <documentation>
                                For an intact test, the delay between the end of penetration and the
                                beginning of rotation. For a remolded test, the time between the end
                                of remolding and the beginning of rotation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maximumMeasuredTorque"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The maximum measured torque.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="remoldedRevolutions" type="positiveInteger"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                If the test is done in remolded soil, the number of rotations of the
                                device to produce the remolding.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rotationRate"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>
                                The rotation rate of the vane during the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="timeToSoilFailure" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time from the start of vane rotation to soil failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="torqueIncrement"
                        type="diggs:TorqueIncrementPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A torque increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="VaneTestPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:VaneTestMeasurementData object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:VaneTestMeasurementData"/>
        </sequence>
    </complexType>
    <element name="TorqueIncrement" type="diggs:TorqueIncrementType">
        <annotation>
            <documentation>
                A single torque increment within a vane test.
            </documentation>
        </annotation>
    </element>
    <complexType name="TorqueIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TorqueIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TorqueIncrement"/>
        </sequence>
    </complexType>
    <complexType name="TorqueIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the start of rotation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="measuredTorque"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The torque reading at elapsedTime.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LossOnIgnitionTest" type="diggs:LossOnIgnitionTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory loss-on-ignition test, which determines carbon
                content.
            </documentation>
        </annotation>
    </element>
    <complexType name="LossOnIgnitionTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="dryingTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature of the oven or other drying apparatus.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time the specimen was kept at the drying temperature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ignitionTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature of the muffle furnace or other ignition device.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ignitionTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time the specimen spent in the muffle furnace.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="OrganicMatterByWetCombustionTest"
        type="diggs:OrganicMatterByWetCombustionTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory wet combustion test that determines organic matter
                (AASHTO T 194).
            </documentation>
        </annotation>
    </element>
    <complexType name="OrganicMatterByWetCombustionTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="sampleTitre" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of ferrous sulfate used to titrate the soil sample
                                containing potassium dichromate solution, according to AASHTO T 194.
                                The ratio of the sample titre volume to the blank titre volume is
                                used to calculate the easily oxidized carbon.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="blankTitre" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of ferrous sulfate used to titrate a blank sample
                                containing potassium dichromate solution, according to AASHTO T 194.
                                The ratio of the sample titre volume to the blank titre volume is
                                used to calculate the easily oxidized carbon.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ParticleSizeTest" type="diggs:ParticleSizeTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory particle size test, which produces the distribution of
                particle sizes in soils by sieve analysis, hydrometer analysis or both.
            </documentation>
        </annotation>
    </element>
    <complexType name="ParticleSizeTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="sieveAnalysis"
                        type="diggs:SieveAnalysisPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A sieve analysis. Repeat for each analysis.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydrometer" type="diggs:HydrometerPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A hydrometer analysis. Repeat for each analysis.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Grading" type="diggs:GradingType" abstract="false">
        <annotation>
            <documentation>
                The percentage of particle sizes within a specific grade interval.
            </documentation>
        </annotation>
    </element>
    <complexType name="GradingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="particleSize" type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>
                                The screen opening size of the sieve, or the grain diameter
                                evaluated by hydrometer, that percentPassing or percentRetained
                                relates to.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="sieveNumber" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The number of the sieve, for sieve analyses. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="percentPassing" type="diggs:MassPerMassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The amount of the total sample passing this size fraction, that is,
                                with particles smaller than this size, as a weight percent.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="percentRetained" type="diggs:MassPerMassMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The amount of the total sample retained at this size fraction, that
                                is, with particles greater than or equal to particleSize, as a
                                weight percent.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="weightRetained" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The dry weight of the sample retained at this size fraction, that
                                is, with particles greater than or equal to particleSize.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherGradingProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A grading parameter not provided elsewhere in diggs:Grading, as a
                                name and value pair. Repeat for each parameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="gradingData" type="diggs:GradingPropertyType">
        <annotation>
            <documentation>
                The grading data of a particle size analysis, wrapped as a property.
            </documentation>
        </annotation>
    </element>
    <complexType name="GradingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Grading object inline. It satisfies the GML
                object-property rule when diggs:Grading is used as an element in another test.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Grading" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="Hydrometer" type="diggs:HydrometerType">
        <annotation>
            <documentation>
                The hydrometer portion of a particle size test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="HydrometerType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element minOccurs="0" name="soakingPeriod"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The time interval the sediment is left to stand in the cylinder
                                before the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dispersionDevice" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The device used for dispersing the sediment, for example a magnetic
                                stirrer or an air jet. No DIGGS-authored dictionary currently exists
                                for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dispersionDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration of the dispersion.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydrometerType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of hydrometer used, for example 151H or 152H. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherHydrometerProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A hydrometer property not provided elsewhere in
                                diggs:HydrometerType. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="sedimentationData"
                        type="diggs:SedimentationPropertyType">
                        <annotation>
                            <documentation>
                                A sedimentation interval of the hydrometer test. Repeat for each
                                interval.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="HydrometerPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Hydrometer object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Hydrometer"/>
        </sequence>
    </complexType>
    <element name="PanData" type="diggs:PanDataType">
        <annotation>
            <documentation>
                The material left in the pan (passing all sieves), or the finest size fraction.
            </documentation>
        </annotation>
    </element>
    <complexType name="PanDataType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="percentLoss" type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The percentage of the sample lost in the sieve analysis: 100 x (1 -
                                final weight / initial sample weight), where the final weight is the
                                cumulative weight of all particle sizes.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="percentRetained" type="diggs:MassPerMassMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The amount of the cumulative soil sample retained on the pan, as a
                                weight percent.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="weightRetained" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The cumulative dry weight of the sample retained on the pan. It is
                                less than or equal to the dry weight of the sample, depending on
                                loss.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherGradingProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A grading parameter not provided elsewhere in diggs:PanData, as a
                                name and value pair. Repeat for each parameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PanDataPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PanData object inline. It satisfies the GML
                object-property rule when diggs:PanData is used as an element in another test.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:PanData" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="Sedimentation" type="diggs:SedimentationType">
        <annotation>
            <documentation>
                A sedimentation interval of a hydrometer test, analogous to the grading object of a
                sieve analysis.
            </documentation>
        </annotation>
    </element>
    <complexType name="SedimentationType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="clockTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The time the measurement was taken.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The elapsed time of the hydrometer reading since the start of the
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydrometerReading"
                        type="diggs:MassPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The value read from the hydrometer at the reading time.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="temperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature at the time of the hydrometer reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="compositeCorrection"
                        type="diggs:MassPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The composite correction applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="correctedReading"
                        type="diggs:MassPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The hydrometer reading after the correction is applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance through which soil particles fall in a given period of
                                time.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleDiameter"
                        type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>
                                The particle size computed from Stokes' law.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentPassing" type="diggs:MassPerMassMeasureType">
                        <annotation>
                            <documentation>
                                The percentage of sediment smaller than the particle diameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SedimentationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Sedimentation object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Sedimentation"/>
        </sequence>
    </complexType>
    <element name="SieveAnalysis" type="diggs:SieveAnalysisType">
        <annotation>
            <documentation>
                The sieve analysis portion of a particle size test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="SieveAnalysisType">
        <annotation>
            <documentation>
                Type for the sieve analysis portion of a particle size test procedure.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element minOccurs="0" name="coarseFractionWetSieved" type="boolean">
                        <annotation>
                            <documentation>
                                True if the coarse fraction of the sample is wet sieved (washed
                                through the screen), false if not.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dispersantUsed" type="boolean">
                        <annotation>
                            <documentation>
                                True if a dispersant is used before washing the sample to determine
                                the amount of sediment smaller than 75 microns.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sandGravelConsistency" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The condition of the sand and gravel size particles in the specimen
                                that could bias the particle size results, for example hard, soft,
                                friable or weathered. No DIGGS-authored dictionary currently exists
                                for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSieveAnalysisProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A sieve analysis property not provided elsewhere in this type.
                                Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:gradingData" minOccurs="0" maxOccurs="unbounded"/>
                    <element minOccurs="0" name="panData" type="diggs:PanDataPropertyType">
                        <annotation>
                            <documentation>
                                The material left in the pan.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SieveAnalysisPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SieveAnalysis object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SieveAnalysis"/>
        </sequence>
    </complexType>
    <element name="PocketPenetrometerTest" type="diggs:PocketPenetrometerTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a pocket penetrometer test. The pocket penetrometer gives a basic
                measure of the strength of a soil, which depends on its water content and on its
                type and consistency.
            </documentation>
        </annotation>
    </element>
    <complexType name="PocketPenetrometerTestType">
        <annotation>
            <documentation>
                Type for the procedure of a pocket penetrometer test. Used by
                diggs:PocketPenetrometerTest and diggs:LabPenetrometerTest.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="reading"
                        type="diggs:ReadingMeasureType">
                        <annotation>
                            <documentation>
                                A penetrometer reading. The trialNo attribute gives its order.
                                Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ReadingMeasureType">
        <annotation>
            <documentation>
                Type for a penetrometer reading: a pressure with the order of the trial.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:PressureMeasureType">
                <attribute name="trialNo" type="positiveInteger">
                    <annotation>
                        <documentation>
                            The order of the trial: 1 for the first trial, 2 for the second, and so
                            on.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="RedoxTest" substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:RedoxTestType">
        <annotation>
            <documentation>
                The procedure of a redox test, which measures the overall reducing or oxidizing
                capacity of a sample. The redox potential is measured in millivolts relative to a
                standard hydrogen electrode, commonly with a platinum electrode and a saturated
                calomel electrode as reference.
            </documentation>
        </annotation>
    </element>
    <complexType name="RedoxTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="redoxTestType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of redox test conducted. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="meanValueOfPotentialOfPlatinumProbes"
                        type="diggs:ElectricPotentialDifferenceMeasureType">
                        <annotation>
                            <documentation>
                                The mean value of the potential of the platinum probes.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SpecificGravityTest" type="diggs:SpecificGravityTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a laboratory specific gravity test. Specific gravity is the ratio
                of the density of a substance to the density of a reference substance, usually water
                at 4 degrees C; equivalently, the ratio of the mass of a substance to the mass of a
                reference substance for the same volume.
            </documentation>
        </annotation>
    </element>
    <complexType name="SpecificGravityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="waterTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The temperature of the water.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="temperatureWaterAndSoil"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature of the water and soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="correctionFactorForWaterTemperature" type="double">
                        <annotation>
                            <documentation>
                                The correction factor for the water temperature.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SwellOrCollapseTest" type="diggs:SwellOrCollapseTestType">
        <annotation>
            <documentation>
                The procedure of a swell or collapse test.
            </documentation>
        </annotation>
    </element>
    <complexType name="SwellOrCollapseTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element default="false" minOccurs="0" name="swellTestProcedure"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The swell test procedure type. For ASTM D4546 the values are "A",
                                "B" or "C". No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="moldHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height of the mold used for the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testWaterType" type="string">
                        <annotation>
                            <documentation>
                                A description of the source and type of the test water.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="swellTestIncrement"
                        type="diggs:SwellTestIncrementPropertyType">
                        <annotation>
                            <documentation>
                                The intermediate swell test data for a particular specimen and
                                vertical stress. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SwellTestIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SwellTestIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SwellTestIncrement"/>
        </sequence>
    </complexType>
    <element name="SwellTestIncrement" type="diggs:SwellTestIncrementType">
        <annotation>
            <documentation>
                An intermediate swell test increment for a particular specimen and vertical stress.
            </documentation>
        </annotation>
    </element>
    <complexType name="SwellTestIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element minOccurs="0" name="seatingPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pressure applied to the specimen before the consolidation stage
                                starts.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="2" minOccurs="0" name="preInundationConsolidation"
                        type="diggs:PreInundationConsolidationPropertyType">
                        <annotation>
                            <documentation>
                                A consolidation event before inundation, as a
                                diggs:SwellTestConsolidationStage. ASTM D4546 Methods A and C use
                                one consolidation event; Method B comprises two, with an intervening
                                period of specimen unloading. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="postInundatiomSwellOrCollapse" type="diggs:PostInundationSwellOrCollapsePropertyType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:postInundationSwellOrCollapse"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use postInundationSwellOrCollapse; this name is a
                                    misspelling of it. The measured swell or collapse of the
                                    specimen after inundation by water, as a
                                    diggs:SwellOrCollapseStage.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="postInundationSwellOrCollapse" type="diggs:PostInundationSwellOrCollapsePropertyType">
                            <annotation>
                                <documentation>
                                    The measured swell or collapse of the specimen after inundation
                                    by water, as a diggs:SwellOrCollapseStage. Use this element, not
                                    the deprecated postInundatiomSwellOrCollapse.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="1" minOccurs="0" name="postInundationConsolidation"
                        type="diggs:PreInundationConsolidationPropertyType">
                        <annotation>
                            <documentation>
                                A consolidation stage after the post-inundation deformation stage
                                (ASTM D4546 Method C), as a diggs:SwellTestConsolidationStage.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PreInundationConsolidationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SwellTestConsolidationStage object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SwellTestConsolidationStage"/>
        </sequence>
    </complexType>
    <element name="SwellTestConsolidationStage" type="diggs:SwellTestConsolidationStageType">
        <annotation>
            <documentation>
                A consolidation stage of a swell test.
            </documentation>
        </annotation>
    </element>
    <complexType name="SwellTestConsolidationStageType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" ref="diggs:timeInterval"/>
                    <element minOccurs="1" name="appliedLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The load applied for this consolidation loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="loadingStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The stress applied for this consolidation loading increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="consolidationIncrement"
                        type="diggs:CTConsolidationIncrementPropertyType">
                        <annotation>
                            <documentation>
                                The elapsed time and deformation recorded during this loading
                                increment. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="finalaxialDeformation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The normal deformation of the sample at the end of the loading
                                increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="finalStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The loading stress measured at the end of the loading increment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PostInundationSwellOrCollapsePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SwellOrCollapseStage object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SwellOrCollapseStage"/>
        </sequence>
    </complexType>
    <element name="SwellOrCollapseStage" type="diggs:SwellOrCollapseStageType">
        <annotation>
            <documentation>
                A stage of a swell test that records the swell or collapse of the specimen after
                inundation.
            </documentation>
        </annotation>
    </element>
    <complexType name="SwellOrCollapseStageType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element name="swellOrCollapseMeasurements"
                        type="diggs:DeformationMeasurementsArrayPropertyType">
                        <annotation>
                            <documentation>
                                The swell or collapse measurements of the stage.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DeformationMeasurementsArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:SwellOrCollapseMeasurement objects
                inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:SwellOrCollapseMeasurement"/>
        </sequence>
    </complexType>
    <element name="SwellOrCollapseMeasurement" type="diggs:SwellOrCollapseMeasurementType">
        <annotation>
            <documentation>
                A swell or collapse measurement at one elapsed time.
            </documentation>
        </annotation>
    </element>
    <complexType name="SwellOrCollapseMeasurementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The elapsed time since the beginning of the measurements.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="swellOrCollapse" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The axial deformation of the specimen at the elapsed time: the
                                specimen height at that time minus the initial specimen height at
                                time zero. Positive values represent swell; negative values
                                represent collapse or hydrocompression.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="TriaxialTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure" type="diggs:TriaxialTestType">
        <annotation>
            <documentation>
                The procedure of a laboratory triaxial shear test. Stress is applied to a sample so
                that the stresses along one axis differ from those in perpendicular directions; in
                conventional triaxial tests a cylindrical soil sample is subjected to radial
                stresses (confining pressure) and controlled increases in axial stress or axial
                displacement. Depending on loading and drainage conditions there are three main
                types: consolidated drained (CD), consolidated undrained (CU) and unconsolidated
                undrained (UU). The results give the shear strength parameters (friction angle,
                cohesion, dilatancy angle) and other dependent parameters.
            </documentation>
        </annotation>
    </element>
    <simpleType name="TriaxialTestAreaCorrectionEnumTypeType">
        <restriction base="string">
            <enumeration value="Central cylindrical bulging">
                <annotation>
                    <documentation>
                        The area is corrected assuming the specimen deforms as a cylinder with a
                        central bulge.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Parabolic bulging">
                <annotation>
                    <documentation>
                        The area is corrected assuming the specimen deforms with a parabolic bulge.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Right circular cylinder">
                <annotation>
                    <documentation>
                        The area is corrected assuming the specimen deforms as a right circular
                        cylinder.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Slip plane">
                <annotation>
                    <documentation>
                        The area is corrected assuming the specimen deforms by shearing along a slip
                        plane.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="TriaxialTestAreaCorrectionTypeType">
        <union memberTypes="diggs:TriaxialTestAreaCorrectionEnumTypeType diggs:OtherNameType"/>
    </simpleType>
    <element abstract="false" name="TriaxialTestConsolidationStage"
        type="diggs:TriaxialTestConsolidationStageType">
        <annotation>
            <documentation>
                The results of the consolidation stage of a triaxial test trial. Other specimen
                information recorded for the stage is held in the conditionPostTest property of the
                associated specimen.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestConsolidationStagePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TriaxialTestConsolidationStage object inline.
                It is the required parent element that holds the stages.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TriaxialTestConsolidationStage"/>
        </sequence>
    </complexType>
    <complexType name="TriaxialTestConsolidationStageType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="consolidationIncrement"
                        type="diggs:ConsolidationIncrementPropertyType">
                        <annotation>
                            <documentation>
                                A consolidation increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenCrossSectionalAreaCalculationMethod"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the specimen cross-sectional area after consolidation is
                                computed, for example ASTM Method A or B. The value of the area is
                                given in the conditionPostTest property of the associated specimen.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveStressEndofConsolidationStage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The effective stress at the end of consolidation, the start of the
                                shear stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="t50" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time for 50 percent consolidation. The t50Method property
                                describes how it was determined.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenHeightChangeAfterConsolidation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The change in specimen height after consolidation. The
                                post-consolidation specimen height is given in the conditionPostTest
                                property of the associated specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="t50Method" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method used to determine t50, for example Casagrande or Taylor.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="TriaxialTestSaturationStage"
        type="diggs:TriaxialTestSaturationStageType">
        <annotation>
            <documentation>
                The results of the saturation stage of a triaxial test trial.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestSaturationStagePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TriaxialTestSaturationStage object inline. It
                is the required parent element that holds the stages.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TriaxialTestSaturationStage"/>
        </sequence>
    </complexType>
    <complexType name="TriaxialTestSaturationStageType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="automatedSaturationEquipmentUsed" type="boolean">
                        <annotation>
                            <documentation>
                                True if automated saturation equipment was used.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="backPressureIncrement"
                        type="diggs:BackPressureIncrementPropertyType">
                        <annotation>
                            <documentation>
                                A back pressure increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bValueEndOfSaturation" type="double">
                        <annotation>
                            <documentation>
                                The B value at the end of saturation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialSaturation"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The initial saturation before testing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maximumBackPressureApplied"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The maximum back pressure applied, or its limit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="saturationMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method of saturation, for example initially saturated (wet)
                                method, initially dry (dry) method, cell pressure or back pressure.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="TriaxialTestShearStage" type="diggs:TriaxialTestShearStageType">
        <annotation>
            <documentation>
                The results of the shear stage of a triaxial test trial.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestShearStagePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TriaxialTestShearStage object inline. It is
                the required parent element that holds the stages.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TriaxialTestShearStage"/>
        </sequence>
    </complexType>
    <complexType name="TriaxialTestShearStageType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="axialStrainAtFailure"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The axial strain at failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deviatorStressAtFailure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The deviator stress at failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="failureCriterion" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The criterion used to define failure, for example maximum deviator
                                stress, maximum principal stress ratio or limiting strain. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="modeOfFailure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The failure mode, for example shear plane or bulging. Use the DIGGS
                                dictionary modeOfFailure.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalPorewaterPressureAtFailure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The total pore water pressure measured at failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="inducedPorewaterPressureAtFailure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The induced pore water pressure measured at failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="porewaterPressureStartOfShearing"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pore water pressure measured before the start of shearing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rateOfAxialStrainDuringShear"
                        type="diggs:RelativeRateMeasureType">
                        <annotation>
                            <documentation>
                                The strain rate during the shear stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="shearingIncrement"
                        type="diggs:ShearingIncrementPropertyType">
                        <annotation>
                            <documentation>
                                A shearing increment. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="slopeOfAngleOfFailureSurface"
                            type="diggs:PlaneAngleMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:failureSurfaceDipAngle"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use failureSurfaceDipAngle, which also states the
                                    reference plane; only one of the two may be given. The angle of
                                    the failure surface of the specimen.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="failureSurfaceDipAngle" type="diggs:PlaneAngleMeasureType">
                            <annotation>
                                <documentation>
                                    Dip of the failure surface of the specimen: the angle between
                                    the failure surface and the plane perpendicular to the specimen
                                    axis (the horizontal, for a vertical specimen), measured along
                                    the line of steepest slope of the surface. Only one of this and
                                    slopeOfAngleOfFailureSurface may be given.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="1" name="totalCellPressureDuringShearStage"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The total cell pressure during the shear stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="undrainedShearStrengthAtFailure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The undrained shear strength at failure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volumetricStrainAtFailureDrainedOnly"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volumetric strain at failure, for drained tests only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="areaCorrectionApplied" type="boolean">
                        <annotation>
                            <documentation>
                                True if an area correction was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="areaCorrectionType"
                        type="diggs:TriaxialTestAreaCorrectionTypeType">
                        <annotation>
                            <documentation>
                                The type of area correction applied. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterCorrectionApplied" type="boolean">
                        <annotation>
                            <documentation>
                                True if a filter correction was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneCorrectionApplied" type="boolean">
                        <annotation>
                            <documentation>
                                True if a membrane correction was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonFrictionCorrectionApplied" type="boolean">
                        <annotation>
                            <documentation>
                                True if a piston friction correction was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="upliftCorrectionApplied" type="boolean">
                        <annotation>
                            <documentation>
                                True if an uplift correction was applied.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="TriaxialTestTrial"
        substitutionGroup="diggs:AbstractProcedureTrial" type="diggs:TriaxialTestTrialType">
        <annotation>
            <documentation>
                The results of one trial of a triaxial test.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TriaxialTestTrial object inline. It is the
                required parent element that holds the trials.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TriaxialTestTrial"/>
        </sequence>
    </complexType>
    <complexType name="TriaxialTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" ref="diggs:specimenRef"> </element>
                    <element minOccurs="0" name="filterInfo" type="diggs:FilterInfoPropertyType">
                        <annotation>
                            <documentation>
                                The filters used and the parameters used for the filter correction.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneInfo" type="diggs:MembraneInfoPropertyType">
                        <annotation>
                            <documentation>
                                The membranes used and the parameters used for the membrane
                                correction.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="saturationStage"
                        type="diggs:TriaxialTestSaturationStagePropertyType">
                        <annotation>
                            <documentation>
                                The saturation stage of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="consolidationStage"
                        type="diggs:TriaxialTestConsolidationStagePropertyType">
                        <annotation>
                            <documentation>
                                The consolidation stage of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shearStage"
                        type="diggs:TriaxialTestShearStagePropertyType">
                        <annotation>
                            <documentation>
                                The shear stage of the trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TriaxialTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element default="" minOccurs="0" name="triaxialTestType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of triaxial test, for example CU, CD, UU or UD. Use the
                                DIGGS dictionary triaxType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="trial"
                        type="diggs:TriaxialTestTrialPropertyType">
                        <annotation>
                            <documentation>
                                A trial of the test. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="BackPressureIncrement"
        substitutionGroup="diggs:AbstractProcedureTrial" type="diggs:BackPressureIncrementType">
        <annotation>
            <documentation>
                Information on one back pressure increment of the saturation stage of a triaxial
                test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="BackPressureIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:BackPressureIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BackPressureIncrement"/>
        </sequence>
    </complexType>
    <complexType name="BackPressureIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="1" name="incrementNumber" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The index of the increment: 1 for the first, 2 for the second, and
                                so on.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="backPressureApplied"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The back pressure applied to the specimen during this increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bValue" type="double">
                        <annotation>
                            <documentation>
                                The pore pressure parameter B: the change in specimen pore pressure
                                caused by a change in chamber pressure with the specimen drainage
                                valves closed, divided by the change in chamber pressure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chamberPressureApplied"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The chamber pressure applied to the specimen during this increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deairedWaterUsed" type="boolean">
                        <annotation>
                            <documentation>
                                True if deaired water was used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the start of the saturation stage.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="FilterInfo" type="diggs:FilterInfoType">
        <annotation>
            <documentation>
                Information on the filter used in a triaxial test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="FilterInfoPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:FilterInfo object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:FilterInfo"/>
        </sequence>
    </complexType>
    <complexType name="FilterInfoType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="filterPaperConfiguration" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The configuration of the filter paper, for example strips or spiral.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterPaperDisksUsed" type="boolean">
                        <annotation>
                            <documentation>
                                True if filter paper disks were used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterPaperType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of filter paper used, for example No. 54. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadCarriedbyFilterPaperStrips"
                        type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The load carried by the filter paper strips per unit length of the
                                perimeter of the specimen they cover, usually approximated as
                                0.00019 kN/mm (0.19 kN/m, 1.1 lbf/in.). Use description or remark if
                                determined otherwise.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="perimeterCarriedbyFilterPaperStrips"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The perimeter of the specimen covered by filter paper.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="MembraneInfo" type="diggs:MembraneInfoType">
        <annotation>
            <documentation>
                Information on the membrane used in a triaxial test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="MembraneInfoPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MembraneInfo object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:MembraneInfo"/>
        </sequence>
    </complexType>
    <complexType name="MembraneInfoType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="membraneMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The membrane material, for example latex or nitrile. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The thickness of the membrane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneYoungsModulus"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                Young's modulus of the membrane material.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="membraneYoungsmodulusDetermination" type="diggs:MeasurementTechniqueEnumType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:membraneYoungsModulusDetermination"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use membraneYoungsModulusDetermination; this name is
                                    a misspelling of it. The method by which Young's modulus was
                                    determined, as a diggs:DescriptorMethodEnumType value. If it was
                                    determined by hanging and stretching the membrane, use
                                    calculated; otherwise use assumed or another suitable value. The
                                    formula attribute describes the formula used.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="membraneYoungsModulusDetermination" type="diggs:MeasurementTechniqueEnumType">
                            <annotation>
                                <documentation>
                                    The method by which Young's modulus was determined, as a
                                    diggs:DescriptorMethodEnumType value. If it was determined by
                                    hanging and stretching the membrane, use calculated; otherwise
                                    use assumed or another suitable value. The formula attribute
                                    describes the formula used. Use this element, not the deprecated
                                    membraneYoungsmodulusDetermination.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="numberOfMembranesUsed" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of membranes used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unstretchedMembraneCircumference"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The unstretched circumference of the membrane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unstretchedMembraneLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The unstretched length of the membrane.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="ShearingIncrement"
        substitutionGroup="diggs:AbstractProcedureTrial" type="diggs:ShearingIncrementType">
        <annotation>
            <documentation>
                Information on one shearing increment of the shear stage of a triaxial test
                procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="ShearingIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ShearingIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:ShearingIncrement"/>
        </sequence>
    </complexType>
    <complexType name="ShearingIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <choice>
                        <sequence>
                            <element minOccurs="1" name="axialLoad" type="diggs:ForceMeasureType">
                                <annotation>
                                    <documentation>
                                        The load applied to the top of the sample.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="1" name="axialDeflection"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The change in the axial length of the sample.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element minOccurs="1" name="deviatorStress"
                                type="diggs:PressureMeasureType">
                                <annotation>
                                    <documentation>
                                        The difference between the major and minor principal
                                        stresses, computed as the axial load divided by the
                                        cross-sectional area of the specimen.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="1" name="axialStrain"
                                type="diggs:LengthPerLengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The strain of the sample under load.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the start of the shear stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalPoreWaterPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The total pore water pressure measured.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="inducedPoreWaterPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pore water pressure induced under loading: the total pore water
                                pressure minus the back pressure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalCellPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The measured confining pressure in the cell.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="UnconfinedCompressiveStrengthTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:UnconfinedCompressiveStrengthTestType">
        <annotation>
            <documentation>
                The procedure of an unconfined (uniaxial) compressive strength test: a specimen is
                loaded axially, without lateral confinement, until it fails, and the maximum
                compressive stress it sustains is its unconfined compressive strength. It applies to
                soil and rock, and to manufactured cementitious materials such as concrete, grout,
                mortar and soil-cement. The strength and other measured values are reported in the
                results of the diggs:Test or diggs:MaterialTest that carries this procedure; this
                object records how the test was carried out and how the specimen failed. The
                governing standard is cited by testProcedureMethod and the specimens tested are
                described by specimen.
            </documentation>
        </annotation>
    </element>
    <complexType name="UnconfinedCompressiveStrengthTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="averageRateOfStrain" type="diggs:RelativeRateMeasureType">
                            <annotation>
                                <documentation>
                                    The average axial strain rate applied to the specimen during
                                    loading, for strain-controlled tests (for example %/min). A test
                                    records either this or loadingRate, not both.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="loadingRate" type="diggs:PressurePerTimeMeasureType">
                            <annotation>
                                <documentation>
                                    The stress rate applied to the specimen during loading, for
                                    stress-controlled tests (for example MPa/s for concrete). Where
                                    the machine is displacement-controlled, it is the stress rate
                                    the rate of movement is set to produce. A test records either
                                    this or averageRateOfStrain, not both.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="modeOfFailure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the specimen failed: for soil and rock, for example shear plane
                                or bulging; for concrete and other cementitious specimens, the
                                fracture type or failure pattern defined by the governing standard.
                                Use the DIGGS dictionary modeOfFailure.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="slopeOfAngleOfFailureSurface"
                            type="diggs:PlaneAngleMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:failureSurfaceDipAngle"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use failureSurfaceDipAngle, which also states the
                                    reference plane; only one of the two may be given. The angle of
                                    the failure surface of the specimen.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="failureSurfaceDipAngle" type="diggs:PlaneAngleMeasureType">
                            <annotation>
                                <documentation>
                                    Dip of the failure surface of the specimen: the angle between
                                    the failure surface and the plane perpendicular to the specimen
                                    axis (the horizontal, for a vertical specimen), measured along
                                    the line of steepest slope of the surface. Only one of this and
                                    slopeOfAngleOfFailureSurface may be given.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="axialStrainAtFailure"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The axial strain of the specimen at failure: at the maximum
                                compressive stress, or at the limiting strain set by the governing
                                standard where no peak is reached.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="compressionIncrement"
                        type="diggs:CompressionIncrementPropertyType">
                        <annotation>
                            <documentation>
                                One reading of the load-deformation record taken during loading,
                                from which the stress-strain curve is drawn. Repeat for each
                                reading, in the order taken.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CompressionIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:CompressionIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:CompressionIncrement"/>
        </sequence>
    </complexType>
    <complexType name="CompressionIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="elapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time since the start of loading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadDialReading" type="string">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0" replacedBy="diggs:axialLoad"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use axialLoad, a force with units. The load dial
                                reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="axialLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The axial compressive force acting on the specimen at this reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="strainDialReading" type="string">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    note="axialDeformation (a length with units) or totalStrain (a strain)"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use axialDeformation (a length with units) or
                                totalStrain (a strain). The strain dial reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalStrain"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The axial strain of the specimen at this reading: the axial
                                deformation divided by the specimen height before loading. A reading
                                may record axialDeformation instead.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitStrain" type="string">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0" replacedBy="diggs:totalStrain"/>
                            </appinfo>
                            <documentation>
                                DEPRECATED. Use totalStrain, a measure with units. Strain per unit
                                length, as text.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="correctedArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the specimen at this reading, corrected
                                for the change in area with axial strain.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="stress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The axial compressive stress on the specimen at this reading:
                                axialLoad divided by the cross-sectional area (the corrected area
                                where given).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="axialDeformation" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The axial shortening of the specimen at this reading, measured from
                                the start of loading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="CompressionIncrement"
        substitutionGroup="diggs:AbstractProcedureTrial" type="diggs:CompressionIncrementType">
        <annotation>
            <documentation>
                A single compression increment within an unconfined compressive strength test
                procedure.
            </documentation>
        </annotation>
    </element>
    <element name="WaterContentTest" type="diggs:WaterContentTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                The procedure of a water content test. Water content (moisture content) is the
                quantity of water contained in a material, expressed as a ratio: the mass of water
                divided by the mass of the solids, as a percentage.
            </documentation>
        </annotation>
    </element>
    <complexType name="WaterContentTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="waterContentDerivedFrom"
                        type="diggs:WaterContentMethodEnumType">
                        <annotation>
                            <documentation>
                                How the water content measurement was taken: from the entire
                                specimen or from the trimmings of a prepared specimen. Values come
                                from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryingTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature of the oven or other drying apparatus.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time the specimen was kept at the drying temperature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="calciumCarbonateGasPressureMoistureReading"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The reading, if a calcium carbonate gas pressure moisture tester is
                                used.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="heatingCycleParameters"
                        type="diggs:HeatingCycleParametersPropertyType">
                        <annotation>
                            <documentation>
                                The parameters of a heating cycle. Repeat for each cycle.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="HeatingCycleParameters" type="diggs:HeatingCycleParametersType" abstract="false">
        <annotation>
            <documentation>
                The parameters of a heating cycle in a water content test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="HeatingCycleParametersType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="heatingIncrementNumber" type="integer">
                        <annotation>
                            <documentation>
                                The number of the heating increment these parameters belong to: 1, 2
                                and so on.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="heatingSource" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The source of heating, for example microwave, hot plate or heat
                                lamp. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="heatingDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration of the heating.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="microwavePowerSetting" type="string">
                        <annotation>
                            <documentation>
                                The power setting, if a microwave is the heating source.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="massOfSamplePlusContainer"
                        type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the sample plus its container.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="HeatingCycleParametersPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:HeatingCycleParameters object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:HeatingCycleParameters"/>
        </sequence>
    </complexType>
</schema>
