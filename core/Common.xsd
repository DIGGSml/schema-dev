        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Project</appinfo>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:projectRef"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use projectRef. A reference to a project, other than the one that
                established the feature, that uses the feature within its business activity. Given
                by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="easting" type="diggs:LengthMeasureType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="a geometry object in the location property"/>
            </appinfo>
            <documentation>DEPRECATED. Use a geometry object in the location property. The easting
                or x-coordinate value.</documentation>
        </annotation>
    </element>
    <element name="northing" type="diggs:LengthMeasureType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="a geometry object in the location property"/>
            </appinfo>
            <documentation>DEPRECATED. Use a geometry object in the location property. The northing
