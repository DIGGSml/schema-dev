    <!-- =========================================================================== -->
    <!-- COMMON OBJECTS                                                              -->
    <!-- =========================================================================== -->

    <element name="Address" type="diggs:AddressType" substitutionGroup="gml:AbstractGML"
        abstract="false">
        <annotation>
            <documentation>A collection of information used to give the location of a building,
                apartment, or other structure.</documentation>
        </annotation>
    </element>
    <complexType name="AddressType">
        <annotation>
            <documentation>Complex type: AddressType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element name="number" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>THouse or building number</documentation>
                        </annotation>
                    </element>
                    <element name="streetAddress" type="string" minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The street address.Buildin number may also e included here if number is not used. If used, this property should only hold the street name.</documentation>
                        </annotation>
                    </element>
                    <element name="city" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The city property.</documentation>
                        </annotation>
                    </element>
                    <element name="state" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The state property.</documentation>
                        </annotation>
                    </element>
                    <element name="province" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The province property.</documentation>
                        </annotation>
                    </element>
                    <element name="county" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The county property.</documentation>
                        </annotation>
                    </element>
                    <element name="country" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The country property.</documentation>
                        </annotation>
                    </element>
                    <element name="postalCode" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Code or identifier for the postal.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AssociatedFile" type="diggs:AssociatedFileType" abstract="false">
        <annotation>
            <documentation>An object that provides information about external files or documents
                associated with the containing features.</documentation>
        </annotation>
    </element>
    <complexType name="AssociatedFileType">
        <annotation>
            <documentation>Complex type: AssociatedFileType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" name="contact"
                            type="diggs:BusinessAssociatePropertyType" maxOccurs="unbounded">
                            <annotation>
                                <documentation>The person or business to contact about this file.
                                    This property should be populated where a fileURL is not
                                    provided.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="1" name="fileURL" type="anyURI">
                            <annotation>
                                <documentation>Path to the digital file</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="fileType" type="gml:CodeType">
                            <annotation>
                                <documentation>Digital file type, typically denoted by the file
                                    extension (eg. .jpg, .pdf)</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="creatingApplication"
                            type="diggs:SoftwareApplicationPropertyType">
                            <annotation>
                                <documentation>Name of the application that created the file, where
                                    applicable.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="documentType" type="gml:CodeType">
                            <annotation>
                                <documentation>For documents, the type of document that the file
                                    represents, such as photo, report, log, etc.). </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="fileDate"
                            type="gml:TimePositionType">
                            <annotation>
                                <documentation>Date file created or last modified.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" ref="diggs:fileStructure"/>
                        <element minOccurs="0" name="mimeType" type="diggs:MimeTypeEnumExtType">
                            <annotation>
                                <documentation>The mime type of the file, from an enumerated list.
                                    Non-registered mime types should be entered as Other:
                                    type/subtype where the subtype should begin with "x-", eg.
                                    application/x-segy.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="compression" type="anyURI">
                            <annotation>
                                <documentation>A value that identifies the compression algorithm
                                    used, if applicable (eg LZW).</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="encryption" type="anyURI">
                            <annotation>
                                <documentation>A value that identifies the file encryption algorithm
                                    used, if applicable (eg. AES).</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AuthorizedParameter" type="diggs:AuthorizedParameterType">
        <annotation>
            <documentation>An object containing the name, value or range of values, and unit of
                measure of a property or measurement parameter, where the name is bound to a
                definition in a properties dictionary and the data type of the value is declared.
                Use this in preference to diggs:Parameter wherever the parameter being reported has
                a dictionary definition: a consumer can then type the value and check it against the
                definition without inferring anything from its lexical form. Use diggs:Parameter
                where the name is genuinely uncontrolled. AuthorizedParameter is accepted anywhere
                diggs:ParameterPropertyType or diggs:ParameterArrayPropertyType is used.</documentation>
        </annotation>
    </element>
    <complexType name="AuthorizedParameterType">
        <annotation>
            <documentation>Complex type: AuthorizedParameterType. A parameter whose name is
                dictionary-bound and whose value carries a declared data type. Parallel to
                diggs:ParameterType, from which it is deliberately not derived; see the comment
                preceding the AuthorizedParameter element declaration.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="parameterName"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>A code identifying what the value property represents.
                                The codeSpace attribute is mandatory and must contain the URI of the
                                definition in a properties dictionary (eg. codeSpace="https://diggsml.org/def/codes/DIGGS/0.1/properties.xml#liquid_limit"),
                                so that an application can resolve and validate the name. Where no
                                such definition exists, use diggs:Parameter instead.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="typeData"
                        type="diggs:DataTypeEnumType">
                        <annotation>
                            <documentation>The data type of the parameter value (eg. double, long,
                                string, etc.). Mandatory: declaring the type is the point of this
                                object, so that a consumer need not infer it from the lexical form
                                of the value or resolve the dictionary definition to obtain it. The
                                type is diggs:DataTypeEnumType and not
                                diggs:PropertyDataTypeEnumType, which additionally permits the empty
                                string; there is no unknown-type case here.</documentation>
                        </annotation>
                    </element>
                    <element name="parameterMinValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>For numeric parameter values where a value range is
                                expressed instead of a fixed value, this property contains the
                                minimum value of the range.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="parameterValue" type="string">
                        <annotation>
                            <documentation>A value associated with the name.</documentation>
                        </annotation>
                    </element>
                    <element name="parameterMaxValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>For numeric parameter values where a value range is
                                expressed instead of a fixed value, this property contains the
                                maximum value of the range.</documentation>
                        </annotation>
                    </element>
                    <element name="parameterUnits" type="diggs:AllUnits" minOccurs="0">
                        <annotation>
                            <documentation>Unit of measure of the parameter.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>An integer that indicates the order of the parameter
                            results.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="Boundary" type="diggs:BoundaryType">
        <annotation>
            <documentation>An object that contains properties describing a layer, interval, or zone
                boundary (eg. dip angle, sharpness, etc.)</documentation>
        </annotation>
    </element>
    <complexType name="BoundaryType">
        <annotation>
            <documentation>Complex type: BoundaryType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location"/>
                    <element minOccurs="0" name="dipAngle" type="diggs:DipMeasureType">
                        <annotation>
                            <documentation>The inclinaton angle in degrees of the boundary surface,
                                as measured downward from the horizontal.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dipDirection" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>The direction of the true dip of the boundary surface, as
                                measured clockwise with respect to true north.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="distinctness" type="gml:CodeType">
                        <annotation>
                            <documentation>A controlled string (preferably) that defines how
                                distinctly the boundary between zones is defined, as governed by
                                both the contrast between adjacent zones and by the width of the
                                boundary. (eg. sharp, gradational)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="origin" type="gml:CodeType">
                        <annotation>
                            <documentation>A controlled string (preferably) that defines the
                                specific nature or origin of the boundary. (eg. unconformity, fault,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="topography" type="gml:CodeType">
                        <annotation>
                            <documentation>A controlled string (preferably) that defines the shape
                                of the boundary surface between zones. (eg. wavy)</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>A value that describes the method by which the observation or
                            measurement was determined. </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="BusinessAssociate" type="diggs:BusinessAssociateType" abstract="false">
        <annotation>
            <documentation>A person or entity who performs functions, activities, or
                services.</documentation>
        </annotation>
    </element>
    <complexType name="BusinessAssociateBaseType">
        <annotation>
            <documentation>Complex type: BusinessAssociateBaseType</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element ref="diggs:internalIdentifier" minOccurs="0"/>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="associatedFile"
                            type="diggs:AssociatedFilePropertyType">
                            <annotation>
                                <documentation>Identifies external files associated with this
                                    feature.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>The remark property.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="BusinessAssociateType">
        <annotation>
            <documentation>Complex type: BusinessAssociateType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:BusinessAssociateBaseType">
                <sequence>
                    <element name="title" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>A title for a person (eg. Mr., Ms., Sra., Dr. etc) that
                                precedes the name. Corporate titles (eg. Inc., Ltd., etc) or
                                suffixes (eg. PhD) would not be entered here, but included in the
                                BusinessAssociate's name.</documentation>
                        </annotation>
                    </element>
                    <element name="address" type="diggs:AddressPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Mailing address for the BusinessAssociate</documentation>
                        </annotation>
                    </element>
                    <element name="emailAddress" type="diggs:EmailType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>An email address for the BusinessAssociate. The type of
                                email (eg. business or personal) is defined in the type
                                attribute.</documentation>
                        </annotation>
                    </element>
                    <element name="phoneNumber" type="diggs:PhoneType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A telephone number for the BusinessAssociate. The type of
                                number (eg. mobile, fax, etc.) is described in the type
                                attribute.</documentation>
                        </annotation>
                    </element>
                    <element name="associatedWith" type="diggs:BusinessAssociatePropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:BusinessAssociate</appinfo>
                            <documentation>A BusinessAssociate that is associated with this one.
                                This can be an xlink:href pointer to the gml:id of another
                                BusinessAssociate object or an embedded BusinessAssociate
                                object</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Calibration" type="diggs:CalibrationType" abstract="false">
        <annotation>
            <documentation>An object containing properties pertaining to instrument
                calibration.</documentation>
        </annotation>
    </element>
    <complexType name="CalibrationType">
        <annotation>
            <documentation>Type for instrument calibration information. Contains calibration data,
                calibration values, date, and use since last calibration. Documents calibration
                history and parameters for equipment and sensors.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element minOccurs="0" name="calibrationData" type="gml:StringOrRefType">
                        <annotation>
                            <documentation>Procedure and recorded data obtained during calibration.
                                This can be represented as text or as a reference to another object
                                or external file via an xlink:href attribute</documentation>
                        </annotation>
                    </element>
                    <element name="cqlibrationValues" type="diggs:ParameterArrayPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Date calibration was perfomed</documentation>
                        </annotation>
                    </element>
                    <element name="date" type="gml:TimePositionType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Date calibration was perfomed</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="useSinceLastCalibration" type="string">
                        <annotation>
                            <documentation>Note about the amount of use of the equipment since the
                                last calibration.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Contract" type="diggs:ContractType" abstract="false">
        <annotation>
            <documentation>An object that contains properties of a business
                contract.</documentation>
        </annotation>
    </element>
    <complexType name="ContractType">
        <annotation>
            <documentation>Complex type: ContractType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element name="version" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The version number or name of this
                                contract</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="contractDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The date the contract went into effect.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="revisionDate" type="gml:TimePositionType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The date when the contract was revised.</documentation>
                        </annotation>
                    </element>
                    <element name="type" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The type of contract.</documentation>
                        </annotation>
                    </element>
                    <element name="value" type="diggs:CostType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The total value of the contract.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ElevationType">
        <annotation>
            <documentation>Extends diggs:LengthMeasureType to add an srsName attribute defining the
                vertical CRS for a scalar level value.
                
                USE THIS ONLY FOR A LEVEL THAT HAS NO DEFINITE POSITION - an average or other
                statistic over an area, such as a mean existing ground level or a mean water table.
                An elevation that IS the elevation of a point on a feature is a position, not a
                length, and takes diggs:PointLocationPropertyType instead; that type carries srsName
                natively, supports one-dimensional, linear-referenced and three-dimensional frames
                alike, and can be referenced by other objects because it has a gml:id.</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:LengthMeasureType">
                <attribute name="srsName" type="anyURI"/>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="EmailStringType">
        <annotation>
            <documentation>Pattern-constrained string for email addresses. Enforces basic email
                format validation.</documentation>
        </annotation>
        <restriction base="string">
            <pattern value="([A-z0-9_\.\-\+])+@(([A-z0-9_\-]{2,})\.)+[A-z0-9_\-]{2,}"/>
        </restriction>
    </simpleType>
    <complexType name="EmailType">
        <annotation>
            <documentation>Complex type: EmailType</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:EmailStringType">
                <attribute name="type" type="diggs:ExtEmailEnumType">
                    <annotation>
                        <documentation>Type classification for the element.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="Environment" type="diggs:EnvironmentType" abstract="false">
        <annotation>
            <documentation>A collection of environmental parameters recorded at a specific time
                instant.</documentation>
        </annotation>
    </element>
    <complexType name="EnvironmentType">
        <annotation>
            <documentation>Complex type: EnvironmentType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The date time for this item.</documentation>
                        </annotation>
                    </element>
                    <element name="ambientTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Ambient air temperature reported as a single value at the
                                time of measurement</documentation>
                        </annotation>
                    </element>
                    <element name="barometricPressure" type="diggs:PressureMeasureType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Barometric pressure reported as a single value at the
                                time of measurement</documentation>
                        </annotation>
                    </element>
                    <element name="humidity" type="diggs:VolumePerVolumeMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>Atmospheric humidity reported as a single value at the
                                time of measurement</documentation>
                        </annotation>
                    </element>
                    <element name="weather" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>General description of the weather (eg. sunny, partly
                                cloudy, etc.)</documentation>
                        </annotation>
                    </element>
                    <element name="windSpeed" type="diggs:LengthPerTimeMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>Wind speed reported as a single value at the time
                                measurement was taken</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherEnvironmentalProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The other environmental property
                                property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="FeatureReferenceType">
        <annotation>
            <documentation>This type is used to point to a DIGGS feature (by its gml:id in the
                xlink:href attribute) or by its gml:identifier (using indentifierRef
                attribute to encode the value of gml:identifier for the same feature)</documentation>
        </annotation>
        <complexContent>
            <extension base="gml:ReferenceType">
                <attribute name="identifierRef" type="diggs:IdentifierReferenceType" use="optional">
                    <annotation>
                        <documentation>Provides a fully qualified gml:identifier value of the target
                            feature. Used primarily to reference a feature by a globally unique
                            identifier as opposed to the gml:id</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="InSituTestEvent" type="diggs:InSituTestEventType">
        <annotation>
            <documentation>An object detailing a time or location-based event that may occur during
                an in-situ test.</documentation>
        </annotation>
    </element>
    <complexType name="InSituTestEventType">
        <annotation>
            <documentation>Complex type: InSituTestEventType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LaboratoryTestEvent" type="diggs:LaboratoryTestEventType">
        <annotation>
            <documentation>An object that records events observed during a laboratory test. This
                object is a concrete representation of AbstractEvent with no additional
                properties.</documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="LaboratoryTestEventType">
        <annotation>
            <documentation>Complex type: LaboratoryTestEventType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status">
                        <annotation>
                            <documentation>A text string to provide information about the status of
                                the object to be used to track QA/QC controls, review or release
                                status, etc. The values used are intended to come from a controlled
                                list of terms maintained by an organization.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:remark"/>
                    <element minOccurs="0" name="time" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Date/time when this event information was
                                recorded</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="infoRecorded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>Other associated data measured or observed at this
                                time</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="Limit" substitutionGroup="gml:AbstractGML"
        type="diggs:LimitType">
        <annotation>
            <documentation>An object containing properties of the detection limits of a
                measurement.</documentation>
        </annotation>
    </element>
    <complexType name="LimitType">
        <annotation>
            <documentation>The type for the detection or measurement limit reported. Contains constraint, limit
                type, value, and out-of-limit value. Used to document detection limits,
                quantification limits, and other measurement constraints.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="constraint" type="gml:CodeType">
                        <annotation>
                            <documentation>The constraint defines a condition under which the limit
                                applies</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="limitType"
                        type="diggs:QualifierEnumExtType">
                        <annotation>
                            <documentation>An enumerated list of terms that decribe the type of limit
                                reported. Allowable values are documented in the associated enumerated list (diggs:QualifierEnumExtType)</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="value" type="string">
                        <annotation>
                            <documentation>The value of the limit. </documentation>
                        </annotation>
                    </element>
                    <element name="outOfLimitValue" type="string">
                        <annotation>
                            <documentation>Value that is reported to signify that the result is out of the allowable limit range</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LocalCoordinate" type="diggs:LocalCoordinateType">
        <annotation>
            <documentation>A metadata object that holds the values of local coordinates for the
                reference point of the associated feature.</documentation>
        </annotation>
    </element>
    <complexType name="LocalCoordinateType">
        <annotation>
            <documentation>Contains properties for the LocalCoordinate object either as specific x,
                y and elevation coordinates. or a DIGGS geometry object with containing the same
                coordinates</documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <choice>
                        <sequence>
                            <element minOccurs="0" ref="diggs:easting"/>
                            <element minOccurs="0" ref="diggs:northing"/>
                            <element minOccurs="0" ref="diggs:elevation"/>
                        </sequence>
                        <element minOccurs="0" ref="diggs:location"/>
                    </choice>
                    <element minOccurs="0" name="localCoodinateUncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>Uncertainty for local coordinates</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Locality" type="diggs:LocalityType" substitutionGroup="gml:AbstractGML"
        abstract="false">
        <annotation>
            <documentation>An object that describes non-coordinate location information for a
                feature.</documentation>
        </annotation>
    </element>
    <complexType name="LocalityType">
        <annotation>
            <documentation>Complex type: LocalityType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element name="address" type="diggs:AddressPropertyType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>The address property.</documentation>
                        </annotation>
                    </element>
                    <element name="district" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a
                                District </documentation>
                        </annotation>
                    </element>
                    <element name="division" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a
                                Division </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lot" type="string">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a Lot
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parceI" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a Parcel
                            </documentation>
                        </annotation>
                    </element>
                    <element name="plss" type="diggs:PlssPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The plss property.</documentation>
                        </annotation>
                    </element>
                    <element name="quadrangle" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a map
                                quadrange </documentation>
                        </annotation>
                    </element>
                    <element name="route" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of the route along which a centerline survey
                                is designated</documentation>
                        </annotation>
                    </element>
                    <element name="segment" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID for an interval or section of a route along
                                whick a centerline survey is designated.</documentation>
                        </annotation>
                    </element>
                    <element name="station" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>Name of the station along a centerline survey. This must
                                be a numeric value, with a unit of measure (eg. ft) specified in the
                                uom attribute. Systems that store station values as a string that
                                include a plus sign (+) need to strip out the + and specify the uom
                                for encoding to DIGGS. </documentation>
                        </annotation>
                    </element>
                    <element name="mileMarker" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>A reference point along a route to indicate either
                                distance travelled or the remaining distance to a destination. Such
                                references are also used by maintenance engineers and emergency
                                services to direct them to specific points where their presence is
                                required. This term is sometimes used to denote a location on a road
                                even if no physical sign is present. This is a numerical value a may
                                differ from a station id used for specific route
                                surveys.</documentation>
                        </annotation>
                    </element>
                    <element name="offset" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1" form="qualified">
                        <annotation>
                            <documentation>Distance measured perpendicular from the station. Unless
                                offsetDirection is specified, positive values imply an offset to the
                                right when facing in the direction of increasing station value.
                                Negative values imply an offset to the left.</documentation>
                        </annotation>
                    </element>
                    <element name="offsetDirection" type="diggs:OffsetDirectionEnumExtType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Direction of the offset measured along the centerline
                                survey. Allowable values are left and right (when facing in the
                                direction of increasing station value.</documentation>
                        </annotation>
                    </element>
                    <element name="tract" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a Tract
                            </documentation>
                        </annotation>
                    </element>
                    <element name="watershed" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name or ID of a territory of land classified as a
                                Watershed </documentation>
                        </annotation>
                    </element>
                    <element name="otherLocalityProperty" type="diggs:ParameterPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Other type of locality designation, given as a name-value
                                pair within a Parameter object.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LocationUncertainty" type="diggs:LocationUncertaintyType" abstract="false">
        <annotation>
            <documentation>Location uncetainty is intended to describe positional uncertainty associated with a geometry, not to alter or replace the geometry itself. Uncertainty values are expressed in the units of the geometry’s CRS and may be provided using axis-based or radial (horizontal/vertical) representations. Multiple representations may coexist and are considered alternative expressions of the same uncertainty.</documentation>
        </annotation>
    </element>
    <complexType name="LocationUncertaintyType">
        <annotation>
            <documentation>Complex type: LocationUncertaintyType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="locationMethod"
                        type="diggs:LocationMethodEnumExtType">
                        <annotation>
                            <documentation>The method used to determine the coordinate
                                information.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="horizontalUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                Radial horizontal uncertainty, expressed in the units of the horizontal CRS axes.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                Vertical uncertainty, expressed in the units of the vertical CRS axis.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="xValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>Uncertainty for the x-axis value of a location
                                coordinate.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="yValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>Uncertainty for the y-axis value of a location
                                coordinate.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="zValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>Uncertainty for the z value of a location
                                coordinate.</documentation>
                        </annotation>
                    </element>

                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MeasurementTechniqueEnumType">
        <annotation>
            <documentation>Complex type: MeasurementTechniqueEnumType</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:DescriptorMethodEnumType">
                <attribute name="formula" type="string">
                    <annotation>
                        <documentation>A description of the formula used to obtain the measurement
                            result.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="NullDataType">
        <annotation>
            <documentation>Complex type: NullDataType</documentation>
        </annotation>
        <simpleContent>
            <extension base="string">
                <attribute name="reason" type="gml:NilReasonType" use="optional">
                    <annotation>
                        <documentation>The reason attribute.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="OtherMimeTypeType">
        <annotation>
            <documentation>Simple type: OtherMimeTypeType</documentation>
        </annotation>
        <restriction base="string">
            <pattern value="Other: [a-z\-\+\.]+/[a-z0-9\-\+\.]+"/>
        </restriction>
    </simpleType>
    
    <!-- diggs:ParameterType is the uncontrolled form: the name may be free text and the
         value is soft-typed, which is correct for the otherProperty bags this type mostly
         serves. Where the parameter has a dictionary definition, use
         diggs:AuthorizedParameter (declared above, in the alphabetical A block of this
         file) instead — it makes codeSpace mandatory on parameterName and adds a
         mandatory typeData. The two types share five particles and the index attribute by
         deliberate duplication rather than derivation; keep them in step. -->
    <element name="Parameter" type="diggs:ParameterType">
        <annotation>
            <documentation>An object containing the name, value or range of values and unit of
                measure of a property or a measurement parameter (result).</documentation>
        </annotation>
    </element>
    <complexType name="ParameterType">
        <annotation>
            <documentation>Complex type: ParameterType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="1" name="parameterName" type="gml:CodeType">
                        <annotation>
                            <documentation>A description or code to what the value property
                                represents. Best practice is to point to a property definition from a standard proerties dictionary in the codeSpace attribute (eg. codeSpace=" https://diggsml.org/def/codes/DIGGS/0,1/properties.xml#liquid_limit")</documentation>
                        </annotation>
                    </element>

                    <element name="parameterMinValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>For numeric parameter values where a value range is
                                expressed instead of a fixed value, this property contains the
                                minimum value of the range.</documentation>
                        </annotation>
                    </element>

                    <element minOccurs="0" name="parameterValue" type="string">
                        <annotation>
                            <documentation>A value associated with the name.</documentation>
                        </annotation>
                    </element>
                    <element name="parameterMaxValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>For numeric parameter values where a value range is
                                expressed instead of a fixed value, this property contains the
                                maximum value of the range.</documentation>

                        </annotation>
                    </element>
                    <element name="parameterUnits" type="diggs:AllUnits" minOccurs="0">
                        <annotation>
                            <documentation>Unit of measure of the parameter.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>An integer that indicates the order of the parameter
                            results.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="PhoneNumberStringType">
        <annotation>
            <documentation>Pattern-constrained string for phone numbers. Enforces basic phone number
                format validation.</documentation>
        </annotation>
        <restriction base="string">
            <pattern
                value="(\+[0-9]( )?)?([0-9]( |-|\.|)){6,14}[0-9]|(\([0-9]{3}\)[-. ]?|[0-9]{3}[-. ])[0-9]{3}[-. ]?[0-9]{4} "
            />
        </restriction>
    </simpleType>
    <complexType name="PhoneType">
        <annotation>
            <documentation>Complex type: PhoneType</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:PhoneNumberStringType">
                <attribute name="type" type="diggs:ExtPhoneEnumType">
                    <annotation>
                        <documentation>Type classification for the element.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="PLSS" type="diggs:PlssType" abstract="false">
        <annotation>
            <documentation>Land subdivisions of the US Public Land Survey System</documentation>
        </annotation>
    </element>
    <complexType name="PlssType">
        <annotation>
            <documentation>Complex type: PlssType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element name="township" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>An approximately 6-mile square area of land, containing
                                36 sections. Also, a horizontal row of townships in the
                                PLSS.</documentation>
                        </annotation>
                    </element>
                    <element name="range" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>A vertical column of townships in the
                                PLSS.</documentation>
                        </annotation>
                    </element>
                    <element name="section" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The name of the section; a one-square-mile block of land,
                                containing 640 acres, or approximately one thirty-sixth of a
                                township. Due to the curvature of the Earth, sections may
                                occasionally be slightly smaller than one square
                                mile.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="aliquotPart" type="string">
                        <annotation>
                            <documentation>The name of the standard subdivisions of a section, such
                                as a half section, quarter section, or quarter-quarter
                                section.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="governmentLot" type="string">
                        <annotation>
                            <documentation>The name of a subpart of a section which is not described
                                as an aliquot part of the section, but which is designated by
                                number, for example, Lot 3. A lot may be regular or irregular in
                                shape, and its acreage may vary from that of regular aliquot parts.
                                These lots frequently border water areas excluded from the
                                PLSS.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baseAndMeridian" type="string">
                        <annotation>
                            <documentation>The name of the point chosen as the starting point for
                                all sectionalized land within a given area. Ths point is located at
                                the intersection of a base line (parallel of latitude, or
                                approximately a parallel of latitude), and a principal
                                meridian.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="landGrant" type="string">
                        <annotation>
                            <documentation>The name of an area of land to which title was conferred
                                by a predecessor government and confirmed by the U.S Government
                                after the territory in which it is situated was acquired by the
                                United States. These lands were never part of the original public
                                domain and were not subject to subdivision by the
                                PLSS.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ProgramScope" type="diggs:ProgramScopeType">
        <annotation>
            <documentation>An object declaring the population of features to which a program design,
                specification or acceptance criterion applies.</documentation>
        </annotation>
    </element>
    <complexType name="ProgramScopeType">
        <annotation>
            <documentation>Declares the population of features to which a program design or
                specification applies. Scope is prospective and declarative: it states where the
                provision applies, not which realized features fulfil it. A realized feature asserts
                its own membership through programDesignRef / programSpecificationRef.</documentation>
        </annotation>
        <sequence>
            <element minOccurs="0" name="appliesToFeatureType" type="gml:CodeType">
                <annotation>
                    <documentation>The kind of feature this provision governs, eg. "RigidInclusion",
                        "LoadTransferPlatform". From a controlled list. May accompany any of the
                        branches below, or stand alone for a provision that applies to every feature
                        of that kind in the program.</documentation>
                </annotation>
            </element>
            <choice minOccurs="0">
                <sequence>
                    <element name="zoneExtent" type="diggs:SurfacePropertyType">
                        <annotation>
                            <documentation>A surface (polygon) within which this provision applies.
                                Bounds applicability; states no layout. This is the only form
                                available to a provision that does not know the layout - which is
                                the normal case for a specification or an acceptance criterion.
                                Where plannedPositions also appears, the planned population is the
                                grid's lattice INTERSECTED WITH this surface; a node on the boundary
                                is included.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plannedPositions"
                        type="diggs:PlannedPositionsPropertyType">
                        <annotation>
                            <documentation>The planned layout within the zone. The grid registers
                                where the lattice sits, and its limits need only COVER the zone - it
                                does not enumerate the features, and index positions falling outside
                                zoneExtent are not part of the population. Optional: a design that
                                states no layout inherits one through basedOnRef.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <element name="plannedPositions" type="diggs:PlannedPositionsPropertyType">
                    <annotation>
                        <documentation>The planned layout, where the layout itself delimits the
                            population and no separate zone boundary is drawn. This is the one case
                            in which the grid's limits ARE the population, there being nothing to
                            intersect with - appropriate for a test panel or any layout whose extent
                            genuinely is the lattice.</documentation>
                    </annotation>
                </element>
                <element maxOccurs="unbounded" name="appliesToFeatureRef"
                    type="diggs:FeatureReferenceType">
                    <annotation>
                        <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeature</appinfo>
                        <documentation>An explicit set of existing features this provision applies
                            to. Valid only where those features PRECEDE the design - remedial or
                            retrofit work. For prospective design use zoneExtent or
                            plannedPositions; a design must not reference features it has not yet
                            caused to exist.</documentation>
                    </annotation>
                </element>
            </choice>
        </sequence>
    </complexType>
    <element name="ProjectEvent" type="diggs:ProjectEventType">
        <annotation>
            <documentation>An object that contains properties of time or location related events
                associated with a project.</documentation>
        </annotation>
    </element>
    <complexType name="ProjectEventType">
        <annotation>
            <documentation>Complex type: ProjectEventType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="Property" type="diggs:PropertyType" substitutionGroup="gml:AbstractValue"
        abstract="false">
        <annotation>
            <documentation>An object that contains properties of a measurement
                result.</documentation>
        </annotation>
    </element>
    <element name="PropertyParameters" type="diggs:PropertyParametersType"
        substitutionGroup="gml:CompositeValue">
        <annotation>
            <documentation>An object that contains the properties of a measurement
                result.</documentation>
        </annotation>
    </element>
    <complexType name="PropertyParametersType">
        <annotation>
            <documentation>Complex type: PropertyParametersType</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:CompositeValueType">
                <sequence>
                    <element ref="diggs:properties" minOccurs="1"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="PropertyType">
        <annotation>
            <documentation>Complex type: PropType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="propertyName" type="gml:CodeType">
                        <annotation>
                            <documentation>A code or name for the property as used by the data
                                provider. This value can come from a controlled list of terms or be
                                an uncontrolled text string. The value would be commonly used to
                                label a column of a log sheet or provide other local meaning to the
                                property. The value of mnemonic should be unique for all of the
                                properties included in the dataValue block transmitted as part of
                                this measurement.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="typeData"
                        type="diggs:PropertyDataTypeEnumType">
                        <annotation>
                            <documentation>The data type for this property (eg. double, long,
                                string, etc.)</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="propertyClass"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>The official name of this property as derived from a
                                dictionary of defined terms. The codespace value must be populated
                                and should contain the URN to allow applications to validate this
                                value as a known property.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="uom" type="diggs:AllUnits">
                        <annotation>
                            <documentation>Unit of measurement for the property.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="atTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>Temperature at which property value is valid, eg. for
                                specific gravity of solids at 20 deg C, this parameter would hold
                                the temperature value</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisBearing"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>Compass bearing direction (relative to true north)
                                defining the measurement axis direction (for directional
                                measurements, eg. component of an extensometer, accelerometer,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisInclination"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>Inclination of measurement axis (measured positively down
                                from horizontal); used for directional measurements, eg.
                                extensometer, accelerometer, etc. </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="nullValue" type="diggs:NullDataType">
                        <annotation>
                            <documentation>An empty string is the default representation of a null
                                value for a property (i.e. when the null value representation is not
                                explicitly defined). This value defines a value to be interpreted as
                                null for this property in the dataValues block. The reason attribute
                                can be used to define the reason for the null value, (eg. witheld).
                                This can be customized with an other: qualifier (eg. other:below
                                detection limit) or reference a URI for a more complete
                                definition.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="context" type="string">
                        <annotation>
                            <documentation>If the property should be interpreted in a particular
                                context (eg. value is only valid for range of overburden pressures,
                                etc.), then the context of the property is described
                                here.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleFraction" type="diggs:SampleFractionEnumType">
                        <annotation>
                            <documentation>Fraction of total sample analyzed (from enumerated list).
                                Applies primarily to non-soil type samples </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="grainsizeFraction"
                        type="diggs:SizeFractionPropertyType">
                        <annotation>
                            <documentation>For properties of soils, the size fraction that this
                                property pertains to </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="correctionUsed"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>A description of corrections used to obtain the reported
                                result. Commonly used to report N-values from SPT tests, or to
                                describe any other adjustments made to the reported data. Can come
                                from a controlled list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementTechnique"
                        type="diggs:MeasurementTechniqueEnumType">
                        <annotation>
                            <documentation>The method by which the property value is obtained. From
                                an enumerated list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="inputParameter"
                        type="diggs:InputParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>A property that provides the value of an input paramter used in the calculation of this Property's value.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedureRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>The procedure ref property.</documentation>
                        </annotation>
                    </element>
                    <element name="detectorRef" type="gml:ReferenceType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <appinfo>diggs:Detector</appinfo>
                            <documentation>A property element that supports a value by reference
                                only. The target value is indicated in the appinfo
                                element.</documentation>
                            <documentation>A reference to the source detector within a sensor used
                                to measure this property, if applicable. Generally used for well
                                log,downhole logging procedures, monitorin equipment, or MWD
                                readings.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="detectionLimits"
                        type="diggs:LimitArrayPropertyType">
                        <annotation>
                            <documentation>Identifies the range of allowable values for this
                                property in the UOM for this property</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="reportable" type="boolean"
                        default="true">
                        <annotation>
                            <documentation>True or false, indicates whether the value of this
                                property can be reported outside of the context of transmission via
                                an xml instance.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="qualifier"
                        type="diggs:QualifierPropertyType">
                        <annotation>
                            <documentation>One or more parameter objects (listing name, value or
                                min/max value of parameters that may be used to qualify the result
                                of this property</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="curveState"
                        type="diggs:ChannelStateEnumType">
                        <annotation>
                            <documentation>Used for well logging procedures, to define the state or
                                status of the data described by the well log curve. From an
                                enumerated list.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="curveDerivation"
                        type="diggs:ChannelDerivationEnumType">
                        <annotation>
                            <documentation>For well logging procedures, defines the source of the
                                data.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="samplingRate"
                        type="diggs:ReciprocalTimeMeasureType">
                        <annotation>
                            <documentation>The raw rate of measurement collection from which any
                                moving averages may be derived. This property should be reported if
                                the value of the measurementTechnique property is moving
                                average.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>An integer that indicates the position of the property result
                            in the dataValues property.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="InputParameter" type="diggs:InputParameterType"/>
    <complexType name="InputParameterType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="parameter" type="diggs:ParameterPropertyType"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="inputParameter"
                        type="diggs:InputParameterPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ProvenancedParameter" type="diggs:ProvenancedParameterType">
        <annotation>
            <documentation>An AuthorizedParameter that additionally states what its value describes
                and where the value came from. Use this in preference to diggs:AuthorizedParameter
                wherever a value's provenance needs to be traceable — a design or basis value derived
                from, or assigned on the strength of, specific evidence. ProvenancedParameter is
                accepted anywhere diggs:ParameterPropertyType or diggs:ParameterArrayPropertyType is
                used, and is the only variant accepted by
                diggs:ProvenancedParameterPropertyType / diggs:ProvenancedParameterArrayPropertyType,
                which are used where provenance is not merely permitted but required.</documentation>
        </annotation>
    </element>
    <complexType name="ProvenancedParameterType">
        <annotation>
            <documentation>Complex type: ProvenancedParameterType. Extends diggs:AuthorizedParameterType
                by plain extension, adding the value's subject and source. A provenanced parameter
                genuinely IS an authorized parameter that carries its provenance, so this is
                inheritance rather than composition around a wrapper element.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AuthorizedParameterType">
                <sequence>
                    <element minOccurs="0" maxOccurs="1" name="subjectRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>A reference to the feature or object that the parameter
                                value describes — for example a geotechnical unit, a material, or a
                                sampling feature. Optional because the subject is sometimes evident
                                from context (the object or property that holds this
                                ProvenancedParameter); state it explicitly wherever that context is
                                not enough to identify the subject unambiguously.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="1" name="derivation" type="gml:CodeType">
                        <annotation>
                            <documentation>How the value was derived from its source(s). Typical
                                values: characteristic, mean, lower-bound, correlated,
                                assumed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="sourceRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>A reference to an object providing the value's provenance
                                — typically a Test, an Observation, or a Sounding. Repeatable: a
                                value may be derived from more than one source, for example a
                                correlation drawing on several tests.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DesignFactor" type="diggs:DesignFactorType">
        <annotation>
            <documentation>An AuthorizedParameter that additionally states what the value is
                applied to - a partial or global safety factor, or a material reduction factor,
                naming both the factor itself (parameterName, dictionary-bound) and the action,
                material, resistance or property it modifies (appliesTo). Serves Design Parameter
                Analysis Group A row 11 (the partial/global factor set a design's safety format
                applies) and row 65 (geosynthetic reduction factors A1-A5 / material factor f_m,
                reused by row 93's durability RF chain).

                WHY A NEW TYPE RATHER THAN A Parameter ARRAY: a bare AuthorizedParameter names one
                thing and carries one value. A factor set needs a second coded dimension - the
                same partial factor concept (say, a resistance factor) takes different values
                depending on what it is applied to, and collapsing factor identity and applies-to
                into one dictionary entry name produces combinatorial growth across every standard
                x factor category combination. Splitting them into two fields is what a Parameter
                array cannot do and what this type exists to add.</documentation>
        </annotation>
    </element>
    <complexType name="DesignFactorType">
        <annotation>
            <documentation>Complex type: DesignFactorType. Extends diggs:AuthorizedParameterType by
                plain extension, adding what the factor applies to - the same inheritance pattern
                diggs:ProvenancedParameterType uses to add provenance. appliesTo necessarily comes
                after the inherited parameterName/typeData/value/units sequence: extension can only
                add particles after what is inherited, not interleave with it.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AuthorizedParameterType">
                <sequence>
                    <element minOccurs="0" name="appliesTo" type="gml:CodeType">
                        <annotation>
                            <documentation>What the factor is applied to - a permanent action, a
                                variable action, a material property such as friction angle, a
                                resistance such as bearing capacity, or a geosynthetic property such
                                as tensile strength. Optional, but stating it is the entire reason
                                this type exists rather than diggs:AuthorizedParameter directly; omit
                                only where the factor's identity already implies what it applies to
                                unambiguously.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignFactorPropertyType">
        <annotation>
            <documentation>Property type for containing a single DesignFactor object. Repeating
                factor sets use a repeated wrapper element of this type, one factor per element -
                matching diggs:RIColumnDesignType/otherProperty and
                diggs:RILTPDesignType/archingCoefficients - rather than one array wrapper containing
                many, per the convention S5 recorded.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DesignFactor" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="DesignAction" type="diggs:DesignActionType">
        <annotation>
            <documentation>An applied load a design must resist - embankment self-weight, traffic
                or other live load, a structure/slab load, a tank, a footing, a surcharge, a
                seismic or wind action - together with the classification a limit-state check needs
                to use it correctly: what kind of action it is, whether it is permanent, variable,
                accidental or seismic, and whether the stated magnitude is a characteristic,
                factored/design or quasi-permanent value.

                GENERIC DESIGN-ACTION MACHINERY, NOT RI-SPECIFIC, so it lives here rather than in
                specialty/RigidInclusions.xsd - any ground-improvement or foundation design that
                states an applied load and needs it correctly classified has the identical problem.
                Motivated by the Design Parameter Analysis's Group H (rows 78-79, "surcharge/live
                load" and "structure/slab load", which are one concept - a distributed load in kPa -
                differing only in origin, and should not be two elements): "actionNature +
                representativeValue are essential and absent from the workbook: under EC7/BS
                limit-state design, whether a stated load is characteristic or factored, permanent
                or variable, changes everything downstream. A file reporting 'q = 20 kPa' without
                them is not usable for checking."

                ALSO ABSORBS, WITHOUT DIRECTLY REPLACING, TWO OTHER GAPS THE SAME ANALYSIS FLAGS.
                Row 47 (the axial load required at one column head) needs exactly this shape -
                "allow repetition keyed by load case (shares the DesignAction shape from Group H)" -
                but is carried today as the single acknowledged-simplification scalar
                diggs:RIColumnDesignType/designAxialLoad; that element's own documentation names
                this type by description ("generic design-action machinery... is not yet built") as
                what a fuller expression would need, and is left as future work rather than migrated
                here, since retiring an existing element is a larger, separate decision. Row 35
                (lateral/bending demand, M and H_lat, which "vary by column position and load case")
                has the same repeating-keyed-by-load-case need; DesignAction does not itself carry a
                moment or lateral-force element - PressureMeasureType/ForceMeasureType are the wrong
                quantity classes for a bending moment - so row 35 remains open for a later task to
                either extend this type or build its own, reusing the pattern established
                here.</documentation>
        </annotation>
    </element>
    <complexType name="DesignActionType">
        <annotation>
            <documentation>Complex type: DesignActionType. Extends
                diggs:AbstractComponentObjectBaseType, the same lightweight base
                diggs:ArchingCoefficientsType and diggs:ReinforcementType use - optional gml:id
                only, no name/description overhead this object doesn't need.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="actionType" type="gml:CodeType">
                        <annotation>
                            <documentation>The kind of action - embankment self-weight, traffic/live
                                load, structure/slab load, tank, footing, surcharge, seismic, wind.
                                Mandatory: an action reported without stating what kind it is, is
                                not interpretable.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="actionNature" type="gml:CodeType">
                        <annotation>
                            <documentation>Permanent, variable, accidental or seismic - the EC7/BS
                                limit-state action classification. Optional in XSD terms, matching
                                this project's general convention that every property is optional
                                and resolution runs per property; but stating it is the entire
                                reason this type exists rather than a bare magnitude, per the
                                element's own top-level documentation.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="representativeValue" type="gml:CodeType">
                        <annotation>
                            <documentation>Whether the stated magnitude is a characteristic,
                                factored/design, or quasi-permanent value. See
                                actionNature.</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="magnitudePressure" type="diggs:PressureMeasureType">
                            <annotation>
                                <documentation>The action's magnitude as a distributed load - the
                                    normal case for a surcharge, embankment self-weight, or slab
                                    load expressed per unit area.</documentation>
                            </annotation>
                        </element>
                        <element name="magnitudeForce" type="diggs:ForceMeasureType">
                            <annotation>
                                <documentation>The action's magnitude as a concentrated (point or
                                    line) load - a footing or tank load stated as a force rather
                                    than a distributed pressure. A quantity class and a distributed
                                    pressure are different data, not two units of one quantity,
                                    which is why this is a separate choice branch rather than a
                                    permissive uom on magnitudePressure - the same reasoning
                                    diggs:RILTPDesignType/sideSlopeRatio's documentation gives for
                                    its own choice.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" maxOccurs="unbounded" name="appliesToZoneRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramDesign</appinfo>
                            <documentation>Where this action applies, for a host design whose own
                                scope covers more than one zone with different loading - for
                                example an RISystemDesign on which several DesignAction entries each
                                govern a different part of the site. References the zone-scoped
                                AbstractProgramDesign (typically an RIColumnDesign or RILTPDesign)
                                whose own ProgramScope/zoneExtent already defines that zone's
                                extent, rather than restating a boundary here: DIGGS already has one
                                mechanism for stating a zone's extent, and this reuses it instead of
                                building a second. Omit where the host design's own scope already
                                identifies the population this action governs - the common
                                case.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignActionArrayPropertyType">
        <annotation>
            <documentation>Property type for arrays of DesignAction objects, matching
                diggs:GeosyntheticArrayPropertyType/diggs:ReinforcementArrayPropertyType's shape -
                one wrapper element containing zero or more DesignAction children - since an action
                array's host particle is single-occurrence
                (maxOccurs="1").</documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:DesignAction"/>
        </sequence>
    </complexType>
    <element name="DesignVerification" type="diggs:DesignVerificationType">
        <annotation>
            <documentation>A design check with an outcome - buckling, shear, global/slope
                stability, lateral spreading, seismic/liquefaction, punching, structural axial, and
                so on - distinguished from a design input or a design output because its meaning
                is not a value but a verdict against a demand and a capacity.

                GENERIC DESIGN-VERIFICATION MACHINERY, NOT RI-SPECIFIC, so it lives here rather
                than in specialty/RigidInclusions.xsd, for the same reason diggs:DesignAction does
                - any foundation or ground-improvement design runs checks of this shape. Motivated
                by the Design Parameter Analysis's F6 ("Inputs, outputs and verifications are
                conflated"): rows 32 (buckling), 33 (shear), 84 (global stability), 86 (lateral
                spreading) and 88 (seismic/liquefaction) are each "not a scalar. Need a small
                object" - a value alone cannot carry a pass/fail verdict, and forcing one into an
                ELEM either drops the verdict or silently repurposes the element as a boolean,
                which loses the demand/capacity reasoning a reviewer needs to check the verdict
                itself.

                REPEATABLE, AND THAT IS LOAD-BEARING FOR ROW 84 SPECIFICALLY: a global stability
                analysis produces one factor of safety per cross-section, per failure surface, per
                static-or-seismic condition, per short-or-long-term condition - "row 84 as a single
                FS scalar cannot carry that." This type does not itself add section or surface
                discriminators - the plan's field list does not call for them - so where several
                DesignVerification repetitions differ only by section or surface, distinguish them
                by gml:name or remark; a typed sectionRef/surfaceRef pair is later work if that
                proves insufficient in practice.

                DISTINCT FROM diggs:AbstractAcceptanceCriterionType (B5/F3): a criterion states a
                LIMIT a design must satisfy, declared on the specification side and checked against
                a realized feature after construction. DesignVerification states the OUTCOME of a
                pre-construction analysis run against that limit, declared on the design side. The
                two are complementary, not alternatives - a buckling criterion (limit) and a
                buckling verification (this design's checked outcome against it) can both exist for
                the same design.</documentation>
        </annotation>
    </element>
    <complexType name="DesignVerificationType">
        <annotation>
            <documentation>Complex type: DesignVerificationType. Extends
                diggs:AbstractComponentObjectBaseType, the same lightweight base
                diggs:DesignActionType and diggs:ReinforcementType use.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="verificationType" type="gml:CodeType">
                        <annotation>
                            <documentation>The kind of check - buckling, shear, global stability,
                                lateral spreading, seismic, liquefaction, punching, structural axial.
                                Mandatory: a verification reported without stating what kind of
                                check it is, is not interpretable.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="method" type="gml:CodeType">
                        <annotation>
                            <documentation>The analysis method used, where the field is method-
                                dependent - for global stability, Column-Wall Method (CWM),
                                Equivalent Strength Method (ESM), Stress Reduction Method (SRM),
                                Pile Support Method (PSM), or numerical analysis with the actual RI
                                layout. Not a neutral label for stability in particular: RIs fail in
                                bending, not shear, so a 2D analysis run with a "composite shear
                                strength" is not defensible, and stating the method here makes that
                                reviewable.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="demand" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The demand value the check compares against capacity -
                                for example the applied shear stress in a shear check, or the
                                applied axial force in a buckling check. diggs:ParameterPropertyType
                                rather than a fixed measure type, because the quantity class is set
                                by verificationType and varies across checks (a stress for shear, a
                                force for buckling, commonly nothing typed at all for a
                                stability/spreading/seismic check that is already fully expressed by
                                utilisationRatio or factorOfSafety below) - the same reasoning
                                diggs:RIColumnDesignType/otherProperty's documentation gives for
                                using the dictionary escape hatch rather than a named element per
                                quantity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="capacity" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The capacity or resistance value the check compares
                                demand against. See demand for why this is
                                diggs:ParameterPropertyType rather than a fixed measure
                                type.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="utilisationRatio"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>Demand divided by capacity. Always dimensionless
                                regardless of verificationType, unlike demand and capacity
                                themselves, so this is a fixed measure type rather than a
                                Parameter.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="factorOfSafety"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>Capacity divided by demand, where the check is
                                conventionally expressed that way round rather than as a
                                utilisation ratio (global stability, lateral spreading). The two
                                are reciprocal framings of the same comparison; state whichever the
                                analysis was run to produce, or both.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outcome" type="gml:CodeType">
                        <annotation>
                            <documentation>The verdict - satisfied, not satisfied, or not required
                                (a check that does not apply to this design, stated rather than
                                omitted so its inapplicability is a recorded decision and not
                                mistakable for an unperformed check). Optional in XSD terms, matching
                                this project's general convention that every property is optional;
                                a DesignVerification stating only verificationType and method, with
                                outcome pending, is still a meaningful record of a check in
                                progress.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="analysisCaseRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:DesignAction</appinfo>
                            <documentation>The load case this verification was run against, as the
                                set of diggs:DesignAction objects whose combination defines that
                                case - for example the permanent and seismic actions active in a
                                seismic buckling check, as opposed to the permanent and variable
                                actions active in a static one. Reuses diggs:DesignAction rather
                                than a bespoke case object or an inline code, for the same reason
                                diggs:DesignAction/appliesToZoneRef reuses diggs:AbstractProgramDesign
                                for zones: DIGGS already has one mechanism for stating a load
                                combination's members, and a second, parallel one would leave
                                nothing correlating them. Repeatable because a case is normally more
                                than one action; empty where the design has not yet built a
                                DesignAction for every action the case needs, or where the
                                verification predates S14's DesignAction and only remark carries the
                                case description.</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Free-text notes on the verification - for example why a
                                buckling check was triggered (the DFI paper: buckling matters
                                specifically where confinement is reduced or lost - karst
                                solutioning, scour, liquefaction, long-term creep of organics/MSW),
                                or whether an outcome is predicted versus verified by post-
                                installation testing. diggs:RemarkPropertyType, matching the
                                house-wide remark convention, rather than a bare string.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignVerificationArrayPropertyType">
        <annotation>
            <documentation>Property type for arrays of DesignVerification objects, matching
                diggs:DesignActionArrayPropertyType's shape - one wrapper element containing zero
                or more DesignVerification children.</documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:DesignVerification"/>
        </sequence>
    </complexType>
    <element abstract="false" name="Qualifier" type="diggs:ParameterType">
        <annotation>
            <documentation>An enumeration of various parameters upon which the property result may
                be qualified</documentation>
        </annotation>
    </element>
    <element name="Remark" type="diggs:RemarkType" abstract="false">
        <annotation>
            <documentation>A remark or comment relevant to the containing object or feature,
                optionally including the remark's author and date.</documentation>
        </annotation>
    </element>
    <complexType name="RemarkType">
        <annotation>
            <documentation>Complex type: RemarkType</documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <element name="content" type="string" minOccurs="1" maxOccurs="1">
                        <annotation>
                            <documentation>The content property.</documentation>
                        </annotation>
                    </element>
                    <element name="author" type="diggs:BusinessAssociatePropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>The author of the remark.</documentation>
                        </annotation>
                    </element>
                    <element name="remarkDateTime" type="gml:TimePositionType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>The remark date time for this item.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ResultFile" type="diggs:ResultFileType" substitutionGroup="gml:File">
        <annotation>
            <documentation>for efficiency reasons, DIGGS also provides a means of encoding the
                ResultSet in an arbitrary external encoding, such as a binary file. This encoding
                may be "well-known" but this is not required. This mode uses the diggs:ResultFile
                element. The values in the dataValues element of the measurement are transmitted in
                a external file that is referenced from the XML structure described by
                diggs:ResultFileType. The external file is referenced by the diggs:fileReference
                property that is an anyURI This means that the external file may be located remotely
                from the referencing DIGGS instance. The diggs:compression property points to a
                definition of a compression algorithm through an anyURI. This may be a retrievable,
                computable definition or simply a reference to an unambiguous name for the
                compression method. The diggs:mimeType property points to a definition of the file
                mime type. The diggs:fileStructure property is defined by a codelist, but should be
                "Record Interleaved" to preserve the required structure of the dataValues property,
                whereby each record contains a set of fields in parameter order, with each record in
                document order associated with a value, in order, in the location or timeDomain
                property of the measurement. Note that if any compression algorithm is applied, the
                structure above applies only to the pre-compression or post-decompression structure
                of the file. </documentation>
        </annotation>
    </element>
    <complexType name="ResultFileBaseType">
        <annotation>
            <documentation>Complex type: ResultFileBaseType</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:FileType">
                <sequence>
                    <element ref="diggs:parameters"/>
                    <choice>
                        <element ref="diggs:fileReference"/>
                    </choice>
                    <element minOccurs="1" ref="diggs:fileStructure"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="ResultFileType">
        <annotation>
            <documentation>Complex type: ResultFileType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:ResultFileBaseType">
                <sequence>
                    <element minOccurs="0" name="mimeType" type="diggs:MimeTypeEnumExtType">
                        <annotation>
                            <documentation>Type or classification of the mime.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="compression" type="anyURI">
                        <annotation>
                            <documentation>The compression property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ResultSet" substitutionGroup="gml:DataBlock" type="diggs:ResultSetType">
        <annotation>
            <documentation>An object that contains properites describing the parameters and data
                values of a measurement result.</documentation>
        </annotation>
    </element>
    <complexType name="ResultSetType">
        <annotation>
            <documentation>Complex type: ResultSetType</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DataBlockType">
                <sequence>
                    <element ref="diggs:parameters" minOccurs="1"/>
                    <choice>
                        <element ref="diggs:dataValues"/>
                    </choice>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <element abstract="false" name="Role" type="diggs:RoleType">
        <annotation>
            <documentation>A role is the function assumed or part played by a business associate in
                relation to the containing DIGGS feature.</documentation>
        </annotation>
    </element>
    <complexType name="RoleType">
        <annotation>
            <documentation>Complex type: RoleType</documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <element name="rolePerformed" type="gml:CodeType" minOccurs="1" maxOccurs="1">
                        <annotation>
                            <documentation>A term describing the role that was
                                performed.</documentation>
                        </annotation>
                    </element>
                    <element name="timePerformed" type="diggs:TimeIntervalPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The time performed property.</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The remark property.</documentation>
                        </annotation>
                    </element>
                    <element name="businessAssociate" type="diggs:BusinessAssociatePropertyType"
                        maxOccurs="unbounded" minOccurs="1">
                        <annotation>
                            <documentation>The business associate performing the
                                role.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SampleProduced" type="diggs:SampleProducedType">
        <annotation>
            <documentation>An object that defines the location of a sample produced by a sampling
                activity.</documentation>
        </annotation>
    </element>
    <complexType name="SampleProducedType">
        <annotation>
            <documentation>Complex type: SampleProducedType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <choice>
                    <sequence>
                        <element minOccurs="1" ref="diggs:location"/>
                        <element minOccurs="0" name="sampleTime"
                            type="diggs:TimeIntervalPropertyType">
                            <annotation>
                                <documentation>The start and end time of sample
                                collection.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <element minOccurs="1" name="sampleTime" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The start and end time of sample
                                collection.</documentation>
                        </annotation>
                    </element>
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="SizeFraction" type="diggs:SizeFractionType">
        <annotation>
            <documentation>The range of grain sizes used for this test procedure; expressed as
                minimum grain size (for a sample with grain sizes above a certain size), or maximum
                grain size (for a sample with grain sizes below a certain). Both minimumGrainSize
                and maximumGrainSize may be populated to represent a sample with grain sizes between
                the two specified.</documentation>
        </annotation>
    </element>
    <complexType name="SizeFractionType">
        <annotation>
            <documentation>Type defining a particle size fraction used in testing. Contains minimum
                grain size, maximum grain size, and percentage of total sample. Used to document the
                specific size fraction of material subjected to laboratory tests.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="minimumGrainSize"
                        type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>The smallest grain size in the sample fraction used for
                                this procedure</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maximumGrainSize"
                        type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>The largest grain size in the sample fraction used for
                                this procedure</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentOfTotalSample"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>The fraction of the total sample used for the procedure
                                (eg. fraction of the total sample represented by the size fraction
                                used for the procedure</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SoftwareApplication" type="diggs:SoftwareApplicationType" abstract="false">
        <annotation>
            <documentation>A computer program designed to carry out a specific task.</documentation>
        </annotation>
    </element>
    <complexType name="SoftwareApplicationType">
        <annotation>
            <documentation>Complex type: SoftwareApplicationType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedObjectType">
                <sequence>
                    <element name="version" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The version property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Specification" type="diggs:SpecificationType"
        substitutionGroup="diggs:AbstractProcedure" abstract="false">
        <annotation>
            <documentation>An object that describes the specification or method used for testing or
                construction, by citing a published standard or a clause of one - an ASTM or AASHTO
                method, a national standard, a project specification clause. Its properties identify
                the document rather than state requirements: standardReferenceNumber,
                standardTitle, standardVersion, standardPart, standardClause and the accrediting
                body.
                
                NOT TO BE CONFUSED WITH diggs:AbstractProgramSpecification
                (core/AbstractTypes.xsd), which since the correction of its name differs from this
                one by a single word. The two are different kinds of thing:
                
                - diggs:Specification is a COMPONENT OBJECT, and specifically a procedure - it
                substitutes diggs:AbstractProcedure. It is held by
                diggs:SpecificationPropertyType wherever a feature needs to say "this is the
                method I followed". It states no requirement of its own; the requirement lives in
                the cited document.
                
                - diggs:AbstractProgramSpecification is a FEATURE HEAD. Its members are features a
                program issues, carrying the tolerances and acceptance limits the work is judged
                against, together with the scope over which they apply. A realized feature cites
                one through diggs:programSpecificationRef.
                
                Rule of thumb: if it was published by a standards body or written into a contract
                and you are pointing at it, use diggs:Specification. If your program is issuing the
                requirement itself, use a member of
                diggs:AbstractProgramSpecification.</documentation>
        </annotation>
    </element>
    <complexType name="SpecificationType">
        <annotation>
            <documentation>Extended type based on AbstractProcedureType. Adds elements for
                specification type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProcedureType">
                <sequence>
                    <choice minOccurs="0" maxOccurs="1">
                        <element name="accredtingBody" type="string">
                            <annotation>
                                <appinfo>DEPRECATED 8/26. Misspelled - use accreditingBody
                                    instead.</appinfo>
                                <documentation>DEPRECATED - misspelled. Identification of the
                                    accrediting body and reference number, if applicable. Retained,
                                    as a choice alongside the corrected accreditingBody, because this
                                    element existed at 3.0.0 and a straight rename would invalidate
                                    released instances using it. New instances should use
                                    accreditingBody; this branch exists only so existing ones keep
                                    validating.</documentation>
                            </annotation>
                        </element>
                        <element name="accreditingBody" type="string">
                            <annotation>
                                <documentation>Identification of the accrediting body and reference
                                    number, if applicable. Corrected spelling of accredtingBody,
                                    misspelled at 3.0.0 and kept as a deprecated choice alternative
                                    below for backward compatibility. Use this element, not that
                                    one, in new instances.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="shortMethodName" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Name of the short method.</documentation>
                        </annotation>
                    </element>
                    <element name="standardClause" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The standard clause property.</documentation>
                        </annotation>
                    </element>
                    <element name="standardPart" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The standard part property.</documentation>
                        </annotation>
                    </element>
                    <element name="standardReferenceNumber" type="string" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>Number or numerical identifier for the standard
                                reference.</documentation>
                        </annotation>
                    </element>
                    <element name="standardTitle" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The standard title property.</documentation>
                        </annotation>
                    </element>
                    <element name="standardVersion" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The standard version property.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSpecificationProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The other specification property
                                property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TemperatureMeasurement" type="diggs:TemperatureMeasurementType">
        <annotation>
            <documentation>A temperature measurement optionally taken at a specific time
                instant.</documentation>
        </annotation>
    </element>
    <complexType name="TemperatureMeasurementPropertyType">
        <annotation>
            <documentation>Property type for temperature measurement references. Used to wrap
                temperature measurement objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TemperatureMeasurement"/>
        </sequence>
    </complexType>
    <complexType name="TemperatureMeasurementType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for temperature
                measurement type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The date time for this item.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="temperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>The temperature property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TimeInterval" type="diggs:TimeIntervalType">
        <annotation>
            <documentation>An interval of time, expressed by a start and end time, or optionally as
                a start time, end time and/or duration.</documentation>
        </annotation>
    </element>
    <complexType name="TimeIntervalType">
        <annotation>
            <documentation>Complex type: TimeIntervalType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="start" type="gml:TimePositionType" maxOccurs="1" minOccurs="1">
                        <annotation>
                            <documentation>The date/time that begins the interval</documentation>
                        </annotation>
                    </element>
                    <element name="end" type="gml:TimePositionType" maxOccurs="1" minOccurs="0">
                        <annotation>
                            <documentation>The date/time that ends the interval.</documentation>
                        </annotation>
                    </element>
                    <element name="duration" type="diggs:TimeMeasureType" maxOccurs="1"
                        minOccurs="0">
                        <annotation>
                            <documentation>The duration of time since start.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Uncertainty" type="diggs:UncertaintyType" abstract="false">
        <annotation>
            <documentation>An object that defines uncetainty values to the location's coordinates. Uncertainty values SHALL be expressed in the same unit of measure as the corresponding coordinate axis of the associated geometry’s CRS.</documentation>
        </annotation>
    </element>
    <complexType name="UncertaintyType">
        <annotation>
            <documentation>Complex type: UncertaintyType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="plusUncertaintyValue"
                        type="diggs:DescriptorValueType">
                        <annotation>
                            <documentation>Uncertainty is reported as +/- from the reported
                                value.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minusUncertaintyValue"
                        type="diggs:DescriptorValueType">
                        <annotation>
                            <documentation>Uncertainty is reported as +/- from the reported
                                value.</documentation>
                        </annotation>
                    </element>

                    <element minOccurs="0" name="confidenceLevel"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>Reported as a percentage (eg. 95%)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertaintyRepresentation"
                        type="diggs:UncertaintyRepresentationEnumExtType">
                        <annotation>
                            <documentation>
                                Describes how the uncertainty values are to be interpreted
                                (e.g. plusMinus, standardDeviation, maximumError).
                            </documentation>
                        </annotation>
                    </element>

                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- =========================================================================== -->
    <!-- COMMON ENUMERATIONS                                                         -->
    <!-- =========================================================================== -->

    <simpleType name="AziRefEnumType">
        <annotation>
            <documentation>Reference to the azimuth of the linear sampling feature. From WITSML v.2
                namespace</documentation>
        </annotation>
        <restriction base="string">

            <enumeration value="magnetic north">
                <annotation>
                    <documentation>The north direction as defined by Magnetic North Pole at the time
                        of the measurement. The Magnetic North Pole is the direction that a magnet
                        points to when freely rotating.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="grid north">
                <annotation>
                    <documentation>The north direction is defined by the coordinate grid in the
                        projection coordinate system.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="true north">
                <annotation>
                    <documentation>The north direction as defined by the true North Pole. The true
                        North Pole is an average of the actual measured north axis, which is the
                        axis of rotation of the earth.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ChannelDerivationEnumType">
        <annotation>
            <documentation>Specifies the source of data in a channel. From WITSML v. 2
                namespace</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="raw">
                <annotation>
                    <documentation>Raw measured data, directly from sensors.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="simulated">
                <annotation>
                    <documentation>Simulated.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="spliced">
                <annotation>
                    <documentation>Derived by splicing values from two or more other
                        channels.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="sampled">
                <annotation>
                    <documentation>Derived by sampling values from one or more other
                        channels.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="model">
                <annotation>
                    <documentation>Based on some modeled results of values in another one or more
                        channels.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ChannelStateEnumType">
        <annotation>
            <documentation>Specifies the source of the data values in the channel, e.g., calculated
                from another source, or from archive, or raw real-time, etc. Taken from WITSML v. 2
                namespace</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="calculated">
                <annotation>
                    <documentation>Calculated from measurements</documentation>
                </annotation>
            </enumeration>
            <enumeration value="final">
                <annotation>
                    <documentation>Considered final and not subject to change</documentation>
                </annotation>
            </enumeration>
            <enumeration value="memory">
                <annotation>
                    <documentation>Sensor data is recorded into downhole memory of a tool, rather
                        than transmitting in "real time" to surface. </documentation>
                </annotation>
            </enumeration>
            <enumeration value="processed">
                <annotation>
                    <documentation>Results of calculations based on measurements</documentation>
                </annotation>
            </enumeration>
            <enumeration value="real time">
                <annotation>
                    <documentation>Measurements at the actual time.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="CurrencyEnumType">
        <annotation>
            <documentation> ISO 4217 currency codes. Each enumeration represents a three-letter
                currency code with documentation showing the currency name and country/territory
                where it is used. </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="AED">
                <annotation>
                    <documentation>UAE Dirham (UNITED ARAB EMIRATES (THE))</documentation>
                </annotation>
            </enumeration>
            <enumeration value="AFN">
                <annotation>
                    <documentation>Afghani (AFGHANISTAN)</documentation>
                </annotation>
            </enumeration>
            <enumeration value="ALL">
                <annotation>
                    <documentation>Lek (ALBANIA)</documentation>
                </annotation>
