    <complexType name="ProvenancedParameterPropertyType">
        <annotation>
            <documentation>Property type for containing a single ProvenancedParameter object. Unlike
                diggs:ParameterPropertyType, only diggs:ProvenancedParameter is admitted here: use
                this property type where a value is meaningless without stating what it describes
