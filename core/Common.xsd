        abstract="false">
        <annotation>
            <documentation>A collection of information used to give the location of a building,
                apartment, or other structure.</documentation>
        </annotation>
    </element>
    <complexType name="AddressType">
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element name="number" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The house or building number.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="streetAddress" type="string" minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The street address. The building number can also be included here if
                                number is not used; if number is used, this property holds only the
                                street name. Repeat for each line of the street address.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="city" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The city.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="state" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The state.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="province" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The province.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="county" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The county.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="country" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The country.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="postalCode" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The postal code.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AssociatedFile" type="diggs:AssociatedFileType" abstract="false">
        <annotation>
            <documentation>An object that provides information about external files or documents
                associated with the containing features.</documentation>
        </annotation>
    </element>
    <complexType name="AssociatedFileType">
        <annotation>
            <documentation>
                Type for an external file or document associated with a feature: its location, file
                type, format, origin and date.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" name="contact"
                            type="diggs:BusinessAssociatePropertyType" maxOccurs="unbounded">
                            <annotation>
                                <documentation>
                                    The person or business to contact about this file. Populate it
                                    where a file location is not provided.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="1" name="fileURL" type="anyURI">
                            <annotation>
                                <documentation>
                                    The path to the digital file.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="fileType" type="gml:CodeType">
                            <annotation>
                                <documentation>
                                    The digital file type, typically denoted by the file extension,
                                    for example .jpg or .pdf. No DIGGS-authored dictionary currently
                                    exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="creatingApplication"
                            type="diggs:SoftwareApplicationPropertyType">
                            <annotation>
                                <documentation>
                                    The application that created the file, where applicable.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="documentType" type="gml:CodeType">
                            <annotation>
                                <documentation>
                                    For documents, the type of document the file represents, such as
                                    photo, report or log. No DIGGS-authored dictionary currently
                                    exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="fileDate"
                            type="gml:TimePositionType">
                            <annotation>
                                <documentation>
                                    The date the file was created or last modified.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" ref="diggs:fileStructure"/>
                        <element minOccurs="0" name="mimeType" type="diggs:MimeTypeEnumExtType">
                            <annotation>
                                <documentation>
                                    The mime type of the file. Values come from the enumerated list,
                                    or "Other: xx", where xx is a user-defined term whose meaning
                                    differs from every listed value (not a synonym of one). For a
                                    mime type that is not registered, xx is type/subtype with a
                                    subtype that begins with "x-", for example Other:
                                    application/x-segy.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="compression" type="anyURI">
                            <annotation>
                                <documentation>
                                    A value, as a URI, that identifies the compression algorithm
                                    used, if applicable, for example LZW.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="encryption" type="anyURI">
                            <annotation>
                                <documentation>
                                    A value, as a URI, that identifies the file encryption algorithm
                                    used, if applicable, for example AES.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AuthorizedParameter" type="diggs:AuthorizedParameterType">
        <annotation>
            <documentation>
                An object containing the name, value or range of values, and unit of measure of a
                property or measurement parameter, where the name is bound to a definition in a
                properties dictionary and the data type of the value is declared. Use it in
                preference to diggs:Parameter wherever the parameter reported has a dictionary
                definition: a consumer can then type the value and check it against the definition
                without inferring anything from its lexical form. Use diggs:Parameter where the name
                is genuinely uncontrolled. It is accepted anywhere diggs:ParameterPropertyType or
                diggs:ParameterArrayPropertyType is used.
            </documentation>
        </annotation>
    </element>
    <complexType name="AuthorizedParameterType">
        <annotation>
            <documentation>
                Type for a parameter whose name is dictionary-bound and whose value carries a
                declared data type. Parallel to diggs:ParameterType, from which it is not derived.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="parameterName"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                A code identifying what the value represents. The codeSpace
                                attribute is mandatory and must give the URI of the definition in a
                                properties dictionary (the dictionary's URI with the entry id, for
                                example the liquid_limit entry of properties.xml), so that an
                                application can resolve and validate the name. Where no such
                                definition exists, use diggs:Parameter instead. Use the DIGGS
                                dictionary that serves the host element: properties.xml,
                                ri_design_properties.xml, design_basis_properties.xml,
                                design_factor_properties.xml, designProperty.xml,
                                evidenceCondition.xml or gp_properties.xml.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="typeData"
                        type="diggs:DataTypeEnumType">
                        <annotation>
                            <documentation>
                                The data type of the parameter value, for example double, long or
                                string. Required: declaring the type is the point of this object, so
                                that a consumer need not infer it from the lexical form of the value
                                or resolve the dictionary definition to obtain it. Unlike
                                diggs:PropertyDataTypeEnumType, it does not permit the empty string,
                                because there is no unknown-type case here. Values come from the
                                enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parameterMinValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                For numeric parameter values expressed as a range rather than a
                                fixed value, the minimum of the range.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="parameterValue" type="string">
                        <annotation>
                            <documentation>
                                The value of the parameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parameterMaxValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                For numeric parameter values expressed as a range rather than a
                                fixed value, the maximum of the range.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parameterUnits" type="diggs:AllUnits" minOccurs="0">
                        <annotation>
                            <documentation>
                                The unit of measure of the parameter. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>
                            An integer that indicates the position of the parameter in the order of
                            the parameters of a result.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="Boundary" type="diggs:BoundaryType">
        <annotation>
            <documentation>An object that contains properties describing a layer, interval, or zone
                boundary (eg. dip angle, sharpness, etc.)</documentation>
        </annotation>
    </element>
    <complexType name="BoundaryType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location"/>
                    <element minOccurs="0" name="dipAngle" type="diggs:DipMeasureType">
                        <annotation>
                            <documentation>
                                The inclination angle of the boundary surface, measured downward
                                from the horizontal.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dipDirection" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The direction of the true dip of the boundary surface, measured
                                clockwise from true north.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="distinctness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How distinctly the boundary between zones is defined, governed by
                                both the contrast between adjacent zones and the width of the
                                boundary, for example sharp or gradational. A controlled term is
                                preferred. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="origin" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The specific nature or origin of the boundary, for example
                                unconformity or fault. A controlled term is preferred. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="topography" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The shape of the boundary surface between zones, for example wavy. A
                                controlled term is preferred. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the boundary was determined. Values come from the
                            enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="BusinessAssociate" type="diggs:BusinessAssociateType" abstract="false">
        <annotation>
            <documentation>A person or entity who performs functions, activities, or
                services.</documentation>
        </annotation>
    </element>
    <complexType name="BusinessAssociateBaseType">
        <annotation>
            <documentation>
                Abstract base type for business associates: at least one name, with an optional
                identifier, internal identifier, status, associated files and remarks.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element ref="diggs:internalIdentifier" minOccurs="0"/>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="associatedFile"
                            type="diggs:AssociatedFilePropertyType">
                            <annotation>
                                <documentation>
                                    External files associated with this business associate, as
                                    diggs:AssociatedFile objects. Repeat for each file.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>
                                    A comment or remark about this business associate. Repeat for
                                    each remark.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="BusinessAssociateType">
        <complexContent>
            <extension base="diggs:BusinessAssociateBaseType">
                <sequence>
                    <element name="title" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                A title for a person, for example Mr., Ms., Sra. or Dr., that
                                precedes the name. Corporate titles (for example Inc. or Ltd.) and
                                suffixes (for example PhD) are not entered here but included in the
                                name of the business associate. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="address" type="diggs:AddressPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A mailing address of the business associate. Repeat for each
                                address.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="emailAddress" type="diggs:EmailType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An email address of the business associate. The type of email, for
                                example business or personal, is given in the type attribute. Repeat
                                for each address.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="phoneNumber" type="diggs:PhoneType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A telephone number of the business associate. The type of number,
                                for example mobile or fax, is given in the type attribute. Repeat
                                for each number.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="associatedWith" type="diggs:BusinessAssociatePropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:BusinessAssociate</appinfo>
                            <documentation>
                                A business associate associated with this one, given as an embedded
                                diggs:BusinessAssociate object or by an xlink:href to the gml:id of
                                another. Repeat for each associated business associate.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Calibration" type="diggs:CalibrationType" abstract="false">
        <annotation>
            <documentation>The calibration of an item of equipment or a sensor: when it was
                calibrated, what was found, and how the equipment has been used since. Held on an
                equipment record through calibrationAuditTrail; an item calibrated more than
                once carries one Calibration per occasion. The laboratory or person who performed or
                approved the calibration is stated through the role property inherited from
                AbstractFeature.</documentation>
        </annotation>
    </element>
    <complexType name="CalibrationType">
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element minOccurs="0" name="calibrationData" type="gml:StringOrRefType">
                        <annotation>
                            <documentation>The procedure followed and the data recorded during the
                                calibration, as text or as a reference (xlink:href) to another
                                object or an external file such as the calibration
                                certificate.</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="cqlibrationValues" type="diggs:ParameterArrayPropertyType"
                            minOccurs="1" maxOccurs="1">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:calibrationValues"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use calibrationValues; this name is a
                                    misspelling of it.</documentation>
                            </annotation>
                        </element>
                        <element name="calibrationValues" type="diggs:ParameterArrayPropertyType"
                            minOccurs="1" maxOccurs="1">
                            <annotation>
                                <documentation>Values established or reported by the calibration,
                                    as named parameters with their values and units - for example a
                                    calibration constant, resolution or uncertainty.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="certificateNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The number of the calibration certificate or report
                                issued for this calibration.</documentation>
                        </annotation>
                    </element>
                    <element name="date" type="gml:TimePositionType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The date the calibration was performed.</documentation>
                        </annotation>
                    </element>
                    <element name="dueDate" type="gml:TimePositionType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The date by which the equipment is due to be calibrated
                                again, as stated on the certificate.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="useSinceLastCalibration" type="string">
                        <annotation>
                            <documentation>A note on how much the equipment has been used since the
                                last calibration.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="calibrationMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>The standard or procedure the calibration followed, as
                                a Specification object or a reference to one - for example a
                                registry entry for the standard, or the laboratory's own
                                procedure.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="calibrationConditions"
                        type="diggs:ParameterArrayPropertyType">
                        <annotation>
                            <documentation>The conditions the calibration was performed under, as
                                named parameters with values, tolerances and units - for example
                                ambient temperature and humidity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="referenceStandard"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractEquipment</appinfo>
                            <documentation>The reference equipment the item was calibrated
                                against, such as a dead-weight tester or a proving load cell, as an
                                Equipment object or a reference to one. The reference equipment's
                                own certificate, due date and traceability are carried by its
                                calibrationAuditTrail.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="calibrationResults"
                        type="diggs:ResultsPropertyType">
                        <annotation>
                            <documentation>A table of calibration points: one row per point, with
                                columns such as the reference value applied, the value the item
                                indicated, the deviation between them and the expanded uncertainty
                                at that point. The columns, their units and their order are
                                declared by the table's parameters. An item calibrated over more
                                than one range or quantity carries one table for each.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Contract" type="diggs:ContractType" abstract="false">
        <annotation>
            <documentation>An object that contains properties of a business
                contract.</documentation>
        </annotation>
    </element>
    <complexType name="ContractType">
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element name="version" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The version number or name of this contract.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="contractDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The date the contract went into effect.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="revisionDate" type="gml:TimePositionType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The date the contract was revised. Repeat for each revision.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="type" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The contract delivery method: design-build, design-bid-build or
                                other. Use the DIGGS dictionary contractType.xml for the list of
                                values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="governingSpecificationSource"
                        type="diggs:GoverningSpecificationSourceEnumExtType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                Whose document governs the work under this contract: owner or agency
                                provisions, the contractor's own specifications, or none. This is a
                                contracting fact, not a design-basis fact; it differs from
                                diggs:RIProgramBasisType/governingStandard, which states which
                                published document governs. The two are complementary: a contract
                                can name owner or agency provisions here while the basis cites the
                                specific standard those provisions invoke. It is stated on the
                                contract, reached through the project's contract property, and not
                                per program: the source applies to everything executed under the
                                contract, which may span more than one specialty's program on the
                                same project. The party concerned is stated through the inherited
                                role of the contract (for example owner, client,
                                specialty_contractor or main_contractor, from roles.xml) with the
                                responsible business associate, on this same object. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="value" type="diggs:CostType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The total value of the contract, as a cost with a currency
                                attribute.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="EmailStringType">
        <annotation>
            <documentation>
                Pattern-constrained string for email addresses, enforcing a basic email format.
            </documentation>
        </annotation>
        <restriction base="string">
            <pattern value="([A-z0-9_\.\-\+])+@(([A-z0-9_\-]{2,})\.)+[A-z0-9_\-]{2,}"/>
        </restriction>
    </simpleType>
    <complexType name="EmailType">
        <simpleContent>
            <extension base="diggs:EmailStringType">
                <attribute name="type" type="diggs:ExtEmailEnumType">
                    <annotation>
                        <documentation>
                            The type of the email address, for example personal or business. Values
                            come from the enumerated list, or "Other: xx", where xx is a
                            user-defined term whose meaning differs from every listed value (not a
                            synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="Environment" type="diggs:EnvironmentType" abstract="false">
        <annotation>
            <documentation>A collection of environmental parameters recorded at a specific time
                instant.</documentation>
        </annotation>
    </element>
    <complexType name="EnvironmentType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date and time of this set of environmental values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="ambientTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The ambient air temperature, as a single value at the time of
                                measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="barometricPressure" type="diggs:PressureMeasureType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The barometric pressure, as a single value at the time of
                                measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="humidity" type="diggs:VolumePerVolumeMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The atmospheric humidity, as a single value at the time of
                                measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="weather" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                A general description of the weather, for example sunny or partly
                                cloudy.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="windSpeed" type="diggs:LengthPerTimeMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The wind speed, as a single value at the time the measurement was
                                taken.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherEnvironmentalProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter for an environmental property not otherwise provided
                                for. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="FeatureReferenceType">
        <annotation>
            <documentation>
                Type for a reference to a DIGGS feature: by its gml:id in the xlink:href attribute,
                or by its gml:identifier using the identifierRef attribute.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:ReferenceType">
                <attribute name="identifierRef" type="diggs:IdentifierReferenceType" use="optional">
                    <annotation>
                        <documentation>
                            The gml:identifier value of the referenced feature, as a fully qualified
                            value. It gives an alternative to the gml:id in xlink:href for finding
                            the referenced feature, mainly to reference a feature by a globally
                            unique identifier and where naming conflicts occur with gml:id when
                            accessing data in external files.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="InSituTestEvent" type="diggs:InSituTestEventType">
        <annotation>
            <documentation>An object detailing a time or location-based event that may occur during
                an in-situ test.</documentation>
        </annotation>
    </element>
    <complexType name="InSituTestEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LaboratoryTestEvent" type="diggs:LaboratoryTestEventType">
        <annotation>
            <documentation>
                An object that records events observed during a laboratory test. A concrete
                diggs:AbstractEventType with no additional properties.
            </documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="LaboratoryTestEventType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:remark"/>
                    <element minOccurs="0" name="time" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The date and time at which this event information was recorded.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="infoRecorded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                Other data measured or observed at the time of the event, as
                                parameters. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="Limit" substitutionGroup="gml:AbstractGML"
        type="diggs:LimitType">
        <annotation>
            <documentation>An object containing properties of the detection limits of a
                measurement.</documentation>
        </annotation>
    </element>
    <complexType name="LimitType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="constraint" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                A condition under which the limit applies. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="limitType"
                        type="diggs:QualifierEnumExtType">
                        <annotation>
                            <documentation>
                                The type of limit reported, for example a detection or
                                quantification limit. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="value" type="string">
                        <annotation>
                            <documentation>
                                The value of the limit.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="outOfLimitValue" type="string">
                        <annotation>
                            <documentation>
                                The value reported to signify that a result is out of the allowable
                                limit range.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="LocalCoordinate" type="diggs:LocalCoordinateType">
        <annotation>
            <documentation>A metadata object that holds the values of local coordinates for the
                reference point of the associated feature.</documentation>
        </annotation>
    </element>
    <complexType name="LocalCoordinateType">
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <choice>
                        <sequence>
                            <element minOccurs="0" ref="diggs:easting"/>
                            <element minOccurs="0" ref="diggs:northing"/>
                            <element minOccurs="0" ref="diggs:elevation"/>
                        </sequence>
                        <element minOccurs="0" ref="diggs:location"/>
                    </choice>
                    <choice minOccurs="0" maxOccurs="1">
                        <element name="localCoodinateUncertainty"
                            type="diggs:LocationUncertaintyPropertyType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:localCoordinateUncertainty"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use localCoordinateUncertainty; this name is a
                                    misspelling of it. The uncertainty of the local coordinates.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="localCoordinateUncertainty"
                            type="diggs:LocationUncertaintyPropertyType">
                            <annotation>
                                <documentation>
                                    The uncertainty of the local coordinates. Use this element, not
                                    the deprecated localCoodinateUncertainty.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Locality" type="diggs:LocalityType" substitutionGroup="gml:AbstractGML"
        abstract="false">
        <annotation>
            <documentation>An object that describes non-coordinate location information for a
                feature.</documentation>
        </annotation>
    </element>
    <complexType name="LocalityType">
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element name="address" type="diggs:AddressPropertyType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The address of the locality.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="district" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a district.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="division" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a division.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lot" type="string">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a lot.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0" maxOccurs="1">
                        <element name="parceI" type="string">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:parcel"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use parcel. This name is a misspelling of it: it ends in a
                                    capital letter I (parceI) where the correct name ends in a lowercase
                                    letter l (parcel); the two look alike in many fonts. The name or id of
                                    a territory of land classified as a parcel.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="parcel" type="string">
                            <annotation>
                                <documentation>
                                    The name or id of a territory of land classified as a parcel. Use
                                    this element (lowercase letter l at the end), not the deprecated
                                    parceI (capital letter I at the end).
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="plss" type="diggs:PlssPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The Public Land Survey System (PLSS) description of the locality.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="quadrangle" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a map
                                quadrangle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="route" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of the route along which a centerline survey is
                                designated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="segment" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of an interval or section of a route along which a
                                centerline survey is designated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="station" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The station along a centerline survey. It must be a numeric value,
                                with the unit of measure (for example ft) given in the uom
                                attribute. Systems that store station values as a string with a plus
                                sign (+) must strip the plus sign and give the uom when encoding to
                                DIGGS.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="mileMarker" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                A reference point along a route that indicates either the distance
                                travelled or the remaining distance to a destination, also used by
                                maintenance engineers and emergency services to direct them to
                                specific points. The term is sometimes used for a location on a road
                                even where no physical sign is present. It is a numeric value and
                                can differ from the station used in route surveys.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="offset" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1" form="qualified">
                        <annotation>
                            <documentation>
                                The distance measured perpendicular from the station. Unless
                                offsetDirection is specified, positive values are an offset to the
                                right when facing the direction of increasing station value, and
                                negative values an offset to the left.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="offsetDirection" type="diggs:OffsetDirectionEnumExtType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The direction of the offset from the centerline survey: left or
                                right, when facing the direction of increasing station value. Values
                                come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="tract" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a tract.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="watershed" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name or id of a territory of land classified as a watershed.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="otherLocalityProperty" type="diggs:ParameterPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter for another type of locality designation, given as a
                                name-value pair. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LocationUncertainty" type="diggs:LocationUncertaintyType" abstract="false">
        <annotation>
            <documentation>
                The positional uncertainty of a geometry; it does not alter or replace the geometry
                itself. Uncertainty values are expressed in the units of the CRS of the geometry and
                can be given in axis-based or radial (horizontal and vertical) form. Several
                representations can be given together and are alternative expressions of the same
                uncertainty.
            </documentation>
        </annotation>
    </element>
    <complexType name="LocationUncertaintyType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="locationMethod"
                        type="diggs:LocationMethodEnumExtType">
                        <annotation>
                            <documentation>
                                The method used to determine the coordinate information. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="horizontalUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                The radial horizontal uncertainty, in the units of the horizontal
                                CRS axes.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                The vertical uncertainty, in the units of the vertical CRS axis.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="xValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                The uncertainty of the x-axis value of a location coordinate.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="yValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                The uncertainty of the y-axis value of a location coordinate.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="zValueUncertainty"
                        type="diggs:UncertaintyPropertyType" nillable="true">
                        <annotation>
                            <documentation>
                                The uncertainty of the z value of a location coordinate.
                            </documentation>
                        </annotation>
                    </element>

                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MeasurementTechniqueEnumType">
        <annotation>
            <documentation>
                Type for the method by which a property value is obtained: a term from
                diggs:DescriptorMethodEnumType, with an optional formula attribute that describes
                the formula used to obtain the result.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:DescriptorMethodEnumType">
                <attribute name="formula" type="string">
                    <annotation>
                        <documentation>
                            A description of the formula used to obtain the measurement result.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="NullDataType">
        <simpleContent>
            <extension base="string">
                <attribute name="reason" type="gml:NilReasonType" use="optional">
                    <annotation>
                        <documentation>
                            The reason for the null value, for example withheld. It is a
                            gml:NilReasonType value: a standard nil reason, an "other:" term (for
                            example other:below detection limit), or a URI to a fuller definition.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="OtherMimeTypeType">
        <annotation>
            <documentation>
                Simple type for a mime type outside the enumerated list, of the form Other:
                type/subtype, for example Other: application/x-segy.
            </documentation>
        </annotation>
        <restriction base="string">
            <pattern value="Other: [a-z\-\+\.]+/[a-z0-9\-\+\.]+"/>
        </restriction>
    </simpleType>

    <!-- diggs:ParameterType is the uncontrolled form: the name may be free text and the
         value is soft-typed, which is correct for the otherProperty bags this type mostly
         serves. Where the parameter has a dictionary definition, use
         diggs:AuthorizedParameter (declared above, in the alphabetical A block of this
         file) instead — it makes codeSpace mandatory on parameterName and adds a
         mandatory typeData. The two types share five particles and the index attribute by
         deliberate duplication rather than derivation; keep them in step. -->
    <element name="Parameter" type="diggs:ParameterType">
        <annotation>
            <documentation>An object containing the name, value or range of values and unit of
                measure of a property or a measurement parameter (result).</documentation>
        </annotation>
    </element>
    <complexType name="ParameterType">
        <annotation>
            <documentation>
                Type for a parameter with a free-text name: a name, a value or range of values, and
                a unit of measure.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="1" name="parameterName" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                A name or code for what the value represents. Best practice is to
                                point to a property definition in a standard properties dictionary
                                through the codeSpace attribute (the dictionary's URI with the entry
                                id, for example the liquid_limit entry of properties.xml). Use the
                                DIGGS dictionary that serves the host element: properties.xml,
                                ri_design_properties.xml, design_basis_properties.xml,
                                design_factor_properties.xml, designProperty.xml,
                                evidenceCondition.xml or gp_properties.xml.
                            </documentation>
                        </annotation>
                    </element>

                    <element name="parameterMinValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                For numeric parameter values expressed as a range rather than a
                                fixed value, the minimum of the range.
                            </documentation>
                        </annotation>
                    </element>

                    <element minOccurs="0" name="parameterValue" type="string">
                        <annotation>
                            <documentation>
                                The value of the parameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parameterMaxValue" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                For numeric parameter values expressed as a range rather than a
                                fixed value, the maximum of the range.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="parameterUnits" type="diggs:AllUnits" minOccurs="0">
                        <annotation>
                            <documentation>
                                The unit of measure of the parameter. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>
                            An integer that indicates the position of the parameter in the order of
                            the parameters of a result.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="PhoneNumberStringType">
        <annotation>
            <documentation>
                Pattern-constrained string for phone numbers, enforcing a basic phone number format.
            </documentation>
        </annotation>
        <restriction base="string">
            <pattern
                value="(\+[0-9]( )?)?([0-9]( |-|\.|)){6,14}[0-9]|(\([0-9]{3}\)[-. ]?|[0-9]{3}[-. ])[0-9]{3}[-. ]?[0-9]{4} "
            />
        </restriction>
    </simpleType>
    <complexType name="PhoneType">
        <simpleContent>
            <extension base="diggs:PhoneNumberStringType">
                <attribute name="type" type="diggs:ExtPhoneEnumType">
                    <annotation>
                        <documentation>
                            The type of the phone number: voice, fax, mobile, voice/fax or
                            voicemail. Values come from the enumerated list, or "Other: xx", where
                            xx is a user-defined term whose meaning differs from every listed value
                            (not a synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="PLSS" type="diggs:PlssType" abstract="false">
        <annotation>
            <documentation>
                The land subdivisions of the US Public Land Survey System.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlssType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element name="township" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                An approximately 6-mile square area of land containing 36 sections;
                                also a horizontal row of townships in the PLSS.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="range" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                A vertical column of townships in the PLSS.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="section" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The name of the section, a one-square-mile block of land of 640
                                acres, or approximately one thirty-sixth of a township. Because of
                                the curvature of the Earth, sections can be slightly smaller than
                                one square mile.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="aliquotPart" type="string">
                        <annotation>
                            <documentation>
                                The name of the standard subdivision of a section, such as a half
                                section, quarter section or quarter-quarter section.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="governmentLot" type="string">
                        <annotation>
                            <documentation>
                                The name of a subpart of a section that is not described as an
                                aliquot part but is designated by number, for example Lot 3. A lot
                                can be regular or irregular in shape, and its acreage can differ
                                from that of regular aliquot parts. These lots frequently border
                                water areas excluded from the PLSS.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baseAndMeridian" type="string">
                        <annotation>
                            <documentation>
                                The name of the point chosen as the starting point for all
                                sectionalized land within a given area, located at the intersection
                                of a base line (a parallel of latitude, or approximately so) and a
                                principal meridian.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="landGrant" type="string">
                        <annotation>
                            <documentation>
                                The name of an area of land to which title was conferred by a
                                predecessor government and confirmed by the U.S. Government after
                                the territory was acquired by the United States. These lands were
                                never part of the original public domain and were not subject to
                                subdivision by the PLSS.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ProjectEvent" type="diggs:ProjectEventType">
        <annotation>
            <documentation>An object that contains properties of time or location related events
                associated with a project.</documentation>
        </annotation>
    </element>
    <complexType name="ProjectEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="Property" type="diggs:PropertyType" substitutionGroup="gml:AbstractValue"
        abstract="false">
        <annotation>
            <documentation>
                An object that holds a property of a measurement result.
            </documentation>
        </annotation>
    </element>
    <element name="PropertyParameters" type="diggs:PropertyParametersType"
        substitutionGroup="gml:CompositeValue">
        <annotation>
            <documentation>An object that contains the properties of a measurement
                result.</documentation>
        </annotation>
    </element>
    <complexType name="PropertyParametersType">
        <complexContent>
            <restriction base="gml:CompositeValueType">
                <sequence>
                    <element ref="diggs:properties" minOccurs="1"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="PropertyType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="propertyName" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                A code or name for the property as used by the data provider. It can
                                come from a controlled list of terms or be an uncontrolled text
                                string, and is commonly used to label a column of a log sheet or
                                give the property a local meaning. The value must be unique among
                                the properties in the dataValues block transmitted as part of this
                                measurement. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="typeData"
                        type="diggs:PropertyDataTypeEnumType">
                        <annotation>
                            <documentation>
                                The data type of this property, for example double, long or string.
                                Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="1" name="propertyClass"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The official name of this property, taken from a dictionary of
                                defined terms. The codeSpace must be populated with the URI of the
                                definition, so that applications can validate the value as a known
                                property. Use the DIGGS property dictionary that serves the host
                                measurement: properties.xml, cpt_interpreted_properties.xml,
                                gp_properties.xml, gr_inj_properties.xml, mwd_properties.xml or
                                pil_properties.xml.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="uom" type="diggs:AllUnits">
                        <annotation>
                            <documentation>
                                The unit of measure of the property. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="srsName" type="anyURI">
                        <annotation>
                            <documentation>
                                For properties that represent a position (for example depth down a
                                borehole, or a geographic position, both in a time-indexed record),
                                the pointer to the spatial reference system the position belongs to:
                                a geospatialSRS, a localCartesianCRS or a
                                LinearSpatialReferenceSystem. The URI must resolve to one of those
                                objects.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="srsDimension" type="positiveInteger">
                        <annotation>
                            <documentation>
                                For properties that represent a position (for example depth down a
                                borehole, or a geographic position, both in a time-indexed record),
                                the dimensionality of the spatial reference system. Where
                                srsDimension is greater than 1, the coordinates in the dataValues
                                block cannot be space-separated, because a parser would read the
                                space as the end of a data record; separate them with |, so that
                                coordinates 10 4 12 are written 10|4|12.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="atTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The temperature at which the property value is valid; for example,
                                for the specific gravity of solids at 20 deg C, the temperature
                                value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisBearing"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                For directional measurements, such as a component of an extensometer
                                or accelerometer, the compass bearing, relative to true north, of
                                the measurement axis.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisInclination"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                For directional measurements, such as an extensometer or
                                accelerometer, the inclination of the measurement axis, positive
                                down from horizontal.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="nullValue" type="diggs:NullDataType">
                        <annotation>
                            <documentation>
                                The value to be interpreted as null for this property in the
                                dataValues block. An empty string is the default null representation
                                when none is defined. The reason attribute gives the reason for the
                                null value, for example withheld; it can be customized with an
                                Other: qualifier (for example Other: below detection limit) or refer
                                to a URI for a fuller definition.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="context" type="string">
                        <annotation>
                            <documentation>
                                The context in which the property is to be interpreted, where it is
                                particular, for example a value valid only for a range of overburden
                                pressures.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleFraction" type="diggs:SampleFractionEnumType">
                        <annotation>
                            <documentation>
                                The fraction of the total sample analyzed. Applies primarily to
                                non-soil samples. Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="grainsizeFraction"
                        type="diggs:SizeFractionPropertyType">
                        <annotation>
                            <documentation>
                                For properties of soils, the size fraction the property pertains to.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="correctionUsed"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                A correction used to obtain the reported result, commonly for
                                N-values from SPT tests, or any other adjustment made to the
                                reported data. A controlled term is preferred. Repeat for each
                                correction. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementTechnique"
                        type="diggs:MeasurementTechniqueEnumType">
                        <annotation>
                            <documentation>
                                The method by which the property value is obtained, from the
                                enumerated list. The formula attribute can describe the formula
                                used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="inputParameter"
                        type="diggs:InputParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter whose value is an input to the calculation of the value
                                of this property. Repeat for each input.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedureRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProcedure</appinfo>
                            <documentation>
                                A reference to the procedure used to obtain this property.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="detectorRef" type="gml:ReferenceType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Detector</appinfo>
                            <documentation>
                                A reference to the source detector within a sensor used to measure
                                this property, if applicable. Generally used for well logs, downhole
                                logging procedures, monitoring equipment or MWD readings. Given by
                                reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="detectionLimits"
                        type="diggs:LimitArrayPropertyType">
                        <annotation>
                            <documentation>
                                The range of allowable values for this property, in the unit of
                                measure of the property.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="reportable" type="boolean"
                        default="true">
                        <annotation>
                            <documentation>
                                Whether the value of this property can be reported outside the
                                context of transmission in an XML instance (true) or not (false).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="qualifier"
                        type="diggs:QualifierPropertyType">
                        <annotation>
                            <documentation>
                                One or more parameters (name, value, or minimum and maximum values)
                                that can qualify the result of this property. Repeat for each
                                qualifier.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="curveState"
                        type="diggs:ChannelStateEnumType">
                        <annotation>
                            <documentation>
                                For well logging procedures, the state or status of the data
                                described by the well log curve, for example calculated from another
                                source, from archive, or raw real time. Values come from the
                                enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="curveDerivation"
                        type="diggs:ChannelDerivationEnumType">
                        <annotation>
                            <documentation>
                                For well logging procedures, the source of the data in the channel.
                                Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="samplingRate"
                        type="diggs:ReciprocalTimeMeasureType">
                        <annotation>
                            <documentation>
                                The raw rate of measurement collection from which any moving
                                averages are derived. Report it if measurementTechnique is moving
                                average.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="index" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>
                            An integer that indicates the position of the property result in the
                            dataValues property.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="InputParameter" type="diggs:InputParameterType">
        <annotation>
            <documentation>
                A parameter that is an input to the calculation of the value of a property.
            </documentation>
        </annotation>
    </element>
    <complexType name="InputParameterType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="parameter" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                The input parameter, as a diggs:Parameter, diggs:AuthorizedParameter
                                or diggs:ProvenancedParameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ProvenancedParameter" type="diggs:ProvenancedParameterType">
        <annotation>
            <documentation>
                An AuthorizedParameter that additionally states what its value describes and where
                the value came from. Use it in preference to diggs:AuthorizedParameter wherever the
                provenance of a value needs to be traceable, such as a design or basis value derived
                from, or assigned on the strength of, specific evidence. It is accepted anywhere
                diggs:ParameterPropertyType or diggs:ParameterArrayPropertyType is used.
            </documentation>
        </annotation>
    </element>
    <complexType name="ProvenancedParameterType">
        <annotation>
            <documentation>
                Type for an authorized parameter that also states the subject and source of its
                value. Extends diggs:AuthorizedParameterType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AuthorizedParameterType">
                <sequence>
                    <element minOccurs="0" maxOccurs="1" name="subjectRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>
                                A reference to the feature or object that the parameter value
                                describes, for example a geotechnical unit, a material or a sampling
                                feature. Optional because the subject is sometimes evident from the
                                object or property that holds the parameter; state it explicitly
                                wherever that context is not enough to identify the subject
                                unambiguously.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="1" name="derivation" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the value was derived from its source or sources, for example
                                characteristic, mean, lower-bound, correlated or assumed. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>A reference to what provides this value's provenance -
                                one kind of source, repeated as needed; a value derived from sources
                                of more than one kind states each as a separate
                                diggs:ProvenancedParameter.</documentation>
                        </annotation>
                        <element maxOccurs="unbounded" ref="diggs:sourceMeasurementRef"/>
                        <element maxOccurs="unbounded" ref="diggs:sourceObservationRef"/>
                        <element maxOccurs="unbounded" ref="diggs:sourceSamplingFeatureRef"/>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DesignFactor" type="diggs:DesignFactorType">
        <annotation>
            <documentation>
                An AuthorizedParameter that additionally states what the value is applied to: a
                partial or global safety factor, or a material reduction factor. It names both the
                factor itself (parameterName, dictionary-bound) and the action, material, resistance
                or property it modifies (appliesTo). Used for the partial or global factor set a
                design's safety format applies, and for geosynthetic reduction factors and material
                factors. The factor and what it applies to are two fields because the same partial
                factor concept, such as a resistance factor, takes different values depending on
                what it is applied to; combining them in one dictionary entry name would multiply
                entries across every standard and factor category.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignFactorType">
        <complexContent>
            <extension base="diggs:AuthorizedParameterType">
                <sequence>
                    <element minOccurs="0" name="appliesTo" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                What the factor is applied to: a permanent action, a variable
                                action, a material property such as friction angle, a resistance
                                such as bearing capacity, or a geosynthetic property such as tensile
                                strength. Optional, but stating it is the reason this type exists
                                rather than diggs:AuthorizedParameter directly; omit it only where
                                the identity of the factor already implies unambiguously what it
                                applies to. Use the DIGGS dictionary appliesTo.xml for the list of
                                values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignFactorPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DesignFactor object inline. A repeating factor
                set uses a repeated element of this type, one factor per element, rather than one
                array wrapper that contains many.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DesignFactor" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="DesignBasisParameter" type="diggs:DesignBasisParameterType">
        <annotation>
            <documentation>
                A named premise a design was prepared from, carrying its value where it has one, the
                condition under which the value applies, and where it came from: a correlation
                coefficient adopted from a published method, a calculation input assumed rather than
                measured, or an adopted design groundwater or ground level. One type serves
                coefficients and assumptions alike, because the distinction between them is not
                structural: an embedment depth conservatively assumed to be zero is both a
                calculation coefficient and a design assumption; the inherited derivation element
                separates an assumed value from a correlated one. It is not a diggs:DesignFactor,
                which is for the partial or global safety factor set a safety format applies and for
                material reduction factors: a bearing factor or mobilization coefficient is a
                premise the calculation consumes, not a margin applied to its result. It is generic,
                not tied to any practice area, and attaches to diggs:AbstractProgramBasisType: a
                deep foundation program adopting an alpha-method adhesion factor, a grouting program
                adopting a permeation radius correlation and a rigid inclusion program adopting a
                penetrometer bearing factor all state the same thing. The type extends
                diggs:ProvenancedParameterType, so parameterName, typeData, the minimum, value and
                maximum, parameterUnits, subjectRef, derivation and the source references are
                inherited. The minimum, value and maximum state a premise as a single value or a
                range, and typeData allows a premise with no numeric value to be stated as text.
                Where the premise is a relationship rather than a scalar, state it in
                functionExpression; where it is a published chart, cite it through
                sourceSpecification and associatedFile and leave the value elements absent.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignBasisParameterType">
        <complexContent>
            <extension base="diggs:ProvenancedParameterType">
                <sequence>
                    <element minOccurs="0" name="appliesToCondition" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The condition under which this value applies, such as a soil
                                behavior class, a material, a loading case or a formation level.
                                Omit it where the premise is unconditional. Where one named premise
                                takes several values under different conditions, state one
                                diggs:DesignBasisParameter per condition rather than one carrying a
                                range, since the values are alternatives selected by condition and
                                not bounds on a single quantity. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="functionExpression" type="string">
                        <annotation>
                            <documentation>
                                The relationship this premise expresses, written out, for example a
                                modulus conversion as the product of a rheological factor and a
                                Young's modulus, or an end bearing pressure as a bearing factor
                                times a cone resistance. Free text, for human reading and citation:
                                no expression language is implied or parsed. Where the relationship
                                is published as a chart with no closed form, leave this absent and
                                cite the chart through sourceSpecification, naming the figure in the
                                standardClause of the referenced Specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="sourceSpecification"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>
                                The standard, code or publication this premise was taken from,
                                referenced into a specification registry or stated inline. Repeat
                                where a value rests on more than one published source.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="associatedFile"
                        type="diggs:AssociatedFilePropertyType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AssociatedFile</appinfo>
                            <documentation>
                                An external file carrying the premise where a value and an
                                expression cannot: for example the scanned or digitized chart a
                                factor is read from, or the spreadsheet a correlation was
                                implemented in.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignBasisParameterPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DesignBasisParameter object inline. A set of
                premises uses a repeated element of this type, one premise per element, matching
                diggs:DesignFactorPropertyType.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DesignBasisParameter" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="SeismicHazardParameters" type="diggs:SeismicHazardParametersType">
        <annotation>
            <documentation>
                The seismic hazard a design adopts as a premise, as a single object: the mapped
                spectral response accelerations, the site class, the site coefficients read against
                that class, and the design peak ground acceleration. They form one object because
                these values are a derivation chain and are close to meaningless apart: site
                coefficients are read from a code table as a function of the site class and the
                mapped accelerations, and a coefficient quoted without its class cannot be checked.
                The object keeps the chain together and lets the standard that supplied it be cited
                once. The element names are code-agnostic, with the familiar symbols given in the
                documentation, so that a design under Eurocode 8, which states a reference peak
                ground acceleration, a ground type and a soil factor, uses the same slots. Every
                element is optional, because codes differ in what they publish; an object that
                states only what its own code supplies is complete. The object carries description,
                name, status and remark, since a hazard statement usually needs to record which map
                edition, return period or study it came from, and remark is where a per-value clause
                citation goes when the values come from several figures of one code.
            </documentation>
        </annotation>
    </element>
    <complexType name="SeismicHazardParametersType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="shortPeriodSpectralAcceleration"
                        type="diggs:LinearAccelerationMeasureType">
                        <annotation>
                            <documentation>
                                The mapped spectral response acceleration at short period for the
                                reference site condition the source code defines: Ss, conventionally
                                at 0.2 s, in IBC/ASCE 7 and codes derived from it. A mapped value
                                before any site adjustment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="onePeriodSpectralAcceleration"
                        type="diggs:LinearAccelerationMeasureType">
                        <annotation>
                            <documentation>
                                The mapped spectral response acceleration at the one-second period
                                for the reference site condition the source code defines: S1 in
                                IBC/ASCE 7 and codes derived from it. A mapped value before any site
                                adjustment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seismicSiteClass"
                        type="diggs:SeismicSiteClassEnumExtType">
                        <annotation>
                            <documentation>
                                The site classification the site coefficients were read against, as
                                investigated: the ground as found, before any improvement. The same
                                element name is used on diggs:RITreatedAreaType and
                                diggs:DesignRITreatedAreaType so that one enumeration governs all
                                three, but they state different facts about the same scale: this one
                                is what the investigation found and the hazard lookup used, the
                                design-side one is what the design predicts improvement will
                                achieve, and the treated-area one is what was achieved. A project
                                that improves the ground enough to change its class states all three
                                and they will not agree; that is the finding, not an error. Values
                                come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shortPeriodSiteCoefficient"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The site coefficient applied to the short-period mapped
                                acceleration: Fa in IBC/ASCE 7 and codes derived from it. It is read
                                from a code table as a function of the site class and the mapped
                                value, which is why it is stated alongside both.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="longPeriodSiteCoefficient"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The site coefficient applied to the one-second mapped acceleration:
                                Fv in IBC/ASCE 7 and codes derived from it.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="peakGroundAcceleration"
                        type="diggs:LinearAccelerationMeasureType">
                        <annotation>
                            <documentation>
                                a_g: the design peak ground acceleration adopted as the seismic
                                hazard premise, read from a national hazard map or a site-specific
                                hazard study for the return period implied by the design working
                                life and consequence class. It is not derivable from the values
                                above and must not be synthesized from them: in ASCE 7 and the codes
                                derived from it, a site-adjusted peak ground acceleration comes from
                                a separately mapped peak ground acceleration and its own site
                                coefficient, and the coefficients above apply to spectral ordinates,
                                not to it. Where a source states spectral values but no peak ground
                                acceleration, leave this absent. It is a
                                diggs:LinearAccelerationMeasureType rather than a dimensionless
                                value because peak ground acceleration is quoted as a fraction of
                                standard gravity at least as often as in m/s2; the mandatory uom,
                                "gn" for the former and "m/s2" for the latter, keeps 0.3 g from
                                being read as 0.3 m/s2. A measured strong-motion record is a
                                different thing in a different domain and is not modelled here.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="hazardStandard"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>
                                The code, map or hazard study the values were taken from. Repeat
                                where a project takes mapped values from one source and a site
                                classification procedure from another. Where every value comes from
                                one code but from different figures or tables within it, cite the
                                code once here and record the per-value clauses in remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SeismicHazardParametersPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SeismicHazardParameters object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SeismicHazardParameters" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="DesignLoad" type="diggs:DesignLoadType">
        <annotation>
            <documentation>
                An applied load a design must resist, such as embankment self-weight, traffic or
                other live load, a structure or slab load, a tank, a footing, a surcharge, or a
                seismic or wind load, together with the limit-state classification needed to use it
                correctly: what kind of load it is, whether it is permanent, variable, accidental or
                seismic, and whether the stated magnitude is a characteristic, factored (design) or
                quasi-permanent value. Generic to any foundation or ground-improvement design.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignLoadType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="actionType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of load: embankment self-weight, traffic or live load,
                                structure or slab load, tank, footing, surcharge, seismic or wind.
                                Use the DIGGS dictionary actionType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="actionNature" type="diggs:ActionNatureEnumExtType">
                        <annotation>
                            <documentation>
                                The EC7/BS limit-state classification of the load: permanent,
                                variable, accidental or seismic. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="representativeValue"
                        type="diggs:RepresentativeValueEnumExtType">
                        <annotation>
                            <documentation>
                                Whether the stated magnitude is a characteristic, factored (design)
                                or quasi-permanent value. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="magnitudePressure" type="diggs:PressureMeasureType">
                            <annotation>
                                <documentation>The load's magnitude as a distributed load per unit
                                    area - the normal case for a surcharge, embankment self-weight,
                                    or slab load.</documentation>
                            </annotation>
                        </element>
                        <element name="magnitudeForce" type="diggs:ForceMeasureType">
                            <annotation>
                                <documentation>The load's magnitude as a concentrated point or line
                                    force - a footing or tank load.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" maxOccurs="unbounded" name="appliesToZoneRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramDesign</appinfo>
                            <documentation>
                                The zone-scoped design this load applies to, for a host design that
                                covers more than one zone with different loading. It references the
                                design object of the zone, not a separate boundary geometry. Omit it
                                where the host design has one loading regime throughout.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignLoadArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:DesignLoad objects inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:DesignLoad"/>
        </sequence>
    </complexType>
    <element name="DesignVerification" type="diggs:DesignVerificationType">
        <annotation>
            <documentation>
                A design check with an outcome, such as buckling, shear, global or slope stability,
                lateral spreading, seismic or liquefaction, punching or structural axial,
                distinguished from a design input or output because its meaning is a verdict against
                a demand and a capacity, not a value. Repeatable, since one design commonly needs
                more than one check, or the same check run under different conditions (static and
                seismic, short-term and long-term); distinguish repetitions by gml:name or remark.
                Distinct from diggs:AbstractAcceptanceCriterionType: a criterion states a limit a
                design must satisfy, declared on the specification side and checked against a
                realized feature after construction, whereas a design verification states the
                outcome of a pre-construction analysis run against that limit, declared on the
                design side.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignVerificationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="verificationType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of check: buckling, shear, global stability, lateral
                                spreading, seismic, liquefaction, punching or structural axial. Use
                                the DIGGS dictionary verificationType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="method" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The analysis method used, where the check is method-dependent: for
                                global stability, the Column-Wall Method (CWM), Equivalent Strength
                                Method (ESM), Stress Reduction Method (SRM), Pile Support Method
                                (PSM) or numerical analysis with the actual RI layout. Use the DIGGS
                                dictionary verificationMethod.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="demand" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The demand value the check compares against capacity - for
                                example the applied shear stress in a shear check, or the applied
                                axial force in a buckling check. A Parameter rather than a fixed
                                measure type because the quantity class varies with
                                verificationType.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="capacity" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The capacity or resistance value the check compares
                                demand against. See demand.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="utilisationRatio"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>Demand divided by capacity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="factorOfSafety"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                Capacity divided by demand, the conventional framing for global
                                stability and lateral spreading checks. State whichever of
                                utilisationRatio or factorOfSafety the analysis produced, or both.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outcome" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The verdict: satisfied, not satisfied, or not required (a check that
                                does not apply to this design). Absent means the check has not yet
                                been run. Use the DIGGS dictionary verificationOutcome.xml for the
                                list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="analysisCaseRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:DesignLoad</appinfo>
                            <documentation>
                                The load case this verification was run against, as the set of
                                diggs:DesignLoad objects that combine to define it, for example the
                                permanent and seismic loads active in a seismic buckling check, as
                                distinct from the permanent and variable loads active in a static
                                one. Repeat for each load in the case. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                Free-text notes on the verification, for example why a check was
                                triggered, or whether the outcome is predicted or verified by
                                post-installation testing.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignVerificationArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:DesignVerification objects inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:DesignVerification"/>
        </sequence>
    </complexType>
    <element name="NonConformance" type="diggs:NonConformanceType">
        <annotation>
            <documentation>
                A record that realized work departed from a stated requirement, and what was decided
                about it. Contained in a diggs:AcceptanceEvaluation, and normally cites the
                diggs:AcceptanceCheck that found the departure. It records the engineering content
                of the finding, not its administration: a non-conformance report as a document is an
                attachment (the inherited associatedFile), a project reference number is the
                inherited gml:name, the open, closed or superseded state is the inherited
                diggs:status, and the narrative of the finding and its resolution is the inherited
                remark. The non-conforming work is identified by at least one of samplingFeatureRef,
                sampleRef, samplingActivityRef, constructionActivityRef, measurementRef or
                observationSystemRef, and subjectLocation narrows it to the part concerned. The
                mandatory gml:id lets a remedial design or a later evaluation cite it. Generic: any
                construction domain that states acceptance criteria can fail to meet them.
            </documentation>
        </annotation>
    </element>
    <complexType name="NonConformanceType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>What departed from the requirement. One kind per
                                non-conformance; repeatable within the kind where one finding
                                affects several subjects. May be omitted where detectedByRef is
                                given, in which case the subject is that of the cited
                                check(s).</documentation>
                        </annotation>
                        <element maxOccurs="unbounded" ref="diggs:samplingFeatureRef"/>
                        <element maxOccurs="unbounded" ref="diggs:sampleRef"/>
                        <element maxOccurs="unbounded" ref="diggs:samplingActivityRef"/>
                        <element maxOccurs="unbounded" ref="diggs:constructionActivityRef"/>
                        <element maxOccurs="unbounded" ref="diggs:measurementRef"/>
                        <element maxOccurs="unbounded" ref="diggs:observationSystemRef"/>
                    </choice>
                    <element minOccurs="0" name="subjectLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The part of the subject this applies to, where it is less than the
                                whole: a depth interval along a linear feature (a grout stage, an
                                anchor bond length or a column segment), an elevation band (a fill
                                lift) or an area. Omit it where it applies to the whole subject.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="disposition" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                What was decided about the non-conforming work: accept as is,
                                repair, rework, replace or reject. Required: the decision is what
                                this record exists to hold. Distinct from correctiveAction: the
                                disposition concerns this non-conforming work, whereas a corrective
                                action concerns the cause, so that the next item does not fail the
                                same way. Use the DIGGS dictionary disposition.xml for the list of
                                values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="correctiveAction"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                An action taken to address the cause of the non-conformance so that
                                it does not recur, such as a change of method, plant, sequence or
                                supervision. Repeat for each action. Absent where the
                                non-conformance was isolated and no cause needed addressing. Use the
                                DIGGS dictionary correctiveAction.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="breachedSpecificationRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
                            <documentation>
                                The requirement that was not met, typically a
                                diggs:DesignConformanceCriterion, a diggs:PerformanceCriterion or a
                                diggs:CompositeAcceptanceCriterion. Repeat where one departure
                                breaches several requirements. Optional where the requirement is
                                stated only in a specification document (an attachment, described in
                                remark), or is the criterion of the check cited by detectedByRef.
                                Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="detectedByRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AcceptanceCheck</appinfo>
                            <documentation>
                                The check or checks that found the departure; the evidence the
                                verdict rests on is cited by the check. Absent where the departure
                                was found by inspection without a formal check. Given by reference
                                only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateIdentified" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                When the non-conformance was identified.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateResolved" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                When the disposition was completed and the non-conformance closed.
                                Absent while it is still open, which the inherited diggs:status
                                states.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="NonConformancePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:NonConformance object inline, or refers to one
                with xlink:href. The reference form lets one evaluation cite a non-conformance
                recorded in another, for example a re-test after remedial work.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:NonConformance"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="AcceptanceCheck" type="diggs:AcceptanceCheckType">
        <annotation>
            <documentation>
                The verdict of evaluating one acceptance criterion against a subject: that the
                verticality of a column was within tolerance, that a grout batch met its strength
                requirement, that a test was performed to its procedure. Records a pass as well as a
                fail; a failure that needs a decision is recorded as a diggs:NonConformance citing
                this check. Contained in a diggs:AcceptanceEvaluation. The subject is identified by
                at least one of samplingFeatureRef, sampleRef, samplingActivityRef,
                constructionActivityRef, measurementRef or observationSystemRef, and subjectLocation
                narrows it to the part concerned. gml:name carries a check reference where a project
                numbers them; diggs:status is the state of this record (draft, reviewed, released),
                which is distinct from outcome, the verdict on the work.
            </documentation>
        </annotation>
    </element>
    <complexType name="AcceptanceCheckType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="criterionRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
                            <documentation>
                                The requirement this check evaluates: a
                                diggs:DesignConformanceCriterion, a diggs:PerformanceCriterion or a
                                diggs:CompositeAcceptanceCriterion. The criterion is the
                                authoritative statement of the property, operator and limit. To
                                evaluate several criteria as one requirement, cite a composite
                                criterion. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <annotation>
                            <documentation>The subject - what was checked. One kind per check;
                                repeatable within the kind where one verdict covers several
                                subjects, as a criterion evaluated over a population
                                does.</documentation>
                        </annotation>
                        <element maxOccurs="unbounded" ref="diggs:samplingFeatureRef"/>
                        <element maxOccurs="unbounded" ref="diggs:sampleRef"/>
                        <element maxOccurs="unbounded" ref="diggs:samplingActivityRef"/>
                        <element maxOccurs="unbounded" ref="diggs:constructionActivityRef"/>
                        <element maxOccurs="unbounded" ref="diggs:measurementRef"/>
                        <element maxOccurs="unbounded" ref="diggs:observationSystemRef"/>
                    </choice>
                    <element minOccurs="0" name="subjectLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The part of the subject this applies to, where it is less than the
                                whole: a depth interval along a linear feature (a grout stage, an
                                anchor bond length or a column segment), an elevation band (a fill
                                lift) or an area. Omit it where it applies to the whole subject.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="determination" type="diggs:DeterminationEnumType">
                        <annotation>
                            <documentation>
                                How the verdict was reached: from a measured value, a derived value
                                or a declaration. Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="outcome" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The verdict: whether the criterion was satisfied. Use the DIGGS
                                dictionary verificationOutcome.xml for the list of values; it is
                                shared with diggs:DesignVerification so that a design-side and an
                                as-built verdict read the same way.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="evidenceMeasurementRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractMeasurement</appinfo>
                            <documentation>
                                A test, survey or monitoring record the compared value was taken
                                from. Repeat where, for example, a statistical criterion draws on
                                several tests. Absent where the value is read from the subject
                                itself, or where the determination is declared. Given by reference
                                only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="evidenceObservationRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservation</appinfo>
                            <documentation>
                                An observation the compared value was taken from, for example the
                                geo-unit whose top surface gives the bearing stratum level at a
                                column. Repeat for several. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded"
                        name="evidenceConstructionActivityRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractConstructionActivity</appinfo>
                            <documentation>
                                A construction activity whose record the compared value was taken
                                from, for example the installation record of the activity that
                                formed a column, from which the depth gained in the last minutes of
                                drilling is read. The activity is cited, not the record inside it.
                                Repeat for several. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="observedValue" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                The value compared against the limit of the criterion, as it stood
                                when the check was made. Where the subject or evidence travels with
                                the file it is the authority; this value lets the verdict be read
                                without it. Normally absent for a declared determination.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="checkDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                When the check was made, distinct from the date of any evidence it
                                relies on.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AcceptanceCheckPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:AcceptanceCheck object inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:AcceptanceCheck"/>
        </sequence>
    </complexType>
    <simpleType name="DeterminationEnumType">
        <restriction base="string">
            <enumeration value="measured">
                <annotation>
                    <documentation>The compared value was measured or recorded directly - on the
                        subject itself or in cited evidence.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="derived">
                <annotation>
                    <documentation>The compared value was computed from recorded values - for
                        example an as-built position against its design position, or the
                        embedment of a column toe below a modelled unit surface.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="declared">
                <annotation>
                    <documentation>No value was compared; conformance was asserted by the party
                        identified on the evaluation - for example by inspection.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="LoadTransferRelation" type="diggs:LoadTransferRelationType">
        <annotation>
            <documentation>
                A shaft (t-z) or tip (q-z) load-transfer relation for one geotechnical unit: the
                mobilization stiffness and limiting resistance that the shaft friction or tip
                bearing of a column develops against that unit, together with which unit it applies
                to and, optionally, the discretized curve behind the stated modulus. Generic design
                machinery, not specific to rigid inclusions: t-z and q-z load-transfer analysis is
                standard deep-foundation practice for driven piles, drilled shafts and micropiles.
                An initial modulus alone discards the shape of the curve: k_tau and k_q are the
                initial slopes of load-transfer curves, and in ASIRI practice they come from the
                Frank and Zhao formulation, which is trilinear (an initial slope, a break, a reduced
                slope and a plateau at the limiting value); the shape governs computed settlement,
                so give the curve where it matters. A relation is per layer, since a single
                site-wide k_tau is meaningless, and relationType and geoUnitRef are both required: a
                classification with no layer, or a layer with no statement of which mechanism it
                governs, is uninterpretable. Mind the sign convention when the object is used for
                the negative skin friction limit q_s: above the neutral plane it is the downdrag
                limit, the opposite sense from the positive shaft resistance below it, for the same
                physical interface. State which regime a given relation describes in remark or in
                the documentation of the referenced diggs:GeoUnitObservation, since limitValue alone
                does not disambiguate it.
            </documentation>
        </annotation>
    </element>
    <complexType name="LoadTransferRelationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="relationType" type="diggs:RelationTypeEnumExtType">
                        <annotation>
                            <documentation>
                                Which mechanism this relation governs: shaft (t-z) or tip (q-z).
                                Required, together with geoUnitRef. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="geoUnitRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:GeoUnitObservation</appinfo>
                            <documentation>
                                The geotechnical unit this relation applies to. Required, and per
                                layer. It references the diggs:GeoUnitObservation directly, the
                                per-unit object in the ground model, not the enclosing
                                diggs:GeoUnitSystem, whose anchoring choice states what the model
                                describes rather than which unit this relation applies to.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="formulation"
                        type="diggs:LoadTransferFormulationEnumExtType">
                        <annotation>
                            <documentation>
                                The load-transfer curve shape adopted, for example Frank-Zhao,
                                linear-elastic-perfectly-plastic, user-defined, or API (for the t-z
                                and q-z formulations of offshore piles). The documentation of each
                                enumerated value gives the exact curve shape. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialModulus"
                        type="diggs:ForcePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                k_tau (shaft) or k_q (tip): the initial slope of the load-transfer
                                curve, the mobilization stiffness at small displacement, before the
                                first break of the curve.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="limitValue" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                q_s (shaft) or q_p (tip): the limiting unit resistance the curve
                                plateaus to at large displacement. See the sign-convention caution
                                on diggs:LoadTransferRelation for the negative skin friction limit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="curve" type="diggs:ResultsPropertyType">
                        <annotation>
                            <documentation>
                                The discretized (displacement, stress) series behind initialModulus
                                and limitValue, where the full curve shape matters and not only its
                                initial slope and plateau. It reuses diggs:ResultsPropertyType,
                                whose diggs:ResultSet holds parameters and a columnar dataValues
                                array: declare a displacement diggs:Property and a stress
                                diggs:Property under parameters, and the paired series under
                                dataValues. It carries no spatial domain, because the domain of a
                                t-z or q-z curve is displacement, not geometry.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LoadTransferRelationArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:LoadTransferRelation objects inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:LoadTransferRelation"/>
        </sequence>
    </complexType>
    <element name="GeoUnitDesignQuantity" type="diggs:GeoUnitDesignQuantityType">
        <annotation>
            <documentation>
                The design-side numbers a deep-foundation axial analysis produces for one
                geotechnical unit: negative skin friction limit, neutral-plane depth and peak axial
                force, toe and shaft resistance, limit unit tip resistance, the adopted
                bearing-stratum level and the subgrade reaction modulus, each keyed to the unit
                through geoUnitRef, as for diggs:LoadTransferRelation. Generic design machinery, not
                specific to rigid inclusions: neutral-plane analysis, end bearing and shaft
                resistance are standard deep-foundation practice. One object serves every role, with
                every field optional except geoUnitRef: shaft friction and shaft resistance are
                stated once per layer the shaft passes through; toe resistance, limit tip resistance
                and the bearing-stratum level apply only to the one unit that is the bearing
                stratum; the neutral-plane depth and peak force describe a single neutral plane that
                falls within exactly one unit; and the subgrade reaction modulus applies per
                soft-soil layer under a load transfer platform. State the subset that applies to the
                role of a unit: a shaft-friction layer states negativeSkinFrictionLimit and
                shaftResistance and leaves the bearing-stratum fields absent, and the bearing
                stratum states toeResistance, limitUnitTipResistance and bearingStratumLevel.
                geoUnitRef is required because every number is meaningless without the unit it was
                computed against; when the instance is the bearing-stratum instance it also supplies
                the reference to the observed stratum top, so no second reference restates it.
                limitState is carried once per object because the neutral-plane depth and peak force
                are serviceability-limit-state quantities, and a file reporting them without the
                limit state is ambiguous: negative skin friction should not be subtracted from
                geotechnical resistance when computing the geotechnical factor of safety, and as the
                factor of safety approaches 1 the neutral plane migrates to the top of the element.
            </documentation>
        </annotation>
    </element>
    <complexType name="GeoUnitDesignQuantityType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="geoUnitRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:GeoUnitObservation</appinfo>
                            <documentation>
                                The geotechnical unit these quantities were computed against.
                                Required.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="limitState" type="diggs:LimitStateEnumExtType">
                        <annotation>
                            <documentation>
                                SLS or ULS. It governs neutralPlaneDepth and
                                maxAxialForceAtNeutralPlane in particular, but is stated once for
                                the instance because a single analysis run is normally computed
                                under one limit state. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="downdragTreatment" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How downdrag was accounted for in the axial analysis of this unit:
                                the neutral-plane method, downdrag folded into a limit-strength
                                check rather than located at a computed plane, engineering
                                experience, or not considered. It governs negativeSkinFrictionLimit,
                                neutralPlaneDepth and maxAxialForceAtNeutralPlane in the same way
                                limitState does, and is stated once per instance for the same
                                reason: two designs reporting the same neutral-plane depth arrived
                                at by different treatments are not comparable. It is declared on
                                this per-unit type, and not only on diggs:RIProgramBasisType,
                                because the values it qualifies live here and a
                                conditionalElementXpath predicate can see only local containment,
                                not the target of a basisRef. Use the DIGGS dictionary
                                downdragTreatment.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="negativeSkinFrictionLimit"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                q_s: the limiting downdrag shear stress above the neutral plane.
                                Mind the sign convention: it is the opposite sense from
                                shaftResistance, the positive shaft resistance below the neutral
                                plane, for the same physical interface.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="neutralPlaneDepth"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                h_c (z_n): the depth at which relative soil and column movement
                                reverses. A position in the linear referencing system of the column,
                                not a bare length: a diggs:PointLocationPropertyType, as
                                diggs:RIColumnType/cutoffElevation is, rather than a
                                diggs:LengthMeasureType that would leave the depth uninterpretable
                                without the datum it was measured from.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxAxialForceAtNeutralPlane"
                        type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Q_max: the peak axial force in the column, including
                                downdrag, occurring at the neutral plane.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearingStratumLevel"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The design-adopted elevation of the top of the bearing stratum. It
                                is distinct from the observed contact of the unit cited by
                                geoUnitRef, which can be a variable surface the designer has
                                idealized to this single level.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toeResistance" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>R_b: the ultimate end-bearing resistance at the
                                toe.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shaftResistance" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                R_s: the ultimate positive skin friction resistance below the
                                neutral plane. See negativeSkinFrictionLimit for the sign
                                convention.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="limitUnitTipResistance"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>q_p / p_l: the unit (per-area) tip resistance or
                                pressuremeter limit pressure - distinct from toeResistance, which is
                                the resulting total force over the toe area.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="subgradeReactionModulus"
                        type="diggs:ForcePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                k_s: the Winkler elastic support stiffness of the soft soil. Not a
                                soil constant: the value depends on the loaded area, so a stated
                                value is comparable only with another computed for a similarly sized
                                loaded area.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GeoUnitDesignQuantityArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:GeoUnitDesignQuantity objects inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:GeoUnitDesignQuantity"/>
        </sequence>
    </complexType>
    <element name="DesignTension" type="diggs:DesignTensionType">
        <annotation>
            <documentation>
                One tensile force component a geosynthetic reinforcement layer must carry, together
                with the load path it comes from: arching between column heads, lateral spreading,
                differential settlement, or their sum. The components are separate objects, repeated
                once per component, because they are different forces that one symbol would
                conflate. Both fields are required: a tension value with no stated source cannot be
                checked against the right design case, and a source with no magnitude carries no
                information.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignTensionType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="magnitude" type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>The tensile force per unit width this component
                                contributes.</documentation>
                        </annotation>
                    </element>
                    <element name="tensionSource" type="diggs:TensionSourceEnumExtType">
                        <annotation>
                            <documentation>
                                The load path this component comes from: arching, lateral spreading,
                                differential settlement, or sum (the combined design tension). The
                                lateral-spreading demand on the reinforcement is the lateral
                                spreading value of this code. Values come from the enumerated list,
                                or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DesignTensionPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DesignTension object inline. A repeating set
                of tension components uses a repeated element of this type, one component per
                element, rather than one array wrapper that contains many.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:DesignTension" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="DesignGeosyntheticLayer" type="diggs:DesignGeosyntheticLayerType">
        <annotation>
            <documentation>
                The design of one geosynthetic reinforcement layer within a load transfer platform:
                product identity, stiffness and strength (each meaningless without the strain level
                and elapsed time they were taken at), the reduction factors applied to reach a
                long-term design value, the tension the layer must carry by load path, anchorage,
                allowable strain, and where the layer sits within the platform. Generic design
                machinery, not specific to rigid inclusions: geosynthetic-reinforced load transfer
                platforms are standard practice for column-supported embankments generally,
                including stone columns and driven piles. The as-built counterpart,
                diggs:GeosyntheticType, is declared in the rigid inclusion schema, so design and
                as-built for this concept are in different files. Tensile stiffness (J) is an
                isochronous secant modulus, defined only once a strain level and elapsed time are
                stated, and long-term design strength depends on design life and the
                reduction-factor chain in the same way; both are also direction-dependent, since
                machine and cross-machine directions differ substantially in most geogrids. Hence
                atStrain, atTime and atDesignLife accompany the stiffness and strength, and
                direction is its own field. Repeat this object once per layer: its presence states
                that basal reinforcement is used and the number of repeats is the layer count, so
                neither is stated as a separate value.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignGeosyntheticLayerType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" name="manufacturer" type="string">
                        <annotation>
                            <documentation>The geosynthetic product's manufacturer or
                                brand.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="productName" type="string">
                        <annotation>
                            <documentation>The manufacturer's product name or designation.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="polymerType" type="diggs:PolymerTypeEnumExtType">
                        <annotation>
                            <documentation>
                                The polymer the geosynthetic is manufactured from, for example HDPE,
                                PET, PP, PVA, PA, aramid or basalt. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="reinforcementType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The product form, for example geogrid uniaxial, geogrid biaxial,
                                geogrid triaxial or geotextile woven. Use the DIGGS dictionary
                                geosyntheticReinforcementType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="direction" type="diggs:DirectionEnumExtType">
                        <annotation>
                            <documentation>
                                The direction the stiffness, strength and design tension values
                                apply in: machine, cross-machine, normal or planar.
                                diggs:GeosyntheticType (as-built) carries a matching direction
                                field, so the stated orientation of the installed layer can be
                                compared with the direction this design value governs. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tensileStiffness"
                        type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>
                                J (J_k): the isochronous secant tensile stiffness at atStrain and
                                atTime.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="atStrain" type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>The strain level tensileStiffness was taken
                                at.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="atTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The elapsed time tensileStiffness was taken at; an isochronous
                                modulus is defined only together with this value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="longTermDesignStrength"
                        type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>
                                T_D (R_B,d): the factored long-term tensile strength, at
                                atDesignLife.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="atDesignLife" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>The design life longTermDesignStrength is factored
                                for.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="reductionFactor"
                        type="diggs:DesignFactorPropertyType">
                        <annotation>
                            <documentation>
                                The creep, installation-damage, weathering, chemical-degradation and
                                joint or seam reduction factors (A1 to A5) and the material partial
                                factor (f_m) applied to reach longTermDesignStrength from the
                                characteristic strength of the geosynthetic. Each is a
                                diggs:DesignFactor, the same object used for the partial and global
                                safety factor set of a design's safety format. Repeat for each
                                factor.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneFactor"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                Ω: the membrane factor the beam method (FHWA GEC-13 Eq. 3-26,
                                tabulated against strain in Table 6-2, Young et al. 2003) multiplies
                                the load carried by this layer and half the design span by to obtain
                                designTension, where the more general parabolic method (Eq. 3-25)
                                instead solves for tension from tensileStiffness and atStrain
                                directly. It is a method-specific input to that output, not a
                                breakdown of it, and is specific to the FHWA beam method: BS 8006-1
                                (Eq 3-16) and EBGEO (Eq 3-20) obtain tension as tensileStiffness
                                times strain directly, and the ASIRI unit-cell method does not
                                compute geosynthetic membrane tension at all. It is a plain measure
                                type, not an authorized parameter, because its name alone identifies
                                it. Nothing in the schema links this value to the method that
                                produced it, and nothing prevents populating it alongside a design
                                that otherwise used BS 8006-1 or EBGEO; state the method in remark
                                or in the designMethod of the design's basis
                                (diggs:RIProgramBasisType, through basisRef), as for
                                diggs:DesignRILTPType/criticalHeight and the arching model.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="designTension"
                        type="diggs:DesignTensionPropertyType">
                        <annotation>
                            <documentation>
                                The tensile force this layer must carry, split by load path; see
                                diggs:DesignTension. The lateral-spreading demand is stated as the
                                lateral spreading component.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="anchorageLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                L_e, L_b (L_A): the embedment length beyond the outer row of
                                columns.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="allowableStrain"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The permitted tensile strain.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="creepStrainLimit"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The additional creep strain allowed over the design life, beyond
                                allowableStrain. The 15% minimum-load-fraction floor is a criterion,
                                not a design value, and is not carried here; see
                                diggs:AbstractAcceptanceCriterionType.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="midSpanDeflection" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                y: the sag of this reinforcement layer between column heads.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="elevation" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The elevation of this layer within the platform. The same type as
                                diggs:GeosyntheticType/elevation (as-built), for direct comparison.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extent" type="diggs:PlanarSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The lateral extent of this layer within the platform, if it does not
                                extend across the whole platform. The same type as
                                diggs:GeosyntheticType/extent (as-built), for direct comparison.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GeosyntheticLayerDesignArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:DesignGeosyntheticLayer objects
                inline.
            </documentation>
        </annotation>
        <sequence minOccurs="0" maxOccurs="unbounded">
            <element ref="diggs:DesignGeosyntheticLayer"/>
        </sequence>
    </complexType>

    <element name="RelativeLocation" type="diggs:RelativeLocationType">
        <annotation>
            <documentation>
                A position stated relative to the geometry of a feature, without a CRS: depth,
                distance along the feature, or a two- or three-dimensional offset in the frame of
                the feature. Generic to any planned position where a real spatial reference system
                does not yet exist, such as a design-stage sample position. It is not a degenerate
                or provisional geometry but a different kind of fact, stated without any CRS, and so
                it is not admitted by diggs:LocationPropertyType and does not substitute
                diggs:AbstractGeometry: a realized position is normally stated within the linear
                referencing system of the feature or a diggs:LocalCartesianCRS, and a
                diggs:LocalCartesianCRS requires a real origin and axis location, which do not exist
                before the feature does. Resolving a planned position against the actual geometry of
                a realized feature is a validation job. Depth (downward from the collar or top of
                the feature) and distance (along the path of the feature) are separate elements
                because they are different measurements, as are relativePosition2D and
                relativePosition3D, which name the chunk width. Several positions are stated as a
                list in one element: "samples at 5, 10, 25 and 30 ft" is one diggs:RelativeLocation
                with a four-item depth list; that a list divides evenly by its chunk width is not
                enforced, as for gml:posList. Per-position metadata, such as a different method or
                remark at one depth, is not expressible here: a position that needs its own is a
                different sample design with its own scope.
            </documentation>
        </annotation>
    </element>
    <complexType name="RelativeLocationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>What this position is relative to - a sampling feature or
                                a sample. Optional because the hosting object (for example
                                diggs:SampleDesignScopeType/sourceFeatureRef) commonly already names
                                it; state it here only where this diggs:RelativeLocation is used
                                somewhere that does not.</documentation>
                        </annotation>
                        <element ref="diggs:relativeToSamplingFeatureRef"/>
                        <element ref="diggs:relativeToSampleRef"/>
                    </choice>
                    <choice>
                        <element name="depth" type="diggs:LengthDoubleListMeasureType">
                            <annotation>
                                <documentation>
                                    One or more depths, downward from the collar or top of the
                                    feature, as a flat list sharing one unit: "5 10 25 30 ft" is one
                                    element holding four depths.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="distance" type="diggs:LengthDoubleListMeasureType">
                            <annotation>
                                <documentation>
                                    One or more distances along the path of the feature (for example
                                    a horizontal borehole, or a trench measured from an end), as a
                                    flat list sharing one unit.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="relativePosition2D" type="diggs:LengthDoubleListMeasureType">
                            <annotation>
                                <documentation>
                                    One or more two-dimensional offsets in the frame of the feature
                                    (for example a position on a trench or test-pit face), as a flat
                                    list of coordinate pairs sharing one unit: "1 2 3 4" is two
                                    positions. See frameConvention for what the two ordinates mean.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="relativePosition3D" type="diggs:LengthDoubleListMeasureType">
                            <annotation>
                                <documentation>
                                    One or more three-dimensional offsets in the frame of the
                                    feature, as a flat list of coordinate triples sharing one unit.
                                    See frameConvention for what the three ordinates mean.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="frameConvention" type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                What the axes of relativePosition2D and relativePosition3D mean; it
                                is required for them to be meaningful, since there is no CRS to
                                define them. Not meaningful for depth and distance, which are
                                self-describing one-dimensional measures with only one axis to name.
                                The codeSpace is required. Use the DIGGS dictionary
                                frameConvention.xml for the list of values. The dictionary is
                                provisional: it was built from practice (station, offset and
                                elevation project baselines; trench and test-pit face logging grids)
                                rather than from a single citable naming standard.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="RelativeLocationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:RelativeLocation object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:RelativeLocation"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <element name="SamplingInterval" type="diggs:SamplingIntervalType">
        <annotation>
            <documentation>
                A regular spacing along a feature, optionally bounded: "every 5 ft", or "every 5 ft
                between 2 m and 20 m". Generic to any regularly spaced planned provision along a
                feature.
            </documentation>
        </annotation>
    </element>
    <complexType name="SamplingIntervalType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="spacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The regular spacing between positions.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="from" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The depth or distance the interval begins at. Absent means unbounded
                                at this end: the interval applies from the start of the feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="to" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The depth or distance the interval ends at. Absent means unbounded
                                at this end: the interval applies to the end of the feature.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SamplingIntervalPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SamplingInterval object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:SamplingInterval"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <element name="SampleDesignScope" type="diggs:SampleDesignScopeType">
        <annotation>
            <documentation>
                Which population a sample design's activity draws from, and how densely or in what
                pattern: the sample-design counterpart of diggs:SFDesignScopeType. Two independent
                questions: where from (a zone, one or more sampling-feature designs, or one or more
                source samples or sample designs) and how many or what pattern (a count, an
                interval, explicit positions or a stride). Population selection is not restated
                here: "all boreholes", "a specific one" and "based on zone" are what
                diggs:SFDesignScopeType states on the sampling-feature design itself, and
                sourceFeatureRef cites that design rather than repeating its zone, count and
                position logic. zone is also available directly, for scoping straight to a region
                without an intermediate sampling-feature design to cite. There are two population
                kinds because they are different relations: a sample collected from a sampling
                feature (sourceFeatureRef) is a different fact from a sample subsampled or
                aggregated from another sample or sample design (sourceSampleRef, typed
                diggs:FractionalReferenceType so that a subsample can state what percentage of its
                source it takes). The selection choice is optional and can be absent: absence means
                every member of the population, or one per referenced feature, which is the natural
                reading for "aggregate all bulk samples from these three test pits".
            </documentation>
        </annotation>
    </element>
    <complexType name="SampleDesignScopeType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <choice>
                        <element name="zone" type="diggs:PlanarSurfaceOrMultiSurfacePropertyType">
                            <annotation>
                                <documentation>
                                    The area this sample design applies to. A feature fulfils this
                                    scope if its reference point lies within this zone, the same
                                    test diggs:SFDesignScopeType/zone applies.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" name="sourceFeatureRef"
                            type="diggs:FeatureReferenceType">
                            <annotation>
                                <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeatureDesign</appinfo>
                                <documentation>
                                    One or more sampling-feature designs this sample design collects
                                    from: a collection of boreholes, or a single reference for a
                                    specific one. This is plan-to-plan: it cites a
                                    diggs:AbstractSamplingFeatureDesign or a specialization (for
                                    example diggs:DesignBorehole or diggs:DesignInstallation), an
                                    antecedent within the plan graph, never a realized sampling
                                    feature.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" name="sourceSampleRef"
                            type="diggs:FractionalReferenceType">
                            <annotation>
                                <appinfo source="urn:x-gml:targetElement">diggs:DesignSample</appinfo>
                                <documentation>
                                    One or more sample designs this one is to be subsampled or
                                    aggregated from: "aggregate all bulk samples from these three
                                    test pits" cites the sample designs of the source pits, not the
                                    pits. This is plan-to-plan: it cites a diggs:DesignSample, an
                                    antecedent within the plan graph, never a realized sample.
                                    Meaningful only where the activityType of the host design is
                                    aggregate or subsample; the schema cannot enforce that
                                    correlation.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="sampleCount" type="positiveInteger">
                            <annotation>
                                <documentation>
                                    A total count across the population: "50 split-barrel samples
                                    from this collection of boreholes".
                                </documentation>
                            </annotation>
                        </element>
                        <element name="samplingInterval" type="diggs:SamplingIntervalPropertyType">
                            <annotation>
                                <documentation>
                                    A regular spacing along each referenced feature, optionally
                                    bounded: "every 5 ft", or "every 5 ft between 2 m and 20 m".
                                </documentation>
                            </annotation>
                        </element>
                        <element name="samplingPosition" type="diggs:RelativeLocationPropertyType">
                            <annotation>
                                <documentation>
                                    One or more specific planned positions, relative to each
                                    referenced feature: "samples at 5, 10, 25 and 30 ft".
                                </documentation>
                            </annotation>
                        </element>
                        <element name="selectionStride" type="positiveInteger">
                            <annotation>
                                <documentation>
                                    Take every Nth member of the population, in whatever order it is
                                    otherwise enumerated: "subsample every other split-barrel
                                    sample" is a stride of 2. Meaningful only for a sourceSampleRef
                                    or sourceFeatureRef population with an inherent order;
                                    meaningless for zone, which has none.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SampleDesignScopePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SampleDesignScope object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:SampleDesignScope"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <element name="PredictedSettlement" type="diggs:PredictedSettlementType">
        <annotation>
            <documentation>
                One component of a predicted settlement: immediate, primary consolidation, secondary
                or creep, total, or a further breakdown (load transfer platform compression, elastic
                shortening of the column with downdrag, settlement of the bearing stratum below the
                toe), together with which component it is. Generic design-output machinery, not
                specific to rigid inclusions: settlement prediction and its component breakdown is
                standard ground-improvement and deep-foundation practice. A bare total settlement
                number has nothing for a monitoring result to be checked against component by
                component, so stating the components makes a measured-versus-predicted comparison
                meaningful. Both fields are required: a settlement value with no stated component
                cannot be compared against the right monitoring result, and a component with no
                value carries no information.
            </documentation>
        </annotation>
    </element>
    <complexType name="PredictedSettlementType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="settlementValue" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The predicted magnitude of this settlement
                                component.</documentation>
                        </annotation>
                    </element>
                    <element name="settlementComponent" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                Which component this value is: immediate, primary consolidation,
                                secondary or creep, total, or, in a further decomposition, load
                                transfer platform compression, rigid inclusion elastic shortening or
                                bearing-stratum settlement. Use the DIGGS dictionary
                                settlementComponent.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PredictedSettlementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PredictedSettlement object inline. A repeating
                settlement breakdown uses a repeated element of this type, one component per
                element, as for diggs:DesignFactorPropertyType and diggs:DesignTensionPropertyType.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:PredictedSettlement" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element abstract="false" name="Qualifier" type="diggs:ParameterType">
        <annotation>
            <documentation>
                A parameter upon which the result of a property can be qualified.
            </documentation>
        </annotation>
    </element>
    <element name="Remark" type="diggs:RemarkType" abstract="false">
        <annotation>
            <documentation>A remark or comment relevant to the containing object or feature,
                optionally including the remark's author and date.</documentation>
        </annotation>
    </element>
    <complexType name="RemarkType">
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <element name="content" type="string" minOccurs="1" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The text of the remark.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="author" type="diggs:BusinessAssociatePropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                The author of the remark. Repeat for several authors.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="remarkDateTime" type="gml:TimePositionType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The date and time of the remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ResultFile" type="diggs:ResultFileType" substitutionGroup="gml:File">
        <annotation>
            <documentation>
                A means of encoding the diggs:ResultSet in an arbitrary external encoding, such as a
                binary file, for efficiency. The encoding can be well known but this is not
                required. The values of the dataValues element of the measurement are transmitted in
                an external file referenced from the structure described by diggs:ResultFileType;
                the file can be located remotely from the referencing DIGGS instance, since
                fileReference is an anyURI. The compression property points, through an anyURI, to a
                definition of the compression algorithm: a retrievable, computable definition, or
                simply a reference to an unambiguous name. The mimeType property points to a
                definition of the file mime type. The fileStructure property is defined by a
                codelist but should be "Record Interleaved" to preserve the required structure of
                dataValues: each record contains a set of fields in parameter order, and each record
                in document order is associated with a value, in order, in the location or
                timeDomain property of the measurement. If a compression algorithm is applied, that
                structure applies only to the pre-compression or post-decompression file.
            </documentation>
        </annotation>
    </element>
    <complexType name="ResultFileBaseType">
        <annotation>
            <documentation>
                Abstract base type for result files: the parameters, the file reference and the file
                structure.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:FileType">
                <sequence>
                    <element ref="diggs:parameters"/>
                    <choice>
                        <element ref="diggs:fileReference"/>
                    </choice>
                    <element minOccurs="1" ref="diggs:fileStructure"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="ResultFileType">
        <complexContent>
            <extension base="diggs:ResultFileBaseType">
                <sequence>
                    <element minOccurs="0" name="mimeType" type="diggs:MimeTypeEnumExtType">
                        <annotation>
                            <documentation>
                                The mime type of the file. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one). For a mime type that
                                is not registered, xx is type/subtype with a subtype that begins
                                with "x-", for example Other: application/x-segy.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="compression" type="anyURI">
                        <annotation>
                            <documentation>
                                A value, as a URI, that identifies the compression algorithm used,
                                if applicable.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ResultSet" substitutionGroup="gml:DataBlock" type="diggs:ResultSetType">
        <annotation>
            <documentation>
                An object that holds the parameters and the data values of a measurement result.
            </documentation>
        </annotation>
    </element>
    <complexType name="ResultSetType">
        <complexContent>
            <restriction base="gml:DataBlockType">
                <sequence>
                    <element ref="diggs:parameters" minOccurs="1"/>
                    <choice>
                        <element ref="diggs:dataValues"/>
                    </choice>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <element abstract="false" name="Role" type="diggs:RoleType">
        <annotation>
            <documentation>A role is the function assumed or part played by a business associate in
                relation to the containing DIGGS feature.</documentation>
        </annotation>
    </element>
    <complexType name="RoleType">
        <complexContent>
            <extension base="gml:AbstractMetadataPropertyType">
                <sequence>
                    <element name="rolePerformed" type="gml:CodeType" minOccurs="1" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The role that was performed. Use the DIGGS dictionary roles.xml for
                                the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="timePerformed" type="diggs:TimeIntervalPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The time the role was performed.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this role. Repeat for each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="businessAssociate" type="diggs:BusinessAssociatePropertyType"
                        maxOccurs="unbounded" minOccurs="1">
                        <annotation>
                            <documentation>
                                The business associate performing the role. Repeat where several
                                perform it.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SampleProduced" type="diggs:SampleProducedType">
        <annotation>
            <documentation>
                An object that defines the time and location of a sample produced by a sampling
                activity.
            </documentation>
        </annotation>
    </element>
    <complexType name="SampleProducedType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location"/>
                    <element minOccurs="0" name="sampleTime" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The start and end time of sample collection.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SizeFraction" type="diggs:SizeFractionType">
        <annotation>
            <documentation>
                The range of grain sizes used for this test procedure, expressed as a minimum grain
                size (for a sample with grain sizes above a certain size), a maximum grain size (for
                a sample with grain sizes below a certain size), or both, for a sample with grain
                sizes between the two. It also states the percentage of the total sample the
                fraction represents.
            </documentation>
        </annotation>
    </element>
    <complexType name="SizeFractionType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="minimumGrainSize"
                        type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>
                                The smallest grain size in the sample fraction used for this
                                procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maximumGrainSize"
                        type="diggs:ParticleSizeMeasureType">
                        <annotation>
                            <documentation>
                                The largest grain size in the sample fraction used for this
                                procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentOfTotalSample"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The fraction of the total sample used for the procedure, for example
                                the fraction of the total sample represented by the size fraction
                                used.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SoftwareApplication" type="diggs:SoftwareApplicationType" abstract="false">
        <annotation>
            <documentation>A computer program designed to carry out a specific task.</documentation>
        </annotation>
    </element>
    <complexType name="SoftwareApplicationType">
        <complexContent>
            <extension base="diggs:AbstractNamedObjectType">
                <sequence>
                    <element name="version" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The version of the software application.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Specification" type="diggs:SpecificationType"
        substitutionGroup="diggs:AbstractProcedure" abstract="false">
        <annotation>
            <documentation>
                An object that describes the specification or method used for testing or
                construction, by citing a published standard or a clause of one: an ASTM or AASHTO
                method, a national standard, a project specification clause. Its properties identify
                the document rather than state requirements: standardReferenceNumber, standardTitle,
                standardVersion, standardPart, standardClause and the accrediting body. Not to be
                confused with diggs:AbstractProgramSpecification. diggs:Specification is a component
                object, a procedure that substitutes diggs:AbstractProcedure, held by
                diggs:SpecificationPropertyType wherever a feature says which method it followed; it
                states no requirement of its own, because the requirement lives in the cited
                document. diggs:AbstractProgramSpecification is a feature head whose members are
                features a program issues, carrying the tolerances and acceptance limits the work is
                judged against and the scope over which they apply; a realized feature cites one
                through diggs:programSpecificationRef. If it was published by a standards body or
                written into a contract and you are pointing at it, use diggs:Specification; if your
                program is issuing the requirement itself, use a member of
                diggs:AbstractProgramSpecification.
            </documentation>
        </annotation>
    </element>
    <complexType name="SpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProcedureType">
                <sequence>
                    <choice minOccurs="0" maxOccurs="1">
                        <element name="accredtingBody" type="string">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:accreditingBody"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use accreditingBody; this name is a
                                    misspelling of it. Identification of the accrediting body and
                                    reference number, if applicable.</documentation>
                            </annotation>
                        </element>
                        <element name="accreditingBody" type="string">
                            <annotation>
                                <documentation>
                                    Identification of the accrediting body and its reference number,
                                    if applicable. Use this element, not the deprecated
                                    accredtingBody.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="shortMethodName" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The short name of a method contained in the specification, for
                                example Method A.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="standardClause" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The clause of the standard that applies.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="standardPart" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The part of the standard that applies.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="standardReferenceNumber" type="string" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The number or numeric identifier of the standard.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="standardTitle" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The title of the standard.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="standardVersion" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The version of the standard.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSpecificationProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter for a specification property not otherwise provided for.
                                Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TemperatureMeasurement" type="diggs:TemperatureMeasurementType">
        <annotation>
            <documentation>A temperature measurement optionally taken at a specific time
                instant.</documentation>
        </annotation>
    </element>
    <complexType name="TemperatureMeasurementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemperatureMeasurement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TemperatureMeasurement"/>
        </sequence>
    </complexType>
    <complexType name="TemperatureMeasurementType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date and time of the temperature measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="temperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The measured temperature.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TimeInterval" type="diggs:TimeIntervalType">
        <annotation>
            <documentation>An interval of time, expressed by a start and end time, or optionally as
                a start time, end time and/or duration.</documentation>
        </annotation>
    </element>
    <complexType name="TimeIntervalType">
        <annotation>
            <documentation>
                Type for an interval of time: a start, and optionally an end and a duration.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="start" type="gml:TimePositionType" maxOccurs="1" minOccurs="1">
                        <annotation>
                            <documentation>
                                The date and time that begins the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="end" type="gml:TimePositionType" maxOccurs="1" minOccurs="0">
                        <annotation>
                            <documentation>
                                The date and time that ends the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="duration" type="diggs:TimeMeasureType" maxOccurs="1"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The duration of the interval since the start.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Uncertainty" type="diggs:UncertaintyType" abstract="false">
        <annotation>
            <documentation>
                An object that defines uncertainty values for the coordinates of a location.
                Uncertainty values must be expressed in the same unit of measure as the
                corresponding coordinate axis of the CRS of the associated geometry.
            </documentation>
        </annotation>
    </element>
    <complexType name="UncertaintyType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="plusUncertaintyValue"
                        type="diggs:DescriptorValueType">
                        <annotation>
                            <documentation>
                                The positive uncertainty, reported as plus from the reported value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minusUncertaintyValue"
                        type="diggs:DescriptorValueType">
                        <annotation>
                            <documentation>
                                The negative uncertainty, reported as minus from the reported value.
                            </documentation>
                        </annotation>
                    </element>

                    <element minOccurs="0" name="confidenceLevel"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The confidence level of the uncertainty, reported as a percentage,
                                for example 95%.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertaintyRepresentation"
                        type="diggs:UncertaintyRepresentationEnumExtType">
                        <annotation>
                            <documentation>
                                How the uncertainty values are to be interpreted, for example
                                plus-minus, standard deviation or maximum error. Values come from
                                the enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>

                </sequence>
            </extension>
        </complexContent>
    </complexType>

