        <annotation>
            <appinfo>DEPRECATED 1/26. Use geometry object in the location property instead.</appinfo>
            <documentation>The easting or x-coordinate value. DEPRECATED, a geometry object in the
                location property holding the same coordinate should be used
                instead.</documentation>
        </annotation>
    </element>
    <element name="northing" type="diggs:LengthMeasureType">
        <annotation>
            <appinfo>DEPRECATED 1/26. Use geometry object in the location property instead.</appinfo>
            <documentation>The northing or y-coordinate value DEPRECATED, a geometry object in the
                location property holding the same coordinate should be used
                instead.</documentation>
        </annotation>
    </element>
    <element name="elevation" type="diggs:LengthMeasureType">
        <annotation>
            <appinfo>DEPRECATED 1/26. Use geometry object in the location property instead.</appinfo>
            <documentation>Elevation value, positive up. DEPRECATED, a geometry object in the
                location property holding the same coordinate should be used
                instead.</documentation>
        </annotation>
    </element>
    <element name="implementationStatus" type="gml:CodeType">
        <annotation>
            <appinfo>DEPRECATED 1/26. A program design object should be used for tracking progress from design through completion.</appinfo>
            <documentation>A text string describing the implementation status of the object or the
                completion status of the activity. Terms used (usch as in progress, completed,
                etc.) are intended to come from a controlled list of terms. DEPRECATED. A program
                design object should be used for tracking progress from design through
                completion.</documentation>
        </annotation>
    </element>

</schema>
