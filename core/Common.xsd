<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <!-- Uncomment to clear validation errors without a master file -->
    <include schemaLocation="../Diggs.xsd"/>

    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>

    <!-- =========================================================================== -->
    <!-- ROOT TYPES                                                               -->
    <!-- =========================================================================== -->

    <element name="Diggs" type="diggs:DiggsType" substitutionGroup="gml:AbstractFeature"
        abstract="false">
        <annotation>
            <documentation>
                The root element of a DIGGS XML instance document. It contains all geotechnical,
                geoenvironmental, geophysical and construction data for exchange, as the top-level
                container for projects, sampling features, samples, tests, observations and
                construction activities. A valid DIGGS document has exactly one Diggs root element.
            </documentation>
        </annotation>
    </element>

    <!-- =========================================================================== -->
    <!-- UTILITY TYPES                                                               -->
    <!-- =========================================================================== -->

    <complexType name="ComponentObjectNoDescriptionType" mixed="false">
        <annotation>
            <documentation>
                Base type for component objects without description or name: retains only
                identifier, status and remark. Used where the description is managed externally or
                is not needed.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractComponentObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>
                                    A comment or remark about this object, as a diggs:Remark. Repeat
                                    for each remark.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
                <attribute ref="gml:id" use="optional">
                    <annotation>
                        <documentation>
                            The identifier of the object (gml:id). Optional; where given it must be
                            unique within the DIGGS instance.
                        </documentation>
                    </annotation>
                </attribute>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="CostType">
        <simpleContent>
            <extension base="decimal">
                <attribute name="currency" type="diggs:CurrencyEnumType" use="required">
                    <annotation>
                        <documentation>
                            The currency of the cost, as an ISO 4217 three-letter code. Each
                            enumerated value is documented with the currency name and the country or
                            territory where it is used. Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="FractionalReferenceType">
        <annotation>
            <documentation>
                Type for a reference to a feature that can state the proportion the referenced
                feature contributes: a diggs:FeatureReferenceType with an optional percentage
                attribute (0 to 100).
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:FeatureReferenceType">
                <attribute name="percentage" type="diggs:Val0-100Type" use="optional">
                    <annotation>
                        <documentation>
                            The proportion, as a percentage between 0 and 100, that the referenced
                            feature contributes. Used to express proportions or composition.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="IdentifierReferenceType">
        <restriction base="string"> </restriction>
    </simpleType>
    <complexType name="InsituTestProcedureType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LaboratoryTestProcedureType">
        <annotation>
            <documentation>
                Concrete type for general laboratory test procedures. Extends
                diggs:AbstractLaboratoryTestProcedureType without adding elements. Used where no
                specialized laboratory test procedure type is needed.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ObjectNoDescriptionType" mixed="false">
        <annotation>
            <documentation>
                Base type for objects without description or name: retains only identifier, status
                and remark. Used for objects whose description is managed externally or is not
                needed.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>
                                    A comment or remark about this object, as a diggs:Remark. Repeat
                                    for each remark.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
                <attribute ref="gml:id" use="required">
                    <annotation>
                        <documentation>
                            The identifier of the object (gml:id). Required, and unique within the
                            DIGGS instance.
                        </documentation>
                    </annotation>
                </attribute>
            </restriction>
        </complexContent>
    </complexType>
    <simpleType name="OtherNameType">
        <annotation>
            <documentation>
                Simple type that lets a controlled list be extended where none of the enumerated
                values suits: a value of the form "Other: xx", where xx is two or more characters.
                Such a value is schema valid, but using the "Other" prefix can cause
                interoperability issues.
            </documentation>
        </annotation>
        <restriction base="string">
            <pattern value="Other: .{2,}"/>
        </restriction>
    </simpleType>
    <complexType name="TimeDomainType">
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:AbstractTimeObject"/>
                    </choice>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <simpleType name="Val0-100Type">
        <annotation>
            <documentation>
                Double value constrained between 0 and 100 inclusive, for percentages and other
                values that must fall within that range.
            </documentation>
        </annotation>
        <restriction base="double">
            <minInclusive value="0"/>
            <maxInclusive value="100"/>
        </restriction>
    </simpleType>

    <!-- =========================================================================== -->
    <!-- COMMON PROPERTIES                                                           -->
    <!-- =========================================================================== -->

    <element name="baseBoundary" type="diggs:BoundaryPropertyType">
        <annotation>
            <documentation>
                Description of the boundary at the base of the observed zone or interval, as defined
                in the location of the observation. Where the location is planar or volumetric and
                the character of the boundary changes along its length or surface, the element can
                repeat if the host type allows more than one. For a linear sampling feature only the
                first in document order applies, and any further ones are ignored.
            </documentation>
        </annotation>
    </element>
    <element name="basedOnRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramModule</appinfo>
            <documentation>
                A reference to a more general program module that this one specializes. Resolution
                is per property, most specific first: a value stated on the referring object
                overrides the same property stated on the target. The target must belong to the same
                substitution-group head as the referring object (a design cites a design, a
                specification a specification, a basis a basis), and chains must be acyclic; the
                validation chain checks both. A design that cites a specification belongs in
                programSpecificationRef instead. Distinct from basisRef, which cites the evidence a
                design was prepared from rather than a more general object of the same kind.
            </documentation>
        </annotation>
    </element>
    <element name="basisRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramBasis</appinfo>
            <documentation>
                A reference to a program basis object: the evidence, ground model, requirement set
                or other input a design or specification was prepared from. Distinct from
                basedOnRef, which cites a more general object of the same kind that this one
                specializes, and from programSpecificationRef, which cites a constraint the design
                must satisfy.
            </documentation>
        </annotation>
    </element>
    <element name="constructionActivityRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractConstructionActivity</appinfo>
            <documentation>
                A reference to the construction activity associated with this feature. Given by
                reference only.
            </documentation>
        </annotation>
    </element>
    <element name="relativeToSampleRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSample</appinfo>
            <documentation>
                The sample a diggs:RelativeLocation's position is stated relative to. Use in place
                of diggs:relativeToSamplingFeatureRef where the reference point is a sample rather
                than a sampling feature. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="relativeToSamplingFeatureRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeature</appinfo>
            <documentation>
                The sampling feature a diggs:RelativeLocation's position is stated relative to, for
                example the borehole a depth is measured down. Use in place of
                diggs:relativeToSampleRef where the reference point is a sampling feature rather
                than a sample. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="sourceMeasurementRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractMeasurement</appinfo>
            <documentation>
                A reference to a measurement, a test or a monitoring reading, that provides the
                provenance of a diggs:ProvenancedParameter value. Repeat where a value derives from
                more than one measurement, for example a correlation drawing on several tests. Do
                not mix with diggs:sourceObservationRef or diggs:sourceSamplingFeatureRef on the
                same parameter; use one kind of source. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="sourceObservationRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservation</appinfo>
            <documentation>
                A reference to an observation that provides the provenance of a
                diggs:ProvenancedParameter value. Repeat for several. Do not mix with
                diggs:sourceMeasurementRef or diggs:sourceSamplingFeatureRef on the same parameter.
                Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="sourceSamplingFeatureRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeature</appinfo>
            <documentation>
                A reference to a sampling feature, for example a diggs:Sounding, that provides the
                provenance of a diggs:ProvenancedParameter value. Repeat for several. Do not mix
                with diggs:sourceMeasurementRef or diggs:sourceObservationRef on the same parameter.
                Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="groundModelRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservationSystem</appinfo>
            <documentation>
                A reference to the ground model a design was prepared from: the observation system,
                typically a diggs:GeoUnitSystem, whose observations carry the units and properties
                the design assumed. It is a reference, not a contained object: a ground model is
                already a feature with its own anchoring sampling feature and observation semantics,
                and a copy inside a basis would create a second place for the two to disagree.
                Repeatable, because one scope can have several ground models distinguished by
                geoUnitType as well as by extent, for example a soil model, a rock model and a model
                of parameters assigned per borehole. Models that describe different parts of a
                program belong on separate bases, each with its own scope, chained to a program-wide
                basis through basedOnRef, so that a design citing one basis resolves exactly the
                model that governs it. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="dataValues" substitutionGroup="gml:tupleList" type="gml:CoordinatesType">
        <annotation>
            <documentation>
                A string of data values forming part of a measurement result set.
            </documentation>
        </annotation>
    </element>
    <element name="fileReference" substitutionGroup="gml:fileReference" type="anyURI">
        <annotation>
            <documentation>
                The URL of the location of the file.
            </documentation>
        </annotation>
    </element>
    <element name="fileStructure" substitutionGroup="gml:fileStructure" type="gml:CodeType">
        <annotation>
            <documentation>
                A controlled term describing how the file is structured, for example Record
                Interleaved. No DIGGS-authored dictionary currently exists for this element.
            </documentation>
        </annotation>
    </element>
    <element name="groupGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProjectScopedGroup</appinfo>
            <documentation>
                A reference from a project-scoped group to another project-scoped group it is itself
                a member of: group nesting, stated in the member-cites-group direction. It is named
                for its class, as is every member of this family: the base type of each feature
                class carries a reference named for that class (diggs:samplingFeatureGroupRef,
                diggs:sampleGroupRef, diggs:measurementGroupRef, diggs:observationGroupRef and
                diggs:projectGroupRef), and this one sits on the group base type itself. Its target
                is diggs:AbstractProjectScopedGroup, with no separate head for a group of groups,
                because a group of groups is itself a group. Not diggs:groupRef, a released element
                meaning the reverse, a group pointing down at its member groups, held by
                diggs:GroupGroupType; the two are not interchangeable. Targeting the project-scoped
                head also means a group of this kind never nests inside a deprecated one. Given by
                reference only.
            </documentation>
        </annotation>
    </element>
    <element name="internalIdentifier" type="gml:CodeWithAuthorityType">
        <annotation>
            <documentation>
                The identifier originally created by the authority for this feature, or used as the
                identifier in the authority's internal data management system, commonly a borehole
                number or id, job number or contract number. There is no assumption about the unique
                scope or persistence of this identifier. Where the original or internal identifier
                does not meet the requirements for gml:id, it can be given here so that the
                originating authority can map it back to its internal data management system. The
                codeSpace attribute must identify the authority that uses the value. No
                DIGGS-authored dictionary currently exists for this element.
            </documentation>
        </annotation>
    </element>
    <element name="investigationTarget" type="diggs:InvestigationTargetEnumExtType">
        <annotation>
            <documentation>
                The target of the investigation for this feature: a feature of interest for an
                exploratory investigation, or the type of feature an activity is performed on.
                Values come from the enumerated list, or "Other: xx", where xx is a user-defined
                term whose meaning differs from every listed value (not a synonym of one).
            </documentation>
        </annotation>
    </element>
    <element name="location" substitutionGroup="gml:domainSet" type="diggs:LocationPropertyType">
        <annotation>
            <documentation>
                The location of a feature or object, as a geometry object.
            </documentation>
        </annotation>
    </element>
    <element name="measurementGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractMeasurementGroup</appinfo>
            <documentation>
                A reference from a measurement to a measurement group it is a member of. The member
                cites the group; see diggs:AbstractProjectScopedGroup. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="measurementRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractMeasurement</appinfo>
            <documentation>
                A reference to a measurement feature associated with this feature: any member of the
                diggs:AbstractMeasurement substitution group, such as diggs:Test, diggs:Monitor,
                diggs:MaterialTest, diggs:GeophysicalFieldSurvey or diggs:MeasurementWhileDrilling.
                Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="observationRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservation</appinfo>
            <documentation>
                A reference to an observation whose description informs this one, for example a
                diggs:LithologyObservation that a diggs:StratigraphyObservation or
                diggs:GeoUnitObservation was interpreted from. Records provenance between
                descriptions, as distinct from diggs:sampleRef (what the observation was made on)
                and diggs:measurementRef (which measurements support it). The target is an
                individual observation, not an observation system. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="observationGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservationGroup</appinfo>
            <documentation>
                A reference from an observation system to an observation group it is a member of,
                for example a set of ground models or logs interpreted together. The member cites
                the group; see diggs:AbstractProjectScopedGroup. An observation system and a
                measurement are the two feature classes that produce interpretable results about the
                ground, and both can need grouping because several of them may be meaningful only
                when read together; compare diggs:measurementGroupRef. The name follows the document
                slot (diggs:Diggs/observation) rather than the abstract head
                (diggs:AbstractObservationSystem), and the group head it targets,
                diggs:AbstractObservationGroup, is named to match. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="originalProjectRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Project</appinfo>
            <appinfo>
                <diggs:deprecated since="3.1.0" replacedBy="diggs:projectRef"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use projectRef. A reference to the project that first established this
                feature. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="parameters" substitutionGroup="gml:rangeParameters"
        type="diggs:PropertyInfoPropertyType">
        <annotation>
            <documentation>
                An object that holds the parameters of DIGGS properties.
            </documentation>
        </annotation>
    </element>
    <element name="partOfSpecificationRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
            <documentation>
                A reference from an acceptance criterion to the named specification it elaborates: a
                diggs:PerformanceCriterion or diggs:DesignConformanceCriterion citing the
                diggs:RIColumnSpecification, diggs:RILTPSpecification or diggs:GroutSpecification
                whose requirements it states one of, or a diggs:CompositeAcceptanceCriterion doing
                the same. This is not basedOnRef: a criterion is a component of the specification it
                elaborates, not a more specific version of it, and the per-property
                most-specific-wins resolution of basedOnRef has nothing to inherit between objects
                that share no properties. Composition is not specialization. At most one may be
                given: a criterion belongs to one specification, and where it is also relevant
                elsewhere the consuming object cites both through its own repeatable
                programSpecificationRef. The target is the broad diggs:AbstractProgramSpecification
                head, so a criterion could technically cite another criterion or a composite; that
                is not the intended use, since membership of a criterion in a composite is recorded
                by the composite's own criterionRef. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="programDesignRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramDesign</appinfo>
            <documentation>
                A reference to the program design this feature was realized to satisfy. Distinct
                from programSpecificationRef, which references a constraint the feature must satisfy
                rather than an intent it was built to. A feature declares its own design membership
                this way; a design does not list its members. Repeatable where several designs
                govern different aspects of the same feature concurrently, or where a later design
                governs a repair or re-use; designRole and effectiveFrom on
                diggs:ProgramDesignReferenceType distinguish these. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="observationSystemRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractObservationSystem</appinfo>
            <documentation>
                A reference to an observation system, such as a lithology log, a stratigraphy or a
                geo-unit model. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="programRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgram</appinfo>
            <documentation>
                A reference to a program associated with this feature.
            </documentation>
        </annotation>
    </element>
    <element name="elementClass" type="diggs:ElementClassEnumExtType">
        <annotation>
            <documentation>
                The role a constructed element plays in the works, trial, test, production or
                sacrificial, as distinct from what it is made of or how it is built. It must be
                stated explicitly rather than inferred, because it governs which acceptance criteria
                apply and how a test result may be extrapolated. Values come from the enumerated
                list, or "Other: xx", where xx is a user-defined term whose meaning differs from
                every listed value (not a synonym of one).
            </documentation>
        </annotation>
    </element>
    <element name="programSpecificationRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
            <documentation>
                A reference to a program specification object that this feature must satisfy.
            </documentation>
        </annotation>
    </element>
    <element name="projectGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProjectGroup</appinfo>
            <documentation>
                A reference from a project to a project group it is a member of. The member cites
                the group; see diggs:AbstractProjectScopedGroup. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="projectRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Project</appinfo>
            <documentation>
                A reference to a project that uses the feature within its business activity: the
                associated project for this instance. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="properties" substitutionGroup="gml:valueComponents"
        type="diggs:PropertiesArrayPropertyType">
        <annotation>
            <documentation>
                A sequence of Property objects that hold the measured properties of a test or
                monitoring activity.
            </documentation>
        </annotation>
    </element>
    <element name="remark" type="diggs:RemarkPropertyType">
        <annotation>
            <documentation>
                A comment or remark about the containing object or feature, as a diggs:Remark, which
                can record who made it and when.
            </documentation>
        </annotation>
    </element>
    <element name="results" substitutionGroup="gml:rangeSet" type="diggs:ResultsPropertyType"
        nillable="true">
        <annotation>
            <documentation>
                The result set of a measurement, as a diggs:ResultSet.
            </documentation>
        </annotation>
    </element>
    <element name="sampleGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSampleGroup</appinfo>
            <documentation>
                A reference from a sample to a sample group it is a member of. The member cites the
                group; see diggs:AbstractProjectScopedGroup. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="sampleProducedRef" type="gml:ReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:SampleProduced</appinfo>
            <documentation>
                A link to the gml:id of the SampleProduced object contained in the associated
                sampling activity. That object holds the location and the specific sampling time of
                the associated sample.
            </documentation>
        </annotation>
    </element>
    <element name="sampleRef" type="diggs:FractionalReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Sample</appinfo>
            <appinfo source="urn:x-gml:targetElement">diggs:TrialGroutBatch</appinfo>
            <appinfo source="urn:x-gml:targetElement">diggs:GroutBatch</appinfo>
            <documentation>
                A reference to a sample associated with this feature. The percentage attribute can
                state the proportion the sample contributes. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="samplingActivityRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:SamplingActivity</appinfo>
            <documentation>
                A reference to a sampling activity associated with this feature. Given by reference
                only.
            </documentation>
        </annotation>
    </element>
    <element name="samplingFeatureGroupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeatureGroup</appinfo>
            <documentation>
                A reference from a sampling feature to a sampling feature group it is a member of.
                This is membership, never containment, which is why it is separate from
                diggs:samplingFeatureRef: it means only that the feature is interpreted jointly with
                the other members of the group, is always optional, and places no spatial or
                structural obligation on either end. The member cites the group; see
                diggs:AbstractProjectScopedGroup. A feature may belong to more than one group; for
                example a borehole can be a member of a borehole/CPT pair and of a wider
                investigation-phase group. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <element name="samplingFeatureRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeature</appinfo>
            <documentation>
                A reference to a sampling feature. The meaning depends on the type that declares it.
                Provenance, on observations, measurements, sampling activities, samples and
                construction activities: the sampling feature the data came from, or that the
                activity was performed on. Containment, on the installation types
                (diggs:AbstractLinearInstallationType, diggs:AbstractPlanarInstallationType and
