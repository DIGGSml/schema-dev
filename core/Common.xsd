    <simpleType name="LocationMethodEnumType">
        <restriction base="string">
            <enumeration value="surveyed">
                <annotation>
                    <documentation> Location determined by direct survey measurements using
                        established surveying methods. </documentation>
                </annotation>
            </enumeration>
            <enumeration value="gnss">
                <annotation>
                    <documentation> Location determined using a Global Navigation Satellite System
                        without differential correction.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="gnssDifferential">
                <annotation>
                    <documentation> Location determined using GNSS with differential correction
                        (e.g., DGPS, RTK, PPP) </documentation>
                </annotation>
            </enumeration>
            <enumeration value="digitized">
                <annotation>
                    <documentation> Location determined by digitizing from a map, image, or other
                        spatial representation. </documentation>
                </annotation>
            </enumeration>
            <enumeration value="interpreted">
                <annotation>
                    <documentation> Location inferred or interpreted from descriptive, geological,
                        or contextual information rather than direct measurement. </documentation>
                </annotation>
            </enumeration>
            <enumeration value="estimated">
                <annotation>
                    <documentation> Location approximated based on limited information where the
                        precise position is unknown. </documentation>
                </annotation>
            </enumeration>
            <enumeration value="reported">
                <annotation>
                    <documentation> Location reported by an external source without independent
                        verification. </documentation>
                </annotation>
            </enumeration>
