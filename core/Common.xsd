    <complexType name="ParameterArrayPropertyType">
        <annotation>
            <documentation>Property type for arrays of parameters. Contains one or more Parameter,
                AuthorizedParameter or ProvenancedParameter elements in any order. Used for
                collections of related parameters. Use Parameter where the parameter name is
                uncontrolled free text; use AuthorizedParameter where the name is bound to a
                dictionary definition and the data type of the value is declared; use
                ProvenancedParameter where, additionally, the value's subject and source need
                stating. A single array may mix all three.</documentation>
        </annotation>
        <choice maxOccurs="unbounded" minOccurs="1">
            <element ref="diggs:Parameter"/>
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>
    <complexType name="ParameterPropertyType">
        <annotation>
            <documentation> Property type for containing a single Parameter, AuthorizedParameter or
                ProvenancedParameter object. Use Parameter where the parameter name is uncontrolled
                free text; use AuthorizedParameter where the name is bound to a dictionary
                definition and the data type of the value is declared; use ProvenancedParameter
                where, additionally, the value's subject and source need stating.</documentation>
        </annotation>
        <choice minOccurs="1" maxOccurs="1">
            <element ref="diggs:Parameter"/>
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>
    <complexType name="AuthorizedParameterPropertyType">
        <annotation>
            <documentation>Property type for containing a single AuthorizedParameter or
                ProvenancedParameter object. Unlike diggs:ParameterPropertyType,
                diggs:Parameter - the uncontrolled, free-text-named variant - is not admitted here.

                USE THIS WHEREVER A NAMED ELEMENT IS THE DESIGNATED HOME FOR A QUANTITY DIGGS HAS
                ALREADY DEFINED A DICTIONARY ENTRY FOR - a schema-enforced guarantee that the
                parameterName carries a mandatory codeSpace (gml:CodeWithAuthorityType, inherited
                from diggs:AuthorizedParameterType), the same discipline a closed xsd:enumeration
                would give a fixed vocabulary, applied to an open, dictionary-governed one instead.
                diggs:ParameterPropertyType remains correct for a genuine escape hatch
                (diggs:otherProperty and its siblings across the schema) - a property DIGGS has not
                yet defined, where a data provider may supply their own dictionary reference or none
                at all; DIGGS itself should never be the one routing an already-defined quantity
                through that generic, uncontrolled path. See diggs:RITreatedAreaDesignType/
                methodApplicabilityRatio and diggs:ArchingCoefficientsType/coefficient
                (specialty/RigidInclusions.xsd) for the worked case this type was built to serve.

                diggs:ProvenancedParameter IS admitted alongside diggs:AuthorizedParameter, not
                instead of it: diggs:ProvenancedParameterType extends diggs:AuthorizedParameterType
                by plain extension (core/Common.xsd), so a ProvenancedParameter genuinely IS an
                AuthorizedParameter that additionally states its value's subject and source -
                excluding it here would reject a strictly stronger statement of the exact guarantee
                this type exists to enforce.</documentation>
        </annotation>
        <choice minOccurs="1" maxOccurs="1">
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>
    <complexType name="AuthorizedParameterArrayPropertyType">
        <annotation>
            <documentation>Property type for arrays of AuthorizedParameter/ProvenancedParameter
                objects. The array counterpart of diggs:AuthorizedParameterPropertyType, matching
                diggs:ParameterArrayPropertyType's relationship to diggs:ParameterPropertyType - see
                that type's documentation for the reasoning and diggs:ArchingCoefficientsType/
                coefficient (specialty/RigidInclusions.xsd) for the worked case.</documentation>
        </annotation>
        <choice minOccurs="1" maxOccurs="unbounded">
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>
    <complexType name="PlannedPositionsPropertyType">
        <annotation>
            <documentation>Property type for containing the planned layout of a designed population
                as a grid geometry. Restricted to grid geometries deliberately: a grid declares an
                index space, which is what lets a realized feature identify which planned position
                it fulfils, through diggs:realizesGridIndex. diggs:MultiPoint is excluded for that
                reason - it enumerates positions but declares no index space, so nothing could
                address a single planned position. A scattered or irregular layout is expressed as a
                degenerate one-dimensional diggs:ReferenceableGridByArray.</documentation>
        </annotation>
        <choice>
            <element ref="diggs:RectifiedGrid">
                <annotation>
                    <documentation>A regular lattice defined by an origin and offset vectors. The
                        offset vectors need not be orthogonal, so a triangular or staggered layout
                        is a RectifiedGrid.</documentation>
                </annotation>
            </element>
            <element ref="diggs:ReferenceableGridByArray">
                <annotation>
                    <documentation>An irregular layout, with positions given explicitly against a
                        declared index space.</documentation>
                </annotation>
            </element>
        </choice>
    </complexType>
