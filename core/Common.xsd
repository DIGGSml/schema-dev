    <element name="implementationStatus" type="gml:CodeType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    note="a program design object, to track progress from design through completion"/>
            </appinfo>
            <documentation>DEPRECATED. Use a program design object to track progress from design
                through completion. A text string describing the implementation status of the object
                or the completion status of the activity.</documentation>
        </annotation>
    </element>
    <simpleType name="LimitStateEnumType">
        <restriction base="string">
            <enumeration value="sls">
                <annotation>
                    <documentation>The limit state concerned with normal function, comfort, and appearance
                        under expected service loading - governs, for example, neutralPlaneDepth and
                        maxAxialForceAtNeutralPlane.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="uls">
                <annotation>
                    <documentation>The limit state concerned with safety against collapse or other forms of
                        structural or geotechnical failure under factored loading.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LimitStateEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LimitStateEnumType"/>
    </simpleType>
    <simpleType name="RelationTypeEnumType">
        <restriction base="string">
            <enumeration value="shaft t-z">
                <annotation>
                    <documentation>
                        The shaft load-transfer relation: mobilized shaft shear stress versus
                        relative shaft and soil displacement.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="tip q-z">
                <annotation>
                    <documentation>
                        The tip (base) load-transfer relation: mobilized unit tip resistance versus
                        tip displacement.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="RelationTypeEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:RelationTypeEnumType"/>
    </simpleType>
    <simpleType name="RepresentativeValueEnumType">
        <restriction base="string">
            <enumeration value="characteristic">
                <annotation>
                    <documentation>The unfactored value of an action as specified, before any partial factor is
                        applied (EC7/BS EN 1990).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="design factored">
                <annotation>
                    <documentation>The characteristic value multiplied by its partial safety factor, used
                        directly in an ultimate limit state check.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="quasi permanent">
                <annotation>
                    <documentation>The value of a variable action taken as its long-duration average, used in
                        serviceability and long-term checks (EC7/BS EN 1990).</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="RepresentativeValueEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:RepresentativeValueEnumType"/>
    </simpleType>
    <simpleType name="DirectionEnumType">
        <annotation>
            <documentation>
                The direction in which the stiffness, strength, tension or installed orientation of
                a geosynthetic is stated: machine, cross-machine, normal to the layer, or in the
                plane of the layer. Shared by the design value
                (diggs:DesignGeosyntheticLayerType/direction) and the as-built value
                (diggs:GeosyntheticType/direction), so that the stated orientation of an installed
                layer can be compared with the design value that governs it.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="machine">
                <annotation>
                    <documentation>The direction of manufacture (roll) of the geosynthetic.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="cross machine">
                <annotation>
                    <documentation>The direction perpendicular to the machine direction.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="normal">
                <annotation>
                    <documentation>Perpendicular to the plane of the layer, through its thickness.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="planar">
                <annotation>
                    <documentation>In the plane of the layer, without distinction between the machine and
                        cross-machine directions.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="DirectionEnumExtType">
        <annotation>
            <documentation>
                A direction from diggs:DirectionEnumType, or a value outside the list of the form
                "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:DirectionEnumType"/>
    </simpleType>
    <simpleType name="ActionNatureEnumType">
        <restriction base="string">
            <enumeration value="permanent">
                <annotation>
                    <documentation>An action expected to act throughout a given reference period, whose
                        variation in magnitude is negligible (EC7/BS EN 1990).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="variable">
                <annotation>
                    <documentation>An action whose magnitude varies significantly over the reference period
                        (EC7/BS EN 1990).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="accidental">
                <annotation>
                    <documentation>An action of short duration but significant magnitude, unlikely to occur on
                        a given structure over its design life (EC7/BS EN 1990).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="seismic">
                <annotation>
                    <documentation>An action arising from earthquake ground motion, classified separately from
                        generic accidental actions in EC7/BS EN 1990.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ActionNatureEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ActionNatureEnumType"/>
    </simpleType>
    <simpleType name="ElementClassEnumType">
        <restriction base="string">
            <enumeration value="trial">
                <annotation>
                    <documentation>An element installed before production begins, to prove the installation
                        method or calibrate the design. Normally not part of the permanent works.
                        Constructed independently of any rigid inclusion system by definition -
                        diggs:RIColumnType/samplingFeatureRef is correspondingly irrelevant for a
                        trial element, not merely omitted, since there is no parent system for it to
                        cite.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="test">
                <annotation>
                    <documentation>A production element selected for verification testing. Distinct from a
                        trial element (which precedes and is independent of production) and from a
                        sacrificial element (which is destroyed by the test): a test element is a
                        permanent, in-service element that also happens to be tested, and is
                        expected to remain in service afterward.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="production">
                <annotation>
                    <documentation>An element that carries permanent load and is not tested destructively. The
                        default, unremarkable case - most elements in a rigid inclusion system are
                        production elements.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="sacrificial">
                <annotation>
                    <documentation>An element installed specifically to be tested to failure, and not relied on
                        to carry permanent load either during or after the test.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ElementClassEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ElementClassEnumType"/>
    </simpleType>
    <simpleType name="TensionSourceEnumType">
        <restriction base="string">
            <enumeration value="arching">
                <annotation>
                    <documentation>
                        Tension mobilized in the geosynthetic by the membrane effect between column
                        heads within the load transfer platform.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lateral spreading">
                <annotation>
                    <documentation>
                        Tension mobilized to resist lateral spreading of the treated ground,
                        typically near a slope or free face.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="differential settlement">
                <annotation>
                    <documentation>
                        Tension mobilized by differential settlement across the reinforced zone.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sum">
                <annotation>
                    <documentation>The combined design tension summing the individual load-path components for
                        this layer.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="TensionSourceEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:TensionSourceEnumType"/>
    </simpleType>
    <simpleType name="SeismicSiteClassEnumType">
        <annotation>
            <documentation>
                Seismic site classification (IBC/ASCE 7 Site Class A to F, based on the average
                properties of the upper profile at the site). It states the interpreted
                classification only; the composite shear-wave velocity a determination is based on
                is a separate measurement (diggs:LabVelocityTest, diggs:GeophysicalFieldSurvey). The
                class descriptions are stated from the general definition in the standard, not from
                the table of a specific edition.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="class a">
                <annotation>
                    <documentation>Hard rock with high shear-wave velocity, at the stiff end of the site class
                        range.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="class b">
                <annotation>
                    <documentation>Rock of moderate to high shear-wave velocity, softer than Site Class A.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="class c">
                <annotation>
                    <documentation>Very dense soil or soft rock, typically high blow count or high undrained
                        shear strength.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="class d">
                <annotation>
                    <documentation>Stiff soil, the default classification where site-specific data is
                        insufficient to assign another class.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="class e">
                <annotation>
                    <documentation>Soft clay soil, or any profile with a sufficient thickness of soft clay
                        meeting the standard's plasticity, moisture and strength thresholds.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="class f">
                <annotation>
                    <documentation>Soils requiring a site-specific geotechnical investigation and dynamic site
                        response analysis - liquefaction-vulnerable soils, peats, highly organic
                        clays, very high plasticity clays, or very thick soft-to-medium-stiff clays.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="SeismicSiteClassEnumExtType">
        <annotation>
            <documentation>
                A site class from diggs:SeismicSiteClassEnumType, or a value outside the list of the
                form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:SeismicSiteClassEnumType"/>
    </simpleType>
    <simpleType name="GoverningSpecificationSourceEnumType">
        <restriction base="string">
            <enumeration value="owner or agency provisions">
                <annotation>
                    <documentation>
                        The governing specification is the provisions of the project owner or of a
                        public agency, for example the special provisions of a state transportation
                        agency for rigid inclusions.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="contractor specifications">
                <annotation>
                    <documentation>The governing specification is the contractor's own submitted specification,
                        rather than one issued by the owner or a public agency.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>No formal specification governs the work.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="GoverningSpecificationSourceEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:GoverningSpecificationSourceEnumType"/>
    </simpleType>
    <simpleType name="LoadTransferFormulationEnumType">
        <restriction base="string">
            <enumeration value="frank zhao">
                <annotation>
                    <documentation>
                        The Frank and Zhao (1982) trilinear t-z and q-z formulation: an initial
                        slope, a break, a reduced slope and a plateau at the limiting value. Widely
                        used for bored piles in fine-grained soils.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="linear elastic perfectly plastic">
                <annotation>
                    <documentation>A bilinear load-transfer curve: linear elastic up to the limit value, then
                        perfectly plastic.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="user defined">
                <annotation>
                    <documentation>
                        A load-transfer curve shape stated directly by the discretized curve field,
                        not derived from a named closed-form formulation.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="api">
                <annotation>
                    <documentation>The American Petroleum Institute RP 2A t-z/q-z formulation developed for
                        offshore driven piles.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LoadTransferFormulationEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LoadTransferFormulationEnumType"/>
    </simpleType>
    <simpleType name="PolymerTypeEnumType">
        <restriction base="string">
            <enumeration value="hdpe">
                <annotation>
                    <documentation>High-density polyethylene.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="pet">
                <annotation>
                    <documentation>Polyester (polyethylene terephthalate).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="pp">
                <annotation>
                    <documentation>Polypropylene.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="pva">
                <annotation>
                    <documentation>Polyvinyl alcohol.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="pa">
                <annotation>
                    <documentation>Polyamide (nylon).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="aramid">
                <annotation>
                    <documentation>
                        Aramid (aromatic polyamide) fiber.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="basalt">
                <annotation>
                    <documentation>
                        Basalt fiber.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="PolymerTypeEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:PolymerTypeEnumType"/>
    </simpleType>
</schema>
