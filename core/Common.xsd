<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.0.0">

    <!-- Uncomment to clear validation errors without a master file -->
    <include schemaLocation="../Diggs.xsd"/>

    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>

    <!-- =========================================================================== -->
    <!-- ROOT TYPES                                                               -->
    <!-- =========================================================================== -->

    <element name="Diggs" type="diggs:DiggsType" substitutionGroup="gml:AbstractFeature"
        abstract="false">
        <annotation>
            <documentation>The root element of a DIGGS XML instance document. This element contains
                 all geotechnical, geoenvironmental, geophysical, and construction data for data
                exchange. It serves as the top-level container for projects, sampling features,
                samples, tests, observations, and construction activities. Every valid DIGGS
                document must have exactly one Diggs root element.</documentation>
        </annotation>
    </element>

    <!-- =========================================================================== -->
    <!-- UTILITY TYPES                                                               -->
    <!-- =========================================================================== -->

    <complexType name="ComponentObjectNoDescriptionType" mixed="false">
        <annotation>
            <documentation>Restricted component object type without description or name elements.
                Restricts AbstractComponentObjectType to remove description and name elements,
                retaining only identifier, status, and remark properties. Used for component objects
                where description is managed externally or not needed.</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractComponentObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>Any comment or remark associated with this specific
                                    object.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
                <attribute ref="gml:id" use="optional"/>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="CostType">
        <annotation>
            <documentation>The price of an item, with a currency attribute.</documentation>
        </annotation>
        <simpleContent>
            <extension base="decimal">
                <attribute name="currency" type="diggs:CurrencyEnumType" use="required">
                    <annotation>
                        <documentation>Currency used for this Cost.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="FractionalReferenceType">
        <annotation>
            <documentation>Complex type: FractionalReferenceType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:FeatureReferenceType">
                <attribute name="percentage" type="diggs:Val0-100Type" use="optional">
                    <annotation>
                        <documentation>Percentage value between 0 and 100. Used to express
                            proportions or composition.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="IdentifierReferenceType">
        <annotation>
            <documentation>Holds the value of the gml:identifier for the feature being referenced. This provides an alternaate means of finding the referenced feature should naming conflicts occur with gml:id when accesing date in external files.</documentation>
        </annotation>
        <restriction base="string"> </restriction>
    </simpleType>
    <complexType name="InsituTestProcedureType">
        <annotation>
            <documentation>Concrete type for general in-situ test procedures. Directly extends
                AbstractInsituTestProcedureType without adding additional elements. Used when no
                specialized in-situ test procedure type is needed.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LaboratoryTestProcedureType">
        <annotation>
            <documentation>Concrete type for general laboratory test procedures. Directly extends
                AbstractLaboratoryTestProcedureType without adding additional elements. Used when no
                specialized laboratory test procedure type is needed.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ObjectNoDescriptionType" mixed="false">
        <annotation>
            <documentation>Restricted object type without description or name elements. Restricts
                AbstractObjectType to remove description and name elements, retaining only
                identifier, status, and remark properties. Used for objects where description is
                managed externally or not needed.</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>Any comment or remark associated with this specific
                                    object.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
                <attribute ref="gml:id" use="required"/>
            </restriction>
        </complexContent>
    </complexType>
    <simpleType name="OtherNameType">
        <annotation>
            <documentation>A type used to extend a controlled list, used where none of the
                enumerations are suitable for transfer. An enumeration of the form Other:xx (where
                xx are two or more characters) will be schmema valid but use of the Other" prefix
                can result in interoperability issues. </documentation>
        </annotation>
        <restriction base="string">
            <pattern value="Other: .{2,}"/>
        </restriction>
    </simpleType>
    <complexType name="TimeDomainType">
        <annotation>
            <documentation>Domain type for time-based coverage. Restricts GML DomainSetType to
                contain DIGGS time objects for representing temporal domains in Monitor
                objects.</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:AbstractTimeObject"/>
                    </choice>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <simpleType name="Val0-100Type">
        <annotation>
            <documentation>Double value constrained between 0 and 100 inclusive. Used for
                percentages and other values that must fall within the 0-100 range.</documentation>
        </annotation>
        <restriction base="double">
            <minInclusive value="0"/>
            <maxInclusive value="100"/>
        </restriction>
    </simpleType>

    <!-- =========================================================================== -->
    <!-- COMMON PROPERTIES                                                           -->
    <!-- =========================================================================== -->

    <element name="baseBoundary" type="diggs:BoundaryPropertyType">
        <annotation>
            <documentation>Description of the boundary at the base of the observed zone or interval
                as defined in the observation's location property. In the case of planar or volume representations where the character of the boundary may change along its length or surface, multiple baseBoundary properties are allowed. In the case of a linear sampling feature, multiple baseBoundary properties are not applicable, and any multiples beyond the first in document order should be ignored.</documentation>
        </annotation>
    </element>
    <element name="basedOnRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramModule</appinfo>
            <documentation>A reference to a more general program module that this one specializes.
                Resolution is per property, most specific first: a value stated here is overridden
                by the same property stated on the referring object.
                
                Two constraints on the target cannot be expressed in XSD and are enforced by the
                validation chain instead. First, the target must belong to the SAME
                substitution-group head as the referring object - a design cites a design, a
                specification cites a specification, a basis cites a basis. A design citing a
                specification would silently pull constraint into the intent chain; that
                relationship belongs in programSpecificationRef. Second, chains must be ACYCLIC.
                
                Distinct from basisRef, which cites the evidence a design was prepared from rather
                than a more general object of the same kind.</documentation>
        </annotation>
    </element>
    <element name="basisRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramBasis</appinfo>
            <documentation>A reference to a program basis object - the evidence, ground model,
                requirement set or other input a design was prepared from. Distinct from
                basedOnRef, which cites a more general object of the SAME kind that this one
                specializes, and from programSpecificationRef, which cites a constraint the design
                must satisfy.</documentation>
        </annotation>
    </element>
    <element name="constructionActivityRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractConstructionActivity</appinfo>
            <documentation>A reference to a construction activity</documentation>
        </annotation>
    </element>
    <element name="dataValues" substitutionGroup="gml:tupleList" type="gml:CoordinatesType">
        <annotation>
            <documentation>A property that holds a string of data values as part of a measurement
                result set.</documentation>
        </annotation>
    </element>
    <element name="fileReference" substitutionGroup="gml:fileReference" type="anyURI">
        <annotation>
            <documentation>A URL to the file's location</documentation>
        </annotation>
    </element>
    <element name="fileStructure" substitutionGroup="gml:fileStructure" type="gml:CodeType">
        <annotation>
            <documentation>A controlled term describing how the file is structured (eg. Record
                Interleaved)</documentation>
        </annotation>
    </element>
    <element name="internalIdentifier" type="gml:CodeWithAuthorityType">
        <annotation>
            <documentation>The value of this property is the identifier originally created by the
                authority for this feature, or that is used as the identifier in the authority's
                internal data management system - commonly this might be a borehole number or id,
                job number, or contract number. There is no assumption as to the unique scope or
                persistence of this identifier. In cases where the original or internal identifier
                does not meet the semantic requirements for gml:id, the internal identifier may be
                used in order for the originating authority to "map back" the identifier to an
                internal data management system. The codeSpace attribute must be populated to
                identify the authority that uses the internalIdentifier value.</documentation>
            <documentation>The internal identifier for this feature.</documentation>
        </annotation>
    </element>
    <element name="investigationTarget" type="diggs:InvestigationTargetEnumExtType">
        <annotation>
            <documentation>A description of the target of the investigation for this feature. It can
                include a feature of interest for an exploratory investigation, or the type of
                feature that an activity is performed on. The values derive from a controlled list
                of terms that can be modified by prefacing the term with "Other:".</documentation>
        </annotation>
    </element>
    <element name="location" substitutionGroup="gml:domainSet" type="diggs:LocationPropertyType">
        <annotation>
            <documentation>A property that contains a geometry object defining a location for a
                feature or object.</documentation>
        </annotation>
    </element>
    <element name="measurementRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Measurement</appinfo>
            <documentation>A reference to a Measurement feature that is associated with this
                feature. </documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="originalProjectRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Project</appinfo>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
            <documentation>A reference to the project that first established this feature. This
                property is informative only - the original project reference should be included as
                one of the projectRef properties. </documentation>
        </annotation>
    </element>
    <element name="parameters" substitutionGroup="gml:rangeParameters"
        type="diggs:PropertyInfoPropertyType">
        <annotation>
            <documentation>An object that contains Diggs property parameters.</documentation>
        </annotation>
    </element>
    <element name="programDesignRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramDesign</appinfo>
            <documentation>A reference to a program design object that states the intent (planned
                characteristics, requirements, or target parameters) this feature was realized to
                satisfy. Distinct from programSpecificationRef, which references a constraint the
                feature must satisfy rather than an intent it was built to.</documentation>
        </annotation>
    </element>
    <element name="programRef" type="diggs:FeatureReferenceType">
        <annotation>
            <documentation>A reference to a program that is associated with this feature.
            </documentation>
        </annotation>
    </element>
    <element name="programSpecificationRef" type="diggs:FeatureReferenceType">
        <annotation>
            <documentation>A reference to a specification or design object within the associated
                program feature that is relevant for this activity</documentation>
        </annotation>
    </element>
    <element name="projectRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Project</appinfo>
            <documentation>A reference to a project that uses the feature within its business
                activity. The project referenced here is the associated project for this
                instance.</documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="properties" substitutionGroup="gml:valueComponents"
        type="diggs:PropertiesArrayPropertyYype">
        <annotation>
            <documentation>A property that contains a sequence of Property objects that hold the
                measured properties of a test or monitoring activity.</documentation>
        </annotation>
    </element>
    <element name="remark" type="diggs:RemarkPropertyType">
        <annotation>
            <documentation>The remark property.</documentation>
        </annotation>
    </element>
    <element name="results" substitutionGroup="gml:rangeSet" type="diggs:ResultsPropertyType"
        nillable="true">
        <annotation>
            <documentation>A property that holds a ResultSet object</documentation>
        </annotation>
    </element>
    <element name="sampleProducedRef" type="gml:ReferenceType">
        <annotation>
            <documentation>A link to the gml:id of the SampleProduced object contained within the
                associated SamplingActivity feature that is associated with this feature. The
                associated SampleProduced object has as its properties the location and specific
                sampling time for the associated sample.</documentation>
        </annotation>
    </element>
    <element name="sampleRef" type="diggs:FractionalReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:Sample</appinfo>
            <appinfo>diggs:TrialGroutBatch</appinfo>
            <appinfo>diggs:GroutBatch</appinfo>
            <documentation>A reference to a sample that is associated with this feature. </documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="samplingActivityRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:SamplingActivity</appinfo>
            <documentation>A reference to a sampling activity that is associated with this feature. </documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="samplingFeatureRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeature</appinfo>
            <documentation>A reference to a sampling feature. This element carries two related but
                distinct senses, determined by the type that declares it:
                
                (1) Provenance - "the sampling feature these data came from". This is the sense on
                observations, measurements, sampling activities, samples and construction activities, where the
                referenced feature is the one the activity was performed on or the data were
                obtained from.
                
                (2) Containment - "the sampling feature this installation sits inside". This is the
                sense on the installation types (diggs:AbstractLinearInstallationType,
                diggs:AbstractPlanarInstallationType, diggs:AbstractPointInstallationType), where it
                is mandatory and identifies the host feature the installation was constructed
                within.
                
                Both senses point at an antecedent. Where a specific type needs to narrow the
                permitted target beyond diggs:AbstractSamplingFeature, it does so with a local
                annotation on its own element ref particle rather than by declaring a new reference
                element; see diggs:RigidInclusionType in specialty/RigidInclusions.xsd for an
                example.</documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    
    <element name="specimenRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSpecimen</appinfo>
            <documentation>A reference to a test specimen</documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="status" type="gml:CodeType">
        <annotation>
            <documentation>A text string to provide information about the status of the data
                associated with this object, for example to be used to track QA/QC controls, review
                or release status, etc. The values used are intended to come from a controlled list
                of terms maintained by an authority desingated by this element's codeSpace
                attribute.</documentation>
        </annotation>
    </element>
    <element name="timeDomain" type="diggs:TimeDomainType" substitutionGroup="gml:domainSet">
        <annotation>
            <documentation>A property that holds the time instances for the time domain of a
                monitoring activity.</documentation>
        </annotation>
    </element>

    <!-- =========================================================================== -->
    <!-- PROPERTY TYPES                                                              -->
    <!-- =========================================================================== -->

    <complexType name="AddressPropertyType">
        <annotation>
            <documentation> Property type for ontaining an Address object. </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Address" minOccurs="1" maxOccurs="1">
                <annotation>
                    <documentation>The address object contains properties of a physical
                        address.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="AssociatedFilePropertyType">
        <annotation>
            <documentation> Property type for referencing or containing an AssociatedFile object.
            </documentation>
        </annotation>
        <sequence minOccurs="1">
            <element ref="diggs:AssociatedFile" maxOccurs="1" minOccurs="0"> </element>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="BoundaryPropertyType">
        <annotation>
            <documentation> Property type for containing a Boundary object </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element ref="diggs:Boundary"/>
        </sequence>
    </complexType>
    <complexType name="BusinessAssociatePropertyType">
        <annotation>
            <documentation>Property type for referencing or containing a BusinessAssociate
                feature.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:BusinessAssociate" minOccurs="0" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="CalibrationPropertyType">
        <annotation>
            <documentation> Property type for containing a Calibration feature.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Calibration" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="ConstructionActivityPropertyType">
        <annotation>
            <documentation> Property type for containing any construction activity feature
                (belonging to the AbstractConstructionActivity substitution group). </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractConstructionActivity"/>
        </sequence>
    </complexType>
    <complexType name="ContractPropertyType">
        <annotation>
            <documentation> Property type for containing a Contract feature.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Contract" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="DetectorPropertyType">
        <annotation>
            <documentation>Property type for referencing or containing a Detector
                object.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="0" ref="diggs:Detector"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="EnvironmentPropertyType">
        <annotation>
            <documentation>Property type for referencing or containing an Environment
                object</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Environment" minOccurs="1" maxOccurs="1">
                <annotation>
                    <documentation>A collection of environmental parameters recorded at a specific
                        time instant.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="EquipmentPropertyType">
        <annotation>
            <documentation>Property type for referencing or containing any equipment
                feature</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:AbstractEquipment" maxOccurs="1" minOccurs="0"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="InputParameterPropertyType">
        <annotation>
            <documentation>PropertyType containing and InputParameter element.
</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:InputParameter"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="InSituTestEventPropertyType">
        <annotation>
            <documentation>Property type for referencing or containing an InsituTestEvent
                objectg.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:InSituTestEvent"/>
        </sequence>
    </complexType>
    <complexType name="InstallationEventPropertyType">
        <annotation>
            <documentation>Property type for containing an InstallationEvent object.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:InstallationEvent"/>
        </sequence>
    </complexType>
    <complexType name="LaboratoryTestEventPropertyType">
        <annotation>
            <documentation>Property type for containing a LaboratoryEvent object.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LaboratoryTestEvent"/>
        </sequence>
    </complexType>
    <complexType name="LaboratoryTestProcedurePropertyType">
        <choice>
            <element ref="diggs:AbstractLaboratoryTestProcedure"/>
            <element ref="diggs:AbstractMaterialTestProcedure"/>
        </choice>
    </complexType>
    <complexType name="LimitArrayPropertyType">
        <annotation>
            <documentation>Property type for containing an array of Limit objects</documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:Limit"/>
        </sequence>
    </complexType>
    <complexType name="LinearSpatialReferenceSystemPropertyType">
        <annotation>
            <documentation> Property type for containing the LinearSpatialReferenceSystem object.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LinearSpatialReferenceSystem"/>
        </sequence>
    </complexType>
    <complexType name="LocalCoordinatePropertyType">
        <annotation>
            <documentation> Property type for containing a LocalCoordinate object.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LocalCoordinate"/>
        </sequence>
    </complexType>
    <complexType name="LocalityPropertyType">
        <annotation>
            <documentation> Property type for containing either a Locatlity or PointLocation object.
                PointLocation is specifically used for sample storage locations where coordinates
                are known, othewise use the Locality object (for Projects, Sampling Features, and
                Sample storage non-coordinate locations.</documentation>
        </annotation>
        <choice>
            <element ref="diggs:Locality" minOccurs="1" maxOccurs="1"/>
            <element ref="diggs:PointLocation"/>
        </choice>
    </complexType>
    <complexType name="LocationPropertyType">
        <annotation>
            <documentation> Property type for containing or referencing any DIGGS geometry object to
                define the location of an object.</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:AbstractGeometry"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="LocationUncertaintyPropertyType">
        <annotation>
            <documentation> Property type for containing a LocationUncertainty object.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:LocationUncertainty" minOccurs="1" maxOccurs="1">
                <annotation>
                    <documentation>Contains properties to define the uncertainty of a location
                        value.</documentation>
                </annotation>
            </element>
        </sequence>
    </complexType>
    <complexType name="ParameterArrayPropertyType">
        <annotation>
            <documentation>Property type for arrays of parameters. Contains one or more Parameter,
                AuthorizedParameter or ProvenancedParameter elements in any order. Used for
                collections of related parameters. Use Parameter where the parameter name is
                uncontrolled free text; use AuthorizedParameter where the name is bound to a
                dictionary definition and the data type of the value is declared; use
                ProvenancedParameter where, additionally, the value's subject and source need
                stating. A single array may mix all three.</documentation>
        </annotation>
        <choice maxOccurs="unbounded" minOccurs="1">
            <element ref="diggs:Parameter"/>
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>
    <complexType name="ParameterPropertyType">
        <annotation>
            <documentation> Property type for containing a single Parameter, AuthorizedParameter or
                ProvenancedParameter object. Use Parameter where the parameter name is uncontrolled
                free text; use AuthorizedParameter where the name is bound to a dictionary
                definition and the data type of the value is declared; use ProvenancedParameter
                where, additionally, the value's subject and source need stating.</documentation>
        </annotation>
        <choice minOccurs="1" maxOccurs="1">
            <element ref="diggs:Parameter"/>
            <element ref="diggs:AuthorizedParameter"/>
            <element ref="diggs:ProvenancedParameter"/>
        </choice>
    </complexType>    <complexType name="PlannedPositionsPropertyType">
        <annotation>
            <documentation>Property type for containing the planned layout of a designed population
                as a grid geometry. Restricted to grid geometries deliberately: a grid declares an
                index space, which is what lets a realized feature identify which planned position
                it fulfils, through diggs:realizesGridIndex. diggs:MultiPoint is excluded for that
                reason - it enumerates positions but declares no index space, so nothing could
                address a single planned position. A scattered or irregular layout is expressed as a
                degenerate one-dimensional diggs:ReferenceableGridByArray.</documentation>
        </annotation>
        <choice>
            <element ref="diggs:RectifiedGrid">
                <annotation>
                    <documentation>A regular lattice defined by an origin and offset vectors. The
                        offset vectors need not be orthogonal, so a triangular or staggered layout
                        is a RectifiedGrid.</documentation>
                </annotation>
            </element>
            <element ref="diggs:ReferenceableGridByArray">
                <annotation>
                    <documentation>An irregular layout, with positions given explicitly against a
                        declared index space.</documentation>
                </annotation>
            </element>
        </choice>
    </complexType>
    <complexType name="PlssPropertyType">
        <annotation>
            <documentation> Property type for containing a PLSS object.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:PLSS" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="ProcedurePropertyType">
