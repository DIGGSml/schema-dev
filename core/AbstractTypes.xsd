<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <!-- Uncomment to clear validation errors without a master file -->
    <include schemaLocation="../Diggs.xsd"/>

    <!-- Imports -->
    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>

    <!-- HIERARCHY LEVEL 1: Root Base Type (Foundation of DIGGS Schema)    -->
    <!--=============================================================================-->

    <element abstract="true" name="AbstractAcceptanceCriterion"
        type="diggs:AbstractAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                Abstract head of the substitution group for acceptance criteria. A criterion states
                one testable requirement: what is measured, how the measurements are reduced to one
                value, the comparison applied and the limit compared against. As a program
                specification it also carries the scope of the features it governs and may
                specialize a more general criterion through basedOnRef. Its members differ in what
                is measured: diggs:PerformanceCriterion measures a physical property of the
                completed work, and diggs:DesignConformanceCriterion measures a geometric or
                constructional property against its design intent. Each names its subject through
                the parameterName of limit; use the DIGGS dictionary properties.xml for a
                performance criterion and designProperty.xml for a design conformance criterion. A
                specification that imposes several requirements on one property, such as a mean and
                a minimum, is stated as several criteria that share a scope.
                diggs:CompositeAcceptanceCriterion states the requirement that a logical combination
                of other criteria holds; it is a program specification but does not substitute this
                head, because it has no operator or limit of its own.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractAcceptanceCriterionType">
        <annotation>
            <documentation>
                Abstract base type for acceptance criteria: which evidence counts, how it is reduced
                to one value (statistic over statisticScope), the comparison (operator) and the
                limit. The subject is named by the parameterName of limit. The criterion names no
                evidence of its own; the evidence it is evaluated against is cited by the
                diggs:AcceptanceCheck that applies it.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" name="statistic" type="diggs:StatisticEnumExtType">
                        <annotation>
                            <documentation>
                                How several values are reduced to the single value compared against
                                the limit. statisticScope states what the values are gathered over.
                                Omit where the criterion applies to each value individually. Values
                                come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentileValue" type="double">
                        <annotation>
                            <documentation>
                                The percentile intended where statistic is "percentile", for example
                                90 for a 90th-percentile criterion. Give it only with that
                                statistic.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="statisticScope" type="diggs:StatisticScopeEnumType">
                        <annotation>
                            <documentation>
                                What the statistic is gathered over: the values within one record
                                (series), the evidence for one subject (evidence), or all subjects
                                the criterion governs (population). Required whenever statistic is
                                given. Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="operator"
                        type="diggs:CriterionOperatorEnumType">
                        <annotation>
                            <documentation>
                                The comparison applied between the evaluated value and the limit.
                                Required: a limit without a comparison states no requirement. Values
                                come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="limit"
                        type="diggs:AuthorizedParameterPropertyType">
                        <annotation>
                            <documentation>
                                The subject this criterion governs, and the value or range the
                                evaluated value is compared against. The subject is the
                                dictionary-bound parameterName of a diggs:AuthorizedParameter or
                                diggs:ProvenancedParameter; a free-text diggs:Parameter is not
                                allowed. The value may be a single value (parameterValue) or a band
                                (parameterMinValue and parameterMaxValue, with operator "within").
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="basis" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The unit of work the criterion is assessed over, for example per
                                element, per unit cell, per 100 ft, or as a multiple of diameter.
                                Distinct from the scope of the specification, which says which
                                features are governed. Use the DIGGS dictionary basis.xml for the
                                list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baseLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The reference length over which a gradient or rate-of-change
                                criterion is assessed, where basis expresses a quantity per unit
                                length. With limit it lets a criterion state a gradient such as 0.5
                                in per 100 ft.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="evidenceCondition"
                        type="diggs:AuthorizedParameterPropertyType">
                        <annotation>
                            <documentation>
                                A condition evidence must meet to count toward this criterion: a
                                coded parameter and its value or range, for example specimen age 28
                                d, elapsed time 1 to 10 min, or depth below the platform. Evidence
                                counts only if it meets every condition given. Omit where all
                                evidence of the criterion's subject counts.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="1" name="sourceSpecRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Specification</appinfo>
                            <documentation>
                                A reference to the published standard or project clause this
                                criterion was taken from. The target is a diggs:Specification, the
                                component object that cites a standard, not a program specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:partOfSpecificationRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType abstract="true" name="AbstractDiggsType">
        <annotation>
            <documentation>
                Abstract root type of all DIGGS objects. Extends gml:AbstractGMLType and requires a
                gml:id attribute, which identifies the object within the DIGGS document and allows
                it to be referenced with xlink. All DIGGS types that can be referenced derive from
                it.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractGMLType">
                <attribute ref="gml:id" use="required">
                    <annotation>
                        <documentation>
                            The identifier of the object (gml:id). Required: it identifies the
                            object within the DIGGS document, where it must be unique, and lets
                            other objects refer to it.
                        </documentation>
                    </annotation>
                </attribute>
            </restriction>
        </complexContent>
    </complexType>
    <!--=============================================================================-->
    <!-- HIERARCHY LEVEL 2: Major Category Base Types                       -->
    <!--=============================================================================-->
    <complexType name="AbstractObjectBaseType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for DIGGS objects that are not features: supporting information
                such as methods, structures and metadata. Requires gml:id and carries an optional
                description and identifier.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractDiggsType">
                <sequence>
                    <element ref="gml:description" minOccurs="0"/>
                    <element minOccurs="0" ref="gml:identifier"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractObjectNoDescriptionType" mixed="false" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for objects that carry no description. Provides identifier,
                status and remark, for specialized objects whose description is not required or is
                given in another way.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractDiggsType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" ref="diggs:remark"/>
                    </sequence>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <!--=============================================================================-->
    <!-- HIERARCHY LEVEL 3+: Specialized Derived Types                      -->
    <!--=============================================================================-->
    <complexType name="AbstractComponentObjectBaseType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for component objects. Restricts gml:AbstractGMLType to an
                optional gml:id and carries an optional description and identifier.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractGMLType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractComponentObjectType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for component objects with the full set of metadata: description,
                identifier and name, plus status and remark.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark, which can
                                record who made it and when. Repeat for each remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractConstructionActivity" type="diggs:AbstractConstructionActivityType"
        abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for construction activities: activities that
                improve or alter ground conditions.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractConstructionActivityType" abstract="false">
        <annotation>
            <documentation>
                Abstract base type for construction activities, which carry out work that improves
                or alters ground conditions.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="1" ref="diggs:samplingFeatureRef" maxOccurs="1"/>
                    <element minOccurs="0" ref="diggs:programRef" maxOccurs="1"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>
                                The program design objects this activity was carried out to realize,
                                for example the diggs:DesignConstructionActivity that planned it.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this activity must satisfy. More
                                than one may apply, for example a method specification together with
                                a site-level performance specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod"
                        type="diggs:ConstructionActivityMethodPropertyType" maxOccurs="unbounded"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The method followed in carrying out this construction activity, as a
                                diggs:ConstructionActivityMethod. A method may be tied to the part
                                of the feature it applies to, for example one method for the base of
                                a surface crust and another below it; with no location it applies to
                                the whole feature. Repeat for each method used. A reference
                                (xlink:href) to a method held elsewhere may be given in place of the
                                object. Giving a diggs:Specification directly in this property is
                                deprecated.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionEvent"
                        type="diggs:InstallationEventPropertyType">
                        <annotation>
                            <documentation>
                                An event recorded while this construction activity was carried out,
                                such as an obstruction met, a loss of material, a stoppage or a
                                refusal. Each is a diggs:InstallationEvent, which can state the
                                depth interval and time it occurred over and any associated
                                readings. Repeat for each event. Events describe what happened
                                during the activity; the method followed is stated by
                                constructionMethod.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionEnvironment" type="diggs:EnvironmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                An environment object holding environmental properties that are
                                relevant to the construction activity but external to it.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="equipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>
                                The equipment used in the construction activity, cited by reference
                                (xlink:href) to an equipment object.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherConstructionActivityProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter recording a property of the construction activity that
                                is not otherwise provided for. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="activityDateTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The date and time interval over which the entire construction
                                activity was conducted, delays included.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="delay" type="diggs:DelayEventPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A non-productive interval that occurred during this construction
                                activity, such as an equipment breakdown, a standby period or a rig
                                move. Repeat for each delay. The delayType of each diggs:DelayEvent
                                gives the cause, from a controlled list. This is the structured
                                counterpart of a narrative remark and supports production analysis
                                such as utilization and non-productive time. Recording a delay here
                                does not replace activityDateTime, which covers the whole activity,
                                delays included. This is an activity-level delay, distinct from the
                                delay property of diggs:DriveSetType (the delay before one drive
                                increment started) and of diggs:VaneTestMeasurementDataType (a
                                procedurally required waiting period).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractEquipment" abstract="true" type="diggs:AbstractEquipmentType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for equipment objects. Derived objects hold
                properties of equipment used to construct, test or monitor objects in the
                geotechnical and geoenvironmental domains.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractEquipmentType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for equipment objects, with manufacturer, model, serial number
                and calibration information.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element name="class" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The class of equipment, for example drill rig or CPT rig. Use the
                                DIGGS dictionary equipmentClass.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="make" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The manufacturer or brand of the equipment.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="modelNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The model name or number of the equipment.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="serialNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The serial number that identifies the individual equipment item.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="calibrationAuditTrail" type="diggs:CalibrationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A calibration record for the equipment, as a diggs:Calibration
                                object. Give one per calibration occasion; a calibration recorded
                                elsewhere is cited by xlink:href.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherEquipmentProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter recording a property of the equipment that is not
                                otherwise provided for, with its name, value or range of values and
                                unit of measure. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractEventType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for events that record time-based or location-based occurrences
                during an investigation.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The measured depth interval over which the event takes place,
                                recorded in the linear referencing system of the sampling feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="time" type="diggs:TimeIntervalPropertyType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The date and time at which this event information was recorded.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="infoRecorded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                Other data measured or observed at the time of the event, as
                                parameters. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractFeatureBaseType" abstract="true">
        <annotation>
            <documentation>
                Abstract minimal base type for DIGGS features: a required gml:id with an optional
                description and identifier.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractFeatureType">
                <sequence>
                    <element ref="gml:description" minOccurs="0"/>
                    <element minOccurs="0" ref="gml:identifier"/>
                </sequence>
                <attribute ref="gml:id" use="required">
                    <annotation>
                        <documentation>
                            The identifier of this feature (gml:id). Required, and unique within the
                            DIGGS instance.
                        </documentation>
                    </annotation>
                </attribute>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractFeatureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for DIGGS features: identifiable real-world entities such as
                projects, sampling features, samples and tests.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" maxOccurs="1" ref="diggs:internalIdentifier"/>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element minOccurs="0" ref="diggs:implementationStatus"/>
                    <element name="associatedFile" type="diggs:AssociatedFilePropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AssociatedFile</appinfo>
                            <documentation>
                                An external file or document associated with this feature, as a
                                diggs:AssociatedFile object, cited by reference.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="role" type="diggs:RolePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A role or task performed in connection with this feature, as a
                                diggs:Role object that identifies the person or organization that
                                performed it and the time frame, if applicable. Repeat for each
                                role.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this feature, as a diggs:Remark. Repeat
                                for each remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractGroup" type="diggs:AbstractGroupType" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for DIGGS groups: logical associations of
                projects, sampling features, samples or other features.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractGroupType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for groups of DIGGS features associated for organizational or
                analytical purposes, such as by geographic area, time period, purpose or contractor.
                A group can contain mixed feature types, and a feature can belong to more than one
                group.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractProjectScopedGroup" type="diggs:AbstractProjectScopedGroupType"
        substitutionGroup="diggs:AbstractGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for project-scoped groups: groups whose
                members cite the group, rather than the group listing its members. A member carries
                a reference to its group (diggs:samplingFeatureGroupRef, diggs:sampleGroupRef,
                diggs:measurementGroupRef, diggs:observationGroupRef or diggs:projectGroupRef, each
                declared on the corresponding family base type) and diggs:groupGroupRef for a nested
                group. This differs from the groups that substitute diggs:AbstractGroup directly
                (diggs:SamplingFeatureGroup, diggs:GroupGroup, diggs:ProjectGroup,
                diggs:MeasurementGroup and diggs:SampleGroup, all deprecated), which hold arrays of
                references to their members. A group is a collection of related features whose
                information can be evaluated and compared together as part of one analysis: it
                carries the assumption that justifies interpreting its members jointly. A borehole
                and a CPT sounding treated as one dataset under a proximity assumption form a group;
                two boreholes that merely lie on the same site do not. The schema cannot constrain
                which feature types a group admits or how many; that is a context-validation concern
                driven from a dictionary.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectScopedGroupType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for project-scoped groups. Adds the project the group belongs to,
                optional program-module references and a reference for group nesting.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <sequence>
                    <element ref="diggs:projectRef" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The project or projects this group belongs to. At least one is
                                required.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>
                                The program design objects this group was realized to satisfy, for
                                example the system design that planned the treated area a group of
                                columns occupies.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this group must satisfy.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:groupGroupRef">
                        <annotation>
                            <documentation>
                                The project-scoped groups this group is itself a member of (group
                                nesting); the reference points from the member to the group. Not
                                diggs:groupRef, which points the other way, from a group down to its
                                member groups.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSamplingFeatureGroup" type="diggs:AbstractSamplingFeatureGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for groups whose members are sampling
                features. A member joins by carrying diggs:samplingFeatureGroupRef, declared on
                diggs:AbstractSamplingFeatureType.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingFeatureGroupType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for groups of sampling features. Adds the spatial extent of the
                group.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType">
                <sequence>
                    <element minOccurs="0" name="extent" type="diggs:SurfacePropertyType">
                        <annotation>
                            <documentation>
                                The area over which this group acts, or within which its members
                                lie. An extent, not a reference point: a treated area, a monitoring
                                network or a paired investigation has no single meaningful position.
                                Optional, because a group need not be spatially delimited; a
                                borehole/CPT pair, for example, is defined by the proximity of its
                                two members. Two-dimensional; elevation is not meaningful for a
                                group extent. Where a concrete group also carries a scalar area, the
                                geometry prevails. May be given inline or by reference (xlink:href).
                                A group extent and a member's featureExtent are not the same thing
                                by default: a group's members often lie outside the area the group
                                is about, for example exploratory boreholes drilled beyond a treated
                                footprint. Where the two genuinely coincide, give the polygon once
                                and reference it from the other rather than writing the same
                                coordinates twice. See diggs:featureExtent.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSampleGroup" type="diggs:AbstractSampleGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for groups whose members are samples. A
                member joins by carrying diggs:sampleGroupRef, declared on diggs:AbstractSampleType.
                No concrete type substitutes this head yet.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSampleGroupType" abstract="true">
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractMeasurementGroup" type="diggs:AbstractMeasurementGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for groups whose members are measurements:
                tests, material tests and monitors. A member joins by carrying
                diggs:measurementGroupRef, declared on diggs:AbstractMeasurementType. No concrete
                type substitutes this head yet.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractMeasurementGroupType" abstract="true">
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractObservationGroup" type="diggs:AbstractObservationGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for groups whose members are observation
                systems: ground models, logs and other interpreted characterizations. A member joins
                by carrying diggs:observationGroupRef, declared on
                diggs:AbstractObservationSystemType. No concrete type substitutes this head yet.
                Several observation systems may be meaningful only when read together, for example
                two ground models of the same site built on different assumptions, or logs that form
                one cross-section.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractObservationGroupType" abstract="true">
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractProjectGroup" type="diggs:AbstractProjectGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for groups whose members are projects. A
                member joins by carrying diggs:projectGroupRef, declared on
                diggs:AbstractProjectType. No concrete type substitutes this head yet. This is a
                group of projects, not a group belonging to a project: it still carries the
                mandatory projectRef it inherits, naming the project under which the grouping is
                made.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectGroupType" abstract="true">
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractInsituTestProcedure" type="diggs:AbstractInsituTestProcedureType"
        substitutionGroup="diggs:AbstractTestProcedure" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for in-situ test procedures.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractInsituTestProcedureType">
        <annotation>
            <documentation>
                Abstract base type for in-situ test procedures performed at sampling features
                without removing specimens.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent" type="diggs:InSituTestEventPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A time-based or location-based record of instantaneous conditions or
                                parameters associated with the in-situ test, such as casing depth,
                                water level or custom parameters. Holds one or more event objects,
                                of the kind associated with the type of sampling feature the test is
                                performed in: for a standard penetration test in a borehole, a
                                diggs:BoreholeEvent recording the depth to water at various times
                                during the test.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLoadTestProcedure" type="diggs:AbstractLoadTestProcedureType"
        substitutionGroup="diggs:AbstractInsituTestProcedure" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for load tests applied directly to a deep
                foundation element or foundation system: static, rapid or dynamic. Its members are
                diggs:StaticLoadTest, diggs:RapidLoadTest and diggs:DynamicLoadTest. It is not
                specific to a sampling feature: a static load test on a driven pile, a drilled shaft
                or a rigid inclusion is the same procedure. It is neutral between standards; cite
                the standard or standards governing an instance, more than one if needed, in the
                inherited testProcedureMethod, for example a rigid-inclusion test governed by ASIRI
                and executed to EN ISO 22477-1. Shared by every load test: the reference system for
                displacement (referenceSystem), the peak load (maxTestLoad), the peak stress
                (maxTestStress), the weight of the loading assembly (deadLoad) and the load
                increments applied (increment). Hold criteria differ between static, rapid and
                dynamic tests, so increment is expected to be little used on the last two; see
                diggs:RapidLoadTestType/pulseDuration and diggs:DynamicLoadTestType/hammerEnergy for
                their single-event characterization. The reaction system has no field here: record
                the reaction frame and jacks as equipment through the inherited
                testProcedureEquipment (equipmentClass.xml includes load_test_reaction_frame and
                hydraulic_jack). Readings taken during each increment are carried on the increment
                (diggs:LoadTestIncrementType/incrementTimeSeries). Derived values such as the
                load-settlement curve and the capacity belong on the results of the measurement that
                cites the procedure.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractLoadTestProcedureType">
        <annotation>
            <documentation>
                Abstract base type for load test procedures. Carries the reference system, peak load
                and stress, dead load and load increments shared by static, rapid and dynamic load
                tests.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="referenceSystem"
                        type="diggs:LoadTestReferenceSystemEnumExtType">
                        <annotation>
                            <documentation>
                                How the movement measured during the test was referenced, for
                                example by an independent reference beam, optical survey or
                                satellite positioning. ASTM D1143 and EN ISO 22477-1 require the
                                reference to be independent of the reaction system and unaffected by
                                ground movement caused by the test; this element records the
                                arrangement used and does not assert that it met that requirement.
                                Values come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxTestLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The maximum load reached during the test. A summary value,
                                independent of the increments: a test recorded without a full
                                increment schedule can still state its peak load.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="increment"
                        type="diggs:LoadTestIncrementPropertyType">
                        <annotation>
                            <documentation>
                                A load increment applied during the test; repeat in sequence. A
                                static test recorded with a full loading schedule has several; a
                                rapid or dynamic test, a single pulse or blow, typically has none.
                                See diggs:LoadTestIncrementType for what each increment carries,
                                including the two alternative hold criteria: a fixed-duration hold
                                (as in the ASTM quick test) or a hold until the movement rate
                                stabilizes (as in the EN ISO 22477-1 maintained-load method).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxTestStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The maximum stress reached during the test, for tests loaded and
                                reported as a stress on a bearing area rather than as a force. May
                                be given alongside maxTestLoad; either or both may be present.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deadLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The total weight of the loading assembly resting on the element
                                before the first increment is applied: bearing plates, jack,
                                reaction beams and platform. The weights of the individual items
                                belong on the equipment records cited through
                                testProcedureEquipment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLaboratoryTestProcedure" type="diggs:AbstractLaboratoryTestProcedureType"
        substitutionGroup="diggs:AbstractTestProcedure" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for laboratory test procedures, each
                performed on a specimen. Within a diggs:Test the specimen derives from a sample
                collected from a sampling feature, so its source location is known; within a
                diggs:MaterialTest it is made from a manufactured material and has no location
                relevance. Using a laboratory test procedure in a Test does not require the specific
                sample or specimen to be described, only that the source location of the sample is
                known or recorded, so test results can be transferred without sample or specimen
                information.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractLaboratoryTestProcedureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for laboratory test procedures performed on specimens, whether
                prepared from samples removed from sampling features or made from manufactured
                materials.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent"
                        type="diggs:LaboratoryTestEventPropertyType">
                        <annotation>
                            <documentation>
                                An event observed during a laboratory test: a
                                diggs:LaboratoryTestEvent, which is a concrete extension of
                                diggs:AbstractEventType with no additional properties.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="specimen" type="diggs:SpecimenPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A specimen used in the test procedure, described by a specialization
                                of diggs:AbstractSpecimen. Repeat for each specimen.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLinearSamplingFeature" type="diggs:AbstractLinearSamplingFeatureType"
        substitutionGroup="diggs:AbstractSamplingFeature" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sampling features with a linear
                geometry, such as a sounding or borehole.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractLinearSamplingFeatureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for sampling features with a linear (1D) geometry, including
                boreholes and trenches.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureType">
                <sequence>
                    <element name="centerLine" type="diggs:LinearExtentPropertyType"
                        maxOccurs="unbounded" minOccurs="1">
                        <annotation>
                            <documentation>
                                The linear geometry of the feature, as a diggs:LinearExtent,
                                defining its shape and location. For a borehole the line is the
                                trajectory of the borehole in 3D space. Several center lines, all
                                associated with the same reference point, may define complex objects
                                such as a wellbore with sidetracks, or different reference datums
                                for one borehole.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="linearReferencing"
                        type="diggs:LinearSpatialReferenceSystemPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The linear spatial reference system of this sampling feature
                                (diggs:LinearSpatialReferenceSystem). It lets other objects state
                                their position as a 1D distance along the feature, typically from
                                the center line origin. For a borehole the coordinates are measured
                                depths down the center line.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plunge" type="diggs:PlungeMeasureType">
                        <annotation>
                            <documentation>
                                For an inclined feature, the plunge angle measured from the
                                horizontal, positive up.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearing" type="diggs:BearingMeasureType">
                        <annotation>
                            <documentation>
                                For an inclined feature, the direction of plunge, positive clockwise
                                from the reference azimuth given in the refAzimuth attribute.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="alignmentDeviation"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                How far the constructed feature departed from its intended
                                alignment, as a dimensionless ratio: the horizontal offset
                                accumulated over the length travelled. Use uom="Euc" for a ratio
                                (0.02) or uom="%" for a percentage (2); a 1:50 tolerance is 0.02 Euc
                                or 2 %. It measures deviation from the intended alignment, not from
                                vertical. Where no intended plunge is stated anywhere, vertical is
                                the intent, as it is for rigid inclusion columns. For a feature
                                intended to be raked, such as a grout hole or a battered pile, it
                                carries only the construction error and not the design rake: a pile
                                intended at 1:4 and built almost perfectly reports a small
                                deviation, not 25 %. The datum is intendedPlunge where given,
                                otherwise the plunge stated by the design or target object for this
                                feature, otherwise vertical. Which source governs: where the center
                                line is genuinely inclined it is a survey and governs, and this
                                property is a derived convenience that should agree with it. Where
                                the center line is vertical it is almost certainly nominal rather
                                than measured, and this property carries the measurement; many
                                construction techniques yield only an inclination (for example of
                                the rig mast) with no azimuth, so no center line can be surveyed.
                                Read alignmentDeterminationMethod rather than inferring from the
                                geometry, since coordinate rounding can make a nominal center line
                                slightly non-vertical.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="intendedPlunge" type="diggs:PlungeMeasureType">
                        <annotation>
                            <documentation>
                                The plunge the feature was intended to be constructed at, against
                                which alignmentDeviation is measured, in the same angular convention
                                as plunge. Populate it only where the intent is not otherwise
                                recoverable, that is, where the design or target object carrying the
                                planned rake is not transferred with the file; where it is, that
                                object is the authority and this element should be omitted. Omit it
                                for a feature intended to be vertical, such as a rigid inclusion
                                column.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="alignmentDeterminationMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the alignment was established: a downhole inclinometer or
                                pendulum in the open hole, an ultrasonic caliper, the inclination of
                                the rig mast, or not determined. This is the provenance of the
                                trajectory and the only place it can be stated: a center line is
                                mandatory, so a feature whose trajectory was never surveyed must
                                still assert one, and a nominal vertical line is otherwise
                                indistinguishable from a surveyed one. A mast-derived value
                                describes the rig, not the finished element, which is a weaker claim
                                than a downhole survey. Absent, together with an exactly vertical
                                center line and no alignmentDeviation, the alignment was not
                                determined; read this as an absence of information, not a claim of
                                verticality. Use the DIGGS dictionary
                                alignmentDeterminationMethod.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractLinearInstallation"
        substitutionGroup="diggs:AbstractSamplingFeature"
        type="diggs:AbstractLinearInstallationType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for linear installations within sampling
                features.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractLinearInstallationType">
        <annotation>
            <documentation>
                Abstract base type for linear installations within sampling features, such as
                instrumentation strings or casing.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element ref="diggs:samplingFeatureRef"/>
                    <element minOccurs="0" name="installationConstructionEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An event or activity during construction of the installation within
                                the sampling feature, as a diggs:InstallationEvent. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="installationEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment used to install the installation: the machinery, tools or
                                devices employed to install the monitoring point or instrumentation.
                                Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractMaterialTestProcedure"
        substitutionGroup="diggs:AbstractTestProcedure"
        type="diggs:AbstractMaterialTestProcedureType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for material test procedures: procedures
                performed only on manufactured samples, for example those created by aggregating
                other samples or materials, where the sample has no location relevance. A material
                test procedure must reference or describe the samples or specimens on which the test
                is performed. Used for characterizing grout samples, and for other samples where the
                results relate to the sample only and not to a geographic feature of interest.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractMaterialTestProcedureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for laboratory test procedures performed on manufactured material
                samples, as opposed to field-collected samples: grout, concrete, slurry and other
                engineered materials. They are performed on specially prepared specimens rather than
                on samples extracted from a sampling feature.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent"
                        type="diggs:LaboratoryTestEventPropertyType">
                        <annotation>
                            <documentation>
                                An event observed during the material test: a
                                diggs:LaboratoryTestEvent, which is a concrete extension of
                                diggs:AbstractEventType with no additional properties.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <annotation>
                            <documentation>Event that occurred during the laboratory material test. Records time-based observations, environmental conditions, or procedural notes made during test execution on manufactured material specimens.</documentation>
                        </annotation>
                        <element maxOccurs="unbounded" minOccurs="1" ref="diggs:sampleRef">
                            <annotation>
                                <documentation>
                                    The manufactured sample or samples the material test is
                                    performed on. At least one is required. The percentage attribute
                                    can state the proportion each sample contributes.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="1" name="specimen"
                            type="diggs:SpecimenPropertyType">
                            <annotation>
                                <documentation>
                                    A specimen used in the material test, described by a
                                    specialization of diggs:AbstractSpecimen. At least one is
                                    required.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractMeasurement" type="diggs:AbstractMeasurementType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for measurement features: tests or
                monitoring activities that record quantitative information in the context of a
                sampling feature or sample.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractMeasurementType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for measurements and quantitative testing procedures: in-situ
                tests, laboratory tests and monitoring activities that produce quantitative data.
                Concrete extensions include diggs:Test, diggs:MaterialTest and diggs:Monitor.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef" maxOccurs="1"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>
                                The program design objects this measurement was realized to satisfy,
                                for example a diggs:DesignMeasurement. More than one may apply where
                                several planning strands govern different aspects of the
                                measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="realizesGridIndex" type="diggs:GridIndexType">
                        <annotation>
                            <documentation>
                                Declares which planned position this measurement realizes, as the
                                index of the planned node within the grid geometry in the
                                measurementLocation of the design cited by programDesignRef. The
                                same form as on a sampling feature; see diggs:GridIndexType. It
                                serves a planned set of tests stated as a
                                diggs:ReferenceableGridByArray, using a one-dimensional grid
                                (dimension="1" on the index) for scattered planned positions: a grid
                                node is not an object and has no gml:id to point at, so the realized
                                measurement carries its index. Omit it for a measurement that was
                                not planned or whose design states no grid. A measurement made at a
                                position other than the planned one states the index of the planned
                                position it stands in for. Do not match a realized measurement to
                                its planned position by proximity: a test made away from its planned
                                position is what a conformance check exists to catch, and it may lie
                                nearer another node.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this measurement must satisfy, for
                                example the acceptance criterion it is evidence for.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:samplingFeatureRef" maxOccurs="unbounded"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:sampleRef"/>
                    <element minOccurs="0" ref="diggs:constructionActivityRef"/>
                    <element minOccurs="0" name="otherMeasurementProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter, typically recording environmental or event-specific
                                conditions that are not tightly bound to either the earth materials
                                whose properties are estimated or the procedure. Parameters tightly
                                bound to the procedure belong in the procedure object. Repeat for
                                each parameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:measurementGroupRef"/>
                    <element minOccurs="0" name="measurementSummary" type="string">
                        <annotation>
                            <documentation>
                                The conclusion the person or organization reporting the measurement
                                drew from it as a whole, in their own words, for example the
                                integrity comment of a pile integrity test or the interpretation
                                stated for a load test. It states what the reporter concluded; it is
                                not an acceptance outcome, which an acceptance evaluation states
                                against a criterion.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedFeatureType" abstract="true">
        <annotation>
            <documentation>
                Abstract feature base type in which at least one gml:name is required and several
                may be given.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element minOccurs="0" ref="diggs:internalIdentifier"/>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element minOccurs="0" ref="diggs:implementationStatus"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="associatedFile"
                            type="diggs:AssociatedFilePropertyType">
                            <annotation>
                                <documentation>
                                    External files associated with this feature, such as a
                                    photograph or other media, binary data or a formatted report,
                                    that elaborate the feature with information that cannot be
                                    represented as text. Repeat for each file.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="role"
                            type="diggs:RolePropertyType">
                            <annotation>
                                <documentation>
                                    A role or task performed in connection with this feature, as a
                                    diggs:Role object that identifies the person or organization
                                    that performed it and the time frame, if applicable. Repeat for
                                    each role.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>
                                    A comment or remark about this feature, as a diggs:Remark.
                                    Repeat for each remark.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedObjectType" abstract="true">
        <annotation>
            <documentation>
                Abstract component object type in which at least one gml:name is required and
                several may be given.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element ref="gml:name" minOccurs="1" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedRoleObjectType">
        <annotation>
            <documentation>
                Abstract base type for objects that perform roles, such as personnel or
                organizations. At least one name is required.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element minOccurs="0" ref="diggs:status"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="role"
                            type="diggs:RolePropertyType">
                            <annotation>
                                <documentation>
                                    A role or task associated with this person or organization, as a
                                    diggs:Role object that records the role performed and the time
                                    frame, if applicable. Repeat for each role.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>
                                    A comment or remark about this object, as a diggs:Remark. Repeat
                                    for each remark.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractObjectType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for DIGGS component objects such as specifications, parameters
                and materials. Carries an optional description, identifier and name, plus status and
                remark.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark, which can
                                record who made it and when. Repeat for each remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractObservationSystem"
        type="diggs:AbstractObservationSystemType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for observation systems: a system of zones
                or regions associated with a sampling feature or sample, each assigned a single
                class of qualitative description, for example lithology, color or discontinuity.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractObservationSystemType">
        <annotation>
            <documentation>
                Abstract base type for observation systems, which contain qualitative or categorical
                observational data.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>
                                The program design objects this observation system was made to
                                satisfy, for example a planned log.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this observation system must
                                satisfy, for example a logging requirement it is evaluated against.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <annotation>
                            <documentation>The feature this observation system occurs in or was made
                                along, or the sample it was made on - exactly one, mandatory. What is
                                referenced here is the SUBJECT of the system: the thing being
                                described.

                                REVERTED 9/26 to this, the 3.0.0 cardinality, retracting S10's
                                widening to [0..*] (RI_Program_Architecture.md §6.3(a)). S10 widened
                                the choice so that a synthesized site-wide ground model could cite
                                the several features it was built from, reading the choice as
                                provenance - "this model was built from these fourteen borings."
                                That conflated two distinct things. This reference says what is
                                being described; the data an observation was DERIVED FROM is stated
                                per observation, through diggs:measurementRef ([0..*] on
                                diggs:AbstractObservationType). A unit whose unit weight derives
                                from a series of SPT or CPT tests cites those measurements there, on
                                the observation whose property they bear on - which a reference here
                                could not do, since a system spans many observations and could not
                                say which one each source bore on. That is the same defect that
                                deprecated the sampleRef branch below.

                                A site-wide interpretation still has one honest subject: the
                                sampling feature whose ground it describes. Where the system is a log
                                it is the borehole; where it is a ground model over a site it is a
                                feature spanning that site - diggs:RITreatedArea,
                                diggs:PlanarSamplingFeature or diggs:VolumetricSamplingFeature.

                                AS OF 9/26 THE sampleRef BRANCH IS DEPRECATED and only
                                samplingFeatureRef should be used here; see that element's own
                                annotation. The sample being observed is now stated on the
                                individual observation, diggs:sampleRef on
                                diggs:AbstractObservationType. Nothing about samplingFeatureRef
                                changes.</documentation>
                        </annotation>
                        <element ref="diggs:samplingFeatureRef"/>
                        <element ref="diggs:sampleRef">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0"
                                        replacedBy="diggs:sampleRef"
                                        note="on each observation (diggs:AbstractObservationType)"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use sampleRef on each observation. A
                                    reference to the sample the observation system was made
                                    on.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="observationProcedure"
                        type="diggs:SpecificationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A specification describing the method used for all of the
                                observations in this observation system, as a diggs:Specification.
                                Where procedures vary among individual observations, use the
                                properties and attributes of the observation objects instead.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:observationGroupRef">
                        <annotation>
                            <documentation>
                                The observation groups this observation system is a member of, for
                                example a set of ground models or logs interpreted together. The
                                member cites the group; see diggs:AbstractProjectScopedGroup. This
                                states membership: the other observation systems this one is read
                                alongside, such as one of three competing interpretations of the
                                same site. It is not the subject of the system, which
                                samplingFeatureRef gives, and it is not provenance, which each
                                observation cites through measurementRef.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractObservation" type="diggs:AbstractObservationType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for observations: a single qualitative or
                categorical description of a zone or region, as opposed to the
                diggs:AbstractObservationSystem that collects many of them.
                diggs:FractureObservation and diggs:PlacedObservation are not members despite their
                names: FractureObservationType descends from diggs:AbstractObjectType and
                PlacedObservationType from diggs:AbstractComponentObjectBaseType.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractObservationType">
        <annotation>
            <documentation>
                Abstract base type for observations: qualitative or categorical descriptions of a
                zone or region.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectNoDescriptionType">
                <sequence>
                    <element minOccurs="0" ref="diggs:sampleRef">
                        <annotation>
                            <appinfo>diggs:Sample</appinfo>
                            <documentation>
                                The sample the observation was made on, cited with xlink:href. Use
                                it on the individual observation, not on the enclosing observation
                                system. The test is what was described, not the kind of observation:
                                give it when the subject of the description is the recovered
                                material itself, and omit it when the description is an
                                interpretation of the ground made along a sampling feature, even if
                                a sample was recovered over the same interval. A core described
                                stratigraphically is an observation of that sample and takes a
                                sampleRef; a stratigraphy interpreted continuously down a borehole
                                does not; the same holds for lithology. The same observation type
                                can be used either way, so the author states it. Compare sampleRef
                                on diggs:AbstractMeasurementType, which has the same meaning,
                                although there the procedure settles it.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:measurementRef">
                        <annotation>
                            <appinfo>diggs:AbstractMeasurement</appinfo>
                            <documentation>
                                The measurement this description derives from, cited with
                                xlink:href: any member of the diggs:AbstractMeasurement substitution
                                group, such as diggs:Test, diggs:Monitor, diggs:MaterialTest,
                                diggs:GeophysicalFieldSurvey or diggs:MeasurementWhileDrilling.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:observationRef">
                        <annotation>
                            <appinfo>diggs:AbstractObservation</appinfo>
                            <documentation>
                                The other observations this description was interpreted from, for
                                example the per-borehole diggs:LithologyObservation that a site-wide
                                diggs:GeoUnitObservation synthesizes, or the lithology a
                                diggs:StratigraphyObservation rests on. The observation-level
                                counterpart to measurementRef, for a description whose basis is
                                another description rather than a measured value. Together they
                                state the provenance of an observation; both are carried on the
                                observation, not the system, because a system spans many
                                observations and cannot say which one a given source bore on.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The location of the description. If not used, the observation
                                pertains to the entire sample or sampling feature that is the target
                                of this observation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trueTopObserved" type="boolean">
                        <annotation>
                            <documentation>
                                Whether the uppermost position of the zone is the true top of the
                                feature being defined (true), or only the upper extent of the zone
                                as set by the extent of the sampling feature itself (false).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trueBaseObserved" type="boolean">
                        <annotation>
                            <documentation>
                                Whether the lowermost position of the zone is the true base of the
                                feature being defined (true), or only the lower extent of the zone
                                as set by the extent of the sampling feature itself (false).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="stratumCode" type="string">
                    <annotation>
                        <documentation>
                            A legacy attribute for AGS trial pit sampling features, where
                            observations of different strata can occur at the same depth in a pit: a
                            reference letter or number whose sole purpose is to link the stratum on
                            the face sketch of the trial pit to the observation.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractProcedureTrial" type="diggs:AbstractProcedureTrialType" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for procedure trials: activities that are
                repeated as part of a test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractProcedureTrialType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for individual trials or repetitions within a test procedure,
                such as the blows of a Standard Penetration Test or repeated readings in a
                laboratory consolidation test. Each trial is a discrete execution of the test
                methodology; trial results can be aggregated or analyzed to produce the final test
                result.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter recording a property of the trial that is not otherwise
                                provided for. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProcedure" type="diggs:AbstractProcedureType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for procedures used in investigations.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProcedureType">
        <annotation>
            <documentation>
                Abstract base type for procedures, which define methods, standards and
                specifications for conducting activities: test procedures, sampling procedures,
                monitoring procedures and other methodological specifications. A procedure can
                reference published standards (for example ASTM or ISO) or describe a custom method
                specific to a project.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramBasis" type="diggs:AbstractProgramBasisType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>
                Abstract head of the substitution group for program bases: the objects a design was
                prepared from, such as ground models, requirement sets, governing standards and
                calculation inputs. A basis is evidence, not intent and not constraint: it is what
                the designer relied on, and a design cites it through basisRef.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramBasisType">
        <annotation>
            <documentation>
                Abstract base type for program bases. Carries the design premises that are not
                specific to one practice area: the service life assumed, the consequence class
                governing reliability and the seismic hazard adopted. Concrete bases add their own
                domain-specific content.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType">
                <sequence>
                    <element minOccurs="0" ref="diggs:basedOnRef"/>
                    <element minOccurs="0" name="designWorkingLife" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The service life the design assumes. It governs the consequence
                                class, the durability provisions and, where the safety format is
                                Eurocode-based, which partial factors apply.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="consequenceClass" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The consequence or reliability class governing the design, for
                                example a Eurocode consequence class (EN 1990 CC1 to CC3) or an
                                equivalent national scheme. Several national schemes use this slot
                                for concepts that are not directly interchangeable with each other
                                or with the Eurocode classes. Use the DIGGS dictionary
                                consequenceClass.xml for the list of values; it contains Eurocode
                                (EN 1990) classes only, so for another scheme give a term and
                                codeSpace from that scheme.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seismicHazard"
                        type="diggs:SeismicHazardParametersPropertyType">
                        <annotation>
                            <documentation>
                                The seismic hazard the design adopts as a premise: the mapped ground
                                motion values, the site coefficients derived from them, the site
                                class those coefficients were read against, and the design peak
                                ground acceleration. Everything here is a basis input with no
                                achieved counterpart; contrast
                                diggs:RITreatedAreaType/seismicSiteClass. Ground improvement can
                                change the Vs30 of a site and so its site class, but it cannot
                                change the hazard at the site, which is fixed by regional seismicity
                                and the chosen return period.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="basisParameter"
                        type="diggs:DesignBasisParameterPropertyType">
                        <annotation>
                            <documentation>
                                A premise the design adopted that is neither a governing standard
                                nor a coded classification: a correlation coefficient taken from a
                                published method, a value assumed for a calculation input, or an
                                adopted design groundwater or ground level. Give one
                                diggs:DesignBasisParameter per named premise. A premise is not a
                                factor: diggs:DesignFactor, and the factor element on the concrete
                                bases, are for the partial or global safety factor set a safety
                                format applies. A penetrometer bearing factor or mobilization
                                coefficient is a premise the calculation consumes, not a safety
                                margin applied to it.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:groundModelRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramDesign" type="diggs:AbstractProgramDesignType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>
                Abstract head of the substitution group for program designs: the planned
                characteristics, targets and requirements that guide execution of a program of work.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramDesignType">
        <annotation>
            <documentation>
                Abstract base type for program designs, which define the planned characteristics and
                requirements of a program of work: target parameters, acceptance criteria, testing
                frequencies and quality control measures. A design can be compared with the actual
                implementation to track compliance and identify deviations.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType">
                <sequence>
                    <element minOccurs="0" ref="diggs:basedOnRef"/>
                    <element minOccurs="0" maxOccurs="1" ref="diggs:basisRef">
                        <annotation>
                            <documentation>
                                The basis this design was prepared from: one, the most specific that
                                applies. More general bases are reached through that basis's own
                                basedOnRef chain, resolved per property with the most specific
                                first.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The specifications this design was prepared to satisfy. This is a
                                different relationship from basedOnRef and is kept separate so that
                                inheritance up the basedOnRef chain does not pull constraints into
                                the chain of intent.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="nonConformanceRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:NonConformance</appinfo>
                            <documentation>
                                The non-conformance or non-conformances this design responds to. Set
                                on a repair, rework or replacement design prepared to carry out a
                                disposition; absent on an original design. A feature built to this
                                design cites the design through its own programDesignRef. Given by
                                reference only.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="AbstractSamplingFeatureDesign" type="diggs:AbstractSamplingFeatureDesignType"
        substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>
                Head of the substitution group for designs of sampling features: the planned
                counterpart of the sampling features that are built. Sibling of
                diggs:AbstractSamplingDesign (samples and sampling activities),
                diggs:AbstractConstructionActivityDesign and diggs:AbstractMeasurementDesign.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSamplingFeatureDesignType">
        <annotation>
            <documentation>
                Abstract base type for designs of sampling features. Carries the kind of sampling
                feature planned, its scope, its progress, planned equipment and other planned
                properties.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="samplingFeatureType"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The kind of sampling feature this design applies to. A realized
                                feature that fulfils the design is expected to be of this type.
                                Optional, like every other property here: an exception design
                                resolves anything it does not restate up its basedOnRef chain. Use
                                the DIGGS dictionary samplingFeatureTypes.xml for the list of
                                values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="scope" type="diggs:SFDesignScopePropertyType">
                        <annotation>
                            <documentation>
                                The geospatial scope of the design: the zones, grid or positions
                                where the planned sampling features are to be placed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="progress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The lifecycle of this planned object as a track of dated states. It
                                answers what is planned but not yet built without any reference from
                                the plan to its realization: a design with no progress recorded, or
                                whose latest progressState has not reached completion, is not yet
                                fulfilled.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment planned to be used in realizing this design, given inline
                                or by reference: for example a piezometer a monitoring plan intends
                                to install, a sampler a collection plan intends to use, or a rig a
                                construction plan intends to bring. The kind of instrument is
                                carried on the equipment's own class property (see
                                equipmentClass.xml).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherDesignProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter for a planned property that has no named element on this
                                or a more specific type. Prefer a named element wherever one exists.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSamplingDesign" type="diggs:AbstractSamplingDesignType"
        substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>
                Abstract head of the substitution group for designs of samples and sampling
                activities. Sibling of diggs:AbstractSamplingFeatureDesign, which covers designs of
                sampling features. Its members include diggs:DesignSample, for a collected or
                derived sample, and diggs:DesignGroutMix, a specialization of it for a manufactured
                sample.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSamplingDesignType">
        <annotation>
            <documentation>
                Abstract base type for designs of samples and sampling activities. Carries the
                planned activity type, progress, planned equipment and other planned properties.
                Scope is not declared here; the scope of a sample design
                (diggs:SampleDesignScopePropertyType) is declared on diggs:DesignSampleType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element name="activityType" type="diggs:PlannedActivityTypeEnumType">
                        <annotation>
                            <documentation>
                                The kind of sampling activity planned: collect, aggregate, subsample
                                or test. Required, in parallel with
                                diggs:AbstractSamplingActivityType/activityType on the realized
                                side. Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="progress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The lifecycle of this planned object as a track of dated states, as
                                for diggs:AbstractSamplingFeatureDesignType/progress.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment planned to carry out this design, given inline or by
                                reference: for example a batching plant or mixer for a grout mix, or
                                a sampler for a collection.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherDesignProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter for a planned property that has no named element on this
                                or a more specific type. Prefer a named element wherever one exists.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractConstructionActivityDesign"
        type="diggs:AbstractConstructionActivityDesignType" substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>
                Abstract head of the substitution group for designs of construction activities: the
                planned counterpart of diggs:AbstractConstructionActivity. A construction activity
                design plans the act (method, equipment, the features it is to build), not the thing
                built; designs of the built features are under diggs:AbstractSamplingFeatureDesign.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractConstructionActivityDesignType">
        <annotation>
            <documentation>
                Abstract base type for designs of construction activities. Carries progress, planned
                equipment and other planned properties.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="progress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The lifecycle of this planned activity as a track of dated states. A
                                design with no progress recorded, or whose latest progressState has
                                not reached completion, has not yet been carried out.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment planned to carry out this activity, such as a rig, a pump
                                or a batching plant, given inline or by reference.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherDesignProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter for a planned property that has no named element on this
                                or a more specific type. Prefer a named element wherever one exists.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractMeasurementDesign" type="diggs:AbstractMeasurementDesignType"
        substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>
                Abstract head of the substitution group for designs of measurements: the planned
                counterpart of diggs:AbstractMeasurement. A measurement design plans the inputs and
                procedure of an in-situ test, a laboratory test, a monitoring campaign or a
                measurement taken while drilling; results do not exist at planning time and are not
                planned.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractMeasurementDesignType">
        <annotation>
            <documentation>
                Abstract base type for measurement designs. Carries progress, planned equipment and
                other planned properties.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="progress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The lifecycle of this planned measurement as a track of dated
                                states. A design with no progress recorded, or whose latest
                                progressState has not reached completion, has not yet been
                                performed.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment planned to take this measurement, given inline or by
                                reference: for example a piezometer a monitoring plan intends to
                                install, a load frame or a logger. The kind of instrument is carried
                                on the equipment's own class property.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherDesignProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter for a planned property that has no named element on this
                                or a more specific type. Prefer a named element wherever one exists.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramModule" type="diggs:AbstractProgramModuleType">
        <annotation>
            <documentation>
                Abstract common ancestor of the three kinds of object a program issues or relies on:
                designs (intent), specifications (constraint) and bases (evidence). It is not itself
                a member of a substitution group; instances substitute diggs:AbstractProgramDesign,
                diggs:AbstractProgramSpecification or diggs:AbstractProgramBasis.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramModuleType">
        <annotation>
            <documentation>
                Abstract base type for program modules: the designs, specifications and bases a
                program issues or relies on.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence> </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramSpecification"
        type="diggs:AbstractProgramSpecificationType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>
                Abstract head of the substitution group for program specifications: the requirements
                a program issues, such as tolerances, acceptance limits and performance criteria,
                each carrying the scope of features over which it applies. A realized feature
                declares which specifications govern it through diggs:programSpecificationRef, and a
                design declares which it was prepared to satisfy through the same property. Not to
                be confused with diggs:Specification. A program specification is a feature head: its
                members are independently identified, referenceable features that state requirements
                and, as program modules, carry scope and basedOnRef. diggs:Specification is a
                component object, a procedure that cites a published standard
                (standardReferenceNumber, standardTitle, standardVersion and so on) and states no
                requirement of its own. A program specification commonly cites a diggs:Specification
                for the test method by which conformance is measured; the two are complementary.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramSpecificationType">
        <annotation>
            <documentation>
                Abstract base type for detailed program specifications that define technical
                requirements and acceptance criteria: references to specific standards (for example
                ASTM or AASHTO), numerical acceptance criteria, testing methods and frequencies, and
                quality control requirements. Unlike designs, specifications are typically
                contractual and establish enforceable requirements. basedOnRef cites a more general
                specification of the same kind that this one specializes; an acceptance criterion
                cites the specification it elaborates through diggs:partOfSpecificationRef instead,
                which is a component relationship rather than specialization. basisRef cites the
                basis the requirements were derived from.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType">
                <sequence>
                    <element minOccurs="0" ref="diggs:basedOnRef"/>
                    <element minOccurs="0" maxOccurs="1" ref="diggs:basisRef">
                        <annotation>
                            <documentation>
                                The basis this specification's requirements were derived from: one,
                                the most specific that applies. More general bases are reached
                                through that basis's own basedOnRef chain.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="appliesToZone"
                        type="diggs:PlanarSurfaceOrMultiSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The region this specification applies to, as a plan-view polygon or,
                                where the region is discontinuous, several polygons. A check, not a
                                membership test: it does not establish which features the
                                specification governs, which is asserted only from the realized side
                                through programSpecificationRef, or from a design that adopts the
                                specification. Where stated, every feature so established is
                                expected to have its referencePoint within the region (a node on the
                                boundary counts as inside); one that does not is a finding, not a
                                reason to exclude it. Where absent, no spatial check applies.
                                Independent of the scope of any citing design: a specification
                                shared across designs, or cited directly by a feature, has no single
                                design scope to inherit the check from.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="appliesToFeatureType"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The kind of feature this specification applies to, for example
                                "ri_column" or "load_transfer_platform". The same kind of check as
                                appliesToZone: every feature established as a member through
                                programSpecificationRef or an adopting design is expected to be of
                                this type; one that is not is a finding. Where absent, no type check
                                applies. The codeSpace is required. For a specification whose
                                subject is a construction activity, the kind of feature the activity
                                builds or acts on. Use the DIGGS dictionary samplingFeatureTypes.xml
                                for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgram" type="diggs:AbstractProgramType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for program features, which contain the
                design and specifications for a collection of planned activities and observations
                associated with a project, covering both exploration efforts and construction
                activities.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramType">
        <annotation>
            <documentation>
                Abstract base type for program features.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element minOccurs="1" ref="diggs:projectRef" maxOccurs="unbounded"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractEvaluation" type="diggs:AbstractEvaluationType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for evaluations: records of whether realized
                work met the acceptance criteria stated by one or more programs. Delivered at the
                top level of a DIGGS document (diggs:Diggs/evaluation). An evaluation cites its
                programs, the criteria it applies, the subjects it judges and the evidence it relies
                on; none of those cite the evaluation.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractEvaluationType">
        <annotation>
            <documentation>
                Abstract base type for evaluations. Who made the evaluation is recorded with the
                inherited role property.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element maxOccurs="unbounded" ref="diggs:programRef">
                        <annotation>
                            <documentation>
                                The program or programs whose acceptance criteria this evaluation
                                applies. Every criterion the evaluation cites belongs to one of
                                them. More than one where an evaluation spans programs, for example
                                the results of a testing program judged against the criteria of a
                                ground improvement program.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="evaluationDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                When the evaluation was issued. Individual checks may carry their
                                own date.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProject" type="diggs:AbstractProjectType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for projects. A project is an organizational
                unit that contains one or more sampling features, samples and associated data,
                typically corresponding to a geographic location or an engineering study. All DIGGS
                data must be associated with a project, which provides the organizational context
                for the investigation.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for projects that organize investigations with a defined scope,
                location and time frame.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element name="referencePoint" type="diggs:PointLocationPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The location of the project, usually a point at the ground surface,
                                within a well-known 3D CRS or combined CRS (geographic or projected,
                                with elevation). An extension of gml:Point with an additional
                                uncertainty property.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="linearExtent" type="diggs:LinearExtentPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A project geometry defined as a line in geographic or projected
                                space, as a LinearExtent geometry object. Repeat for each line.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="arealExtent" type="diggs:SurfacePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A project geometry that gives the areal extent of the project in
                                geographic or projected space, as a surface geometry object. Repeat
                                for each area.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="projectDateTimeSpan" type="diggs:TimeIntervalPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The interval of time during which the project was active.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="locality" type="diggs:LocalityPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A diggs:Locality or diggs:PointLocation object describing,
                                respectively, the non-coordinate or the coordinate location of the
                                project. If the project has only one locality property, use
                                referencePoint rather than a PointLocation object to give the
                                coordinate location.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="purpose" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The purpose of the project. Intended to come from a controlled list
                                of terms. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="projectEvent"
                        type="diggs:ProjectEventPropertyType">
                        <annotation>
                            <documentation>
                                An event associated with the project, by time or location, as a
                                diggs:ProjectEvent. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="contract" type="diggs:ContractPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A business contract associated with the project, as a diggs:Contract
                                object. Repeat for each contract.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherProjectProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter, with a name and value, describing a project property
                                not otherwise defined in the schema. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:projectGroupRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSample" type="diggs:AbstractSampleType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for all material samples.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSampleType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for samples. A sample is physical material collected from a
                sampling feature during a sampling activity, or made by aggregating other samples.
                Samples link field investigations (sampling features) to laboratory testing
                (specimens and material tests), and record their collection location, parent
                sampling feature, collection method and physical characteristics. A sample can be
                subdivided into specimens for laboratory testing or aggregated from several source
                samples.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element name="projectRef" type="diggs:FeatureReferenceType" minOccurs="1">
                        <annotation>
                            <documentation>
                                The project this sample is associated with. Required: every sample
                                belongs to a project, which gives it its organizational and
                                geographical context.
                            </documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:samplingActivityRef"/>
                    <element minOccurs="0" ref="diggs:programRef">
                        <annotation>
                            <documentation>
                                The program this sample is associated with. Where stated, this is
                                the authoritative program for the sample; where absent, the program
                                is that of the sampling activity, reached through
                                samplingActivityRef. State it only where the program of the sample
                                genuinely differs from that of its sampling activity, for example a
                                sample re-tested under a later, separate testing program.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this sample must satisfy. The same
                                override and fallback rule applies as for programRef.
                            </documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:sampleProducedRef"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:sampleGroupRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSamplingActivity"
        type="diggs:AbstractSamplingActivityType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sampling activities, which are the
                actions taken to collect samples from sampling features, such as drilling, coring,
                excavation and grab sampling. Each records the who, what, when, where and how of
                sample collection, including equipment used, environmental conditions and recovery
                information.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingActivityType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for sampling activities that collect materials from sampling
                features.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <element minOccurs="0" maxOccurs="1" name="currentDesign"
                        type="diggs:ProgramDesignReferencePropertyType">
                        <annotation>
                            <documentation>
                                The program design this activity was carried out to realize, as
                                currently planned.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="previousDesign"
                        type="diggs:ProgramDesignReferencePropertyType">
                        <annotation>
                            <documentation>
                                A design that governed this activity at an earlier point, before a
                                later design superseded it. Use designRole and effectiveFrom on the
                                reference to state which design and when.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this activity must satisfy.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:constructionActivityRef"/>
                    <choice>
                        <sequence>
                            <element ref="diggs:samplingFeatureRef" minOccurs="1" maxOccurs="1"/>
                            <element name="samplingLocation" type="diggs:LocationPropertyType"
                                minOccurs="1">
                                <annotation>
                                    <documentation>
                                        The geographic location of the sampling activity.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element maxOccurs="unbounded" minOccurs="0"
                                ref="diggs:associatedProjectRef"/>
                            <element minOccurs="0" ref="diggs:originalProjectRef"/>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="sourceSampleRef" maxOccurs="unbounded"
                        type="diggs:FractionalReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Sample/@gml:id</appinfo>
                            <documentation>
                                The sample or samples used to create the samples produced by this
                                activity (see sampleProduced). Used only for activities that
                                subsample or aggregate other samples. For an aggregate, the
                                percentage attribute can state how much of the new sample is
                                composed of the source sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="activityType" type="diggs:ActivityTypeEnumType">
                        <annotation>
                            <documentation>
                                The classification of the sampling activity, which applications can
                                use to validate other activity information. The samples the activity
                                produces are expected to agree with the value: for aggregate, the
                                samples carry more than one sourceSampleRef; for subsample, only
                                one; for test, neither a sourceSampleRef nor a samplingFeatureRef,
                                the activity pointing to a project only. Values come from the
                                enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lengthLongestPortion"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For rock cores, the length of the longest solid, cylindrical core
                                piece of the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>
                                The purpose of taking this sample: an uncontrolled string describing
                                the test or tests intended to be run on the samples generated by
                                this activity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockQualityDesignationLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For rock cores, the sum of the lengths of core pieces longer than
                                100 mm (4 in), measured along the centerline.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingActivityRQD"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                For rock cores, the rock quality designation of the sampling
                                activity: rockQualityDesignationLength divided by the core run (the
                                length of the sampling activity interval).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="sampleProduced"
                        type="diggs:SampleProducedPropertyType">
                        <annotation>
                            <documentation>
                                The samples produced by this sampling activity and, optionally, the
                                time and location of each.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplerInsertionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                For sampling of soil or rock, the means by which the sampler is
                                inserted into the ground, for example pushed or driven. Use the
                                DIGGS dictionary samplerInsertionMethod.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingCategory" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The ISO 22475-1 sampling category (A to E) achieved by the technique
                                and equipment of this sampling activity: how much the technique
                                disturbs the material sampled, independent of what was actually
                                recovered. See diggs:SampleType/qualityClass for the related but
                                distinct soil quality class of the sample. Use the DIGGS dictionary
                                samplingCategory.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingDate" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The date and time interval that encompasses the entire time over
                                which sampling occurred.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingEnvironment"
                        type="diggs:EnvironmentPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A collection of environmental parameters recorded at a specific time
                                instant during the sampling. Repeat for each recording.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplingEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>
                                The sampling equipment used, as an equipment feature or a reference
                                to one. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplingMethod" type="diggs:SamplingMethodPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                The method of sampling, as a diggs:Specification or, where the
                                method is a driven penetration test, a reference (xlink:href) to the
                                diggs:DrivenPenetrationTest procedure of the diggs:Test that
                                produced the samples.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="solidCoreRecoveryLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For rock cores, the sum of the lengths of solid, cylindrical core
                                pieces.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalSampleRecoveryLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For soil or rock cores, the total length of sample recovered during
                                the activity; 0 if none was recovered. It can also be derived if
                                totalSampleRecovery is reported.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalSampleRecovery"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                For core samples from boreholes, the derived ratio of
                                totalSampleRecoveryLength to the length of the sampling activity
                                interval, typically reported as a percent.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                For sampling activities that blend samples in aggregation, such as
                                soil-cement mixtures, the time taken to mix the samples together.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0"
                        name="otherSamplingActivityProperty" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter reporting ancillary metadata about the sampling
                                activity. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element maxOccurs="1" minOccurs="0" name="coringPushPressure"
                            type="diggs:PressureMeasureType">
                            <annotation>
                                <documentation>
                                    For coring activities, the push pressure reported as a single
                                    value.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element maxOccurs="1" minOccurs="0" name="coringPushPressureMin"
                                type="diggs:PressureMeasureType">
                                <annotation>
                                    <documentation>
                                        For coring push pressure reported as a range, the minimum
                                        pressure.
                                    </documentation>
                                </annotation>
                            </element>
                            <element maxOccurs="1" minOccurs="0" name="coringPushPressureMax"
                                type="diggs:PressureMeasureType">
                                <annotation>
                                    <documentation>
                                        For coring push pressure reported as a range, the maximum
                                        pressure.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSamplingFeature" type="diggs:AbstractSamplingFeatureType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sampling features. A sampling feature is
                a physical object or location through which properties of an investigation target
                are observed or measured, or through which some type of activity is performed. It
                defines the dimensionality, extent and local spatial reference system of the zones
                where observations or activities take place.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingFeatureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for sampling features where investigations are conducted.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:originalProjectRef"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:associatedProjectRef"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:samplingFeatureGroupRef"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <element minOccurs="0" maxOccurs="1" name="currentDesign"
                        type="diggs:ProgramDesignReferencePropertyType">
                        <annotation>
                            <documentation>
                                The program design this feature was realized to satisfy, as
                                currently built.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="previousDesign"
                        type="diggs:ProgramDesignReferencePropertyType">
                        <annotation>
                            <documentation>
                                A design that governed this feature earlier in its history, for
                                example the design it was originally built to, before a later repair
                                or modification. Use designRole and effectiveFrom on the reference
                                to state which design and when.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>
                                The program specification objects this feature must satisfy. More
                                than one may be cited, for example a site-level performance
                                specification and a project-level tolerance specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="realizesGridIndex" type="diggs:GridIndexType">
                        <annotation>
                            <documentation>
                                Declares which planned position this feature realizes, as the index
                                of the planned node within the grid geometry of the design cited by
                                programDesignRef. Where that design states no plannedPositions of
                                its own, the grid is the one resolved through its basedOnRef chain,
                                most specific first. Ordered per the grid's axisLabels and of the
                                same dimension as the grid; see diggs:GridIndexType. Omit it for
                                instance-scoped designs, where programDesignRef alone identifies the
                                plan, and for zone-scoped designs, which state no planned positions
                                to index into. Only the grid form needs it, because a grid node is
                                not an object and has no gml:id to point at. Do not match a realized
                                feature to its planned position by proximity: nearest-node matching
                                fails silently where it matters most, since a column placed outside
                                its position tolerance is what a conformance check exists to catch,
                                and it may lie nearer another node.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="environment"
                        type="diggs:EnvironmentPropertyType">
                        <annotation>
                            <documentation>
                                An environment object holding environmental parameters recorded
                                during construction of the sampling feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSamplingFeatureProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter giving the name, value or range of values, and unit of
                                measure of a property or measurement parameter not otherwise
                                provided for. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="locality" type="diggs:LocalityPropertyType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                A diggs:Locality object holding non-coordinate location information
                                for the feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="referencePoint" type="diggs:PointLocationPropertyType"
                        minOccurs="1">
                        <annotation>
                            <documentation>
                                The location of the sampling feature, as a diggs:PointLocation
                                within a known spatial 3D CRS or compound CRS (a geographic or
                                projected 2D CRS plus a vertical CRS). Required.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="localCoordinates"
                        type="diggs:LocalCoordinatePropertyType">
                        <annotation>
                            <documentation>
                                A diggs:LocalCoordinate object holding the local coordinates of the
                                reference point of the feature.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="AbstractSensor" substitutionGroup="diggs:AbstractEquipment"
        type="diggs:AbstractSensorType" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sensors.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSensorType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for sensors that measure physical parameters such as temperature
                or pressure. It carries no gml:AssociationAttributeGroup or
                gml:OwnershipAttributeGroup: those are attributes of a property element, not of an
                object, so the property that points at a sensor (diggs:SensorPropertyType) carries
                them instead.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="referencePoint"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The reference point location of the sensor, such as the top of
                                casing for a tape used to detect water level, or a location within
                                the response zone itself.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateInstalled"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The date and time the sensor was installed: a single time, or a
                                period for a multi-stage installation. Needed to interpret
                                monitoring data relative to the installation date.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="detector" type="diggs:DetectorPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The detection device or mechanism the sensor uses, which responds to
                                the measured parameter, for example a pressure transducer, vibrating
                                wire or thermistor. Repeat where the sensor uses several detection
                                methods.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSpecimen" type="diggs:AbstractSpecimenType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for specimens, with concrete specializations
                by specimen state or type, for example soil, liquid, gas, rock or manufactured
                cementitious material. A specimen derives from one or more samples, is created as
                part of a test procedure, and exists only in the context of the test procedure that
                creates it.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSpecimenType">
        <annotation>
            <documentation>
                Abstract base type for test specimens derived from samples or manufactured
                materials. A specimen is a prepared portion of a sample used for a specific
                laboratory test, typically prepared to standard dimensions and conditions (for
                example trimmed, molded or cured) according to the test method. One sample can yield
                several specimens for different tests or repeat testing. A specimen is described
                within the specimen property of the diggs:Test or diggs:MaterialTest that tests it.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element maxOccurs="unbounded" ref="diggs:sampleRef">
                        <annotation>
                            <documentation>
                                The sample or samples the specimen was derived from. At least one is
                                required. The percentage attribute can state the proportion each
                                sample contributes.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the specimen where it differs from that of its host
                                sample, for example a specimen taken from a core sample at a
                                specific location rather than one encompassing the whole sample.
                                When absent, the specimen location is that of the host sample, if
                                relevant.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extractionTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The time instant when this specimen was extracted from the sample
                                for testing or, for a specimen molded or cast from fresh material,
                                the time it was made. It equals diggs:MaterialTest/samplingTime and
                                diggs:Test/samplingTime when only one specimen is used for the test,
                                and should generally not be used in that case. Where several
                                specimens are used and each was extracted at a different time, use
                                this property for the precise time of each.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="preparationProcedure"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>
                                A diggs:Specification, or a reference to one, describing the
                                procedure used to prepare the specimen from the sample. It can be a
                                simple description (the gml:description of the Specification), the
                                name of a standard (the gml:name) or a full procedural specification
                                using the properties of the Specification. More than one may be
                                given where the specimen was made and prepared under several
                                procedures, for example cast and cured under one standard and capped
                                under another.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherSpecimenProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A parameter recording a specimen property not otherwise provided
                                for. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractSurface"
        substitutionGroup="diggs:AbstractGeometricPrimitive" type="diggs:AbstractSurfaceType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for DIGGS standalone surface geometries
                (diggs:PlanarSurface, diggs:MultiPlanarSurface, diggs:TriangulatedSurface,
                diggs:CompositeSurface). It excludes diggs:Shell, which is one boundary component of
                a solid rather than a surface in its own right. A property that wants any real
                surface, not the boundary piece of a solid, should reference diggs:AbstractSurface
                rather than gml:AbstractSurface.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSurfaceType">
        <annotation>
            <documentation>
                Abstract base type for DIGGS standalone surface geometries.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractSurfaceType"/>
        </complexContent>
    </complexType>

    <element name="AbstractTestProcedure" type="diggs:AbstractTestProcedureType"
        substitutionGroup="diggs:AbstractProcedure" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for the procedures that comprise a
                diggs:Test or diggs:MaterialTest.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractTestProcedureType">
        <annotation>
            <documentation>
                Abstract base type for test procedures, which define how tests are performed.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProcedureType">
                <sequence>
                    <element name="testProcedureMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                The method used for the test procedure, as a diggs:Specification or
                                a reference to one. Repeat to cite several standards that govern the
                                same procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="testProcedureEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>
                                The equipment used in the test procedure, as an object that
                                substitutes for diggs:AbstractEquipment, given inline or by
                                reference. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testingEnvironment" maxOccurs="unbounded"
                        type="diggs:EnvironmentPropertyType">
                        <annotation>
                            <documentation>
                                Environmental conditions during testing. Values at different times
                                during the test can be given in several elements, using the dateTime
                                property of the environment object.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherTestProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter recording a test property not otherwise provided for.
                                Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="LoadTestReferenceSystemEnumType">
        <restriction base="string">
            <enumeration value="independent reference beam">
                <annotation>
                    <documentation>Displacement measured against a fixed reference beam supported clear of the
                        reaction system and of any ground disturbed by the test.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="optical survey">
                <annotation>
                    <documentation>Displacement measured by optical or total-station survey referenced to a
                        fixed benchmark independent of the reaction system.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="satellite positioning">
                <annotation>
                    <documentation>
                        Displacement measured by satellite positioning (GNSS) referenced to a fixed
                        benchmark.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LoadTestReferenceSystemEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LoadTestReferenceSystemEnumType"/>
    </simpleType>
    <simpleType name="StatisticEnumType">
        <restriction base="string">
            <enumeration value="individual">
                <annotation>
                    <documentation>The criterion is evaluated against each measurement in its scope separately,
                        with no reduction to a single value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean">
                <annotation>
                    <documentation>The criterion is evaluated against the arithmetic mean of the measurements
                        in its scope.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="median">
                <annotation>
                    <documentation>The criterion is evaluated against the median of the measurements in its
                        scope.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="minimum">
                <annotation>
                    <documentation>The criterion is evaluated against the smallest of the measurements in its
                        scope.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="maximum">
                <annotation>
                    <documentation>The criterion is evaluated against the largest of the measurements in its
                        scope.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="percentile">
                <annotation>
                    <documentation>The criterion is evaluated against a stated percentile of the measurements
                        in its scope; the percentile intended is given by the sibling
                        percentileValue element.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="standard deviation">
                <annotation>
                    <documentation>The criterion is evaluated against the standard deviation of the
                        measurements in its scope.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="coefficient of variation">
                <annotation>
                    <documentation>The criterion is evaluated against the coefficient of variation (standard
                        deviation divided by the mean) of the measurements in its scope, as a limit
                        on scatter.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="StatisticEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:StatisticEnumType"/>
    </simpleType>
</schema>
