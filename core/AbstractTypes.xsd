<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.0.0">

    <!-- Uncomment to clear validation errors without a master file -->
    <include schemaLocation="../Diggs.xsd"/>

    <!-- Imports -->
    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>

    <!-- HIERARCHY LEVEL 1: Root Base Type (Foundation of DIGGS Schema)    -->
    <!--=============================================================================-->

    <element abstract="true" name="AbstractAcceptanceCriterion"
        type="diggs:AbstractAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>Head of the substitution group for acceptance criteria - a single
                testable requirement stating what is measured, how the measurements are reduced to
                one value, the comparison applied, and the limit compared against. Being a program
                specification, a criterion also carries the scope of features it governs and may
                specialize a more general criterion through basedOnRef.
                
                Its two members differ only in WHAT IS MEASURED, and that difference is carried by
                the element name rather than by a discriminator field:
                diggs:PerformanceCriterion measures a physical property of the completed work,
                diggs:DesignConformanceCriterion measures a geometric or constructional property
                against its design intent.
                
                One criterion states ONE requirement. A specification imposing several requirements
                on the same property - say a mean and a minimum - is several criteria sharing a
                scope, not one criterion with several limits.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractAcceptanceCriterionType">
        <annotation>
            <documentation>Base type for acceptance criteria. Carries everything a criterion needs
                except its subject, which its concrete members supply.
                
                Factoring the criterion this way - subject, statistic, operator, limit - is what
                lets one type express what diggs:GroutingPerformanceSpecificationType
                (specialty/Grouting.xsd) spells out as roughly thirty separately named elements
                encoding property x statistic x bound. That type is untouched by this step;
                re-expressing it against this family comes later, with a migration
                path.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" name="statistic" type="gml:CodeType">
                        <annotation>
                            <documentation>How multiple measurements within the criterion's scope
                                are reduced to the single value that is compared against the limit.
                                Intended values: individual, mean, minimum, maximum, percentile.
                                Omit where the criterion applies to each measurement
                                individually.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentileValue" type="double">
                        <annotation>
                            <documentation>The percentile intended, where statistic is "percentile"
                                - for example 90 for a 90th-percentile criterion. Meaningless
                                otherwise; that this element and statistic must agree is a
                                correlation XSD cannot express, and is left to the validation
                                chain.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="operator"
                        type="diggs:CriterionOperatorEnumType">
                        <annotation>
                            <documentation>The comparison applied between the evaluated value and
                                the limit. Mandatory: a limit without a comparison states no
                                requirement.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" maxOccurs="1" name="limit"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The value or range the evaluated value is compared
                                against, with its unit. A diggs:ParameterPropertyType so that the
                                limit may be a single value (parameterValue) or a band
                                (parameterMinValue / parameterMaxValue, with operator "within"),
                                and so that a dictionary-bound or provenanced form may be used where
                                the limit itself derives from evidence - the widened property type
                                admits diggs:Parameter, diggs:AuthorizedParameter and
                                diggs:ProvenancedParameter alike.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="basis" type="gml:CodeType">
                        <annotation>
                            <documentation>The unit of work the criterion is assessed over - for
                                example per element, per unit cell, per 100 ft, or as a multiple of
                                diameter. Distinct from scope, which says WHICH features are
                                governed; basis says over what quantum each evaluation is
                                made.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baseLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The reference length over which a gradient or
                                rate-of-change criterion is assessed, where basis expresses a per
                                unit length quantum. Together with limit this is what lets a
                                criterion state a gradient such as "0.5 in per 100 ft", which no
                                single length-valued element can carry.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="evaluatedAgainstRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>A reference to a feature that supplies the value this
                                criterion is evaluated against - typically a Test, a Monitor, or a
                                sampling feature. Repeatable, since a statistic may be computed over
                                many. Carries no targetElement appinfo deliberately: the legitimate
                                targets share no single substitution-group head, and enumerating
                                members instead of naming a head is the pattern that left
                                diggs:samplingFeatureRef stale.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="1" name="sourceSpecRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Specification</appinfo>
                            <documentation>A reference to the published standard or project clause
                                this criterion was taken from. Points at a diggs:Specification, the
                                COMPONENT OBJECT that cites a standard - not at a program
                                specification, which is what this criterion itself
                                is.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    
    <complexType abstract="true" name="AbstractDiggsType">
        <annotation>
            <documentation>The root abstract type for all DIGGS objects. This type extends GML's AbstractGMLType but restricts it to require a gml:id attribute. The gml:id serves as a unique identifier for the object within the DIGGS document and enables XML linking and referencing. All DIGGS types that need to be referenced ultimately derive from this base type, ensuring every object in the schema has a unique identifier for cross-referencing and data integrity.</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractGMLType">
                <attribute ref="gml:id" use="required"/>
            </restriction>
        </complexContent>
    </complexType>
    <!--=============================================================================-->
    <!-- HIERARCHY LEVEL 2: Major Category Base Types                       -->
    <!--=============================================================================-->
    <complexType name="AbstractObjectBaseType" abstract="true">
        <annotation>
            <documentation>Base type for all DIGGS objects, including required gmlid, description and identifier properties. This is the fundamental abstract type for objects (non-feature objects) in DIGGS, that represent supporting information like methods, structures and metadata, rather than primary geotechnical features.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractDiggsType">
                <sequence>
                    <element ref="gml:description" minOccurs="0"/>
                    <element minOccurs="0" ref="gml:identifier"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractObjectNoDescriptionType" mixed="false" abstract="true">
        <annotation>
            <documentation>Base type for all objects without description field. This is the fundamental abstract type for component objects (non-feature objects) in DIGGS, providing core properties including identifier,status, remark, and xml:lang, but excluding the description field. Used as a base for specialized objects where descriptions are not required or are provided through alternative mechanisms. Component objects typically represent supporting information like equipment, procedures, and metadata rather than primary geotechnical features.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractDiggsType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" ref="diggs:remark"/>
                    </sequence>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <!--=============================================================================-->
    <!-- HIERARCHY LEVEL 3+: Specialized Derived Types                      -->
    <!--=============================================================================-->
    <complexType name="AbstractComponentObjectBaseType" abstract="true">
        <annotation>
            <documentation>Base type for all component objects where gml:AbstractGML is restricted to only allow for an optional gml:id.</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractGMLType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractComponentObjectNoDescriptionType" abstract="true">
        <annotation>
            <documentation>Restricted component object type without description or name elements. Restricts AbstractComponentObjectType to remove the description and name elements, retaining only identifier, status, and remark properties.</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractComponentObjectType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>Any comment or remark associated with this specific
                                    object.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
                <attribute ref="gml:id" use="optional"/>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractComponentObjectType" abstract="true">
        <annotation>
            <documentation>Standard base type for component objects with full metadata properties. This type extends AbstractComponentObjectBaseType to include GML description, identifier, name elements, plus DIGGS-specific status and remark properties.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status">
                        <annotation>
                            <documentation>A text string to provide information about the status of
                                the object to be used to track QA/QC controls, review or release
                                status, etc. The values used are intended to come from a controlled
                                list of terms maintained by an organization.</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractConstructionActivity" type="diggs:AbstractConstructionActivityType"
        abstract="true">
        <annotation>
            <documentation>Base type for construction activity features - activities that improve or
                alter ground conditions.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractConstructionActivityType" abstract="false">
        <annotation>
            <documentation>Base type for construction activity features. Construction activities are specialized activities that modify or improve ground conditions.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="1" ref="diggs:samplingFeatureRef" maxOccurs="1"/>
                    <element minOccurs="0" ref="diggs:programRef" maxOccurs="1"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this
                                activity was carried out to realize - for example the
                                TargetConstructionActivity (B7) that planned it. Widened here (S7)
                                from absent: an activity could previously cite its governing
                                specification but had no direct way to cite the plan it executed,
                                resolvable only indirectly via samplingFeatureRef to the realized
                                feature and that feature's own programDesignRef.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects
                                this activity must satisfy. Widened here (S7) from
                                maxOccurs="1": an activity may be governed by more than one
                                specification, for example a method specification alongside a
                                site-level performance specification, the same reasoning that
                                widened diggs:AbstractSamplingFeatureType's copy of this element
                                (B1).</documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A property element that contains a Specification object
                                (or reference to one) detailing the test procedure method
                                used.</documentation>
                        </annotation>
                    </element>
                    <element name="constructionEnvironment" type="diggs:EnvironmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A reference to an Environment object containing
                                environmental properties relevant but external to the construction
                                activity.</documentation>
                        </annotation>
                    </element>
                    <element name="equipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>A property element that supports a value by reference
                                only. The target value is indicated in the appinfo
                                element.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherConstructionActivityProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>A reference to a Parameter object used to record
                                properties that otherwise are not included as a property of the
                                construction activity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="activityDateTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>A reference to TimeInterval object identiying the
                                date/time interval over which the entire construction activity was
                                conducted.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractEquipment" abstract="true" type="diggs:AbstractEquipmentType">
        <annotation>
            <documentation>The base type for Diggs equipment types. Derivations are objects that
                contains properties of equipment used to construct, test, or monitor objects within
                the geotechnical and geoenvironmental domains.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractEquipmentType" abstract="true">
        <annotation>
            <documentation>Base type for equipment objects used in geotechnical investigations. Includes manufacturer, model, serial number, and calibration information.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element name="class" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The class or type of equipment - eg. drill rig, CPT rig,
                                etc. Intended to come from a controlled list.</documentation>
                        </annotation>
                    </element>
                    <element name="make" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The manufacturer or brand of the
                                equipment</documentation>
                        </annotation>
                    </element>
                    <element name="modelNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The model name or number of the equipment</documentation>
                        </annotation>
                    </element>
                    <element name="serialNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The serial number that identifies the unique equipment
                                item.</documentation>
                        </annotation>
                    </element>
                    <element name="calibrationAuditTrail" type="diggs:CalibrationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>A reference to a Calibration object that stores
                                calibration information for the equipment</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherEquipmentProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>Reference to a Parameter object containing the name,
                                value or range of values and unit of measure of a
                                property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractEventType" abstract="true">
        <annotation>
            <documentation>Base type for event objects that record time-based or location-based occurrences during investigations.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The measured depth interval over which the event takes
                                place, recorded in the hole's linear referencing
                                system.</documentation>
                        </annotation>
                    </element>
                    <element name="time" type="diggs:TimeIntervalPropertyType" minOccurs="0">
                        <annotation>
                            <documentation>Date/time when this event information was
                                recorded</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="infoRecorded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>Other associated data measured or observed at this
                                time</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractFeatureBaseType" abstract="true">
        <annotation>
            <documentation>Minimal base type for DIGGS features, providing only GML description, identifier, and required gml:id.</documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractFeatureType">
                <sequence>
                    <element ref="gml:description" minOccurs="0"/>
                    <element minOccurs="0" ref="gml:identifier"/>
                </sequence>
                <attribute ref="gml:id" use="required">
                    <annotation>
                        <documentation>The id of this feature. The id must be unique within a DIGGS
                            xml instance.</documentation>
                    </annotation>
                </attribute>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractFeatureType" abstract="true">
        <annotation>
            <documentation>Standard base type for all DIGGS feature objects. Features represent identifiable real-world entities such as projects, sampling features, samples, and tests.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" maxOccurs="1" ref="diggs:internalIdentifier">
                        <annotation>
                            <documentation/>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element minOccurs="0" ref="diggs:implementationStatus"/>
                    <element name="associatedFile" type="diggs:AssociatedFilePropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AssociatedFile</appinfo>
                            <documentation>A reference to an AssociatedFile object that provides
                                information about external files or documents associated with this
                                feature. The target value is indicated in the appinfo
                                element.</documentation>
                        </annotation>
                    </element>
                    <element name="role" type="diggs:RolePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A reference to a Role object that dentifies a specific
                                role or task performed that is associated with this specific
                                feature, the person or organization that performed the role, and
                                associated time frame, if applicable..</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A reference to a Remark object that provies a comment or
                                remark associated with this specific feature.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractGroup" type="diggs:AbstractGroupType" abstract="true">
        <annotation>
            <documentation>Base type for DIGGS groups - logical associations of projects, sampling
                features, or samples</documentation>
        </annotation>
    </element>
    <complexType name="AbstractGroupType" abstract="true">
        <annotation>
            <documentation>Base type for flexible grouping of DIGGS features for organizational or analytical purposes. Groups allow logical associations of projects, sampling features, samples, or other features without establishing strict hierarchical relationships. Groups can be used to organize features by geographic area, time period, purpose, contractor, or any other organizational principle. Groups can contain mixed feature types and features can belong to multiple groups.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractProjectScopedGroup" type="diggs:AbstractProjectScopedGroupType"
        substitutionGroup="diggs:AbstractGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for project-scoped groups - the generation
                of DIGGS groups whose MEMBERS CITE THE GROUP rather than the group enumerating its
                members.

                REFERENCE DIRECTION IS THE DEFINING DIFFERENCE between this generation and the
                concrete groups that substitute diggs:AbstractGroup directly
                (diggs:SamplingFeatureGroup, diggs:GroupGroup, diggs:ProjectGroup,
                diggs:MeasurementGroup, diggs:SampleGroup - all DEPRECATED 8/26). Those hold arrays
                of references pointing down at their members, which inverts the DIGGS antecedent
                rule that a child cites its parent, and which means the group element must be
                rewritten every time a member is added - unworkable for append or streaming
                workflows at construction scale, where members arrive one at a time over months. A
                member of a group deriving from this type instead carries its own reference upward:
                diggs:samplingFeatureGroupRef, diggs:sampleGroupRef, diggs:measurementGroupRef,
                diggs:observationGroupRef or diggs:projectGroupRef, each declared on the
                corresponding family base type, and diggs:groupGroupRef for a nested group.

                WHAT A GROUP IS: a collection of related features whose information content can be
                evaluated and compared together as part of a coherent analysis - equivalently, A
                GROUP IS A FEATURE WHOSE CONTENT IS THE WARRANT FOR INTERPRETING ITS MEMBERS
                JOINTLY. A borehole and a CPT sounding treated as one dataset under a proximity
                assumption form a group because the group carries that assumption
                (diggs:BoreholeCPTPair); two boreholes that merely happen to sit on the same site do
                not. This is what makes Group a real classification rather than a label, and it is
                the test to apply before adding a concrete group type.

                MEMBER TYPE AND MEMBER COUNT ARE NOT SCHEMA-ENFORCEABLE under reverse referencing.
                XSD cannot constrain the type of a referenced element - not through xlink:href, not
                through keyref - so which feature kinds a given concrete group admits, and how many
                of each, is a context-validation concern driven from a dictionary rather than
                something this hierarchy can express. Only containment gives schema-enforced target
                typing, and containment is exactly what reverse referencing gives up in order to be
                append-safe. The typed heads below narrow the intent as far as XSD allows: they
                state which FAMILY a group belongs to, and each family's *GroupRef element is
                declared only on that family's own base type.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectScopedGroupType" abstract="true">
        <annotation>
            <documentation>Base type for project-scoped groups. Adds the project association that
                diggs:AbstractGroupType cannot supply, plus optional program-module references and a
                group-nesting reference.

                WHY THIS TYPE EXISTS RATHER THAN A CHANGE TO diggs:AbstractGroupType.
                diggs:AbstractFeatureType carries no projectRef, and diggs:AbstractGroupType extends
                it with an empty sequence, so A GROUP CANNOT STATE WHICH PROJECT IT BELONGS TO. That
                becomes blocking the moment a feature which today inherits mandatory projectRef from
                diggs:AbstractSamplingFeatureType is reclassified as a group - diggs:
                RigidInclusionSystem is the first such case. The obligation is added here, on a new
                type, rather than to diggs:AbstractGroupType, so that instances of the released
                concrete groups are unaffected BY CONSTRUCTION: the backward-compatibility question
                disappears rather than being managed.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <sequence>
                    <element ref="diggs:projectRef" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The project or projects this group belongs to. Mandatory,
                                with the same [1..*] cardinality diggs:AbstractSamplingFeatureType
                                states for its own projectRef - so a feature reclassified from a
                                sampling feature to a group neither gains nor loses the obligation to
                                name its project.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this
                                group was realized to satisfy - for example the system design that
                                planned the treated area a realized group of columns now occupies.
                                Declared once here rather than per family, because every
                                project-scoped group plausibly wants it.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects
                                this group must satisfy.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:groupGroupRef">
                        <annotation>
                            <documentation>Zero or more references to project-scoped groups this
                                group is itself a member of - group nesting, stated in the same
                                member-cites-group direction as every other reference in this
                                generation, and named for its class on the same rule as every other
                                reference in this family.

                                NOT diggs:groupRef, which is an existing released element meaning the
                                REVERSE: a group pointing down at its member groups, held by
                                diggs:GroupGroupType. Reusing that name here would invert the
                                meaning of a released element, which is the precise defect this
                                generation exists to remove.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSamplingFeatureGroup" type="diggs:AbstractSamplingFeatureGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for groups whose members are sampling
                features. Members join by carrying diggs:samplingFeatureGroupRef, declared on
                diggs:AbstractSamplingFeatureType.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingFeatureGroupType" abstract="true">
        <annotation>
            <documentation>Base type for groups of sampling features. Adds the group's spatial
                extent.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType">
                <sequence>
                    <element minOccurs="0" name="extent" type="diggs:SurfacePropertyType">
                        <annotation>
                            <documentation>The area over which this group acts, or within which its
                                members lie.

                                AN EXTENT, NOT A REFERENCE POINT - and that distinction is why the
                                group classification exists at all. diggs:AbstractSamplingFeatureType
                                MANDATES referencePoint, because a borehole, a pile or a sounding has
                                a definite position. A treated area, a monitoring network or a paired
                                investigation has no meaningful single position; being forced to
                                invent one is the schema saying the feature was classified wrongly.
                                Groups state where they are by extent instead.

                                Optional, because a group need not be spatially delimited at all - a
                                borehole/CPT pair is defined by the proximity of its two members
                                rather than by a polygon drawn around them.

                                Two-dimensional. Elevation is not meaningful for a group extent;
                                where a member-level or system-level elevation matters it is carried
                                by the member, or by an explicit elevation property on the concrete
                                group type.

                                WHERE A CONCRETE GROUP ALSO CARRIES A SCALAR AREA, THE GEOMETRY
                                PREVAILS - the established DIGGS convention for a convenience scalar
                                sitting alongside the geometry it summarizes.

                                MAY BE STATED INLINE OR BY REFERENCE. diggs:SurfacePropertyType has
                                an optional content model and carries gml:AssociationAttributeGroup,
                                so this extent may be cited with xlink:href rather than given inline.
                                Where a group extent genuinely coincides with a member's
                                featureExtent, one of the two should hold the polygon and the other
                                reference it - which one is an authoring choice, since neither is the
                                other's antecedent; what matters is that the same coordinates are not
                                written twice, because two copies can be edited apart.

                                DO NOT ASSUME THEY COINCIDE, THOUGH. An earlier version of this
                                documentation offered a diggs:RITreatedArea standing for the footprint
                                of a diggs:RigidInclusionSystem as the canonical case of exactly that
                                sharing. It is in fact a counter-example, and instructive: a group's
                                members routinely include features lying OUTSIDE the area the group
                                is nominally about - exploratory boreholes drilled beyond the
                                ground-improvement footprint to characterize it are the standard case
                                - so the group extent must enclose them while the treated area must
                                not. The two polygons are different by construction, and referencing
                                one from the other would assert a false identity. Coincidence is a
                                fact to be checked per instance, never a default.

                                See featureExtent (extended/ExtSamplingFeatures.xsd) for the general
                                form of this convention, and diggs:ProgramScope/zoneExtent for the
                                design-side case, where antecedence does settle the direction.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSampleGroup" type="diggs:AbstractSampleGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for groups whose members are samples.
                Members join by carrying diggs:sampleGroupRef, declared on diggs:AbstractSampleType.

                NOTE THIS HEAD RESTORES A CAPABILITY 3.0.0 DID NOT ACTUALLY HAVE. The released
                diggs:SampleGroup is typed diggs:SampleGroupType, which holds measurementRef rather
                than sampleRef; the only type that would have grouped samples,
                diggs:MeasurementGroupType, is referenced by no element at all. There has therefore
                been no way to group samples in DIGGS since 3.0.0. No concrete type substitutes this
                head yet - add one when a real use appears.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractSampleGroupType" abstract="true">
        <annotation>
            <documentation>Base type for groups of samples. Adds nothing beyond
                diggs:AbstractProjectScopedGroupType; it exists to give diggs:sampleGroupRef a family
                to target.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractMeasurementGroup" type="diggs:AbstractMeasurementGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for groups whose members are measurements -
                tests, material tests and monitors. Members join by carrying
                diggs:measurementGroupRef, declared on diggs:AbstractMeasurementType. No concrete
                type substitutes this head yet.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractMeasurementGroupType" abstract="true">
        <annotation>
            <documentation>Base type for groups of measurements. Adds nothing beyond
                diggs:AbstractProjectScopedGroupType; it exists to give diggs:measurementGroupRef a
                family to target.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractObservationGroup" type="diggs:AbstractObservationGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for groups whose members are observation
                systems - ground models, logs and other interpreted characterizations. Members join
                by carrying diggs:observationGroupRef, declared on
                diggs:AbstractObservationSystemType. No concrete type substitutes this head yet.

                PARALLELS diggs:AbstractMeasurementGroup, and exists for the same reason. An
                observation system and a measurement are the two feature classes that produce
                interpretable statements about the ground, and several of either may only be
                meaningful read together - two ground models of the same site built on different
                assumptions, or a set of logs forming one cross-section.

                Named to match diggs:observationGroupRef rather than the abstract feature head
                diggs:AbstractObservationSystem, so that a group's contract stays derivable from the
                referencing element's name by pattern. DIGGS names this class inconsistently already:
                the document slot is diggs:Diggs/observation while the head is
                diggs:AbstractObservationSystem, the one feature class where the two differ. The
                reference and the group head here both follow the slot.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractObservationGroupType" abstract="true">
        <annotation>
            <documentation>Base type for groups of observation systems. Adds nothing beyond
                diggs:AbstractProjectScopedGroupType; it exists to give diggs:observationGroupRef a
                family to target.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractProjectGroup" type="diggs:AbstractProjectGroupType"
        substitutionGroup="diggs:AbstractProjectScopedGroup" abstract="true">
        <annotation>
            <documentation>Head of the substitution group for groups whose members are projects.
                Members join by carrying diggs:projectGroupRef, declared on diggs:AbstractProjectType.
                No concrete type substitutes this head yet.

                THE NAME IS NOT A SYNONYM FOR diggs:AbstractProjectScopedGroup. This is a group OF
                projects; that is any group belonging TO a project. A group of projects still carries
                the mandatory projectRef it inherits - naming the project under whose business the
                grouping is asserted - which is a different statement from the membership its
                diggs:projectGroupRef-carrying members make.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectGroupType" abstract="true">
        <annotation>
            <documentation>Base type for groups of projects. Adds nothing beyond
                diggs:AbstractProjectScopedGroupType; it exists to give diggs:projectGroupRef a family
                to target.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectScopedGroupType"/>
        </complexContent>
    </complexType>
    <element name="AbstractInsituTestProcedure" type="diggs:AbstractInsituTestProcedureType"
        substitutionGroup="diggs:AbstractTestProcedure" abstract="true">
        <annotation>
            <documentation>Base type for insitu test procedure objects.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractInsituTestProcedureType">
        <annotation>
            <documentation>Base type for in-situ test procedures performed at sampling features without removing specimens.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent" type="diggs:InSituTestEventPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A test event is a time-based or location-based recording
                                of instantaneous conditions or parameters associated with an in-situ
                                test, such as casing depth, water level, or any custom parameters.
                                This property holds one or more Event objects; Event objects are
                                associated with the type of sampling feature that the in-situ test
                                is performed in. For example, for a standard penetration test
                                performed in a borehole, a BoreholeEvent object would be used in the
                                testEvents property to record the depth to water at various times
                                during the test.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLoadTestProcedure" type="diggs:AbstractLoadTestProcedureType"
        substitutionGroup="diggs:AbstractInsituTestProcedure" abstract="true">
        <annotation>
            <documentation>Abstract head for a load test applied directly to a deep foundation
                element or foundation system - static, rapid or dynamic. Serves the axial
                compressive load-test family (S27): diggs:StaticLoadTest, diggs:RapidLoadTest and
                diggs:DynamicLoadTest, all declared in extended/ExtProcedures.xsd.

                NOT RI-SPECIFIC. A static load test on a driven pile, a drilled shaft and a rigid
                inclusion is the same procedure - this head and its concrete members live in the
                generic insitu-test-procedure cluster for that reason, the same placement decision
                already made for diggs:PressuremeterTest and diggs:PumpingTest in this file's
                neighbourhood.

                THIS HEAD IS DELIBERATELY STANDARD-NEUTRAL, AND THAT IS THE POINT. The same physical
                test is governed by more than one standard depending on jurisdiction and specialty
                practice, and DIGGS does not model a separate procedure type per standard - the
                inherited diggs:AbstractTestProcedureType/testProcedureMethod
                (diggs:SpecificationPropertyType, [0..*]) is what cites which standard(s) govern a
                given instance, and it is already repeatable so more than one can be cited at once
                (e.g. an ASIRI-governed rigid-inclusion test executed to EN ISO 22477-1). For the
                static case specifically: ASTM D1143/D1143M ("Standard Test Methods for Deep
                Foundation Elements Under Static Axial Compressive Load") and EN ISO 22477-1
                ("Testing of piles: static compression load testing") describe the same test with
                different vocabulary and, in one respect, different scope - ISO 22477-1 covers only
                the maintained-load method and explicitly excludes the constant-rate-of-penetration
                and cyclic variants ASTM permits as options. ASIRI (2012), the rigid-inclusion
                recommendations most RI projects cite, predates EN ISO 22477-1 (2018) and was
                written against its predecessor, the now-withdrawn NF P94-150-1; current French/
                European practice has since migrated to EN ISO 22477-1 for the same test. This head
                and StaticLoadTest's own loadingProcedure vocabulary are built to carry either
                tradition without forcing a choice between them - see StaticLoadTest's own
                documentation.

                What every load test shares, and is carried here: the reference system used to
                measure displacement (referenceSystem), the peak load reached (maxTestLoad), and the
                load increments actually applied (increment, [0..*] diggs:LoadTestIncrement
                objects) - loading and hold criteria differ enough between the static, rapid and
                dynamic cases that increment is expected to be sparsely used, or not used at all, on
                the latter two; see diggs:RapidLoadTestType/pulseDuration and
                diggs:DynamicLoadTestType/hammerEnergy for their own single-event characterisation
                instead.

                THE REACTION SYSTEM DELIBERATELY HAS NO FIELD HERE. def's equipmentClass.xml already
                carries load_test_reaction_frame and hydraulic_jack, consumed through the inherited
                diggs:AbstractTestProcedureType/testProcedureEquipment
                ([0..*] diggs:EquipmentPropertyType) - a coded reactionSystem element on this type
                would duplicate that existing mechanism rather than fill a gap.

                THE TEST RESULTS ARE NOT CARRIED HERE EITHER. The load-settlement curve, capacity,
                and any other measured or derived value belong on diggs:Test/outcome's ResultSet,
                exactly as every other insitu test already reports its results - this head and its
                members describe how the test was run, not what it measured.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractLoadTestProcedureType">
        <annotation>
            <documentation>Base type for diggs:AbstractLoadTestProcedure. See the element's own
                documentation for the full rationale.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="referenceSystem" type="gml:CodeType">
                        <annotation>
                            <documentation>How the movement measured during the test was
                                referenced - e.g. an independent reference beam, optical survey, or
                                satellite positioning. Both ASTM D1143 and EN ISO 22477-1 require the
                                reference system to be independent of the reaction system and
                                unaffected by ground movement caused by the test itself; this element
                                records which arrangement satisfied that requirement, it does not
                                assert that it did.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxTestLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>The maximum load reached during the test. A summary
                                value, independent of and not necessarily derived from the individual
                                increment elements below - a test recorded without a full
                                increment-by-increment schedule can still state its peak
                                load.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="increment"
                        type="diggs:LoadTestIncrementPropertyType">
                        <annotation>
                            <documentation>The load increments applied during the test, in
                                sequence. Optional and repeatable: a static test recorded with a full
                                loading schedule will have several, a rapid or dynamic test - a
                                single pulse or blow rather than a staged sequence - will typically
                                have none. See diggs:LoadTestIncrementType (extended/ExtProcedures.xsd)
                                for what each increment carries, including the two alternative
                                hold-criterion fields that let one type serve both the fixed-duration
                                hold ASTM's Quick Test uses and the movement-rate-stabilization hold
                                EN ISO 22477-1's maintained-load method requires.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLaboratoryTestProcedure" type="diggs:AbstractLaboratoryTestProcedureType"
        substitutionGroup="diggs:AbstractTestProcedure" abstract="true">
        <annotation>
            <documentation>Base type for laboratory test procedure objects. A laboratory test
                procedure is performed on a specimen derived from a sample that was collected from a
                samplingFeature, and therefore the sample's location is known and relates to a
                geographic feature of interest. Use of a laboratory test procedure within a Test
                object does not require that information about the specific sample or specimen is
                known, only that the source location of the sample is known or recorded. This allows
                results of a test to be transferred without specific information about the sample or
                specimen.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractLaboratoryTestProcedureType" abstract="true">
        <annotation>
            <documentation>Base type for laboratory test procedures performed on specimens removed from sampling features.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent"
                        type="diggs:LaboratoryTestEventPropertyType">
                        <annotation>
                            <documentation>An property that contains an object that records an event
                                observed during a laboratory test. This object is a concrete
                                representation of AbstractEvent with no additional
                                properties.</documentation>
                        </annotation>
                    </element>
                    <element name="specimen" type="diggs:SpecimenPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A property that contains a specialization of
                                AbstractSpecimen that describes the properties for a specimen used
                                in the test procedure. </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractLinearSamplingFeature" type="diggs:AbstractLinearSamplingFeatureType"
        substitutionGroup="diggs:AbstractSamplingFeature" abstract="true">
        <annotation>
            <documentation>Base type for a sampling feature with a linear geometry (eg. sounding or
                borehole). </documentation>
        </annotation>
    </element>
    <complexType name="AbstractLinearSamplingFeatureType" abstract="true">
        <annotation>
            <documentation>Base type for sampling features with linear (1D) geometries including
                boreholes and trenches.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureType">
                <sequence>
                    <element name="centerLine" type="diggs:LinearExtentPropertyType"
                        maxOccurs="unbounded" minOccurs="1">
                        <annotation>
                            <documentation>A reference to a LinearExtent object that represents the
                                linear geometry of the feature, defining its shape and location. For
                                a borehole for example, the linestring would represent the
                                borehole's trajectory in 3D space. Multiple centerlines can be
                                defined (all associated with the same reference point) to define
                                complex objects such as a wellbore with sidetracks, or different
                                reference datums for a single borehole.</documentation>
                        </annotation>
                    </element>
                    <element name="linearReferencing"
                        type="diggs:LinearSpatialReferenceSystemPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A reference to a LinearSpatialReferenceSystem object for
                                this sampling feature. A linear SRS allows other objects to
                                reference their position (location) on the sampling feature with 1D
                                coordinates that represents distance along the linear sampling
                                feature, typically from the centerline origin. For sampling features
                                such as boreholes the linear SRS coordinates define measured depths
                                down the hole's centerline.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plunge" type="diggs:PlungeMeasureType">
                        <annotation>
                            <documentation>For an inclined feature, the plunge angle, measured from
                                the horizontal, positive up</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearing" type="diggs:BearingMeasureType">
                        <annotation>
                            <documentation>For an inclined feature, the direction of plunge,
                                positive clockwise from the reference azimuth, as expressed in the
                                refAzimuth attribute.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractLinearInstallation"
        substitutionGroup="diggs:AbstractSamplingFeature" type="diggs:AbstractLinearInstallationType">
        <annotation>
            <documentation>Abstract element for linear installations within sampling features.
                Serves as the head of the substitution group for linear installation
                types.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractLinearInstallationType">
        <annotation>
            <documentation>Base type for linear installations within sampling features such as
                instrumentation strings or casing.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element ref="diggs:samplingFeatureRef"/>
                    <element minOccurs="0" name="installationConstructionEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the occurrence and activities involved
                                during construction of the installation within the sampling
                                feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="installationEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation> Equipment used to install the point installation.
                                References the machinery, tools, or devices employed during
                                installation of the monitoring point or instrumentation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractMaterialTestProcedurePropertyType">
        <annotation>
            <documentation>Property type wrapper for AbstractMaterialTestProcedure elements. This type enables AbstractMaterialTestProcedure to be used as a property in other types, following the GML property pattern. The property type provides a container that can hold a reference to a MaterialTestProcedure element defined elsewhere in the document or include the element inline.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:AbstractMaterialTestProcedure" minOccurs="0"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <element abstract="true" name="AbstractMaterialTestProcedure"
        substitutionGroup="diggs:AbstractTestProcedure"
        type="diggs:AbstractMaterialTestlProcedureType">
        <annotation>
            <documentation>Base type for all test procedures performed only on manufactured samples
                -eg. those that are created by aggregation of other samples or materials and where
                the sample has no location relevance. Material test procedures must reference or
                describe the samples and/or specimens upon which the test is performed. This
                category was developed for test procedures developed for characterizing grout
                samples but could be used for other types of samples where the results of the
                procedure relate to the characteristics of the sample only, and does not relate to
                the properties of a geographic feature of interest</documentation>
        </annotation>
    </element>
    <complexType name="AbstractMaterialTestlProcedureType" abstract="true">
        <annotation>
            <documentation>Base type for all laboratory test procedures performed on manufactured material samples (as opposed to field-collected samples). Material tests include procedures on grout, concrete, slurry, and other engineered materials. These tests differ from standard laboratory tests in that they are performed on specially prepared specimens rather than samples extracted from a sampling feature.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testEvent"
                        type="diggs:LaboratoryTestEventPropertyType"/>
                    <choice>
                        <annotation>
                            <documentation>Event that occurred during the laboratory material test. Records time-based observations, environmental conditions, or procedural notes made during test execution on manufactured material specimens.</documentation>
                        </annotation>
                        <element maxOccurs="unbounded" minOccurs="1" ref="diggs:sampleRef"/>
                        <element maxOccurs="unbounded" minOccurs="1" name="specimen"
                            type="diggs:SpecimenPropertyType"/>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractMeasurement" type="diggs:AbstractMeasurementType">
        <annotation>
            <documentation>Base type for measurement features - tests or monitoring activities that
                record quantitative information in the context of a sampling feature or
                sample.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractMeasurementType" abstract="true">
        <annotation>
            <documentation>Base type for all measurements and quantitative testing procedures. Measurements include in-situ tests, laboratory tests, and monitoring activities that produce quantitative data. This abstract type is extended by Test (in-situ procedures), MaterialTest (laboratory procedures on samples), and Monitor (continuous or periodic monitoring) types.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef" maxOccurs="1"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this
                                measurement was realized to satisfy - for example a
                                TargetMeasurement (S7). A measurement may cite more than one design
                                where multiple planning strands govern different aspects of
                                it.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects
                                this measurement must satisfy - for example the acceptance criterion
                                it is evidence for.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:samplingFeatureRef" maxOccurs="unbounded"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:sampleRef"/>
                    <element minOccurs="0" ref="diggs:constructionActivityRef"/>
                    <element minOccurs="0" name="otherMeasurementProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>This will typically be used to record environmental
                                parameters, or event-specific parameters that are not tightly bound
                                to either the earth materials for which properties are being
                                estimated, or the procedure. Parameters that are tightly bound to
                                the procedure should be encoded within the procedure
                                object.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:measurementGroupRef">
                        <annotation>
                            <documentation>Zero or more references to measurement groups this
                                measurement is a member of - for example a set of tests interpreted
                                together as one monitoring campaign. The member cites the group; see
                                diggs:AbstractProjectScopedGroup.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedFeatureType" abstract="true">
        <annotation>
            <documentation>Feature type emphasizing naming through multiple gml:name elements.</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element minOccurs="0" ref="diggs:internalIdentifier">
                            <annotation>
                                <documentation>The value of this property is the identifier
                                    originally created by the authority for this feature, or that is
                                    used as the identifier in the authority's internal data
                                    management system. There is no assumption as to the unique scope
                                    or persistence of this identifier. In cases where the original
                                    or internal identifier does not meet the semantic requirements
                                    for gml:id or gml:identifier, the internal identifier may be
                                    included in this property in order for the originating authority
                                    to "map back" the identifier to an internal data management
                                    system. The codeSpace attribute must be populated to identify
                                    the authority that uses the internalIdentifier
                                    value.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" ref="diggs:implementationStatus"/>
                        <element maxOccurs="unbounded" minOccurs="0" name="associatedFile"
                            type="diggs:AssociatedFilePropertyType">
                            <annotation>
                                <documentation>Identifies external files associated with this
                                    feature. This allows for the feature to be further elaborated
                                    with information that cannot be represented by ASCII text, such
                                    as a photograph or other media, binary data, or a formatted
                                    report.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="role"
                            type="diggs:RolePropertyType">
                            <annotation>
                                <documentation>Identifies a specific role or task performed that is
                                    associated with this specific feature, the person or
                                    organization that performed the role, and associated time frame,
                                    if applicable.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>Any comment or remark associated with this specific
                                    feature.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedObjectType" abstract="true">
        <annotation>
            <documentation>Component object type emphasizing naming through multiple gml:name elements.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element ref="gml:name" minOccurs="1" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:status">
                        <annotation>
                            <documentation>A text string to provide information about the status of
                                the object to be used to track QA/QC controls, review or release
                                status, etc. The values used are intended to come from a controlled
                                list of terms maintained by an organization.</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Any comment or remark associated with this specific
                                object.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbstractNamedRoleObjectType">
        <annotation>
            <documentation>Specialized object type for entities that perform roles such as personnel or organizations.</documentation>
        </annotation>
        <complexContent>
            <restriction base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <sequence>
                        <element minOccurs="0" ref="gml:description"/>
                        <element minOccurs="0" ref="gml:identifier"/>
                    </sequence>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="1" ref="gml:name"/>
                        <element minOccurs="0" ref="diggs:status">
                            <annotation>
                                <documentation>A text string to provide information about the status
                                    of the object to be used to track QA/QC controls, review or
                                    release status, etc. The values used are intended to come from a
                                    controlled list of terms maintained by an
                                    organization.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="role"
                            type="diggs:RolePropertyType">
                            <annotation>
                                <documentation>Identifies a specific role or task performed that is
                                    associated with this specific feature, the person or
                                    organization that performed the role, and associated time frame,
                                    if applicable.</documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" minOccurs="0" name="remark"
                            type="diggs:RemarkPropertyType">
                            <annotation>
                                <documentation>Any comment or remark associated with this specific
                                    feature.</documentation>
                            </annotation>
                        </element>
                    </sequence>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="AbstractObjectType" abstract="true">
        <annotation>
            <documentation>Standard base type for DIGGS component objects such as specifications, parameters, and materials.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectBaseType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:name"/>
                    <element minOccurs="0" ref="diggs:status">
                        <annotation>
                            <documentation>A text string to provide information about the status of
                                the object to be used to track QA/QC controls, review or release
                                status, etc. The values used are intended to come from a controlled
                                list of terms maintained by an organization.</documentation>
                        </annotation>
                    </element>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractObservationSystem"
        type="diggs:AbstractObservationSystemType">
        <annotation>
            <documentation>A system of zones or regions associated with a sampling feature or sample
                for which a single class of qualitative description is assigned (eg. lithology,
                color, discontinuity, etc.)</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractObservationSystemType">
        <annotation>
            <documentation>Base type for observation systems contain qualitative or category observational data</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <choice minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>What this observation system was made along or from -
                                zero, one, or many sampling features or samples, in any
                                combination. Relaxed from a mandatory single choice (S10; RI_Program_
                                Architecture.md §6.3(a)): the original exactly-one-of assumed every
                                observation system is an interpretation ALONG one feature - a log
                                down one borehole. A ground model (diggs:GeoUnitSystem, and by
                                extension every AbstractObservationSystemType descendant, since this
                                choice is inherited rather than overridden per subtype) is instead
                                synthesized FROM many features - an interpretation over a volume,
                                with nothing correct to put in a single mandatory slot. Repeating
                                samplingFeatureRef also lets the system record its own provenance:
                                "this model was built from these fourteen borings" is itself
                                evidence a design basis should be able to state, not merely
                                permitted content. Zero occurrences remains valid for a model with no
                                honest anchor at all - the case architecture §6.3(a) calls out for a
                                project with no site-spanning feature to hang off
                                honestly.</documentation>
                        </annotation>
                        <element ref="diggs:samplingFeatureRef"/>
                        <element ref="diggs:sampleRef"/>
                    </choice>
                    <element minOccurs="0" name="observationProcedure"
                        type="diggs:SpecificationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>A property containing a Specification object that
                                describes the method used for all of the observations contained
                                within this ObservationSystem. Where procedures vary among
                                individual observations, use appropriate properties and attributes
                                within the various observation objects to describe the approach
                                used.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:observationGroupRef">
                        <annotation>
                            <documentation>Zero or more references to observation groups this
                                observation system is a member of - for example a set of ground
                                models or logs interpreted together. The member cites the group; see
                                diggs:AbstractProjectScopedGroup.

                                DISTINCT FROM THE samplingFeatureRef/sampleRef CHOICE ABOVE, which is
                                provenance - the features this system was interpreted FROM. This
                                element is membership: the other observation systems this one is read
                                ALONGSIDE. A ground model built from fourteen borings states that
                                through the choice; a ground model that is one of three competing
                                interpretations of the same site states that here.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType abstract="true" name="AbstractObservationType">
        <annotation>
            <documentation>The base type for all descriptions, which extend this
                type</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectNoDescriptionType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:measurementRef">
                        <annotation>
                            <appinfo>diggs:Test</appinfo>
                            <appinfo>diggs:Monitor</appinfo>
                            <appinfo>diggs:MaterialTest</appinfo>
                            <documentation>If the description derives from a measurement, then this
                                element can be optionally used to point to the subject Test,
                                Materia;Test or Monitor feature via the xlink:href
                                attribute</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The location of the description. If not used, observation
                                pertains to the entire sample or sampling feature that is the target
                                of this observation</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trueTopObserved" type="boolean">
                        <annotation>
                            <documentation>True or false, indicating whether the geometry of the
                                uppermost position of the zone represents the true top of the
                                feature being defined (true) or (false) whether the top represents
                                the upper extent of the zone that is described by the extent of the
                                sampling feature itself.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trueBaseObserved" type="boolean">
                        <annotation>
                            <documentation>True or false, indicating whether the geometry of the
                                lowermost position of the zone represents the true base of the
                                feature being defined (true) or (false) whether the base represents
                                the lower extent of the zone that is defined by the extent of the
                                sampling feature itself.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>A value that describes the method by which the observation or
                            measurement was determined. </documentation>
                    </annotation>
                </attribute>
                <attribute name="stratumCode" type="string">
                    <annotation>
                        <documentation>A legacy attribute to support AGS trial pit sampling features
                            where observations of different stratum may occur at the same depth in a
                            pit. It is a reference letter or number whose sole purpose is to link
                            the stratum shown on a face sketch of the trial pit to the specific
                            observation. </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractProcedureTrial" type="diggs:AbstractProcedureTrialType" abstract="true">
        <annotation>
            <documentation>Base type for procedure trial - activities that are repeated as part of a
                test procedure.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractProcedureTrialType" abstract="true">
        <annotation>
            <documentation>Base type for individual trials or repetitions within a test procedure. Many test procedures involve multiple trials (e.g., multiple readings, repeat measurements, or staged loading sequences). Each trial represents a discrete execution of the test methodology, and the trial results can be aggregated or analyzed to produce the final test result. Common examples include multiple blows in a Standard Penetration Test or repeated readings in a laboratory consolidation test.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherProperty"
                        type="diggs:ParameterPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProcedure" type="diggs:AbstractProcedureType">
        <annotation>
            <documentation>Abstract element for procedures used in investigations. Serves as the head of the substitution group for procedure types.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProcedureType">
        <annotation>
            <documentation>Base type for all procedure objects. Procedures define methods, standards, and specifications for conducting activities within DIGGS. This includes test procedures (how tests are conducted), sampling procedures (how samples are collected), monitoring procedures (how sensors collect data), and other methodological specifications. Procedures can reference published standards (e.g., ASTM, ISO) or describe custom methods specific to a project.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramBasis" type="diggs:AbstractProgramBasisType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>Abstract element for program bases. Serves as the head of the
                substitution group for the objects a design was prepared FROM - ground models,
                requirement sets, governing standards, calculation inputs. A basis is evidence, not
                intent and not constraint: it is what the designer relied on, and it is cited by a
                design through basisRef.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramBasisType">
        <annotation>
            <documentation>Base type for program basis features. Adds nothing to
                diggs:AbstractProgramModuleType: a basis is distinguished by being a separate
                substitution-group head, which is what lets basedOnRef chains stay within a kind and
                what lets basisRef name a single target. Concrete bases add their own
                content.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType"/>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramDesign" type="diggs:AbstractProgramDesignType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>Abstract element for program designs. Serves as the head of the substitution group for program design types.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramDesignType">
        <annotation>
            <documentation>Base type for program design specifications that define the planned characteristics and requirements for a program of work. Program designs typically specify target parameters, acceptance criteria, testing frequencies, quality control measures, and other requirements that guide program execution. Design specifications can be compared with actual program implementation to track compliance and identify deviations.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to the specifications this design
                                was prepared to satisfy. Design-to-specification is a different
                                relationship from basedOnRef and is carried here so that inheritance
                                up the basedOnRef chain does not silently pull constraint into the
                                intent chain.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:basisRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramModule" type="diggs:AbstractProgramModuleType">
        <annotation>
            <documentation>Abstract element serving as the common ancestor of the three kinds of
                object a program issues or relies on: designs (intent), specifications (constraint)
                and bases (evidence). It exists to declare, once, the two properties all three
                share - scope and basedOnRef - and to give basedOnRef a single abstract target to
                name. It is not itself a substitution group member of anything, and no object
                substitutes it directly; instances substitute one of the three heads below
                it.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramModuleType">
        <annotation>
            <documentation>Base type for program modules - the designs, specifications and bases a
                program issues or relies on. Carries only what all three share.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element minOccurs="0" name="scope" type="diggs:ProgramScopePropertyType">
                        <annotation>
                            <documentation>The population of features this module applies to,
                                declared prospectively by geometry or feature type rather than by
                                enumerating realized features. Where absent, the module applies to
                                the whole program, or inherits a scope through
                                basedOnRef.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:basedOnRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgramSpecification"
        type="diggs:AbstractProgramSpecificationType"
        substitutionGroup="diggs:AbstractProgramModule">
        <annotation>
            <documentation>Abstract element for program specifications. Serves as the head of the
                substitution group for specification types - the requirements a program issues, such
                as tolerances, acceptance limits and performance criteria, each carrying the scope
                of features over which it applies. A realized feature declares which of these govern
                it through diggs:programSpecificationRef; a design declares which it was prepared to
                satisfy through the same property.
                
                NOT TO BE CONFUSED WITH diggs:Specification (core/Common.xsd), which since the
                correction of this element's name differs from it by a single word. The two are
                different kinds of thing:
                
                - diggs:AbstractProgramSpecification, here, is a FEATURE HEAD. Its members are
                features - independently identified, referenceable, and issued by a program. They
                state requirements, and since they substitute diggs:AbstractProgramModule they
                also carry scope and basedOnRef.
                
                - diggs:Specification is a COMPONENT OBJECT, and specifically a procedure
                substituting diggs:AbstractProcedure. It exists to CITE a published standard -
                its properties are standardReferenceNumber, standardTitle, standardVersion and so
                on - and it states no requirement of its own. It is held by
                diggs:SpecificationPropertyType wherever a feature records the method it
                followed.
                
                A program specification will commonly cite a diggs:Specification for the test method
                by which conformance is to be measured; the two are complementary rather than
                alternatives.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramSpecificationType">
        <annotation>
            <documentation>Base type for detailed program specifications that define technical requirements and acceptance criteria. Specifications typically reference specific standards (e.g., ASTM, AASHTO), specify numerical acceptance criteria, define testing methods and frequencies, and establish quality control requirements. Unlike designs, specifications are typically contractual documents that establish enforceable requirements for program execution.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramModuleType"/>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProgram" type="diggs:AbstractProgramType">
        <annotation>
            <documentation>This feature serves as the head of a substitution group for program features that contain properties about the design and specifications for a collection of planned activities and observations associated with a project. These include properties that define the planning and specifications for both exploration efforts and construction activities.
</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractProgramType">
        <annotation>
            <documentation>The base type for all programs, which extend this type</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element minOccurs="1" ref="diggs:projectRef" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The location of the description</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractProject" type="diggs:AbstractProjectType">
        <annotation>
            <documentation>Abstract element serving as the head of the substitution group for all project types. A Project represents an organizational unit that contains one or more sampling features, samples, and associated data. Projects typically correspond to specific geographical locations or engineering studies. All DIGGS data must be associated with a project, which provides the organizational context for the investigation.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractProjectType" abstract="true">
        <annotation>
            <documentation>Base type for projects that organize investigations with defined scope, location, and time frame.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element name="referencePoint" type="diggs:PointLocationPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Defines the location of the project (usually a location
                                at the ground surface) within a well-known 3D CRS or combined CRS
                                (geographic or projected, and elevation), as an extension of
                                gml:Point object with an additional uncertainty property
                            </documentation>
                        </annotation>
                    </element>
                    <element name="linearExtent" type="diggs:LinearExtentPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Defines a project geometry that may be defined as a line
                                in geographic or projected space and contains a LinearExtent
                                geometry object. </documentation>
                        </annotation>
                    </element>
                    <element name="arealExtent" type="diggs:SurfacePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Defines a project geometry that represents the areal
                                extent of a project in geographic or projected space and contains a
                                surface geometry object.</documentation>
                        </annotation>
                    </element>
                    <element name="projectDateTimeSpan" type="diggs:TimeIntervalPropertyType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The interval of time during which the project was
                                active.</documentation>
                        </annotation>
                    </element>
                    <element name="locality" type="diggs:LocalityPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Contains either a Locality object or a PointLocation
                                object that describes, repectively, the non-coordinate or coordinate
                                location of the project. If only one locality property exists for
                                the project, referencePoint should be used to desccribe the
                                coordinate location for the project instead of the PointLocation
                                object.</documentation>
                        </annotation>
                    </element>
                    <element name="purpose" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>A string descxribing the purpose for the project. This is
                                intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="projectEvent"
                        type="diggs:ProjectEventPropertyType">
                        <annotation>
                            <documentation>Contains a ProjectEvent property describing the
                                occurrence of a time or location related event associated with a
                                project.</documentation>
                        </annotation>
                    </element>
                    <element name="contract" type="diggs:ContractPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Contains a Contract object that describes the properties
                                of a business contract associated with the project. </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherProjectProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>Contains a Parameter object used to describe the name and
                                value of a project property not otherwise explicitly defined in the
                                schema.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:projectGroupRef">
                        <annotation>
                            <documentation>Zero or more references to project groups this project is a
                                member of. The member cites the group; see
                                diggs:AbstractProjectScopedGroup.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSample" type="diggs:AbstractSampleType">
        <annotation>
            <documentation>Base object and Abstract head of a substitution group for all material
                samples. </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSampleType" abstract="true">
        <annotation>
            <documentation>Base type for all sample objects. A sample represents physical material collected from a sampling feature during a sampling activity. Samples are the fundamental link between field investigations (sampling features) and laboratory testing (specimens and material tests). Samples maintain information about their collection location, parent sampling feature, collection method, and physical characteristics. Samples can be subdivided into specimens for laboratory testing or aggregated from multiple source samples.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element name="projectRef" type="diggs:FeatureReferenceType" minOccurs="1">
                        <annotation>
                            <documentation>Reference to the project that this sample is associated with. Every sample must be associated with a project, which provides the organizational and geographical context for the sample. This reference links the sample to its parent project, enabling queries and organization by project.</documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:samplingActivityRef"/>
                    <element minOccurs="0" ref="diggs:programRef">
                        <annotation>
                            <documentation>A reference to the program this sample is associated
                                with. Added here (S7) - diggs:AbstractSampleType never carried
                                programRef, unlike every other realized-object head. OVERRIDE/
                                FALLBACK RULE: where stated directly here, this is the authoritative
                                program for the sample; where absent, the program is inherited by
                                walking samplingActivityRef to the sampling activity and reading
                                its own programRef. State this element directly only where the
                                sample's program genuinely differs from its sampling activity's -
                                for example a sample re-tested under a later, separate testing
                                program.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this
                                sample was collected to satisfy (S7) - for example a TargetSample.
                                Same override/fallback precedence as programRef above: where absent,
                                inherit via samplingActivityRef to the sampling activity's own
                                programDesignRef.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects
                                this sample must satisfy (S7). Same override/fallback precedence as
                                programRef above.</documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:sampleProducedRef">
                        <annotation>
                            <documentation/>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:sampleGroupRef">
                        <annotation>
                            <documentation>Zero or more references to sample groups this sample is a
                                member of. The member cites the group; see
                                diggs:AbstractProjectScopedGroup.

                                This is the first working way to group samples in DIGGS. The released
                                diggs:SampleGroup is typed diggs:SampleGroupType, which holds
                                measurementRef rather than sampleRef, and diggs:MeasurementGroupType -
                                the only type that holds sampleRef - is referenced by no element at
                                all.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSamplingActivity"
        type="diggs:AbstractSamplingActivityType">
        <annotation>
            <documentation>Abstract element for sampling activities. Serves as the head of the substitution group for sampling activity types.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingActivityType" abstract="true">
        <annotation>
            <documentation>Base type for sampling activities that collect materials from sampling features.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>Abstract element serving as the head of the substitution group for all sampling activity types. Sampling activities represent the actions taken to collect samples from sampling features. Activities include drilling, coring, excavation, grab sampling, and other collection methods. Each activity records the who, what, when, where, and how of sample collection, including equipment used, environmental conditions, and recovery information.</documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this
                                activity was carried out to realize (S7). A sampling activity may
                                cite more than one design where multiple planning strands govern
                                different aspects of it.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects
                                this activity must satisfy (S7).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:constructionActivityRef"/>
                    <choice>
                        <sequence>
                            <element ref="diggs:samplingFeatureRef" minOccurs="1" maxOccurs="1"/>
                            <element name="samplingLocation" type="diggs:LocationPropertyType"
                                minOccurs="1">
                                <annotation>
                                    <documentation>Geographic location of the sampling
                                        activity.</documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element maxOccurs="unbounded" minOccurs="0"
                                ref="diggs:associatedProjectRef"/>
                            <element minOccurs="0" ref="diggs:originalProjectRef"/>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="sourceSampleRef" maxOccurs="unbounded"
                        type="diggs:FractionalReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:Sample/@gml:id</appinfo>
                            <documentation>A reference to a sample or samples that are used to
                                create the sample(s) (identified in the sampleProduced property)
                                produced by this activity. This element is only used for activities
                                that subsample or aggregate samples from other samples. For
                                aggregate samples, the percentage attribute optionally defines how
                                much of the total new sample is composed from the source
                                sample.</documentation>
                        </annotation>
                    </element>
                    <element name="activityType" type="diggs:ActivityTypeEnumType">
                        <annotation>
                            <documentation>A controlled list that indicates the classification of
                                sampling activity. Can be used by applications to validate other
                                activity info. One of the following strings must be used: collect -
                                activity created a sample or samples by collection from a sampling
                                feature; aggregate - activity created a sample or samples by
                                aggregating existing samples; the associated Sample(s) should
                                contain more than one sourceSampleRef; subsample - activity created
                                a sample or samples by subsampling an existing sample; only one
                                sourceSampleRef should be specified for the related Sample(s); test
                                - activity produced a test, standard or blank sample that does not
                                relate to any field sample or sampling feature; activity will point
                                to a project but no sourceSampleRef nor samplingFeatureRef should be
                                specified for the associated Sample(s). none - the sample activity
                                failed to produce any physical sample; unknown - used where no
                                information about the sampling activity exists (eg. for legacy data
                                where only sample name or label and location (depth) exists).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lengthLongestPortion"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For rock cores, the length of the longest solid,
                                cylindrical core piece of the sample</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>Purpose of taking this sample. This is an uncontrolled
                                string that describes the test or tests that are intended to be run
                                on the sample(s) generated from this activity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockQualityDesignationLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For rock cores, the sum of length of core pieces that are
                                > 100 mm (4 inches) measured along the centerline</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingActivityRQD"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>For rock cores, the rock quality designation for the
                                sampling activity, defined by the rockQualityDesignationLength
                                divided by the core run (length of sampling activity
                                interval)</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="sampleProduced"
                        type="diggs:SampleProducedPropertyType">
                        <annotation>
                            <documentation>Identifies the samples, and the time and location(s) of
                                samples (optional) that are produced by this sampling
                                activity</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplerInsertionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>For sampling of soil or rock, the means by which the
                                sampler is inserted into the ground. From a controlled list (eg.
                                pushed, driven, etc.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingDate" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The date/time that encompasses the entire time over which
                                sampling occurred.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingEnvironment"
                        type="diggs:EnvironmentPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Contains a component object that is a collection of
                                environmental parameters recorded at a specific time instant dureing
                                the sampling.</documentation>
                        </annotation>
                    </element>
                    <element name="samplingEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>A property element that contains an Equipment feature (or
                                reference to one) that details the sampling equipment
                                used</documentation>
                        </annotation>
                    </element>
                    <element name="samplingMethod" type="diggs:SamplingMethodPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A property that contains a Specification object or reference to ta DrivenPenetrationObject detailing
                                the method of sampling</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="solidCoreRecoveryLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For rock cores, the sum of the lengths of solid,
                                cylindrical, core pieces</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalSampleRecoveryLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For soil or rock cores, this property is the length of
                                the total amount of sample recovered during the activity. If no
                                sample is recovered, this value is 0. This value can also be derived
                                if totalSampleRecovery is reported.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalSampleRecovery"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>A derived result for core samples from boreholes, defined
                                by the totalSampleRecoveryLength divided by the length of the
                                samplingActivity intervsl, typically reported as a
                                percent.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>For sampling activities that involve blending samples in
                                aggregation (such as soil-cement mixtures), this property carries
                                the time duration to mix the sample together.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0"
                        name="otherSamplingActivityProperty" type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>A property that contains a Parameter object whereby
                                ancillary metadata about the sampling activity can be
                                reported</documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element maxOccurs="1" minOccurs="0" name="coringPushPressure"
                            type="diggs:PressureMeasureType">
                            <annotation>
                                <documentation>For coring activities, the push pressure reported as
                                    a single value</documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element maxOccurs="1" minOccurs="0" name="coringPushPressureMin"
                                type="diggs:PressureMeasureType">
                                <annotation>
                                    <documentation>For reporting coring push pressure as a range,
                                        this property holds the minimum pressure
                                        value.</documentation>
                                </annotation>
                            </element>
                            <element maxOccurs="1" minOccurs="0" name="coringPushPressureMax"
                                type="diggs:PressureMeasureType">
                                <annotation>
                                    <documentation>For reporting coring push pressure as a range,
                                        this property holds the maximum pressure
                                        value.</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSamplingFeature" type="diggs:AbstractSamplingFeatureType">
        <annotation>
            <documentation>An abstract object that serves as the head of a substitution group for
                all sampling features. A sampling feature is a physical object or location through
                which we observe or measure properties of an investigation target, or perform some
                type of activity. It serves to define the dimensionality, extent, and local spatial
                reference system for zones where observations or activities take place.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractSamplingFeatureType" abstract="true">
        <annotation>
            <documentation>Base type for all sampling features where investigations are conducted.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedFeatureType">
                <sequence>
                    <element ref="diggs:investigationTarget" maxOccurs="unbounded" minOccurs="0"/>
                    <element ref="diggs:projectRef" maxOccurs="unbounded"/>
                    <element minOccurs="0" ref="diggs:originalProjectRef"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:associatedProjectRef"/>
                    <element minOccurs="0" ref="diggs:programRef"/>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programDesignRef">
                        <annotation>
                            <documentation>Zero or more references to program design objects this feature was
                                realized to satisfy. A feature may cite more than one design where multiple design
                                strands govern different aspects of it.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:programSpecificationRef">
                        <annotation>
                            <documentation>Zero or more references to program specification objects this feature
                                must satisfy. A feature may cite more than one specification, for example a
                                site-level performance specification alongside a project-level tolerance
                                specification.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="realizesGridIndex" type="gml:integerList">
                        <annotation>
                            <documentation>Declares which planned position this feature realizes, as the index of
                                the planned node within the index space of the grid geometry of the design
                                referenced by programDesignRef. Where that design states no plannedPositions of its
                                own, the grid is the one resolved through its basedOnRef chain - resolution walks
                                the chain most-specific-first and geometry resolves exactly like a scalar, which is
                                what lets an exception design be a bare polygon with no layout of its own.
                                
                                Ordered per the grid's axisLabels and of the same dimension as the grid. Uses
                                gml:integerList, the type gml:GridEnvelope itself uses for its low and high bounds,
                                so an index is written in the same form as the limits it must fall within.
                                
                                OMIT THIS ELEMENT for instance-scoped designs, where programDesignRef alone already
                                identifies the plan, and for zone-scoped designs, which state no planned positions
                                to index into. Only the grid form needs the discriminator, because a grid node is
                                not an object and so has no gml:id to point at.
                                
                                Do NOT match a realized feature to its planned position by proximity. Nearest-node
                                matching fails silently exactly where it matters most - a column placed outside its
                                position tolerance is the case a conformance check exists to catch, and it is also
                                the case most likely to be nearer some other node.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="environment"
                        type="diggs:EnvironmentPropertyType">
                        <annotation>
                            <documentation>Reference to an object containing environmental
                                parameters recorded during construction of the sampling
                                feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSamplingFeatureProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>Reference to an Parameter object containing the name,
                                value or range of values and unit of measure of a property or a
                                measurement parameter.</documentation>
                        </annotation>
                    </element>
                    <element name="locality" type="diggs:LocalityPropertyType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>A reference to a Locality object, containing
                                non-coordinate location information for a feature.</documentation>
                        </annotation>
                    </element>
                    <element name="referencePoint" type="diggs:PointLocationPropertyType"
                        minOccurs="1">
                        <annotation>
                            <documentation>Reference to a PointLocation object on the feature that
                                defines the location of the samplingFeature within a known spatial
                                3D CRS or compound CRS (geographic or projected 2D CRS, plus a
                                vertical CRS).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="localCoordinates"
                        type="diggs:LocalCoordinatePropertyType">
                        <annotation>
                            <documentation>A reference to a LocalCoordinate object that holds the
                                values of local coordinates for the reference point of the
                                associated feature. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:samplingFeatureGroupRef">
                        <annotation>
                            <documentation>Zero or more references to sampling feature groups this
                                feature is a member of.

                                THE MEMBER CITES THE GROUP, never the reverse. A group is not edited
                                to admit a member, which is what makes membership expressible in
                                append and streaming workflows - the case that matters when members
                                are constructed one at a time over months. See
                                diggs:AbstractProjectScopedGroup for the full rationale and for why
                                the released group types that reference downward are deprecated.

                                NOT TO BE CONFUSED WITH samplingFeatureRef, which on an installation
                                means CONTAINMENT ("I am constructed within the referenced feature")
                                and is mandatory there. This element means MEMBERSHIP ("I am
                                interpreted jointly with the other members of the referenced
                                group"), is always optional, and never implies containment. The two
                                were previously conflated on a single element name whose meaning
                                depended on which type declared it; separating them is the point of
                                this element.

                                A feature may belong to more than one group - groups are not a
                                partition, and a borehole may be simultaneously a member of a
                                borehole/CPT pair and of a wider investigation-phase group.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractSensor" substitutionGroup="diggs:AbstractEquipment"
        type="diggs:AbstractSensorType" abstract="true">
        <annotation>
            <documentation>Abstract element for sensors. Serves as the head of the substitution group for sensor types.</documentation>
        </annotation>
    </element>
    <complexType name="AbstractSensorType" abstract="true">
        <annotation>
            <documentation>Base type for sensors that measure physical parameters such as temperature or pressure.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="referencePoint"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Identifies the reference point location for the sensor.
                                This may be the top of casing for a tape used to detect water level
                                or it could be a location within the response zone
                                itself.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateInstalled"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Date and time when the sensor was installed. Can specify a single installation time or a time period for multi-stage installation. Critical for interpreting monitoring data relative to installation date.</documentation>
                        </annotation>
                    </element>
                    <element name="detector" type="diggs:DetectorPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Detection device or mechanism used by the sensor. Describes the physical detector that responds to the measured parameter (e.g., pressure transducer, vibrating wire, thermistor). Multiple detectors can be specified if the sensor uses multiple detection methods.</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="true" name="AbstractSpecimen" type="diggs:AbstractSpecimenType">
        <annotation>
            <documentation>AbstractSpecimen serves as the head of a substitution group for concrete
                specimen specializations based on specimen state or type: eg. soil, liquid, gas,
                rock. A specimen derives from one or more Samples, is created as part of a test
                procedure, and exists only in the context of the test procedure that creates
                it.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSpecimenType">
        <annotation>
            <documentation>Base type for test specimens derived from samples or manufactured materials. A specimen is a prepared portion of a sample used for a specific laboratory test. Specimens differ from samples in that they are typically prepared to standard dimensions and conditions (e.g., trimmed, molded, cured) according to test method requirements. A single sample may yield multiple specimens for different tests or repeat testing. Specimens are always associated with a MaterialTest procedure.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractFeatureType">
                <sequence>
                    <element maxOccurs="unbounded" ref="diggs:sampleRef"/>
                    <element minOccurs="0" name="specimenLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>In cases where the specimen location may be different
                                from the host sample's location (for example, a specimeen derived
                                from a core sample at a specific location, instead of a specimen
                                encompassing the entire extent of the sample), this property is used
                                to indicate the specific location. When not present, the spcecimen
                                location will be the same as the host sample's location if relevant.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extractionTime" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The time instant when this specimen was extracted from
                                the sample for testing. This is equivalent to
                                diggs:MaterialTest/sampleTime and diggs:Test/diggs:samplingTime
                                where only one specimen is used for the test and should generally
                                not be used in that case. Where multiple specimens are used for a
                                test and each was extracted from the host at different times, then
                                this property should be used to record the precise sampling time for
                                each specimen.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="preparationProcedure"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>A property that contains a Specification object or
                                reference to a Specification object that describes the procedure
                                used to prepare the specimen from the sample. This can be a simple
                                description (contained in the Specification object's gml:description
                                property), the name of a standard specification (in the gml:name) or
                                a full procedural specification using appropriate properties in the
                                Specification object. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherSpecimenProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    
    <element abstract="true" name="AbstractSurface" substitutionGroup="diggs:AbstractGeometricPrimitive"
        type="diggs:AbstractSurfaceType">
        <annotation>
            <documentation>Abstract head of the substitution group for DIGGS standalone surface
                geometries (diggs:PlanarSurface, diggs:MultiPlanarSurface,
                diggs:TriangulatedSurface, diggs:CompositeSurface). Deliberately excludes
                diggs:Shell, which represents one boundary component of a solid rather than a
                standalone surface in its own right — a property that wants "any real surface, not
                a solid's boundary piece" (e.g. diggs:CompositeSurface's own members) should
                reference diggs:AbstractSurface, not gml:AbstractSurface.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractGeometricPrimitiveType"/>
            
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractTargetObject" type="diggs:AbstractTargetObjectType"
        substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>Head of the substitution group for the Target pattern: a planned
                counterpart of a realized DIGGS object, carrying what is intended (through inherited
                scope and basedOnRef) and a progress track, but never a reference to its own
                realization - the realized object cites the plan instead
                (diggs:programDesignRef), never the reverse. Being a program design, a target also
                carries the specification(s) it must satisfy (programSpecificationRef) and the basis
                it rests on (basisRef), both inherited.
                
                One Target exists per REALIZED ABSTRACT HEAD that is independently instantiable at
                document root - never one per concrete type, and never for a head that exists only
                inside another object's context (diggs:AbstractSpecimen is the case that fails this
                test and gets no Target: it exists only inside a MaterialTest, and planning it is
                already covered by diggs:PlannedTest). A Target plans the inputs and the procedure;
                concrete realized types differ from one another almost entirely in their RESULTS,
                which do not exist at planning time and so have nothing to target.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractTargetObjectType">
        <annotation>
            <documentation>Base type for the Target pattern. Carries a progress track, a planned-
                equipment slot and a dictionary escape hatch; everything else a target needs comes
                from diggs:AbstractProgramDesignType (programSpecificationRef, basisRef) and,
                through it, diggs:AbstractProgramModuleType (scope, basedOnRef) - nothing is
                redeclared here.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="progress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>The lifecycle of this planned object, as a track of dated
                                states. This is what answers "what is planned but not yet built?"
                                without any reference from the plan to its realization: a target
                                with no progress recorded, or whose latest progressState has not
                                reached completion, is not yet fulfilled.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="plannedEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>Equipment planned to be used in realizing this target,
                                held inline or by reference - a piezometer a monitoring plan intends
                                to install, a sampler a collection plan intends to use, a rig a
                                construction plan intends to bring. GENERIC ACROSS THE WHOLE TARGET
                                FAMILY (D2, decided 2026-08-16, built 2026-08-19): placed here rather
                                than as a per-type named field so it is "referenceable from any other
                                target," per D2's own framing, rather than requiring a parallel
                                bespoke field on each Target specialization that happens to need one.
                                Named for what it is (equipment), not for which Target subtype hosts
                                it - diggs:TargetMeasurement uses this for a planned instrument the
                                same way diggs:TargetSample uses it for planned sampling equipment;
                                neither gets its own differently-named copy.

                                THE PROPERTY DIGGS ALREADY HAD NO HOME FOR. Before this element,
                                ri_properties.xml#instrument_type stated a planned instrument's kind
                                as a bare parameter, explicitly because "there is no equipment
                                reference on diggs:TargetMeasurementType for it to become instead."
                                That entry is now retired: state the instrument as an inline or
                                referenced diggs:Sensor/diggs:Equipment here, with its kind carried
                                on the equipment's own diggs:class (equipmentClass.xml already binds
                                to //diggs:Sensor/diggs:class and //diggs:Equipment/diggs:class
                                unconditionally, so no dictionary change was needed to make this
                                element's content dictionary-checkable).

                                SUPERSEDES diggs:TargetSampleType's own former samplingEquipment
                                field (built one day earlier, same session arc, as part of the
                                TargetSample rework) - that field was the first instance of exactly
                                this need, built before D2's generic answer existed. Retired in favour
                                of this element; diggs:TargetSample now carries planned sampling
                                equipment here like every other Target.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="otherProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The dictionary escape hatch: a planned property that has
                                no named element on this or a more specific target type. Prefer a
                                named element wherever the plan has one; use this only where none
                                exists.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    
    <element name="AbstractTestProcedure" type="diggs:AbstractTestProcedureType"
        substitutionGroup="diggs:AbstractProcedure" abstract="true">
        <annotation>
            <documentation>Base type for all procedures that comprise a Test or MaterialTest.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractTestProcedureType">
        <annotation>
            <documentation>Base type for test procedures that define how tests are performed.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProcedureType">
                <sequence>
                    <element name="testProcedureMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A property element that contains a Specification object
                                (or reference to one) detailing the test procedure method
                                used.</documentation>
                        </annotation>
                    </element>
                    <element name="testProcedureEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>Contains or references an Equipment object. Any concrete
                                object that substitutes for AbstractEquipment can be contained or
                                referenced by this property. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testingEnvironment" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Environmental conditions during testing. Values derived
                                at different times during the test can be specified with multiple
                                elements and using the Environment/dateTime
                                property.</documentation>
                        </annotation>
                        <complexType>
                            <complexContent>
                                <extension base="diggs:EnvironmentPropertyType">
                                    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                                    <attributeGroup ref="gml:AssociationAttributeGroup"/>
                                </extension>
                            </complexContent>
                        </complexType>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherTestProperty"
                        type="diggs:ParameterPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

</schema>
