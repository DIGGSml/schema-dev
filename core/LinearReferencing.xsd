        <documentation>
            DIGGS Linear Referencing Schema - Version 3.0b
            
            This schema provides comprehensive linear referencing capabilities for 
            any DIGGS linear sampling features, including boreholes, wells, 
            soundings, and geophysical tracklines.
            
            Based on ISO 19148:2021 (Linear referencing) adapted for geotechnical 
            and geoenvironmental contexts. This schema removes transportation-specific 
            concepts (lanes, routes, addresses) and adds geotechnical-specific 
            referents and methods.
            
            Linear referencing in DIGGS is based on distance measurements along 
            LinearExtent features, which are DIGGS extensions of gml:LineString, typically
            with 3D coordinates. All measurements proceed in coordinate order from the first 
            coordinate (or referent coordinate) to the last coordinate in the gml:posList, 
            regardless of spatial orientation (vertical, horizontal, or deviated). Spatial 
            direction can be optionally provided by the positiveDirection property of the 
            LRMethod.
            
            Key ISO 19148:2021 Concepts Implemented:
            - §6.2: Linear Referencing Method (LRMethod)
            - §6.3: Linear Element (LinearExtent)
            - §6.4: Linear Spatial Reference System (LinearSRS)
            - §7.2: Linear Position (via gml:Point with srsName)
            - §7.3: Linear Location (intervals via gml:LineString with srsName)
            
            Copyright (c) DIGGS 2025. All rights reserved.
        </documentation>
    </annotation>
    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.opengis.net/gml/3.3/lr" schemaLocation="glrProfile_diggs.xsd"/>
    <import namespace="http://www.opengis.net/gml/3.3/lrov" schemaLocation="glrovProfile_diggs.xsd"/>
    <element name="LinearReferencingMethod" type="diggs:LinearReferencingMethodType"
        substitutionGroup="gml:Definition">
        <annotation>
            <documentation>
                A linear referencing method: the procedure for specifying a position along a linear
                element as a distance from an origin, optionally with a lateral offset (ISO
                19148:2021, section 6.2). It fixes the method name and category, the unit of
                distance, the positive direction and whether lateral offsets are supported.
            </documentation>
        </annotation>
    </element>
    <complexType name="LinearReferencingMethodType">
        <complexContent>
            <extension base="gml:IdentifiedObjectType">
                <sequence>
                    <element name="name" type="diggs:LinearReferencingNameTypeEnumType">
                        <annotation>
                            <documentation>
                                The name of the method, which fixes how distances are measured: the
                                unit, the origin and whether lateral offsets apply. Values come from
                                the enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="type" type="diggs:LinearReferencingMethodTypeEnumType">
                        <annotation>
                            <documentation>
                                The category of the method (ISO 19148:2021, section 6.2.3):
                                absolute, relative or interpolative. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="units" type="diggs:LengthUomEnumType">
                        <annotation>
                            <documentation>
                                The unit of the distance along the linear element, which is the
                                first coordinate value of a position.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="positiveDirection" type="diggs:PositiveDirectionEnumType"
                        minOccurs="0" default="increasing">
                        <annotation>
                            <documentation>
                                The direction in which measured values increase along the linear
                                element. Measurement always proceeds from the first to the last
                                coordinate; the values other than increasing are labels that say
                                what that direction means, for example downward for a borehole.
                                Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constraint" type="string">
                        <annotation>
                            <documentation>
                                A constraint this method imposes, for example that a referent cannot
                                be of type "line start" or "line end". Repeat for each constraint.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="offsetParameters" type="diggs:OffsetParametersPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The parameters of the lateral offset, for methods that support one,
                                for example for transects, tracklines with swath data, pipelines
                                with offset monitoring points, or trial pits with offset sampling
                                locations. When present, the method is two-dimensional: a linear
                                spatial reference system using it has srsDimension 2 and a position
                                is encoded in gml:pos as the distance along, in units, then the
                                offset, in offsetParameters/offsetUnits. When absent, the method is
                                one-dimensional: srsDimension is 1 and a position is the distance
                                alone.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LinearReferencingMethodPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LinearReferencingMethod object inline, or
                refers to one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:LinearReferencingMethod"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="LinearSpatialReferenceSystem" substitutionGroup="gml:Definition"
        type="diggs:LinearSpatialReferenceSystemType">
        <annotation>
            <documentation>
                A linear spatial reference system for a sampling feature: positions along a linear
                element given as distances under a linear referencing method, measured from a
                referent when the method is relative.
            </documentation>
        </annotation>
    </element>
    <complexType name="LinearSpatialReferenceSystemType">
        <complexContent>
            <extension base="gml:IdentifiedObjectType">
                <sequence>
                    <element ref="glr:linearElement"/>
                    <choice>
                        <element name="lrm" type="diggs:LinearReferencingMethodPropertyType">
                            <annotation>
                                <documentation>
                                    The linear referencing method that this system applies.
                                </documentation>
                            </annotation>
                        </element>
                        <element ref="glr:lrm">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:lrm"/>
                                </appinfo>
                                <documentation>DEPRECATED. Use diggs:lrm. The linear referencing
                                    method, in the glr namespace.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="referent" type="diggs:ReferentPropertyType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The referent that is the origin of measurements when the method type
                                is relative; required in that case and optional otherwise. For a
                                system of depth below ground surface, it is the ground surface
                                referent on the linear element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:linearReferencingMethodUncertainty"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Referent" type="diggs:ReferentType" substitutionGroup="gml:AbstractObject">
        <annotation>
            <documentation>
                A reference point on or associated with a linear element: the origin of relative
                measurements, or an anchor point that calibrates an interpolative method. Examples
                are the ground surface, kelly bushing or rotary table for drilling, the sea floor or
                mudline for marine work, the start or end of a geophysical trackline, a kickoff
                point for wells, and the top or bottom of a core. When a linear spatial reference
                system uses a relative method, the referent is the zero point of its measurements.
            </documentation>
        </annotation>
    </element>
    <complexType name="ReferentBaseType">
        <annotation>
            <documentation>
                Base type for a referent, carrying the common GML properties such as description and
                name.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractGMLType">
                <sequence>
                    <element minOccurs="0" ref="gml:description"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="ReferentType">
        <complexContent>
            <extension base="diggs:ReferentBaseType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="name" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The name or abbreviation by which the referent is known, for example
                                GS (ground surface), KB (kelly bushing), RT (rotary table), SF (sea
                                floor) or TOC (top of core, or top of casing). Use the DIGGS
                                dictionary referentName.xml for the list of values; its entries
                                accept either the full name or a common abbreviation as the value.
                                Identify the entry with codeSpace, for example
                                referentName.xml#ground_surface; this also resolves an abbreviation
                                that two entries share.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="referentType" type="diggs:ReferentTypeEnumType">
                        <annotation>
                            <documentation>
                                The kind of referent, which gives the reference point its physical
                                or logical meaning, for example ground surface, kelly bushing,
                                kickoff point, top of core or bottom of core. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="position" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The position of the referent in a coordinate reference system,
                                typically geographic or projected. It allows linear reference
                                coordinates to be transformed to geographic coordinates.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="distanceAlong" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The position of the referent along the linear extent, as the
                                distance from its first coordinate in gml:posList. For example, a
                                kelly bushing at the first point has a distance of 0, and a ground
                                surface 5 ft below it has 5 ft.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="startValue" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measure value at the location of this referent. It is 0, in the
                                unit of the linear referencing method, when omitted.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ReferentPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Referent object inline, or refers to one with
                xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Referent"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="OffsetParameters" type="diggs:OffsetParametersType"
        substitutionGroup="gml:AbstractObject">
        <annotation>
            <documentation>
                The parameters that define a lateral offset from the centerline of a linear element:
                the perpendicular distance from the centerline, positive on the side given by
                offsetDirection and negative on the other. Its presence in a linear referencing
                method makes the method two-dimensional. Examples are the swaths of side-scan sonar
                or sub-bottom profilers on a vessel trackline, offset soil sampling along a survey
                transect, and monitoring points parallel to a pipeline.
            </documentation>
        </annotation>
    </element>
    <complexType name="OffsetParametersType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="offsetType" type="diggs:OffsetTypeEnumType"
                        default="perpendicular">
                        <annotation>
                            <documentation>
                                How the offset is measured from the centerline: perpendicular to it,
                                at a constant bearing, or radially from a center point. Values come
                                from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="offsetDirection" type="diggs:OffsetDirectionEnumType"
                        default="right">
                        <annotation>
                            <documentation>
                                The side on which offset values are positive, looking along the
                                linear element from its first to its last coordinate. Offsets on the
                                other side are negative, and zero is on the centerline. Values come
                                from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="offsetUnits" type="diggs:LengthUomEnumType">
                        <annotation>
                            <documentation>
                                The unit of the lateral offset, which is the second coordinate value
                                of a position. It may differ from the unit of the distance along,
                                though they are typically the same.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="maxOffset" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The largest allowed offset magnitude, in offsetUnits: valid offsets
                                lie between minus and plus this value. For example, the swath width
                                of a geophysical instrument, or the limit of sampling from a
                                transect centerline.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearing" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The bearing along which offsets from the centerline are measured, as
                                an azimuth from north or a compass bearing. Required when offsetType
                                is constantBearing.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="OffsetParametersPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:OffsetParameters object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:OffsetParameters"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <simpleType name="LinearReferencingMethodTypeEnum">
        <restriction base="string">
            <enumeration value="absolute">
                <annotation>
                    <documentation>
                        Position is the distance from a fixed origin, typically the first coordinate
                        of the linear extent, for example measured depth from the kelly bushing,
                        distance along a geophysical trackline from its start, or distance from the
                        top of a core sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="relative">
                <annotation>
                    <documentation>
                        Position is the distance from a referent point along the linear element, for
                        example depth below ground surface, distance from a line intersection point,
                        or distance from a kickoff point in directional drilling.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="interpolative">
                <annotation>
                    <documentation>
                        Position is found by interpolating between known control points (anchor
                        points) along the linear element, for example core positions adjusted for
                        stretch or compression between the top and bottom of the core, trackline
                        positions interpolated between GPS waypoints, or borehole positions adjusted
                        with downhole survey stations.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LinearReferencingMethodTypeEnumType">
        <union memberTypes="diggs:OtherNameType diggs:LinearReferencingMethodTypeEnum"/>
    </simpleType>
    <simpleType name="LinearReferencingMethodNameEnum">
        <restriction base="string">
            <enumeration value="trueFootage">
                <annotation>
                    <documentation>
                        Distance in decimal feet along the linear element from its start, in the
                        direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trueCentimeters">
                <annotation>
                    <documentation>
                        Distance in decimal centimeters along the linear element from its start, in
                        the direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trueInches">
                <annotation>
                    <documentation>
                        Distance in decimal inches along the linear element from its start, in the
                        direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trueMeters">
                <annotation>
                    <documentation>
                        Distance in decimal meters along the linear element from its start, in the
                        direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="chainage">
                <annotation>
                    <appinfo>
                        <diggs:deprecated since="3.0.0"
                            note="trueMeters if the units are meters, trueFootage if they are feet"/>
                    </appinfo>
                    <documentation>DEPRECATED. Use trueMeters if the units are meters, or
                        trueFootage if they are feet. Distance along the linear element from its
                        start, in the direction of the linear element.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="trueFootageWithOffset">
                <annotation>
                    <documentation>
                        Distance in decimal feet along the linear element from its start, in the
                        direction of the linear element. If diggs:offsetParameters is given, the
                        location is then adjusted by the offset it describes. A linearly referenced
                        coordinate is two-dimensional: the distance, then the offset.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trueMetersWithOffset">
                <annotation>
                    <documentation>
                        Distance in decimal meters along the linear element from its start, in the
                        direction of the linear element. If diggs:offsetParameters is given, the
                        location is then adjusted by the offset it describes. A linearly referenced
                        coordinate is two-dimensional: the distance, then the offset.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="referenceFootage">
                <annotation>
                    <documentation>
                        Distance in decimal feet along the linear element from a specified referent
                        location, in the direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="referenceMeters">
                <annotation>
                    <documentation>
                        Distance in decimal meters along the linear element from a specified
                        referent location, in the direction of the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="referenceFootageWithOffset">
                <annotation>
                    <documentation>
                        Distance in decimal feet along the linear element from a specified referent
                        location, in the direction of the linear element. If diggs:offsetParameters
                        is given, the location is then adjusted by the offset it describes. A
                        linearly referenced coordinate is two-dimensional: the distance, then the
                        offset.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="referenceMetersWithOffset">
                <annotation>
                    <documentation>
                        Distance in decimal meters along the linear element from a specified
                        referent location, in the direction of the linear element. If
                        diggs:offsetParameters is given, the location is then adjusted by the offset
                        it describes. A linearly referenced coordinate is two-dimensional: the
                        distance, then the offset.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="inchMeasure">
                <annotation>
                    <documentation>
                        Distance expressed in decimal inches along the linear element, in the
                        direction of the linear element. The location is found from the two anchor
                        points along the linear element that bracket the measurement, interpolating
                        between them using the length of the line segment between them. In DIGGS,
                        used primarily for logging locations on a core sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="cmMeasure">
                <annotation>
                    <documentation>
                        Distance expressed in decimal centimeters along the linear element, in the
                        direction of the linear element. The location is found from the two anchor
                        points along the linear element that bracket the measurement, interpolating
                        between them using the length of the line segment between them. In DIGGS,
                        used primarily for logging locations on a core sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="footMeasure">
                <annotation>
                    <documentation>
                        Distance expressed in decimal feet along the linear element, in the
                        direction of the linear element. The location is found from the two anchor
                        points along the linear element that bracket the measurement, interpolating
                        between them using the length of the line segment between them.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="meterMeasure">
                <annotation>
                    <documentation>
                        Distance expressed in decimal meters along the linear element, in the
                        direction of the linear element. The location is found from the two anchor
                        points along the linear element that bracket the measurement, interpolating
                        between them using the length of the line segment between them.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LinearReferencingNameTypeEnumType">
        <union memberTypes="diggs:OtherNameType diggs:LinearReferencingMethodNameEnum"/>
    </simpleType>
    <simpleType name="PositiveDirectionEnumType">
        <restriction base="string">
            <enumeration value="increasing">
                <annotation>
                    <documentation>
                        Positive follows the coordinate order, from the first to the last
                        coordinate. This is the standard convention.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="downward">
                <annotation>
                    <documentation>
                        Label for positive being downward (deeper), common for boreholes where the
                        first coordinate is the collar and the last is the bottom of the hole.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="upward">
                <annotation>
                    <documentation>
                        Label for positive being upward (shallower), for example for core logged
                        from bottom to top, or for elevation-based referencing.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="forward">
                <annotation>
                    <documentation>
                        Label for horizontal features: positive is the forward direction of the
                        survey or alignment, common for transects, pipelines and tracklines.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="OffsetDirectionEnumType">
        <annotation>
            <documentation>
                The side of a linear element on which lateral offsets are positive, looking along
                the element from its first to its last coordinate in gml:posList. Offsets on the
                other side are negative, and zero is on the centerline.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="right">
                <annotation>
                    <documentation>
                        Positive offset is to the right when looking along the linear element.
                        Standard for terrestrial applications such as transects, pipelines and road
                        alignments.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="left">
                <annotation>
                    <documentation>
                        Positive offset is to the left when looking along the linear element.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="starboard">
                <annotation>
                    <documentation>
                        Positive offset is to starboard, the right side when facing the bow. Marine
                        convention for geophysical tracklines and marine surveys; equivalent to
                        right.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="port">
                <annotation>
                    <documentation>
                        Positive offset is to port, the left side when facing the bow. Marine
                        convention for geophysical tracklines; equivalent to left.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="OffsetTypeEnumType">
        <restriction base="string">
            <enumeration value="perpendicular">
                <annotation>
                    <documentation>
                        Offset measured perpendicular to the tangent of the centerline at each
                        point. The usual method for straight or gently curved features.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="constantBearing">
                <annotation>
                    <documentation>
                        Offset measured along a fixed compass bearing from each centerline point,
                        rather than perpendicular to the local tangent. Used in marine surveys with
                        sensor arrays that keep a constant orientation relative to north.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="radial">
                <annotation>
                    <documentation>
                        Offset measured radially outward from a defined center point, rather than
                        perpendicular to the centerline. For circular or spiral survey patterns and
                        radial sampling designs.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ReferentTypeEnum">
        <annotation>
            <documentation>
                Referent types for geotechnical, geoenvironmental and geophysical linear features:
                common reference points in drilling, sampling and survey operations.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="ground surface">
                <annotation>
                    <documentation>
                        The natural or existing ground surface at the location of the feature. The
                        usual reference for boreholes, CPT soundings, test pits and other subsurface
                        investigations.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="kelly bushing">
                <annotation>
                    <documentation>
                        The kelly bushing on a drilling rig, at the top of the kelly drive system.
                        Typically the reference for measured depth in rotary drilling. Rotary
                        bushing is the preferred term.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="rotary bushing">
                <annotation>
                    <documentation>
                        The bushing seated in the rotary table through which the kelly or drill
                        string passes. Its elevation (RKB, rotary kelly bushing) is a common datum
                        for measuring drilled depths and is typically a few feet above the drill
                        floor elevation. Preferred over kelly bushing.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="rotary table">
                <annotation>
                    <documentation>
                        The rotating platform of a drilling rig through which the drill string
                        passes. An alternative reference for measured depth.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="crown valve">
                <annotation>
                    <documentation>
                        The valve assembly at the crown of the derrick or mast, at or near the crown
                        block. A depth datum in drilling operations, at one of the highest fixed
                        points of the rig.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="derrick floor">
                <annotation>
                    <documentation>
                        The derrick floor or rig floor, the main working platform of the drilling
                        rig. Sometimes used instead of the kelly bushing or rotary table.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mudline">
                <annotation>
                    <documentation>
                        The river or lakebed surface in over-water drilling: the sediment-water
                        interface in non-marine aquatic environments.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sea floor">
                <annotation>
                    <documentation>
                        The sea floor surface, used in marine geophysical and geotechnical surveys.
                        Typically the reference for measured depth in subsea wells and offshore
                        boreholes.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean sea level">
                <annotation>
                    <documentation>
                        Mean sea level, a vertical datum in marine and coastal environments: the
                        arithmetic mean of hourly water elevations observed over a National Tidal
                        Datum Epoch (19 years).
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lowest astronomical tide">
                <annotation>
                    <documentation>
                        The lowest tide level over a National Tidal Datum Epoch (19 years). A
                        low-water datum in some coastal applications.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean higher high water">
                <annotation>
                    <documentation>
                        A tidal datum: the average of the higher high water height of each tidal day
                        observed over a National Tidal Datum Epoch (19 years). Applicable in areas
                        with mixed tidal regimes.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean high water">
                <annotation>
                    <documentation>
                        A tidal datum: the average of all the high water heights observed over a
                        National Tidal Datum Epoch (19 years).
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean lower low water">
                <annotation>
                    <documentation>
                        A tidal datum: the average of the lower low water height of each tidal day
                        observed over a National Tidal Datum Epoch (19 years). The common datum for
                        nautical charts in the United States.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean low water">
                <annotation>
                    <documentation>
                        A tidal datum: the average of all the low water heights observed over a
                        National Tidal Datum Epoch (19 years).
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mean tide level">
                <annotation>
                    <documentation>
                        A tidal datum: the arithmetic mean of mean high water and mean low water,
                        the same as half-tide level.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="top of casing">
                <annotation>
                    <documentation>
                        The top of the protective casing of a borehole or well. A reference for
                        depth measurements in monitoring wells and environmental boreholes.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="bottom of casing">
                <annotation>
                    <documentation>
                        The base of the protective casing of a borehole or well, where cased hole
                        changes to open hole.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="casing flange">
                <annotation>
                    <documentation>
                        A flange affixed to the top of the casing string, used to attach production
                        equipment. A common reference in oil and gas wells.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="kickoff point">
                <annotation>
                    <documentation>
                        The point at which a borehole deviates from vertical in directional
                        drilling. An important reference for deviated well paths and horizontal
                        drilling.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="top of hole">
                <annotation>
                    <documentation>
                        The top of a drilled hole; generally the same as the ground surface unless
                        the hole is drilled within an excavation or from a platform.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="bottom of hole">
                <annotation>
                    <documentation>
                        The terminal end of a borehole or well at maximum penetration: the total
                        depth (TD) of the hole.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="top of core">
                <annotation>
                    <documentation>
                        The defined top of a core sample. Used for positions within core samples
                        that are handled separately from the parent borehole, and a common anchor
                        point for linear referencing within a core.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="bottom of core">
                <annotation>
                    <documentation>
                        The defined base of a core sample. Used for core recovery calculations and
                        sample referencing; often better defined than the top of core when slough is
                        present at the top of the cored interval. A common anchor point for
                        bottom-up core logging.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="line start">
                <annotation>
                    <documentation>
                        The starting point of a geophysical trackline or survey transect,
                        corresponding to the first coordinate of the linear extent. A common
                        reference for distance along survey lines.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="line end">
                <annotation>
                    <documentation>
                        The ending point of a geophysical trackline or survey transect,
                        corresponding to the last coordinate of the linear extent.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="intersection">
                <annotation>
                    <documentation>
                        The point where this linear feature crosses another linear feature. Common
                        in grid-based geophysical surveys, where perpendicular survey lines create a
                        network of tie points.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="benchmark">
                <annotation>
                    <documentation>
                        A surveyed benchmark used as the elevation reference for the feature: a
                        monumented point with known coordinates in a geodetic reference system.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ReferentTypeEnumType">
        <annotation>
            <documentation>
                Type for the kind of a referent: a diggs:ReferentTypeEnum value or a value of the
                form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:ReferentTypeEnum"/>
    </simpleType>
    <element name="linearReferencingMethodUncertainty" type="diggs:UncertaintyPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    note="the uncertainty within each diggs:LinearExtent that uses this linear reference system"/>
            </appinfo>
            <documentation>DEPRECATED. Use the uncertainty within each diggs:LinearExtent that uses
                this linear reference system. An accuracy value (usually a length) for the locations
                that use this linear reference system.</documentation>
        </annotation>
    </element>
    <element abstract="true" name="AbstractRelativeReferenceSystem"
        type="diggs:AbstractRelativeReferenceSystemType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    note="diggs:LinearSpatialReferenceSystem for linear referencing, or diggs:LocalCartesianCRS for 2D and 3D relative referencing"/>
            </appinfo>
            <documentation>DEPRECATED. Use diggs:LinearSpatialReferenceSystem for linear
                referencing, or diggs:LocalCartesianCRS for 2D and 3D relative referencing. Head of
                the relative spatial reference systems.</documentation>
        </annotation>
    </element>
    <complexType name="RelativeReferenceSystemPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object, which is a
                diggs:LinearSpatialReferenceSystem, an object that substitutes for
                gml:AbstractSingleCRS or an object that substitutes for
                diggs:AbstractRelativeReferenceSystem inline.
            </documentation>
        </annotation>
        <choice>
            <element ref="diggs:LinearSpatialReferenceSystem"/>
            <element ref="gml:AbstractSingleCRS"/>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractRelativeReferenceSystem"/>
        </choice>
    </complexType>
    <complexType name="AbstractRelativeReferenceSystemType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    note="diggs:LinearSpatialReferenceSystem for linear referencing, or diggs:LocalCartesianCRS for 2D and 3D relative referencing"/>
            </appinfo>
            <documentation>DEPRECATED. Use diggs:LinearSpatialReferenceSystem for linear
                referencing, or diggs:LocalCartesianCRS for 2D and 3D relative referencing. Type of
                diggs:AbstractRelativeReferenceSystem.</documentation>
        </annotation>
        <complexContent>
            <extension base="glr:LinearSRSType"/>
        </complexContent>
    </complexType>
    <element name="VectorLinearSpatialReferenceSystem"
        type="diggs:VectorLinearSpatialReferenceSystemType"
        substitutionGroup="diggs:AbstractRelativeReferenceSystem">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    replacedBy="diggs:LocalCartesianCRS"
                    note="a diggs:LocalCartesianCRS declared in DocumentInformation/crs"/>
            </appinfo>
            <documentation>DEPRECATED. Use a diggs:LocalCartesianCRS declared in
                DocumentInformation/crs. A linear spatial reference system with an offset vector
                fixing a planar orientation.</documentation>
        </annotation>
    </element>
    <complexType name="VectorLinearSpatialReferenceSystemType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    replacedBy="diggs:LocalCartesianCRS"
                    note="a diggs:LocalCartesianCRS declared in DocumentInformation/crs"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a diggs:LocalCartesianCRS declared in DocumentInformation/crs. Type
                of diggs:VectorLinearSpatialReferenceSystem.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractRelativeReferenceSystemType">
                <sequence>
                    <element name="offsetVector" type="glrov:VectorType" maxOccurs="3" minOccurs="1">
                        <annotation>
                            <documentation>
                                A unit vector that defines the orientation of the planar surface
                                extending from the planar surface's reference edge. Repeat for each
                                vector.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="linearReferencingMethodUncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The accuracy (usually a length) of the locations that use this
                                linear reference system, for example the source and accuracy of the
                                depths in a hole. Where elements that refer to this system have
                                different uncertainties, report those within the elements
                                themselves.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vectorOffsetUncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The accuracy of the offset vector.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
</schema>
