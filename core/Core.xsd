<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.0.0">

    <annotation>
        <documentation> Includes core geotechnical features: projects, sampling features, sampling
            activities and samples, observations, measurements, equipment, geometry and time objects
            and related elements. This module provides the fundamental data structures for
            documenting site investigations including project metadata, borehole construction
            details, sample descriptions, field testing, and laboratory analysis. This is the heart
            of the DIGGS Core profile. </documentation>
    </annotation>

    <!-- Uncomment to clear validation errors without a master file-->
    <include schemaLocation="../Diggs.xsd"/>

    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/1999/xlink" schemaLocation="xlinks.xsd"/>

    <!-- ================================================================================== -->
    <!-- DOCUMENT INFORMATION ELEMENTS                                                      -->
    <!-- ================================================================================== -->
    <element name="DocumentInformation" type="diggs:DocumentInformationType" abstract="false">
        <annotation>
            <documentation>An object that contains metadata about the specific xml
                instance.</documentation>
        </annotation>
    </element>
    <complexType name="DocumentInformationType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectBaseType. Adds elements for
                document information type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="creationDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The date that this instance file was
                                created.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The effective date for the data in this XML
                                instance.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="expirationDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>The expiration date for the data in this XML
                                instance.</documentation>
                        </annotation>
                    </element>
                    <element name="author" type="diggs:BusinessAssociatePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The author of the document.</documentation>
                        </annotation>
                    </element>
                    <element name="disclaimer" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Conditions and limitations of the data.</documentation>
                        </annotation>
                    </element>
                    <element name="sourceSoftware" type="diggs:SoftwareApplicationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The software that created the instance.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="destination" type="string">
                        <annotation>
                            <documentation>The intended destination for this XML
                                instance.</documentation>
                        </annotation>
                    </element>
                    <element name="destinationSoftware" type="diggs:SoftwareApplicationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The software that is intended to consume the
                                file.</documentation>
                        </annotation>
                    </element>
                    <element name="auditTrail" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>A series of remarks providing a history of
                                transmissions.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="crs"
                        type="diggs:CRSPropertyType">
                        <annotation>
                            <documentation>The crs property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DocumentInformationPropertyType">
        <annotation>
            <documentation>Property type for document information references. Used to wrap document
                information objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element minOccurs="1" maxOccurs="1" ref="diggs:DocumentInformation"/>
        </sequence>
    </complexType>
    <complexType name="CRSPropertyType">
        <annotation>
            <documentation>Property type for crs references. Used to wrap crs objects or references
                in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="gml:AbstractCRS"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- PROJECT ELEMENTS                                                                   -->
    <!-- ================================================================================== -->

    <element name="Project" type="diggs:ProjectType" substitutionGroup="diggs:AbstractProject"
        abstract="false">
        <annotation>
            <documentation>A Project is a business activity that encompasses a collection of
                sampling features, activities, samples, observations and measurements. A project may
                occur at a physical location, in which case it can optionally contain geometries. A
                project is typically associated with an investigation or construction activity for
                which there a specific outcome anticipated - eg. a research publication, design, or
                an actual geotechnical construction (eg. deep foundation, earthwork,
                etc.)</documentation>
        </annotation>
    </element>
    <complexType name="ProjectType">
        <annotation>
            <documentation>Concrete type extending AbstractProjectType. Provides implementation for
                project type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProjectType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ProjectPropertyType">
        <annotation>
            <documentation>Property type for project references. Used to wrap project objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractProject"> </element>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GENERAL SAMPLING FEATURE ELEMENTS                                                  -->
    <!-- ================================================================================== -->
    <element name="InstallationEvent" type="diggs:InstallationEventType">
        <annotation>
            <documentation>An object that contains properties about a time or depth related event
                occurring in association with creation of an installation feature.</documentation>
        </annotation>
    </element>
    <complexType name="InstallationEventType">
        <annotation>
            <documentation>Complex type: InstallationEventType</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- BOREHOLE ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Borehole"
        substitutionGroup="diggs:AbstractLinearSamplingFeature" type="diggs:BoreholeType">
        <annotation>
            <documentation>A sampling feature feature that is a deep, narrow excavation made by
                drilling and/or extraction of earth material. Boreholes are constructed typically
                for the purpose of investigating subsurface geologic or geotechnical conditions,
                exploring for water or oil, for installation of wells or other downhole monitoring
                installations.</documentation>
        </annotation>
    </element>
    <element name="BoreholeConstructionMethod" type="diggs:BoreholeConstructionMethodType">
        <annotation>
            <documentation>An object that contains properties of borehole
                construction.</documentation>
        </annotation>
    </element>
    <complexType name="BoreholeConstructionMethodPropertyType">
        <annotation>
            <documentation>Property type for borehole construction method references. Used to wrap
                borehole construction method objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BoreholeConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeConstructionMethodType">
        <annotation>
            <documentation>Extended type based on AbstractNamedRoleObjectType. Adds elements for
                borehole construction method type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The location within the sampling feature that corresponds
                                to the particular construction method being referenced here. If
                                omitted, it is assumed that the procedures specified apply to the
                                entire extent of the sampling feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time during which the construction event is
                                occurring</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeStability" type="string">
                        <annotation>
                            <documentation>Uncontrolled string describing stability conditions of
                                the hole during this interval</documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>Contains a Specification object that may be used to
                                describe any details regarding the method of construction. It should
                                not be used to simply provide a name for the construction method.
                                That value should be entered in the gml:name property for this
                                object.</documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A property element that contains an Equipment feature (or
                                reference to one) that details the construction equipment
                                used.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cuttingToolInfo"
                        type="diggs:CuttingToolArrayPropertyType">
                        <annotation>
                            <documentation>The cutting tool info property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="drillPipeInfo"
                        type="diggs:DrillPipeArrayPropertyType">
                        <annotation>
                            <documentation>The drill pipe info property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydraulicFluidFlowRate"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>The flow rate of the hydraulic fluid.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeDiameter" type="diggs:BoreholeDiameterType">
        <annotation>
            <documentation>An object that carries the diameter of a borehole and its
                location.</documentation>
        </annotation>
    </element>
    <complexType name="BoreholeDiameterPropertyType">
        <annotation>
            <documentation>Property type for borehole diameter references. Used to wrap borehole
                diameter objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:BoreholeDiameter" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeDiameterType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for borehole
                diameter type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="diameterLocation" type="diggs:LinearExtentPropertyType"
                        maxOccurs="1" minOccurs="0">
                        <annotation>
                            <documentation>The depth interval in the hole that pertains to the
                                diameter reported, measured in a linear referencing system. If
                                omitted, it is assumed that the diameter reported pertains to the
                                entire length of the hole</documentation>
                        </annotation>
                    </element>
                    <element name="diameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The diameter of the borehole over the depth interval
                                reported.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="computedBoreholeCrossSectionalArea"
                        type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>Cross-sectional area of the borehole, computed from
                                inferred borehole diameter for the interval</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="computedBoreholeVolume"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>Volume of the boreholein this interval, computed from the
                                inferred borehole diameter.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeEvent" type="diggs:BoreholeEventType">
        <annotation>
            <documentation>Depth and/or time related information recorded during construction of the
                borehole.These events are intended to record information that is non-geological.
                Typically this includes drillers comments usually found on the boring or drilling
                log, for reporting incidents during drilling (such as "Fishing for broken U100"),
                drilling records that don't readily fit in any other groups (such as "Pushing
                boulder ahead of casing"), observations that are not strictly geological (such as
                "Strong petrol smell").</documentation>
        </annotation>
    </element>
    <complexType name="BoreholeEventPropertyType">
        <annotation>
            <documentation>Property type for borehole event references. Used to wrap borehole event
                objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BoreholeEvent"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeEventType">
        <annotation>
            <documentation>Extended type based on AbstractEventType. Adds elements for borehole
                event type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="casingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured Depth to Base of Casing installed at this event
                                time, in the hole's linear referencing system. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeBottom" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured Depth to Base of Hole at this event time,
                                reported in the hole's linear referencing system.</documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element minOccurs="0" name="waterDepth"
                            type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>Depth to Water Surface as measured at this event
                                    time, recorded in the hole's linear referencing
                                    system.</documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="isDry" type="boolean" fixed="true">
                            <annotation>
                                <documentation>Indicates whether dry.</documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="BoreholeType">
        <annotation>
            <documentation>Extended type based on AbstractLinearSamplingFeatureType. Adds elements
                for borehole type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time when the hole is constructed. This
                                should include the entire time the drill rig is on
                                site.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="whenDestroyed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The time period during which the hole was destroyed or
                                forever abandoned. This date must occur after all related
                                observations, measurements or activities had been performed in the
                                borehole, and should reflect the time after which no observations or
                                activities are possible in the hole.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalMeasuredDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The measured depth to the bottom of the hole, measured in
                                a hole's linear referencing system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:holeBearing"/>
                    <element minOccurs="0" ref="diggs:holePlunge"/>
                    <element maxOccurs="1" minOccurs="0" name="boreholePurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the purpose for drilling the hole (eg.
                                exploratory boring, monitoring well, etc.). Intended to come from a
                                controlled list.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="boreholeType"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the type of boring, intended to come
                                from a controlled lis ot terms. This is intended for use as a
                                classifier that applications may use to identify types of boreholes
                                that may require different data storage structures. It should not be
                                used to describe the borehole construction method. The
                                BoreholeConstructionMethod object should be used for such
                                purposes.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on construction of the borehole backfill
                                after drilling. Also used to record backfill installed during well
                                construction or rock grouting activities</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the borehole casing installed while
                                drilling and/or after completion of drilling.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:BoreholeConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information regarding construction of the hole over
                                different depth intervals</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:BoreholeEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information about events recorded during construction of
                                the borehole.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:chiseling"/>
                    <element name="drillAdvancement" maxOccurs="unbounded" minOccurs="0"
                        type="diggs:DrillAdvancementArrayPropertyType">
                        <annotation>
                            <documentation>The drill advancement property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="flush" type="diggs:FlushPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information related to flushing the borehole with fluid
                                (eg. fluid type, return, fluid color, etc.) </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeDiameter"
                        type="diggs:BoreholeDiameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the borehole diameter with depth,
                                generally representing the bit size used within a borehole interval.
                                Detailed measurements of borehole derived from a caliper log is a
                                Test property resulting from a Wireline log procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterStrike" type="diggs:WaterStrikePropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on when ground water is struck during
                                drilling of the hole.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Advancement" type="diggs:AdvancementType">
        <annotation>
            <documentation>Object that carries drill advancement properties.</documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="AdvancementType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for advancement
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="location" type="diggs:LinearExtentPropertyType" minOccurs="1">
                        <annotation>
                            <documentation>The measured depth interval of the reported section of
                                the borehole. </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="time" type="diggs:TimeIntervalPropertyType" minOccurs="0">
                            <annotation>
                                <documentation>Start date/time, end date/time, and duration to
                                    advance the reported section of the borehole.</documentation>
                            </annotation>
                        </element>
                        <element name="elapsedTime" type="diggs:TimeMeasureType" minOccurs="0">
                            <annotation>
                                <documentation>The amount of time it took to advance over the
                                    reported interval. </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="advancementRate" type="diggs:LengthPerTimeMeasureType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The rate of advancement over the measured depth interval.
                                This property can be used in addition to or in lieu of time or
                                elapsedTime.</documentation>
                        </annotation>
                    </element>
                    <element name="downwardThrust" minOccurs="0" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Downward thrust on bit</documentation>
                        </annotation>
                    </element>
                    <element name="downthrustPressure" minOccurs="0"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Pressure of downthrust system</documentation>
                        </annotation>
                    </element>
                    <element name="energyDensity" minOccurs="0"
                        type="diggs:EnergyPerVolumeMeasureType">
                        <annotation>
                            <documentation>Specific energy</documentation>
                        </annotation>
                    </element>
                    <element name="fluidCirculationRate" minOccurs="0"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>Fluid (mud) circulation rate</documentation>
                        </annotation>
                    </element>
                    <element name="fluidPressurePump" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Fluid (usually mud) pressure at output of
                                pump</documentation>
                        </annotation>
                    </element>
                    <element name="fluidRecoveryRate" minOccurs="0"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>Fluid (mud) recovery rate</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidWeight"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>The mass per unit volume of a drilling fluid, synonymous
                                with fluid density or mud weight. </documentation>
                        </annotation>
                    </element>
                    <element name="hammeringUsed" minOccurs="0" type="boolean">
                        <annotation>
                            <documentation>True if drill stem was hammered while advancing (eg.
                                chiseling).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chiselingToolUsed" type="gml:StringOrRefType">
                        <annotation>
                            <documentation>Tool used to perform the chiseling. Intended to come from
                                a controlled list. NOTE: This is a string that could come from a
                                controlled list of terms, but could also reference an Equipment
                                metadata object.</documentation>
                        </annotation>
                    </element>
                    <element name="hammerPressure" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Supply pressure to downhole hammer</documentation>
                        </annotation>
                    </element>
                    <element name="mechanicalSpecificEnergy" minOccurs="0"
                        type="diggs:EnergyPerVolumeMeasureType">
                        <annotation>
                            <documentation>A measure of the energy required to remove a unit volume
                                of rock.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:penetrationRate"/>
                    <element name="restrainingForce" minOccurs="0" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Restraining (holdback) force</documentation>
                        </annotation>
                    </element>
                    <element name="restrainingPressure" minOccurs="0"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Pressure of restraining (holdback) system</documentation>
                        </annotation>
                    </element>
                    <element name="rotationalSpeed" minOccurs="0"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>Rotational speed of the drill head</documentation>
                        </annotation>
                    </element>
                    <element name="rotationalTorque" minOccurs="0"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>Rotational torque on the drill head</documentation>
                        </annotation>
                    </element>
                    <element name="torqueOnRods" minOccurs="0" type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>Torque applied to top of drill rods</documentation>
                        </annotation>
                    </element>
                    <element name="torquePressure" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Torque pressure</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Backfill" type="diggs:BackfillType">
        <annotation>
            <documentation>An object that contains properites associated with backfilling of a
                borehole. </documentation>
        </annotation>
    </element>
    <element name="BackfillLayer" type="diggs:BackfillLayerType">
        <annotation>
            <documentation>An object that carries properties for a layer of backfill
                material.</documentation>
        </annotation>
    </element>
    <complexType name="BackfillLayerPropertyType">
        <annotation>
            <documentation>Property type for backfill layer references. Used to wrap backfill layer
                objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BackfillLayer"/>
        </sequence>
    </complexType>
    <complexType name="BackfillLayerType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for backfill
                layer type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="backfillInterval"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>The depth interval in the borehole (measured in a linear
                                reference system), where the backfill material was emplaced. If
                                omitted, it is assumed that the backfill information pertains to the
                                entire length of the hole</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="whenEmplaced" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Indicates the date/time during which the backfill was
                                emplaced in this depth interval.</documentation>
                        </annotation>
                    </element>
                    <element name="backfillMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of material used as backfill (eg. bentonite,
                                cuttings, sand, etc.). Intended to come from a controlled list
                                assigned to an authority.</documentation>
                        </annotation>
                    </element>
                    <element name="isSanitarySeal" type="boolean" minOccurs="0">
                        <annotation>
                            <documentation>If true, identifies this backfill layer as a sanitary
                                seal.</documentation>
                        </annotation>
                    </element>
                    <element name="backfillVolume" type="diggs:VolumeMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The total valume of backfill material emplaced in this
                                layer</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutingActivityRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:GroutingActivity</appinfo>
                            <documentation>If pressure and flow rate time series are recorded for
                                this backfill layer, this information is stored in a grouting
                                activity feature. This property points to the grouting activity
                                corresponding to emplacement of this layer</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:GroutBatch</appinfo>
                            <documentation>If information is recorded about components of a Grout
                                used for backfill or as part of a grouting activity,this property
                                points to the GroutBatch object corresponding to the grout batch
                                used in this backfill layer.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellOpeningRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:GroutBatch</appinfo>
                            <documentation>If information is recorded about components of a Grout
                                used for backfill or as part of a grouting activity,this property
                                points to the GroutBatch object corresponding to the grout batch
                                used in this backfill layer.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="BackfillPropertyType">
        <annotation>
            <documentation>Property type for backfill references. Used to wrap backfill objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element minOccurs="1" ref="diggs:Backfill"/>
        </sequence>
    </complexType>
    <complexType name="BackfillType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for backfill
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="backfillDateTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The date/time interval over which the entire backfilling
                                operation was conducted. Date/time intervals can also be specified
                                for the emplacement of individual backfill layers in the
                                backfillLayers property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillLayer"
                        type="diggs:BackfillLayerPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The depth intervals where backfill is emplaced. The
                                backfill intervals should not overlap, nor should there be gaps
                                between intervals.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillType" type="diggs:backfillTypeEnumType">
                        <annotation>
                            <documentation>A controlled list of terms to indicate what type of
                                backfilling is described in the object. Choices are: annular space
                                within borehole - backfilling occurs within the annular space
                                between the outer casing and the natural borehole wall annular space
                                between casings - backfilling occurs within the annular space
                                between nested casings open hole - backfilling occurs within an open
                                hole within casing - backfilling occurs within the innermost
                                casing</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="backfillTypeEnumType">
        <annotation>
            <documentation>Enumeration defining backfill type enum type values. Contains 4 allowed
                value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="annular space within borehole">
                <annotation>
                    <documentation>annular space within borehole - annular space within borehole
                        value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="annular space within casings">
                <annotation>
                    <documentation>annular space within casings - annular space within casings
                        value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="open hole">
                <annotation>
                    <documentation>open hole - open hole value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="within casing">
                <annotation>
                    <documentation>within casing - within casing value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="Casing" type="diggs:CasingType">
        <annotation>
            <documentation>An object containing properties pertaining to borehole
                casing.</documentation>
        </annotation>
    </element>
    <complexType name="CasingPropertyType">
        <annotation>
            <documentation>Property type for casing references. Used to wrap casing objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Casing"/>
        </sequence>
    </complexType>
    <complexType name="CasingType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for casing type
                definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="casingLocation"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>The depth interval of the casing after fully installed
                                and advanced within the borehole. If omitted, it is assumed that the
                                casing information pertains to the entire length of the borehole or
                                well.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingOutsideDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The casing outside diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingInsideDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The casing inside diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingWallThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The casing wall thickness property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>The material that the casing is made of, eg. PVC,
                                stainless steel, etc. Intended to come from a controlled list of
                                terms.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="numberGroutPorts"
                        type="positiveInteger">
                        <annotation>
                            <documentation>If casing is an overburden casing as sleeve pipe (OCSP)
                                or other casing through which grout is injected, this property
                                records the number of ports in the casing.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="timeCasingInstalled"
                        type="diggs:TimeIntervalType">
                        <annotation>
                            <documentation>The time interval over which the casing was installed
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="timeCasingRemoved"
                        type="diggs:TimeIntervalType">
                        <annotation>
                            <documentation>The time interval during which the casing was removed
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="casingAdvancement"
                        type="diggs:CasingAdvancementPropertyType">
                        <annotation>
                            <documentation>The casing advancement property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="CasingAdvancement" type="diggs:CasingAdvancementType">
        <annotation>
            <documentation>If casing is advanced while drilling, or retracted during an activity,
                like grouting, this object records the time interval when casing
                advancement/retraction occurs, along with the start and end position of the casing
                bottom.</documentation>
        </annotation>
    </element>
    <complexType name="CasingAdvancementPropertyType">
        <annotation>
            <documentation>Property type for casing advancement references. Used to wrap casing
                advancement objects or references in properties.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:CasingAdvancement"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="CasingAdvancementType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for casing
                advancement type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="advancementTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Time at start and end of the casing advancement
                                interval</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBaseAtStart"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>The location of the bottom at the casing at the beginning
                                of the casing interval.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBaseAtEnd"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>The location of the bottom at the casing at the end of
                                the casing advancement interval.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBlows" type="positiveInteger">
                        <annotation>
                            <documentation>If casing is driven, the number of blows to drive the
                                casing the reported distance. Details about the process should be
                                reported in the relevant equipment or construction method
                                object.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CuttingToolArrayPropertyType">
        <annotation>
            <documentation>Property type for cutting tool array references. Used to wrap cutting
                tool array objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:CuttingTool"/>
        </sequence>
    </complexType>
    <element name="CuttingTool" type="diggs:CuttingToolType">
        <annotation>
            <documentation>The cutting tool property.</documentation>
        </annotation>
    </element>
    <complexType name="CuttingToolType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectType. Adds elements for
                cutting tool type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="toolType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of cutting tool (bit) used, such as hollow-stem
                                auger, tri-cone bit, roller bit, etc. Intended to come form a
                                controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element name="classIADC" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>For roller cone and fixed cutter (PDC) drill bits, the
                                four-character International Association of Drilling Contractors
                                code assigned to the bit</documentation>
                        </annotation>
                    </element>
                    <element name="make" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The manufacturer or brand of the cutting
                                tool</documentation>
                        </annotation>
                    </element>
                    <element name="modelNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The model name or number of the cutting
                                tool</documentation>
                        </annotation>
                    </element>
                    <element name="serialNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>The serial number that identifies the unique cutting
                                tool.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The inner diameter of the cuktting tool or bit (where
                                applicable, such as for a hollow stem auger).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The outer diameter of the cutting tool or
                                bit.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>The material that the tool is made from, eg. tungsten
                                carbide. Intended to come from a controlled list of
                                terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolWearStart" type="string">
                        <annotation>
                            <documentation>A qualitative or quantitative (eg. gauge ring diameter)
                                description of the tool condition (wear) at the start of the
                                interval.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolWearEnd" type="string">
                        <annotation>
                            <documentation>A qualitative or quantitative (eg. gauge ring diameter)
                                description of the tool condition (wear) at the end of the
                                interval.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DrillAdvancementArrayPropertyType">
        <annotation>
            <documentation>Property type for drill advancement array references. Used to wrap drill
                advancement array objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element maxOccurs="1" minOccurs="0" ref="diggs:Advancement">
                <annotation>
                    <documentation>Data describing drilling parameters and observations while
                        advancing a section of the borehole, such as drill advancement rate, mud
                        weight, thrust and rotational speed.</documentation>
                </annotation>
            </element>
        </sequence>
        <attribute name="setName" type="string">
            <annotation>
                <documentation>A value that identifies this set of Advancement objects to account
                    for redrilling over a specific depth range. Each set of Advancement objects
                    corresponds to a single drilling event over a speciic depth range that
                    encompasses the total depth range of the set of Advancement objects. Possible
                    values for setName could be "Initial", "Redrill 1", etc.</documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="DrillPipeType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectType. Adds elements for
                drill pipe type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="pipeInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The inner diameter of the drill pipe (where hollow pipe
                                is used).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The outer diameter of the drill pipe.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>The material that the pipe is made from, eg. steel.
                                Intended to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeSectionLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The length of each pipe section used for this depth
                                interval. Note: if pipe section lengths change, a new new DrillPipe
                                object should be instantiated to identify the depth interval for the
                                new pipe section length.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeSectcionWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Weight of an individual pipe section used in this
                                interval.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DrillPipeArrayPropertyType">
        <annotation>
            <documentation>Property type for drill pipe array references. Used to wrap drill pipe
                array objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="unbounded" minOccurs="1">
            <element ref="diggs:DrillPipe"/>
        </sequence>
    </complexType>
    <element name="DrillPipe" type="diggs:DrillPipeType">
        <annotation>
            <documentation>The drill pipe property.</documentation>
        </annotation>
    </element>
    <element name="Flush" type="diggs:FlushType">
        <annotation>
            <documentation>The flush property.</documentation>
        </annotation>
    </element>
    <complexType name="FlushPropertyType">
        <annotation>
            <documentation>Property type for flush references. Used to wrap flush objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Flush" maxOccurs="1" minOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="FlushType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for flush type
                definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="flushZoneLocation" type="diggs:LinearExtentPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>The depth interval of the flush zone, measured in a
                                linear reference system. If omitted, it is to be assumed that the
                                flushing activity pertains to the entire hole
                                length.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidType" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of fluid used for flushing. Intended to derive from
                                a controlled list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minFlushReturn"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>Percentage of fluid that returns from the hole following
                                flushing. (minimum value)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxflushReturn"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>Percentage of fluid that returns from the hole following
                                flushing. (maximum value)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="flushColor" type="string">
                        <annotation>
                            <documentation>Color of the fluid return; an uncontrolled
                                string.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="WaterStrike" type="diggs:WaterStrikeType">
        <annotation>
            <documentation>A water strike consists of one or more water level readings taken upon
                encountering or expecting to encounter water during drilling. Depending on practice,
                this may consist of individual reasurements taken one or more times as drilling
                progresses or a series of measurements taken over a short time interval when
                drilling is halted at a particular depth.</documentation>
        </annotation>
    </element>
    <complexType name="WaterStrikePropertyType">
        <annotation>
            <documentation>Property type for water strike references. Used to wrap water strike
                objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:WaterStrike"/>
        </sequence>
    </complexType>
    <element name="WaterStrikeReading" type="diggs:WaterStrikeReadingType">
        <annotation>
            <documentation>An element containing water level reading properties following a water
                strick.</documentation>
        </annotation>
    </element>
    <element name="LinkedWSReading" type="diggs:LinkedWSReadingType">
        <annotation>
            <documentation>An element containing water level reading properties following a water
                strick.</documentation>
        </annotation>
    </element>
    <complexType name="WaterStrikeReadingPropertyType">
        <annotation>
            <documentation>Property type for water strike reading references. Used to wrap water
                strike reading objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:WaterStrikeReading"/>
        </sequence>
    </complexType>
    <complexType name="LinkedWSReadingPropertyType">
        <annotation>
            <documentation>Property type for linked ws reading references. Used to wrap linked ws
                reading objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:LinkedWSReading"/>
        </sequence>
    </complexType>
    <complexType name="WaterStrikeReadingType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for water strike
                reading type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="elapsedTime" type="diggs:TimeMeasureType">
                            <annotation>
                                <documentation>The elapsed time following an initial water strike
                                    when water level is again measured</documentation>
                            </annotation>
                        </element>
                        <element name="dateTime" type="gml:TimePositionType" minOccurs="1">
                            <annotation>
                                <documentation>DateTime that water strike measurement
                                    occurred.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice>
                        <element name="notEncountered" fixed="true" type="boolean" minOccurs="1">
                            <annotation>
                                <documentation>The not encountered property.</documentation>
                            </annotation>
                        </element>
                        <element name="waterLocation" type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>The measure depth to water; measured in a hole's
                                    linear referencing system.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="unbounded" minOccurs="0" name="linkedReading"
                        type="diggs:LinkedWSReadingPropertyType">
                        <annotation>
                            <documentation>The linked reading property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LinkedWSReadingType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for linked ws
                reading type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="elapsedTime" type="diggs:TimeMeasureType">
                            <annotation>
                                <documentation>The elapsed time following an initial water strike
                                    when water level is again measured</documentation>
                            </annotation>
                        </element>
                        <element name="dateTime" type="gml:TimePositionType" minOccurs="1">
                            <annotation>
                                <documentation>DateTime that water strike measurement
                                    occurred.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice>
                        <element name="notEncountered" fixed="true" type="boolean" minOccurs="1">
                            <annotation>
                                <documentation>The not encountered property.</documentation>
                            </annotation>
                        </element>
                        <element name="waterLocation" type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>The measure depth to water; measured in a hole's
                                    linear referencing system.</documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="WaterStrikeType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for water strike
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence minOccurs="0">
                    <element name="waterStrikeReadings" type="diggs:WaterStrikeReadingPropertyType">
                        <annotation>
                            <documentation>Water level readings taken as part of this water
                                strike.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sealLocation"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Location at which water strike is sealed by casing;
                                measured in borehole linear referencing system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bottomCasing"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured depth to base of casing at time water strike
                                occurred; measured in borehole linear referencing
                                system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bottomHole" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Location of the bottom of the hole when the water strike
                                readings are made, given in the hole's linear referencing
                                system.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SOUNDING ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Sounding"
        substitutionGroup="diggs:AbstractLinearSamplingFeature" type="diggs:SoundingType">
        <annotation>
            <documentation>A sampling feature that is created by a measurement or construction
                activity through insertion of a probe or toolinto the ground. </documentation>
        </annotation>
    </element>
    <element name="SoundingConstructionMethod" type="diggs:SoundingConstructionMethodType">
        <annotation>
            <documentation>An object that contains properties of the construction of a sounding
                sampling feature.</documentation>
        </annotation>
    </element>
    <complexType name="SoundingConstructionMethodPropertyType">
        <annotation>
            <documentation>Property type for sounding construction method references. Used to wrap
                sounding construction method objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:SoundingConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="SoundingConstructionMethodType">
        <annotation>
            <documentation>Extended type based on AbstractNamedRoleObjectType. Adds elements for
                sounding construction method type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The location within the sampling feature that corresponds
                                to the particular construction method being referenced here. If
                                omitted, it is assumed that the procedures specified apply to the
                                entire extent of the sampling feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time during which the construction event is
                                occurring</documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>Properties describing the method by which the borehole is
                                constructed over this location interval</documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>A property element that contains an Equipment feature (or
                                reference to one) that details the construction equipment
                                used.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SoundingEvent" type="diggs:SoundingEventType">
        <annotation>
            <documentation>An object that contains properties describing a location or time based
                event that occurs during contstruction of a sounding sampling
                feature.</documentation>
        </annotation>
    </element>
    <complexType name="SoundingEventPropertyType">
        <annotation>
            <documentation>Property type for sounding event references. Used to wrap sounding event
                objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:SoundingEvent"/>
        </sequence>
    </complexType>
    <complexType name="SoundingEventType">
        <annotation>
            <documentation>Extended type based on AbstractEventType. Adds elements for sounding
                event type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="casingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured Depth to Base of Casing installed at this event
                                time, in the sounding's linear referencing system. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="soundingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>Measured Depth to Base of the sounding at this event
                                time, reported in the sounding's linear referencing
                                system.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SoundingType">
        <annotation>
            <documentation>Extended type based on AbstractLinearSamplingFeatureType. Adds elements
                for sounding type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time when the sounding is constructed. This
                                should include the entire time the drill rig is on
                                site.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalMeasuredDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The measured depth to the bottom of the hole, measured in
                                a hole's linear referencing system.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="soundingPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the purpose for the sounding. Intended
                                to come from a controlled list (eg. CPT, Flat Dilatometer,
                                etc).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType">
                        <annotation>
                            <documentation>Information on construction of the backfill after the
                                sounding is made.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the casing installed following or during
                                the sounding</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:SoundingConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information regarding construction of the sounding over
                                different depth intervals</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:SoundingEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on sounding construction events with
                                time.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TRIAL PIT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="TrialPit" substitutionGroup="diggs:AbstractLinearSamplingFeature"
        type="diggs:TrialPitType">
        <annotation>
            <documentation>A relatively shallow excavation into the earth's surface, dug either
                manually or by a mechanical excavator. Samples,observations and tests in the trial
                pit are referenced in a linear referencing system only (1D). This is a legacy
                sampling feature to support AGS trial pit constructs. The TrenchWall sampling
                feature should be used to represent more detail on walls of pits or trenches in
                2D.</documentation>
        </annotation>
    </element>
    <element name="TrialPitEvent" type="diggs:TrialPitEventType">
        <annotation>
            <documentation>The trial pit event property.</documentation>
        </annotation>
    </element>
    <complexType name="TrialPitEventPropertyType">
        <annotation>
            <documentation>Property type for trial pit event references. Used to wrap trial pit
                event objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TrialPitEvent"/>
        </sequence>
    </complexType>
    <complexType name="TrialPitEventType">
        <annotation>
            <documentation>Extended type based on AbstractEventType. Adds elements for trial pit
                event type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="depth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Measured Depth to base of the pit or trench at this event
                                time, reported in the pit's linear referencing
                                system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="length" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The horizontal length of the long dimension of the pit or
                                trench at this event time.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="width" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The horizontal length of the short dimension of the pit
                                or trench at this event time.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stability" type="string">
                        <annotation>
                            <documentation>Uncontrolled string describing stability conditions of
                                the pit or trench at this point in time.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TrialPitType">
        <annotation>
            <documentation>Extended type based on AbstractLinearSamplingFeatureType. Adds elements
                for trial pit type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time when the hole is constructed. This
                                should include the entire time the drill rig is on
                                site.</documentation>
                        </annotation>
                    </element>
                    <element name="totalMeasuredDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The maximum depth of the pit, referenced to a linear
                                reference system.</documentation>
                        </annotation>
                    </element>
                    <element name="pitLength" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>The length of the long horizontal dimension of the pit.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pitWidth" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>The length of the short horizontal dimension of the
                                pit.</documentation>
                        </annotation>
                    </element>
                    <element name="shoring" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Description of shoring equipment and
                                method.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="trialPitPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the purpose for excavating the pit (eg.
                                exploratory). Intended to come from a controlled
                                list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType">
                        <annotation>
                            <documentation>Information on construction of the trial pit
                                backfill.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:TrenchConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information regarding construction of the pit over
                                different depth intervals</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:TrialPitEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on construction of the trial pit with
                                time</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TrenchConstructionMethod" type="diggs:TrenchConstructionMethodType">
        <annotation>
            <documentation>An object that contains properties related to the method of construction
                of a trench wall or trial pit sampling feature.</documentation>
        </annotation>
    </element>
    <complexType name="TrenchConstructionMethodPropertyType">
        <annotation>
            <documentation>Property type for trench construction method references. Used to wrap
                trench construction method objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TrenchConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="TrenchConstructionMethodType">
        <annotation>
            <documentation>Extended type based on AbstractNamedRoleObjectType. Adds elements for
                trench construction method type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>The location within the sampling feature that corresponds
                                to the particular construction method being referenced here. If
                                omitted, it is assumed that the procedures specified apply to the
                                entire extent of the sampling feature</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>The period of time during which the construction event is
                                occurring</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trenchStability" type="string">
                        <annotation>
                            <documentation>Uncontrolled string describing stability conditions of
                                the trench during this interval</documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:Specification</appinfo>
                            <documentation>A property element that supports a value by reference
                                only. The target value is indicated in the appinfo
                                element.</documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>A property element that contains an Equipment feature (or
                                reference to one) that details the construction equipment
                                used.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- WELL ELEMENTS                                                                      -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Well" substitutionGroup="diggs:AbstractLinearInstallation"
        type="diggs:WellType">
        <annotation>
            <documentation>A sampling feature that is an installation within a borehole or sounding,
                used for observing, withdrawing, or injecting fluids. Although wells are discrete
                sampling features in their own right, they are installed within boreholes or
                soundings, and must reference the parent borehole or sounding feature within the
                mandatory samplingFeatureRef property.</documentation>
        </annotation>
    </element>
    <element name="WellOpening" type="diggs:WellOpeningType">
        <annotation>
            <documentation>An object containing properties that define the location and
                characteristics of a well screen or perforations within a Well sampling
                feature.</documentation>
        </annotation>
    </element>
    <complexType name="WellOpeningPropertyType">
        <annotation>
            <documentation>Property type for well opening references. Used to wrap well opening
                objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:WellOpening"/>
        </sequence>
    </complexType>
    <complexType name="WellOpeningType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for well opening
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" name="openInterval" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>The depth interval in which the well openings occur.
                                Recorded in a linear reference system for the well.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:filterPackInterval"/>
                    <element minOccurs="0" name="openingLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The opening length property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The opening width property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The opening diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of well screen or perforation (eg. wire-wound
                                screen, louvered or shuttered, perforated casing,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of material that the well screen or perforation
                                interval is composed of.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="WellType">
        <annotation>
            <documentation>Extended type based on AbstractLinearInstallationType. Adds elements for
                well type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLinearInstallationType">
                <sequence>
                    <element minOccurs="0" name="aquiferTested" type="gml:CodeType">
                        <annotation>
                            <documentation>Name or other identifier for the aquifer being sampled by
                                the well.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>If a production or extraction well, a code or description
                                of the purpose for the fluid (eg. public supply, municipal,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialDevelopmentMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>Description of the method used to develop the well after
                                initial construction (eg. compressed air, surged,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialDevelopmentTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>Time required for initial development </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maintenanceEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the occurrence and activities involved in
                                well maintenance and servicing.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="opening" type="diggs:WellOpeningPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the location and type of well openings
                                (perforations) installed to allow fluid communication between the
                                well and adjacent earth material</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:sanitarySealLocation"/>
                    <element minOccurs="0" ref="diggs:sanitarySealType">
                        <annotation>
                            <documentation/>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specialTreatment" type="string">
                        <annotation>
                            <documentation>Description of any special procedures employed upon
                                initial development of well.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellAbandonment"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the occurrence and procedures performed
                                upon abandoning the well</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellCasing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Information on the type and location of the solid well
                                casing installed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The measured depth to the bottom of the well, measured
                                from the top of the well casing or the well's centerline origin if
                                different from top of casing</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellFinishType" type="gml:CodeType">
                        <annotation>
                            <documentation>Description of how the well is finished (eg. gravel pack
                                with perforations, open end, sand point, etc.) </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="wellPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the purpose for installing the hole (eg.
                                ground water withdrawal, observation, etc.). Intended to come from a
                                controlled list.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SamplingFeaturePropertyType">
        <annotation>
            <documentation>Property type for including or referencing sampling feature
                objects,</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractSamplingFeature"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SAMPLING ACTIVITY ELEMENTS                                                         -->
    <!-- ================================================================================== -->

    <element abstract="false" name="SamplingActivity"
        substitutionGroup="diggs:AbstractSamplingActivity" type="diggs:SamplingActivityType">
        <annotation>
            <documentation>The action taken to obtain or produce material samples even if the
                activity fails to produce a sample (eg. a core run that produces no recovery). The
                activity type must be specified, and indicates if the produced sample(s) are a
                result of collection at a sampling feature, sub-sampling, aggregation of two or more
                samples, or a sample created as a test or blank sample. All samples must refer to a
                SamplingActivity feature.</documentation>
        </annotation>
    </element>
    <complexType name="SamplingActivityType">
        <annotation>
            <documentation>Concrete type extending AbstractSamplingActivityType. Provides
                implementation for sampling activity type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingActivityType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ActivityTypeEnumType">
        <annotation>
            <documentation>Enumeration defining activity type enum type values. Contains 6 allowed
                value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="aggregate">
                <annotation>
                    <documentation>aggregate - aggregate value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="collect">
                <annotation>
                    <documentation>collect - collect value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>none - none value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="subsample">
                <annotation>
                    <documentation>subsample - subsample value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="test">
                <annotation>
                    <documentation>test - test value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="unknown">
                <annotation>
                    <documentation>unknown - unknown value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>

    <!-- ================================================================================== -->
    <!-- SAMPLE ELEMENTS                                                                    -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Sample" substitutionGroup="diggs:AbstractSample"
        type="diggs:SampleType">
        <annotation>
            <documentation>A material sample, either solid, fluid, or gas that is obtained as a
                result of a sampling activity, for the purpose of observation and/or testing. This
                is a concrete representation of AbstractSample, which serves as the head of a
                substitution group for this and other sample specialties.</documentation>
        </annotation>
    </element>
    <complexType name="SampleType">
        <annotation>
            <documentation>Extended type based on AbstractSampleType. Adds elements for sample type
                definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSampleType">
                <sequence>
                    <element name="relativeReferencingSystem"
                        type="diggs:RelativeReferenceSystemPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>For a core or block sample, this property can be used to
                                introduce a relative spatial reference system for describing the
                                sample relative to a position on the sample instead of relative to
                                the sampling feature's origin. In this case, the linearElement
                                property of diggs:LinearSpatialReferenceSystem would reference the
                                sample's location instead of the sampling feature's.

                                NOT ITSELF DEPRECATED, unlike the planar and volumetric relative
                                referencing properties on sampling features - this states where a
                                position sits WITHIN a sample, which diggs:LocalCartesianCRS does
                                not supersede. But note that one of the three branches its property
                                type admits, diggs:VectorLinearSpatialReferenceSystem, IS deprecated
                                as of 1/26; an earlier version of this documentation named it here
                                as an equal alternative and no longer does. Use
                                diggs:LinearSpatialReferenceSystem, or a
                                diggs:LocalCartesianCRS. </documentation>
                        </annotation>
                    </element>
                    <element name="relativeReferenceSystemOrigin" minOccurs="0" maxOccurs="1"
                        type="diggs:relativeReferenceSystemOriginEnumType">
                        <annotation>
                            <documentation>For a core or block sample where the vertical orientation
                                of the sample is preserved, identifies whether the origin of the
                                relative reference system (where the linear element is the sample
                                location defined in the associated SamplingActivity) occurs at the
                                top or the bottom of the sample</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="classification" type="diggs:SampClassEnumType">
                        <annotation>
                            <documentation>A definition of the class of sample collected, such as
                                soil, rock, fluid, etc.). Intended to come from a controlled
                                list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of sample, informational and intended to come from a
                                controlled list of terms. These can include general terms such as
                                "bulk" and "core", but often sample type is organization specific
                                and may incorporate information that identifies the sample class
                                (eg. "water"), sampler used (eg. "piston sample"), method (eg. "push
                                sample"), condition (eg. "undisturbed thin wall tube sample"),
                                purpose (eg. "soil sample for environmental testing"), or associated
                                with a specific test or activity ("SPT sample"). All are appropriate
                                terms to serve as a shorthand for inforation provided by other
                                sample or associated sampling activity properties. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="condition" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the sample condition following
                                collection or production; intended to come from a controlled list of
                                terms (eg. Disturbed). This term appies to the entire sample. If a
                                core sample has different types and intensity of disturbance along
                                its length, this should be described as a constituent in the
                                LithologyObservation of the sample.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extrusionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>Method by which the sample is removed from its
                                sampler.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialContainer"
                        type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>The initial container property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>Purpose of taking this sample. This is an uncontrolled
                                string that describes the test or tests that are intended to be run
                                on this sample.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Weight of the sample following collection or production
                                and prior to any subsampling or specimen preparation</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>Volume of the sample following collection or production
                                and prior to any subsampling or specimen preparation</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleDimensions"
                        type="diggs:SampleDimensionsPropertyType">
                        <annotation>
                            <documentation>The sample dimensions property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleMatrix" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the sample matrix, if applicable. This
                                is intended to come from a controlled list.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialPreservationMethod" type="string">
                        <annotation>
                            <documentation>Description of methods used to preserve integrity of the
                                sample </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chainOfCustodyEvent"
                        type="diggs:ChainOfCustodyEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Contains information on the chain-of-custody for the
                                sample</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSampleProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>The other sample property property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coreDistkurbance" type="gml:CodeType">
                        <annotation>
                            <documentation>For describing a core sample of rock or soil, a
                                description of the kind and intensity of disturbance to the core
                                sample as a result of the sampling process. Common terms are
                                biscuiting, fluid intrusion, drilling breccia, fractured, moderately
                                disturbed, soupy, partial void, etc. Intended to come from a
                                controlled list of terms.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="SampClassEnumType">
        <annotation>
            <documentation>Union type for samp class enum type. Accepts values from OtherNameType or
                SampleClassificationEnumType.</documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:SampleClassificationEnumType"/>
    </simpleType>
    <simpleType name="SampleClassificationEnumType">
        <annotation>
            <documentation>Enumeration defining sample classification enum type values. Contains 7
                allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Cement">
                <annotation>
                    <documentation>Cement - cement value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Chemical">
                <annotation>
                    <documentation>Chemical - chemical value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Fluid">
                <annotation>
                    <documentation>Fluid - fluid value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Gas">
                <annotation>
                    <documentation>Gas - gas value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Grout">
                <annotation>
                    <documentation>Grout - grout value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Rock">
                <annotation>
                    <documentation>Rock - rock value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Soil">
                <annotation>
                    <documentation>Soil - soil value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="ChainOfCustodyEvent" type="diggs:ChainOfCustodyEventType">
        <annotation>
            <documentation>An object containing properties pertaining to the chain of custody of a
                sample.</documentation>
        </annotation>
    </element>
    <complexType name="ChainOfCustodyEventPropertyType">
        <annotation>
            <documentation>Property type for chain of custody event references. Used to wrap chain
                of custody event objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ChainOfCustodyEvent" minOccurs="1"/>
        </sequence>
    </complexType>
    <complexType mixed="false" name="ChainOfCustodyEventType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectType. Adds elements for
                chain of custody event type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="sourceCustodian"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation> A reference to the BusinessAssociate object that is
                                releasing custody of the sample.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="destinationCustodian"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation> A reference to the BusinessAssociate object that is
                                receiving custody of the sample.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateInitiated" type="gml:TimePositionType">
                        <annotation>
                            <documentation>Date that sample was shipped or date that chain of
                                custody event was initiated</documentation>
                        </annotation>
                    </element>
                    <element name="dateCompleted" type="gml:TimePositionType" minOccurs="0">
                        <annotation>
                            <documentation>Date that sample was received or date that chain of
                                custody event was completed</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleContainer" type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>Information about the sample container, if repackaged
                                from the initial container.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shippingContainer"
                        type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>Information about the container that the sample
                                containers are transported in.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="storageLocation"
                        type="diggs:LocalityPropertyType">
                        <annotation>
                            <documentation>The location of the sample once it has reached it's
                                destination. Can be expressed as properties of a Locality object
                                (eg. address or other local term describing location, or as a
                                coordinate point (PointLocation) </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="Container" type="diggs:ContainerType">
        <annotation>
            <documentation>A physical object that holds a sample</documentation>
        </annotation>
    </element>
    <complexType name="ContainerPropertyType">
        <annotation>
            <documentation>Property type for container references. Used to wrap container objects or
                references in properties.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Container" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="ContainerType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for container
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="containerLabel" type="string">
                        <annotation>
                            <documentation>Identifier listed on the container holding the sample.
                                This might be a box number (if for core) or sample number, or the
                                same value as the sample name</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerType" type="gml:CodeType">
                        <annotation>
                            <documentation>Description of container for the sample; intended to be
                                derived from a controlled list. Example:Jar, Bucket, Vial, Bag,
                                Box</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>Description of the material that the container is made
                                of.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Height of the container</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length of the container</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>Volume of the container</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Weight of the container</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Width of the container</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="preservativeAdded" type="gml:CodeType">
                        <annotation>
                            <documentation>Example:The type of preservative added to sample, if
                                any.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="relativeReferenceSystemOriginEnumType">
        <annotation>
            <documentation>Enumeration defining relative reference system origin enum type values.
                Contains 2 allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="top of sample">
                <annotation>
                    <documentation>top of sample - top of sample value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="bottom of sample">
                <annotation>
                    <documentation>bottom of sample - bottom of sample value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="SampleDimensions" type="diggs:SampleDimensionsType">
        <annotation>
            <documentation>For solid soil or rock samples, contains properties on the sample
                dimensions </documentation>
        </annotation>
    </element>
    <complexType name="SampleDimensionsType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectBaseType. Adds elements for
                sample dimensions type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.Any comment or remark associated with this specific
                                feature, the person or organization making the comment, and the time
                                comment was made.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="diameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>For core or cylindrical samples, the diameter of the
                                sample</documentation>
                        </annotation>
                    </element>
                    <element name="height" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>For block samples, the length of one of the sides of the
                                block measured normal to the sampling direction</documentation>
                        </annotation>
                    </element>
                    <element name="length" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>For block or core samples, the length of the sample
                                measured in the sampling direction (eg. core length or length of
                                block sample as measured between the top and base of the sampling
                                interval)</documentation>
                        </annotation>
                    </element>
                    <element name="width" type="diggs:LengthMeasureType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>For block samples, the length of one of the sides of the
                                block measured normal to the sampling direction</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SampleDimensionsPropertyType">
        <annotation>
            <documentation>Property type for sample dimensions references. Used to wrap sample
                dimensions objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SampleDimensions"/>
        </sequence>
    </complexType>
    <complexType name="SamplePropertyType">
        <annotation>
            <documentation>Property type for sample references. Used to wrap sample objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractSample"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DISCONTINUITY OBSERVATION SYSTEM ELEMENTS                                          -->
    <!-- ================================================================================== -->

    <complexType name="DiscontinuityObservationType">
        <annotation>
            <documentation>A discontinuity or zone of discontinuities</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element name="fractureObservation" type="diggs:FractureObservationPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>The fracture observation property.</documentation>
                        </annotation>
                    </element>
                    <element name="fractureSpacing" minOccurs="0"
                        type="diggs:FractureSpacingPropertyType">
                        <annotation>
                            <documentation>The fracture spacing property.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>Description of the boundary at the base of the observed
                                zone or interval as defined in the observation's location
                                property</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DiscontinuityObservation" type="diggs:DiscontinuityObservationType">
        <annotation>
            <documentation>Descriptions of faults, fractures and joints and their spacing, with
                attendant mechanical and hydraulic properties. Individual discontinuities or zone of
                discontinuities within a discontinuity system may overlap.</documentation>
        </annotation>
    </element>
    <complexType name="DiscontinuityObservationPropertyType">
        <annotation>
            <documentation>Property type for discontinuity observation references. Used to wrap
                discontinuity observation objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:DiscontinuityObservation"/>
        </sequence>
    </complexType>
    <element name="DiscontinuitySystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:DiscontinuitySystemType">
        <annotation>
            <documentation>An object that contains a system of discontinuity
                observations.</documentation>
        </annotation>
    </element>
    <complexType name="DiscontinuitySystemType">
        <annotation>
            <documentation>Extended type based on AbstractObservationSystemType. Adds elements for
                discontinuity system type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="discontinuityType" type="gml:CodeType">
                        <annotation>
                            <documentation>The kind of Discontinuity system described (eg. Joints).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="discontinuityObservation"
                        type="diggs:DiscontinuityObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The discontinuity observation property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FractureObservation" type="diggs:FractureObservationType">
        <annotation>
            <documentation>An object containing properties of a fracture
                observation.</documentation>
        </annotation>
    </element>
    <complexType name="FractureObservationPropertyType">
        <annotation>
            <documentation>Property type for fracture observation references. Used to wrap fracture
                observation objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:FractureObservation"/>
        </sequence>
    </complexType>
    <complexType name="FractureObservationType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for fracture
                observation type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="aperatureMeasurement"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Discontinuity aperture measurement</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="aperatureObservation" type="string">
                        <annotation>
                            <documentation>Discontinuity aperture observation</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dipAngle" type="diggs:DipMeasureType">
                        <annotation>
                            <documentation>Dip of discontinuity, a plane angle measurement measured positive down from the horizontal</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dipDirection" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>Dip direction of discontinuity</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="discontinuityNumber" type="integer">
                        <annotation>
                            <documentation>Discontinuity number</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureSetNumber" type="string">
                        <annotation>
                            <documentation>Discontinuity set reference number</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="infillMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>Infilling material</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="infillHardness" type="gml:CodeType">
                        <annotation>
                            <documentation>Hardness of the infill material</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="jointRoughnessCoefficient" type="double">
                        <annotation>
                            <documentation>Joint Roughness Coefficient</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="persistence" type="double">
                        <annotation>
                            <documentation>Persistence measurement</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="planarity" type="gml:CodeType">
                        <annotation>
                            <documentation>Intermediate scale planarity (ISRM 1978)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="roughness" type="gml:CodeType">
                        <annotation>
                            <documentation>Small scale roughness (ISRM 1978)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seepageRating" type="gml:CodeType">
                        <annotation>
                            <documentation>Seepage rating (ISRM 1978)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceAppearance" type="string">
                        <annotation>
                            <documentation>Surface appearance</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="termination" type="gml:CodeType">
                        <annotation>
                            <documentation>Discontinuity termination (lower, upper) (ISRM
                                1978)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of discontinuity</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wallStrength" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>Discontinuity wall strength</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wallWeathering" type="gml:CodeType">
                        <annotation>
                            <documentation>Discontinuity wall weathering</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureHealing" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of fracture healing or the state of healed
                                fractures in rock. These might include mineral
                                filling/mineralization (eg. crystallization, precipitation),
                                physical charactceristics (eg. cementation, recrystallization),
                                quality descriptors (eg. partial healing, etc.) and age/time of
                                healing (eg. ancient, recent).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterFlow" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>Water flow estimate</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wavinessAmplitude" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Large scale waviness, amplitude (ISRM
                                1978)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wavinessWavelength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Large scale waviness, wavelength (ISRM
                                1978)</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>A value that describes the method by which the observation or
                            measurement was determined. </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="FractureSpacing" type="diggs:FractureSpacingType">
        <annotation>
            <documentation>An object containing properties describing the spacing between
                fractures.</documentation>
        </annotation>
    </element>
    <complexType name="FractureSpacingPropertyType">
        <annotation>
            <documentation>Property type for fracture spacing references. Used to wrap fracture
                spacing objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:FractureSpacing"/>
        </sequence>
    </complexType>
    <complexType name="FractureSpacingType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for fracture
                spacing type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence minOccurs="1">
                    <element minOccurs="0" name="minSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Minimum Fracture Spacing over zone</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Maximum Fracture Spacing over zone</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averageSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Average Fracture Spacing over zone</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureCount" type="positiveInteger">
                        <annotation>
                            <documentation>The number of fractures identified within the extent of
                                the DiscontinuityObservation.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fracturesPerUnitLength"
                        type="diggs:ReciprocalLengthMeasureType">
                        <annotation>
                            <documentation>Number of fractures per unit length as specified in the
                                uom attribute. This is a property included for compatibility with an
                                AGS field but should generally not be otherwise used, as it is
                                borehole specific and can be calculated from fractureCount and the
                                length of the LinearExtent reported for the
                                DiscontinuityObservation</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="placedObservation" type="diggs:PlacedObservationPropertyType">
        <annotation>
            <documentation>The placed observation property.</documentation>
        </annotation>
    </element>
    <element name="PlacedObservation" type="diggs:PlacedObservationType">
        <annotation>
            <documentation>A component object that identifies an observation (as a text string) that
                is assigned to a geographic location. This object is used to locate general
                observations within a Observation object of an ObservationSystem</documentation>
        </annotation>
    </element>
    <complexType name="PlacedObservationPropertyType">
        <annotation>
            <documentation>Property type for placed observation references. Used to wrap placed
                observation objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:PlacedObservation"/>
        </sequence>
    </complexType>
    <complexType name="PlacedObservationType">
        <annotation>
            <documentation>Extended type based on AbstractComponentObjectBaseType. Adds elements for
                placed observation type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element ref="diggs:location"/>
                    <element minOccurs="1" name="observation" type="string" maxOccurs="1">
                        <annotation>
                            <documentation>A description of the lithologies that make up a
                                subsidiary portion of the overall lithologic classification of the
                                layer or sample, or exist as specific components of the
                                primarylithology property</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GEOUNIT OBSERVATION SYSTEM ELEMENTS                                                -->
    <!-- ================================================================================== -->

    <element name="GeoUnitObservation" type="diggs:GeoUnitObservationType">
        <annotation>
            <documentation>Descriptions of a soil or rock where the unit is primarily defined by the
                value(s) or a value range of one or more physical or engineering properties. The
                criteria for distinguishing such units may vary depending on the engineering
                application.</documentation>
        </annotation>
    </element>
    <complexType name="GeoUnitObservationType">
        <annotation>
            <documentation>Extended type based on AbstractObservationType. Adds elements for geo
                unit observation type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element minOccurs="1" name="unitName" type="gml:CodeType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The name of the unit (eg. Unit A) assigned to this
                                zone.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitDescription" type="string">
                        <annotation>
                            <documentation>An optional description of the named unit</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDistanceToTopOfUnit"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>When encountered in a linear sampling feature, the
                                vertical distance to the top (or beginning) of the unit, measured
                                from the feature's reference point.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDistanceToBaseOfUnit"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>When encountered in a linear sampling feature, the
                                vertical distance to the base (or end) of the unit, measured from
                                the feature's reference point.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="topElevation"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>The absolute elevation of the top of the unit. Added
                                (S10; RI_Program_Architecture.md §6.3(b)) alongside
                                verticalDistanceToTopOfUnit rather than replacing it: that element
                                is correct for a single log, where "distance from the feature's
                                reference point" is exactly the right frame, but wrong for a
                                site-wide model synthesized across many boreholes, where a unit's
                                top is a level shared across the model, not an offset from any one
                                borehole's collar.

                                diggs:PointLocationPropertyType, for consistency with how every
                                other elevation in DIGGS is carried: that type holds srsName
                                natively and supports one-dimensional, linear-referenced and
                                three-dimensional frames alike, so a level stated in a vertical CRS
                                is expressed as a one-dimensional position. AN EARLIER DRAFT typed
                                this diggs:ElevationType, a scalar, arguing that a level interpreted
                                for a unit has no single point on that unit's surface it is uniquely
                                the position of. That argument is RETRACTED, and diggs:ElevationType
                                has been removed from the schema.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baseElevation"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>The absolute elevation of the base of the unit. See
                                topElevation.</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="verticalThicknessOfUnit" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    Thickness of the unit, measured vertically. This would be
                                    the difference between the verticalDistanceToBaseOfUnit -
                                    verticalDistanceToTopOfUnit.
                            </documentation>
                            </annotation>
                        </element>
                        <element name="verticallThicknessOfUnit" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>DEPRECATED 8/26. Misspelling; use verticalThicknessOfUnit.</appinfo>
                                <documentation>DEPRECATED 8/26. Misspelling; use
                                    verticalThicknessOfUnit.

                                    Thickness of the unit, measured vertically. This would be
                                    the difference between the verticalDistanceToBaseOfUnit -
                                    verticalDistanceToTopOfUnit.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="unbounded" minOccurs="0" name="characteristicProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>A Parameter object that describes the name, value, or
                                range of values of a property characteristic of this
                                unit.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>Widened from maxOccurs=1 (S10; RI_Program_
                                Architecture.md §6.3(c)): diggs:baseBoundary's own documentation
                                already states multiple properties are allowed "in the case of
                                planar or volume representations where the character of the
                                boundary may change along its length or surface" - exactly the
                                ground-model case, where a unit's base may change character across
                                a surface. Two sibling observation types (LithologyObservationType
                                here; the color observation type in extended/ExtObservation.xsd)
                                already declare it unbounded; GeoUnitObservationType carried the
                                restrictive default, contrary to what the element
                                promises.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GeoUnitObservationPropertyType">
        <annotation>
            <documentation>Property type for geo unit observation references. Used to wrap geo unit
                observation objects or references in properties.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:GeoUnitObservation" maxOccurs="1">
                <annotation>
                    <documentation>A geotechnical unit defined within a project and generally
                        identified by one or more characteristic physical or engineering
                        properties.</documentation>
                </annotation>
            </element>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="GeoUnitSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:GeoUnitSystemType">
        <annotation>
            <documentation>An object containing a system of geostechnical unit observations.
                Observations. Geotechnical units are bodies of earth material distinguished by one
                or more characteristic engineering properties. Observations within a geounit system
                must not overlap.</documentation>
        </annotation>
    </element>

    <!-- ================================================================================== -->
    <!-- LITHOLOGY OBSERVATION SYSTEM ELEMENTS                                              -->
    <!-- ================================================================================== -->

    <complexType name="GeoUnitSystemType">
        <annotation>
            <documentation>Extended type based on AbstractObservationSystemType. Adds elements for
                geo unit system type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="geoUnitType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>A type or class designation for the GeoUnit. Optional,
                                intended to come from a controlled list.</documentation>
                        </annotation>
                    </element>
                    <element name="geoUnitObservation" type="diggs:GeoUnitObservationPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The geo unit observation property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Lithology" type="diggs:LithologyType">
        <annotation>
            <documentation>An object containing the properties of a lithology
                description.</documentation>
        </annotation>
    </element>
    <simpleType name="LithologyCharacterEnumType">
        <annotation>
            <documentation>Enumeration defining lithology character enum type values. Contains 3
                allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="disseminated">
                <annotation>
                    <documentation>This lithology is uniformly distributed as a component that
                        serves to classify the primary lithology, such as sand within a sandy clay
                        primary lithology</documentation>
                </annotation>
            </enumeration>
            <enumeration value="interbedded">
                <annotation>
                    <documentation>This lithology is interbedded within the primary
                        lithology</documentation>
                </annotation>
            </enumeration>
            <enumeration value="inclusions">
                <annotation>
                    <documentation>This lithology is contained in discrete masses within the primary
                        lithology</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LithologyCharacterEnumExtType">
        <annotation>
            <documentation>Union type for lithology character enum ext type. Accepts values from
                LithologyCharacterEnumType or OtherNameType.</documentation>
        </annotation>
        <union memberTypes="diggs:LithologyCharacterEnumType diggs:OtherNameType"/>
    </simpleType>
    <element name="LithologyObservation" type="diggs:LithologyObservationType">
        <annotation>
            <documentation>An object containing properties of a lithology observation that includes
                the geometric bounds of the observations (eg. an interval of a borehole, polygon
                representation (on maps or cross-section), or 3D volume, properties of the primary
                and any component lithologies, any ancillary observations as descriptions that are
                made within the bounds of the lithology observations (placedObservation) and the
                conditions that mark the basal boundary of the lithology described.</documentation>
        </annotation>
    </element>
    <complexType name="LithologyObservationPropertyType">
        <annotation>
            <documentation>Property type for lithology observation references. Used to wrap
                lithology observation objects or references in properties.</documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:LithologyObservation"/>
        </sequence>
    </complexType>
    <complexType name="LithologyObservationType">
        <annotation>
            <documentation>Extended type based on AbstractObservationType. Adds elements for
                lithology observation type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element name="primaryLithology" type="diggs:LithologyPropertyType">
                        <annotation>
                            <documentation>A description of the lithologies that make up the
                                principal portion of the overall lithologic classification of the
                                observed zone or sample,</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="componentLithology"
                        type="diggs:ComponentLithologyPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>A description of the lithology that makes up a subsidiary
                                portion of the overall observed zone or sample.This property would
                                be used where the lithology is observed to be distinct from the
                                primary lithology, for example where a zone is interbedded or the
                                component lithology occurs in inclusions or in a specific part of
                                the zone but is otherwise not separated out, This property can also
                                be used in soil descriptions, where lithologic components such as
                                sand, gravel and fines where specific details about the components
                                (eg. silty sand with gravel) are recorded and therefore the use of
                                the constituent property is not sufficient.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="facies" type="string">
                        <annotation>
                            <documentation>In reference to unconsolidated soils or sedimentary
                                rocks, this property describes certain conditions of sedimentation
                                that reflect a particular process or depositional environment. Some
                                examples might be alluvium, dune sand, river terrace deposits,
                                hemipelagic sediment, etc. Facies designations do not imply any
                                order within a stratigraphic column. Facies terms used to define
                                informal geologic units that occur in stratigraphic order (eg. units
                                do not repeat within a stratigraphic column) should be reported in a
                                StratigraphySystem. For metamorphic rocks, this property is used to
                                describe a set of mineral assemblages that form under similar
                                pressures and temperatures (eg. zeolite facies, blueschist
                                facies).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitName" type="string">
                        <annotation>
                            <documentation>A formal or informal name for the geologic or
                                geotechnical unit associated with this lithology observation. An
                                uncontrolled string, examples might be "Unit A" "Merrit Sand" "Bay
                                Mud", etc. This property would be used in cases where a
                                StratigraphySystem or GeoUnitSystem</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary" maxOccurs="unbounded"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LithologyPropertyType">
        <annotation>
            <documentation>Property type for lithology references. Used to wrap lithology objects or
                references in properties.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Lithology">
                <annotation>
                    <documentation>A term that provides description of rocks and soils on the basis
                        of such characteristics as color, mineralogic composition, and grain size or
                        other physical properties. This object holds properties to encode these
                        characteristics as both descriptions and in a controlled manner that allows
                        for machine parsing of the soil or rock characteristics</documentation>
                </annotation>
            </element>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="LithologySystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:LithologySystemType">
        <annotation>
            <documentation>A property containing a system of lithology observations.</documentation>
        </annotation>
    </element>
    <complexType name="LithologySystemType">
        <annotation>
            <documentation>Extended type based on AbstractObservationSystemType. Adds elements for
                lithology system type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="lithologyClassificationType" type="gml:CodeType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Describes the classification system(s) used to define the
                                lithology classification codes (eg. USCS) used within this
                                system</documentation>
                        </annotation>
                    </element>
                    <element name="lithologyObservation"
                        type="diggs:LithologyObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The lithology observation property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LithologyType" mixed="false">
        <annotation>
            <documentation>Extended type based on ComponentObjectNoDescriptionType. Adds elements
                for lithology type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:ComponentObjectNoDescriptionType">
                <sequence>
                    <choice>
                        <sequence>
                            <element name="classificationCode" type="diggs:DescriptorCodeType"
                                minOccurs="1" maxOccurs="1">
                                <annotation>
                                    <documentation>The value that describes the lithology as a
                                        controlled term (classification code or controlled name),
                                        rather than a simply descriptive one. Examples: 1) For soils
                                        described using the Unified Soil Classification, this value
                                        shall be the "group name", including any modifiers as
                                        defined in Figures 1,2 and 3 of ASTM D2487 or Figures 1 and
                                        2 of ASTM D2488, eg "Silty sand" or "Gravelly silt with
                                        sand". Where only the group symbol is reported, the
                                        unmodifed group name for the symbol should be used, as shown
                                        in Table 1 of ASTM D2487. 2) For soils described using the
                                        AASHTO soil classification system, this value should be the
                                        group or subgroup classification (eg. "A-3", "A-2-6"). 3)
                                        For soils classified using the USDA, Shepard (1954), or Folk
                                        classifications based on soil textures, this value would be
                                        the full-text textural classification, eg. "sandy loam"
                                        (USDA), "sand-silt-clay" (Shepard), or "muddy Sand" (Folk).
                                        4) For soils classified using the British Soil
                                        Classification System, this value would be the recommended
                                        name (eg. "CLAY of very high plasticity"), or the group
                                        symbol if the standard name is not given (eg. "CV"). 5) For
                                        rock, for example as defined by the American Geosciences
                                        Institute (AGI) glossary, this value would be the rock name
                                        (eg. "Dolostone", "Basalt", "Pebbly mudstone", etc.). Either
                                        a classificationCode value or lithDescription value must be
                                        present in the Lithology object. The codespace attribute
                                        should be a URL to an xml dictionary that conforms to the
                                        GML Dictionary.xsd and DIGGSDictionary_diggs.xsd schemas and
                                        that defines the terms used in the classification system
                                        within diggs:Definition elements. The value of
                                        classificationCode should be equivalent to a gml:name
                                        property of the associated diggs:Definition, for example:
                                        &lt;classificationCode
                                        codespace="https://diggsml.org/def/codes/DIGGS/0.1/astmD2488.xml#SWg">Well-graded
                                        sand with gravel&lt;/classificationCode> An example
                                        diggs:Definition element within the dictionary would look as
                                        follows: &lt;diggs:Definition gml:id="SWg">
                                        &lt;gml:description>SW with ≥ 15%
                                        gravel&lt;/gml:description> &lt;gml:identifier
                                        codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/astmD2487.xml#SWg&lt;/gml:identifier>
                                        &lt;gml:name>Well-graded sand with gravel&lt;/gml:name>
                                        &lt;diggs:dataType>string&lt;/diggs:dataType>
                                        &lt;diggs:authority>ASTM D2487&lt;/diggs:authority>
                                        &lt;diggs:reference>https://www.astm.org/d2487-17.html&lt;/diggs:reference>
                                        &lt;diggs:occurrences> &lt;diggs:Occurrence>
                                        &lt;diggs:sourceElementXpath>//diggs:Lithology/diggs:classificationCode&lt;/diggs:sourceElementXpath>
                                        &lt;/diggs:Occurrence> &lt;/diggs:occurrences>
                                        &lt;/diggs:Definition> The Geo-Institute has developed
                                        online dictionaries for ASTM D2487, ASTM D2488, AASHTO and
                                        USDA classification systems that should be referenced in
                                        instance documents that use those classifications.
                                        Classification systems that do not have an online dictionary
                                        may be used, but the codeSpace attribute should be a URL to
                                        an online resource for the classification system rather than
                                        an uncontrolled string value. Such usage may limit
                                        interoperability and is not recommended - a dictionary
                                        should be developed for these cases.</documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>This property provides descriptive information
                                        about the lithology and should be use in conjunction with
                                        classificationCode. If the information is recorded,
                                        lithDescription include a description of color,facies, grain
                                        size disctribution, constituents and field properties, even
                                        if those properties are not specifically encoded (eg.
                                        well-graded sand (SW), fine-grained, dark grey, massive,
                                        dry, hard). If the lithology description does not include
                                        any controlled term that serves to classify it, then
                                        lithDescription must be used instead of classificationCode,
                                        i.e., either classificationCode or lithDescription must
                                        contain a value (although both may contain values and is
                                        preferred). </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element minOccurs="1" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>This property provides descriptive information
                                        about the lithology and should be use in conjunction with
                                        classificationCode. If the information is recorded,
                                        lithDescription include a description of color,facies, grain
                                        size disctribution, constituents and field properties, even
                                        if those properties are not specifically encoded (eg.
                                        well-graded sand (SW), fine-grained, dark grey, massive,
                                        dry, hard). If the lithology description does not include
                                        any controlled term that serves to classify it, then
                                        lithDescription must be used instead of classificationCode,
                                        i.e., either classificationCode or lithDescription must
                                        contain a value (although both may contain values and is
                                        preferred). </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="classificationSymbol" maxOccurs="1"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>For USCS, AASHTO or BSCS soil classification systems,
                                this property holds the group symbol (for USCS) or the group or
                                appropriate subgroup classification (for AASHTO and BSCS). Symbology
                                for nan-standard or proprietary classifications may also be reported
                                here. Codespace attribute is mandatory and should preferably a link
                                to the associated DIGGS dictionary, or be either USCS, AASHTO, or
                                BSCS for those systems, or an authority code for non-standard
                                systems.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groupIndexAASHTO" type="positiveInteger">
                        <annotation>
                            <documentation>For soils classified using the AASHTO system, this
                                property holds the value of the group index (GI) as defined by: GI=
                                (F–35)[0.2+0.005(LL– 40)}+(F–15)(PI–10) where F is the percentage
                                passing the 75 μm (0.075 mm) sieve, expressed as a whole number, LL
                                is the liquid limit and PI is the plasticity index. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="legendCode" type="diggs:LegendCodeType">
                        <annotation>
                            <documentation>A value used to define a graphic pattern that may be used
                                to symbolize the lithology on a borehole log or map. The value can
                                be optionally associated with an authority or dictionary using the
                                codeSpace attribute and may also point to a specific graphic file
                                using the xlink:href and mimeType attributes that contains the
                                pattern named by the value of legendCode.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="matrixType" type="diggs:MatrixEnumType">
                        <annotation>
                            <documentation>Specifies the engineering characteristics of the
                                lithology matrix, either soil, rock or solid organic matter. This
                                property can typically be inferred from the classificationCode, but
                                is included here to simplify data ingestion into data systems that
                                may store rock and soil physical property information in different
                                objects or tables.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="colorCharacter"
                        type="diggs:ColorCharacterEnumExtType">
                        <annotation>
                            <documentation>Describes the character of the color property or collection of color properties, from the following enumerated list: banded - multiple colors occur
                            in horizontal layers within the unit mottled - unit consists of a
                            pattern of irregular spots, blotches or patches of a different color
                            than the unit matrix color multicalored - unit consists of multiple
                            colors where there is no description of the pattern or character of the
                            various colors uniform - unit consists of a single color variegated - a
                            multicolored unit containing spots, streaks, or blotches of multiple
                            colors </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="color" type="diggs:ColorPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>A color whose boundaries match those of the lithology
                                observation should be encoded in the enclosed Color object. If there
                                are depth-specific changes in color taht are significant and do not
                                match the boundaries of the lithologyObservation, then a ColorSystem
                                can be defined to represent those data instead of encoding separate
                                lithologyObservations to record only changes in color. Also,
                                ancillary color changes in color within a lithologyObservation can
                                be added as a description only within a
                                PlacedObservation.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constituent" type="diggs:ConstituentPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Constituents are materials and structures associated with
                                this lithology, but not considered significant enough to record as
                                part of a ConstituentSystem, or where location within a lithology
                                observation is not important to preserve (except as a comment).
                                Constituents of a lithology are descriptions that generally fall
                                into one of the following classes: 1) types of sedimentary or
                                physical structures, 2) types of lithologic, mineralogic or organic
                                accessories (eg. presence of calcite, gas odor, etc.), 3) types and
                                degree of bioturbation features, 4) types of diagenetic structures,
                                5) types of physical structures produced by sampling, 6) types of
                                fossils, 7) types of trace fossils, 8) types of
                                fractures</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lithProperties"
                        type="diggs:LithPropertiesPropertyType">
                        <annotation>
                            <documentation>The lith properties property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbundanceMeasureType">
        <annotation>
            <documentation>Concrete type extending Val0-100Type. Provides implementation for
                abundance measure type.</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:Val0-100Type">
                <attribute name="uom" type="diggs:DimensionlessUomEnumType" use="required">
                    <annotation>
                        <documentation>Unit of measure for the value.</documentation>
                    </annotation>
                </attribute>
                <attribute name="approximator" type="diggs:ApproximatorEnumExtType">
                    <annotation>
                        <documentation>A term that indicates approximation or uncertainty in the
                            reported value of the quantity.</documentation>
                    </annotation>
                </attribute>
                <attribute name="byVolume" type="boolean">
                    <annotation>
                        <documentation>Indicates whether the value percentage is by weight or by
                            volume. By weight is the default if the attribute is not present. True
                            indicates that the percentage is by volume.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="ApproximatorEnumType">
        <annotation>
            <documentation>Enumeration of terms used to indicate approximate quantities or
                thresholds</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="about">
                <annotation>
                    <documentation>Indicates a value that is close to but may vary slightly above or
                        below the stated quantity. More informal than
                        "approximately".</documentation>
                </annotation>
            </enumeration>
            <enumeration value="approximately">
                <annotation>
                    <documentation>Formal term indicating a value very close to the stated quantity,
                        with minimal deviation. More precise than "about" or
                        "roughly".</documentation>
                </annotation>
            </enumeration>
            <enumeration value="roughly">
                <annotation>
                    <documentation>Suggests an estimate with potentially significant variance from
                        the stated value. Less precise than "approximately" or
                        "about".</documentation>
                </annotation>
            </enumeration>
            <enumeration value="at least">
                <annotation>
                    <documentation>Specifies a strict minimum threshold, with values equal to or
                        greater than the stated quantity being acceptable.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="greater than">
                <annotation>
                    <documentation>Mathematical/formal version of "more than", indicating values
                        strictly exceeding the specified quantity.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="at most">
                <annotation>
                    <documentation>Specifies a maximum threshold, with values equal to or less than
                        the stated quantity being acceptable.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="less than">
                <annotation>
                    <documentation>Indicates values strictly below the specified quantity, excluding
                        the stated value itself. More formal than general phrases like
                        "under".</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ApproximatorEnumExtType">
        <annotation>
            <documentation>Union type for approximator enum ext type. Accepts values from
                ApproximatorEnumType or OtherNameType.</documentation>
        </annotation>
        <union memberTypes="diggs:ApproximatorEnumType diggs:OtherNameType"/>
    </simpleType>
    <complexType name="ColorPropertyType">
        <annotation>
            <documentation>Property type for color references. Used to wrap color objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Color"/>
        </sequence>
    </complexType>
    <complexType name="ColorType">
        <annotation>
            <documentation>Extended type based on ComponentObjectNoDescriptionType. Adds elements
                for color type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:ComponentObjectNoDescriptionType">
                <sequence>
                    <choice>
                        <element minOccurs="1" name="colorCode" type="diggs:DescriptorCodeType">
                            <annotation>
                                <documentation>The code value that defines the color; preferably
                                    defined by an authority. Typically this would be a Munsell color
                                    code. (eg. 10YR 4/3)</documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element minOccurs="1" name="colorName" type="diggs:DescriptorCodeType"
                                maxOccurs="1">
                                <annotation>
                                    <documentation>The name of the color, preferably defined by an
                                        authority defined in the codespace attribute (eg. reddish
                                        brown)</documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="colorCode" type="diggs:DescriptorCodeType">
                                <annotation>
                                    <documentation>The code value that defines the color; preferably
                                        defined by an authority. Typically this would be a Munsell
                                        color. (eg. 10YR4/3)</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="colorComponents"
                        type="diggs:ColorComponentsPropertyType">
                        <annotation>
                            <documentation>The color components property.</documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="abundanceCode" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>A measure of the relative amount of the color
                                    present. Terms such as few, rare, common, etc. represent
                                    relative abundance as a range of percentages that are specific
                                    to different standards bodies, so the use of these terms should
                                    reference a codelist dictionary using the codeSpace attribute..
                                    Specific percentage estimates should use the abundancePercent
                                    and/or maxAbundancePercent properties.</documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element name="abundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>A measure of the amount of the color present,
                                        expressed as a percentage. If expressing the percentage as a
                                        range - eg. 30-50%, this property should report the lower
                                        estimate and maxAbuncancePercentage should be used to report
                                        the upper estimate.</documentation>
                                </annotation>
                            </element>
                            <element name="maxAbundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>If expressing the percentage of a color as a
                                        range - eg. 30-50%, this property should report the the
                                        upper estimate.</documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="preface" type="string">
                        <annotation>
                            <documentation>A string value that would be used to preface the color
                                code or name in a programmatically constructed description for
                                display purposes. Values like "with", "trending towards" or "and"
                                are commonly used. For example, a secondary color of gray might have
                                a preface of "with". When combined in a description with a primary
                                color of brown would produce the phrase "brown with
                                gray"</documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="origin" type="diggs:ColorOriginEnumType">
                    <annotation>
                        <documentation>A term from an enumerated list that identifies the location
                            (eg matrix or mottle), or the source/cause of the color described.
                            Defined terms are: matrix - the color of the soil or rock matrix mottle
                            - the color of soil mottles clay depletion - color caused by depletion
                            of clay iron depletion - color caused by depletion of iron iron Fe2 mass
                            - color caused by masses of reduced iron iron Fe3 mass - color caused by
                            masses of oxidized iron iron-manganese mass - color caused by masses of
                            iron and manganese jarosite mass - color caused by masses of jarosite
                            manganese mass - color caused by masses of manganese ironstone module -
                            color caused by ironstone nodules iron-manganese nodule - color caused
                            by iron-manganese nodules jarosite nodule - color caused by jarosite
                            nodules plinthite - color caused by plinthite(s) (an iron-rich,
                            humus-poor mixture of clay with quartz and other minerals).
                            iron-manganese concretion - color caused by iron-manganese concretions
                            manganese coat or film - color caused by manganese coats or films
                            disseminated carbonate - color caused by disseminated calcium carbonate
                            disseminated salts - color caused by disseminated unspecified salts
                            disseminated gypsum - color caused by disseminated gypsum barite mass -
                            color caused by masses of barite gypsum mass - color caused by masses of
                            gypsum carbonate mass - color caused by masses of calcium carbonate salt
                            mass - color caused by masses of unspecified salt clay body - color
                            caused by included bodies of clay silica mass - color caused by masses
                            of silica gypsum crystal clusters - color caused by crystal clusters of
                            gypsum carbonate nodule - color caused by nodules of carbonate durinode
                            (SiO2) nodule - color caused by nodules of SiO2 gibbsite (Al1O3) nodule
                            - color caused by nodules of Al2O3 opal nodule - color caused by nodules
                            of opal ortstein nodule - color caused by hardpans cemented with iron
                            and organic matter carbonate concretion - color caused by concretions of
                            calcium carbonate gibbsite concretion - color caused by concretions of
                            gibbsite silica concretion - color caused by concretions of silica
                            titanium oxide - color caused by concretions of titanium oxide barite
                            crystals - color caused by crystals of barite calcite crystals - color
                            caused by calcite crystals gypsum crystals - color caused by gypsum
                            crystals salt crystals - color caused by salt crystals satin spar
                            crystals - color caused by crystals of satin spar gypsum selenite
                            crystals - color caused by crystals of selenite gypsum</documentation>
                    </annotation>
                </attribute>
                <attribute name="rank" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>A positive integer value that identifies the relative
                            significance or importance of the color, with 1 signifying the highest
                            rank. Using this attribute eliminates possible ambiguity when using
                            abundanceCode to infer significance.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
