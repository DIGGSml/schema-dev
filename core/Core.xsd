    <complexType name="ComponentLithPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ComponentLith object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ComponentLith"/>
        </sequence>
    </complexType>
    <complexType name="ComponentLithType" mixed="false">
        <complexContent>
            <extension base="diggs:ComponentObjectNoDescriptionType">
                <sequence>
                    <choice>
                        <sequence>
                            <element name="classificationCode" type="diggs:DescriptorCodeType"
                                minOccurs="1" maxOccurs="1">
                                <annotation>
                                    <documentation>
                                        The lithology as a controlled term (a classification code or
                                        controlled name) rather than a descriptive one. For USCS
                                        (ASTM D2487, D2488) it is the group name with its modifiers,
                                        for example "Silty sand" or "Gravelly silt with sand"; where
                                        only the group symbol is reported, use the unmodified group
                                        name for the symbol. For AASHTO it is the group or subgroup
                                        (for example "A-3", "A-2-6"); for USDA, Shepard or Folk
                                        textural classifications, the full-text class (for example
                                        "sandy loam", "sand-silt-clay", "muddy Sand"); for the
                                        British Soil Classification System, the recommended name
                                        (for example "CLAY of very high plasticity") or the group
                                        symbol if no standard name is given; for rock, the rock
                                        name, for example from the American Geosciences Institute
                                        glossary ("Dolostone", "Basalt"). Either classificationCode
                                        or lithDescription must be present. The codeSpace attribute
                                        is the URL of a GML dictionary that defines the terms of the
                                        classification system, and the value equals the gml:name of
                                        the matching diggs:Definition, for example the entry SWg of
                                        astmD2488.xml with the value "Well-graded sand with gravel".
                                        A system without an online dictionary may be used with a
                                        codeSpace that is a URL to an online resource describing it,
                                        but interoperability is limited and a dictionary should be
                                        developed. Use the DIGGS dictionary for the classification
                                        system applied: USCSSoilComponents.xml, aashtoM145.xml,
                                        astm2488Brdr.xml, astmD2487.xml, astmD2488.xml,
                                        astmD5715.xml or usda.xml.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>
                                        Descriptive information about the lithology, including
                                        color, facies, grain size distribution, constituents and
                                        field properties, even where these are also encoded (for
                                        example: well-graded sand (SW), fine-grained, dark grey,
                                        massive, dry, hard). Give it with classificationCode; it is
                                        preferred that both are present.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element minOccurs="1" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>
                                        Descriptive information about the lithology, including
                                        color, facies, grain size distribution, constituents and
                                        field properties, even where these are also encoded (for
                                        example: well-graded sand (SW), fine-grained, dark grey,
                                        massive, dry, hard). Required when the lithology has no
                                        controlled term in classificationCode.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="classificationSymbol" maxOccurs="1"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The group symbol (USCS) or the group or appropriate subgroup
                                classification (AASHTO and BSCS) of a soil classification. Symbols
                                of non-standard or proprietary classifications may also be reported.
                                The codeSpace attribute is mandatory: preferably a link to the DIGGS
                                dictionary, or USCS, AASHTO or BSCS for those systems, or an
                                authority code for a non-standard system. Use the DIGGS dictionary
                                for the classification system applied: grp-aashtoM145.xml,
                                grp-astmD2487.xml, grp-astmD2488.xml or grp-astmD2488Brdr.xml.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groupIndexAASHTO" type="positiveInteger">
                        <annotation>
                            <documentation>
                                For soils classified by the AASHTO system, the group index GI =
                                (F-35)[0.2+0.005(LL-40)]+(F-15)(PI-10), where F is the percentage
                                passing the 75 micrometer sieve as a whole number, LL is the liquid
                                limit and PI is the plasticity index.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="colorCharacter"
                        type="diggs:ColorCharacterEnumExtType">
                        <annotation>
                            <documentation>
                                The character of the color property, or collection of color
                                properties. Values come from the enumerated list, or "Other: xx",
                                where xx is a user-defined term whose meaning differs from every
                                listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="color" type="diggs:ColorPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                A color whose boundaries match those of the lithology observation.
                                Where significant color changes do not match those boundaries,
                                define a diggs:ColorSystem rather than separate lithology
                                observations; minor color changes within the observation can be
                                given as a description in a diggs:PlacedObservation. Repeat for each
                                color.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constituent" type="diggs:ConstituentPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A material or structure associated with the lithology that is not
                                significant enough to record in a diggs:ConstituentSystem, or whose
                                location within the observation need not be preserved. Constituents
                                are sedimentary or physical structures; lithologic, mineralogic or
                                organic accessories (calcite, gas odor); bioturbation features;
                                diagenetic structures; physical structures produced by sampling;
                                fossils; trace fossils; and fractures. Repeat for each constituent.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="componentProperties"
                        type="diggs:ComponentPropertiesPropertyType">
                        <annotation>
                            <documentation>
                                Field properties of the component lithology.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="ComponentLith" type="diggs:ComponentLithType">
        <annotation>
            <documentation>
                A lithology that is a component of a lithologic zone, with the same descriptive
                properties as diggs:Lithology plus properties of the component.
            </documentation>
        </annotation>
    </element>
    <complexType name="ComponentPropertiesType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <annotation>
                            <documentation>
                                apparentDensity applies to granular soils and consistency to
                                fine-grained soils. Give one or the other for a lithology class, not
                                both.
                            </documentation>
                        </annotation>
                        <element name="apparentDensity" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The relative density of intact coarse-grained soils, for example
                                    very loose, loose, medium dense, dense or very dense. No
                                    DIGGS-authored dictionary currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="consistency" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The consistency of intact fine-grained soils, for example very
                                    soft, soft, firm, hard or very hard. No DIGGS-authored
                                    dictionary currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="beddingOrientation" type="string" minOccurs="1">
                            <annotation>
                                <documentation>
                                    The bedding orientation of stratified material, for example
                                    horizontal or inclined. If quantitative strike or dip data are
                                    available, give dipAngle and dipDirection instead.
                                </documentation>
                            </annotation>
                        </element>
                        <choice>
                            <sequence>
                                <element name="dipAngle" type="diggs:DipMeasureType">
                                    <annotation>
                                        <documentation>
                                            The dip of the component property, a plane angle
                                            measured positive down from the horizontal.
                                        </documentation>
                                    </annotation>
                                </element>
                                <element minOccurs="0" name="dipDirection"
                                    type="diggs:PlaneAngleMeasureType">
                                    <annotation>
                                        <documentation>
                                            The direction of dip of the property, measured clockwise
                                            from the reference azimuth (typically true north).
                                        </documentation>
                                    </annotation>
                                </element>
                            </sequence>
                            <element minOccurs="1" name="dipDirection"
                                type="diggs:PlaneAngleMeasureType">
                                <annotation>
                                    <documentation>
                                        The direction of dip of the property, measured clockwise
                                        from the reference azimuth (typically true north). Required
                                        together with dipAngle.
                                    </documentation>
                                </annotation>
                            </element>
                        </choice>
                    </choice>
                    <element name="beddingSpacing" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                For stratified material, the average thickness between beds, as a
                                descriptive term (thick, thin) or a string giving a numeric value
                                (10 cm). No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="cementation" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The degree of cementation of intact coarse-grained soils, for
                                example weak, moderate or strong. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dilatancy" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The dilatancy of fine-grained soils, for example none, slow or
                                rapid. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dryStrength" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The dry strength, for example none, low, medium, high or very high.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fabric" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The spatial arrangement of grains, for example random, oriented or
                                imbricated. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="moistureCondition" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture condition of the soil, for example dry, moist or wet.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleAngularity" type="gml:CodeType"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall angularity of coarse-grained particles, for example
                                angular, subangular, subrounded or rounded. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleHardness" type="diggs:SizeClassCodeType"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall hardness of sand and coarser particles by how they react
                                to a hammer blow: crack, fracture or crumble, or hard if no cracking
                                occurs. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleShape" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall shape of (typically) gravel and larger particles, for
                                example flat, elongated, or flat and elongated. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSize" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall particle size distribution of sand and coarser material,
                                for example "fine", "fine to coarse" or "medium". No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSizeDistribution"
                        type="diggs:ParticleSizeDistributionPropertyType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                Quantitative particle size information such as mean and maximum
                                grain size, as opposed to the qualitative terms of particleSize.
                                Report the detailed grain size distribution curve as results of a
                                diggs:ParticleSizeTest.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSorting" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The relative sorting of soil or rock particles, for example
                                "well-sorted". No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plasticity" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative plasticity of fine-grained soil, for example low,
                                medium or high. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="reactionToHCl" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The reaction of the soil to hydrochloric acid, for example none,
                                weak or strong. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockGrainSize" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The overall particle or crystal size distribution of the rock,
                                depending on its origin: terms such as pegmatitic or aphanitic for
                                crystalline igneous or metamorphic rocks, fine sand or cobbles for
                                clastic sedimentary rocks, and "coarse ash" or "lapilli" for
                                pyroclastic igneous rocks. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockHardness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative hardness of rock as governed by its mineralogy, for
                                example "hard". No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockMass" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The structural features that constitute mechanical discontinuities
                                (major geological features) of the rock mass, meaning any in situ
                                rock with its inherent geomechanical discontinuities, for example
                                fissile, blocky or fractured. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockSlakingRate" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative rate of slaking of rock, for example "slow". No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockSorting" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The relative sorting of soil or rock particles, for example
                                "well-sorted". No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockStrength" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative hardness of rock as governed by its compressive
                                strength, for example "strong". No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockWeathering" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative degree of rock weathering, for example "slightly
                                decomposed" or "Grade III". No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="soilStructure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The structure of intact soil, for example stratified, laminated,
                                fissured, slickensided, blocky, lensed, homogeneous or varved. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="staining" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The source of visible staining of the lithologic unit within the
                                area of observation, for example iron, manganese or hydrocarbons. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceTexture" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The microscale features on grain surfaces, for example polished,
                                smooth, pitted or striated. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toughness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative toughness of fine-grained soil when kneaded near the
                                plastic limit, for example low, medium or high. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherComponentProperty" maxOccurs="unbounded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A property not listed in diggs:ComponentPropertiesType, as a name
                                and value pair, for example name "Additional Description" with value
                                "with slag". Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ComponentPropertiesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ComponentProperties object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ComponentProperties"/>
        </sequence>
    </complexType>
    <complexType name="ConstituentType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="codeValue" type="diggs:ConstituentCategoryCodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The code that defines the constituent, for example "SM" or
                                "gastropod", preferably defined by an authority named in the
                                codeSpace attribute. The category attribute states what kind of
                                constituent it is. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="abundanceCode" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The relative amount of the constituent present, as a term such
                                    as few, rare or common. The percentage ranges these terms
                                    represent differ between standards bodies, so name the code list
                                    in the codeSpace attribute. For a percentage estimate use
                                    abundancePercent and maxAbundancePercent. Use the DIGGS
                                    dictionary for the classification system applied: abundance.xml
                                    or abundanceUSDA.xml.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element name="abundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The amount of the constituent present, as a percentage. For
                                        a range such as 30-50%, give the lower estimate here and the
                                        upper in maxAbundancePercent.
                                    </documentation>
                                </annotation>
                            </element>
                            <element name="maxAbundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The upper estimate of the percentage of the constituent
                                        present, where it is given as a range.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element name="distribution" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                How the constituent is distributed within the interval, for example
                                scattered, sporadic or locally. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="rank" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>
                            The relative significance of the constituent, with 1 the highest. It
                            removes the ambiguity of inferring significance from abundanceCode.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="Constituent" type="diggs:ConstituentType">
        <annotation>
            <documentation>
                A minor constituent within a lithology zone: its identity, abundance and
                distribution.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConstituentCategoryCodeType">
        <simpleContent>
            <extension base="gml:CodeType">
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="category" type="diggs:ConstituentCategoryEnumExtType">
                    <annotation>
                        <documentation>
                            The kind of constituent described, for example lithology or fossils.
                            Values come from the enumerated list, or "Other: xx", where xx is a
                            user-defined term whose meaning differs from every listed value (not a
                            synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="ConstituentCategoryEnumExtType">
        <union memberTypes="diggs:ConstituentCategoryEnumType diggs:OtherNameType"/>
    </simpleType>
    <simpleType name="ConstituentCategoryEnumType">
        <restriction base="string">
            <enumeration value="core disturbance">
                <annotation>
                    <documentation>
                        For a core sample of rock or soil, the kind and intensity of disturbance to
                        the sample as a result of the sampling process. Common terms are biscuiting,
                        fluid intrusion, drilling breccia, fractured, moderately disturbed, soupy,
                        partial void, etc.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="diagenetic features">
                <annotation>
                    <documentation>
                        Physical, chemical, and biological changes that occur in sediments after
                        their initial deposition and during and after their lithification. Includes
                        features like concretions, nodules, mineral replacement, cementation, and
                        dissolution structures.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="fossils">
                <annotation>
                    <documentation>
                        Preserved remains, impressions, or traces of ancient life forms in
                        sedimentary rocks. Includes body fossils such as shells, bones, teeth,
                        leaves, and other preserved organic remains of once-living organisms.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="hydrocarbons">
                <annotation>
                    <documentation>
                        Organic compounds consisting of hydrogen and carbon, including oil, natural
                        gas, bitumen, and other petroleum products found within sedimentary rocks
                        and soils. May appear as staining, residues, or accumulations.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lithologic">
                <annotation>
                    <documentation>
                        Rock and mineral components of the soil or sediment, including the presence
                        of sand, silt, clay, and mineral or rock fragments.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sedimentary structures">
                <annotation>
                    <documentation>
                        Features formed during or shortly after sediment deposition, reflecting the
                        physical processes of sedimentation. Includes bedding, lamination,
                        cross-stratification, ripple marks, mud cracks, and graded bedding.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trace fossils">
                <annotation>
                    <documentation>
                        Preserved evidence of biological activity rather than preserved remains of
                        the organism itself. Includes burrows, tracks, trails, borings, and other
                        signs of organism behavior preserved in sedimentary rocks.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <complexType name="ConstituentPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Constituent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Constituent"/>
        </sequence>
    </complexType>
    <complexType name="DescriptorCodeType">
        <annotation>
            <documentation>
                Type for a code, a classification code, color code or color name, that records how
                it was determined.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="gml:CodeType">
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="ComponentLithology" type="diggs:ComponentLithologyType">
        <annotation>
            <documentation>
                A distinct lithologic type that occurs within a lithologic zone (observation) and is
                not described as part of the primary lithology. It occurs where the zone is
                interbedded and complex enough that separating each lithologic layer is not
                practical, or where one lithology occurs as an inclusion within another.
            </documentation>
        </annotation>
    </element>
    <complexType name="ComponentLithologyPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ComponentLithology object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:ComponentLithology"/>
        </sequence>
    </complexType>
    <complexType name="ComponentLithologyType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence maxOccurs="1" minOccurs="1">
                    <element maxOccurs="1" minOccurs="1" name="lithology"
                        type="diggs:ComponentLithPropertyType">
                        <annotation>
                            <documentation>
                                The component lithology, as a diggs:ComponentLith.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="abundanceCode" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The relative amount of the subordinate lithology present, as a
                                    term such as few, rare or common. The percentage ranges these
                                    terms represent differ between standards bodies, so name the
                                    code list in the codeSpace attribute. For a percentage estimate
                                    use abundancePercent and maxAbundancePercent. Use the DIGGS
                                    dictionary for the classification system applied: abundance.xml
                                    or abundanceUSDA.xml.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element name="abundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The amount of the lithologic component present, as a
                                        percentage. For a range such as 30-50%, give the lower
                                        estimate here and the upper in maxAbundancePercent.
                                    </documentation>
                                </annotation>
                            </element>
                            <element name="maxAbundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The upper estimate of the percentage of the lithologic
                                        component present, where it is given as a range.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                </sequence>
                <attribute name="association" type="diggs:LithologyCharacterEnumExtType">
                    <annotation>
                        <documentation>
                            How the component lithology is associated with the primary lithology:
                            disseminated, interbedded or in inclusions. Values come from the
                            enumerated list, or "Other: xx", where xx is a user-defined term whose
                            meaning differs from every listed value (not a synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="rank" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>
                            The relative significance of the component lithology, with 1 the
                            highest. It removes the ambiguity of inferring significance from
                            abundanceCode.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="ComponentProperties" type="diggs:ComponentPropertiesType">
        <annotation>
            <documentation>
                Field properties of a lithologic component, such as relative density, consistency,
                structure, particle characteristics and rock descriptors.
            </documentation>
        </annotation>
    </element>
    <complexType name="DescriptorType">
        <annotation>
            <documentation>
                Type for a free-text description that records how it was determined.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="string">
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="legendCode" type="string">
                    <annotation>
                        <appinfo>
                            <diggs:deprecated since="3.0.0" replacedBy="diggs:legendCode" note="the legendCode property of diggs:Lithology"/>
                        </appinfo>
                        <documentation>
                            DEPRECATED. Use the legendCode property of diggs:Lithology. A legend
                            code given on the description.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
