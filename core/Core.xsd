    <element name="gridMappingFunction" substitutionGroup="gml:AbstractObject"
        type="gml:CoverageFunctionType">
        <annotation>
            <documentation>The gridMappingFunction property describes the mapping function from the
                domain to the range for gridded locations. If omitted, the gml:startPoint is assumed
                to be the value of the gml:low property in the gml:Grid geometry, and the
                gml:sequenceRule is assumed to be linear and the gml:axisOrder property is assumed
                to be â€œ+1 +2â€.</documentation>
        </annotation>
    </element>
    <complexType name="TestType">
        <annotation>
            <documentation>Extended type based on AbstractMeasurementType. Adds elements for test
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractMeasurementType">
                <sequence>
                    <element minOccurs="0" name="samplingTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>Describes the time that the result applies to the
                                property of the investigation target. This is often the time of
                                interaction by a sampling activity or measurement procedure with a
                                real-world feature. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="resultTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>Describes the time when the result became available,
                                typically when the procedure associated with the observation was
                                completed. For some observations this is identical to the
                                samplingTime. However, there are important cases where they differ.
                                Example: Where a measurement is made on a specimen in a laboratory,
                                the samplingTime should record the time the specimen was retrieved
                                from its host, while the resultTime should record the time the
                                laboratory procedure was applied. Example: Where monitoring
                                observation results are post-processed, the resultTime is the
                                post-processing time, while the samplingTime preserves the time of
                                initial interaction with the world. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="validTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>Describes the time period during which the result is
                                intended to be used.</documentation>
                        </annotation>
                    </element>
                    <element name="outcome" type="diggs:TestResultPropertyType">
                        <annotation>
                            <documentation>A property that contains the information about what
                                properties are being measured, the results of the measurement, and
                                the associated locations that the measurement results relate
                                to.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedure" type="diggs:ProcedurePropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The procedure property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GROUP ELEMENTS                                                         -->
    <!-- ================================================================================== -->

    <element name="SamplingFeatureGroup" substitutionGroup="diggs:AbstractGroup"
        type="diggs:SamplingFeatureGroupType">
        <annotation>
            <appinfo>DEPRECATED 8/26. Use a concrete group substituting
                diggs:AbstractSamplingFeatureGroup, whose members cite the group through
                diggs:samplingFeatureGroupRef, instead of enumerating members here.</appinfo>
            <documentation>A top-level Diggs feature that references associated sampling features
                within a group. DEPRECATED 8/26.

                REFERENCES THE WRONG WAY. This element holds an array of references pointing DOWN at
                its members, which inverts the DIGGS antecedent rule that a child cites its parent,
                and which means the group element must be rewritten every time a member is added -
                unworkable for append or streaming workflows where members arrive one at a time over
                the course of construction. The replacement generation reverses the direction: see
                diggs:AbstractSamplingFeatureGroup, and diggs:BoreholeCPTPair below for the first
                concrete member of it.

                Retained live rather than removed, so that any existing instance continues to
                validate. Do not use it in new documents.</documentation>
        </annotation>
    </element>
    <complexType name="SamplingFeatureGroupType">
        <annotation>
            <appinfo>DEPRECATED 8/26. Use a type deriving from
                diggs:AbstractSamplingFeatureGroupType.</appinfo>
            <documentation>Extended type based on AbstractGroupType. Adds elements for sampling
                feature group type definition. DEPRECATED 8/26 - see
                diggs:SamplingFeatureGroup.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" ref="diggs:samplingFeatureRef" minOccurs="1"/>
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeCPTPair" substitutionGroup="diggs:AbstractSamplingFeatureGroup"
        type="diggs:BoreholeCPTPairType">
        <annotation>
            <documentation>A borehole paired with a cone penetration test sounding, sited close
                enough together that their logs are interpreted as one record of a single ground
                profile.

                THE CANONICAL GROUP, AND THE TEST OF WHAT A GROUP IS FOR. The two features are
                physically distinct and independently identified - each keeps its own location,
                its own construction record and its own results - but neither is interpreted alone:
                the CPT supplies continuous stratigraphic resolution the borehole cannot, and the
                borehole supplies the samples and index tests that calibrate the CPT. Treating them
                as one dataset rests on an assumption, namely that they are near enough that the
                same soil profile underlies both. THIS FEATURE IS WHERE THAT ASSUMPTION IS RECORDED,
                which is what makes the pair a group rather than a label: the group's content is the
                warrant for interpreting its members jointly.

                MEMBERSHIP IS DECLARED BY THE MEMBERS. The borehole and the sounding each carry a
                diggs:samplingFeatureGroupRef pointing at this feature; this feature holds no
                references to them. Neither the member types nor the count of two are enforceable in
                XSD under reverse referencing - both are context-validation concerns - so a document
                stating a pair with one member, or with three, is schema-valid and must be caught by
                validation, not here.

                Substitutes diggs:AbstractSamplingFeatureGroup and lives in the Core profile, where
                the borehole and sounding it groups already live.</documentation>
        </annotation>
    </element>
    <complexType name="BoreholeCPTPairType">
        <annotation>
            <documentation>Type for a paired borehole and CPT sounding. Adds the separation on which
                the pairing rests.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureGroupType">
                <sequence>
                    <element minOccurs="0" name="separationDistance" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The horizontal distance between the two members - the
                                quantity the proximity assumption is judged on.

                                Optional, and informational: a consumer can compute it from the two
                                members' own locations, and where the computed value disagrees with
                                this one THE MEMBER GEOMETRY PREVAILS, per the established DIGGS
                                convention for a convenience scalar stated alongside the geometry it
                                summarizes. It is stated here because the pairing decision was made
                                against a distance, and recording that distance is how the
                                assumption becomes reviewable rather than implicit - a reader should
                                not have to resolve two xlinks and project two coordinates to learn
                                whether the pairing was defensible.

                                Where the pair is not spatially justified at all - two features
                                paired because they penetrate the same known stratum rather than
                                because they are close - omit this and state the reason in remark
                                (inherited from diggs:AbstractFeatureType).</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroupPropertyType">
        <annotation>
            <documentation>Property type for group references. Used to wrap group objects or
                references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:AbstractGroup" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TEST SCHEDULING ELEMENTS                                                                -->
    <!-- ================================================================================== -->

    <element name="TestingProgram" substitutionGroup="diggs:AbstractProgram"
        type="diggs:TestingProgramType"/>
    <complexType name="TestingProgramType">
        <complexContent>
            <extension base="diggs:AbstractProgramType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="testingSchedule"
                        type="diggs:TestingSchedulePropertyType"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedTest"
                        type="diggs:PlannedTestPropertyType"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="testSpecification"
                        type="diggs:TestSpecificationPropertyType"/>
                    <element maxOccurs="unbounded" minOccurs="0" name="specimenPrepSpecification"
                        type="diggs:SpecimenPrepSpecificationPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TestingSchedulePropertyType">
        <sequence>
            <element ref="diggs:TestingSchedule"/>
        </sequence>
    </complexType>
    <element name="TestingSchedule" substitutionGroup="diggs:AbstractProgramDesign"
        type="diggs:TestingScheduleType"/>

    <complexType name="TestingScheduleType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="submittingEntity"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>The entity that submits the schedule to the receiving entity (laboratory) for analysis</documentation>
                        </annotation>
                    </element>
                    <element name="receivingEntity" type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>The entity that takes receipt of the submitted schedule</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="plannedCompletionDate"
                        type="gml:TimeInstantPropertyType">
                        <annotation>
                            <documentation>The date/time that the complete schedule is proposed to be completed</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="scheduleProgress"
                        type="diggs:ProgressEventArrayPropertyType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="ProgressEvent" type="diggs:ProgressEventType"/>
    <complexType name="ProgressEventType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element name="timeStamp" type="gml:TimePositionType"/>
                    <element name="progressState" type="gml:CodeType"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType name="ProgressEventArrayPropertyType">
        <sequence maxOccurs="unbounded">
            <element ref="diggs:ProgressEvent"/>
        </sequence>
    </complexType>
    <element name="PlannedTest" type="diggs:PlannedTestType"/>
    <complexType name="PlannedTestType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element name="testingScheduleRef" type="diggs:FeatureReferenceType"/>
                    <element maxOccurs="unbounded" ref="diggs:sampleRef"/>
                    <element name="testSpecificationRef" type="diggs:FeatureReferenceType"/>
                    <element minOccurs="0" name="specimenPrepSpecificationRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:SpecimenPrepSpecification</appinfo>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testingProgress"
                        type="diggs:ProgressEventArrayPropertyType"/>
                    <element minOccurs="0" ref="diggs:measurementRef"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PlannedTestPropertyType">
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:PlannedTest"/>
        </sequence>
    </complexType>
    <element name="TestSpecification" type="diggs:TestSpecificationType"
        substitutionGroup="diggs:AbstractProgramSpecification"/>
    <complexType name="TestSpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType"/>
        </complexContent>
    </complexType>
    <complexType name="TestSpecificationPropertyType">
        <sequence>
            <element ref="diggs:TestSpecification"/>
        </sequence>
    </complexType>
    <element name="SpecimenPrepSpecification" type="diggs:SpecimenPrepSpecificationType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>A program specification governing the preparation of a Specimen from one
                or more Samples - trimming, molding, curing or otherwise conditioning sampled
                material to the state required for a specific test procedure. This corresponds to
                what test standards (e.g. ASTM D421, D2217) call "sample preparation", but the
                object it governs is the diggs:AbstractSpecimen produced, not the diggs:Sample it
                is produced from - hence the name.</documentation>
        </annotation>
    </element>
    <complexType name="SpecimenPrepSpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType"/>
        </complexContent>
    </complexType>
    <complexType name="SpecimenPrepSpecificationPropertyType">
        <sequence>
            <element ref="diggs:SpecimenPrepSpecification"/>
        </sequence>
    </complexType>
    <simpleType name="CriterionOperatorEnumType">
        <annotation>
            <documentation>The comparison an acceptance criterion applies between the evaluated
                value and its limit. Closed enumeration: these five comparisons are complete for
                the purpose, and an uninterpretable extension value would defeat automated
                evaluation of the criterion.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="le">
                <annotation>
                    <documentation>Less than or equal to the limit's value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="ge">
                <annotation>
                    <documentation>Greater than or equal to the limit's value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="eq">
                <annotation>
                    <documentation>Equal to the limit's value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="ne">
                <annotation>
                    <documentation>Not equal to the limit's value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="within">
                <annotation>
                    <documentation>Within an inclusive range. Use with a limit that populates
                        parameterMinValue and parameterMaxValue rather than parameterValue - this is
                        the operator that carries a tolerance band such as "0.25 to 0.75
                        in".</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="PerformanceCriterion" type="diggs:PerformanceCriterionType"
        substitutionGroup="diggs:AbstractAcceptanceCriterion">
        <annotation>
            <documentation>An acceptance criterion on a measured physical property of the completed
                work - a strength, a permeability, a settlement, a modulus. Post-construction
                acceptance: it is evaluated against what was built, and the property it names is
                dictionary-bound so that the quantity is unambiguous.</documentation>
        </annotation>
    </element>

    <complexType name="PerformanceCriterionType">
        <complexContent>
            <extension base="diggs:AbstractAcceptanceCriterionType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="propertyClass"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>The physical property this criterion governs. The
                                codeSpace attribute is mandatory and must resolve the property in a
                                properties dictionary, so that a consumer can identify the quantity
                                without interpreting free text. Where the requirement is on a
                                constructional or geometric property rather than a measured physical
                                one, use diggs:DesignConformanceCriterion
                                instead.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="DesignConformanceCriterion" type="diggs:DesignConformanceCriterionType"
        substitutionGroup="diggs:AbstractAcceptanceCriterion">
        <annotation>
            <documentation>An acceptance criterion on a geometric or constructional property
                measured against its design intent - position, verticality, diameter, length,
                cut-off elevation. A tolerance: it asks whether what was built matches what was
                designed, rather than whether it performs.</documentation>
        </annotation>
    </element>
    <complexType name="DesignConformanceCriterionType">
        <complexContent>
            <extension base="diggs:AbstractAcceptanceCriterionType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="designProperty" type="gml:CodeType">
                        <annotation>
                            <documentation>The design property this criterion governs - for example
                                position, verticality, diameter, cut-off elevation. gml:CodeType
                                rather than gml:CodeWithAuthorityType because no design-property
                                dictionary exists yet; populate codeSpace once one does. Where the
                                requirement is on a measured physical property, use
                                diggs:PerformanceCriterion instead.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <simpleType name="LogicalOperatorEnumType">
        <annotation>
            <documentation>How the member criteria of a diggs:CompositeAcceptanceCriterion combine
                into one verdict. A closed, fixed set, so an enumeration rather than a gml:CodeType
                with a dictionary - the same call TF2 made for a physically closed set, and the same
                form diggs:CriterionOperatorEnumType already uses in this
                family.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="and">
                <annotation>
                    <documentation>Every member criterion must be satisfied. The conjunctive case
                        that motivated this object: a drilling refusal criterion such as
                        "penetration rate below X AND torque above Y" is met only when both hold
                        together, and recording the two separately loses exactly the conjunction
                        that defines refusal.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="or">
                <annotation>
                    <documentation>At least one member criterion must be satisfied. Termination
                        rules are often disjunctive - stop at design depth OR on reaching a
                        specified resistance, whichever occurs first.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="CompositeAcceptanceCriterion" type="diggs:CompositeAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>A requirement formed by combining two or more separately stated
                acceptance criteria under one logical operator - "penetration rate below X AND
                torque above Y", the drilling refusal case (D6, answered 2026-08-16, built at the
                task of the same name).

                WHY IT EXISTS. diggs:AbstractAcceptanceCriterion states one comparison of one
                evaluated value against one limit, and its documentation is explicit that several
                requirements on the same property are several criteria sharing a scope. That is the
                right rule and is unchanged. What it cannot express is a requirement whose MEANING
                is the conjunction: two co-scoped criteria state "each of these must hold", which is
                indistinguishable from "both must hold at the same instant, on the same element" -
                and for a refusal rule the difference is the whole content. This object states the
                combination itself, so nothing is inferred from co-scoping.

                IT DOES NOT SUBSTITUTE diggs:AbstractAcceptanceCriterion, DELIBERATELY, and the
                reason is structural rather than conceptual. diggs:AbstractAcceptanceCriterionType
                mandates operator and limit; a composite has neither of its own - its members carry
                them - and XSD restriction cannot drop a mandatory particle, so membership in that
                group would force every composite to state a meaningless comparison against a
                meaningless value. It substitutes diggs:AbstractProgramSpecification instead, the
                head diggs:AbstractAcceptanceCriterion itself substitutes. NOTHING IS LOST BY THIS:
                no slot anywhere in DIGGS is typed on diggs:AbstractAcceptanceCriterion -
                diggs:ProgramSpecificationPropertyType and every other consumer is typed on
                diggs:AbstractProgramSpecification - so a composite is accepted exactly where a
                diggs:PerformanceCriterion is, with no slot changed.

                THE MEMBERS REMAIN FIRST-CLASS. Each is a normally declared criterion with its own
                subject, statistic, operator, limit, basis and evaluatedAgainstRef, evaluated on its
                own terms; this object combines the verdicts and adds nothing to how any one of them
                is assessed. That is also why it carries no statistic, basis or baseLength of its
                own - those govern how a single evaluated value is reduced and compared, which is a
                member's business, not the combination's.</documentation>
        </annotation>
    </element>
    <complexType name="CompositeAcceptanceCriterionType">
        <annotation>
            <documentation>Type for a criterion whose content is a logical combination of other
                criteria. Extends diggs:AbstractProgramSpecificationType, so it inherits scope and
                basedOnRef like any program specification and can be scoped to the features it
                governs in the ordinary way.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="logicalOperator"
                        type="diggs:LogicalOperatorEnumType">
                        <annotation>
                            <documentation>How the member criteria combine. Mandatory: a set of
                                criteria with no stated operator is exactly the co-scoped collection
                                this object exists to disambiguate.

                                ONE OPERATOR ACROSS ALL MEMBERS. A mixed expression - "A and (B or
                                C)" - is written as nested composites, the inner one declared first
                                and cited by the outer through criterionRef, which is why
                                criterionRef admits a composite as a member. Carrying a
                                per-member operator instead would make precedence implicit, and
                                implicit precedence in a data standard is read wrongly sooner or
                                later.

                                THERE IS NO "not". Negation takes one operand, which contradicts
                                criterionRef's minimum of two, and a negated comparison is already
                                expressible directly: the complement of "le" is "ge" on the same
                                property, and diggs:CriterionOperatorEnumType carries both along
                                with "ne".</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="2" maxOccurs="unbounded" name="criterionRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
                            <documentation>A reference to one member criterion - a
                                diggs:PerformanceCriterion, a diggs:DesignConformanceCriterion, or
                                another diggs:CompositeAcceptanceCriterion where the expression
                                nests.

                                MINIMUM OF TWO, because a composite of one member states nothing
                                that the member does not state by itself.

                                A REFERENCE RATHER THAN A CONTAINED OBJECT. A criterion is a
                                first-class program specification that is normally cited from
                                elsewhere - by a diggs:DesignVerification, by a report - and one
                                criterion may take part in more than one composite. Containing it
                                here would either hide it from those consumers or duplicate it. The
                                members must therefore be declared BEFORE the composite that cites
                                them, per the antecedent rule; both sit in the same repeatable
                                specification slot, so this is a matter of document order only.

                                targetElement names diggs:AbstractProgramSpecification, which is
                                BROADER THAN THE INTENDED TARGET SET - it also admits
                                diggs:TestSpecification and the domain specifications. It is named
                                anyway because it is a real substitution-group head that covers all
                                three legitimate targets, and naming a head is the pattern;
                                enumerating members instead is what left diggs:samplingFeatureRef
                                stale, as diggs:AbstractAcceptanceCriterionType/evaluatedAgainstRef
                                already records. That the target is specifically a criterion is left
                                to the validation chain.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TargetSamplingFeature" type="diggs:TargetSamplingFeatureType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A planned counterpart of a realized diggs:AbstractSamplingFeature - a
                borehole, sounding, trial pit, well, pile, or an RI sampling feature
                (RIColumn, LoadTransferPlatform, RigidInclusionSystem). One Target for the whole
                realized head, per the granularity rule: what varies between concrete sampling
                feature kinds is result content, which a target does not carry.
                
                diggs:TargetBorehole and diggs:TargetInstallation specialize this type for feature
                kinds that genuinely need extra properties; where a feature kind needs nothing
                beyond what this type already carries, TargetSamplingFeature is used
                directly.</documentation>
        </annotation>
    </element>
    <complexType name="TargetSamplingFeatureType">
        <annotation>
            <documentation>Base type for planned sampling features.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTargetObjectType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="targetSFType"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>The kind of sampling feature planned - for example
                                borehole, sounding, trial pit, well, pile, rigid inclusion, load
                                transfer platform. Mandatory, and codeSpace is mandatory on it
                                (inherited from gml:CodeWithAuthorityType): the value must resolve
                                in a dictionary so a consumer need not infer the planned feature kind
                                from context or a closed schema enumeration.
                                
                                NO SUCH DICTIONARY EXISTS YET. The intended one is
                                samplingFeatureTypes.xml (build step 7, out of scope here), covering
                                both plain sampling features and installation types in one
                                vocabulary, since an installation IS a sampling feature
                                (diggs:AbstractLinearInstallation, diggs:AbstractPlanarInstallation
                                both substitute diggs:AbstractSamplingFeature directly) - so no
                                separate installation-type vocabulary is needed. Until the dictionary
                                exists, populate codeSpace with whatever project-specific vocabulary
                                is in use; do not leave it empty and do not invent a DIGGS
                                codeSpace URL.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="1" name="targetSFLocation"
                        type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>The planned location or extent of the feature. Optional
                                because a population-scope design (scope, inherited) has no single
                                location - the population's extent is expressed there instead.
                                diggs:LocationPropertyType admits every DIGGS geometry, so the choice
                                of geometry kind is guidance rather than a schema constraint:
                                PointLocation for a point feature (a borehole, a pile), an
                                AbstractCurve for a linear transect, an AbstractSurface or
                                MultiSurface for a planar feature (a load transfer platform), an
                                AbstractVolume for a 3-D extent.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="diameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The planned diameter, where the feature kind has one (a
                                pile, a rigid inclusion, a sounding). Informational convenience: THE
                                GEOMETRY PREVAILS where targetSFLocation carries an extent that
                                disagrees with this value.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The planned total length, for a linear feature - the
                                analogue of the realized side's totalMeasuredDepth. Informational
                                convenience: THE GEOMETRY PREVAILS where targetSFLocation carries a
                                curve whose length disagrees with this value.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="TargetBorehole" type="diggs:TargetBoreholeType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A specialization of diggs:TargetSamplingFeature for a planned borehole,
                carrying the two properties a borehole plan needs beyond the base: what casing and
                backfill are planned. Substitutes diggs:AbstractTargetObject directly rather than
                diggs:TargetSamplingFeature - concrete DIGGS elements are never substitution-group
                heads - but its type extends diggs:TargetSamplingFeatureType, the same pattern
                diggs:ConcretePile (specialty/DeepFoundation.xsd) uses against
                diggs:AbstractLinearInstallation.</documentation>
        </annotation>
    </element>
    <complexType name="TargetBoreholeType">
        <complexContent>
            <extension base="diggs:TargetSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="casingDescription" type="string">
                        <annotation>
                            <documentation>A description of the casing planned for the
                                borehole.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillDescription" type="string">
                        <annotation>
                            <documentation>A description of the backfill planned for the
                                borehole.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="TargetInstallation" type="diggs:TargetInstallationType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A specialization of diggs:TargetSamplingFeature for a planned
                installation - a well, a pile, a rigid inclusion, or any other member of
                diggs:AbstractLinearInstallation / diggs:AbstractPlanarInstallation, all of which
                substitute diggs:AbstractSamplingFeature directly (there is no separate installation
                head on the realized side to target). Adds no properties of its own: targetSFType
                (inherited) already carries which installation kind is planned, dictionary-bound, so
                nothing here needs to be closed-enumerated. Substitutes diggs:AbstractTargetObject
                directly, matching diggs:TargetBorehole.</documentation>
        </annotation>
    </element>
    <complexType name="TargetInstallationType">
        <complexContent>
            <extension base="diggs:TargetSamplingFeatureType"/>
        </complexContent>
    </complexType>

    <element name="TargetSample" type="diggs:TargetSampleType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A planned counterpart of a realized diggs:Sample - covers the whole
                diggs:AbstractSample head (currently one concrete member, Sample).

                MIRRORS diggs:AbstractSamplingActivityType, NOT diggs:AbstractSampleType (Dan,
                2026-08-18, correcting an earlier draft of this type). A sample cannot be designed
                beyond designing the activity that creates it:
                diggs:AbstractSampleType/samplingActivityRef carries no minOccurs/maxOccurs and so
                defaults to [1..1] - every realized Sample has exactly one SamplingActivity, and a
                sample's content (recovery, condition, matrix as observed) is downstream of that
                activity by construction. What is genuinely plannable is the activity's procedure
                and intent, the same distinction every other Target in this family draws between
                what precedes a result and the result itself. The element keeps the name
                TargetSample, not TargetSamplingActivity, because the planning purpose stated by
                its host design is still "produce a sample" - only the field content mirrors the
                activity that produces it.</documentation>
        </annotation>
    </element>
    <complexType name="TargetSampleType">
        <annotation>
            <documentation>Base type for planned samples. Mirrors
                diggs:AbstractSamplingActivityType's plannable content (procedure and intent) field
                for field, deliberately excluding everything on that type which is a
                recovered-material result (lengthLongestPortion, rockQualityDesignationLength,
                samplingActivityRQD, solidCoreRecoveryLength, totalSampleRecoveryLength,
                totalSampleRecovery, sampleProduced, samplingEnvironment) or program-module
                provenance (carried instead through the inherited
                scope/basedOnRef/programSpecificationRef/basisRef, by way of
                diggs:AbstractProgramDesignType and diggs:AbstractTargetObjectType). One deliberate
                exception to the mirroring rule: sampleMatrix, below. A second field,
                samplingEquipment (matching diggs:AbstractSamplingActivityType/samplingEquipment in
                name), was built here originally but retired the next day in favour of
                diggs:AbstractTargetObjectType/plannedEquipment (D2) once that generic, Target-family-
                wide slot existed - planned sampling equipment is now stated there, not with a
                sample-specific name.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTargetObjectType">
                <sequence>
                    <element name="activityType" type="diggs:PlannedActivityTypeEnumType">
                        <annotation>
                            <documentation>What kind of sampling activity is planned - collect,
                                aggregate, subsample, or test. Mandatory: the identity field every
                                other Target in this family has exactly one of (targetSFType,
                                relationType, actionType, ...), and a planned sample reported
                                without it is not interpretable - a subsample plan and a collection
                                plan need different supporting fields, most obviously
                                sourceTargetSampleRef. Placed first, ahead of the fields that mirror
                                diggs:AbstractSamplingActivityType's own field order, for the same
                                identity-field-first reason. Restricted from
                                diggs:ActivityTypeEnumType (diggs:PlannedActivityTypeEnumType,
                                declared below): the realized enumeration's "none" ("the activity
                                failed to produce any physical sample") and "unknown" ("legacy data
                                where only sample name exists") describe outcomes, not
                                plans.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="targetConstructionActivityRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetConstructionActivity</appinfo>
                            <documentation>A reference to the planned construction activity this
                                sample is to be taken during or from - the planned counterpart of
                                diggs:constructionActivityRef (AbstractSamplingActivityType). For
                                example, cylinder or cube sampling planned against a specific column
                                or batch installation. Plan-to-plan: cites a
                                TargetConstructionActivity, an antecedent within the plan graph,
                                never a realized construction activity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="targetSFRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetSamplingFeature</appinfo>
                            <documentation>A reference to the planned sampling feature this sample
                                is to be collected from - the planned counterpart of the mandatory
                                diggs:samplingFeatureRef/diggs:samplingLocation choice
                                (AbstractSamplingActivityType), and typed the same way as
                                diggs:TargetMeasurement/targetSFRef and
                                diggs:TargetConstructionActivity/targetSFRef. Widened to [0..*],
                                matching those two: a population-scope sampling plan (scope,
                                inherited) governs many features without naming one. Plan-to-plan:
                                cites a TargetSamplingFeature (or one of its specializations,
                                diggs:TargetBorehole / diggs:TargetInstallation), an antecedent
                                within the plan graph, never a realized sampling
                                feature.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>The planned location of the sample - most often a
                                diggs:LinearExtent marking the planned depth interval within
                                targetSFRef's linear referencing system. Matches
                                diggs:AbstractSamplingActivityType/samplingLocation in name and type
                                (diggs:LocationPropertyType). The single most important fact about a
                                planned sample, and the reason this element exists rather than
                                leaving planned depth to otherProperty.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="sourceTargetSampleRef"
                        type="diggs:FractionalReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetSample</appinfo>
                            <documentation>A reference to the planned sample(s) this one is to be
                                subsampled or aggregated from - the planned counterpart of
                                diggs:sourceSampleRef (AbstractSamplingActivityType), and typed the
                                same way (diggs:FractionalReferenceType) so a planned subsample can
                                state what percentage of the source it will take. Plan-to-plan: this
                                cites another TargetSample, an antecedent within the plan graph,
                                never a realized Sample. Meaningful only where activityType is
                                "aggregate" or "subsample"; XSD cannot enforce that
                                correlation.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>Purpose of taking this sample - an uncontrolled string
                                describing the test or tests intended to be run on the sample(s)
                                generated from this activity. Matches
                                diggs:AbstractSamplingActivityType/purpose in name, type and
                                meaning.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleMatrix" type="gml:CodeType">
                        <annotation>
                            <documentation>The planned material class of the sample - for example
                                soil, rock, grout, water. Named and typed to match
                                diggs:SampleType/sampleMatrix, the as-built counterpart, rather than
                                diggs:SampleType/type, whose own documentation describes it as "a
                                shorthand for information provided by other sample or associated
                                sampling activity properties" - a lossier duplicate of what
                                activityType, samplingMethod and targetSFRef already state between
                                them.

                                THE ONE DELIBERATE EXCEPTION TO MIRRORING
                                diggs:AbstractSamplingActivityType RATHER THAN
                                diggs:AbstractSampleType (Dan, 2026-08-18). Everything else on this
                                type is procedure or intent, but a designer planning a sample from a
                                not-yet-drilled location often cannot state with certainty whether
                                the recovered material will be soil or rock - the targeted sampling
                                feature's own stratigraphy may not be known at the planned depth.
                                State the expected or required matrix where it is known; the
                                dictionary this element binds to carries coarse classes (soil, rock)
                                alongside finer material terms for exactly this reason, so a plan
                                can be as specific or as provisional as the design stage
                                allows.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplerInsertionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>For planned sampling of soil or rock, the means by which
                                the sampler is planned to be inserted into the ground - for example
                                pushed, driven. Matches
                                diggs:AbstractSamplingActivityType/samplerInsertionMethod in name,
                                type and dictionary.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="samplingMethod"
                        type="diggs:SamplingMethodPropertyType">
                        <annotation>
                            <documentation>The method(s) this sample is planned to be collected by,
                                held inline or by reference. Matches
                                diggs:AbstractSamplingActivityType/samplingMethod in name and
                                type.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>For planned aggregate activities that involve blending
                                samples (such as soil-cement mixtures), the planned time duration to
                                mix the sample together. Matches
                                diggs:AbstractSamplingActivityType/mixingTime in name and
                                type.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="PlannedActivityTypeEnumType">
        <annotation>
            <documentation>Restriction of diggs:ActivityTypeEnumType to the four values that
                describe a plan rather than an outcome - excludes "none" ("the activity failed to
                produce any physical sample") and "unknown" ("legacy data where only sample name
                exists"), neither of which can be planned for. Used for
                diggs:TargetSampleType/activityType.</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="collect">
                <annotation>
                    <documentation>collect - activity will create a sample or samples by collection
                        from a sampling feature.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="aggregate">
                <annotation>
                    <documentation>aggregate - activity will create a sample or samples by
                        aggregating existing samples; the associated TargetSample(s) should have
                        more than one sourceTargetSampleRef.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="subsample">
                <annotation>
                    <documentation>subsample - activity will create a sample or samples by
                        subsampling an existing sample; only one sourceTargetSampleRef should be
                        specified for the related TargetSample(s).</documentation>
                </annotation>
            </enumeration>
            <enumeration value="test">
                <annotation>
                    <documentation>test - activity will produce a test, standard or blank sample
                        that does not relate to any field sample or sampling feature.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>

    <complexType name="MeasurementMethodPropertyType">
        <annotation>
            <documentation>Property type for containing or referencing the diggs:Specification a
                planned measurement is to follow. Modelled on diggs:ProcedurePropertyType
                (core/Common.xsd:722) rather than the schema's more common
                gml:AssociationAttributeGroup usage: of the 44 property types carrying that
                attribute group, 29 still require the contained object (minOccurs defaults to 1),
                which makes the by-reference form schema-invalid in practice (architecture §9 item
                8). Here the contained element is explicitly minOccurs="0", so a producer may supply
                the Specification inline, by xlink:href, or both, with the embedded object
                prevailing when both are present.
                
                Renamed from an earlier inline testSpecification to avoid a third schema-wide
                collision on the word "Specification", alongside diggs:Specification (the component
                object this property type wraps) and diggs:AbstractProgramSpecification (the
                feature head).</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Specification" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>

    <element name="TargetMeasurement" type="diggs:TargetMeasurementType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A planned counterpart of a realized diggs:AbstractMeasurement - covers
                all five concrete members (Test, Monitor, MaterialTest, MeasurementWhileDrilling,
                GeophysicalFieldSurvey) with one type, since what is plannable is already common to
                the abstract head and what differs between the concretes is their result content.
                Renamed from an earlier TargetTest for exactly that reason: a type named for one
                member would misdescribe what it actually covers.</documentation>
        </annotation>
    </element>
    <complexType name="TargetMeasurementType">
        <annotation>
            <documentation>Base type for planned measurements.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTargetObjectType">
                <sequence>
                    <element minOccurs="0" name="measurementKind" type="gml:CodeType">
                        <annotation>
                            <documentation>What kind of measurement is planned, so that a reader knows what is
                                intended before any realized object exists to inspect.
                                
                                gml:CodeType with a dictionary vocabulary, deliberately NOT a closed XSD
                                enumeration: the set of measurement kinds grows without a schema release. Note the
                                contrast with diggs:TargetSamplingFeatureType/targetSFType, which is
                                gml:CodeWithAuthorityType. That element is mandatory and its values must be precise,
                                so it compels a codeSpace; this one is optional and largely derivable, so it does
                                not.
                                
                                KEEP IT OPTIONAL AND EXPECT IT TO BE OMITTED. It is largely redundant with
                                measurementMethod below: a planned ASTM D1143 test already announces itself as a
                                static load test. State it where no method is cited, or where the method admits
                                several kinds of measurement.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="targetSFRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetSamplingFeature</appinfo>
                            <documentation>A reference to the planned sampling feature this
                                measurement is to be performed on or from - the planned counterpart
                                of diggs:samplingFeatureRef (AbstractMeasurementType), and typed the
                                same way. Plan-to-plan: cites a TargetSamplingFeature (or one of its
                                specializations, diggs:TargetBorehole / diggs:TargetInstallation), an
                                antecedent within the plan graph, never a realized sampling
                                feature.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="targetSampleRef"
                        type="diggs:FractionalReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetSample</appinfo>
                            <documentation>A reference to the planned sample this measurement is to
                                be performed on - the planned counterpart of diggs:sampleRef
                                (AbstractMeasurementType), and typed the same way. Plan-to-plan:
                                cites a TargetSample, never a realized Sample.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementLocation"
                        type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>The planned location of the measurement - most often a
                                diggs:LinearExtent marking the planned depth or depth interval within
                                targetSFRef's linear referencing system, a diggs:PointLocation for a
                                single planned test position or instrument point, or a
                                diggs:MultiPointLocation for several planned positions served by one
                                provision.

                                THERE IS NO NAMED REALIZED-SIDE COUNTERPART TO MIRROR, AND THAT IS WHY
                                THIS ELEMENT IS NEEDED RATHER THAN INHERITED. On the realized side a
                                measurement's position is normally the DOMAIN of its result coverage -
                                diggs:location, which substitutes gml:domainSet - so a
                                diggs:Test carries no location property of its own and needs none: the
                                domain is indexed by the results themselves. A measurement-while-drilling
                                record follows the same rule, stating position explicitly where its
                                outcome is time-domain and leaving it to the result domain where the
                                outcome is location-indexed; and a diggs:MaterialTest has no domain at
                                all, being performed on a sample rather than at a place.
                                diggs:MonitorType/monitorLocation is the one realized exception, and for
                                a reason that does not transfer: a monitoring point is a fixed position
                                that exists independently of, and prior to, any reading taken there.

                                A PLANNED MEASUREMENT HAS NO COVERAGE, so it has no domain, so the
                                mechanism the realized side relies on is simply unavailable to it. Before
                                this element existed a plan could say WHICH feature a measurement was to
                                be performed on (targetSFRef) and HOW DENSELY (the testingDensity choice
                                below), but not WHERE - "a pressuremeter test at 4.5 m and 9.0 m in
                                BH-3" was unstatable except as a bare otherProperty parameter, which is
                                the un-queryable resting state the Target family exists to remove.

                                DISTINCT FROM, AND COMPLEMENTARY TO, THE testingDensity CHOICE BELOW: a
                                density states spacing without committing to positions ("one test per
                                1.5 m of hole"), this states the positions themselves. Either may be
                                given alone, and both together are meaningful where a specified spacing
                                has been resolved into a planned schedule.

                                NORMALLY OMITTED WHERE THE MEASUREMENT IS ON A PLANNED SAMPLE: cite the
                                sample through targetSampleRef and let its own
                                diggs:TargetSampleType/samplingLocation carry the depth, rather than
                                restating it here. Omit it too where the measurement applies to the
                                whole of the referenced feature, as an axial load test applies to a
                                whole column - absence means the provision is not positioned, never that
                                its position is unknown.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="measurementMethod"
                        type="diggs:MeasurementMethodPropertyType">
                        <annotation>
                            <documentation>The method(s) this measurement is planned to follow, held
                                inline or by reference (see diggs:MeasurementMethodPropertyType).
                                Unbounded and by-reference-capable because the same method is
                                typically shared across many planned measurements - renamed from an
                                earlier inline testSpecification for exactly that reuse
                                reason.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="readingFrequency"
                        type="diggs:ReciprocalTimeMeasureType">
                        <annotation>
                            <documentation>How often this measurement is planned to be taken.
                                
                                ONE FIELD FAMILY, NOT A MONITORING-SPECIFIC FIELD. A measurement-while-drilling
                                logging interval, a dynamic-testing sampling rate, a load-test hold increment and an
                                instrument read frequency are the same quantity under four names, which is why this
                                sits on the generic planned-measurement type rather than on a monitoring
                                specialization or in a specialty file.
                                
                                diggs:ReciprocalTimeMeasureType rather than diggs:FrequencyMeasureType: the
                                reciprocal-time units are the ones this quantity is actually written in - 1/d for a
                                daily instrument reading, 1/h, 1/min, 1/s - whereas FrequencyMeasureType is the
                                hertz-based vibration and signal-processing type. A daily reading is
                                uom="1/d" with a value of 1.
                                
                                XSD CANNOT ENFORCE that a reading frequency appears only where it makes sense; that
                                is the cost of one planned-measurement type serving every measurement kind. Recover
                                it with dictionary Occurrence conditions keyed on measurementKind, or in the
                                validation module's context checks.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="duration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>How long this measurement is planned to run - a monitoring campaign's
                                span, a load-test hold time, the length of a logging window.
                                
                                Named and typed to match diggs:TimeIntervalType/duration
                                (core/Common.xsd), which is the realized-side counterpart and is also
                                diggs:TimeMeasureType, so one concept keeps one name across the plan/realized
                                boundary. Not to be confused with the gml:duration of the GML profile, which is in
                                a different namespace and is an XSD duration lexical form rather than a measure.
                                
                                State a start or end time, where one is planned, through the scope and progress
                                machinery inherited from the Target spine rather than here: this element carries an
                                elapsed span, not a position in time.</documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>TESTING DENSITY (TF2, 2026-08-19, retyped from a single
                                diggs:AuthorizedParameterPropertyType element): how densely this
                                measurement is planned to be taken across a population or an area,
                                where the provision is stated as a spatial or count-based density
                                rather than a rate in time - one test per footing, one per linear foot
                                of wall, one per unit area of slab (Post-installation Parameter
                                Analysis V2 row 22: LTP special-inspection frequency/regime).

                                A CHOICE OF THREE, NOT ONE ELEMENT WITH A VARYING QUANTITY CLASS.
                                Earlier documentation on this particle argued for a dictionary-bound
                                parameter because "there is no reciprocal-length or reciprocal-area
                                measure type in DIGGS today" - that premise was wrong: both
                                diggs:ReciprocalLengthMeasureType and diggs:ReciprocalAreaMeasureType
                                already exist (core/MeasureTypes.xsd). Once that is corrected, the
                                three shapes a testing density can take are a CLOSED, PHYSICALLY FIXED
                                SET - per linear length, per area, or per discrete element/count -
                                unlike diggs:DesignVerificationType/demand and /capacity, whose
                                quantity class genuinely is open-ended across verification types, or
                                testedFraction below, which is always dimensionless. A dictionary
                                carries no advantage for a fixed three-member set, so the dictionary-
                                bound-parameter mechanism (still the right tool for demand/capacity,
                                per docs/build/X2-analysis/NOTES.md in the RI project's working
                                notes) is not needed here. Superseded
                                ri_properties.xml#testing_density, retired with this change.

                                DISTINCT FROM readingFrequency, WHICH IS TIME-BASED ONLY -
                                diggs:ReciprocalTimeMeasureType cannot state "per linear foot" or "per
                                unit area". DISTINCT FROM testedFraction below (what share of a
                                population is tested, always dimensionless) - this states how closely
                                spaced testing is in space or by count, testedFraction states what
                                fraction of the population it covers.

                                EXACTLY ONE BRANCH, NEVER MORE THAN ONE: a choice, not three
                                independent optional elements, since a single planned measurement has
                                one testing-density shape, not several stated simultaneously.

                                Continuous, 100%-coverage inspection (this row's other half -
                                "continuous visual inspection") is not a density at all and is not
                                what this choice states; record it through measurementKind/remark
                                instead, the same way a Test with no readingFrequency is understood to
                                be a single planned event.</documentation>
                        </annotation>
                        <element name="testingDensityPerLength"
                            type="diggs:ReciprocalLengthMeasureType">
                            <annotation>
                                <documentation>Testing density expressed per unit length - one test
                                    per linear foot of wall, one inspection per 10 m of trench.
                                    Typical uom values: 1/m, 1/ft.</documentation>
                            </annotation>
                        </element>
                        <element name="testingDensityPerArea" type="diggs:ReciprocalAreaMeasureType">
                            <annotation>
                                <documentation>Testing density expressed per unit area - one
                                    compaction test per unit area of slab or platform. Typical uom
                                    values: 1/m2, 1/ft2.</documentation>
                            </annotation>
                        </element>
                        <element name="testingDensityPerElement"
                            type="diggs:DimensionlessMeasureType">
                            <annotation>
                                <documentation>Testing density expressed per discrete element - one
                                    test per footing, one test per every N columns. A bare count or
                                    ratio rather than a spatial rate; typical uom values: Euc (a plain
                                    count/ratio) or %.</documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="testedFraction"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>The proportion of a planned population of elements that is
                                to be tested, where a testing provision is scoped to a population
                                rather than to named elements - "5 percent of production rigid
                                inclusions". Typically stated uom="%" (diggs:DimensionlessUomEnumType
                                permits percent, fraction or Euclid; see
                                diggs:DesignVerificationType/utilisationRatio and /factorOfSafety for
                                the precedent of using this measure type for a plain dimensionless
                                ratio rather than a dictionary-bound parameter).

                                A FRACTION OF A POPULATION, NOT A RATE IN TIME: it answers "how many
                                of them" and not "how often", and is deliberately distinct from the
                                temporal reading frequency carried by readingFrequency above, and from
                                the spatial/count-based density carried by the testingDensityPerLength/
                                PerArea/PerElement choice above - three related but independent
                                provisions, retained as separate elements rather than folded into one
                                another (TF1, 2026-08-19, retiring the former
                                ri_properties.xml#tested_fraction, which stated this as an
                                undictionaried parameter before this element existed).

                                diggs:ProgramScopeType (inherited via the Target spine) states WHICH
                                features a provision governs, by geometry, layout or feature type, and
                                has no fraction concept by design; this element states what share of
                                that scoped population is sampled. The two are complementary and both
                                are normally needed.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testLoadPercentDesignLoad"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>The maximum load a planned load test is to reach, expressed
                                as a percentage of the design working load of the element being
                                tested. Typically stated uom="%".

                                Stated as a ratio rather than as a force because the test requirement
                                is written that way in practice and because the absolute value differs
                                per element while the ratio does not, which is what lets one
                                population-scoped test provision govern a whole zone. Where the
                                provision is adopted from a standard or a published recommendation
                                rather than derived for the project, state that in a remark - this
                                element itself carries only the value, not its derivation (TF1,
                                2026-08-19, retiring the former
                                ri_properties.xml#test_load_pct_design_load, whose own documentation
                                suggested a diggs:ProvenancedParameter for exactly this
                                provenance-tracking case; a fixed measure type has no equivalent
                                mechanism, so cite the source in remark
                                instead).</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType name="ConstructionMethodPropertyType">
        <annotation>
            <documentation>Property type for containing or referencing the diggs:Specification a
                planned construction activity is to follow. A twin of
                diggs:MeasurementMethodPropertyType (this file), not a reuse of it: the two wrap the
                same diggs:Specification the same way (modelled on diggs:ProcedurePropertyType,
                core/Common.xsd:722, with the contained element minOccurs="0" so the by-reference
                form is actually valid - see diggs:MeasurementMethodPropertyType's documentation for
                why that matters), but a property named constructionMethod typed
                "MeasurementMethodPropertyType" would misdescribe itself to a schema browser. No
                house-style mechanism (xsd:group, attributeGroup) exists to share the shape without
                that cost - the same trade AuthorizedParameterType/ParameterType already
                accepted.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Specification" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>

    <element name="TargetConstructionActivity" type="diggs:TargetConstructionActivityType"
        substitutionGroup="diggs:AbstractTargetObject">
        <annotation>
            <documentation>A planned counterpart of a realized diggs:AbstractConstructionActivity -
                the act that builds something, not the thing built. Where
                diggs:TargetSamplingFeature plans "a column here", TargetConstructionActivity plans
                "installed by full-displacement auger, terminated on this refusal criterion, in this
                sequence relative to neighbours" - installation-tab rows 7, 8, 39 and 40, which
                TargetSamplingFeature cannot hold because they describe the act, not the object. The
                termination/refusal criterion itself is not a property of this type: it is cited the
                same way any other requirement is, through programSpecificationRef, inherited from
                diggs:AbstractProgramDesignType.</documentation>
        </annotation>
    </element>
    <complexType name="TargetConstructionActivityType">
        <annotation>
            <documentation>Base type for planned construction activities.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTargetObjectType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" name="targetSFRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:TargetSamplingFeature</appinfo>
                            <documentation>A reference to the planned sampling feature this activity
                                is to construct or act on - the planned counterpart of
                                diggs:samplingFeatureRef (AbstractConstructionActivityType, where it
                                is mandatory and single-valued). Widened to [0..*] here, matching
                                diggs:TargetMeasurement's targetSFRef rather than a literal mirror of
                                the realized cardinality: a population-scope activity plan (scope,
                                inherited) governs many features without naming one, and an
                                individual activity may reasonably act on more than one feature (a
                                platform excavation spanning several planned columns). Plan-to-plan:
                                cites a TargetSamplingFeature (or one of its specializations,
                                diggs:TargetBorehole / diggs:TargetInstallation), an antecedent
                                within the plan graph, never a realized sampling
                                feature.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="constructionMethod"
                        type="diggs:ConstructionMethodPropertyType">
                        <annotation>
                            <documentation>The method(s) this activity is planned to follow, held
                                inline or by reference (see diggs:ConstructionMethodPropertyType).
                                Unbounded and by-reference-capable because the same method is
                                typically shared across many planned activities - the same reuse
                                reason diggs:TargetMeasurement.measurementMethod was widened for
                                (architecture §9 item 8).</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- EQUIPMENT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->
    <!-- ================================================================================== -->
    <!-- CORING DEVICE ELEMENTS                                                              -->
    <!-- ================================================================================== -->

    <element name="CoringDevice" type="diggs:CoringDeviceType"
        substitutionGroup="diggs:AbstractEquipment" abstract="false">
        <annotation>
            <documentation>An object that contains properties of a borehole coring
                device.</documentation>
        </annotation>
    </element>
    <complexType name="CoringDeviceType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for coring
                device type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="areaRatio" type="diggs:AreaPerAreaMeasureType">
                        <annotation>
                            <documentation>A sample disturbance parameter, defined as the difference
                                of the squares of the outside and inside diameter of the cutting
                                shoe, divided by the square of the inside diameter of the cutting
                                shoe.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelExtension" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Distance that coring device extends beyond drill bit at
                                full extension. Negative values indicate barrel is recessed behind
                                bit.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diamter of inside of core barrel or sampling tube
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diameter of outside of core barrel or sampling
                                tube</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length of core barrel or sampling tube</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="insideClearanceRatio"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>The inside sample diameter minus the cutting shoe inside
                                diameter divided by the cutting shoe inside diameter, expressed as a
                                percentage. A sample disturbance parameter.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="linerPresent" type="boolean">
                        <annotation>
                            <documentation>True if a liner is present in the barrel.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="linerType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of liner material or the type of coating within
                                the coring device (eg. porcelain coating on a shelby tube). Intended
                                to come from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outsideClearanceRatio"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>The outside cutting shoe diameter minus the outside
                                sampler diameter, divided by the outside sampler diameter, expressed
                                as a percentage. A sample disturbance parameter.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Inner diameter of the cutting shoe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Length of the core shoe, eg. the device that fastens onto
                                the lower end of the main core barrel.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Inner diameter of the cutting shoe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeType" type="gml:CodeType">
                        <annotation>
                            <documentation>Refers to the type of shoe used, typically manufacturer
                                specific.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DETECTOR ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Detector" type="diggs:DetectorType">
        <annotation>
            <documentation>A component of a sensor that measures one specific property (measurand),
                optionally along a single geometric axis</documentation>
        </annotation>
    </element>
    <complexType name="DetectorType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for detector
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="detectorLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>The location that the detector measures (eg response zone
                                of the detector)</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="measurand"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>Contains the code value of the property being measured.
                                Codespace must be defined and the value should occur within a
                                dictionary</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>A term describing the type of sensor. Intended to come
                                from a controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisBearing"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>Compass bearing direction (relative to true north)
                                defining the measurement axis direction (for directional
                                measurements, eg. component of an extensometer, accelerometer,
                                etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisInclination"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>Inclination of measurement axis (measured positively down
                                from horizontal); used for directional measurements, eg.
                                extensometer, accelerometer, etc. </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DRILL RIG ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="DrillRig" substitutionGroup="diggs:AbstractEquipment" type="diggs:DrillRigType">
        <annotation>
            <documentation>The drill rig property.</documentation>
        </annotation>
    </element>
    <complexType name="DrillRigType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for drill rig
                type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="engine" type="string">
                        <annotation>
                            <documentation>A text string describing the name and other parameters
                                associated with the engine that drives the drill rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="carrierType" type="gml:CodeType">
                        <annotation>
                            <documentation>A description of the type of device that "carries" the
                                rig, eg. "rubber tire ATV", "truck mounted", "track mounted".
                                Intended to come from a controled list of terms. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tireSizeFront" type="string">
                        <annotation>
                            <documentation>A text string describing the size of the front tires for
                                a rubber tire mounted rig.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tireSizeRear" type="string">
                        <annotation>
                            <documentation>A text string describing the size of the rear tires for a
                                rubber tire mounted rig.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groundBearingPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The typical or maximum pressure exerted on the ground by
                                the weight of the rig.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberForwardGears" type="positiveInteger">
                        <annotation>
                            <documentation>The number of forward gears in the
                                transmission.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberReverseGears" type="positiveInteger">
                        <annotation>
                            <documentation>The number of reverse gears in the
                                transmission.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="transferCaseInfo" type="string">
                        <annotation>
                            <documentation>A text string describing the transfer case capabilities,
                                eg. "air shift controls for drill, rear axle (4x2) and front axle
                                (4x4)"</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="axleInfo" type="string">
                        <annotation>
                            <documentation>A text string describing axle information where
                                applicable, eg. "planetary with no-spin differentials, front and
                                rear"</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="winchCapacity"
                        type="diggs:WinchCapacityMeasureType">
                        <annotation>
                            <documentation>Maximum capacity of the winch (expressed as a
                                weight).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterTankCapacity" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>Maximum volume of the onboard water tank.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="levelingSystem" type="string">
                        <annotation>
                            <documentation>A text string describing the system used for leveling the
                                rig (eg."Three hydraulic jacks, 36 inch (91.4 cm) stroke"
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rotaryDriveMaxTorque"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>The maximum torque produced by the rotary drive system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rotaryDriveMaxSpeed"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>The maximum rotational speed of the rotary drive system.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="rotaryDriveGearRatio"
                        type="diggs:rotaryDriveGearRatioMeasureType">
                        <annotation>
                            <documentation>The ratio between the input rotation speed at the head
                                and rotation of the bit, depending on the gear
                                selected.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pullDownForceMax" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Maximum crowd or pulldown force of the feed
                                system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="feedRateMax" type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>Maximum rate that the rig can feed the drill pipe into
                                the ground</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="retractForceMax" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Maximum retract force of the feed system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="retractRateMax"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>Maximum rate that the rig can retract the drill
                                pipe</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="strokeMax" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Maximum stroke height of the feed system.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdSystemType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of system used to apply downward pressure
                                (typically winch or cylinder). Intended to come from a controlled
                                list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdCylinderArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>For a cylinder crowd system, this property holds the
                                cross-sectional area of the crowd sylinder.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baselineCrowdPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The standard operating pressure for crowd force
                                application on the drill rig,</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdConversionCoeff" type="double">
                        <annotation>
                            <documentation>The ratio of crowd force to the pressure applied
                                (force/pressure) to convert crowd pressure to force.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baselineTorquePressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The standard operating pressure for torque application on
                                the drill rig,</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="noHydraulicMotors" type="integer">
                        <annotation>
                            <documentation>The count of hydraulic motors used in the drilling
                                setup.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxHydMotorDisplacement"
                        type="diggs:VolumePerRotationMeasureType">
                        <annotation>
                            <documentation>he maximum volume displaced by the hydraulic motor per
                                revolution.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minHydMotorDisplacement"
                        type="diggs:VolumePerRotationMeasureType">
                        <annotation>
                            <documentation>The minimum volume displaced by the hydraulic motor per
                                revolution.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxHydPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The highest pressure at which the drill rig's hydraulic
                                system can operate.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxTorque" type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>The highest rotational force that can be applied by the
                                drill rig</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mastLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Nominal length of the mast, typically measured from
                                ground to sheaves.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="rotaryDriveGearRatioMeasureType">
        <annotation>
            <documentation>Concrete type extending double. Provides implementation for rotary drive
                gear ratio measure type.</documentation>
        </annotation>
        <simpleContent>
            <extension base="double">
                <attribute name="gearNumber" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>The gear number associated with this ratio (eg. 1, 2 or 3
                            etc.</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="WinchCapacityMeasureType">
        <annotation>
            <documentation>Concrete type extending ForceMeasureType. Provides implementation for
                winch capacity measure type.</documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:ForceMeasureType">
                <attribute name="winchLocation" type="string">
                    <annotation>
                        <documentation>Location of the winch on the rig (eg. front,
                            rear)</documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- EQUIPMENT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="Equipment" type="diggs:EquipmentType" substitutionGroup="diggs:AbstractEquipment"
        abstract="false">
        <annotation>
            <documentation>Generic Equipment object, contains only the properties of the base type.
                Used where a more specialized equipment object is not needed or not
                developed.</documentation>
        </annotation>
    </element>
    <complexType name="EquipmentType">
        <annotation>
            <documentation>Concrete type extending AbstractEquipmentType. Provides implementation
                for equipment type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType"/>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SENSOR ELEMENTS                                                                    -->
    <!-- ================================================================================== -->

    <element name="Sensor" type="diggs:SensorType" substitutionGroup="diggs:AbstractSensor"
        abstract="false">
        <annotation>
            <documentation>An instrument used to take readings as part of a measurement. A sensor
                inherits from AbstractEquipment and may be assigned to a location via a coordinate
                or by a text description. In addition, a sensor can also have one or more detectors,
                each of which can also be assigned a location, plus a measurand, and a measiurement
                axis orientation.</documentation>
        </annotation>
    </element>
    <element name="sensorRef" type="diggs:FeatureReferenceType">
        <annotation>
            <documentation>A reference to a sensor that is associated with this feature. </documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <complexType name="SensorPropertyType">
        <annotation>
            <documentation>Property type for sensor references. Used to wrap sensor objects or
                references in properties.</documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Sensor" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="SensorType">
        <annotation>
            <documentation>Concrete type extending AbstractSensorType. Provides implementation for
                sensor type.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSensorType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TRIAXIAL TEST EQUIPMENT ELEMENTS                                                   -->
    <!-- ================================================================================== -->

    <element abstract="false" name="TriaxialTestEquipment"
        substitutionGroup="diggs:AbstractEquipment" type="diggs:TriaxialTestEquipmentType">
        <annotation>
            <documentation>An object that contains properties to capture specific parameters of
                triaxial test proecdure equipment.</documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestEquipmentType">
        <annotation>
            <documentation>Extended type based on AbstractEquipmentType. Adds elements for triaxial
                test equipment type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="loadCellCapacity" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>The load cell capacity property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="massOfTopPorousStone" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>The mass of top porous stone property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="massOfTopCap" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>The mass of top cap property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Type of pressure transducer, eg. single pressure
                                transducer, effective stress transducer. Intended to come from a
                                controlled list of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="poreWaterPressureDeviceMeetsUndrainedSpecs"
                        type="boolean">
                        <annotation>
                            <documentation>For undrained tests, this property is true if pore water
                                pressure measurement system satisfies the requirment that the volume
                                change due to pore water pressure change divided by total volume of
                                specimen divided by the change in pore pressue less than 3.2 X 10-6
                                m2/kN (2.2 X 10-5 in2/lb (ASTM 4761-11, Sec. 5.8)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureTransducerType" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of pressure transducer, eg. single pressure
                                transducer, effective stress transducer. Intended to come from a
                                controlled list of terms.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SPECIMEN ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element name="SoilSpecimen" type="diggs:SoilSpecimenType"
        substitutionGroup="diggs:AbstractSpecimen">
        <annotation>
            <documentation>A specialization of a specimen that describes the physical conditions of
                a soil sample or samples subjected to testing.</documentation>
        </annotation>
    </element>
    <complexType name="SoilSpecimenType">
        <annotation>
            <documentation>Extended type based on AbstractSpecimenType. Adds elements for soil
                specimen type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="conditionPreTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>Describes the physical conditions of the sample
                                pre-test</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionIntermediate"
                        type="diggs:SpecimenConditionsPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Describes the physical conditions of the specimen at an
                                intermediate stage during the test.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionPostTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>Describes the physical conditions of the specimen
                                post-test. For triaxial tests, this condition is used to report
                                specimen conditions following consolidation stage.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="intactSpecimenPreparationInfo"
                        type="diggs:IntactSpecimenPreparationInfoPropertyType">
                        <annotation>
                            <documentation>Provides information on preparation of intact specimens,
                                such as whether and how specimen was trimmed for
                                testing</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="reconstitutedSpecimenPreparationInfo"
                        type="diggs:ReconstitutedSpecimenPreparationInfoPropertyType">
                        <annotation>
                            <documentation>Provides information on the preparation of reconstituted
                                samples (eg. number of lifts, compactor type, etc.)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sizeFraction" type="diggs:SizeFractionPropertyType">
                        <annotation>
                            <documentation>For soil speciments, size fraction from which test
                                portion was obtained</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityOfSolids"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>Specific gravity of soil solids (Gs) is the ratio of the
                                density of a substance to the density of a reference substance,
                                usually water at 4 deg C; equivalently, it is the ratio of the mass
                                of a substance to the mass of a reference substance for the same
                                given volume.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenType" type="diggs:SpecimenTypeType">
                        <annotation>
                            <documentation>The structural condition of the soil specimen being
                                tested, defined by the following controlled terms: 1) intact -
                                specimen prepared without disturbance from an "undisturbed" sample
                                (eg. thin-walled sampler); 2) disturbed - specimen prepared from a
                                disturbed sample (eg. thick walled sampler; 3) remolded - specimen
                                prepared from a failed or otherwise disturbed intact specimen; 4)
                                reconstituted - specimen prepared to a predetermined water content
                                and density</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="RockSpecimen" type="diggs:RockSpecimenType"
        substitutionGroup="diggs:AbstractSpecimen">
        <annotation>
            <documentation>A specialization of a specimen that describes the physical conditions of
                a rock sample or samples subjected to testing.</documentation>
        </annotation>
    </element>
    <complexType name="RockSpecimenType">
        <annotation>
            <documentation>Extended type based on AbstractSpecimenType. Adds elements for rock
                specimen type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="conditionPreTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>Describes the physical conditions of the specimen
                                pre-test</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionIntermediate"
                        type="diggs:SpecimenConditionsPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>Describes the physical conditions of the specimen at an
                                intermediate stage during the test.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionPostTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>Describes the physical conditions of the specimen
                                post-test. For triaxial tests, this condition is used to report
                                specimen conditions following consolidation stage.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="ReconstitutedSpecimenPreparationInfo"
        type="diggs:ReconstitutedSpecimenPreparationInfoType">
        <annotation>
            <documentation>An object containing properties about a reconsituted specimen for
                testing.</documentation>
        </annotation>
    </element>
    <complexType name="ReconstitutedSpecimenPreparationInfoPropertyType">
        <annotation>
            <documentation>Property type for reconstituted specimen preparation info references.
                Used to wrap reconstituted specimen preparation info objects or references in
                properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ReconstitutedSpecimenPreparationInfo"/>
        </sequence>
    </complexType>
    <complexType name="ReconstitutedSpecimenPreparationInfoType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for
                reconstituted specimen preparation info type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="compactorType"
                        type="diggs:ReconstitutedSpecimenCompactorType">
                        <annotation>
                            <documentation>Type of compactor used, from an enumerated list: Drop
                                hammer, Harvard miniature, Static rod, Other: (with uncontrolled
                                string following colon).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberOfLifts" type="positiveInteger">
                        <annotation>
                            <documentation>Type of compactor used, from an enumerated list: Drop
                                hammer, Harvard miniature, Static rod, Other: (with uncontrolled
                                string following colon).</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="relativeCompaction"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>The relative compaction property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterContentRelativeToOptimum" type="double">
                        <annotation>
                            <documentation>Water content relative to optimum water content,
                                expressed as decimal (eg. water content at optimum =
                                1)</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ReconstitutedSpecimenCompactorEnumType">
        <annotation>
            <documentation>Enumeration defining reconstituted specimen compactor enum type values.
                Contains 3 allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Drop hammer">
                <annotation>
                    <documentation>Drop hammer - drop hammer value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Harvard miniature">
                <annotation>
                    <documentation>Harvard miniature - harvard miniature value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="Static rod">
                <annotation>
                    <documentation>Short integer data value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
