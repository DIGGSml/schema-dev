<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <annotation>
        <documentation> Includes core geotechnical features: projects, sampling features, sampling
            activities and samples, observations, measurements, equipment, geometry and time objects
            and related elements. This module provides the fundamental data structures for
            documenting site investigations including project metadata, borehole construction
            details, sample descriptions, field testing, and laboratory analysis. This is the heart
            of the DIGGS Core profile. </documentation>
    </annotation>

    <!-- Uncomment to clear validation errors without a master file
    <include schemaLocation="../Diggs.xsd"/>
-->

    <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml3.2Profile_diggs.xsd"/>
    <import namespace="http://www.w3.org/1999/xlink" schemaLocation="xlinks.xsd"/>

    <!-- ================================================================================== -->
    <!-- DOCUMENT INFORMATION ELEMENTS                                                      -->
    <!-- ================================================================================== -->
    <element name="DocumentInformation" type="diggs:DocumentInformationType" abstract="false">
        <annotation>
            <documentation>
                Metadata about the DIGGS instance document itself: who created it, when, with what
                software, and for whom.
            </documentation>
        </annotation>
    </element>
    <complexType name="DocumentInformationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="creationDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date the instance file was created.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date from which the data in the instance are effective.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="expirationDate" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date after which the data in the instance are no longer valid.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="author" type="diggs:BusinessAssociatePropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The author of the document. Repeat for each author.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="disclaimer" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                Conditions and limitations that apply to the data.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="sourceSoftware" type="diggs:SoftwareApplicationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The software that created the instance. Repeat for each application.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="destination" type="string">
                        <annotation>
                            <documentation>
                                The intended destination of the instance.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="destinationSoftware" type="diggs:SoftwareApplicationPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The software the instance is intended to be consumed by. Repeat for
                                each application.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="auditTrail" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A remark in the history of transmissions of the instance. Repeat for
                                each transmission.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="crs"
                        type="diggs:CRSPropertyType">
                        <annotation>
                            <documentation>
                                A coordinate reference system used by the instance, given as a
                                gml:AbstractCRS object. Repeat for each system.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DocumentInformationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DocumentInformation object inline.
            </documentation>
        </annotation>
        <sequence>
            <element minOccurs="1" maxOccurs="1" ref="diggs:DocumentInformation"/>
        </sequence>
    </complexType>
    <complexType name="CRSPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for gml:AbstractCRS inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="gml:AbstractCRS"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- PROJECT ELEMENTS                                                                   -->
    <!-- ================================================================================== -->

    <element name="Project" type="diggs:ProjectType" substitutionGroup="diggs:AbstractProject"
        abstract="false">
        <annotation>
            <documentation>
                A business activity that encompasses a collection of sampling features, activities,
                samples, observations and measurements, and is typically undertaken for a specific
                outcome such as a research publication, a design or a geotechnical construction
                (deep foundation, earthwork and so on). A project may occur at a physical location,
                in which case it can contain geometries.
            </documentation>
        </annotation>
    </element>
    <complexType name="ProjectType">
        <complexContent>
            <extension base="diggs:AbstractProjectType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ProjectPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractProject
                inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractProject"> </element>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GENERAL SAMPLING FEATURE ELEMENTS                                                  -->
    <!-- ================================================================================== -->
    <element name="InstallationEvent" type="diggs:InstallationEventType">
        <annotation>
            <documentation>
                A time or depth related event that occurred during the creation of an installation
                feature.
            </documentation>
        </annotation>
    </element>
    <complexType name="InstallationEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- BOREHOLE ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Borehole"
        substitutionGroup="diggs:AbstractLinearSamplingFeature" type="diggs:BoreholeType">
        <annotation>
            <documentation>
                A deep, narrow excavation made by drilling or extraction of earth material,
                typically to investigate subsurface geologic or geotechnical conditions, to explore
                for water or oil, or to install wells or other downhole monitoring installations.
            </documentation>
        </annotation>
    </element>
    <element name="BoreholeConstructionMethod" type="diggs:BoreholeConstructionMethodType">
        <annotation>
            <documentation>
                The method and equipment used to construct a borehole, or a part of it.
            </documentation>
        </annotation>
    </element>
    <complexType name="BoreholeConstructionMethodPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:BoreholeConstructionMethod object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BoreholeConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeConstructionMethodType">
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The part of the borehole that this construction method applies to.
                                If omitted, the method applies to the entire extent of the sampling
                                feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the construction method was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeStability" type="string">
                        <annotation>
                            <documentation>
                                A description of the stability of the hole during the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                A diggs:Specification that describes the details of the construction
                                method. Use gml:name on this object, not this element, to name the
                                method. Repeat for each specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                The equipment used to construct the borehole, as a diggs:Equipment
                                feature. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cuttingToolInfo"
                        type="diggs:CuttingToolArrayPropertyType">
                        <annotation>
                            <documentation>
                                The cutting tools (bits) used during this method.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="drillPipeInfo"
                        type="diggs:DrillPipeArrayPropertyType">
                        <annotation>
                            <documentation>
                                The drill pipe used during this method.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hydraulicFluidFlowRate"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The flow rate of the hydraulic fluid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeDiameter" type="diggs:BoreholeDiameterType">
        <annotation>
            <documentation>
                The diameter of a borehole over a depth interval.
            </documentation>
        </annotation>
    </element>
    <complexType name="BoreholeDiameterPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:BoreholeDiameter object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:BoreholeDiameter" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeDiameterType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="diameterLocation" type="diggs:LinearExtentPropertyType"
                        maxOccurs="1" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth interval, in the hole's linear referencing system, that
                                the diameter applies to. If omitted, the diameter applies to the
                                entire length of the hole.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="diameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the borehole over the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="computedBoreholeCrossSectionalArea"
                        type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the borehole over the interval, computed
                                from the inferred diameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="computedBoreholeVolume"
                        type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the borehole over the interval, computed from the
                                inferred diameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeEvent" type="diggs:BoreholeEventType">
        <annotation>
            <documentation>
                A non-geological event recorded during construction of a borehole, at a depth or
                time. Typical content is driller's comments from the drilling log, such as an
                incident ("Fishing for broken U100"), a record that fits no other group ("Pushing
                boulder ahead of casing") or a non-geological observation ("Strong petrol smell").
            </documentation>
        </annotation>
    </element>
    <complexType name="BoreholeEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:BoreholeEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BoreholeEvent"/>
        </sequence>
    </complexType>
    <complexType name="BoreholeEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="casingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The depth of the base of the casing installed at the time of the
                                event, in the hole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeBottom" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The depth of the base of the hole at the time of the event, in the
                                hole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element minOccurs="0" name="waterDepth"
                            type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>
                                    The depth to the water surface measured at the time of the
                                    event, in the hole's linear referencing system.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="isDry" type="boolean" fixed="true">
                            <annotation>
                                <documentation>
                                    True if the hole was dry at the time of the event.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="BoreholeType">
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the hole was constructed, covering the
                                entire time the drill rig was on site.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="whenDestroyed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the hole was destroyed or permanently
                                abandoned. It follows all observations, measurements and activities
                                in the hole and marks the time after which none is possible.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalMeasuredDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measured depth to the bottom of the hole, in the hole's linear
                                referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:holeBearing"/>
                    <element minOccurs="0" ref="diggs:holePlunge"/>
                    <element maxOccurs="1" minOccurs="0" name="boreholePurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose for drilling the hole, for example exploratory boring or
                                monitoring well. Use the DIGGS dictionary boreholePurpose.xml for
                                the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="boreholeType"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                A classifier of the type of boring, which applications can use to
                                identify boreholes that need different data storage structures. It
                                does not describe the construction method; use
                                diggs:BoreholeConstructionMethod for that. Use the DIGGS dictionary
                                boreholeType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The backfill placed in the borehole after drilling, including
                                backfill installed during well construction or rock grouting. Repeat
                                for each backfill operation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The casing installed while drilling or after completion. Repeat for
                                each casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:BoreholeConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The construction method applied over a depth interval of the hole.
                                Repeat for each interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:BoreholeEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An event recorded during construction of the borehole. Repeat for
                                each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:chiseling"/>
                    <element name="drillAdvancement" maxOccurs="unbounded" minOccurs="0"
                        type="diggs:DrillAdvancementArrayPropertyType">
                        <annotation>
                            <documentation>
                                The drilling parameters recorded while advancing the hole. Repeat
                                for each set of advancement objects, for example an initial drilling
                                and a redrill.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="flush" type="diggs:FlushPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                Flushing of the borehole with fluid, with the fluid type, return and
                                color. Repeat for each flushed zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holeDiameter"
                        type="diggs:BoreholeDiameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The borehole diameter with depth, generally the bit size used within
                                an interval. A caliper log gives detailed diameter measurements,
                                which are a diggs:Test property from a wireline log procedure.
                                Repeat for each interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterStrike" type="diggs:WaterStrikePropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A record of ground water struck during drilling of the hole. Repeat
                                for each strike.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Advancement" type="diggs:AdvancementType">
        <annotation>
            <documentation>
                Drilling parameters recorded while a section of the borehole is advanced.
            </documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="AdvancementType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="location" type="diggs:LinearExtentPropertyType" minOccurs="1">
                        <annotation>
                            <documentation>
                                The measured depth interval of the section of the borehole reported.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="time" type="diggs:TimeIntervalPropertyType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The start time, end time and duration of advancing the section.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="elapsedTime" type="diggs:TimeMeasureType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The time taken to advance over the interval.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element name="advancementRate" type="diggs:LengthPerTimeMeasureType"
                        minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The rate of advancement over the interval. Give it in addition to,
                                or instead of, time or elapsedTime.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="downwardThrust" minOccurs="0" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The downward thrust on the bit.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="downthrustPressure" minOccurs="0"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pressure of the downthrust system.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="energyDensity" minOccurs="0"
                        type="diggs:EnergyPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The specific energy of drilling.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fluidCirculationRate" minOccurs="0"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The circulation rate of the drilling fluid (mud).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fluidPressurePump" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pressure of the drilling fluid (usually mud) at the pump outlet.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fluidRecoveryRate" minOccurs="0"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The recovery rate of the drilling fluid (mud).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidWeight"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The mass per unit volume of the drilling fluid; synonymous with
                                fluid density or mud weight.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammeringUsed" minOccurs="0" type="boolean">
                        <annotation>
                            <documentation>
                                True if the drill stem was hammered while advancing, for example
                                when chiseling.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chiselingToolUsed" type="gml:StringOrRefType">
                        <annotation>
                            <documentation>
                                The tool used for chiseling, as a string or a reference to a
                                diggs:Equipment metadata object. Use a string from a controlled list
                                of terms where one is available.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerPressure" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The supply pressure to the downhole hammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="mechanicalSpecificEnergy" minOccurs="0"
                        type="diggs:EnergyPerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The energy required to remove a unit volume of rock.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:penetrationRate"/>
                    <element name="restrainingForce" minOccurs="0" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The restraining (holdback) force.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="restrainingPressure" minOccurs="0"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pressure of the restraining (holdback) system.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rotationalSpeed" minOccurs="0"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>
                                The rotational speed of the drill head.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rotationalTorque" minOccurs="0"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The rotational torque on the drill head.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="torqueOnRods" minOccurs="0" type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The torque applied to the top of the drill rods.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="torquePressure" minOccurs="0" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The pressure of the torque system.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Backfill" type="diggs:BackfillType">
        <annotation>
            <documentation>
                Backfilling of a borehole: when it was done and the layers of material placed.
            </documentation>
        </annotation>
    </element>
    <element name="BackfillLayer" type="diggs:BackfillLayerType">
        <annotation>
            <documentation>
                A layer of backfill material placed in a borehole.
            </documentation>
        </annotation>
    </element>
    <complexType name="BackfillLayerPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:BackfillLayer object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:BackfillLayer"/>
        </sequence>
    </complexType>
    <complexType name="BackfillLayerType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="backfillInterval"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The depth interval, in the hole's linear referencing system, where
                                the backfill was placed. If omitted, the backfill information
                                applies to the entire length of the hole.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="whenEmplaced" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the backfill was placed in this interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="backfillMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material used as backfill, for example bentonite, cuttings or
                                sand. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="isSanitarySeal" type="boolean" minOccurs="0">
                        <annotation>
                            <documentation>
                                True if the layer is a sanitary seal.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="backfillVolume" type="diggs:VolumeMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The total volume of backfill material placed in the layer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutingActivityRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:GroutingActivity</appinfo>
                            <documentation>
                                The grouting activity that placed this layer, where pressure and
                                flow rate time series were recorded for it. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groutRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:GroutBatch</appinfo>
                            <documentation>
                                The diggs:GroutBatch used in this layer, where the components of the
                                grout are recorded. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellOpeningRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo>diggs:WellOpening</appinfo>
                            <documentation>
                                The well opening, a diggs:WellOpening held in
                                diggs:WellType/opening, that this layer is associated with. Given by
                                reference only.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="BackfillPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Backfill object inline.
            </documentation>
        </annotation>
        <sequence>
            <element minOccurs="1" ref="diggs:Backfill"/>
        </sequence>
    </complexType>
    <complexType name="BackfillType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="backfillDateTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period over which the entire backfilling operation was
                                conducted. The placement of individual layers is dated in
                                diggs:BackfillLayerType/whenEmplaced.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillLayer"
                        type="diggs:BackfillLayerPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A depth interval where backfill was placed. Intervals do not overlap
                                and have no gaps between them. Repeat for each layer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillType" type="diggs:BackfillTypeEnumType">
                        <annotation>
                            <documentation>
                                The location of the backfilling: in the annular space within the
                                borehole, the annular space between casings, an open hole, or within
                                the innermost casing. Values come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="BackfillTypeEnumType">
        <restriction base="string">
            <enumeration value="annular space within borehole">
                <annotation>
                    <documentation>
                        Backfilling in the annular space between the outer casing and the natural
                        borehole wall.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="annular space within casings">
                <annotation>
                    <documentation>
                        Backfilling in the annular space between nested casings.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="open hole">
                <annotation>
                    <documentation>
                        Backfilling in an open hole.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="within casing">
                <annotation>
                    <documentation>
                        Backfilling within the innermost casing.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="Casing" type="diggs:CasingType">
        <annotation>
            <documentation>
                Casing installed in a borehole or well.
            </documentation>
        </annotation>
    </element>
    <complexType name="CasingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Casing object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Casing"/>
        </sequence>
    </complexType>
    <complexType name="CasingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="casingLocation"
                        type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The depth interval of the casing once fully installed and advanced.
                                If omitted, the casing information applies to the entire length of
                                the borehole or well.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingOutsideDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The outside diameter of the casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingInsideDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The inside diameter of the casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingWallThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The wall thickness of the casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material the casing is made of, for example PVC or stainless
                                steel. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="numberGroutPorts"
                        type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of grout ports, where the casing is an overburden casing
                                as sleeve pipe (OCSP) or other casing through which grout is
                                injected.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="timeCasingInstalled"
                        type="diggs:TimeIntervalType">
                        <annotation>
                            <documentation>
                                The period over which the casing was installed.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="timeCasingRemoved"
                        type="diggs:TimeIntervalType">
                        <annotation>
                            <documentation>
                                The period over which the casing was removed.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="casingAdvancement"
                        type="diggs:CasingAdvancementPropertyType">
                        <annotation>
                            <documentation>
                                An advancement or retraction of the casing. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="CasingAdvancement" type="diggs:CasingAdvancementType">
        <annotation>
            <documentation>
                An advancement of casing while drilling, or retraction during an activity such as
                grouting, with the time interval and the start and end positions of the casing base.
            </documentation>
        </annotation>
    </element>
    <complexType name="CasingAdvancementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:CasingAdvancement object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:CasingAdvancement"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="CasingAdvancementType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="advancementTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The start and end time of the casing advancement interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBaseAtStart"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the base of the casing at the start of the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBaseAtEnd"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the base of the casing at the end of the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingBlows" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of blows needed to drive the casing the distance
                                reported, where the casing is driven. Describe the process in the
                                equipment or construction method object.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="CuttingToolArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:CuttingTool objects inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:CuttingTool"/>
        </sequence>
    </complexType>
    <element name="CuttingTool" type="diggs:CuttingToolType">
        <annotation>
            <documentation>
                A cutting tool (bit) used for drilling.
            </documentation>
        </annotation>
    </element>
    <complexType name="CuttingToolType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="toolType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of cutting tool used, for example hollow-stem auger,
                                tri-cone bit or roller bit. Use the DIGGS dictionary
                                cuttingToolType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="classIADC" type="gml:CodeType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The four-character International Association of Drilling Contractors
                                (IADC) code assigned to a roller cone or fixed cutter (PDC) bit. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="make" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The manufacturer or brand of the cutting tool.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="modelNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The model name or number of the cutting tool.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="serialNumber" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The serial number that identifies the individual cutting tool.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The inner diameter of the tool or bit, where applicable (for example
                                a hollow-stem auger).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The outer diameter of the tool or bit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material the tool is made from, for example tungsten carbide. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolWearStart" type="string">
                        <annotation>
                            <documentation>
                                The condition (wear) of the tool at the start of the interval,
                                qualitative or quantitative (for example a gauge ring diameter).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toolWearEnd" type="string">
                        <annotation>
                            <documentation>
                                The condition (wear) of the tool at the end of the interval,
                                qualitative or quantitative (for example a gauge ring diameter).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DrillAdvancementArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:Advancement objects inline. The
                setName attribute identifies the set.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element maxOccurs="1" minOccurs="0" ref="diggs:Advancement"/>
        </sequence>
        <attribute name="setName" type="string">
            <annotation>
                <documentation>
                    A name for this set of diggs:Advancement objects, to account for redrilling over
                    a depth range. Each set corresponds to one drilling event over a depth range
                    that encompasses the set, for example "Initial" or "Redrill 1".
                </documentation>
            </annotation>
        </attribute>
    </complexType>
    <complexType name="DrillPipeType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="pipeInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The inner diameter of the drill pipe, where hollow pipe is used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The outer diameter of the drill pipe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material the pipe is made from, for example steel. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pipeSectionLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of each pipe section used over the depth interval. If
                                section lengths change, give a new diggs:DrillPipe for the new
                                interval.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="pipeSectcionWeight" type="diggs:ForceMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:pipeSectionWeight"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use pipeSectionWeight; this name is a misspelling of
                                    it. The weight of one pipe section used in the interval.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="pipeSectionWeight" type="diggs:ForceMeasureType">
                            <annotation>
                                <documentation>
                                    The weight of one pipe section used in the interval. Use this
                                    element, not the deprecated pipeSectcionWeight.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="DrillPipeArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:DrillPipe objects inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded" minOccurs="1">
            <element ref="diggs:DrillPipe"/>
        </sequence>
    </complexType>
    <element name="DrillPipe" type="diggs:DrillPipeType">
        <annotation>
            <documentation>
                A drill pipe, or a run of identical pipe sections, used in drilling.
            </documentation>
        </annotation>
    </element>
    <element name="Flush" type="diggs:FlushType">
        <annotation>
            <documentation>
                Flushing of a borehole with fluid.
            </documentation>
        </annotation>
    </element>
    <complexType name="FlushPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Flush object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Flush" maxOccurs="1" minOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="FlushType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="flushZoneLocation" type="diggs:LinearExtentPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth interval of the flush zone, in the hole's linear
                                referencing system. If omitted, the flushing applies to the entire
                                hole length.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of fluid used for flushing. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minFlushReturn"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The minimum percentage of the fluid that returns from the hole after
                                flushing.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="maxflushReturn" type="diggs:VolumePerVolumeMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:maxFlushReturn"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use maxFlushReturn; this name is a misspelling of
                                    it. The maximum percentage of the fluid that returns from the
                                    hole after flushing.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="maxFlushReturn" type="diggs:VolumePerVolumeMeasureType">
                            <annotation>
                                <documentation>
                                    The maximum percentage of the fluid that returns from the hole
                                    after flushing. Use this element, not the deprecated
                                    maxflushReturn.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="flushColor" type="string">
                        <annotation>
                            <documentation>
                                The color of the fluid return, as free text.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="WaterStrike" type="diggs:WaterStrikeType">
        <annotation>
            <documentation>
                One or more water level readings taken on encountering, or expecting to encounter,
                water during drilling. A strike may be individual measurements taken as drilling
                progresses, or a series of measurements taken over a short interval while drilling
                is halted at a depth.
            </documentation>
        </annotation>
    </element>
    <complexType name="WaterStrikePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:WaterStrike object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:WaterStrike"/>
        </sequence>
    </complexType>
    <element name="WaterStrikeReading" type="diggs:WaterStrikeReadingType">
        <annotation>
            <documentation>
                A water level reading following a water strike.
            </documentation>
        </annotation>
    </element>
    <element name="LinkedWSReading" type="diggs:LinkedWSReadingType">
        <annotation>
            <documentation>
                A water level reading linked to an earlier reading of the same water strike.
            </documentation>
        </annotation>
    </element>
    <complexType name="WaterStrikeReadingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:WaterStrikeReading object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:WaterStrikeReading"/>
        </sequence>
    </complexType>
    <complexType name="LinkedWSReadingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LinkedWSReading object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:LinkedWSReading"/>
        </sequence>
    </complexType>
    <complexType name="WaterStrikeReadingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="elapsedTime" type="diggs:TimeMeasureType">
                            <annotation>
                                <documentation>
                                    The time elapsed since the initial water strike when the water
                                    level was measured again.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="dateTime" type="gml:TimePositionType" minOccurs="1">
                            <annotation>
                                <documentation>
                                    The date and time of the water strike measurement.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice>
                        <element name="notEncountered" fixed="true" type="boolean" minOccurs="1">
                            <annotation>
                                <documentation>
                                    True if water was not encountered.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="waterLocation" type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>
                                    The measured depth to water, in the hole's linear referencing
                                    system.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="unbounded" minOccurs="0" name="linkedReading"
                        type="diggs:LinkedWSReadingPropertyType">
                        <annotation>
                            <documentation>
                                A later reading linked to this one. Repeat for each.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LinkedWSReadingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="elapsedTime" type="diggs:TimeMeasureType">
                            <annotation>
                                <documentation>
                                    The time elapsed since the initial water strike when the water
                                    level was measured again.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="dateTime" type="gml:TimePositionType" minOccurs="1">
                            <annotation>
                                <documentation>
                                    The date and time of the water strike measurement.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice>
                        <element name="notEncountered" fixed="true" type="boolean" minOccurs="1">
                            <annotation>
                                <documentation>
                                    True if water was not encountered.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="waterLocation" type="diggs:PointLocationPropertyType">
                            <annotation>
                                <documentation>
                                    The measured depth to water, in the hole's linear referencing
                                    system.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="WaterStrikeType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence minOccurs="0">
                    <element name="waterStrikeReadings" type="diggs:WaterStrikeReadingPropertyType">
                        <annotation>
                            <documentation>
                                The water level readings taken as part of this water strike.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sealLocation"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The location where the water strike is sealed off by casing, in the
                                borehole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bottomCasing"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The measured depth to the base of the casing at the time of the
                                water strike, in the borehole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bottomHole" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the bottom of the hole when the water strike
                                readings were made, in the hole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- CONSTRUCTION ACTIVITY METHOD ELEMENTS                                              -->
    <!-- (declared ahead of the Sounding elements below; used by any construction activity) -->
    <!-- ================================================================================== -->
    <element name="ConstructionActivityMethod" type="diggs:ConstructionActivityMethodType">
        <annotation>
            <documentation>
                A construction method together with the part of the constructed feature it was
                applied to. Where the method changes along the feature, give one object per method,
                each with its own location; where one method applies throughout, give one object and
                omit location.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConstructionActivityMethodType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The part of the constructed feature the method applies to, in the
                                feature's own referencing system, typically a depth interval along a
                                linear feature. If omitted, the method applies to the whole extent
                                of the feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A specification of the method followed over the location, citing or
                                describing the standard, procedure or technique rather than only
                                naming it. Repeat for each specification that applies over the
                                location, for example a driving standard and a grouting standard.
                                State the equipment in the activity's equipment property.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cuttingToolInfo"
                        type="diggs:CuttingToolArrayPropertyType">
                        <annotation>
                            <documentation>
                                The cutting tools used by the method over the location, such as an
                                auger or a bit. The rig that drives the tool is the activity's
                                equipment; the tool is stated here because one rig works with
                                several tools and a method over part of a feature may use a
                                different tool from the rest.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SOUNDING ELEMENTS                                                                  -->
    <!-- ================================================================================== -->
    <element abstract="false" name="Sounding"
        substitutionGroup="diggs:AbstractLinearSamplingFeature" type="diggs:SoundingType">
        <annotation>
            <documentation>
                A sampling feature created by a measurement or construction activity by inserting a
                probe or tool into the ground.
            </documentation>
        </annotation>
    </element>
    <element name="SoundingConstructionMethod" type="diggs:SoundingConstructionMethodType">
        <annotation>
            <documentation>
                The method and equipment used to construct a sounding, or a part of it.
            </documentation>
        </annotation>
    </element>
    <complexType name="SoundingConstructionMethodPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SoundingConstructionMethod object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:SoundingConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="SoundingConstructionMethodType">
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The part of the sounding that this construction method applies to.
                                If omitted, the method applies to the entire extent of the sampling
                                feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the construction method was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                A diggs:Specification that describes the method by which the
                                sounding is constructed over the location. Repeat for each
                                specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <documentation>
                                The equipment used to construct the sounding, as a diggs:Equipment
                                feature. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SoundingEvent" type="diggs:SoundingEventType">
        <annotation>
            <documentation>
                An event, at a location or a time, that occurred during construction of a sounding.
            </documentation>
        </annotation>
    </element>
    <complexType name="SoundingEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SoundingEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:SoundingEvent"/>
        </sequence>
    </complexType>
    <complexType name="SoundingEventType">
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="casingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The measured depth to the base of the casing installed at the time
                                of the event, in the sounding's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="soundingBottom"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The measured depth to the base of the sounding at the time of the
                                event, in the sounding's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SoundingType">
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the sounding was constructed, covering the
                                entire time the rig was on site.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalMeasuredDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measured depth to the bottom of the sounding, in the sounding's
                                linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="soundingPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose of the sounding, for example CPT or flat dilatometer.
                                Use the DIGGS dictionary soundingPurpose.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType">
                        <annotation>
                            <documentation>
                                The backfill placed after the sounding was made.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The casing installed during or after the sounding. Repeat for each
                                casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:SoundingConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The construction method applied over a depth interval of the
                                sounding. Repeat for each interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:SoundingEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An event recorded during construction of the sounding. Repeat for
                                each event.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TRIAL PIT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="TrialPit" substitutionGroup="diggs:AbstractLinearSamplingFeature"
        type="diggs:TrialPitType">
        <annotation>
            <documentation>
                A relatively shallow excavation into the earth's surface, dug manually or by a
                mechanical excavator. Samples, observations and tests in the pit are referenced in a
                linear referencing system only (one dimension). It supports AGS trial pit
                constructs; use diggs:TrenchWall to represent the walls of a pit or trench in two
                dimensions.
            </documentation>
        </annotation>
    </element>
    <element name="TrialPitEvent" type="diggs:TrialPitEventType">
        <annotation>
            <documentation>
                An event that occurred during construction of a trial pit.
            </documentation>
        </annotation>
    </element>
    <complexType name="TrialPitEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TrialPitEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TrialPitEvent"/>
        </sequence>
    </complexType>
    <complexType name="TrialPitEventType">
        <annotation>
            <documentation>
                Type for an event recorded during construction of a trial pit or trench: its depth,
                plan dimensions and stability at that time.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractEventType">
                <sequence>
                    <element minOccurs="0" name="depth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measured depth to the base of the pit or trench at the time of
                                the event, in the pit's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="length" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The horizontal length of the long dimension of the pit or trench at
                                the time of the event.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="width" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The horizontal length of the short dimension of the pit or trench at
                                the time of the event.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stability" type="string">
                        <annotation>
                            <documentation>
                                A description of the stability of the pit or trench at the time of
                                the event.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TrialPitType">
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the pit was excavated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="totalMeasuredDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The maximum depth of the pit, in the pit's linear referencing
                                system.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pitLength" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The length of the long horizontal dimension of the pit.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pitWidth" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The length of the short horizontal dimension of the pit.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="shoring" type="string" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                A description of the shoring equipment and method.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="trialPitPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose for excavating the pit, for example exploratory. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType">
                        <annotation>
                            <documentation>
                                The backfill placed in the pit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionMethod"
                        type="diggs:TrenchConstructionMethodPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The construction method applied over a depth interval of the pit.
                                Repeat for each interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionEvent"
                        type="diggs:TrialPitEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An event recorded during construction of the pit. Repeat for each
                                event.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TrenchConstructionMethod" type="diggs:TrenchConstructionMethodType">
        <annotation>
            <documentation>
                The method and equipment used to construct a trench wall or trial pit, or a part of
                it.
            </documentation>
        </annotation>
    </element>
    <complexType name="TrenchConstructionMethodPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TrenchConstructionMethod object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TrenchConstructionMethod"/>
        </sequence>
    </complexType>
    <complexType name="TrenchConstructionMethodType">
        <complexContent>
            <extension base="diggs:AbstractNamedRoleObjectType">
                <sequence>
                    <element minOccurs="0" ref="diggs:location">
                        <annotation>
                            <documentation>
                                The part of the sampling feature that this construction method
                                applies to. If omitted, the method applies to the entire extent of
                                the sampling feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="methodTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the construction method was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trenchStability" type="string">
                        <annotation>
                            <documentation>
                                A description of the stability of the trench during the interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionMethod" type="diggs:SpecificationPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:Specification</appinfo>
                            <documentation>
                                A diggs:Specification that describes the method of construction over
                                the location. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="constructionEquipment" type="diggs:EquipmentPropertyType"
                        maxOccurs="unbounded" minOccurs="0">
                        <annotation>
                            <appinfo>diggs:AbstractEquipment</appinfo>
                            <documentation>
                                The equipment used to construct the trench or pit, as a
                                diggs:Equipment feature. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- WELL ELEMENTS                                                                      -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Well" substitutionGroup="diggs:AbstractLinearInstallation"
        type="diggs:WellType">
        <annotation>
            <documentation>
                An installation within a borehole or sounding, used to observe, withdraw or inject
                fluids. A well is a sampling feature in its own right and must cite its parent
                borehole or sounding in the mandatory samplingFeatureRef property.
            </documentation>
        </annotation>
    </element>
    <element name="WellOpening" type="diggs:WellOpeningType">
        <annotation>
            <documentation>
                The location and characteristics of a well screen or of perforations in a well.
            </documentation>
        </annotation>
    </element>
    <complexType name="WellOpeningPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:WellOpening object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:WellOpening"/>
        </sequence>
    </complexType>
    <complexType name="WellOpeningType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" name="openInterval" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The depth interval in which the well openings occur, in the well's
                                linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:filterPackInterval"/>
                    <element minOccurs="0" name="openingLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of an opening.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The width of an opening.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of an opening.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of well screen or perforation, for example wire-wound
                                screen, louvered or shuttered, or perforated casing. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="openingMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material the well screen or perforated interval is made of. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="WellType">
        <complexContent>
            <extension base="diggs:AbstractLinearInstallationType">
                <sequence>
                    <element minOccurs="0" name="aquiferTested" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The name or identifier of the aquifer sampled by the well. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fluidPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                For a production or extraction well, the purpose of the fluid, for
                                example public supply or municipal. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialDevelopmentMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>
                                The method used to develop the well after initial construction, for
                                example compressed air or surging.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialDevelopmentTime"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The time required for initial development.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maintenanceEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A maintenance or servicing event of the well. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="opening" type="diggs:WellOpeningPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The location and type of the openings (perforations) that allow
                                fluid communication between the well and the adjacent earth
                                material. Repeat for each opening interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:sanitarySealLocation"/>
                    <element minOccurs="0" ref="diggs:sanitarySealType">
                        <annotation>
                            <documentation/>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specialTreatment" type="string">
                        <annotation>
                            <documentation>
                                A description of any special procedures used during initial
                                development of the well.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellAbandonment"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                An event in the abandonment of the well, with the procedures
                                performed. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellCasing" type="diggs:CasingPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The type and location of the solid well casing installed. Repeat for
                                each casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The measured depth to the bottom of the well, from the top of the
                                well casing or, if different, from the well's centerline origin.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wellFinishType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the well is finished, for example gravel pack with perforations,
                                open end or sand point. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="wellPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose for installing the well, for example ground water
                                withdrawal or observation. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SamplingFeaturePropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for
                diggs:AbstractSamplingFeature inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractSamplingFeature"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SAMPLING ACTIVITY ELEMENTS                                                         -->
    <!-- ================================================================================== -->

    <element abstract="false" name="SamplingActivity"
        substitutionGroup="diggs:AbstractSamplingActivity" type="diggs:SamplingActivityType">
        <annotation>
            <documentation>
                The action taken to obtain or produce material samples, even if it fails to produce
                one (for example a core run with no recovery). The activity type states whether the
                samples result from collection at a sampling feature, subsampling, aggregation of
                samples, or creation of a test or blank sample. Every sample refers to a sampling
                activity.
            </documentation>
        </annotation>
    </element>
    <complexType name="SamplingActivityType">
        <complexContent>
            <extension base="diggs:AbstractSamplingActivityType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ActivityTypeEnumType">
        <restriction base="string">
            <enumeration value="aggregate">
                <annotation>
                    <documentation>
                        The activity created samples by aggregating existing samples; the associated
                        samples contain more than one sourceSampleRef.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="collect">
                <annotation>
                    <documentation>
                        The activity created samples by collection from a sampling feature.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>
                        The activity failed to produce any physical sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="subsample">
                <annotation>
                    <documentation>
                        The activity created samples by subsampling an existing sample; the
                        associated samples contain only one sourceSampleRef.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="test">
                <annotation>
                    <documentation>
                        The activity produced a test, standard or blank sample that does not relate
                        to any field sample or sampling feature; the activity points to a project,
                        and the associated samples have neither sourceSampleRef nor
                        samplingFeatureRef.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="unknown">
                <annotation>
                    <documentation>
                        No information about the sampling activity exists, for example for legacy
                        data where only the sample name or label and the location (depth) are known.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>

    <!-- ================================================================================== -->
    <!-- SAMPLE ELEMENTS                                                                    -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Sample" substitutionGroup="diggs:AbstractSample"
        type="diggs:SampleType">
        <annotation>
            <documentation>
                A material sample, solid, fluid or gas, obtained as a result of a sampling activity
                for observation or testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="SampleType">
        <complexContent>
            <extension base="diggs:AbstractSampleType">
                <sequence>
                    <element name="relativeReferencingSystem"
                        type="diggs:RelativeReferenceSystemPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                A relative spatial reference system for a core or block sample,
                                locating positions within the sample instead of relative to the
                                sampling feature's origin. The linearElement of
                                diggs:LinearSpatialReferenceSystem then references the sample's
                                location rather than the sampling feature's. Use
                                diggs:LinearSpatialReferenceSystem or diggs:LocalCartesianCRS;
                                diggs:VectorLinearSpatialReferenceSystem is deprecated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="relativeReferenceSystemOrigin" minOccurs="0" maxOccurs="1"
                        type="diggs:RelativeReferenceSystemOriginEnumType">
                        <annotation>
                            <documentation>
                                For a core or block sample whose vertical orientation is preserved,
                                whether the origin of the relative reference system occurs at the
                                top or the bottom of the sample. The linear element is the sample
                                location defined in the associated sampling activity. Values come
                                from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="classification" type="diggs:SampClassEnumType">
                        <annotation>
                            <documentation>
                                The class of sample collected, for example soil, rock or fluid.
                                Values come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of sample. Terms can be general ("bulk", "core") or
                                organization specific, and may incorporate the sample class
                                ("water"), the sampler ("piston sample"), the method ("push
                                sample"), the condition ("undisturbed thin wall tube sample"), the
                                purpose ("soil sample for environmental testing") or an associated
                                test ("SPT sample"). Each serves as shorthand for information also
                                held by other sample or sampling activity properties. Use the DIGGS
                                dictionary sampleType.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="condition" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The condition of the sample after collection or production, for
                                example disturbed. It applies to the whole sample; describe
                                disturbance that varies along a core as a constituent in the
                                sample's lithology observation. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="qualityClass" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The ISO 22475-1 / EC7-2 soil sample quality class (1 to 5), which
                                states what soil properties can be relied on from this recovered
                                sample. It applies to soil only, not rock. See
                                diggs:AbstractSamplingActivityType/samplingCategory for the
                                technique category of the activity, which applies to both soil and
                                rock. Use the DIGGS dictionary qualityClass.xml for the list of
                                values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="extrusionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method by which the sample is removed from its sampler. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialContainer"
                        type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>
                                The container the sample was first placed in.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>
                                The purpose of taking the sample, as free text; typically the test
                                or tests intended for it.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the sample after collection or production and before
                                any subsampling or specimen preparation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleMass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the sample after collection or production and before any
                                subsampling or specimen preparation. Corresponds to
                                diggs:DesignSampleType/plannedSampleMass on the design side.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the sample after collection or production and before
                                any subsampling or specimen preparation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleDimensions"
                        type="diggs:SampleDimensionsPropertyType">
                        <annotation>
                            <documentation>
                                The dimensions of the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleMatrix" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The sample matrix, if applicable. Use the DIGGS dictionary
                                sampleMatrix.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="initialPreservationMethod" type="string">
                        <annotation>
                            <documentation>
                                A description of the methods used to preserve the integrity of the
                                sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chainOfCustodyEvent"
                        type="diggs:ChainOfCustodyEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A custody transfer of the sample. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="otherSampleProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A sample property not provided elsewhere in diggs:SampleType. Repeat
                                for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="coreDistkurbance" type="gml:CodeType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:coreDisturbance"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use coreDisturbance; this name is a misspelling of
                                    it. For a core sample of rock or soil, the kind and intensity of
                                    disturbance from the sampling process, for example biscuiting,
                                    fluid intrusion, drilling breccia, fractured, moderately
                                    disturbed, soupy or partial void. No DIGGS-authored dictionary
                                    currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="coreDisturbance" type="gml:CodeType">
                            <annotation>
                                <documentation>
                                    For a core sample of rock or soil, the kind and intensity of
                                    disturbance from the sampling process, for example biscuiting,
                                    fluid intrusion, drilling breccia, fractured, moderately
                                    disturbed, soupy or partial void. No DIGGS-authored dictionary
                                    currently exists for this element. Use this element, not the
                                    deprecated coreDistkurbance.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="SampClassEnumType">
        <union memberTypes="diggs:OtherNameType diggs:SampleClassificationEnumType"/>
    </simpleType>
    <simpleType name="SampleClassificationEnumType">
        <restriction base="string">
            <enumeration value="Cement">
                <annotation>
                    <documentation>
                        A cement sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Chemical">
                <annotation>
                    <documentation>
                        A chemical sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Fluid">
                <annotation>
                    <documentation>
                        A fluid sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Gas">
                <annotation>
                    <documentation>
                        A gas sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Grout">
                <annotation>
                    <documentation>
                        A grout sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Rock">
                <annotation>
                    <documentation>
                        A rock sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Soil">
                <annotation>
                    <documentation>
                        A soil sample.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="ChainOfCustodyEvent" type="diggs:ChainOfCustodyEventType">
        <annotation>
            <documentation>
                A transfer of custody of a sample from one party to another.
            </documentation>
        </annotation>
    </element>
    <complexType name="ChainOfCustodyEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ChainOfCustodyEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ChainOfCustodyEvent" minOccurs="1"/>
        </sequence>
    </complexType>
    <complexType mixed="false" name="ChainOfCustodyEventType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="sourceCustodian"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>
                                The business associate releasing custody of the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="destinationCustodian"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>
                                The business associate receiving custody of the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateInitiated" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date the sample was shipped, or the custody event was initiated.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dateCompleted" type="gml:TimePositionType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The date the sample was received, or the custody event was
                                completed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleContainer" type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>
                                The sample container, if the sample was repackaged from the initial
                                container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shippingContainer"
                        type="diggs:ContainerPropertyType">
                        <annotation>
                            <documentation>
                                The container the sample containers are transported in.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="storageLocation"
                        type="diggs:LocalityPropertyType">
                        <annotation>
                            <documentation>
                                The location of the sample once it reaches its destination: a
                                diggs:Locality (an address or other local description) or a
                                diggs:PointLocation (coordinates).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="Container" type="diggs:ContainerType">
        <annotation>
            <documentation>
                A physical object that holds a sample.
            </documentation>
        </annotation>
    </element>
    <complexType name="ContainerPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Container object inline, or refers to one with
                xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Container" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <complexType name="ContainerType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="containerLabel" type="string">
                        <annotation>
                            <documentation>
                                The identifier on the container, for example a box number for core,
                                a sample number, or the same value as the sample name.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of container, for example jar, bucket, vial, bag or box. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material the container is made of. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height of the container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="containerWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The width of the container.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="preservativeAdded" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of preservative added to the sample, if any. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="RelativeReferenceSystemOriginEnumType">
        <restriction base="string">
            <enumeration value="top of sample">
                <annotation>
                    <documentation>
                        The origin is at the top of the sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="bottom of sample">
                <annotation>
                    <documentation>
                        The origin is at the bottom of the sample.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="SampleDimensions" type="diggs:SampleDimensionsType">
        <annotation>
            <documentation>
                The dimensions of a solid soil or rock sample.
            </documentation>
        </annotation>
    </element>
    <complexType name="SampleDimensionsType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="diameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For core or cylindrical samples, the diameter of the sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="height" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                For block samples, the length of one side of the block, measured
                                normal to the sampling direction.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="length" type="diggs:LengthMeasureType" minOccurs="0"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                For block or core samples, the length of the sample measured in the
                                sampling direction, for example the core length or the distance
                                between the top and base of the sampling interval of a block sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="width" type="diggs:LengthMeasureType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                For block samples, the length of one side of the block, measured
                                normal to the sampling direction.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SampleDimensionsPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SampleDimensions object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SampleDimensions"/>
        </sequence>
    </complexType>
    <complexType name="SamplePropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractSample
                inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractSample"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DISCONTINUITY OBSERVATION SYSTEM ELEMENTS                                          -->
    <!-- ================================================================================== -->

    <complexType name="DiscontinuityObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element name="fractureObservation" type="diggs:FractureObservationPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The observation of the fracture.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="fractureSpacing" minOccurs="0"
                        type="diggs:FractureSpacingPropertyType">
                        <annotation>
                            <documentation>
                                The spacing of the fractures.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval as defined in the observation's location property
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DiscontinuityObservation" type="diggs:DiscontinuityObservationType"
        substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A discontinuity, or zone of discontinuities, with its mechanical and hydraulic
                properties: a fault, fracture or joint, and its spacing. Discontinuities within a
                system may overlap.
            </documentation>
        </annotation>
    </element>
    <complexType name="DiscontinuityObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:DiscontinuityObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:DiscontinuityObservation"/>
        </sequence>
    </complexType>
    <element name="DiscontinuitySystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:DiscontinuitySystemType">
        <annotation>
            <documentation>
                A system of discontinuity observations.
            </documentation>
        </annotation>
    </element>
    <complexType name="DiscontinuitySystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="discontinuityType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of discontinuity system described, for example joints. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="discontinuityObservation"
                        type="diggs:DiscontinuityObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A discontinuity observation in the system. Repeat for each
                                discontinuity or zone.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FractureObservation" type="diggs:FractureObservationType">
        <annotation>
            <documentation>
                The properties of a fracture observation: orientation, aperture, roughness, infill,
                water flow and related descriptors.
            </documentation>
        </annotation>
    </element>
    <complexType name="FractureObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:FractureObservation object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:FractureObservation"/>
        </sequence>
    </complexType>
    <complexType name="FractureObservationType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="aperatureMeasurement" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:apertureMeasurement"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use apertureMeasurement; this name is a misspelling
                                    of it. The measured aperture of the discontinuity.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="apertureMeasurement" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The measured aperture of the discontinuity. Use this element,
                                    not the deprecated aperatureMeasurement.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="aperatureObservation" type="string">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:apertureObservation"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use apertureObservation; this name is a misspelling
                                    of it. A description of the aperture of the discontinuity.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="apertureObservation" type="string">
                            <annotation>
                                <documentation>
                                    A description of the aperture of the discontinuity. Use this
                                    element, not the deprecated aperatureObservation.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="dipAngle" type="diggs:DipMeasureType">
                        <annotation>
                            <documentation>
                                The dip of the discontinuity, a plane angle measured positive down
                                from the horizontal.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dipDirection" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The dip direction of the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="discontinuityNumber" type="integer">
                        <annotation>
                            <documentation>
                                The number that identifies the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureSetNumber" type="string">
                        <annotation>
                            <documentation>
                                The reference number of the discontinuity set the discontinuity
                                belongs to.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="infillMaterial" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The material filling the discontinuity. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="infillHardness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The hardness of the infill material. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="jointRoughnessCoefficient" type="double">
                        <annotation>
                            <documentation>
                                The joint roughness coefficient (JRC) of the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="persistence" type="double">
                        <annotation>
                            <documentation>
                                The persistence of the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="planarity" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The intermediate-scale planarity of the discontinuity (ISRM 1978).
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="roughness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The small-scale roughness of the discontinuity (ISRM 1978). No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seepageRating" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The seepage rating of the discontinuity (ISRM 1978). No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceAppearance" type="string">
                        <annotation>
                            <documentation>
                                A description of the surface appearance of the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="termination" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The termination of the discontinuity, lower and upper (ISRM 1978).
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of discontinuity. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wallStrength" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The strength of the discontinuity wall.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wallWeathering" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The weathering of the discontinuity wall. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureHealing" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The healing of the fracture, or the state of healed fractures in
                                rock: mineral filling or mineralization (crystallization,
                                precipitation), physical characteristics (cementation,
                                recrystallization), quality (partial healing) and the age of healing
                                (ancient, recent). No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterFlow" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The estimated water flow from the discontinuity.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wavinessAmplitude" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The amplitude of the large-scale waviness of the discontinuity (ISRM
                                1978).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wavinessWavelength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The wavelength of the large-scale waviness of the discontinuity
                                (ISRM 1978).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="FractureSpacing" type="diggs:FractureSpacingType">
        <annotation>
            <documentation>
                The spacing between fractures over a zone.
            </documentation>
        </annotation>
    </element>
    <complexType name="FractureSpacingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:FractureSpacing object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:FractureSpacing"/>
        </sequence>
    </complexType>
    <complexType name="FractureSpacingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence minOccurs="1">
                    <element minOccurs="0" name="minSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The minimum fracture spacing over the zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The maximum fracture spacing over the zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averageSpacing" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The average fracture spacing over the zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fractureCount" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of fractures identified within the extent of the
                                diggs:DiscontinuityObservation.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fracturesPerUnitLength"
                        type="diggs:ReciprocalLengthMeasureType">
                        <annotation>
                            <documentation>
                                The number of fractures per unit length, in the unit of the uom
                                attribute. It exists for compatibility with an AGS field and is not
                                otherwise recommended, because it is specific to boreholes and can
                                be computed from fractureCount and the length of the linear extent
                                of the diggs:DiscontinuityObservation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="placedObservation" type="diggs:PlacedObservationPropertyType">
        <annotation>
            <documentation>
                An observation placed at a location within the observation that holds it, wrapped as
                a property. Repeat for each place.
            </documentation>
        </annotation>
    </element>
    <element name="PlacedObservation" type="diggs:PlacedObservationType">
        <annotation>
            <documentation>
                An observation, as text, assigned to a location. It records general observations at
                places within an observation of an observation system.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlacedObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PlacedObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:PlacedObservation"/>
        </sequence>
    </complexType>
    <complexType name="PlacedObservationType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element ref="diggs:location"/>
                    <element minOccurs="1" name="observation" type="string" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The observation, as text.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GEOUNIT OBSERVATION SYSTEM ELEMENTS                                                -->
    <!-- ================================================================================== -->

    <element name="GeoUnitObservation" type="diggs:GeoUnitObservationType"
        substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A soil or rock unit defined primarily by the value, or a range of values, of one or
                more physical or engineering properties; the criteria that distinguish units depend
                on the engineering application. The three-dimensional body of a unit, if one is
                given, is held by the inherited diggs:location property, which admits any
                diggs:AbstractGeometry, for example a diggs:SurfaceBoundedSolid, diggs:Solid,
                diggs:MultiSolid or diggs:CompositeSolid.
            </documentation>
        </annotation>
    </element>
    <complexType name="GeoUnitObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element minOccurs="1" name="unitName" type="gml:CodeType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The name assigned to the unit, for example "Unit A". No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the unit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDistanceToTopOfUnit"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The vertical distance from the feature's reference point to the top
                                (or beginning) of the unit. It applies only to a one-dimensional
                                unit observed along a single linear sampling feature, such as a
                                borehole log; for a unit synthesized across many boreholes, hold a
                                three-dimensional geometry in diggs:location instead.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="verticalDistanceToBaseOfUnit"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The vertical distance from the feature's reference point to the base
                                (or end) of the unit. It applies only to a one-dimensional unit
                                observed along a single linear sampling feature, as for
                                verticalDistanceToTopOfUnit.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="verticalThicknessOfUnit" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The thickness of the unit, measured vertically: the difference
                                    between verticalDistanceToBaseOfUnit and
                                    verticalDistanceToTopOfUnit along one log. It applies only to a
                                    one-dimensional unit; the thickness of a site-wide unit at a
                                    point follows from the surfaces held in diggs:location.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="verticallThicknessOfUnit" type="diggs:LengthMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:verticalThicknessOfUnit"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use
                                    diggs:GeoUnitObservationType/verticalThicknessOfUnit. The
                                    thickness of the unit, measured vertically.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element maxOccurs="unbounded" minOccurs="0" name="characteristicProperty"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A property characteristic of the unit, with its name and a value or
                                range of values. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                The boundary at the base of the unit. Repeat where the character of
                                the boundary changes across the base surface of the unit.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GeoUnitObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:GeoUnitObservation object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:GeoUnitObservation" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="GeoUnitSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:GeoUnitSystemType">
        <annotation>
            <documentation>
                A system of geotechnical unit observations. Geotechnical units are bodies of earth
                material distinguished by one or more characteristic engineering properties. The
                observations in a system do not overlap.
            </documentation>
        </annotation>
    </element>

    <!-- ================================================================================== -->
    <!-- LITHOLOGY OBSERVATION SYSTEM ELEMENTS                                              -->
    <!-- ================================================================================== -->

    <complexType name="GeoUnitSystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="geoUnitType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                A type or class designation for the units of the system. Use the
                                DIGGS dictionary gp_properties.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="geoUnitObservation" type="diggs:GeoUnitObservationPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A geotechnical unit observation of the system. Repeat for each unit.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Lithology" type="diggs:LithologyType">
        <annotation>
            <documentation>
                The description of a rock or soil on the basis of characteristics such as color,
                mineralogic composition and grain size, both as text and as controlled terms that
                allow machine parsing.
            </documentation>
        </annotation>
    </element>
    <simpleType name="LithologyCharacterEnumType">
        <restriction base="string">
            <enumeration value="disseminated">
                <annotation>
                    <documentation>
                        The lithology is uniformly distributed as a component that serves to
                        classify the primary lithology, such as sand within a sandy clay.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="interbedded">
                <annotation>
                    <documentation>
                        The lithology is interbedded within the primary lithology.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="inclusions">
                <annotation>
                    <documentation>
                        The lithology is contained in discrete masses within the primary lithology.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LithologyCharacterEnumExtType">
        <union memberTypes="diggs:LithologyCharacterEnumType diggs:OtherNameType"/>
    </simpleType>
    <element name="LithologyObservation" type="diggs:LithologyObservationType"
        substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                An observation of lithology over a geometric extent, such as an interval of a
                borehole, a polygon on a map or cross-section, or a volume. It holds the primary and
                component lithologies, ancillary observations within the extent (placedObservation)
                and the conditions marking the basal boundary of the lithology.
            </documentation>
        </annotation>
    </element>
    <complexType name="LithologyObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LithologyObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:LithologyObservation"/>
        </sequence>
    </complexType>
    <complexType name="LithologyObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element minOccurs="0" name="lithologyClassificationType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The classification system that applies to this observation. Use it
                                to override the default of the enclosing diggs:LithologySystem for
                                this interval, or, where the system declares more than one default,
                                to say which of them applies. Omit it and the observation takes the
                                default of the system. A typical case is a soil column classified
                                visually throughout (ASTM D2488) in which a few sampled intervals
                                are classified from laboratory tests (ASTM D2487). It may also
                                record that no soil classification system applies, for material that
                                is not soil or not naturally deposited. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="primaryLithology" type="diggs:LithologyPropertyType">
                        <annotation>
                            <documentation>
                                The lithology that makes up the principal portion of the observed
                                zone or sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="componentLithology"
                        type="diggs:ComponentLithologyPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A lithology that makes up a subsidiary portion of the observed zone
                                or sample. Use it where the lithology is distinct from the primary
                                lithology, for example interbedded or occurring in inclusions or in
                                part of the zone, and in soil descriptions where components such as
                                sand, gravel and fines are recorded in detail (silty sand with
                                gravel) and a constituent is not sufficient. Repeat for each
                                component.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="facies" type="string">
                        <annotation>
                            <documentation>
                                The conditions of sedimentation that reflect a particular process or
                                depositional environment, for unconsolidated soils or sedimentary
                                rocks, for example alluvium, dune sand, river terrace deposits or
                                hemipelagic sediment; for metamorphic rocks, a set of mineral
                                assemblages formed under similar pressures and temperatures, for
                                example zeolite facies or blueschist facies. Facies terms imply no
                                order in a stratigraphic column; report informal units that occur in
                                stratigraphic order in a diggs:StratigraphySystem.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitName" type="string">
                        <annotation>
                            <documentation>
                                A formal or informal name for the geologic or geotechnical unit this
                                observation belongs to, for example "Unit A", "Merrit Sand" or "Bay
                                Mud". Use it where no diggs:StratigraphySystem or
                                diggs:GeoUnitSystem names the unit.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary" maxOccurs="unbounded"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LithologyPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Lithology object inline, or refers to one with
                xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Lithology"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="LithologySystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:LithologySystemType">
        <annotation>
            <documentation>
                A system of lithology observations.
            </documentation>
        </annotation>
    </element>
    <complexType name="LithologySystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="lithologyClassificationType" type="gml:CodeType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The classification system or systems used to define the lithology
                                classification codes (for example USCS) in this system. They are the
                                default for the system: an observation that states nothing is
                                classified under them. A diggs:LithologyObservation may carry its
                                own lithologyClassificationType, which overrides the default for
                                that interval or, where more than one default is declared, says
                                which applies. Omit it where classification varies interval by
                                interval and every observation states its own. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="lithologyObservation"
                        type="diggs:LithologyObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A lithology observation of the system. Repeat for each observation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LithologyType" mixed="false">
        <complexContent>
            <extension base="diggs:ComponentObjectNoDescriptionType">
                <sequence>
                    <choice>
                        <sequence>
                            <element name="classificationCode" type="diggs:DescriptorCodeType"
                                minOccurs="1" maxOccurs="1">
                                <annotation>
                                    <documentation>
                                        The lithology as a controlled term (a classification code or
                                        controlled name) rather than a descriptive one. For USCS
                                        (ASTM D2487, D2488) it is the group name with its modifiers,
                                        for example "Silty sand" or "Gravelly silt with sand"; where
                                        only the group symbol is reported, use the unmodified group
                                        name for the symbol. For AASHTO it is the group or subgroup
                                        (for example "A-3", "A-2-6"); for USDA, Shepard or Folk
                                        textural classifications, the full-text class (for example
                                        "sandy loam", "sand-silt-clay", "muddy Sand"); for the
                                        British Soil Classification System, the recommended name
                                        (for example "CLAY of very high plasticity") or the group
                                        symbol if no standard name is given; for rock, the rock
                                        name, for example from the American Geosciences Institute
                                        glossary ("Dolostone", "Basalt"). Either classificationCode
                                        or lithDescription must be present. The codeSpace attribute
                                        is the URL of a GML dictionary that defines the terms of the
                                        classification system, and the value equals the gml:name of
                                        the matching diggs:Definition, for example the entry SWg of
                                        astmD2488.xml with the value "Well-graded sand with gravel".
                                        A system without an online dictionary may be used with a
                                        codeSpace that is a URL to an online resource describing it,
                                        but interoperability is limited and a dictionary should be
                                        developed. Use the DIGGS dictionary for the classification
                                        system applied: USCSSoilComponents.xml, aashtoM145.xml,
                                        astm2488Brdr.xml, astmD2487.xml, astmD2488.xml,
                                        astmD5715.xml or usda.xml.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>
                                        Descriptive information about the lithology, including
                                        color, facies, grain size distribution, constituents and
                                        field properties, even where these are also encoded (for
                                        example: well-graded sand (SW), fine-grained, dark grey,
                                        massive, dry, hard). Give it with classificationCode; it is
                                        preferred that both are present.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element minOccurs="1" name="lithDescription"
                                type="diggs:DescriptorType">
                                <annotation>
                                    <documentation>
                                        Descriptive information about the lithology, including
                                        color, facies, grain size distribution, constituents and
                                        field properties, even where these are also encoded (for
                                        example: well-graded sand (SW), fine-grained, dark grey,
                                        massive, dry, hard). Required when the lithology has no
                                        controlled term in classificationCode.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="classificationSymbol" maxOccurs="1"
                        type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The group symbol (USCS) or the group or appropriate subgroup
                                classification (AASHTO and BSCS) of a soil classification. Symbols
                                of non-standard or proprietary classifications may also be reported.
                                The codeSpace attribute is mandatory: preferably a link to the DIGGS
                                dictionary, or USCS, AASHTO or BSCS for those systems, or an
                                authority code for a non-standard system. Use the DIGGS dictionary
                                for the classification system applied: grp-aashtoM145.xml,
                                grp-astmD2487.xml, grp-astmD2488.xml or grp-astmD2488Brdr.xml.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groupIndexAASHTO" type="positiveInteger">
                        <annotation>
                            <documentation>
                                For soils classified by the AASHTO system, the group index GI =
                                (F-35)[0.2+0.005(LL-40)]+(F-15)(PI-10), where F is the percentage
                                passing the 75 micrometer sieve as a whole number, LL is the liquid
                                limit and PI is the plasticity index.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="legendCode" type="diggs:LegendCodeType">
                        <annotation>
                            <documentation>
                                A value that defines a graphic pattern used to symbolize the
                                lithology on a borehole log or map. The codeSpace attribute can
                                associate it with an authority or dictionary, and the xlink:href and
                                mimeType attributes can point to a graphic file containing the
                                pattern.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="matrixType" type="diggs:MatrixEnumType">
                        <annotation>
                            <documentation>
                                The engineering character of the lithology matrix: soil, rock or
                                solid organic matter. It can usually be inferred from
                                classificationCode and is included to ease ingestion into systems
                                that store soil and rock properties separately. Values come from the
                                enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="colorCharacter"
                        type="diggs:ColorCharacterEnumExtType">
                        <annotation>
                            <documentation>
                                The character of the color property, or collection of color
                                properties. Values come from the enumerated list, or "Other: xx",
                                where xx is a user-defined term whose meaning differs from every
                                listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="color" type="diggs:ColorPropertyType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                A color whose boundaries match those of the lithology observation.
                                Where significant color changes do not match those boundaries,
                                define a diggs:ColorSystem rather than separate lithology
                                observations; minor color changes within the observation can be
                                given as a description in a diggs:PlacedObservation. Repeat for each
                                color.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constituent" type="diggs:ConstituentPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A material or structure associated with the lithology that is not
                                significant enough to record in a diggs:ConstituentSystem, or whose
                                location within the observation need not be preserved. Constituents
                                are sedimentary or physical structures; lithologic, mineralogic or
                                organic accessories (calcite, gas odor); bioturbation features;
                                diagenetic structures; physical structures produced by sampling;
                                fossils; trace fossils; and fractures. Repeat for each constituent.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lithProperties"
                        type="diggs:LithPropertiesPropertyType">
                        <annotation>
                            <documentation>
                                Further properties of the lithology.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="AbundanceMeasureType">
        <annotation>
            <documentation>
                Type for an abundance as a percentage, between 0 and 100, with an approximator term
                and a basis of weight or volume.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="diggs:Val0-100Type">
                <attribute name="uom" type="diggs:DimensionlessUomEnumType" use="required">
                    <annotation>
                        <documentation>
                            The unit of measure of the value.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="approximator" type="diggs:ApproximatorEnumExtType">
                    <annotation>
                        <documentation>
                            A term that indicates approximation or uncertainty in the reported
                            value. Values come from the enumerated list, or "Other: xx", where xx is
                            a user-defined term whose meaning differs from every listed value (not a
                            synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="byVolume" type="boolean">
                    <annotation>
                        <documentation>
                            Whether the percentage is by volume (true) or by weight (false). If the
                            attribute is absent, the percentage is by weight.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="ApproximatorEnumType">
        <restriction base="string">
            <enumeration value="about">
                <annotation>
                    <documentation>
                        The value is close to the stated quantity but may vary slightly above or
                        below it. More informal than "approximately".
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="approximately">
                <annotation>
                    <documentation>
                        The value is very close to the stated quantity, with minimal deviation. More
                        precise than "about" or "roughly".
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="roughly">
                <annotation>
                    <documentation>
                        The value is an estimate with potentially significant variance from the
                        stated quantity. Less precise than "approximately" or "about".
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="at least">
                <annotation>
                    <documentation>
                        A strict minimum threshold: values equal to or greater than the stated
                        quantity are acceptable.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="greater than">
                <annotation>
                    <documentation>
                        The value strictly exceeds the stated quantity. The formal form of "more
                        than".
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="at most">
                <annotation>
                    <documentation>
                        A maximum threshold: values equal to or less than the stated quantity are
                        acceptable.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="less than">
                <annotation>
                    <documentation>
                        The value is strictly below the stated quantity, excluding the stated value
                        itself. More formal than "under".
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ApproximatorEnumExtType">
        <union memberTypes="diggs:ApproximatorEnumType diggs:OtherNameType"/>
    </simpleType>
    <complexType name="ColorPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Color object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Color"/>
        </sequence>
    </complexType>
    <complexType name="ColorType">
        <complexContent>
            <extension base="diggs:ComponentObjectNoDescriptionType">
                <sequence>
                    <choice>
                        <element minOccurs="1" name="colorCode" type="diggs:DescriptorCodeType">
                            <annotation>
                                <documentation>
                                    The code that defines the color, preferably defined by an
                                    authority named in the codeSpace attribute. Typically a Munsell
                                    color code, for example 10YR 4/3. No DIGGS-authored dictionary
                                    currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element minOccurs="1" name="colorName" type="diggs:DescriptorCodeType"
                                maxOccurs="1">
                                <annotation>
                                    <documentation>
                                        The name of the color, preferably defined by an authority
                                        named in the codeSpace attribute, for example "reddish
                                        brown". No DIGGS-authored dictionary currently exists for
                                        this element.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="colorCode" type="diggs:DescriptorCodeType">
                                <annotation>
                                    <documentation>
                                        The code that defines the color, preferably defined by an
                                        authority named in the codeSpace attribute. Typically a
                                        Munsell color code, for example 10YR 4/3. Given together
                                        with colorName. No DIGGS-authored dictionary currently
                                        exists for this element.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="colorComponents"
                        type="diggs:ColorComponentsPropertyType">
                        <annotation>
                            <documentation>
                                The components of a Munsell color description.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="abundanceCode" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The relative amount of the color present, as a term such as few,
                                    rare or common. The percentage ranges these terms represent
                                    differ between standards bodies, so name the code list in the
                                    codeSpace attribute. For a percentage estimate use
                                    abundancePercent and maxAbundancePercent. Use the DIGGS
                                    dictionary for the classification system applied: abundance.xml
                                    or abundanceUSDA.xml.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element name="abundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The amount of the color present, as a percentage. For a
                                        range such as 30-50%, give the lower estimate here and the
                                        upper in maxAbundancePercent.
                                    </documentation>
                                </annotation>
                            </element>
                            <element name="maxAbundancePercent" type="diggs:AbundanceMeasureType"
                                minOccurs="0">
                                <annotation>
                                    <documentation>
                                        The upper estimate of the percentage of the color present,
                                        where it is given as a range.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="preface" type="string">
                        <annotation>
                            <documentation>
                                A string placed before the color code or name in a description
                                constructed for display, such as "with", "trending towards" or
                                "and". A secondary gray with the preface "with" after a primary
                                brown gives "brown with gray".
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="origin" type="diggs:ColorOriginEnumType">
                    <annotation>
                        <documentation>
                            The location (matrix or mottle) or the source or cause of the color
                            described. Values come from the enumerated list, or "Other: xx", where
                            xx is a user-defined term whose meaning differs from every listed value
                            (not a synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="rank" type="positiveInteger" use="optional">
                    <annotation>
                        <documentation>
                            The relative significance of the color, with 1 the highest. It removes
                            the ambiguity of inferring significance from abundanceCode.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <element name="Color" type="diggs:ColorType">
        <annotation>
            <documentation>
                The color of an earth material.
            </documentation>
        </annotation>
    </element>
    <simpleType name="ColorCharacterEnumExtType">
        <annotation>
            <documentation>
                Type for the character of a color property or collection of color properties: a
                diggs:ColorCharacterEnumType value or a value of the form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:ColorCharacterEnumType diggs:OtherNameType"> </union>
    </simpleType>
    <simpleType name="ColorCharacterEnumType">
        <annotation>
            <documentation>
                The character of a color property or collection of color properties.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="banded">
                <annotation>
                    <documentation>
                        Multiple colors occur in horizontal layers within the unit.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mottled">
                <annotation>
                    <documentation>
                        A pattern of irregular spots, blotches or patches of a color different from
                        the matrix color of the unit.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="multicolored">
                <annotation>
                    <documentation>
                        Multiple colors, with no indication of the pattern or character of the
                        various colors.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="uniform">
                <annotation>
                    <documentation>
                        A single, uniform color.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="variegated">
                <annotation>
                    <documentation>
                        Multiple colors consisting of spots, streaks or blotches.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <complexType name="ColorComponentsPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ColorComponents object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ColorComponents"/>
        </sequence>
    </complexType>
    <element name="ColorComponents" type="diggs:ColorComponentsType">
        <annotation>
            <documentation>
                The components of a Munsell color description: intensity, modifier and hue. They can
                be combined to construct a color name; for example intensity "dark", modifier
                "greenish" and hue "Gray" give "dark greenish Grey", which would correspond to one
                or more Munsell color codes.
            </documentation>
        </annotation>
    </element>
    <complexType name="ColorComponentsType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:intensity"/>
                    <element minOccurs="0" name="modifier" type="diggs:ModifierEnumExtType">
                        <annotation>
                            <documentation>
                                The term that modifies the base hue, for example yellowish, reddish,
                                creamy or olive. It comes second in the color description, or first
                                if intensity is not used. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="hue" type="diggs:HueEnumExtType">
                        <annotation>
                            <documentation>
                                The base hue of the soil or rock color, for example black, tan,
                                buff, gray or red. Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
