    <element name="intensity" type="diggs:IntensityEnumExtType">
        <annotation>
            <documentation>
                The first term in a color description, if used. For soils and rock it is typically a
                value or chroma term, for example pale, dark, brilliant, medium or dusky. Values
                come from the enumerated list, or "Other: xx", where xx is a user-defined term whose
                meaning differs from every listed value (not a synonym of one).
            </documentation>
        </annotation>
    </element>
    <simpleType name="IntensityEnumExtType">
        <union memberTypes="diggs:IntensityEnumType diggs:OtherNameType"/>
    </simpleType>
    <simpleType name="IntensityEnumType">
        <restriction base="string">
            <enumeration value="strong">
                <annotation>
                    <documentation>
                        A strong color, with high chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="very dark">
                <annotation>
                    <documentation>
                        A very dark color.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="very deep">
                <annotation>
                    <documentation>
                        A very deep color, very dark and of high chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="very dusky">
                <annotation>
                    <documentation>
                        A very dusky color, very dark and of low chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="vivid">
                <annotation>
                    <documentation>
                        A vivid color, with very high chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="very light">
                <annotation>
                    <documentation>
                        A very light color.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="very pale">
                <annotation>
                    <documentation>
                        A very pale color, very light and of low chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="dark">
                <annotation>
                    <documentation>
                        A dark color.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="deep">
                <annotation>
                    <documentation>
                        A deep color, dark and of high chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="light">
                <annotation>
                    <documentation>
                        A light color.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="medium dark">
                <annotation>
                    <documentation>
                        A color between medium and dark.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="medium">
                <annotation>
                    <documentation>
                        A color of medium lightness.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="medium light">
                <annotation>
                    <documentation>
                        A color between medium and light.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="mottled">
                <annotation>
                    <documentation>
                        The color is mottled; the pattern is described by the mottle colors.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="dusky">
                <annotation>
                    <documentation>
                        A dusky color, dark and of low chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="pale">
                <annotation>
                    <documentation>
                        A pale color, light and of low chroma.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="brilliant">
                <annotation>
                    <documentation>
                        A brilliant color, light and of high chroma.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <complexType name="LegendCodeType">
        <simpleContent>
            <extension base="string">
                <attribute name="codeSpace" type="anyURI">
                    <annotation>
                        <documentation>
                            A dictionary, thesaurus, classification scheme, authority or pattern for
                            the term, with the same purpose as codeSpace in the GML namespace.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute ref="xlink:href">
                    <annotation>
                        <documentation>
                            A pointer to the graphic file for this legend code. Required if the
                            mimeType attribute is used.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="mimeType" type="diggs:MimeTypeEnumExtType">
                    <annotation>
                        <documentation>
                            The MIME type of the legend graphic file identified by the xlink:href
                            attribute. Values come from the enumerated list, or "Other: xx", where
                            xx is a user-defined term whose meaning differs from every listed value
                            (not a synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="LithProperties" type="diggs:LithPropertiesType">
        <annotation>
            <documentation>
                Soil geotechnical and geologic properties derived solely from visual and manual
                techniques, such as those defined in ASTM D2488.
            </documentation>
        </annotation>
    </element>
    <complexType name="LithPropertiesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LithProperties object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" ref="diggs:LithProperties"/>
        </sequence>
    </complexType>
    <complexType name="LithPropertiesType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <annotation>
                            <documentation>
                                apparentDensity applies to granular soils and consistency to
                                fine-grained soils. Give one or the other for a lithology class, not
                                both.
                            </documentation>
                        </annotation>
                        <element name="apparentDensity" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The relative density of intact coarse-grained soils, for example
                                    very loose, loose, medium dense, dense or very dense. No
                                    DIGGS-authored dictionary currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="consistency" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The consistency of intact fine-grained soils, for example very
                                    soft, soft, firm, hard or very hard. No DIGGS-authored
                                    dictionary currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <choice minOccurs="0">
                        <element name="beddingOrientation" type="string" minOccurs="1">
                            <annotation>
                                <documentation>
                                    The bedding orientation of stratified material, for example
                                    horizontal or inclined. If quantitative strike or dip data are
                                    available, give dipAngle and dipDirection instead.
                                </documentation>
                            </annotation>
                        </element>
                        <choice>
                            <sequence>
                                <element name="dipAngle" type="diggs:DipMeasureType">
                                    <annotation>
                                        <documentation>
                                            The dip of the lithology property, a plane angle
                                            measured positive down from the horizontal.
                                        </documentation>
                                    </annotation>
                                </element>
                                <element minOccurs="0" name="dipDirection"
                                    type="diggs:PlaneAngleMeasureType">
                                    <annotation>
                                        <documentation>
                                            The direction of dip of the lithology property, measured
                                            clockwise from the reference azimuth (typically true
                                            north).
                                        </documentation>
                                    </annotation>
                                </element>
                            </sequence>
                            <element minOccurs="1" name="dipDirection"
                                type="diggs:PlaneAngleMeasureType">
                                <annotation>
                                    <documentation>
                                        The direction of dip of the lithology property, measured
                                        clockwise from the reference azimuth (typically true north).
                                        Required together with dipAngle.
                                    </documentation>
                                </annotation>
                            </element>
                        </choice>
                    </choice>
                    <element name="beddingSpacing" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                For stratified material, the average thickness between beds, as a
                                descriptive term (thick, thin) or a string giving a numeric value
                                (10 cm). No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="cementation" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The degree of cementation of intact coarse-grained soils, for
                                example weak, moderate or strong. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dilatancy" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The dilatancy of fine-grained soils, for example none, slow or
                                rapid. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dryStrength" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The dry strength, for example none, low, medium, high or very high.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="fabric" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The spatial arrangement of grains, for example random, oriented or
                                imbricated. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="moistureCondition" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture condition of the soil, for example dry, moist or wet.
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="odor" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The odor of the material if organic or unusual, for example H2S. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleAngularity" type="gml:CodeType"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall angularity of coarse-grained particles, for example
                                angular, subangular, subrounded or rounded. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleHardness" type="diggs:SizeClassCodeType"
                        maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall hardness of sand and coarser particles by how they react
                                to a hammer blow: crack, fracture or crumble, or hard if no cracking
                                occurs. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleShape" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall shape of (typically) gravel and larger particles, for
                                example flat, elongated, or flat and elongated. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSize" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The overall particle size distribution of sand and coarser material,
                                for example "fine", "fine to coarse" or "medium". No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSizeDistribution"
                        type="diggs:ParticleSizeDistributionPropertyType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                Quantitative particle size information such as mean and maximum
                                grain size, as opposed to the qualitative terms of particleSize.
                                Report the detailed grain size distribution curve as results of a
                                diggs:ParticleSizeTest.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="particleSorting" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The relative sorting of soil particles, for example "well-sorted".
                                No DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plasticity" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative plasticity of fine-grained soil, for example low,
                                medium or high. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="reactionToHCl" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The reaction of the soil to hydrochloric acid, for example none,
                                weak or strong. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockGrainSize" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The overall particle or crystal size distribution of the rock,
                                depending on its origin: terms such as pegmatitic or aphanitic for
                                crystalline igneous or metamorphic rocks, fine sand or cobbles for
                                clastic sedimentary rocks, and "coarse ash" or "lapilli" for
                                pyroclastic igneous rocks. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockHardness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative hardness of rock as governed by its mineralogy, for
                                example "hard". No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockMass" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The structural features that constitute mechanical discontinuities
                                (major geological features) of the rock mass, meaning any in situ
                                rock with its inherent geomechanical discontinuities, for example
                                fissile, blocky or fractured. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockSorting" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The relative sorting of soil or rock particles, for example
                                "well-sorted". No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockSlakingRate" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative rate of slaking of rock, for example "slow". No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockStrength" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative hardness of rock as governed by its compressive
                                strength, for example "strong". No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rockWeathering" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative degree of rock weathering, for example "slightly
                                decomposed" or "Grade III". No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="soilStructure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The structure of intact soil, for example stratified, laminated,
                                fissured, slickensided, blocky, lensed, homogeneous or varved. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="staining" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The source of visible staining of the lithologic unit within the
                                area of observation, for example iron, manganese or hydrocarbons. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceTexture" type="gml:CodeType" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The microscale features on grain surfaces, for example polished,
                                smooth, pitted or striated. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="toughness" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The relative toughness of fine-grained soil when kneaded near the
                                plastic limit, for example low, medium or high. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitRecoveryLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of core recovered for the lithologic interval. Dividing
                                it by the interval thickness gives the unit recovery percentage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitRQD" type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The rock quality designation of the unit: unitRQDLength divided by
                                the total unit thickness.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitRQDLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The total length of intact pieces of rock core equal to or exceeding
                                100 mm (4 in) in length over the lithologic interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherLithProperty" maxOccurs="unbounded"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A property not listed in diggs:LithPropertiesType, as a name and
                                value pair, for example name "Additional Description" with value
                                "with slag". Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="MatrixEnumType">
        <restriction base="string">
            <enumeration value="soil">
                <annotation>
                    <documentation>
                        The matrix is soil.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="rock">
                <annotation>
                    <documentation>
                        The matrix is rock.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="solid organic matter">
                <annotation>
                    <documentation>
                        The matrix is solid organic matter.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="surficial">
                <annotation>
                    <documentation>
                        The matrix is surficial material at the ground surface.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
