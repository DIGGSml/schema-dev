    <element name="ParticleSize" type="diggs:ParticleSizeType">
        <annotation>
            <documentation>
                A particle size: a numeric value, a description, or both.
            </documentation>
        </annotation>
    </element>
    <element name="ParticleSizeDistribution" type="diggs:ParticleSizeDistributionType">
        <annotation>
            <documentation>
                Summary particle size information for a lithology, such as the mean, modal,
                equivalent, minimum and maximum grain size, as text descriptors or numeric values.
            </documentation>
        </annotation>
    </element>
    <complexType name="ParticleSizeDistributionPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ParticleSizeDistribution object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ParticleSizeDistribution"/>
        </sequence>
    </complexType>
    <complexType name="ParticleSizeDistributionType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" name="meanGrainsize"
                        type="diggs:ParticleSizePropertyType">
                        <annotation>
                            <documentation>
                                The mean grain size, as a text descriptor (for example fine sand) or
                                a numeric value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="modalGrainsize"
                        type="diggs:ParticleSizePropertyType">
                        <annotation>
                            <documentation>
                                The modal grain size, as a text descriptor (for example fine sand)
                                or a numeric value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="equivalentDiameter"
                        type="diggs:ParticleSizePropertyType">
                        <annotation>
                            <documentation>
                                The equivalent diameter for the soil, as a text descriptor (for
                                example fine sand) or a numeric value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minimumDiameter"
                        type="diggs:ParticleSizePropertyType">
                        <annotation>
                            <documentation>
                                The minimum diameter of particles in the soil, as a text descriptor
                                (for example fine sand) or a numeric value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maximumDiameter"
                        type="diggs:ParticleSizePropertyType">
                        <annotation>
                            <documentation>
                                The maximum diameter of particles in the soil, as a text descriptor
                                (for example fine sand) or a numeric value.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute name="howDetermined" type="diggs:DescriptorMethodEnumType">
                    <annotation>
                        <documentation>
                            The method by which the observation or measurement was determined.
                            Values come from the enumerated list.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ParticleSizePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ParticleSize object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ParticleSize"/>
        </sequence>
    </complexType>
    <complexType name="ParticleSizeType">
        <complexContent>
            <extension base="diggs:ObjectNoDescriptionType">
                <choice>
                    <annotation>
                        <documentation>
                            Give particleSizeValue, particleSizeDescription or both.
                        </documentation>
                    </annotation>
                    <sequence>
                        <element name="particleSizeValue" type="diggs:ParticleSizeMeasureType"
                            minOccurs="1">
                            <annotation>
                                <documentation>
                                    The particle size as a number, in length units such as
                                    millimeters of diameter, or in phi.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="particleSizeDescription" type="gml:CodeType" minOccurs="0">
                            <annotation>
                                <documentation>
                                    The particle size as a description, for example "very fine
                                    sand". No DIGGS-authored dictionary currently exists for this
                                    element.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <sequence>
                        <element name="particleSizeDescription" type="gml:CodeType" minOccurs="1">
                            <annotation>
                                <documentation>
                                    The particle size as a description, for example "very fine
                                    sand". Required when particleSizeValue is not given. No
                                    DIGGS-authored dictionary currently exists for this element.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SizeClassCodeType">
        <annotation>
            <documentation>
                Type for a code that states a particle size or hardness class, with an optional
                grain size class.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="gml:CodeType">
                <attribute name="sizeClass" type="diggs:SizeClassEnumExtType">
                    <annotation>
                        <documentation>
                            The grain size class. Identify the grain size classification system in
                            the codeSpace attribute. Values come from the enumerated list, or
                            "Other: xx", where xx is a user-defined term whose meaning differs from
                            every listed value (not a synonym of one).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="SizeClassEnumType">
        <restriction base="string">
            <enumeration value="clay">
                <annotation>
                    <documentation>
                        Clay-size particles: Wentworth, particles smaller than 0.0039 mm; ASTM,
                        fines (silt and clay) finer than 0.075 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="xlay">
                <annotation>
                    <appinfo>
                        <diggs:deprecated since="3.1.0" note="Use clay; this value is a misspelling of it."/>
                    </appinfo>
                    <documentation>
                        DEPRECATED. Use clay; this value is a misspelling of it. Clay-size
                        particles: Wentworth, particles smaller than 0.0039 mm; ASTM, fines (silt
                        and clay) finer than 0.075 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="silt">
                <annotation>
                    <documentation>
                        Silt-size particles: Wentworth, particles between 0.0039 and 0.0625 mm;
                        ASTM, fines finer than 0.075 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sand">
                <annotation>
                    <documentation>
                        Sand-size particles: ASTM, particles between 0.075 and 4.75 mm; Wentworth,
                        between 0.0625 and 2 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="gravel">
                <annotation>
                    <documentation>
                        Gravel-size particles: ASTM, particles between 4.75 and 75 mm; Wentworth,
                        particles above 2 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="granule">
                <annotation>
                    <documentation>
                        Granule-size particles: Wentworth, particles between 2 and 4 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="pebble">
                <annotation>
                    <documentation>
                        Pebble-size particles: Wentworth, particles between 4 and 64 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="cobble">
                <annotation>
                    <documentation>
                        Cobble-size particles: ASTM, particles between 75 and 300 mm; Wentworth,
                        between 64 and 256 mm.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="boulder">
                <annotation>
                    <documentation>
                        Boulder-size particles: ASTM, particles above 300 mm; Wentworth, particles
                        above 256 mm.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="SizeClassEnumExtType">
        <union memberTypes="diggs:SizeClassEnumType diggs:OtherNameType"/>
    </simpleType>

    <!-- ================================================================================== -->
    <!-- STRATIGRAPNY OBSERVATION SYSTEM ELEMENTS                                           -->
    <!-- ================================================================================== -->

    <element name="StratigraphyObservation" type="diggs:StratigraphyObservationType"
        substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A description of an ordered body of rock or soil, such as a formation, a
                biostratigraphic unit or an aquifer.
            </documentation>
        </annotation>
    </element>
    <complexType name="StratigraphyObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:StratigraphyObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:StratigraphyObservation"/>
        </sequence>
    </complexType>
    <complexType name="StratigraphyObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element name="stratigraphicUnitName" type="gml:CodeType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The name of the stratigraphic unit assigned to this zone, for
                                example "Harold Formation". It comes from a controlled list based on
                                the subtype of the layer system. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stratigraphicUnitDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the named stratigraphic unit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="unitType" type="diggs:StratUnitExtEnumType">
                        <annotation>
                            <documentation>
                                The type of the unit. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval as defined in the observation's location property
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="StratigraphySystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:StratigraphySystemType">
        <annotation>
            <documentation>
                A system of stratigraphy observations. The observations in a system do not overlap,
                and stratigraphic unit values are unique within the system.
            </documentation>
        </annotation>
    </element>
    <complexType name="StratigraphySystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="stratigraphyType" type="diggs:StratUnitExtEnumType">
                        <annotation>
                            <documentation>
                                The type of the stratigraphic units described in the system. Where a
                                system has different unit definitions (rare), give the dominant type
                                here and use the unitType of each diggs:StratigraphyObservation to
                                say which type applies to it. Values come from the enumerated list,
                                or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element name="stratigraphyObservation"
                        type="diggs:StratigraphyObservationPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A stratigraphy observation of the system. Repeat for each
                                observation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ObservationSystemPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for
                diggs:AbstractObservationSystem inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:AbstractObservationSystem"/>
        </sequence>
    </complexType>
    <simpleType name="StratUnitEnumType">
        <annotation>
            <documentation>
                The types of stratigraphic unit.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="allostratigraphic">
                <annotation>
                    <documentation>
                        A body of sedimentary rock defined and identified only by its bounding
                        discontinuities.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="biostratigraphic">
                <annotation>
                    <documentation>
                        Bodies of rock strata defined or characterized by their contained fossils.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="chemostratigraphic">
                <annotation>
                    <documentation>
                        A body of rock defined by the chemical composition of the sediments, rocks
                        and rock components.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="chemostraitgraphic">
                <annotation>
                    <appinfo>
                        <diggs:deprecated since="3.1.0" note="Use chemostratigraphic; this value is a misspelling of it."/>
                    </appinfo>
                    <documentation>
                        DEPRECATED. Use chemostratigraphic; this value is a misspelling of it. A
                        body of rock defined by the chemical composition of the sediments, rocks and
                        rock components.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="chronostratigraphic">
                <annotation>
                    <documentation>
                        Bodies of rock, layered or unlayered, defined between specified
                        stratigraphic horizons that represent specified intervals of geologic time.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="geophysical">
                <annotation>
                    <documentation>
                        Bodies of rock and soil distinguished by their geophysical properties. The
                        criteria for distinguishing such units vary with the engineering
                        application.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="hydrostratigraphic">
                <annotation>
                    <documentation>
                        A part of a body of rock that forms a distinct hydrologic unit with respect
                        to the flow of ground water, generally characterized by its porosity and
                        permeability.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="hydrostraptigraphic">
                <annotation>
                    <appinfo>
                        <diggs:deprecated since="3.1.0" note="Use hydrostratigraphic; this value is a misspelling of it."/>
                    </appinfo>
                    <documentation>
                        DEPRECATED. Use hydrostratigraphic; this value is a misspelling of it. A
                        part of a body of rock that forms a distinct hydrologic unit with respect to
                        the flow of ground water, generally characterized by its porosity and
                        permeability.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lithodemic">
                <annotation>
                    <documentation>
                        A three-dimensional body composed of one or more intrusive, highly deformed
                        or highly metamorphosed rock types, distinguished and delimited by rock
                        characteristics. Its contacts with other rock units may be sedimentary,
                        extrusive, intrusive or tectonic, or relate to metamorphic grade.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lithostratigraphic">
                <annotation>
                    <documentation>
                        Bodies of rock, bedded or unbedded, defined and characterized by their
                        lithologic properties and their stratigraphic relations.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="magnetostratigraphic">
                <annotation>
                    <documentation>
                        Rock strata unified by similar magnetic characteristics (not only magnetic
                        polarity) that differentiate them from adjacent strata.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="pedostratigraphic">
                <annotation>
                    <documentation>
                        Units defined by the stratigraphic and spatial relationships and
                        implications of surface and buried soils; used to interpret paleosols.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="polarity chronostratigraphic">
                <annotation>
                    <documentation>
                        Units defined by the primary magnetic-polarity record imposed when the rock
                        was deposited or crystallized during a specific interval of geologic time.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="tectonostratigraphic">
                <annotation>
                    <documentation>
                        A body characterized by a consistent tectonostratigraphy and metamorphic
                        evolution, and bounded by tectonic discontinuities.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="StratUnitExtEnumType">
        <annotation>
            <documentation>
                Type for a type of stratigraphic unit: a diggs:StratUnitEnumType value or a value of
                the form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:StratUnitEnumType diggs:OtherNameType"/>
    </simpleType>

    <!-- ================================================================================== -->
    <!-- MATERIAL TEST ELEMENTS                                                             -->
    <!-- ================================================================================== -->

    <element name="MaterialTest" substitutionGroup="diggs:AbstractMeasurement"
        type="diggs:MaterialTestType">
        <annotation>
            <documentation>
                A laboratory test of a material, with its procedure and outcome.
            </documentation>
        </annotation>
    </element>
    <element name="MaterialTestResult" type="diggs:MaterialTestResultType">
        <annotation>
            <documentation>
                The outcome of a material test: the properties measured, the results and the
                locations they relate to.
            </documentation>
        </annotation>
    </element>
    <complexType name="MaterialTestResultType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" ref="diggs:results"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MaterialTestResultPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MaterialTestResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element minOccurs="1" ref="diggs:MaterialTestResult"/>
        </sequence>
    </complexType>
    <complexType name="MaterialTestType">
        <complexContent>
            <extension base="diggs:AbstractMeasurementType">
                <sequence>
                    <element minOccurs="0" name="samplingTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The time the result applies to, in relation to the investigation
                                target. It is often the time a sampling activity or measurement
                                procedure interacted with the real-world feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="resultTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The time the result became available, typically when the procedure
                                was completed. It can differ from samplingTime: for a laboratory
                                measurement on a specimen, samplingTime is when the specimen was
                                retrieved from its host and resultTime is when the laboratory
                                procedure was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="validTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the result is intended to be used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="outcome" type="diggs:MaterialTestResultPropertyType">
                        <annotation>
                            <documentation>
                                The properties measured, the results of the measurement and the
                                locations the results relate to.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="procedure"
                        type="diggs:LaboratoryTestProcedurePropertyType">
                        <annotation>
                            <documentation>
                                The laboratory test procedure followed. Repeat for each procedure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MeasurementWhileDrillingType">
        <complexContent>
            <extension base="diggs:AbstractMeasurementType">
                <sequence>
                    <element name="outcome" type="diggs:MWDResultPropertyType">
                        <annotation>
                            <documentation>
                                The result of the measurement while drilling.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedure" type="diggs:MWDProcedurePropertyType">
                        <annotation>
                            <documentation>
                                The measurement while drilling procedure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- MEASUREMENT WHILE DRILLING ELEMENTS                                                -->
    <!-- ================================================================================== -->

    <element name="MeasurementWhileDrilling" substitutionGroup="diggs:AbstractMeasurement"
        type="diggs:MeasurementWhileDrillingType">
        <annotation>
            <documentation>
                A measurement of drilling parameters made while drilling.
            </documentation>
        </annotation>
    </element>
    <element name="MWDResult" type="diggs:MWDResultType">
        <annotation>
            <documentation>
                The result of a measurement while drilling: values over a time domain at a location.
            </documentation>
        </annotation>
    </element>
    <complexType name="MWDResultType">
        <complexContent>
            <restriction base="gml:AbstractCoverageType">
                <sequence>
                    <choice>
                        <element ref="diggs:location"/>
                        <element ref="diggs:timeDomain"/>
                    </choice>
                    <element ref="diggs:results"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="MWDResultPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MWDResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:MWDResult"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- MONITOR ELEMENTS                                                                   -->
    <!-- ================================================================================== -->

    <element name="Monitor" type="diggs:MonitorType" substitutionGroup="diggs:AbstractMeasurement">
        <annotation>
            <documentation>
                A monitoring activity: estimates of the value of a property of the investigation
                target, measured at a time instant or within a time interval, at a location or
                series of locations, and derived from a test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="MonitorResultPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemporalResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TemporalResult"/>
        </sequence>
    </complexType>
    <complexType name="MonitorType">
        <complexContent>
            <extension base="diggs:AbstractMeasurementType">
                <sequence>
                    <element minOccurs="0" name="samplingTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The time interval the monitor result applies to. Optional, but give
                                it where the timeIntervalList is used in the timeDomain of the
                                monitor outcome.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="monitorLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the monitoring measurement: the detector or sensor
                                location, or the response zone (such as a well screen interval) the
                                measurement applies to. Where the location is a geometry aggregate,
                                the results refer to all locations as a whole. Where a sensor has
                                detectors at several locations, each monitoring the property at its
                                own location, give the results of each detector in a separate
                                diggs:Monitor.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="outcome" type="diggs:MonitorResultPropertyType">
                        <annotation>
                            <documentation>
                                The properties measured, the results of the measurement and the
                                locations the results relate to.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedure" type="diggs:ProcedurePropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The procedure followed. Repeat for each procedure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TemporalResult" substitutionGroup="gml:AbstractCoverage"
        type="diggs:TemporalResultType">
        <annotation>
            <documentation>
                The properties and results of a monitoring activity, over a time domain.
            </documentation>
        </annotation>
    </element>
    <complexType name="TemporalResultType">
        <annotation>
            <documentation>
                Type for results over a time domain: a coverage with a time domain and a result set.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractCoverageType">
                <sequence>
                    <element ref="diggs:timeDomain"/>
                    <element ref="diggs:results"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TEST ELEMENTS                                                                      -->
    <!-- ================================================================================== -->

    <complexType name="MeasurementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for
                diggs:AbstractMeasurement inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:AbstractMeasurement"/>
        </sequence>
    </complexType>
    <element name="Test" type="diggs:TestType" substitutionGroup="diggs:AbstractMeasurement">
        <annotation>
            <documentation>
                A test: estimates of the value of a property of the investigation target, measured
                at a time instant or within a time interval and within a spatial domain, typically
                derived from a test procedure.
            </documentation>
        </annotation>
    </element>
    <element name="TestResult" substitutionGroup="gml:AbstractCoverage" type="diggs:TestResultType">
        <annotation>
            <documentation>
                The results of a test: the locations and the result set.
            </documentation>
        </annotation>
    </element>
    <complexType name="TestResultPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TestResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TestResult"/>
        </sequence>
    </complexType>
    <complexType name="TestResultBaseType">
        <annotation>
            <documentation>
                Base type for the results of a test: a coverage with a location and a result set.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractCoverageType">
                <sequence>
                    <element ref="diggs:location"/>
                    <element ref="diggs:results"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="TestResultType">
        <complexContent>
            <extension base="diggs:TestResultBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:gridMappingFunction"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="gridMappingFunction" substitutionGroup="gml:AbstractObject"
        type="gml:CoverageFunctionType">
        <annotation>
            <documentation>
                The mapping function from the domain to the range for gridded locations. If omitted,
                gml:startPoint is assumed to be the value of gml:low in the gml:Grid geometry,
                gml:sequenceRule is assumed to be linear, and gml:axisOrder is assumed to be "+1
                +2".
            </documentation>
        </annotation>
    </element>
    <complexType name="TestType">
        <complexContent>
            <extension base="diggs:AbstractMeasurementType">
                <sequence>
                    <element minOccurs="0" name="samplingTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The time the result applies to, in relation to the investigation
                                target. It is often the time a sampling activity or measurement
                                procedure interacted with the real-world feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="resultTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The time the result became available, typically when the procedure
                                was completed. It can differ from samplingTime: for a laboratory
                                measurement on a specimen, samplingTime is when the specimen was
                                retrieved from its host and resultTime is when the laboratory
                                procedure was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="validTime"
                        type="diggs:TimeIntervalOrInstantPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the result is intended to be used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="outcome" type="diggs:TestResultPropertyType">
                        <annotation>
                            <documentation>
                                The properties measured, the results of the measurement and the
                                locations the results relate to.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="procedure" type="diggs:ProcedurePropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The procedure followed. Repeat for each procedure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- GROUP ELEMENTS                                                         -->
    <!-- ================================================================================== -->

    <element name="SamplingFeatureGroup" substitutionGroup="diggs:AbstractGroup"
        type="diggs:SamplingFeatureGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0" note="a concrete group substituting diggs:AbstractSamplingFeatureGroup, whose members cite it through diggs:samplingFeatureGroupRef"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a concrete group substituting diggs:AbstractSamplingFeatureGroup,
                whose members cite the group through samplingFeatureGroupRef. A feature that
                references associated sampling features within a group.
            </documentation>
        </annotation>
    </element>
    <complexType name="SamplingFeatureGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0" note="a type deriving from diggs:AbstractSamplingFeatureGroupType"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a type deriving from diggs:AbstractSamplingFeatureGroupType. Type
                for a group of associated sampling features.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" ref="diggs:samplingFeatureRef" minOccurs="1">
                        <annotation>
                            <documentation>
                                A sampling feature that is a member of the group. Repeat for each
                                member.
                            </documentation>
                        </annotation>
                    </element>
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="BoreholeSoundingPair" substitutionGroup="diggs:AbstractSamplingFeatureGroup"
        type="diggs:BoreholeSoundingPairType">
        <annotation>
            <documentation>
                A borehole paired with a sounding (CPT, DMT or otherwise), sited close enough
                together that their logs can be interpreted as one record of a single ground
                profile. The two features stay physically distinct, each with its own location,
                construction record and results, but are interpreted jointly: the sounding supplies
                continuous stratigraphic resolution, and the borehole supplies the samples and index
                tests that calibrate it. The pair records the assumption that the same soil profile
                underlies both. Membership is declared by the members: the borehole and the sounding
                each carry a diggs:samplingFeatureGroupRef that points at this feature, and this
                feature holds no references to them. The pair is expected to have exactly two
                members, which the schema cannot enforce.
            </documentation>
        </annotation>
    </element>
    <complexType name="BoreholeSoundingPairType">
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureGroupType">
                <sequence>
                    <element minOccurs="0" name="separationDistance" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The horizontal distance between the two members, against which the
                                proximity assumption is judged. It is informational: where it
                                disagrees with the distance computed from the member locations, the
                                member geometry prevails. Where the pairing is not justified by
                                proximity (two features paired because they penetrate the same known
                                stratum), omit it and give the reason in remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="GroupPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractGroup
                inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:AbstractGroup" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TEST SCHEDULING ELEMENTS                                                                -->
    <!-- ================================================================================== -->

    <element name="TestingProgram" substitutionGroup="diggs:AbstractProgram"
        type="diggs:TestingProgramType">
        <annotation>
            <documentation>
                A program of testing: the schedules submitted for testing, the planned tests, and
                the measurement and specimen preparation specifications they follow.
            </documentation>
        </annotation>
    </element>
    <complexType name="TestingProgramType">
        <complexContent>
            <extension base="diggs:AbstractProgramType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="testingSchedule"
                        type="diggs:TestingSchedulePropertyType">
                        <annotation>
                            <documentation>
                                A testing schedule of the program. Repeat for each schedule.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="plannedTest"
                        type="diggs:PlannedTestPropertyType">
                        <annotation>
                            <documentation>
                                A planned test of the program. Repeat for each test.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="measurementSpecification"
                        type="diggs:MeasurementSpecificationPropertyType">
                        <annotation>
                            <documentation>
                                A specification of how a measurement is carried out. Repeat for each
                                specification.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="specimenPrepSpecification"
                        type="diggs:SpecimenPrepSpecificationPropertyType">
                        <annotation>
                            <documentation>
                                A specification of how a specimen is prepared. Repeat for each
                                specification.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="TestingSchedulePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TestingSchedule object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TestingSchedule"/>
        </sequence>
    </complexType>
    <element name="TestingSchedule" substitutionGroup="diggs:AbstractProgramDesign"
        type="diggs:TestingScheduleType">
        <annotation>
            <documentation>
                A schedule of tests submitted to a receiving entity, typically a laboratory, for
                analysis.
            </documentation>
        </annotation>
    </element>

    <complexType name="TestingScheduleType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element minOccurs="0" name="submittingEntity"
                        type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>
                                The entity that submits the schedule to the receiving entity
                                (laboratory) for analysis.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="receivingEntity" type="diggs:BusinessAssociatePropertyType">
                        <annotation>
                            <documentation>
                                The entity that takes receipt of the submitted schedule.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="plannedCompletionDate"
                        type="gml:TimeInstantPropertyType">
                        <annotation>
                            <documentation>
                                The date and time by which the complete schedule is planned to be
                                completed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="scheduleProgress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The progress of the schedule, as a series of progress events.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="ProgressEvent" type="diggs:ProgressEventType">
        <annotation>
            <documentation>
                A recorded state of progress of a design, schedule or planned test at a time, with
                the number of features completed.
            </documentation>
        </annotation>
    </element>
    <complexType name="ProgressEventType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element name="timeStamp" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date and time the progress state was recorded.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="progressState" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The state of progress reached. Use the DIGGS dictionary
                                progressState.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="featureCount" type="nonNegativeInteger">
                        <annotation>
                            <documentation>
                                Where the progress involves the creation or disposition of features
                                (sampling features, samples), the number of features completed at
                                this phase of the implementation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType name="ProgressEventArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more diggs:ProgressEvent objects inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:ProgressEvent"/>
        </sequence>
    </complexType>
    <element name="PlannedTest" type="diggs:PlannedTestType">
        <annotation>
            <documentation>
                A test planned under a testing schedule: the samples to test, the measurement
                specification to follow, and the progress of the test.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlannedTestType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element name="testingScheduleRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>
                                The testing schedule the test is planned under.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" ref="diggs:sampleRef">
                        <annotation>
                            <documentation>
                                A sample to be tested. Repeat for each sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="measurementSpecificationRef" type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>
                                The measurement specification the test follows.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenPrepSpecificationRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:SpecimenPrepSpecification</appinfo>
                            <documentation>
                                The specimen preparation specification the test requires. Given by
                                reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testingProgress"
                        type="diggs:ProgressEventArrayPropertyType">
                        <annotation>
                            <documentation>
                                The progress of the test, as a series of progress events.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:measurementRef">
                        <annotation>
                            <documentation>
                                The measurement that carried out the planned test.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PlannedTestPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PlannedTest object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="diggs:PlannedTest"/>
        </sequence>
    </complexType>
    <element name="MeasurementSpecification" type="diggs:MeasurementSpecificationType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                A program specification governing how a measurement is carried out, as distinct from
                what its result must be: the method to follow, the quantities to record and the
                equipment to use. It applies to any kind of measurement, such as an in-situ test, a
                laboratory test or a monitoring campaign. Requirements the measurement must meet,
                such as a minimum number of load increments, a maximum test stress or a hold time,
                are criteria that name this specification through partOfSpecificationRef, and the
                planned measurement cites the specification through programSpecificationRef.
                Criteria on the measured result are performance criteria and are stated separately.
            </documentation>
        </annotation>
    </element>
    <complexType name="MeasurementSpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" name="appliesToMeasurementKind" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of measurement this specification applies to, from the same
                                vocabulary as diggs:DesignMeasurementType/measurementKind. If
                                absent, the specification is not limited to one kind. Use the DIGGS
                                dictionary measurementKind.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="measurementMethod"
                        type="diggs:MeasurementMethodPropertyType">
                        <annotation>
                            <documentation>
                                A method the measurement is required to follow: the standard or
                                procedure document, as a diggs:Specification. Repeat where the
                                measurement follows more than one document.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="recordingParameter"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                A quantity the measurement is required to record, such as a
                                settlement, an applied stress or a water level, as a code from a
                                property dictionary. Repeat for each quantity. Use the DIGGS
                                dictionaries gr_inj_properties.xml or mwd_properties.xml for the
                                list of values. The codeSpace attribute is mandatory.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="requiredEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment the measurement is required to use, such as a calibrated
                                jack, dial gauges of a stated resolution or a reference beam. Repeat
                                for each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MeasurementSpecificationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MeasurementSpecification object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:MeasurementSpecification"/>
        </sequence>
    </complexType>
    <element name="ConstructionActivitySpecification"
        type="diggs:ConstructionActivitySpecificationType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                A program specification governing how a construction activity is carried out, as
                distinct from what the finished feature must be: the method to follow, the equipment
                to use and the telemetry the work must record. Requirements the activity must meet,
                such as a termination or refusal rule, are criteria that name this specification
                through partOfSpecificationRef, and the activity cites the specification through
                programSpecificationRef.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConstructionActivitySpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" name="constructionMethod"
                        type="diggs:ConstructionActivityMethodPropertyType">
                        <annotation>
                            <documentation>
                                A method the activity is required to follow, as a
                                diggs:ConstructionActivityMethod: the standard or procedure, the
                                part of the feature it applies to, and the cutting tool it requires.
                                Repeat for methods over different parts of the feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="recordingParameter"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                A quantity the work is required to record in real time, such as
                                drilling speed, depth, torque or grout pressure, as a code from a
                                property dictionary. Compare the propertyClass of the installation
                                record of the realized activity. Repeat for each quantity. Use the
                                DIGGS dictionaries gr_inj_properties.xml or mwd_properties.xml for
                                the list of values. The codeSpace attribute is mandatory.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="requiredEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                Equipment the activity is required to use, such as a rig with a
                                depth and torque monitor or a pump with a flow meter. Repeat for
                                each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SpecimenPrepSpecification" type="diggs:SpecimenPrepSpecificationType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                A program specification governing the preparation of a specimen from one or more
                samples: trimming, molding, curing or otherwise conditioning sampled material to the
                state a test procedure requires. It corresponds to what test standards (for example
                ASTM D421 and D2217) call sample preparation, but it governs the
                diggs:AbstractSpecimen produced, not the diggs:Sample it is produced from.
            </documentation>
        </annotation>
    </element>
    <complexType name="SpecimenPrepSpecificationType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType"/>
        </complexContent>
    </complexType>
    <complexType name="SpecimenPrepSpecificationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SpecimenPrepSpecification object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:SpecimenPrepSpecification"/>
        </sequence>
    </complexType>
    <simpleType name="CriterionOperatorEnumType">
        <restriction base="string">
            <enumeration value="le">
                <annotation>
                    <documentation>
                        Less than or equal to the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="ge">
                <annotation>
                    <documentation>
                        Greater than or equal to the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="lt">
                <annotation>
                    <documentation>
                        Strictly less than the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="gt">
                <annotation>
                    <documentation>
                        Strictly greater than the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="eq">
                <annotation>
                    <documentation>
                        Equal to the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="ne">
                <annotation>
                    <documentation>
                        Not equal to the limit's value.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="within">
                <annotation>
                    <documentation>
                        Within an inclusive range. Use with a limit that populates parameterMinValue
                        and parameterMaxValue rather than parameterValue - this is the operator that
                        carries a tolerance band such as "0.25 to 0.75 in".
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="StatisticScopeEnumType">
        <restriction base="string">
            <enumeration value="series">
                <annotation>
                    <documentation>
                        The values within one record - for example the largest settlement in one
                        monitoring record, or the slope of one load-test curve.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="evidence">
                <annotation>
                    <documentation>
                        The evidence for one subject - for example the mean of the cylinders taken
                        from one grout batch.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="population">
                <annotation>
                    <documentation>
                        All subjects the criterion governs - for example 95% of the columns in a
                        zone, or a testing frequency across a program.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="PerformanceCriterion" type="diggs:AbstractAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractAcceptanceCriterion">
        <annotation>
            <documentation>
                An acceptance criterion on a measured physical property of the completed work, such
                as a strength, permeability, settlement or modulus, evaluated against what was
                built. The parameterName of limit/AuthorizedParameter identifies the property; its
                mandatory codeSpace should resolve against properties.xml, so that a consumer can
                identify the quantity without interpreting free text. The schema does not enforce
                which dictionary is used. Where the requirement is on a constructional or geometric
                property, use diggs:DesignConformanceCriterion.
            </documentation>
        </annotation>
    </element>

    <element name="DesignConformanceCriterion" type="diggs:AbstractAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractAcceptanceCriterion">
        <annotation>
            <documentation>
                An acceptance criterion on a geometric, constructional or compositional property
                measured against its design intent, such as position, verticality, diameter, length,
                cut-off elevation, binding material content or a water/binding-material ratio. It is
                a tolerance: it asks whether what was built matches what was designed, not whether
                it performs. The parameterName of limit/AuthorizedParameter identifies the design
                property; its mandatory codeSpace should resolve against designProperty.xml. The
                schema does not enforce which dictionary is used. Where the requirement is on a
                measured physical property, use diggs:PerformanceCriterion.
            </documentation>
        </annotation>
    </element>

    <simpleType name="LogicalOperatorEnumType">
        <restriction base="string">
            <enumeration value="and">
                <annotation>
                    <documentation>
                        Every member criterion must be satisfied, for example a drilling refusal
                        rule such as penetration rate below X and torque above Y, which is met only
                        when both hold together.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="or">
                <annotation>
                    <documentation>
                        At least one member criterion must be satisfied, for example a termination
                        rule that stops at design depth or on reaching a specified resistance,
                        whichever occurs first.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="CompositeAcceptanceCriterion" type="diggs:CompositeAcceptanceCriterionType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                A requirement formed by combining two or more separately stated acceptance criteria
                under one logical operator, for example the drilling refusal rule "penetration rate
                below X and torque above Y". Each member is a normally declared criterion with its
                own subject, statistic, operator, limit, basis and evaluated-against references,
                evaluated on its own terms; the composite combines their verdicts and has no
                statistic, basis or base length of its own. A member may have a different kind of
                subject from the composite: a requirement about the act of construction, such as a
                refusal rule, is judged on the construction activity cited through
                constructionActivityRef, while the composite is judged on the feature. A
                construction activity member applies to the feature named by that activity's
                samplingFeatureRef; where several activities act on the feature, the latest by
                activityDateTime counts. The composite substitutes
                diggs:AbstractProgramSpecification, so it is accepted wherever a
                diggs:PerformanceCriterion is.
            </documentation>
        </annotation>
    </element>
    <complexType name="CompositeAcceptanceCriterionType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="1" maxOccurs="1" name="logicalOperator"
                        type="diggs:LogicalOperatorEnumType">
                        <annotation>
                            <documentation>
                                How the member criteria combine. One operator applies across all
                                members; write a mixed expression such as "A and (B or C)" as nested
                                composites, the inner one declared first and cited by the outer
                                through criterionRef. There is no "not": negate a comparison by
                                using the complementary operator on the member criterion. Values
                                come from the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="2" maxOccurs="unbounded" name="criterionRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractProgramSpecification</appinfo>
                            <documentation>
                                A member criterion: a diggs:PerformanceCriterion, a
                                diggs:DesignConformanceCriterion or, where the expression nests,
                                another diggs:CompositeAcceptanceCriterion. A composite has at least
                                two members. A member is cited rather than contained, because a
                                criterion is cited from elsewhere (by a diggs:DesignVerification or
                                a report) and may take part in more than one composite; declare it
                                before the composite that cites it. The target is a criterion, not
                                any other program specification, which the validation chain checks.
                                Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" ref="diggs:partOfSpecificationRef">
                        <annotation>
                            <documentation>
                                The named program specification this composite elaborates, as for
                                the members of diggs:AbstractAcceptanceCriterionType.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AcceptanceEvaluation" type="diggs:AcceptanceEvaluationType"
        substitutionGroup="diggs:AbstractEvaluation">
        <annotation>
            <documentation>
                A set of acceptance checks and the non-conformances raised from them, issued
                together, typically as one QA/QC or acceptance report. It applies to any program
                that states acceptance criteria. A later finding, such as a re-test or a disposition
                decided afterward, is delivered as a further evaluation or as a reissue of this one.
            </documentation>
        </annotation>
    </element>
    <complexType name="AcceptanceEvaluationType">
        <complexContent>
            <extension base="diggs:AbstractEvaluationType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" name="acceptanceCheck"
                        type="diggs:AcceptanceCheckPropertyType">
                        <annotation>
                            <documentation>
                                One verdict against one criterion. Repeat for each check.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="nonConformance"
                        type="diggs:NonConformancePropertyType">
                        <annotation>
                            <documentation>
                                A departure from a requirement found in this evaluation, and what
                                was decided about it. Repeat for each non-conformance.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ClearanceTemporalOrderEnumType">
        <restriction base="string">
            <enumeration value="unordered">
                <annotation>
                    <documentation>
                        The two governing timestamps must be at least minimumElapsedTime apart, in
                        either order: no two of these within that time of each other.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="referenceBeforeSubject">
                <annotation>
                    <documentation>
                        The reference feature (or, where referenceFeatureType is absent, an earlier
                        member of the same subject population) must reach its governing timestamp at
                        least minimumElapsedTime before the subject does: wait that time after the
                        reference completes.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="subjectBeforeReference">
                <annotation>
                    <documentation>
                        The subject must reach its governing timestamp at least minimumElapsedTime
                        before the reference does; the reverse of referenceBeforeSubject.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="ClearanceConstraint" type="diggs:ClearanceConstraintType"
        substitutionGroup="diggs:AbstractProgramSpecification">
        <annotation>
            <documentation>
                A requirement that two activities or features keep a minimum separation distance, a
                minimum elapsed time between them, or both together as a conditional rule:
                "installations within 3 m of each other must be at least 24 h apart". It is generic
                across domains: adjacent columns protecting fresh grout from vibration,
                grout-injection stages avoiding hydraulic fracture of a neighbor still curing, a new
                borehole standing off from a utility, a pile sequenced away from a monitored
                structure. It states a relation between two features, or two members of a
                population, over a length and a duration, which the single operator and limit of a
                criterion cannot combine; it therefore substitutes
                diggs:AbstractProgramSpecification directly. appliesToFeatureType (inherited) names
                the population the constraint governs, the subject; referenceFeatureType names what
                the subject must keep clear of. If referenceFeatureType is absent, every member of
                the subject population clears every other member. If it names a different type, the
                constraint relates the subject population to that other one, typically a
                pre-existing feature the program did not install and cannot date, in which case
                minimumElapsedTime does not apply on that side. minimumSeparation and
                minimumElapsedTime are independently optional. Both present is the conditional case:
                within minimumSeparation, the two governing timestamps must be at least
                minimumElapsedTime apart. minimumSeparation alone is an unconditional exclusion
                zone. minimumElapsedTime alone is an unconditional sequencing gap for every pair the
                scope selects. At least one of the two is expected; the validation chain checks it.
                The object records the rule, not the check: evaluating it means finding, for every
                pair of features the scope selects, the separation between their locations (per
                separationBasis) and the elapsed time between their governing timestamps (per
                elapsedTimeBasis, typically each feature's installing
                diggs:AbstractConstructionActivity/activityDateTime), and comparing each against its
                threshold.
            </documentation>
        </annotation>
    </element>
    <complexType name="ClearanceConstraintType">
        <complexContent>
            <extension base="diggs:AbstractProgramSpecificationType">
                <sequence>
                    <element minOccurs="0" name="referenceFeatureType"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The kind of feature the subject population (the inherited
                                appliesToFeatureType) must keep clear of. If absent, members of the
                                subject population clear each other; if it names a different type,
                                the constraint relates the subject population to that other type.
                                Use the DIGGS dictionary samplingFeatureTypes.xml, the same one
                                appliesToFeatureType uses, for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minimumSeparation" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance threshold. Where minimumElapsedTime is also given, the
                                timing requirement applies only between features closer together
                                than this distance; otherwise this alone is an unconditional
                                exclusion distance.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="separationBasis" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How minimumSeparation is measured between two features: centerline
                                to centerline, edge to edge, nearest point, plan-view distance or
                                slant distance. A feature's location geometry alone does not say
                                which two points the distance is taken between. Use the DIGGS
                                dictionary separationBasis.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minimumElapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration threshold. Where minimumSeparation is also given, it
                                applies only between features closer together than that distance;
                                otherwise this alone is an unconditional minimum interval between
                                any two governing timestamps the scope selects.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="elapsedTimeBasis"
                        type="diggs:ElapsedTimeBasisEnumExtType">
                        <annotation>
                            <documentation>
                                Which pair of timestamps minimumElapsedTime is measured between:
                                completion of one to start of the other, start to start, completion
                                to completion, or start to completion. The four intervals can differ
                                by the full duration of either activity. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="temporalOrder"
                        type="diggs:ClearanceTemporalOrderEnumType">
                        <annotation>
                            <documentation>
                                Whether minimumElapsedTime is symmetric ("unordered") or directional
                                ("referenceBeforeSubject", "subjectBeforeReference"). If omitted,
                                the order is unordered, the common case of two peer installations
                                that need only clear the interval in either order. Values come from
                                the enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constraintRationale" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                Why the constraint exists, such as vibration sensitivity, fresh
                                material curing, hydraulic fracture risk, ground heave or settlement
                                risk, utility strike risk, structural load interaction, personnel
                                safety exclusion, noise restriction or environmental buffer. It does
                                not affect the check itself. Use the DIGGS dictionary
                                constraintRationale.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DesignSamplingFeature" type="diggs:DesignSamplingFeatureType"
        substitutionGroup="diggs:AbstractSamplingFeatureDesign">
        <annotation>
            <documentation>
                A design for a sampling feature that has no specialization of its own, such as a
                transect, a planar sampling feature or a volumetric sampling feature, typically one
                whose conformance is judged mainly by location.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignSamplingFeatureType">
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureDesignType"/>
        </complexContent>
    </complexType>

    <complexType name="GridIndexType">
        <annotation>
            <documentation>
                Type for the index of one node in the index space of a grid: a whitespace-separated
                list of integers, one per grid axis, ordered per the grid's axisLabels, in the same
                form as the gml:low and gml:high bounds of the gml:GridEnvelope the index falls
                within.
            </documentation>
        </annotation>
        <simpleContent>
            <extension base="gml:integerList">
                <attribute name="dimension" type="positiveInteger" default="2">
                    <annotation>
                        <documentation>
                            The number of values in the index, equal to the dimension of the grid it
                            indexes. It is two where omitted; state 3 for an index into a
                            three-dimensional grid.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="GridIndexStepType">
        <simpleContent>
            <extension base="diggs:GridIndexType">
                <attribute name="sequenceNumber" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>
                            The position of this node in the installation order, counting from 1. It
                            is stated on the step, not left to document order, so it survives
                            reserialization and can be compared with the as-built
                            diggs:RIColumnType/installationSequenceNumber. The numbers of one
                            sequence run 1 to n, counted within this design; a
                            diggs:DesignProductionSequence places the design among the program's
                            other work.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <simpleType name="InstallationSequenceRuleEnumType">
        <annotation>
            <documentation>
                The traversal rules admitted for an installation order: Linear and Boustrophedonic,
                the two whose meaning is fully determined by the rule name and axisOrder alone.
                GML's spelling is kept so that an installation order and a coverage traversal use
                the same words. This is a restriction of gml:SequenceRuleEnumeration, which offers
                six names; the others (Cantor-diagonal, Spiral, Morton, Hilbert) need information
                that neither GML nor DIGGS carries. State an arbitrary order as explicit
                gridIndexStep entries.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Linear">
                <annotation>
                    <documentation>
                        Row by row, returning to the same side of the grid to begin each row.
                        axisOrder states which axis counts as a row and the direction taken on every
                        axis.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Boustrophedonic">
                <annotation>
                    <documentation>
                        Serpentine: as Linear, but alternate rows run in the opposite direction, so
                        the traversal never crosses the grid to begin a row. This is the rig path
                        most layouts follow.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <complexType name="InstallationSequenceRuleType">
        <simpleContent>
            <extension base="diggs:InstallationSequenceRuleEnumType">
                <attribute name="axisOrder" type="gml:AxisDirectionList">
                    <annotation>
                        <documentation>
                            Which axis of the grid's index space varies fastest, and the direction
                            along each: a whitespace-separated list of signed, 1-based axis numbers,
                            for example "+1 +2" or "-2 +1". The numbers index the grid's own axes,
                            in the order its axisLabels and offsetVectors declare them, not the axes
                            of the CRS named by srsName. The sign is the direction: + runs from
                            gml:low to gml:high, - from high to low. Position in the list is
                            precedence: the first axis named varies fastest, the last slowest. Each
                            axis of the grid appears exactly once. Where omitted, the axes are taken
                            in their declared order, all ascending ("+1 +2" on a two-dimensional
                            grid).
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="InstallationSequence" type="diggs:InstallationSequenceType">
        <annotation>
            <documentation>
                The order in which the columns of one design are to be installed, stated over the
                index space of the design's plannedPositions grid. It indexes the grid, not a set of
                objects, so an installation order can be given without any planned position object
                existing. State the order in exactly one of two ways: sequenceRule with an optional
                startPoint gives a generated traversal, compact and right for regular layouts; one
                or more gridIndexStep entries, each a grid index with its own sequenceNumber, give
                an explicit order and account for every node of the grid. The order is local to the
                design: numbers run 1 to n over its own nodes. Order between designs (primary,
                secondary and tertiary passes, or one column type first) and out-of-order nodes are
                stated by a diggs:DesignProductionSequence. Minimum spacing to fresh concrete and
                minimum age before adjacent installation are requirements, not an order; use
                diggs:ClearanceConstraint.
            </documentation>
        </annotation>
    </element>
    <complexType name="InstallationSequenceType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <choice>
                    <sequence>
                        <element name="sequenceRule" type="diggs:InstallationSequenceRuleType">
                            <annotation>
                                <documentation>
                                    The traversal that generates the installation order over the
                                    grid: Linear or Boustrophedonic, with axisOrder stating which
                                    axis varies fastest and the direction along each. The rule names
                                    are restricted to these two; state any other order with
                                    gridIndexStep.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="startPoint" type="diggs:GridIndexType">
                            <annotation>
                                <documentation>
                                    The grid node the sequence begins at. If omitted, it is the
                                    gml:low of the grid, its lowest-indexed corner, as
                                    gml:GridFunction also defaults. Meaningful only with
                                    sequenceRule.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <element name="gridIndexStep" type="diggs:GridIndexStepType" minOccurs="1"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                One explicitly ordered node, the alternative to a generated
                                traversal. The content is the grid index of the node, a
                                diggs:GridIndexType like diggs:realizesGridIndex and
                                plannedGridIndex, and the sequenceNumber attribute states its
                                position in the order. The entries account for every node of the
                                design's plannedPositions grid, each node once, with the sequence
                                numbers running 1 to n; the schema does not enforce either. Use it
                                for an order no rule generates, such as (1,1) then (10,2) then
                                (1,2).
                            </documentation>
                        </annotation>
                    </element>
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="InstallationSequencePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:InstallationSequence object inline, or refers
                to one with xlink:href. Refer to a sequence by xlink:href so that sibling designs
                forming successive passes over the same layout can cite one sequence rather than
                restate it.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:InstallationSequence"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <element name="PlannedPositions" type="diggs:PlannedPositionsType">
        <annotation>
            <documentation>
                The planned layout of a population of sampling features, either as an exact, indexed
                grid or as a general pattern with no grid geometry defined.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlannedPositionsType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <choice>
                    <sequence>
                        <choice>
                            <element ref="diggs:RectifiedGrid">
                                <annotation>
                                    <documentation>
                                        A regular lattice defined by an origin and offset vectors.
                                        The offset vectors need not be orthogonal, so a triangular
                                        or staggered layout is a rectified grid.
                                    </documentation>
                                </annotation>
                            </element>
                            <element ref="diggs:ReferenceableGridByArray">
                                <annotation>
                                    <documentation>
                                        An irregular layout, with positions given explicitly against
                                        a declared index space.
                                    </documentation>
                                </annotation>
                            </element>
                        </choice>
                        <element minOccurs="0" name="installationSequence"
                            type="diggs:InstallationSequencePropertyType">
                            <annotation>
                                <documentation>
                                    The order in which the features at the grid nodes of this layout
                                    are to be installed.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <sequence>
                        <element minOccurs="0" name="gridPattern" type="gml:CodeType">
                            <annotation>
                                <documentation>
                                    The general plan arrangement (square, rectangular, triangular,
                                    staggered or irregular), stated without a grid geometry. Use the
                                    DIGGS dictionary gridPattern.xml for the list of values.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="spacingX" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The center-to-center spacing along the first axis. State it
                                    alone for a square or triangular pattern; add spacingY only
                                    where the two spacings of a rectangular pattern differ.
                                </documentation>
                            </annotation>
                        </element>
                        <element minOccurs="0" name="spacingY" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The center-to-center spacing along the second axis, for a
                                    rectangular pattern where it differs from spacingX.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                </choice>
            </extension>
        </complexContent>
    </complexType>

    <element name="SFDesignScope" type="diggs:SFDesignScopeType">
        <annotation>
            <documentation>
                Defines which sampling features fulfil a design, at one of three levels of
                generality: a zone with a count but no individual positions, a set of planned
                positions (a grid, or a general pattern with no grid), or a single target location.
            </documentation>
        </annotation>
    </element>
    <complexType name="SFDesignScopeType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <choice>
                    <sequence>
                        <element minOccurs="0" name="featureCount" type="nonNegativeInteger">
                            <annotation>
                                <documentation>
                                    The total number of features the design applies to within the
                                    zone, for example 20 boreholes to be drilled somewhere in the
                                    zone. Individual positions are not stated at this level, so an
                                    installation sequence cannot be defined.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="zone" type="diggs:PlanarSurfaceOrMultiSurfacePropertyType">
                            <annotation>
                                <documentation>
                                    The area the design applies to. A feature fulfils the design if
                                    its reference point lies within the zone.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <sequence>
                        <element ref="diggs:plannedPositions">
                            <annotation>
                                <documentation>
                                    The planned layout of the features this design applies to.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="zone" minOccurs="0"
                            type="diggs:PlanarSurfaceOrMultiSurfacePropertyType">
                            <annotation>
                                <documentation>
                                    Where present, restricts the grid nodes of plannedPositions to
                                    those that also fall within this zone.
                                </documentation>
                            </annotation>
                        </element>
                    </sequence>
                    <element ref="diggs:targetPosition">
                        <annotation>
                            <documentation>
                                Scopes the design to the planned location and geometry of a single
                                feature.
                            </documentation>
                        </annotation>
                    </element>
                </choice>
            </extension>
        </complexContent>
    </complexType>

    <element name="targetPosition" type="diggs:TargetPositionPropertyType">
        <annotation>
            <documentation>
                The planned position of a single feature, wrapped as a property.
            </documentation>
        </annotation>
    </element>
    <element name="TargetPosition" type="diggs:TargetPositionType">
        <annotation>
            <documentation>
                The planned location and geometry of a single feature.
            </documentation>
        </annotation>
    </element>
    <complexType name="TargetPositionType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element name="targetLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The planned location or extent of the feature. Every DIGGS geometry
                                is admitted; use a diggs:PointLocation for a point feature (a
                                borehole, a pile), a curve for a linear transect, a surface or
                                multisurface for a planar feature (a load transfer platform) and a
                                volume for a three-dimensional extent.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DesignProductionSequence" type="diggs:DesignProductionSequenceType"
        substitutionGroup="diggs:AbstractProgramDesign">
        <annotation>
            <documentation>
                The order in which the work of a whole program is to be carried out across all of
                its designs: columns installed, boreholes drilled, samples taken, measurements made.
                One object holds one order, so whether one feature is produced after a second and
                before a third is answered from a single series of numbers, wherever the three are
                designed. Declare it in the program's design slot, after the designs it orders. A
                diggs:ClearanceConstraint on the program (a minimum spacing to fresh work, a minimum
                age before adjacent work) attaches through programSpecificationRef.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignProductionSequenceType">
        <complexContent>
            <extension base="diggs:AbstractProgramDesignType">
                <sequence>
                    <element name="step" type="diggs:ProductionSequenceStepType" minOccurs="1"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                One placement in the order. The xlink:href names what is placed, the
                                element content, where present, is the grid index of one node, and
                                the sequenceNumber is the position in the order. Placing a design
                                that states a plannedPositions grid requires the content, the node
                                placed. Placing a diggs:TargetPosition takes empty content. Placing
                                a design whose plannedPositions carry an InstallationSequence, with
                                empty content, places the whole design as a block: sequenceNumber is
                                the start of the block, and the design's own order of 1 to n
                                occupies sequenceNumber to sequenceNumber + n - 1. Placing any other
                                design with empty content places the whole design at sequenceNumber,
                                its features unordered among themselves. A design is placed either
                                as a block or whole, or node by node, not both. Steps that share a
                                number, or whose blocks overlap, are unordered with respect to each
                                other. Repeat for each placement.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ProductionSequenceStepType">
        <simpleContent>
            <extension base="diggs:GridIndexType">
                <attribute ref="xlink:href" use="required">
                    <annotation>
                        <documentation>
                            The design or diggs:TargetPosition this step places, as a reference to
                            its gml:id.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="sequenceNumber" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>
                            The position of what the step places in the program-wide order, counting
                            from 1; it is comparable with the as-built
                            diggs:RIColumnType/installationSequenceNumber. Where the step places a
                            design that carries its own InstallationSequence as a block, the number
                            at which that design's own order starts.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <element name="plannedPositions" type="diggs:PlannedPositionsPropertyType">
        <annotation>
            <documentation>
                The layout for a set of planned sampling features: a grid with an index space, or a
                general pattern with no grid defined.
            </documentation>
        </annotation>
    </element>

    <element name="ProgramDesignReference" type="diggs:ProgramDesignReferenceType">
        <annotation>
            <documentation>
                A reference from a realized feature to a program design that governs it, qualified
                by the kind of governing relationship and when it took effect. Use a bare
                programDesignRef where a feature has exactly one governing design in its original,
                as-built role; use this object where more than one design governs it, or where a
                later design supersedes an earlier one.
            </documentation>
        </annotation>
    </element>
    <complexType name="ProgramDesignReferenceType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:programDesignRef"/>
                    <element minOccurs="0" name="designRole" type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The kind of governing relationship: the design the feature was
                                originally built to, a later design under which it was repaired or
                                strengthened, a design that adopted it unchanged, or one that no
                                longer governs. Absent means built to this design. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="effectiveFrom" type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                When the governing relationship took effect. It orders multiple
                                references where more than one applies. A superseded relationship is
                                stated by the successor's own effectiveFrom together with a
                                designRole marking the earlier one superseded, not by a separate end
                                date.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="DesignBorehole" type="diggs:DesignBoreholeType"
        substitutionGroup="diggs:AbstractSamplingFeatureDesign">
        <annotation>
            <documentation>
                A design for a planned borehole: its diameter, depth and inclination.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignBoreholeType">
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureDesignType">
                <sequence>
                    <element minOccurs="0" name="designDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The nominal designed diameter, from the bit diameter intended for
                                use. For a stepped borehole, the maximum intended diameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="designMinDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                For a stepped borehole, the minimum intended diameter.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="designDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The designed total measured depth, from the top of the centerline.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="designPlunge" type="diggs:PlungeMeasureType">
                        <annotation>
                            <documentation>
                                The design plunge angle, measured from the horizontal, positive up.
                                Where absent, vertical (-90 degrees) is assumed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="designBearing" type="diggs:BearingMeasureType">
                        <annotation>
                            <documentation>
                                Where the design borehole is inclined, the direction of plunge.
                                Meaningless without designPlunge; where designPlunge is stated and
                                this is absent, the direction is unconstrained.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="casingDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the casing planned for the borehole.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfillDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the backfill planned for the borehole.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="DesignInstallation" type="diggs:DesignInstallationType"
        substitutionGroup="diggs:AbstractSamplingFeatureDesign">
        <annotation>
            <documentation>
                A design for a planned installation, such as a well, a pile or a rigid inclusion:
                any member of diggs:AbstractLinearInstallation or diggs:AbstractPlanarInstallation.
                The inherited samplingFeatureType states which kind of installation is planned.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignInstallationType">
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureDesignType"/>
        </complexContent>
    </complexType>

    <element name="DesignSample" type="diggs:DesignSampleType"
        substitutionGroup="diggs:AbstractSamplingDesign">
        <annotation>
            <documentation>
                A design for a sample, or for the activity that produces one. It covers every
                diggs:AbstractSample and, through diggs:DesignGroutMix, a manufactured sample. It
                mirrors diggs:AbstractSamplingActivityType, not diggs:AbstractSampleType: a
                collected sample cannot be designed beyond the activity that creates it, so what is
                plannable is the procedure and intent of that activity.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignSampleType">
        <annotation>
            <documentation>
                Base type for sample designs. It mirrors the plannable content of
                diggs:AbstractSamplingActivityType, procedure and intent, and leaves out the results
                of recovery. Use diggs:DesignSample or a specialization such as
                diggs:DesignGroutMix.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingDesignType">
                <sequence>
                    <element minOccurs="0" name="constructionActivityDesignRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractConstructionActivityDesign</appinfo>
                            <documentation>
                                The design of the construction activity this sample is to be taken
                                during or from, for example cylinder sampling planned against a
                                column installation. It is the planned counterpart of
                                diggs:constructionActivityRef on a realized sampling activity, and
                                cites a design, never a realized activity. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The planned absolute location of the sample, in a real CRS. Use it
                                only where sampleScope does not apply because no source feature is
                                cited, for example a grab sample at a known position. Where the
                                sample is planned relative to a cited sampling feature, state the
                                position through sampleScope/samplingPosition
                                (diggs:RelativeLocation), which carries no CRS. Do not use the two
                                together.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleScope"
                        type="diggs:SampleDesignScopePropertyType">
                        <annotation>
                            <documentation>
                                The population this sample design draws from, and how densely or in
                                what pattern. See diggs:SampleDesignScopeType.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="purpose" type="string">
                        <annotation>
                            <documentation>
                                The purpose of taking the sample, as free text; typically the test
                                or tests intended for the samples. Corresponds to
                                diggs:AbstractSamplingActivityType/purpose.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleMatrix" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The planned material class of the sample, for example soil, rock,
                                grout or water. It corresponds to diggs:SampleType/sampleMatrix on
                                the as-built side. A designer often cannot say whether recovered
                                material will be soil or rock; state the expected or required matrix
                                where known. The dictionary carries coarse classes alongside finer
                                material terms, so a plan can be as specific or as provisional as
                                the design stage allows. Use the DIGGS dictionary sampleMatrix.xml
                                for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplerInsertionMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                For planned sampling of soil or rock, the means by which the sampler
                                is planned to be inserted into the ground, for example pushed or
                                driven. Corresponds to
                                diggs:AbstractSamplingActivityType/samplerInsertionMethod. Use the
                                DIGGS dictionary samplerInsertionMethod.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="samplingMethod"
                        type="diggs:SamplingMethodPropertyType">
                        <annotation>
                            <documentation>
                                The method the sample is planned to be collected by, inline or by
                                reference. Corresponds to
                                diggs:AbstractSamplingActivityType/samplingMethod. Repeat for each
                                method.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mixingTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                For planned aggregate activities that blend samples, such as
                                soil-cement mixtures or a grout mix design via diggs:DesignGroutMix,
                                the planned time to mix the sample together. Corresponds to
                                diggs:AbstractSamplingActivityType/mixingTime.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plannedSampleWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The planned weight of the sample. Corresponds to
                                diggs:SampleType/sampleWeight, so the planned and obtained sizes
                                compare field for field.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plannedSampleMass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The planned mass of the sample. Corresponds to
                                diggs:SampleType/sampleMass; sampling standards often specify a
                                minimum sample size in mass.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plannedSampleVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The planned volume of the sample. Corresponds to
                                diggs:SampleType/sampleVolume. On diggs:DesignGroutMix it overlaps
                                in meaning, not in role, with
                                diggs:DesignGroutMixType/theoreticalYield, the batch volume the mix
                                formula computes to; both may be stated.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plannedSampleDimensions"
                        type="diggs:SampleDimensionsPropertyType">
                        <annotation>
                            <documentation>
                                The planned dimensions of the sample: diameter and length for a core
                                sample (measured in the sampling direction), or height, width and
                                length for a block sample (sides normal to the sampling direction).
                                Corresponds to diggs:SampleType/sampleDimensions.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="PlannedActivityTypeEnumType">
        <restriction base="string">
            <enumeration value="collect">
                <annotation>
                    <documentation>
                        The activity will create samples by collection from a sampling feature.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="aggregate">
                <annotation>
                    <documentation>
                        The activity will create samples by aggregating existing samples; the
                        sampleScope of the diggs:DesignSample cites more than one sourceSampleRef.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="subsample">
                <annotation>
                    <documentation>
                        The activity will create samples by subsampling an existing sample; the
                        sampleScope of the diggs:DesignSample cites exactly one sourceSampleRef.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="test">
                <annotation>
                    <documentation>
                        The activity will produce a test, standard or blank sample that does not
                        relate to any field sample or sampling feature.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>

    <complexType name="MeasurementMethodPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Specification a planned measurement is to
                follow, inline, by reference with xlink:href, or both; the embedded object prevails
                when both are present. The Specification cites a published standard; it is not a
                diggs:MeasurementSpecification, which holds requirements.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:Specification" maxOccurs="1"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>

    <element name="DesignMeasurement" type="diggs:DesignMeasurementType"
        substitutionGroup="diggs:AbstractMeasurementDesign">
        <annotation>
            <documentation>
                A design for a measurement: the planned counterpart of a realized
                diggs:AbstractMeasurement. One type serves every kind of measurement, whether an
                in-situ test, a laboratory test on a sample, a monitoring campaign, a measurement
                taken while drilling or a geophysical survey, because what is plannable (what it is
                done on, where, by what method, how often, how densely, for how long) is common to
                all of them. A realized measurement cites its design through programDesignRef.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignMeasurementType">
        <complexContent>
            <extension base="diggs:AbstractMeasurementDesignType">
                <sequence>
                    <element minOccurs="0" name="measurementKind" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of measurement planned, so a reader knows what is intended
                                before any realized object exists. Optional, and largely redundant
                                with measurementMethod: a planned ASTM D1143 test already announces
                                itself as a static load test. State it where no method is cited, or
                                where the method admits several kinds of measurement. Use the DIGGS
                                dictionary measurementKind.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="samplingFeatureDesignRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeatureDesign</appinfo>
                            <documentation>
                                The design of the sampling feature the measurement is to be
                                performed on or from; the planned counterpart of
                                diggs:samplingFeatureRef. It cites a
                                diggs:AbstractSamplingFeatureDesign or a specialization, never a
                                realized sampling feature. Repeat: one measurement design may govern
                                every feature a population design covers. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="sampleDesignRef"
                        type="diggs:FractionalReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:DesignSample</appinfo>
                            <documentation>
                                The design of the sample the measurement is to be performed on; the
                                planned counterpart of diggs:sampleRef. It cites a
                                diggs:DesignSample or a specialization such as a grout mix design,
                                never a realized sample, and is how a laboratory test or a test on a
                                produced material is planned. Repeat for each sample design. Given
                                by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="constructionActivityDesignRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractConstructionActivityDesign</appinfo>
                            <documentation>
                                The design of the construction activity the measurement accompanies,
                                such as measurement while drilling or the records of an
                                installation; the planned counterpart of
                                diggs:constructionActivityRef. It cites a design, never a realized
                                activity. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementLocation"
                        type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The planned location of the measurement: most often a
                                diggs:LinearExtent for the planned depth or depth interval in the
                                linear referencing system of samplingFeatureDesignRef, a
                                diggs:PointLocation for a single test position or instrument point,
                                or a diggs:MultiPointLocation for several positions served by one
                                provision. A planned measurement has no result coverage to carry its
                                position, so the position is stated here. It complements the
                                testingDensity choice: a density states spacing without committing
                                to positions, this states the positions, and both together are
                                meaningful where a spacing has been resolved into a schedule.
                                Normally omit it where the measurement is on a planned sample, whose
                                own position (diggs:DesignSampleType/samplingLocation or
                                sampleScope/samplingPosition) carries the depth. Omit it also where
                                the measurement applies to the whole of the referenced feature, as
                                an axial load test applies to a whole column; absence means the
                                provision is not positioned, not that its position is unknown.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="measurementMethod"
                        type="diggs:MeasurementMethodPropertyType">
                        <annotation>
                            <documentation>
                                The method the measurement is planned to follow, inline or by
                                reference, so the same method can be shared across many planned
                                measurements. Repeat for each method.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="plannedProcedure"
                        type="diggs:ProcedurePropertyType">
                        <annotation>
                            <documentation>
                                The procedure the measurement is planned to be carried out with, as
                                the same procedure object a realized measurement carries in its
                                procedure property, for example a diggs:PlateLoadTest or a
                                diggs:StaticLoadTest, inline or by reference. It states the planned
                                values of the procedure (plate size, bedding, reference system,
                                maximum stress, planned increments with stress and hold) in the
                                structure the realized procedure uses, so planned and realized
                                values compare field for field. It states intent; a requirement the
                                realized measurement must meet is a criterion. Contrast
                                measurementMethod, which cites the standard to follow. Repeat for
                                each procedure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="readingFrequency"
                        type="diggs:ReciprocalTimeMeasureType">
                        <annotation>
                            <documentation>
                                How often the measurement is planned to be taken: a
                                measurement-while-drilling logging interval, a dynamic testing
                                sampling rate, a load-test hold increment or an instrument read
                                frequency. A daily reading is uom="1/d" with a value of 1. The
                                schema cannot enforce that a reading frequency appears only where it
                                makes sense; use dictionary Occurrence conditions keyed on
                                measurementKind or the validation module's context checks.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="duration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                How long the measurement is planned to run: a monitoring campaign's
                                span, a load-test hold time or the length of a logging window.
                                Corresponds to diggs:TimeIntervalType/duration on the realized side.
                                It is an elapsed span, not a position in time; state a planned date
                                through progress.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>
                                The planned testing density: how densely the measurement is taken
                                across a population or an area, stated as a spatial or count-based
                                density rather than a rate in time, for example one test per
                                footing, one per linear foot of wall or one per unit area of slab.
                                Give exactly one of per length, per area or per discrete element. It
                                is distinct from readingFrequency, which is time-based only, and
                                from testedFraction, which states what share of a population is
                                tested rather than how closely spaced the tests are. Continuous
                                inspection of the whole population is not a density; record it
                                through measurementKind or remark. A measurement with no
                                readingFrequency is understood to be a single planned event.
                            </documentation>
                        </annotation>
                        <element name="testingDensityPerLength"
                            type="diggs:ReciprocalLengthMeasureType">
                            <annotation>
                                <documentation>
                                    The testing density per unit length, for example one test per
                                    linear foot of wall or one inspection per 10 m of trench.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="testingDensityPerArea" type="diggs:ReciprocalAreaMeasureType">
                            <annotation>
                                <documentation>
                                    The testing density per unit area, for example one compaction
                                    test per unit area of slab or platform.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="testingDensityPerElement"
                            type="diggs:DimensionlessMeasureType">
                            <annotation>
                                <documentation>
                                    The testing density per discrete element, for example one test
                                    per footing or one test per N columns. It is a count or ratio
                                    rather than a spatial rate; typical uom values are Euc or %.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="testedFraction"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The proportion of a planned population of elements that is to be
                                tested, where a testing provision is scoped to a population rather
                                than to named elements, for example "5 percent of production rigid
                                inclusions". Typically uom="%". It answers how many, not how often:
                                it is distinct from readingFrequency and from the testingDensity
                                choice. samplingFeatureDesignRef names which features a provision
                                governs; this element states what share of that population is
                                tested, and both are normally needed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testLoadPercentDesignLoad"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The maximum load a planned load test is to reach, as a percentage of
                                the design working load of the element tested. Typically uom="%". It
                                is a ratio because test requirements are written that way and the
                                absolute value differs per element, which lets one population-scoped
                                provision govern a zone. Where the tested element is not the element
                                the design load acts on, such as a column loaded through a plate in
                                a test of a platform design pressure, state the planned maximum
                                stress on the planned procedure instead. It carries the value only;
                                state any derivation in a remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="DesignConstructionActivity" type="diggs:DesignConstructionActivityType"
        substitutionGroup="diggs:AbstractConstructionActivityDesign">
        <annotation>
            <documentation>
                A design for a construction activity with no specialization of its own: the planned
                counterpart of a realized diggs:AbstractConstructionActivity. Where a sampling
                feature design plans "a column here", this plans how it is to be built: the method
                to follow, the equipment to use and the planned features the work acts on.
                Requirements the work must meet, such as a termination or refusal criterion, are
                cited through the inherited programSpecificationRef.
            </documentation>
        </annotation>
    </element>
    <complexType name="DesignConstructionActivityType">
        <complexContent>
            <extension base="diggs:AbstractConstructionActivityDesignType">
                <sequence>
                    <element minOccurs="0" maxOccurs="unbounded" name="samplingFeatureDesignRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:AbstractSamplingFeatureDesign</appinfo>
                            <documentation>
                                The design of a feature the activity is to construct or act on; the
                                planned counterpart of diggs:samplingFeatureRef on the realized
                                activity. It cites a design, never a realized feature. Repeat: one
                                activity design may govern every feature a population design covers.
                                Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="constructionMethod"
                        type="diggs:ConstructionActivityMethodPropertyType">
                        <annotation>
                            <documentation>
                                The method the activity is planned to follow, as a
                                diggs:ConstructionActivityMethod, the same object the realized
                                activity uses, so a plan can state a method for part of the work as
                                well as for the whole. Repeat for each method.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- EQUIPMENT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->
    <!-- ================================================================================== -->
    <!-- CORING DEVICE ELEMENTS                                                              -->
    <!-- ================================================================================== -->

    <element name="CoringDevice" type="diggs:CoringDeviceType"
        substitutionGroup="diggs:AbstractEquipment" abstract="false">
        <annotation>
            <documentation>
                A borehole coring device.
            </documentation>
        </annotation>
    </element>
    <complexType name="CoringDeviceType">
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="areaRatio" type="diggs:AreaPerAreaMeasureType">
                        <annotation>
                            <documentation>
                                A sample disturbance parameter: the difference of the squares of the
                                outside and inside diameter of the cutting shoe, divided by the
                                square of the inside diameter of the cutting shoe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelExtension" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance the coring device extends beyond the drill bit at full
                                extension. Negative values indicate the barrel is recessed behind
                                the bit.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The inside diameter of the core barrel or sampling tube.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The outside diameter of the core barrel or sampling tube.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="barrelLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the core barrel or sampling tube.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="insideClearanceRatio"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                A sample disturbance parameter: the inside sample diameter minus the
                                cutting shoe inside diameter, divided by the cutting shoe inside
                                diameter, as a percentage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="linerPresent" type="boolean">
                        <annotation>
                            <documentation>
                                True if a liner is present in the barrel.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="linerType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of liner material or coating within the coring device, for
                                example porcelain coating on a Shelby tube. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="outsideClearanceRatio"
                        type="diggs:LengthPerLengthMeasureType">
                        <annotation>
                            <documentation>
                                A sample disturbance parameter: the outside cutting shoe diameter
                                minus the outside sampler diameter, divided by the outside sampler
                                diameter, as a percentage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeInnerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The inner diameter of the cutting shoe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the core shoe, the device that fastens onto the lower
                                end of the main core barrel.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeOuterDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The outer diameter of the cutting shoe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shoeType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of shoe used, typically manufacturer specific. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DETECTOR ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element abstract="false" name="Detector" type="diggs:DetectorType">
        <annotation>
            <documentation>
                A component of a sensor that measures one specific property (the measurand),
                optionally along a single geometric axis.
            </documentation>
        </annotation>
    </element>
    <complexType name="DetectorType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="detectorLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The location that the detector measures, for example the response
                                zone of the detector.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="measurand"
                        type="gml:CodeWithAuthorityType">
                        <annotation>
                            <documentation>
                                The property being measured. The codeSpace attribute is mandatory,
                                and the value should occur within the dictionary it names. Use the
                                DIGGS dictionary measurand.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of detector. No DIGGS-authored dictionary currently exists
                                for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisBearing"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The compass bearing, relative to true north, of the measurement
                                axis, for directional measurements such as a component of an
                                extensometer or an accelerometer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="measurementAxisInclination"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The inclination of the measurement axis, measured positively down
                                from the horizontal, for directional measurements such as an
                                extensometer or an accelerometer.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- DRILL RIG ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="DrillRig" substitutionGroup="diggs:AbstractEquipment" type="diggs:DrillRigType">
        <annotation>
            <documentation>
                A drill rig.
            </documentation>
        </annotation>
    </element>
    <complexType name="DrillRigType">
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="engine" type="string">
                        <annotation>
                            <documentation>
                                A description of the engine that drives the drill rig: its name and
                                other parameters.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="carrierType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of device that carries the rig, for example "rubber tire
                                ATV", "truck mounted" or "track mounted". No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tireSizeFront" type="string">
                        <annotation>
                            <documentation>
                                The size of the front tires of a rubber-tire-mounted rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="tireSizeRear" type="string">
                        <annotation>
                            <documentation>
                                The size of the rear tires of a rubber-tire-mounted rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="groundBearingPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The typical or maximum pressure exerted on the ground by the weight
                                of the rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberForwardGears" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of forward gears in the transmission.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberReverseGears" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of reverse gears in the transmission.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="transferCaseInfo" type="string">
                        <annotation>
                            <documentation>
                                A description of the transfer case capabilities, for example "air
                                shift controls for drill, rear axle (4x2) and front axle (4x4)".
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="axleInfo" type="string">
                        <annotation>
                            <documentation>
                                A description of the axles where applicable, for example "planetary
                                with no-spin differentials, front and rear".
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="winchCapacity"
                        type="diggs:WinchCapacityMeasureType">
                        <annotation>
                            <documentation>
                                The maximum capacity of the winch, expressed as a weight. The
                                winchLocation attribute states where the winch is on the rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterTankCapacity" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The maximum volume of the onboard water tank.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="levelingSystem" type="string">
                        <annotation>
                            <documentation>
                                A description of the system used to level the rig, for example
                                "Three hydraulic jacks, 36 inch (91.4 cm) stroke".
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rotaryDriveMaxTorque"
                        type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The maximum torque produced by the rotary drive system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rotaryDriveMaxSpeed"
                        type="diggs:AngularVelocityMeasureType">
                        <annotation>
                            <documentation>
                                The maximum rotational speed of the rotary drive system.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="rotaryDriveGearRatio"
                        type="diggs:RotaryDriveGearRatioMeasureType">
                        <annotation>
                            <documentation>
                                The ratio between the input rotation speed at the head and the
                                rotation of the bit, for the gear selected. The gearNumber attribute
                                identifies the gear. Repeat for each gear.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pullDownForceMax" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The maximum crowd or pulldown force of the feed system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="feedRateMax" type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The maximum rate at which the rig can feed the drill pipe into the
                                ground.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="retractForceMax" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The maximum retract force of the feed system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="retractRateMax"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The maximum rate at which the rig can retract the drill pipe.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="strokeMax" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The maximum stroke height of the feed system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdSystemType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of system used to apply downward pressure, typically winch
                                or cylinder. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdCylinderArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                For a cylinder crowd system, the cross-sectional area of the crowd
                                cylinder.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baselineCrowdPressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The standard operating pressure for crowd force application on the
                                drill rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crowdConversionCoeff" type="double">
                        <annotation>
                            <documentation>
                                The ratio of crowd force to the pressure applied (force divided by
                                pressure), which converts crowd pressure to force.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="baselineTorquePressure"
                        type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The standard operating pressure for torque application on the drill
                                rig.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="noHydraulicMotors" type="integer">
                        <annotation>
                            <documentation>
                                The number of hydraulic motors used in the drilling setup.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxHydMotorDisplacement"
                        type="diggs:VolumePerRotationMeasureType">
                        <annotation>
                            <documentation>
                                The maximum volume displaced by the hydraulic motor per revolution.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="minHydMotorDisplacement"
                        type="diggs:VolumePerRotationMeasureType">
                        <annotation>
                            <documentation>
                                The minimum volume displaced by the hydraulic motor per revolution.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxHydPressure" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The highest pressure at which the hydraulic system of the drill rig
                                can operate.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="maxTorque" type="diggs:MomentOfForceMeasureType">
                        <annotation>
                            <documentation>
                                The highest rotational force the drill rig can apply.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mastLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The nominal length of the mast, typically measured from the ground
                                to the sheaves.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="RotaryDriveGearRatioMeasureType">
        <simpleContent>
            <extension base="double">
                <attribute name="gearNumber" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>
                            The number of the gear this ratio applies to, for example 1, 2 or 3.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>
    <complexType name="WinchCapacityMeasureType">
        <simpleContent>
            <extension base="diggs:ForceMeasureType">
                <attribute name="winchLocation" type="string">
                    <annotation>
                        <documentation>
                            The location of the winch on the rig, for example front or rear.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </simpleContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- EQUIPMENT ELEMENTS                                                                 -->
    <!-- ================================================================================== -->

    <element name="Equipment" type="diggs:EquipmentType" substitutionGroup="diggs:AbstractEquipment"
        abstract="false">
        <annotation>
            <documentation>
                Generic equipment that carries only the properties of the base type. Use it where a
                more specialized equipment object is not needed or not developed.
            </documentation>
        </annotation>
    </element>
    <complexType name="EquipmentType">
        <complexContent>
            <extension base="diggs:AbstractEquipmentType"/>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SENSOR ELEMENTS                                                                    -->
    <!-- ================================================================================== -->

    <element name="Sensor" type="diggs:SensorType" substitutionGroup="diggs:AbstractSensor"
        abstract="false">
        <annotation>
            <documentation>
                An instrument used to take readings as part of a measurement. A sensor is equipment,
                and may be assigned a location by a coordinate or by a text description. It can also
                have one or more detectors, each with its own location, a measurand and a
                measurement axis orientation.
            </documentation>
        </annotation>
    </element>
    <element name="sensorRef" type="diggs:FeatureReferenceType">
        <annotation>
            <documentation>
                A reference to a sensor associated with this feature. Given by reference only.
            </documentation>
        </annotation>
    </element>
    <complexType name="SensorType">
        <complexContent>
            <extension base="diggs:AbstractSensorType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- TRIAXIAL TEST EQUIPMENT ELEMENTS                                                   -->
    <!-- ================================================================================== -->

    <element abstract="false" name="TriaxialTestEquipment"
        substitutionGroup="diggs:AbstractEquipment" type="diggs:TriaxialTestEquipmentType">
        <annotation>
            <documentation>
                The parameters of the equipment used in a triaxial test procedure.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriaxialTestEquipmentType">
        <complexContent>
            <extension base="diggs:AbstractEquipmentType">
                <sequence>
                    <element minOccurs="0" name="loadCellCapacity" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The capacity of the load cell.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="massOfTopPorousStone" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the top porous stone.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="massOfTopCap" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the top cap.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the loading piston.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="poreWaterPressureDeviceMeetsUndrainedSpecs"
                        type="boolean">
                        <annotation>
                            <documentation>
                                For undrained tests, true if the pore water pressure measurement
                                system satisfies the requirement that the volume change due to a
                                pore pressure change, divided by the total specimen volume and by
                                the change in pore pressure, is less than 3.2 x 10-6 m2/kN (2.2 x
                                10-5 in2/lb) (ASTM D4767-11, Sec. 5.8).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureTransducerType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of pressure transducer, for example a single pressure
                                transducer or an effective stress transducer. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================== -->
    <!-- SPECIMEN ELEMENTS                                                                  -->
    <!-- ================================================================================== -->

    <element name="SoilSpecimen" type="diggs:SoilSpecimenType"
        substitutionGroup="diggs:AbstractSpecimen">
        <annotation>
            <documentation>
                A specimen that describes the physical conditions of a soil sample, or samples,
                subjected to testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="SoilSpecimenType">
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="conditionPreTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen before the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionIntermediate"
                        type="diggs:SpecimenConditionsPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen at an intermediate stage
                                during the test. Repeat for each stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionPostTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen after the test. For triaxial
                                tests, it reports the specimen conditions following the
                                consolidation stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="intactSpecimenPreparationInfo"
                        type="diggs:IntactSpecimenPreparationInfoPropertyType">
                        <annotation>
                            <documentation>
                                Information on the preparation of an intact specimen, such as
                                whether and how it was trimmed for testing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="reconstitutedSpecimenPreparationInfo"
                        type="diggs:ReconstitutedSpecimenPreparationInfoPropertyType">
                        <annotation>
                            <documentation>
                                Information on the preparation of a reconstituted specimen, such as
                                the number of lifts and the compactor type.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sizeFraction" type="diggs:SizeFractionPropertyType">
                        <annotation>
                            <documentation>
                                The size fraction from which the test portion was obtained.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specificGravityOfSolids"
                        type="diggs:SpecificGravityMeasureType">
                        <annotation>
                            <documentation>
                                The specific gravity of the soil solids (Gs): the ratio of the
                                density of the solids to the density of a reference substance,
                                usually water at 4 degrees C.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="specimenType" type="diggs:SpecimenTypeType">
                        <annotation>
                            <documentation>
                                The structural condition of the soil specimen tested. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="RockSpecimen" type="diggs:RockSpecimenType"
        substitutionGroup="diggs:AbstractSpecimen">
        <annotation>
            <documentation>
                A specimen that describes the physical conditions of a rock sample, or samples,
                subjected to testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="RockSpecimenType">
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="conditionPreTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen before the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionIntermediate"
                        type="diggs:SpecimenConditionsPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen at an intermediate stage
                                during the test. Repeat for each stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="conditionPostTest"
                        type="diggs:SpecimenConditionsPropertyType">
                        <annotation>
                            <documentation>
                                The physical conditions of the specimen after the test. For triaxial
                                tests, it reports the specimen conditions following the
                                consolidation stage.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="ReconstitutedSpecimenPreparationInfo"
        type="diggs:ReconstitutedSpecimenPreparationInfoType">
        <annotation>
            <documentation>
                Information on the preparation of a reconstituted specimen for testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="ReconstitutedSpecimenPreparationInfoPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ReconstitutedSpecimenPreparationInfo object
                inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ReconstitutedSpecimenPreparationInfo"/>
        </sequence>
    </complexType>
    <complexType name="ReconstitutedSpecimenPreparationInfoType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="0" name="compactorType"
                        type="diggs:ReconstitutedSpecimenCompactorType">
                        <annotation>
                            <documentation>
                                The type of compactor used. Values come from the enumerated list, or
                                "Other: xx", where xx is a user-defined term whose meaning differs
                                from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="numberOfLifts" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of layers (lifts) used in reconstituting the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="blowsPerLift" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of rammer blows per lift (layer) used to compact the
                                specimen in the mold.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mouldDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the mold used for reconstituting the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="mouldVolume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The specimen volume within the mold.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="relativeCompaction"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The compaction of the specimen after reconstitution, as a fraction
                                or, most typically, a percentage of the maximum dry density of the
                                sample.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterContentRelativeToOptimum" type="double">
                        <annotation>
                            <documentation>
                                The water content relative to the optimum water content, as a
                                decimal ratio: water content at optimum is 1.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rammerDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the rammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rammerMass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the rammer (hammer) used.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rammerWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the rammer (hammer) used, in force units.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rammerDrop" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The drop height of the rammer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rammerIsManual" type="boolean">
                        <annotation>
                            <documentation>
                                True if the rammer is operated manually, false if it is automatic.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ReconstitutedSpecimenCompactorEnumType">
        <restriction base="string">
            <enumeration value="Drop hammer">
                <annotation>
                    <documentation>
                        A drop hammer.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Harvard miniature">
                <annotation>
                    <documentation>
                        A Harvard miniature compactor.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="Static rod">
                <annotation>
                    <documentation>
                        A static rod.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ReconstitutedSpecimenCompactorType">
        <union memberTypes="diggs:ReconstitutedSpecimenCompactorEnumType diggs:OtherNameType"/>
    </simpleType>

    <element name="SpecimenConditions" type="diggs:SpecimenConditionsType">
        <annotation>
            <documentation>
                The physical conditions of a specimen subjected to testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="SpecimenConditionsType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectType">
                <sequence>
                    <element minOccurs="0" name="dateTime" nillable="false"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The date and, optionally, time or time interval during which this
                                evaluation of the specimen condition was made.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="index" nillable="false" type="positiveInteger">
                        <annotation>
                            <documentation>
                                For intermediate evaluations of specimen condition, the order of the
                                measurement: 1, 2, 3 and so on.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bulkDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The bulk density of the specimen: its density before drying.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bulkUnitWeight"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The bulk unit weight of the specimen: its unit weight before drying.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="crossSectionalArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The cross-sectional area of the specimen. Methods for computing it
                                can be given in the associated test procedure object.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dimensionMeasurementTechnique"
                        type="diggs:DimensionMeasurementTechniqueType">
                        <annotation>
                            <documentation>
                                The technique used to measure the specimen lengths and diameters:
                                calipers, a PI-tape or another technique. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ringDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                If a cylindrical specimen is contained within a ring or mold, the
                                inside diameter of the ring before the specimen was placed.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryUnitWeight"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The dry unit weight of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryDensity"
                        type="diggs:DensityOrUnitWeightMeasureType">
                        <annotation>
                            <documentation>
                                The dry density of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the specimen after drying.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dryMass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the specimen after drying.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element minOccurs="0" name="diameter" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    For cylindrical or spherical specimens, the diameter of the
                                    specimen.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence minOccurs="0">
                            <element minOccurs="0" name="length" type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        One of the cross-sectional, or horizontal, dimensions of the
                                        prepared specimen.
                                    </documentation>
                                </annotation>
                            </element>
                            <element minOccurs="0" name="width" type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The other cross-sectional, or horizontal, dimension of the
                                        prepared specimen.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="height" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The vertical dimension of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="diameterHeightRatio" type="double">
                        <annotation>
                            <documentation>
                                For cylindrical specimens, the specimen diameter divided by the
                                specimen height (D/H), the reciprocal of the length-to-diameter
                                ratio (L/D) used by most compressive strength standards. Where
                                relevant, give it even if the specimen diameter and height are also
                                given, to facilitate processing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="heightDiameterRatio" type="double">
                        <annotation>
                            <documentation>
                                For cylindrical specimens, the specimen height divided by the
                                specimen diameter (H/D, also written L/D), the reciprocal of
                                diameterHeightRatio and the form compressive strength standards use
                                to decide whether a correction to the measured strength applies.
                                Where relevant, give it even if the specimen diameter and height are
                                also given, to facilitate processing.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="percentSaturation"
                        type="diggs:VolumePerVolumeMeasureType">
                        <annotation>
                            <documentation>
                                The degree of saturation of the specimen, as a percentage.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="shape" type="diggs:SpecimenShapeType">
                        <annotation>
                            <documentation>
                                The shape of the specimen tested. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surfaceArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The total surface area of the specimen, computed in a way that
                                depends on the specimen shape.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="temperature"
                        type="diggs:TemperatureMeasurementPropertyType">
                        <annotation>
                            <documentation>
                                The temperature of the specimen, held in a
                                diggs:TemperatureMeasurement with an optional dateTime that
                                identifies the time instant of the measurement. Repeat for each
                                measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="volume" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The volume of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waterContent" type="diggs:WaterContentMeasureType">
                        <annotation>
                            <documentation>
                                The water content of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wetMass" type="diggs:MassMeasureType">
                        <annotation>
                            <documentation>
                                The mass of the specimen before soaking or drying, at this state of
                                the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wetWeight" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the specimen before drying.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="voidRatio" type="double">
                        <annotation>
                            <documentation>
                                The void ratio of the specimen (soils): the volume of voids divided
                                by the volume of solids.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="otherConditionProperty"
                        type="diggs:ParameterPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A condition property not provided elsewhere in
                                diggs:SpecimenConditionsType. Repeat for each property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="SpecimenConditionsPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:SpecimenConditions object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:SpecimenConditions"/>
        </sequence>
    </complexType>

    <element name="IntactSpecimenPreparationInfo" type="diggs:IntactSpecimenPreparationInfoType">
        <annotation>
            <documentation>
                Information on the preparation of an intact specimen.
            </documentation>
        </annotation>
    </element>
    <complexType name="IntactSpecimenPreparationInfoPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:IntactSpecimenPreparationInfo object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:IntactSpecimenPreparationInfo"/>
        </sequence>
    </complexType>
    <complexType name="IntactSpecimenPreparationInfoType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <element name="IntactSpecimenType" type="diggs:IntactSpecimenTypeType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:intactSpecimenType"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use intactSpecimenType; this name is a misspelling
                                    of it. The type or classification of the intact specimen. Values
                                    come from the enumerated list, or "Other: xx", where xx is a
                                    user-defined term whose meaning differs from every listed value
                                    (not a synonym of one).
                                </documentation>
                            </annotation>
                        </element>
                        <element name="intactSpecimenType" type="diggs:IntactSpecimenTypeType">
                            <annotation>
                                <documentation>
                                    The type or classification of the intact specimen. Values come
                                    from the enumerated list, or "Other: xx", where xx is a
                                    user-defined term whose meaning differs from every listed value
                                    (not a synonym of one). Use this element, not the deprecated
                                    IntactSpecimenType.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                    <element minOccurs="0" name="specimenTrimmedInWetRoom" type="boolean">
                        <annotation>
                            <documentation>
                                For trimmed intact specimens, true if the trimming took place in a
                                wet room.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="IntactSpecimenTypeEnumType">
        <annotation>
            <documentation>
                The ways an intact specimen is obtained from its sample.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="extruded">
                <annotation>
                    <documentation>
                        The specimen was extruded from its sampler.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sub-sampled">
                <annotation>
                    <documentation>
                        The specimen was sub-sampled from a larger sample.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="trimmed">
                <annotation>
                    <documentation>
                        The specimen was trimmed to the required dimensions.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="IntactSpecimenTypeType">
        <annotation>
            <documentation>
                Type for the type of an intact specimen: a diggs:IntactSpecimenTypeEnumType value or
                a value of the form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:IntactSpecimenTypeEnumType diggs:OtherNameType"/>
    </simpleType>

    <simpleType name="SpecimenShapeEnumType">
        <annotation>
            <documentation>
                The shapes of a specimen tested.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="cylinder">
                <annotation>
                    <documentation>
                        A cylinder.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="cube">
                <annotation>
                    <documentation>
                        A cube.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="cuboid">
                <annotation>
                    <documentation>
                        A cuboid: a square cylinder or a cube with uneven sides.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="non-solid">
                <annotation>
                    <documentation>
                        A paste, liquid or gas with no defined shape.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="sphere">
                <annotation>
                    <documentation>
                        A sphere.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="SpecimenShapeType">
        <annotation>
            <documentation>
                Type for the shape of a specimen: a diggs:SpecimenShapeEnumType value or a value of
                the form "Other: xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:SpecimenShapeEnumType"/>
    </simpleType>
    <simpleType name="SpecimenTypeType">
        <union memberTypes="diggs:OtherNameType diggs:SpecimenEnumType"/>
    </simpleType>
    <simpleType name="SpecimenEnumType">
        <restriction base="string">
            <enumeration value="intact">
                <annotation>
                    <documentation>
                        The specimen was prepared without disturbance from an undisturbed sample,
                        for example from a thin-walled sampler.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="disturbed">
                <annotation>
                    <documentation>
                        The specimen was prepared from a disturbed sample, for example from a
                        thick-walled sampler.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="remolded">
                <annotation>
                    <documentation>
                        The specimen was prepared from a failed or otherwise disturbed intact
                        specimen.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="reconstituted">
                <annotation>
                    <documentation>
                        The specimen was prepared to a predetermined water content and density.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>

    <simpleType name="DimensionMeasurementTechniqueEnumType">
        <annotation>
            <documentation>
                The techniques for measuring specimen lengths and diameters.
            </documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Calipers">
                <annotation>
                    <documentation>
                        Measured with calipers.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="PI-tape">
                <annotation>
                    <documentation>
                        Measured with a pi tape, which reads diameter from circumference.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="DimensionMeasurementTechniqueType">
        <annotation>
            <documentation>
                Type for a technique for measuring specimen dimensions: a
                diggs:DimensionMeasurementTechniqueEnumType value or a value of the form "Other:
                xx".
            </documentation>
        </annotation>
        <union memberTypes="diggs:DimensionMeasurementTechniqueEnumType diggs:OtherNameType"/>
    </simpleType>

    <!-- ================================================================================= -->
    <!-- GEOMETRY OBJECTS                                                                  -->
    <!-- ================================================================================= -->

    <element abstract="true" name="AbstractGeometricAggregate"
        substitutionGroup="diggs:AbstractGeometry" type="gml:AbstractGeometricAggregateType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for geometry aggregates, the collections of
                geometric primitives.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractGeometricAggregateType">
        <annotation>
            <documentation>
                Abstract base type for geometry aggregates: collections of geometric primitives that
                together represent a single geometric concept, such as a multi-part feature or a
                discontinuous sampling area. Use one of its concrete extensions, for example
                diggs:MultiPointLocationType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractGeometricAggregateType"> </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractGeometricPrimitive"
        substitutionGroup="diggs:AbstractGeometry" type="gml:AbstractGeometricPrimitiveType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for geometry primitives.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractGeometricPrimitiveType">
        <annotation>
            <documentation>
                Abstract base type for geometric primitives: geometric objects that are not
                decomposed further into other primitives. All primitives are oriented in the
                direction implied by the sequence of their coordinate tuples. Use one of its
                concrete extensions, for example diggs:PointLocationType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractGeometricPrimitiveType"/>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractGeometry" substitutionGroup="gml:AbstractGeometry"
        type="gml:AbstractGeometryType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for DIGGS geometry objects.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractGeometryType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for DIGGS geometry objects, the root of the DIGGS geometry
                hierarchy; every DIGGS geometry type derives from gml:AbstractGeometryType through
                it. gml:name, gml:identifier, gml:description and gml:descriptionReference are
                available on every geometry. gml:id is optional, but state one whenever the geometry
                is referenced: a linear-referencing element, a shared extent cited by xlink:href or
                a local CRS axis definition cannot resolve without one. Omit it only for geometry
                that is wholly contained and never cited. Use one of its concrete extensions, for
                example diggs:PointLocationType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractGeometryType"/>
        </complexContent>
    </complexType>

    <element name="PointLocation" substitutionGroup="diggs:AbstractGeometricPrimitive"
        type="diggs:PointLocationType">
        <annotation>
            <documentation>
                A geometry object that defines a point location.
            </documentation>
        </annotation>
    </element>
    <complexType name="PointLocationType">
        <complexContent>
            <extension base="diggs:AbstractGeometricPrimitiveType">
                <sequence>
                    <choice>
                        <element ref="gml:pos"/>
                    </choice>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the point.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PointLocationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PointLocation object inline, or refers to one
                with xlink:href.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:PointLocation"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>

    <element name="MultiPointLocation" substitutionGroup="diggs:AbstractGeometricAggregate"
        type="diggs:MultiPointLocationType">
        <annotation>
            <documentation>
                A geometry object that contains a collection of point locations.
            </documentation>
        </annotation>
    </element>
    <complexType name="MultiPointLocationType">
        <complexContent>
            <extension base="diggs:AbstractGeometricAggregateType">
                <sequence>
                    <element ref="gml:posList"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the points.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MultiPointPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MultiPointLocation object inline, or refers to
                one with xlink:href.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:MultiPointLocation"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>

    <complexType name="RectifiedGridType">
        <complexContent>
            <extension base="diggs:GridType">
                <sequence>
                    <element name="origin" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The location of the grid origin: the node with grid coordinates of
                                zero on every axis.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="offsetVector" type="gml:VectorType">
                        <annotation>
                            <documentation>
                                The vector between adjacent nodes along one grid axis. Repeat for
                                each grid axis.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the grid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RectifiedGrid" substitutionGroup="diggs:AbstractGeometry"
        type="diggs:RectifiedGridType">
        <annotation>
            <documentation>
                A grid whose node positions are derived from an origin and offset vectors. It
                mirrors gml:RectifiedGrid.
            </documentation>
        </annotation>
    </element>

    <element name="Grid" type="diggs:GridType" substitutionGroup="diggs:AbstractGeometry">
        <annotation>
            <documentation>
                A grid of nodes in an index space, defined by its limits and axis labels, without
                spatial positions.
            </documentation>
        </annotation>
    </element>
    <complexType name="GridType">
        <annotation>
            <documentation>
                Type for a grid of nodes in an index space, defined by its limits and axis labels.
                Extend it to give the nodes positions, for example diggs:RectifiedGridType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGeometryType">
                <sequence>
                    <element name="limits" type="gml:GridLimitsType">
                        <annotation>
                            <documentation>
                                The extent of the grid in its index space: the lowest and highest
                                index on each axis.
                            </documentation>
                        </annotation>
                    </element>
                    <choice>
                        <element name="axisLabels" type="gml:NCNameList">
                            <annotation>
                                <documentation>
                                    The labels of the grid axes, in index order.
                                </documentation>
                            </annotation>
                        </element>
                        <element maxOccurs="unbounded" name="axisName" type="string">
                            <annotation>
                                <documentation>
                                    The name of a grid axis. Repeat for each axis.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
                <attribute name="dimension" type="positiveInteger" use="required">
                    <annotation>
                        <documentation>
                            The number of dimensions of the grid.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>

    <element name="ReferenceableGridByArray" substitutionGroup="diggs:AbstractGeometry"
        type="diggs:ReferenceableGridByArrayType">
        <annotation>
            <documentation>
                A grid whose node positions are given explicitly as an ordered list of coordinates
                (posList), rather than derived from an origin and offset vectors
                (diggs:RectifiedGrid). Use it for a non-uniform or terrain-draped grid, for example
                a geophysical inversion mesh, where node spacing is irregular on one or more axes.
                It mirrors gmlrgrid:ReferenceableGridByArrayType of GML 3.3.
            </documentation>
        </annotation>
    </element>
    <complexType name="ReferenceableGridByArrayType">
        <complexContent>
            <extension base="diggs:GridType">
                <sequence>
                    <element ref="gml:posList">
                        <annotation>
                            <documentation>
                                The ordered list of node positions, one coordinate tuple per grid
                                node, in the traversal order given by sequenceRule. The number of
                                tuples equals the product of the extents of the grid limits, each
                                extent inclusive.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="sequenceRule" type="gml:SequenceRuleType">
                        <annotation>
                            <documentation>
                                The traversal order of the node positions in posList relative to the
                                grid's own index axes, for example Linear or Boustrophedonic.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the grid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractCurve"
        substitutionGroup="diggs:AbstractGeometricPrimitive" type="diggs:AbstractCurveType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for curves, the one-dimensional geometric
                primitives.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractCurveType">
        <annotation>
            <documentation>
                Abstract base type for curves. A curve may always be viewed as a geometric
                primitive, that is, as continuous. Use one of its concrete extensions, for example
                diggs:LinearExtentType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractCurveType"/>
        </complexContent>
    </complexType>

    <element name="LinearExtent" substitutionGroup="diggs:AbstractCurve"
        type="diggs:LinearExtentType">
        <annotation>
            <documentation>
                A location as a linear extent or interval, implementing the Linear Element concept
                of ISO 19148:2021 section 6.3. The first vertex is the starting location and the
                last vertex the end location, with the coordinates in gml:posList in the order
                traversed during measurement. It is the object along which linear referencing
                measurements are made, and typically represents a borehole centerline (the
                three-dimensional path from collar to bottom), a well trajectory including deviated
                wells, a CPT sounding path, a geophysical trackline or a survey transect.
            </documentation>
        </annotation>
    </element>
    <complexType name="LinearExtentType">
        <complexContent>
            <extension base="diggs:AbstractCurveType">
                <sequence>
                    <choice>
                        <element ref="gml:posList"/>
                    </choice>
                    <element minOccurs="0" name="datumReference" type="diggs:ReferentTypeEnumType">
                        <annotation>
                            <documentation>
                                The type of local or permanent reference datum for vertical
                                gravity-based (elevation and vertical depth) and measured depth
                                coordinates, in the context of a borehole or well. It follows
                                eml:WellboreDatumReference and is associated with the origin (first
                                point) of the linear extent. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="anchorPoint"
                        type="diggs:ReferentPropertyType">
                        <annotation>
                            <documentation>
                                A calibration point that relates measure values to geometric
                                positions along this linear extent. It is needed only when the
                                length of the linear element does not correspond to the length
                                computed from the coordinates: when physical core length differs
                                from measured depth (anchors at top and bottom enable scaling, as
                                for expanded or compressed core), when downhole surveys or GPS
                                waypoints provide control points for adjusting the geometry, or when
                                measures cannot be computed directly from the centerline geometry.
                                Where measures are computed by interpolating along the geometry,
                                anchor points are not needed. Repeat for each point.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="startValue" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                Where the linear element is linearly referenced, the measure value
                                at its start. It defaults to 0 in the unit of the linear referencing
                                method if omitted.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The uncertainty of the geometric positions along the linear extent,
                                where the coordinates have a known measurement uncertainty.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LinearExtentPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LinearExtent object inline, or refers to one
                with xlink:href.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:LinearExtent"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="SurfacePropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractSurface,
                or one diggs:MultiSurface, inline, or refers to one with xlink:href.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:AbstractSurface"/>
                        <element ref="diggs:MultiSurface"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>

    <element name="PlanarSurface" substitutionGroup="diggs:AbstractSurface"
        type="diggs:PlanarSurfaceType">
        <annotation>
            <documentation>
                A surface that lies within a single plane, as a polygon with an outer ring and
                optionally several inner rings. The coordinate points of all rings are coplanar.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlanarSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractSurfaceType">
                <sequence>
                    <element minOccurs="0" ref="gml:exterior"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:interior"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the surface.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType name="PlanarSurfacePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PlanarSurface object inline, or refers to one
                with xlink:href.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:PlanarSurface"/>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <complexType name="PlanarSurfaceOrMultiSurfacePropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PlanarSurface or one diggs:MultiSurface
                inline. It is narrower than diggs:SurfacePropertyType, for a host that wants one
                planar region or several disjoint planar regions and nothing else. The members of
                the diggs:MultiSurface are expected to be diggs:PlanarSurface objects, which the
                schema does not enforce. Each member is treated as an independent component, and
                components do not overlap in plan view.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <choice>
                <element ref="diggs:PlanarSurface"/>
                <element ref="diggs:MultiSurface"/>
            </choice>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>
    <element name="MultiPlanarSurface" substitutionGroup="diggs:AbstractSurface"
        type="diggs:MultiPlanarSurfaceType">
        <annotation>
            <documentation>
                A single contiguous surface that does not lie within a single plane, as an array of
                polygon patches, each with an outer ring and optionally inner rings. The points of a
                patch are coplanar, and each patch shares an edge with an adjacent patch. Patches
                are not individually addressable (no gml:id, no independent srsName); use
                diggs:CompositeSurface when panels need their own CRS, gml:id or reuse by reference,
                and diggs:MultiSurface for a collection with no assumed adjacency between members.
            </documentation>
        </annotation>
    </element>
    <complexType name="MultiPlanarSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractSurfaceType">
                <sequence>
                    <element ref="gml:patches"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the surface.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>


    <element name="CompositeSurface" substitutionGroup="diggs:AbstractSurface"
        type="diggs:CompositeSurfaceType">
        <annotation>
            <documentation>
                A single contiguous surface assembled from one or more independently existing
                surface members that join along shared boundaries (ISO 19107 GM_CompositeSurface).
                Each member is a complete diggs:AbstractSurface object with its own gml:id and
                optional srsName, given inline or by xlink:href to a surface defined elsewhere in
                the document. Use it when panels need their own CRS, gml:id or reuse by reference,
                for example a dog-leg trench wall whose segments were surveyed in different local
                datums. Use diggs:MultiPlanarSurface for a single multi-panel surface with
                non-addressable panels, and diggs:MultiSurface for a discontinuous collection or a
                coverage domain needing one value per member.
            </documentation>
        </annotation>
    </element>
    <complexType name="CompositeSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractSurfaceType">
                <sequence>
                    <element ref="diggs:surfaceMember" minOccurs="0" maxOccurs="unbounded"/>
                    <element ref="diggs:surfaceMembers" minOccurs="0"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the surface.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attributeGroup ref="gml:AggregationAttributeGroup"/>
            </extension>
        </complexContent>
    </complexType>

    <element name="PlanarSurfacePatch" substitutionGroup="gml:AbstractSurfacePatch"
        type="diggs:PlanarSurfacePatchType">
        <annotation>
            <documentation>
                A polygon that defines one patch of a diggs:MultiPlanarSurface.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlanarSurfacePatchType">
        <complexContent>
            <extension base="gml:AbstractSurfacePatchType">
                <sequence>
                    <element minOccurs="0" ref="gml:exterior"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="gml:interior"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:PatchedLocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the patch.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute fixed="planar" name="interpolation" type="gml:SurfaceInterpolationType">
                    <annotation>
                        <documentation>
                            The interpolation method of the patch surface.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="MultiSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractGeometricAggregateType">
                <sequence>
                    <element ref="diggs:surfaceMember" minOccurs="0" maxOccurs="unbounded"/>
                    <element ref="diggs:surfaceMembers" minOccurs="0"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional accuracy of the surfaces.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="MultiSurface" substitutionGroup="diggs:AbstractGeometricAggregate"
        type="diggs:MultiSurfaceType">
        <annotation>
            <documentation>
                A collection of surface geometries with no assumed contiguity between members (ISO
                19107 GM_MultiSurface): a coverage domain (N surfaces, N values) or a genuinely
                discontinuous extent, such as several isolated footing surfaces. Members may be
                given inline (surfaceMember or surfaceMembers) or by xlink:href to a surface defined
                elsewhere in the document; a coverage domain should prefer the inline surfaceMembers
                array so its element count stays directly readable without resolving references.
                Contrast diggs:CompositeSurface (contiguous, one domain value) and
                diggs:MultiPlanarSurface (contiguous, non-addressable patches).
            </documentation>
        </annotation>
    </element>

    <!-- ================================================================================= -->
    <!-- TIME OBJECTS                                                                  -->
    <!-- ================================================================================= -->

    <complexType name="AbstractTimeObjectBaseType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for time objects that have no description field, such as events,
                time periods or temporal measurements. Use one of its concrete extensions.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:AbstractTimeObjectType">
                <sequence>
                    <element ref="gml:description" minOccurs="0"/>
                </sequence>
            </restriction>
        </complexContent>
    </complexType>
    <element name="AbstractTimeObject" substitutionGroup="gml:AbstractTimeObject"
        type="diggs:AbstractTimeObjectType" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for DIGGS time objects.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractTimeObjectType">
        <annotation>
            <documentation>
                Abstract base type for DIGGS time objects: the GML temporal model with status and
                remarks. Use one of its concrete extensions, for example diggs:TimePositionListType.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTimeObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:status"/>
                    <element name="remark" type="diggs:RemarkPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A comment or remark about this object, as a diggs:Remark. Repeat for
                                each remark.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <complexType name="TimeArrayPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="diggs:TimePositionList, in place of diggs:MultiTimeInstant"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:TimePositionList. Property type that wraps a time instant,
                used only by diggs:MultiTimeInstantType.
            </documentation>
        </annotation>
        <sequence maxOccurs="1" minOccurs="1">
            <element ref="gml:TimeInstant"/>
        </sequence>
    </complexType>
    <element name="TimePositionList" substitutionGroup="diggs:AbstractTimeObject"
        type="diggs:TimePositionListType">
        <annotation>
            <documentation>
                A time object that contains a list of time instances expressed as xsd:dateTime
                values.
            </documentation>
        </annotation>
    </element>
    <complexType name="TimePositionListType">
        <complexContent>
            <extension base="diggs:AbstractTimeObjectType">
                <sequence>
                    <element name="timePositionList" type="diggs:TimeListSimpleType">
                        <annotation>
                            <documentation>
                                The list of time instances, as whitespace-separated dateTime values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="TimeIntervalList" substitutionGroup="diggs:AbstractTimeObject"
        type="diggs:TimeIntervalListType">
        <annotation>
            <documentation>
                A time object that contains a list of time intervals (durations or elapsed times)
                expressed as decimal values. The unit attribute gives the time unit of the list.
            </documentation>
        </annotation>
    </element>

    <complexType name="TimeIntervalListType">
        <complexContent>
            <extension base="diggs:AbstractTimeObjectType">
                <sequence>
                    <element ref="diggs:timeIntervalList"/>
                </sequence>
                <attribute name="unit" type="gml:TimeUnitType" use="required">
                    <annotation>
                        <documentation>
                            The time unit of the values in the list.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="radix" type="positiveInteger">
                    <annotation>
                        <documentation>
                            The base of the resolution of the values, as in gml:timeInterval: with
                            factor, the values are resolved to one radix^(-factor) of the unit. For
                            example unit second, radix 10 and factor 3 give a resolution of one
                            millisecond.
                        </documentation>
                    </annotation>
                </attribute>
                <attribute name="factor" type="integer">
                    <annotation>
                        <documentation>
                            The exponent of the resolution of the values; see radix.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="TimeListSimpleType">
        <list itemType="gml:TimePositionUnion"/>
    </simpleType>
    <element name="timeIntervalList" type="diggs:TimeIntervalListSimpleType">
        <annotation>
            <documentation>
                A list of decimal values representing time intervals (durations or elapsed times),
                separated by whitespace.
            </documentation>
        </annotation>
    </element>
    <simpleType name="TimeIntervalListSimpleType">
        <list itemType="decimal"/>
    </simpleType>

    <!-- ================================================================================== -->
    <!-- DEPRECATED ELEMENTS                                                                -->
    <!-- ================================================================================== -->

    <element name="filterPackInterval" type="diggs:LinearExtentPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:Backfill" note="a Backfill object that references this well opening"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a diggs:Backfill object that references this well opening. The depth
                interval of the filter pack surrounding the well screen or well openings.
            </documentation>
        </annotation>
    </element>
    <element name="holeBearing" type="diggs:PlaneAngleMeasureType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:bearing"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use bearing. The bearing of the hole.
            </documentation>
        </annotation>
    </element>
    <element name="holePlunge" type="diggs:PlaneAngleMeasureType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0" replacedBy="diggs:plunge"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use plunge. The plunge of the hole.
            </documentation>
        </annotation>
    </element>
    <element name="chiseling" type="diggs:ChiselingPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="diggs:BoreholeConstructionMethod for the interval and tool, and the borehole's drillAdvancement for the rate of advancement"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:BoreholeConstructionMethod for the chiseling interval and
                tool, and the borehole's drillAdvancement for the rate of advancement. Information
                on chiseling activity in a hole (AGS CHIS group).
            </documentation>
        </annotation>
    </element>
    <element name="Chiseling" type="diggs:ChiselingType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="diggs:BoreholeConstructionMethod for the interval and tool, and the borehole's drillAdvancement for the rate of advancement"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:BoreholeConstructionMethod and the borehole's drillAdvancement
                (see chiseling). An object containing properties about chiseling activity as part of
                advancement of a borehole.
            </documentation>
        </annotation>
    </element>
    <complexType name="ChiselingPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="diggs:BoreholeConstructionMethod for the interval and tool, and the borehole's drillAdvancement for the rate of advancement"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:BoreholeConstructionMethod and the borehole's drillAdvancement
                (see chiseling). Property type that contains one diggs:Chiseling object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:Chiseling"/>
        </sequence>
    </complexType>
    <complexType name="ChiselingType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" note="diggs:BoreholeConstructionMethod for the interval and tool, and the borehole's drillAdvancement for the rate of advancement"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:BoreholeConstructionMethod and the borehole's drillAdvancement
                (see chiseling). Type for chiseling activity during advancement of a borehole.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="chiselingLocation" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The measured depth interval over which the chiseling takes place,
                                recorded in the hole's linear referencing system.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="timeTaken" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The amount of time taken to perform the chiseling task.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="chiselingToolUsed" type="gml:StringOrRefType">
                        <annotation>
                            <documentation>
                                Tool used to perform the chiseling. Intended to come from a
                                controlled list. NOTE: This is a string that could come from a
                                controlled list of terms, but could also reference an Equipment
                                metadata object.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="sanitarySealLocation" type="diggs:PointLocationPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:Backfill" note="a Backfill object of the borehole representing the sanitary seal"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a diggs:Backfill object of the borehole to represent the sanitary
                seal. Distance to the base of the sanitary seal, measured in the borehole's linear
                reference system.
            </documentation>
        </annotation>
    </element>
    <element name="sanitarySealType" type="gml:CodeType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:Backfill" note="a Backfill object of the borehole representing the sanitary seal"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a diggs:Backfill object of the borehole to represent the sanitary
                seal. The type of material used for the sanitary or surface seal (e.g. bentonite,
                grout).
            </documentation>
        </annotation>
    </element>
    <element name="penetrationRate" type="diggs:LengthPerTimeMeasureType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:advancementRate" note="in the borehole's drillAdvancement (diggs:Advancement)"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use advancementRate in the borehole's drillAdvancement. Rate of
                advancement of the drill head.
            </documentation>
        </annotation>
    </element>

    <element name="MultiTimeInstant" type="diggs:MultiTimeInstantType"
        substitutionGroup="diggs:AbstractTimeObject" abstract="false">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:TimePositionList"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:TimePositionList. A time object that contains a collection of
                time instances.
            </documentation>
        </annotation>
    </element>
    <complexType name="MultiTimeInstantType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0" replacedBy="diggs:TimePositionListType"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use diggs:TimePositionListType. Type for a collection of time instances.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractTimeObjectType">
                <sequence>
                    <element name="timeMember" type="diggs:TimeArrayPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A time instant that is a member of the collection. Repeat for each
                                member.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="ElapsedTimeBasisEnumType">
        <restriction base="string">
            <enumeration value="completion to start">
                <annotation>
                    <documentation>
                        Elapsed time measured from the completion of the first activity's governing
                        interval to the start of the second's.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="start to start">
                <annotation>
                    <documentation>
                        Elapsed time measured between the start of each activity's governing
                        interval.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="completion to completion">
                <annotation>
                    <documentation>
                        Elapsed time measured between the completion of each activity's governing
                        interval.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="start to completion">
                <annotation>
                    <documentation>
                        Elapsed time measured from the start of the first activity's governing
                        interval to the completion of the second's.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ElapsedTimeBasisEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ElapsedTimeBasisEnumType"/>
    </simpleType>
</schema>
