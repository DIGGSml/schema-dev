<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <!-- ================================================================================= -->
    <!-- This schema file contains abstract and concrete elements and types that define    -->
    <!-- EXTENDED samplng features ans associated geometry and time domain objects.            -->
    <!-- ================================================================================= -->
    <!-- ================================================================================= -->
    <!-- SAMPLING FEATURE OBJECTS                                                                  -->
    <!-- ================================================================================= -->


    <!-- Uncomment to clear validation errors without a master file
    <include schemaLocation="../Diggs.xsd"/>
-->
    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element abstract="true" name="AbstractPointSamplingFeature"
        substitutionGroup="diggs:AbstractSamplingFeature"
        type="diggs:AbstractPointSamplingFeatureType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for point sampling features.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractPointSamplingFeatureType">
        <annotation>
            <documentation>
                Abstract base type for point sampling features: discrete locations where samples are
                collected or measurements made. They are treated as points because their extent is
                negligible compared with the investigation area, even where they have physical
                dimensions (a monitoring well has a diameter). Examples are CPT soundings,
                groundwater monitoring points, surface soil sample locations and probe test
                positions. A point feature has a single location coordinate. Use one of its concrete
                extensions, for example diggs:Station.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureType">
                <sequence> </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractPointInstallation"
        substitutionGroup="diggs:AbstractSamplingFeature" type="diggs:AbstractPointInstallationType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for installations with point (0D)
                geometries, such as monitoring points or instrumentation nodes. An installation is a
                sampling feature that is installed within another sampling feature.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractPointInstallationType">
        <complexContent>
            <extension base="diggs:AbstractPointSamplingFeatureType">
                <sequence>
                    <element ref="diggs:samplingFeatureRef"/>
                    <element minOccurs="0" name="installationConstructionEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The occurrences and activities involved in constructing the
                                installation within the sampling feature. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="installationEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                The equipment used to install the installation, such as the
                                machinery, tools or devices employed to install a monitoring point
                                or instrumentation. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="false" name="Transect"
        substitutionGroup="diggs:AbstractLinearSamplingFeature" type="diggs:TransectType">
        <annotation>
            <documentation>
                A linear sampling feature that extends along the surface of an investigation target,
                used for features such as geophysical arrays and measured sections.
            </documentation>
        </annotation>
    </element>
    <complexType name="TransectType">
        <complexContent>
            <extension base="diggs:AbstractLinearSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenTransectRun"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the transect is run.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalTransectLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The total length of the transect.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="transectPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose for running the transect. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="false" name="Station" substitutionGroup="diggs:AbstractPointSamplingFeature"
        type="diggs:StationType">
        <annotation>
            <documentation>
                A sampling feature that is a point in or on the earth's surface where observations
                or tests are performed, where samples are collected, or where monitoring devices are
                installed.
            </documentation>
        </annotation>
    </element>
    <complexType name="StationType">
        <complexContent>
            <extension base="diggs:AbstractPointSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" name="whenOccupied" type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The time interval during which the station was occupied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of station, for example outcrop or survey marker. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="AbstractPlanarSamplingFeature" type="diggs:AbstractPlanarSamplingFeatureType"
        substitutionGroup="diggs:AbstractSamplingFeature" abstract="true">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sampling features with planar (2D)
                geometries.
            </documentation>
        </annotation>
    </element>
    <complexType name="AbstractPlanarSamplingFeatureType" abstract="true">
        <annotation>
            <documentation>
                Abstract base type for sampling features with planar (2D) geometries, including test
                pits and excavations. Use one of its concrete extensions, for example
                diggs:PlanarSamplingFeature.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" maxOccurs="1" ref="diggs:referenceEdge"/>
                    <element name="featureExtent" type="diggs:SurfacePropertyType" maxOccurs="1"
                        minOccurs="1">
                        <annotation>
                            <documentation>
                                The extent of the surface feature, usable for visual representations
                                in simple mapping software. It is the only extent property needed:
                                the srsName of the surface may name either a spatial CRS or a
                                diggs:LocalCartesianCRS declared in DocumentInformation/crs, so a
                                feature described in local coordinates gives its extent here and
                                points srsName at that local CRS. relativeFeatureBoundary,
                                referenceEdge and planarReferencing are deprecated. The surface may
                                be given inline or cited with xlink:href, pointing at a surface
                                declared elsewhere in the document, so that one polygon need not be
                                restated everywhere it applies. A reference asserts identity: this
                                feature's extent is that surface, not an approximation of it or
                                derived from it. Where two extents differ, however slightly, each
                                states its own geometry and no reference is used. For example, an
                                as-built feature whose extent matched the designed extent it
                                realizes cites that surface, while one that departed from it carries
                                its own.
                            </documentation>
                        </annotation>
                    </element>
                    <element ref="diggs:relativeFeatureBoundary" maxOccurs="1" minOccurs="0"/>
                    <element ref="diggs:planarReferencing" maxOccurs="unbounded" minOccurs="0"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractPlanarInstallation"
        substitutionGroup="diggs:AbstractSamplingFeature"
        type="diggs:AbstractPlanarInstallationType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for installations with planar (2D)
                geometries. An installation is a sampling feature that is installed within another
                sampling feature.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractPlanarInstallationType">
        <complexContent>
            <extension base="diggs:AbstractPlanarSamplingFeatureType">
                <sequence>
                    <element ref="diggs:samplingFeatureRef"/>
                    <element minOccurs="0" name="installationConstructionEvent"
                        type="diggs:InstallationEventPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The occurrences and activities involved in constructing the
                                installation within the sampling feature. Repeat for each event.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="installationEquipment"
                        type="diggs:EquipmentPropertyType">
                        <annotation>
                            <documentation>
                                The equipment used to install the installation, such as the
                                machinery, tools or devices employed to install a monitoring point
                                or instrumentation. Repeat for each item.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="PlanarSamplingFeature" substitutionGroup="diggs:AbstractPlanarSamplingFeature"
        type="diggs:PlanarSamplingFeatureType">
        <annotation>
            <documentation>
                A generic 2D sampling feature that represents a 2D sampling space. The featureExtent
                can be a PlanarSurface (simple cross-sections or maps), where the surface is
                entirely coplanar, or a MultiPlanarSurface, where the surface consists of several
                coplanar patches (dog-leg sections or non-coplanar surfaces).
            </documentation>
        </annotation>
    </element>
    <complexType name="PlanarSamplingFeatureType">
        <complexContent>
            <extension base="diggs:AbstractPlanarSamplingFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <element name="TrenchWall" substitutionGroup="diggs:AbstractPlanarSamplingFeature"
        type="diggs:TrenchWallType">
        <annotation>
            <documentation>
                A wall of a trench or pit dug into the ground, represented by a PlanarSurface or
                MultiPlanarSurface geometry.
            </documentation>
        </annotation>
    </element>
    <element name="TrenchWallEvent" type="diggs:TrialPitEventType">
        <annotation>
            <documentation>
                An event, in time or location, that occurs during construction of a trial pit or
                trench wall.
            </documentation>
        </annotation>
    </element>
    <complexType name="TrenchWallEventPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TrenchWallEvent object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TrenchWallEvent"/>
        </sequence>
    </complexType>
    <complexType name="TrenchWallType">
        <complexContent>
            <extension base="diggs:AbstractPlanarSamplingFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="whenConstructed"
                        type="diggs:TimeIntervalPropertyType">
                        <annotation>
                            <documentation>
                                The period during which the trench is constructed, including the
                                entire time it is open for logging.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="trenchDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The maximum depth of the trench, referenced to a linear reference
                                system.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="trenchLength"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the long horizontal dimension of the trench.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="trenchWidth"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of the short horizontal dimension of the trench.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="shoring" type="string">
                        <annotation>
                            <documentation>
                                A description of the shoring equipment and method used for the
                                trench.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" name="trenchPurpose" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The purpose of excavating the trench, for example exploratory. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="backfill" type="diggs:BackfillPropertyType">
                        <annotation>
                            <documentation>
                                The construction of the trench backfill that covers the trench wall
                                exposure.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionMethod"
                        type="diggs:TrenchConstructionMethodPropertyType">
                        <annotation>
                            <documentation>
                                The construction method of the pit over a depth interval. Repeat for
                                each interval.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="constructionEvent"
                        type="diggs:TrenchWallEventPropertyType">
                        <annotation>
                            <documentation>
                                An event in the construction of the trench, with time. Repeat for
                                each event.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element abstract="true" name="AbstractVolumetricSamplingFeature"
        substitutionGroup="diggs:AbstractSamplingFeature"
        type="diggs:AbstractVolumeSamplingFeatureType">
        <annotation>
            <documentation>
                Abstract head of the substitution group for sampling features with volume (3D)
                geometries.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractVolumeSamplingFeatureType">
        <annotation>
            <documentation>
                Abstract base type for sampling features with volume (3D) geometries. Use one of its
                concrete extensions, for example diggs:VolumetricSamplingFeature.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractSamplingFeatureType">
                <sequence>
                    <element minOccurs="0" ref="diggs:referenceEdge"/>
                    <element maxOccurs="1" minOccurs="1" name="featureExtent"
                        type="diggs:VolumePropertyType">
                        <annotation>
                            <documentation>
                                The extent of the solid feature, usable for visual representations
                                in simple mapping software. It is the only extent property needed:
                                the srsName of the volume may name either a spatial CRS or a
                                diggs:LocalCartesianCRS declared in DocumentInformation/crs.
                                relativeFeatureExtent and volumeReferencing are deprecated. The
                                volume may be given inline or cited with xlink:href, with the same
                                meaning as for
                                diggs:AbstractPlanarSamplingFeatureType/featureExtent.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="1" minOccurs="0" ref="diggs:relativeFeatureExtent"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:volumeReferencing"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="VolumetricSamplingFeature"
        substitutionGroup="diggs:AbstractVolumetricSamplingFeature"
        type="diggs:VolumetricSamplingFeatureType">
        <annotation>
            <documentation>
                A generic 3D sampling feature that represents a volume that defines the sampling
                space. Its featureExtent uses Solid geometry.
            </documentation>
        </annotation>
    </element>
    <complexType name="VolumetricSamplingFeatureType">
        <complexContent>
            <extension base="diggs:AbstractVolumeSamplingFeatureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================= -->
    <!-- GEOMETRY OBJECTS                                                                  -->
    <!-- ================================================================================= -->

    <element abstract="true" name="AbstractVolume" type="diggs:AbstractVolumeType"
        substitutionGroup="diggs:AbstractGeometricPrimitive">
        <annotation>
            <documentation>
                Abstract head of the substitution group for 3D geometries.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractVolumeType">
        <annotation>
            <documentation>
                Abstract base type for volume geometries: an abstraction of a solid that supports
                differing levels of complexity, and is always a continuous geometric primitive. It
                extends gml:AbstractSolidType, GML's equivalent concept (DIGGS names it "Volume"
                rather than "Solid"). Use one of its concrete extensions, for example diggs:Solid.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="gml:AbstractSolidType"/>
        </complexContent>
    </complexType>

    <complexType name="VolumePropertyType">
        <annotation>
            <documentation>
                Property type that contains an object that substitutes for diggs:AbstractVolume
                inline, or refers to one with xlink:href.
            </documentation>
        </annotation>
        <complexContent>
            <restriction base="gml:DomainSetType">
                <sequence minOccurs="0">
                    <choice>
                        <element ref="diggs:AbstractVolume"/>
                    </choice>
                </sequence>
                <attributeGroup ref="gml:OwnershipAttributeGroup"/>
                <attributeGroup ref="gml:AssociationAttributeGroup"/>
            </restriction>
        </complexContent>
    </complexType>
    <complexType name="SolidType">
        <complexContent>
            <extension base="diggs:AbstractVolumeType">
                <sequence>
                    <element minOccurs="0" name="exterior" type="diggs:ShellPropertyType">
                        <annotation>
                            <documentation>
                                The exterior boundary surface of the volume: the outer shell that
                                encloses the 3D feature. For a solid volume it is the only boundary
                                surface needed.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="interior"
                        type="diggs:ShellPropertyType">
                        <annotation>
                            <documentation>
                                An interior boundary surface (a void or hole) within the volume: a
                                hollow space or cavity inside the 3D feature. Repeat for each void.
                                Not needed for a volume without internal voids.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:PatchedLocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the solid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="Solid" substitutionGroup="diggs:AbstractVolume" type="diggs:SolidType">
        <annotation>
            <documentation>
                A geometry object that forms the basis for 3D geometry: a volume bounded by shells.
                exterior specifies the outer boundary and interior the inner boundaries (voids or
                holes) of the solid.
            </documentation>
        </annotation>
    </element>
    <element name="Shell" substitutionGroup="diggs:AbstractGeometricPrimitive" type="diggs:ShellType">
        <annotation>
            <documentation>
                A single connected component of the boundary of a 3D solid. Every
                diggs:surfaceMember references or contains one surface, any element substitutable
                for diggs:AbstractSurface; in a shell, the surfaces describe the boundary of the
                solid. A shell is topologically a surface (the ISO 19107 boundary-of-a-solid
                concept), but its element does not substitute diggs:AbstractSurface, because it is a
                boundary component rather than a standalone surface. If the aggregationType
                attribute is given, its value shall be "set".
            </documentation>
        </annotation>
    </element>
    <complexType name="ShellType">
        <complexContent>
            <extension base="diggs:AbstractSurfaceType">
                <sequence>
                    <element minOccurs="1" ref="diggs:surfaceMembers"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:PatchedLocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the shell.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attributeGroup ref="gml:AggregationAttributeGroup"/>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="ShellPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Shell object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Shell"/>
        </sequence>
    </complexType>

    <element name="SurfaceBoundedSolid" type="diggs:SurfaceBoundedSolidType"
        substitutionGroup="diggs:AbstractVolume">
        <annotation>
            <documentation>
                A volume of earth material whose sides are vertical, encoded as a top surface, a
                bottom surface and a footprint that fixes its lateral extent: one planar region, or
                several disjoint planar regions when the plan-view extent is itself disconnected
                (see diggs:PlanarSurfaceOrMultiSurfacePropertyType). It is intended for geologic
                bodies, such as a stratigraphic unit, a geotechnical layer or a zone of treated
                ground, whose top and bottom vary in relief but whose lateral boundary is vertical
                everywhere. It states only the independent geometry and leaves the side walls to be
                computed, which for a many-vertex footprint or a finely triangulated top surface is
                a large reduction in instance size compared with a diggs:Solid, which needs a
                diggs:Shell enumerating every bounding polygon, including one side polygon per
                footprint edge. Use diggs:Solid for a volume whose sides are not vertical.
                Construction: the solid is the region between topSurface and bottomSurface, bounded
                laterally by vertical walls on the footprint's boundary or, when the footprint is a
                diggs:MultiSurface, on the boundary of each member independently, which gives a
                separate disjoint body per member; together they make up the one
                SurfaceBoundedSolid. The footprint decides only where a wall stands in plan view,
                never how tall it is. A wall lies in the vertical plane through its footprint edge,
                and its upper and lower edges follow the profiles of the top and bottom surfaces
                along that edge. A wall therefore changes slope wherever a surface does, and where a
                surface has a vertical member crossing the edge (a step) the wall steps with it, so
                that the solid is closed; where a surface is one plane, or linear along the whole
                edge, the wall reduces to one planar quadrilateral. The vertices of the top and
                bottom surfaces need not coincide with each other or with the footprint's. A
                footprint interior ring (a hole through the body, or through one member) generates
                its own wall. Footprint members shall not overlap in plan view. Coverage: the top
                and bottom surfaces shall each extend to or beyond the footprint over its entire
                area. A body whose surface stops short of its footprint is not a valid
                diggs:SurfaceBoundedSolid, and no rendering is defined for it. The XSD cannot
                express this geometric condition; check it by instance-level geometry validation of
                the footprint against the extent of each bounding surface. Bounding surfaces:
                topSurface and bottomSurface are each one continuous surface, a diggs:PlanarSurface,
                diggs:CompositeSurface, diggs:MultiPlanarSurface or diggs:TriangulatedSurface (see
                diggs:BoundingSurfacePropertyType), not a diggs:MultiSurface, whose members have no
                assumed adjacency. A body present as several disjoint pieces is expressed with a
                diggs:MultiSurface footprint over continuous top and bottom surfaces: each footprint
                member is walled and capped independently. The members of a diggs:CompositeSurface
                and the patches of a diggs:MultiPlanarSurface shall share boundaries, adjacent
                members meeting along a common boundary curve in three dimensions, so a step is
                represented by a vertical member or patch, never by a gap. Neither surface need be
                planar, single-patch or monotonic. Crossing surfaces: the two surfaces may touch or
                cross. The solid exists only where topSurface lies above bottomSurface; where the
                top is at or below the bottom the body has no thickness and that part of the
                footprint is empty. A body may pinch out within its footprint, and the surviving
                regions are separate parts of the one solid. A consumer should treat the empty
                regions as void, with the parts of the walls that would stand on them, rather than
                render an inverted volume. No GML counterpart: GML represents a solid only by
                explicit boundary representation (gml:Solid bounded by gml:Shell), so this is a
                DIGGS construct with nothing in GML to align to. It substitutes diggs:AbstractVolume
                and its type derives from diggs:AbstractVolumeType, which derives from
                gml:AbstractSolidType, so a schema-aware GML consumer sees a member of the solid
                family, and only a DIGGS-aware consumer needs to know how to expand it.
            </documentation>
        </annotation>
    </element>

    <complexType name="BoundingSurfacePropertyType">
        <annotation>
            <documentation>
                Property type that contains one object, which is a diggs:PlanarSurface, a
                diggs:CompositeSurface, a diggs:MultiPlanarSurface or a diggs:TriangulatedSurface
                inline, or refers to one with xlink:href. It holds one continuous bounding surface
                of a diggs:SurfaceBoundedSolid: a diggs:PlanarSurface, diggs:CompositeSurface,
                diggs:MultiPlanarSurface or diggs:TriangulatedSurface. It is narrower than
                diggs:SurfacePropertyType, which also admits diggs:MultiSurface: a collection of
                surfaces with no assumed adjacency cannot serve as one bounding surface, and a body
                in disjoint pieces is expressed with a diggs:MultiSurface footprint instead. That
                the members of a diggs:CompositeSurface, and the patches of a
                diggs:MultiPlanarSurface, share boundaries is a geometric condition this type cannot
                express; see diggs:SurfaceBoundedSolid.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <choice>
                <element ref="diggs:PlanarSurface"/>
                <element ref="diggs:CompositeSurface"/>
                <element ref="diggs:MultiPlanarSurface"/>
                <element ref="diggs:TriangulatedSurface"/>
            </choice>
        </sequence>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <complexType name="SurfaceBoundedSolidType">
        <complexContent>
            <extension base="diggs:AbstractVolumeType">
                <sequence>
                    <element name="footprint" type="diggs:PlanarSurfaceOrMultiSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The lateral extent of the volume: one planar polygon
                                (diggs:PlanarSurface) whose boundary is the trace of the vertical
                                sides, or several disjoint polygons (diggs:MultiSurface, each member
                                expected to be a diggs:PlanarSurface) when the plan-view extent is
                                itself disconnected, for instance a geologic unit present as
                                separate unconnected patches. Unlike topSurface and bottomSurface,
                                which are each one continuous surface, the footprint may be a
                                diggs:MultiSurface, because each component is one planar region and
                                walls are erected on each component's own boundary; a MultiSurface
                                footprint over one pair of continuous bounding surfaces yields a
                                separate body for each member. Each component's exterior ring is its
                                outer wall; each interior ring is a hole through the body and
                                generates its own wall. Components shall not overlap in plan view.
                                The footprint is normally horizontal and authored as a plan-view
                                polygon, but the content model does not require it. Elevation
                                carried by the footprint's coordinates is not the volume's top or
                                bottom: the footprint supplies (x, y) only, and the bounding
                                surfaces supply elevation.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="topSurface" type="diggs:BoundingSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The upper bounding surface of the volume; for a geologic body, the
                                top of the unit. It is one continuous surface: a
                                diggs:PlanarSurface, a multi-patch diggs:MultiPlanarSurface or
                                diggs:CompositeSurface (whose patches or members share boundaries, a
                                step being a vertical member), or a diggs:TriangulatedSurface mesh;
                                not a diggs:MultiSurface. It shall extend to or beyond the footprint
                                over the footprint's whole area. The portion outside the footprint
                                is not part of the solid, which allows one authored surface to serve
                                several adjacent bodies.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="bottomSurface" type="diggs:BoundingSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The lower bounding surface of the volume; for a geologic body, the
                                base of the unit, which is commonly the top of the unit below and
                                may be the same surface object cited twice by reference. It admits
                                the same surfaces as topSurface and is subject to the same coverage
                                requirement. It may touch or cross topSurface: where it lies at or
                                above the top the body pinches out and that part of the footprint is
                                empty; see diggs:SurfaceBoundedSolid.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the volume as a whole. Uncertainty
                                specific to one bounding surface belongs on that surface's own
                                uncertainty property.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="solidMember" type="diggs:SolidMemberPropertyType">
        <annotation>
            <documentation>
                A single volume member of a diggs:CompositeSolid or diggs:MultiSolid, given inline
                or by reference with xlink:href. A volume here is any element substitutable for
                diggs:AbstractVolume: diggs:Solid, diggs:SurfaceBoundedSolid or, though unusual and
                worth a second look, a nested diggs:CompositeSolid. It corresponds to
                diggs:surfaceMember for volumes.
            </documentation>
        </annotation>
    </element>
    <complexType name="SolidMemberPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractVolume
                inline, or refers to one with xlink:href. Give either the reference or the contained
                element, not both and not neither.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:AbstractVolume"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <element name="solidMembers" type="diggs:SolidMembersArrayPropertyType">
        <annotation>
            <documentation>
                An inline array of volume members of a diggs:CompositeSolid or diggs:MultiSolid. The
                order of the members is significant and shall be preserved when processing the
                array. Prefer this form over repeated diggs:solidMember elements when every member
                is inline and the element count should stay directly readable (for example a block
                model with one value per cell). Referencing members by xlink is not supported here;
                use diggs:solidMember for that.
            </documentation>
        </annotation>
    </element>
    <complexType name="SolidMembersArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more objects that substitute for
                diggs:AbstractVolume inline. Referencing members with xlink is not supported; use
                diggs:solidMember for that.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:AbstractVolume"/>
        </sequence>
    </complexType>

    <element name="CompositeSolid" substitutionGroup="diggs:AbstractVolume"
        type="diggs:CompositeSolidType">
        <annotation>
            <documentation>
                A single connected volume assembled from one or more independently existing volume
                members that join along shared boundary faces (ISO 19107 GM_CompositeSolid): one
                body, tiled into cells that between them cover it exactly once, with no gaps and no
                overlaps. Because it is a volume, it substitutes diggs:AbstractVolume and is legal
                wherever diggs:Solid or diggs:SurfaceBoundedSolid is, including diggs:featureExtent.
                The no-gap, no-overlap condition is not machine-enforced, as elsewhere in this
                geometry family. It is intended for a body divided into cells that carry different
                property values (a fault-block model, a block model in the mining sense) while still
                behaving as one connected volume, for example for a total-volume computation or as
                the single subject of one observation. When the members are not asserted to tile one
                connected body, use diggs:MultiSolid.
            </documentation>
        </annotation>
    </element>
    <complexType name="CompositeSolidType">
        <complexContent>
            <extension base="diggs:AbstractVolumeType">
                <sequence>
                    <element ref="diggs:solidMember" minOccurs="0" maxOccurs="unbounded"/>
                    <element ref="diggs:solidMembers" minOccurs="0"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the composite solid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attributeGroup ref="gml:AggregationAttributeGroup"/>
            </extension>
        </complexContent>
    </complexType>

    <element name="MultiSolid" substitutionGroup="diggs:AbstractGeometricAggregate"
        type="diggs:MultiSolidType">
        <annotation>
            <documentation>
                A collection of volume geometries with no assumed adjacency, contiguity or tiling
                between members (ISO 19107 GM_MultiSolid): a disjoint set of bodies, such as a
                geologic unit present as several unconnected patches, or a coverage domain needing
                one value per volume. Unlike diggs:CompositeSolid, it does not behave as one solid:
                it substitutes diggs:AbstractGeometricAggregate, not diggs:AbstractVolume, so it can
                be given through diggs:location and any other diggs:AbstractGeometry property, but
                not through diggs:featureExtent. Members may overlap; nothing here asserts they do
                not. Members may be inline (solidMember or solidMembers) or cited by xlink:href to a
                volume defined elsewhere in the document. Contrast diggs:CompositeSolid, whose
                members tile one connected body.
            </documentation>
        </annotation>
    </element>
    <complexType name="MultiSolidType">
        <complexContent>
            <extension base="diggs:AbstractGeometricAggregateType">
                <sequence>
                    <element ref="diggs:solidMember" minOccurs="0" maxOccurs="unbounded"/>
                    <element ref="diggs:solidMembers" minOccurs="0"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the multi solid.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <element name="MultiCurve" substitutionGroup="diggs:AbstractGeometricAggregate" type="diggs:MultiCurveType">
        <annotation>
            <documentation>
                A geometry object that holds a collection of curve geometries.
            </documentation>
        </annotation>
    </element>
    <complexType name="MultiCurveType">
        <complexContent>
            <extension base="diggs:AbstractGeometricAggregateType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" ref="diggs:curveMembers"/>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the multi curve.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="curveMembers" type="diggs:CurveMembersArrayPropertyType">
        <annotation>
            <documentation>
                An inline array of curve members of a diggs:MultiCurve. The order of the members is
                significant and shall be preserved when processing the array.
            </documentation>
        </annotation>
    </element>
    <complexType name="CurveMembersArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more objects that substitute for
                diggs:AbstractCurve inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:AbstractCurve"/>
        </sequence>
    </complexType>
    <element name="surfaceMember" type="diggs:SurfaceMemberPropertyType">
        <annotation>
            <documentation>
                A single surface member of a diggs:CompositeSurface or diggs:MultiSurface, given
                inline or by reference with xlink:href. A surface here is any element substitutable
                for diggs:AbstractSurface; this excludes diggs:Shell, which represents the boundary
                component of a solid rather than a standalone surface.
            </documentation>
        </annotation>
    </element>
    <complexType name="SurfaceMemberPropertyType">
        <annotation>
            <documentation>
                Property type that contains one object that substitutes for diggs:AbstractSurface
                inline, or refers to one with xlink:href. Give either the reference or the contained
                element, not both and not neither.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <element ref="diggs:AbstractSurface"/>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
        <attributeGroup ref="gml:OwnershipAttributeGroup"/>
    </complexType>
    <element name="surfaceMembers" type="diggs:SurfaceMembersArrayPropertyType">
        <annotation>
            <documentation>
                An inline array of surface members of a diggs:CompositeSurface or
                diggs:MultiSurface. The order of the members is significant and shall be preserved
                when processing the array. Prefer this form over repeated diggs:surfaceMember
                elements when every member is inline and the element count should stay directly
                readable (for example a coverage domain with one value per surface). Referencing
                members by xlink is not supported here; use diggs:surfaceMember for that.
            </documentation>
        </annotation>
    </element>
    <complexType name="SurfaceMembersArrayPropertyType">
        <annotation>
            <documentation>
                Property type that contains one or more objects that substitute for
                diggs:AbstractSurface inline. Referencing members with xlink is not supported; use
                diggs:surfaceMember for that.
            </documentation>
        </annotation>
        <sequence maxOccurs="unbounded">
            <element ref="diggs:AbstractSurface"/>
        </sequence>
    </complexType>

    <element name="PlanarObservationRepresentation" substitutionGroup="diggs:AbstractGeometry"
        type="diggs:PlanarObservationRepresentationType">
        <annotation>
            <documentation>
                The planar extent, top and bottom locations of a planar surface observation. In
                practice it holds the geometries of the top and bottom surfaces of a volume of earth
                material where they contact a planar surface, such as a geologic contact or
                stratigraphic boundary, and the area (as a surface) between the two contacts.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlanarObservationRepresentationType">
        <complexContent>
            <extension base="diggs:AbstractGeometryType">
                <sequence>
                    <element name="layerTopIntersection" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The line where the top surface of a layer (a volume of earth
                                material) intersects a planar sampling feature.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="layerBaseIntersection" type="diggs:LinearExtentPropertyType">
                        <annotation>
                            <documentation>
                                The location of the basal surface of a layer (a volume of earth
                                material) that intersects a planar sampling feature. Depending on
                                how the planar sampling feature is encoded, several line strings may
                                define this basal surface.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="representativeSurface"
                        type="diggs:SurfacePropertyType">
                        <annotation>
                            <documentation>
                                A polygon that represents the layer volume in the plane of the
                                planar sampling feature. It is typically a ring polygon whose curve
                                members are the layer top intersection, the layer bottom
                                intersection and two edges normally at the lateral extent of the
                                planar feature. Repeat for each polygon.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>

    <!-- ================================================================================= -->
    <!-- DEPRECATED ELEMENTS                                                                  -->
    <!-- ================================================================================= -->

    <element name="planarReferencing" type="diggs:LocalReferencingPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    replacedBy="diggs:LocalCartesianCRS"
                    note="a diggs:LocalCartesianCRS declared in DocumentInformation/crs"/>
            </appinfo>
            <documentation>DEPRECATED. Use a diggs:LocalCartesianCRS declared in
                DocumentInformation/crs. The local coordinate reference system of a planar feature
                that uses relative coordinates.</documentation>
        </annotation>
    </element>

    <element name="volumeReferencing" type="diggs:LocalReferencingPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    replacedBy="diggs:LocalCartesianCRS"
                    note="a diggs:LocalCartesianCRS declared in DocumentInformation/crs"/>
            </appinfo>
            <documentation>DEPRECATED. Use a diggs:LocalCartesianCRS declared in
                DocumentInformation/crs, named in the srsName of the geometry held by featureExtent.
                The local coordinate reference system of a volumetric feature that uses relative
                coordinates.</documentation>
        </annotation>
    </element>

    <complexType name="LocalReferencingPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.0.0"
                    replacedBy="diggs:LocalCartesianCRS"
                    note="a diggs:LocalCartesianCRS declared in DocumentInformation/crs"/>
            </appinfo>
            <documentation>
                DEPRECATED. Use a diggs:LocalCartesianCRS declared in DocumentInformation/crs.
                Property type associating a planar or volume engineering coordinate reference system
                with a feature.
            </documentation>
        </annotation>
        <sequence minOccurs="0">
            <choice>
                <element ref="diggs:VectorLinearSpatialReferenceSystem"/>
                <element ref="diggs:LocalCartesianCRS"/>
            </choice>
        </sequence>
        <attributeGroup ref="gml:AssociationAttributeGroup"/>
    </complexType>

    <element name="referenceEdge" type="diggs:LinearExtentPropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="the x-axis definition of a diggs:LocalCartesianCRS"/>
            </appinfo>
            <documentation>DEPRECATED. Use the x-axis definition of a diggs:LocalCartesianCRS. A
                line, in the same absolute CRS, defining one edge (usually the top or bottom) of the
                sampling feature's surface.</documentation>
        </annotation>
    </element>

    <element name="relativeFeatureBoundary" type="diggs:SurfacePropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    replacedBy="diggs:featureExtent"
                    note="with its geometry in a spatial CRS or a diggs:LocalCartesianCRS"/>
            </appinfo>
            <documentation>DEPRECATED. Use featureExtent, whose geometry may use a spatial CRS or a
                diggs:LocalCartesianCRS. The extent of a planar feature in a relative planar
                referencing system.</documentation>
        </annotation>
    </element>

    <element name="relativeFeatureExtent" type="diggs:VolumePropertyType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    replacedBy="diggs:featureExtent"
                    note="with its geometry in a spatial CRS or a diggs:LocalCartesianCRS"/>
            </appinfo>
            <documentation>DEPRECATED. Use featureExtent, whose geometry may use a spatial CRS or a
                diggs:LocalCartesianCRS. The extent of a volumetric feature in a relative
                referencing system.</documentation>
        </annotation>
    </element>
    <!-- ================================================================================= -->
    <!-- TRIANGULATED SURFACE - v 3.1 addition (planar-triangle-mesh equivalent of gml:TriangulatedSurface)  -->
    <!-- Parallels MultiPlanarSurface/PlanarSurfacePatch exactly: extends diggs:AbstractSurfaceType -->
    <!-- and substitutes diggs:AbstractSurface, so it's automatically usable anywhere        -->
    <!-- PlanarSurface/MultiPlanarSurface already are today (arealExtent's SurfacePropertyType -->
    <!-- choice, a Solid's Shell surfaceMember, etc.) — no other schema changes needed.       -->
    <!-- (Corrected S32f, 2026-09: diggs:AbstractSurface does NOT itself substitute           -->
    <!-- gml:AbstractSurface - it substitutes diggs:AbstractGeometricPrimitive, which         -->
    <!-- substitutes diggs:AbstractGeometry, which substitutes gml:AbstractGeometry. Since    -->
    <!-- S32e, diggs:AbstractSurfaceType does TYPE-DERIVE from gml:AbstractSurfaceType, which  -->
    <!-- is the separate, correct sense in which this family now carries real GML identity.)-->
    <!-- ================================================================================= -->

    <element name="TriangulatedSurface" substitutionGroup="diggs:AbstractSurface"
        type="diggs:TriangulatedSurfaceType">
        <annotation>
            <documentation>
                A single contiguous surface composed exclusively of planar triangular patches
                (diggs:TrianglePatch). Unlike diggs:MultiPlanarSurface, whose arbitrary polygon
                patches must each be verified as coplanar, every patch has exactly three vertices
                and is planar by construction. It is intended for an inherently irregular
                (non-planar) surface, such as a geologic contact, stratigraphic boundary or other
                soil or rock model bounding surface, as a triangulated mesh, typically as one of the
                faces (diggs:Shell surfaceMembers) of a diggs:Solid soil-model volume. Each patch
                shall share an edge with an adjacent patch to form a continuous surface, the same
                connectivity requirement as diggs:MultiPlanarSurface.
            </documentation>
        </annotation>
    </element>

    <complexType name="TriangulatedSurfaceType">
        <complexContent>
            <extension base="diggs:AbstractSurfaceType">
                <sequence>
                    <element ref="gml:patches">
                        <annotation>
                            <documentation>
                                The triangle patches of the surface. Every member is expected to be
                                a diggs:TrianglePatch; this is by convention only, as for the
                                patches of gml:TriangulatedSurface.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the surface.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>


    <element name="TrianglePatch" substitutionGroup="gml:AbstractSurfacePatch"
        type="diggs:TriangulatedSurfacePatchType">
        <annotation>
            <documentation>
                A single planar triangle that is one patch of a diggs:TriangulatedSurface. It is the
                triangle-only counterpart of diggs:PlanarSurfacePatch: exactly one required exterior
                boundary (no interior rings, since a triangle has no holes), whose ring shall be a
                gml:LinearRing with exactly four positions (three distinct corners, the first and
                last coincident), the convention gml:Triangle uses. This is not machine-enforced by
                the content model.
            </documentation>
        </annotation>
    </element>
    <complexType name="TriangulatedSurfacePatchType">
        <complexContent>
            <extension base="gml:AbstractSurfacePatchType">
                <sequence>
                    <element ref="gml:exterior">
                        <annotation>
                            <documentation>
                                The exterior boundary of the triangle. It is required, unlike the
                                optional exterior of diggs:PlanarSurfacePatch, and is a 3-sided ring
                                of 4 positions, the first equal to the last.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="uncertainty"
                        type="diggs:LocationUncertaintyPropertyType">
                        <annotation>
                            <documentation>
                                The positional uncertainty of the triangle patch.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
                <attribute fixed="planar" name="interpolation" type="gml:SurfaceInterpolationType">
                    <annotation>
                        <documentation>
                            The interpolation of the patch, fixed at planar.
                        </documentation>
                    </annotation>
                </attribute>
            </extension>
        </complexContent>
    </complexType>


</schema>
