<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">

    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element name="ColorObservation" type="diggs:ColorObservationType" substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A description of the color of the material encountered over one zone or interval.
                Several colors can be described within a single observation.
            </documentation>
        </annotation>
    </element>
    <complexType name="ColorObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ColorObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:ColorObservation"/>
        </sequence>
    </complexType>
    <complexType name="ColorObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element minOccurs="0" name="colorCharacter"
                        type="diggs:ColorCharacterEnumExtType">
                        <annotation>
                            <documentation>
                                The character of the color or colors observed: how multiple colors,
                                if any, are distributed within the zone. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="color" type="diggs:ColorPropertyType">
                        <annotation>
                            <documentation>
                                A color observed in the zone or interval. Repeat for each distinct
                                color, using the rank attribute of diggs:Color to show relative
                                significance.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval, as defined in the observation's location property. For a
                                planar or volume location, repeat the element where the character of
                                the boundary changes along its length or surface.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ColorSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:ColorSystemType">
        <annotation>
            <documentation>
                A system of color observations along or within a sampling feature. Observations
                within the system must not overlap.
            </documentation>
        </annotation>
    </element>
    <complexType name="ColorSystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element minOccurs="0" name="colorType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of color description system used, for example "Munsell
                                Color" or "wet color". No DIGGS-authored dictionary currently exists
                                for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="colorObservation"
                        type="diggs:ColorObservationPropertyType">
                        <annotation>
                            <documentation>
                                A color observation within the system. Repeat once for each zone or
                                interval described.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ConstituentObservation" type="diggs:ConstituentObservationType" substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A description of the details of earth materials encountered within a sampling
                feature. Constituents restricted to a specific lithologic zone are instead encoded
                as constituent properties of the diggs:Lithology zone itself.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConstituentObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ConstituentObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:ConstituentObservation"/>
        </sequence>
    </complexType>
    <complexType name="ConstituentObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element maxOccurs="unbounded" name="constituent"
                        type="diggs:ConstituentPropertyType">
                        <annotation>
                            <documentation>
                                A constituent of the earth material in the observed zone or
                                interval, such as a fossil or a diagenetic feature. Repeat for each
                                constituent.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval, as defined in the observation's location property. Only
                                one baseBoundary may be given.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ConstituentSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:ConstituentSystemType">
        <annotation>
            <documentation>
                A system of constituent observations. Observations need not be continuous and may
                overlap, but zones with the same named constituents must not overlap.
            </documentation>
        </annotation>
    </element>
    <complexType name="ConstituentSystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="constituentType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of constituent description the system contains, for example
                                "Fossils" or "Diagenesis". No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="constituentObservation"
                        type="diggs:ConstituentObservationPropertyType">
                        <annotation>
                            <documentation>
                                A constituent observation within the system. Repeat once for each
                                zone or interval described.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="OrientationObservation" type="diggs:OrientationObservationType" substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                A description of the geometry of vectors or planar surfaces encountered at a
                sampling feature, such as bedding, joints or cross-beds, characterizing regions of
                generalized geometry. Individual measurements of the planes of boundaries or faults
                are recorded in diggs:DiscontinuityObservation or diggs:Lithology instead.
            </documentation>
        </annotation>
    </element>
    <simpleType name="OrientationObsPropertyEnumType">
        <union>
            <simpleType>
                <restriction base="string">
                    <enumeration value="bedding">
                        <annotation>
                            <documentation>
                                Orientations of bedding: the layering of sediments or sedimentary
                                rock.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="cross-bedding">
                        <annotation>
                            <documentation>
                                Orientations of cross-bedding: inclined layers within a bed that lie
                                at an angle to the main bedding.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="faults">
                        <annotation>
                            <documentation>
                                Orientations of faults: fractures along which the rock on either
                                side has been displaced.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="joints">
                        <annotation>
                            <documentation>
                                Orientations of joints: fractures along which there has been no
                                appreciable displacement.
                            </documentation>
                        </annotation>
                    </enumeration>
                    <enumeration value="fractures">
                        <annotation>
                            <documentation>
                                Orientations of fractures, meaning breaks in the rock mass, that are
                                not described as joints or faults.
                            </documentation>
                        </annotation>
                    </enumeration>
                </restriction>
            </simpleType>
            <simpleType>
                <restriction base="string">
                    <pattern value="Other: .{2,}"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>
    <complexType name="OrientationObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element name="orientation" type="diggs:OrientationPropertyType">
                        <annotation>
                            <documentation>
                                The orientation of the feature, as strike or bearing and dip or
                                plunge.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval, as defined in the observation's location property. Only
                                one baseBoundary may be given.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="OrientationSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:OrientationSystemType">
        <annotation>
            <documentation>
                A system of orientation observations. Observations within the system must not
                overlap.
            </documentation>
        </annotation>
    </element>
    <complexType name="OrientationSystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="orientationFeatureType"
                        type="diggs:OrientationObsPropertyEnumType">
                        <annotation>
                            <documentation>
                                The type of planar feature whose orientations the system describes,
                                for example faults or bedding. Values come from the enumerated list,
                                or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="orientationFeatureObservation"
                        type="diggs:OrientationObservationPropertyType">
                        <annotation>
                            <documentation>
                                An orientation observation within the system. Repeat once for each
                                zone or interval described.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="OrientationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:Orientation object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:Orientation"/>
        </sequence>
    </complexType>
    <element name="Orientation" type="diggs:OrientationType">
        <annotation>
            <documentation>
                The orientation of bedding, a fracture or a zone, given as a strike or bearing and a
                dip or plunge.
            </documentation>
        </annotation>
    </element>
    <complexType name="OrientationObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:OrientationObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:OrientationObservation"/>
        </sequence>
    </complexType>
    <complexType name="OrientationType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="strikeOrBearing" type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The true bearing of the feature, if linear, or the strike of the
                                plane, measured from north (range 0-360), where 0 is north and 90 is
                                east.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dipOrPlunge" type="diggs:DipMeasureType">
                        <annotation>
                            <documentation>
                                The inclination of the feature measured positive downward from
                                horizontal, where 0 is horizontal and 90 is vertically down. Set the
                                apparent attribute to true if the value is an apparent dip rather
                                than a true dip.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="OtherObservation" type="diggs:OtherObservationType" substitutionGroup="diggs:AbstractObservation">
        <annotation>
            <documentation>
                An observation of a kind not covered by the other observation types, described by
                name-value pairs whose names should reference a dictionary. Because the description
                is open, no validation rules apply beyond those defined for a specific use case.
            </documentation>
        </annotation>
    </element>
    <complexType name="OtherObservationPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:OtherObservation object inline.
            </documentation>
        </annotation>
        <sequence maxOccurs="1">
            <element maxOccurs="1" ref="diggs:OtherObservation"/>
        </sequence>
    </complexType>
    <element name="OtherObservationSystem" substitutionGroup="diggs:AbstractObservationSystem"
        type="diggs:OtherObservationSystemType">
        <annotation>
            <documentation>
                A system of diggs:OtherObservation objects of the kind named by otherSystemType.
            </documentation>
        </annotation>
    </element>
    <complexType name="OtherObservationType">
        <complexContent>
            <extension base="diggs:AbstractObservationType">
                <sequence>
                    <element maxOccurs="unbounded" name="property"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A named parameter and its value describing the observed zone or
                                interval. Repeat for each parameter observed.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" ref="diggs:placedObservation"/>
                    <element minOccurs="0" ref="diggs:baseBoundary">
                        <annotation>
                            <documentation>
                                Description of the boundary at the base of the observed zone or
                                interval, as defined in the observation's location property. Only
                                one baseBoundary may be given.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="OtherObservationSystemType">
        <complexContent>
            <extension base="diggs:AbstractObservationSystemType">
                <sequence>
                    <element name="otherSystemType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The kind of observation described by the system. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" name="otherObservation"
                        type="diggs:OtherObservationPropertyType">
                        <annotation>
                            <documentation>
                                An observation within the system. Repeat once for each zone or
                                interval described.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
</schema>
