<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.0.0">


    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element name="DynamicProbeTest" type="diggs:DynamicProbeTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An object describing a driven penetration test procedure. The Driven
                Penetration Test includes all methods that involve driving a rod (with or without a
                sampler) by impact hammer. The most common test of this type inclue the Standard
                Penetration Test and the Becker Hammer Test.</documentation>
        </annotation>
    </element>
    <complexType name="DynamicProbeTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for dynamic probe test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="penetrationTestType" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of penetration test performed.</documentation>
                        </annotation>
                    </element>
                    <element name="hammerType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>The type of hammer used for the sampling and penetration,
                                including the mechanism used to lift and drop the hammer assembly.
                                Additional details about the sampler (e.g. cathead diameter, number
                                of turns, etc) can be mapped to the equipment
                                object.</documentation>
                        </annotation>
                    </element>
                    <element name="hammerMass" type="diggs:MassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The hammer mass used to drive the
                                sampler.</documentation>
                        </annotation>
                    </element>
                    <element name="hammerDropHeight" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The hammer drop height.</documentation>
                        </annotation>
                    </element>
                    <element name="hammerEfficiency" type="diggs:DimensionlessMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>A description of the energy efficiency of the hammer.
                                Also known as energy ratio.</documentation>
                        </annotation>
                    </element>
                    <element name="samplerLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The length of the sampler barrel.</documentation>
                        </annotation>
                    </element>
                    <element name="samplerInternalDiameter" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>The inside diameter of the sampler.</documentation>
                        </annotation>
                    </element>
                    <element name="samplerLinerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>A description of the liner, if used.</documentation>
                        </annotation>
                    </element>
                    <element name="samplerRetainerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>A description of the basket retainer, if
                                used.</documentation>
                        </annotation>
                    </element>
                    <element name="rodType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>The type of sampling rods used for
                                penetration.</documentation>
                        </annotation>
                    </element>
                    <element name="rodExternalDiameter" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The external diameter of the sampling
                                rods.</documentation>
                        </annotation>
                    </element>
                    <element name="rodSectionLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The drive rod weight per unit length.</documentation>
                        </annotation>
                    </element>
                    <element name="rodWeight" type="diggs:ForcePerLengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The drive rod weight per unit length.</documentation>
                        </annotation>
                    </element>
                    <element name="depthCasing" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Casing depth at time of test</documentation>
                        </annotation>
                    </element>
                    <element name="selfWeightPenetration" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>The distance the sampler penetrates the soil under its
                                own weight before applying hammer blows</documentation>
                        </annotation>
                    </element>
                    <element name="waterDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Depth to water at time of test.</documentation>
                        </annotation>
                    </element>
                    <element name="totalPenetration" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Total distance the sampler penetrated the soil following
                                completion of the procedure</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FlatPlateDilatometerTest" type="diggs:FlatPlateDilatometerTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An object describing a flat plate dilatometer test procedure. This test
                consists of forcing the dilatometer blade into the soil, with the membrane facing
                the horizontal direction, to a desired test penetration, measuring the thrust to
                accomplish this penetration and then using gas pressure to expand a circular steel
                membrane located on one side of the blade. The operator measures and records the
                pressure required to produce expansion of the membrane into the soil at two preset
                deflections. The operator then deflates the membrane, possibly recording an optional
                third measurement, advances the blade the desired penetration increment and repeats
                the test. </documentation>
        </annotation>
    </element>
    <complexType name="FlatPlateDilatometerTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for flat plate dilatometer test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="bladeThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The blade thickness property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bladeWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The blade width property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaA" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The gauge gas pressure inside the membrane (corrected for
                                Zm) required to overcome the stiffness of the membrane and move it
                                inward to a center-expansion of 0.05 mm (a negative gauge or suction
                                pressure, but recorded as positive) with only ambient atmospheric
                                pressure acting externally. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaB" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The gauge gas pressure inside the membrane (corrected for
                                Zm) required to overcome the stiffness of the membrane and move it
                                outward to a center-expansion of 1.10 mm against only the ambient
                                atmospheric pressure. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of thin flat dilatometer circular steel membrane
                                used for testing. Typical types include soft, standard and
                                hard.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionReducerDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The diameter of the friction reducer.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionReducerLocation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The distance of the friction reducer relative to the
                                center of the dilatometer membrane.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rodDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The rod diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rodLinearWeight"
                        type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>The rod linear weight property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="zm" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The gauge pressure deviation from zero when vented to
                                atmospheric pressure (an offset used to correct pressure readings to
                                the true gauge pressure). </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituCBRTest" type="diggs:InsituCBRTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An object describing an in-situ California bearing ratio test procedure.
                The California bearing ratio (CBR) is a penetration test for evaluation of the
                mechanical strength of road subgrades and basecourses. The test is performed by
                measuring the pressure required to penetrate a soil sample with a plunger of
                standard area. The measured pressure is then divided by the pressure required to
                achieve an equal penetration on a standard crushed rock material.</documentation>
        </annotation>
    </element>
    <complexType name="InsituCBRTestType">
        <annotation>
            <documentation>Base type for InsituCBRTest</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="penetrationIncrement"
                        type="diggs:CBRIncrementPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The penetration increment property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diameter of the penetration piston</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="reactionLoadDescription" type="string">
                        <annotation>
                            <documentation>Description of the type of weight used for the reaction
                                load</documentation>
                        </annotation>
                    </element>
                    <element name="seatingForce" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Force of reaction system.</documentation>
                        </annotation>
                    </element>
                    <element name="surchargePressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Load imposed by surchage from test
                                equipment.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="InSituPenetrometerTest"
        substitutionGroup="diggs:AbstractInsituTestProcedure"
        type="diggs:InSituPenetrometerTestType">
        <annotation>
            <documentation>This test provides an estimate of undrained shear
                strength.</documentation>
        </annotation>
    </element>
    <complexType name="InSituPenetrometerTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for in situ penetrometer test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="reading"
                        type="diggs:ReadingMeasureType">
                        <annotation>
                            <documentation>The reading property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituPermeabilityTest" type="diggs:InsituPermeabilityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>This test determines the insitu permeability of a soil based on constant
                head, falling head, and packer test methods.</documentation>
        </annotation>
    </element>
    <complexType name="InsituPermeabilityTestType">
        <annotation>
            <documentation>Base type for InsituPermeabilityTest</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="permeabilityTestType" type="gml:CodeType" default="false"
                        minOccurs="0">
                        <annotation>
                            <documentation>Type of permeability test.</documentation>
                        </annotation>
                    </element>
                    <element name="depthTestZoneTop" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Depth to the top of the test zone</documentation>
                        </annotation>
                    </element>
                    <element name="depthTestZoneBottom" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Depth to the bottom of the test zone</documentation>
                        </annotation>
                    </element>
                    <element name="stage" type="integer" minOccurs="0">
                        <annotation>
                            <documentation>Stage number of multistage packer test.</documentation>
                        </annotation>
                    </element>
                    <element name="depthWaterPreTest" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Depth to water in borehole or piezometer immediately
                                prior to test.</documentation>
                        </annotation>
                    </element>
                    <element name="diameterTestZone" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Diameter of test zone.</documentation>
                        </annotation>
                    </element>
                    <element name="diameterCasing" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Diameter of standpipe or casing.</documentation>
                        </annotation>
                    </element>
                    <element name="averageFlow" type="diggs:VolumePerTimeMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Average flow during packer test stage.</documentation>
                        </annotation>
                    </element>
                    <element name="depthStandingWater" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Depth to assumed standing water level.</documentation>
                        </annotation>
                    </element>
                    <element name="appliedHead" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Applied total head of water during test stage at centre
                                of packer test zone.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituResistivityTest" type="diggs:InsituResistivityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>This test determines the insitu resistivity of a soil.</documentation>
        </annotation>
    </element>
    <complexType name="InsituResistivityTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for insitu resistivity test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testType" type="gml:CodeType">
                        <annotation>
                            <documentation>The type of insitu test conducted. Intended to come from
                                a controlled list of terms. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodeSpacing" type="gml:CodeType">
                        <annotation>
                            <documentation>Average electrode spacing</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituVaneTest" abstract="false" type="diggs:InsituVaneTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An object describing an in-situ vahe shear test procedure. This test
                gives the in place shearing resistance of soft, saturated clays.</documentation>
        </annotation>
    </element>
    <complexType name="InsituVaneTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for insitu vane test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="intactVaneTest" type="diggs:VaneTestPropertyType">
                        <annotation>
                            <documentation>Vane shear test parameters in intact soil</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="remoldedVaneTest" type="diggs:VaneTestPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>Vane shear test parameters in remolded
                                soil</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="torqueRodFriction" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>Measure of the friction of the torque rod; measured as
                                friction above the slip coupling or as blank rod friction where rod
                                is in direct contact with the soil.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneBladeThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The vane blade thickness property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneDepthBelow" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Vane depth beneath housing or bottom of hole. This is a
                                vector length measure describing the difference in the hole or
                                housing bottom and the test location.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The vane diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The vane height property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneShaftDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The vane shaft diameter property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneSystemType" type="gml:CodeType">
                        <annotation>
                            <documentation>Type of vane system, eg. slip coupling, no slip coupling,
                                vane shoe push/drill, etc. Intended to come from a controlled list
                                of terms.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneTaperAngleBottom"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>The vane taper angle bottom property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneTaperAngleTop"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>The vane taper angle top property.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneType" type="diggs:VaneEnumTypeExt">
                        <annotation>
                            <documentation>The type of vane, from the following controlled list:
                                double tapered, single tapered, rectangular. Can also use other:xxx
                                to define a new type.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="VaneEnumTypeExt">
        <annotation>
            <documentation>Union type for vane enum type ext. Accepts values from OtherNameType or VaneEnumType.</documentation>
        </annotation>
        <union memberTypes="diggs:OtherNameType diggs:VaneEnumType"/>
    </simpleType>
    <simpleType name="VaneEnumType">
        <annotation>
            <documentation>Enumeration defining vane enum type values. Contains 3 allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="double tapered">
                <annotation>
                    <documentation>double tapered - double tapered value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="rectangular">
                <annotation>
                    <documentation>rectangular - rectangular value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="single tapered">
                <annotation>
                    <documentation>single tapered - single tapered value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="LugeonTest" type="diggs:LugeonTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An in-situ testing method widely used to estimate the average hydraulic
                conductivity of rock formations. The test is also referred to as a "water pressure
                test" or a "packer test". </documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="LugeonTestType">
        <annotation>
            <documentation>Extended type based on AbstractInsituTestProcedureType. Adds elements for lugeon test type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="depthToGroundWater" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Distance from ground surface to the top of the saturated
                                zone (water table)</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureMeasurementConfiguration"
                        type="diggs:pressureMeasurementConfigurationEnumType">
                        <annotation>
                            <documentation>Describes how pressure is measured during the test; from
                                a controlled list. Allowed values are: - pressure gauge - borehole
                                transducer</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureGaugeHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Height above ground surface to the pressure gauge
                                location, if pressure gauge is used instead of a borehole
                                transducer</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pMax" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>The maximum test pressure, defined so that it does not
                                exceed the in-situ minimum stress, thus avoiding hydraulic
                                fracturing.</documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="lugeonStep"
                        type="diggs:LugeonStepPropertyType">
                        <annotation>
                            <documentation>Contains properties for each step of the lugeeon test run
                                at various injection pressures. There are typically five steps in a
                                lugeon test. </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LugeonStepPropertyType">
        <annotation>
            <documentation>Property type for lugeon step references. Used to wrap lugeon step objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:LugeonStep"/>
        </sequence>
    </complexType>
    <element name="LugeonStep" type="diggs:LugeonStepType">
        <annotation>
            <documentation>An object that carries properties for a Lugeon test step</documentation>
        </annotation>
    </element>
    <complexType name="LugeonStepType">
        <annotation>
            <documentation>Extended type based on AbstractObjectType. Adds elements for lugeon step type definition.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" name="lugeonStepNumber" type="positiveInteger">
                        <annotation>
                            <documentation>The number of this step, with 1 representing the first
                                step, 2 the second step, etc.</documentation>
                        </annotation>
                    </element>
                    <element name="pressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>The target pressure for the step</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="avgFlowRate" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>The average flow rate for the step, derived from the flow
                                measurements recorded in the step time series. </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coeffPermeability"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>The coefficient of permeability (also known as hydraulic
                                conductivity) computed from the step measurements. This value is
                                averaged with other step results and is reported as one of the
                                primary test results </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lugeonValue"
                        type="diggs:VolumePerTimePerPressureLengthMeasureType">
                        <annotation>
                            <documentation>The Lugeon value, a measure of hydraulic conductivity in
                                rock, as computed from the step measurements. This value is averaged
                                with other step results and is reported as one of the primary test
                                results </documentation>
                        </annotation>
                    </element>
                    <element name="lugeonStepTimeSeries"
                        type="diggs:LugeonStepTimeSeriesPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>Property that contains the recorded flow for the test
                                step.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalElapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>The total elapsed time for the step; this is typically 10
                                minutes, but could be different if steady-state flow
                                occurs</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalVolumeWater" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>The total volume of water pumped into the borehole during
                                this step</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LugeonStepTimeSeriesPropertyType">
        <annotation>
            <documentation>Property type holding a grout stage time series</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TemporalResult"/>
        </sequence>
    </complexType>
    <simpleType name="pressureMeasurementConfigurationEnumType">
        <annotation>
            <documentation>Enumeration defining pressure measurement configuration enum type values. Contains 2 allowed value(s).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="pressure gauge">
                <annotation>
                    <documentation>pressure gauge - pressure gauge value.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="borehole transducer">
                <annotation>
                    <documentation>borehole transducer - borehole transducer value.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="PressuremeterTest" type="diggs:PressuremeterTestProcedureType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>The Pressuremeter measures both the strength and stress-strain properties
                of all soil types including soft rock. The pressuremeter is used primarily to
                calculate bearing capacity of shallow and deep foundations; settlement of
                foundations; deformation of laterally loaded and sheet piles and resistance of
                anchors</documentation>
        </annotation>
    </element>
    <complexType name="PressuremeterTestProcedureType">
        <annotation>
            <documentation>Base type for PressuremeterTest</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="pressuremeterType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>The type of pressuremeter.</documentation>
                        </annotation>
                    </element>
                    <element name="pressuremeterDiameter" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>The uninflated diameter of the
                                pressuremeter.</documentation>
                        </annotation>
                    </element>
                    <element name="trial" type="diggs:PressuremeterTestTrialPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>The trial property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PressuremeterTestTrial" type="diggs:PressuremeterTestTrialType" abstract="false">
        <annotation>
            <documentation>Results for each trial in PressuremeterTest</documentation>
        </annotation>
    </element>
    <complexType name="PressuremeterTestTrialPropertyType">
        <annotation>
            <documentation>Property for PressuremeterTestTrials, required parent element that holds
                the multiple trials.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:PressuremeterTestTrial" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="PressuremeterTestTrialType">
        <annotation>
            <documentation>Base type for PressuremeterTestTrials</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="trialNo" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>Pressuremeter loading or reloading cycle.</documentation>
                        </annotation>
                    </element>
                    <element name="shearModulus" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Unload or reload shear modulus for the
                                cycle.</documentation>
                        </annotation>
                    </element>
                    <element name="meanStrain" type="double" minOccurs="0">
                        <annotation>
                            <documentation>Mean strain.</documentation>
                        </annotation>
                    </element>
                    <element name="strainRange" type="double" minOccurs="0">
                        <annotation>
                            <documentation>Strain range or amplitude.</documentation>
                        </annotation>
                    </element>
                    <element name="meanPressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Mean pressure.</documentation>
                        </annotation>
                    </element>
                    <element name="pressureRange" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>Pressure range or amplitude.</documentation>
                        </annotation>
                    </element>
                    <element name="linearity" type="double" minOccurs="0">
                        <annotation>
                            <documentation>Linearity exponent (from Bolton and Whittle,
                                1999)</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PumpingTest" type="diggs:PumpingTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>An aquifer test (or a pumping test) is conducted to evaluate an aquifer
                by "stimulating" the aquifer through constant pumping, and observing the aquifer's
                "response" (drawdown) in observation wells.</documentation>
        </annotation>
    </element>
    <complexType name="PumpingTestType">
        <annotation>
            <documentation>Base type for PumpingTest</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="averagePumpingRate"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>The average pumping rate property.</documentation>
                        </annotation>
                    </element>
                    <element name="pumpingTestTimeSeries"
                        type="diggs:PumpingTestTimeSeriesPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>The pumping test time series property.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="StaticLoadTest" type="diggs:StaticLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>A maintained-load or constant-rate-of-penetration axial compressive load
                test applied directly to a deep foundation element, per ASTM D1143/D1143M or EN ISO
                22477-1 (or their national equivalents - see loadingProcedure).

                MULTI-STANDARD BY DESIGN. ASTM D1143 names seven loading procedures (Quick Test,
                Maintained Test, Loading in Excess of Maintained Test, Constant Time Interval,
                Constant Rate of Penetration, Constant Movement Increment, Cyclic Loading); EN ISO
                22477-1 covers only the maintained-load family and explicitly excludes the
                constant-rate-of-penetration and cyclic variants. loadingProcedure's vocabulary
                (staticLoadTestProcedure.xml) carries all of ASTM's named options; its
                maintained_load entry is the value both traditions share, and is what an EN ISO
                22477-1 (or ASIRI-governed) test states regardless of which of ASTM's other six
                options it has no equivalent for. Cite the governing standard itself through the
                inherited testProcedureMethod, not through this element - loadingProcedure names the
                loading METHOD, testProcedureMethod names the STANDARD that specifies
                it.</documentation>
        </annotation>
    </element>
    <complexType name="StaticLoadTestType">
        <annotation>
            <documentation>Base type for StaticLoadTest.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="loadingProcedure" type="gml:CodeType">
                        <annotation>
                            <documentation>The loading procedure used, from
                                staticLoadTestProcedure.xml. See this element's own documentation
                                above for how the vocabulary spans both the ASTM and EN ISO
                                traditions.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RapidLoadTest" type="diggs:RapidLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>An axial compressive force-pulse (rapid) load test applied directly to a
                deep foundation element, per ASTM D7383 or EN ISO 22477-10 - a loading duration
                (tens to a few hundred milliseconds) between the seconds-to-minutes timescale of
                diggs:StaticLoadTest and the millisecond-or-shorter timescale of
                diggs:DynamicLoadTest, requiring the inertial/damping correction analysisMethod
                names rather than the load-settlement reading a static test takes directly.

                MULTI-STANDARD BY DESIGN. EN ISO 22477-10 classifies a rapid test by its purpose -
                an investigation test (a sacrificial pile loaded to ultimate limit state) or a
                control test (a working pile loaded to a specified load above serviceability limit
                state) - a distinction ASTM D7383 does not name; testCategory carries it where it
                applies and is left absent where it does not. analysisMethod's two named values
                (the Unloading Point Method and its Modified form) are the interpretation techniques
                both standards' practitioner communities use to derive an equivalent static
                capacity from the measured force-pulse data; neither standard body treats them as
                proprietary to the other.</documentation>
        </annotation>
    </element>
    <complexType name="RapidLoadTestType">
        <annotation>
            <documentation>Base type for RapidLoadTest.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testCategory" type="gml:CodeType">
                        <annotation>
                            <documentation>Investigation test or control test, from
                                rapidLoadTestCategory.xml - the EN ISO 22477-10 classification by
                                test purpose. See this element's own documentation
                                above.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pulseDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>Duration of the applied force pulse.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="analysisMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>The method used to derive an equivalent static
                                load-displacement response from the measured force-pulse data, from
                                rapidLoadTestAnalysisMethod.xml (Unloading Point Method / Modified
                                Unloading Point Method / other).</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DynamicLoadTest" type="diggs:DynamicLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>A high-strain dynamic load test applied directly to a deep foundation
                element by hammer impact, per ASTM D4945 or EN ISO 22477-4.

                MULTI-STANDARD BY DESIGN, AND WIDER UNDER ISO THAN UNDER ASTM. ASTM D4945 is
                specifically strain-and-acceleration ("PDA") impact testing, almost always paired in
                US practice with CAPWAP or an equivalent signal-matching analysis (a form of wave
                equation analysis) to derive static capacity. EN ISO 22477-4 names four distinct
                methods under one standard - dynamic impact testing (the ASTM D4945 method), driving
                formulae, wave equation analysis, and multi-blow dynamic testing (deriving capacity
                from a series of blows at different displacement/velocity levels) - and testMethod's
                vocabulary (dynamicLoadTestMethod.xml) carries all four plus signal_matching for the
                CAPWAP-style companion analysis ASTM practice names separately from the base impact
                method.

                DELIBERATELY NOT WIRED TO diggs:PDARecordType (specialty/DeepFoundation.xsd). That
                type is a purpose-built structured PDA record, but it hangs off
                PileDrivingActivityType/pdaRecord - a construction-activity property - not off
                Test/outcome, which a post-construction verification test on a completed element
                needs. Reusing it would require widening its reach across a specialty boundary for a
                generic capability; the generic route (this procedure plus Test/outcome's ResultSet
                carrying dictionary-bound force/velocity/capacity values, exactly as every other load
                test on this tab already works) needs no such change and is what is built here. See
                docs/RI_Post_Installation_Parameter_Analysis.md P5 for the full
                reasoning.</documentation>
        </annotation>
    </element>
    <complexType name="DynamicLoadTestType">
        <annotation>
            <documentation>Base type for DynamicLoadTest.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>The method used to derive pile resistance, from
                                dynamicLoadTestMethod.xml. See this element's own documentation
                                above for the ASTM/EN ISO correspondence.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hammerEnergy" type="diggs:EnergyMeasureType">
                        <annotation>
                            <documentation>The rated or observed energy delivered by the impact
                                hammer for the blow(s) tested. The hammer itself, where a typed
                                record is wanted beyond this scalar, is carried through the inherited
                                testProcedureEquipment.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LoadTestIncrement" type="diggs:LoadTestIncrementType" abstract="false"
        substitutionGroup="diggs:AbstractProcedureTrial">
        <annotation>
            <documentation>One load increment applied during a load test - the procedure's planned
                or as-executed schedule, not the measured readings taken at it (those belong on
                Test/outcome's ResultSet, per diggs:AbstractLoadTestProcedure's own
                documentation).

                TWO ALTERNATIVE HOLD-CRITERION FIELDS, BY DESIGN, NOT REDUNDANTLY. holdDuration (a
                fixed clock time) is how ASTM's Quick Test and Constant Time Interval procedures
                define when to advance to the next increment; stabilizationCriterion (a rate of
                movement) is how EN ISO 22477-1's maintained-load method and ASTM's own Maintained
                Test define it instead. A given increment states whichever criterion its governing
                procedure actually uses and leaves the other absent - they are not two ways of
                recording the same fact, they are the two different rules a loading procedure can
                specify.</documentation>
        </annotation>
    </element>
    <complexType name="LoadTestIncrementType">
        <annotation>
            <documentation>Extended type based on AbstractProcedureTrialType. Adds elements for one
                load-test increment.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="incrementNumber" type="positiveInteger">
                        <annotation>
                            <documentation>Sequence number of this increment within the
                                test.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadingPhase" type="gml:CodeType">
                        <annotation>
                            <documentation>Whether this increment is part of loading, unloading, or
                                a reload within a cyclic sequence, from
                                loadTestIncrementPhase.xml.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="appliedLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>The load applied at this increment.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holdDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>The fixed duration this increment was held for, where the
                                governing procedure specifies a clock-time hold rather than a
                                movement-rate stabilization criterion. See this type's own
                                documentation above.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stabilizationCriterion"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>The rate-of-movement threshold that had to be reached
                                before advancing from this increment, where the governing procedure
                                specifies a stabilization criterion rather than a fixed-duration
                                hold. See this type's own documentation above.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LoadTestIncrementPropertyType">
        <annotation>
            <documentation>Property for LoadTestIncrement, required parent element that holds the
                multiple increments.</documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:LoadTestIncrement"/>
        </sequence>
    </complexType>
    <element name="AbstractPlateBearingTestProcedure" type="diggs:AbstractPlateBearingTestProcedureType"
        abstract="true" substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>Abstract head for a load test applied through a bearing plate rather than
                directly to an axially-loaded element - diggs:PlateLoadTest (a single column head)
                and diggs:ZoneLoadTest (a platform over a group of columns), S28. Shares S27's
                AbstractLoadTestProcedureType (referenceSystem, maxTestLoad, increment) and adds
                what both plate-bearing tests need beyond it: the plate itself (plateDiameter,
                plateStiffness), the load applied before readings start (seatingLoad), the level the
                plate bears at (bearingLevel), and the load-cycle procedure used
                (loadingProcedure).

                DISTINCT FROM diggs:StaticLoadTest, NOT A VARIANT OF IT. ASTM D1143/D1143M and EN
                ISO 22477-1 (S27) measure a pile or column's own axial capacity by loading it
                directly; D1196/D1195 and DIN 18134 measure the STIFFNESS OF THE GROUND OR PLATFORM
                SURFACE by loading it through a plate. The RI Post-installation Parameter Analysis
                confirmed the workbook's "PLT"/"ZLT" abbreviations mean the latter, not a naming
                variant of the former.

                MULTI-STANDARD BY DESIGN, ACROSS THREE TRADITIONS RATHER THAN TWO.
                ASTM D1196 ("Nonrepetitive Static Plate Load Tests of Soils and Flexible Pavement
                Components") is the live US standard; its predecessor ASTM D1194 was withdrawn in
                2003 but remains in wide practical use and is registered for that reason.
                ASTM D1195 covers the REPETITIVE variant (used for airport pavement design).
                DIN 18134, the German static plate load test, is distinct from both: it prescribes
                exactly two load cycles and reports two named moduli, Ev1 (first loading) and Ev2
                (second loading, after initial compression) - the ratio Ev2/Ev1 is itself a
                reported compaction-quality indicator. loadingProcedure's vocabulary
                (plateBearingTestProcedure.xml) spans all three: nonrepetitive, repetitive, and
                two_cycle. BS 8006-1, already registered for diggs:ZoneLoadTest, specifies THAT a
                zone load test is required for reinforced-fill/rigid-inclusion platform
                verification; it does not itself define a plate-test procedure, which is why a zone
                load test is typically executed to D1196, D1195 or DIN 18134's methodology at a
                scale the platform requires, citing BOTH standards through the inherited, repeatable
                testProcedureMethod - the standard that says the test is required, and the standard
                that says how to run it, are frequently not the same document.

                THE RESULTING MODULI ARE RESULTS, NOT PROCEDURE CONTENT, per this family's
                established split. Ev1/Ev2 and the modulus of subgrade reaction go on
                Test/outcome's ResultSet via properties.xml#deformation_modulus_first_load,
                #deformation_modulus_second_load and #modulus_of_subgrade_reaction - new dictionary
                entries, since none of the three existed anywhere in def before this
                task.</documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractPlateBearingTestProcedureType">
        <annotation>
            <documentation>Base type for diggs:AbstractPlateBearingTestProcedure. See the element's
                own documentation for the full rationale.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="plateDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>Diameter of the circular bearing plate
                                used.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plateStiffness" type="gml:CodeType">
                        <annotation>
                            <documentation>Whether the bearing plate behaves as rigid or flexible
                                under load, from plateBearingTestStiffness.xml.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seatingLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>The small load applied to seat the plate before load
                                increments and readings begin.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearingLevel" type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>The level the bearing plate rests at.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadingProcedure" type="gml:CodeType">
                        <annotation>
                            <documentation>The load-cycle procedure used, from
                                plateBearingTestProcedure.xml (nonrepetitive / repetitive /
                                two_cycle). See this type's own documentation above for how the
                                vocabulary spans the ASTM and DIN traditions.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PlateLoadTest" type="diggs:PlateLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractPlateBearingTestProcedure">
        <annotation>
            <documentation>A plate-bearing load test on a single deep foundation element head, per
                ASTM D1194 (withdrawn 2003, still in practical use), ASTM D1195/D1196, or DIN 18134.
                Post-installation row 13 ("PLT").

                No fields of its own: the shared diggs:AbstractPlateBearingTestProcedureType carries
                everything this test needs. Distinguished from diggs:ZoneLoadTest by what
                Test/samplingFeatureRef cites - a single diggs:RIColumn here, a
                diggs:LoadTransferPlatform there - not by any schema particle on this
                type.</documentation>
        </annotation>
    </element>
    <complexType name="PlateLoadTestType">
        <annotation>
            <documentation>Base type for PlateLoadTest.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractPlateBearingTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="ZoneLoadTest" type="diggs:ZoneLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractPlateBearingTestProcedure">
        <annotation>
            <documentation>A large-plate load test on a load transfer platform over a group of rigid
                inclusion columns, per BS 8006-1 (which requires the test) executed to ASTM
                D1195/D1196 or DIN 18134's methodology (which define how to run it) - see
                diggs:AbstractPlateBearingTestProcedure's own documentation for why citing both is
                the expected case, not a redundancy. Post-installation row 14 ("ZLT").

                Test/samplingFeatureRef ([0..*], inherited, no new mechanism needed) cites the
                diggs:LoadTransferPlatform the test was performed on. loadedFootprint and
                testedColumnRef exist because the tested area is routinely a SUBSET of that
                platform, not the whole of it.</documentation>
        </annotation>
    </element>
    <complexType name="ZoneLoadTestType">
        <annotation>
            <documentation>Base type for ZoneLoadTest.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractPlateBearingTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="loadedFootprint"
                        type="diggs:PlanarSurfacePropertyType">
                        <annotation>
                            <documentation>The plan-view extent of the loaded area, where it does
                                not cover the whole of the load transfer platform
                                cited through Test/samplingFeatureRef.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="testedColumnRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:RIColumn</appinfo>
                            <documentation>Explicit references to the specific diggs:RIColumn
                                features the loaded footprint bears on, where that is a named subset
                                of the platform's columns rather than all of them. A property
                                element that supports a value by reference only. The target value is
                                indicated in the appinfo element.

                                EXPLICIT RATHER THAN DERIVED, matching the reasoning
                                diggs:RIColumnType/ltpRef was built on the same day (REF1): the
                                loaded footprint's geometry could in principle be tested against
                                each column's position, but an explicit reference is definitive and
                                does not depend on the footprint geometry being present or
                                precise.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LowStrainIntegrityTest" type="diggs:LowStrainIntegrityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>A low-strain impact integrity test on a completed deep foundation element,
                per ASTM D5882 or the French national pair NF P94-160-2 (reflection/sonic-echo
                method) and NF P94-160-4 (impedance method). Post-installation row 7 - the one
                post-installation test typically applied to a POPULATION of production elements
                (commonly around 5% in US DOT practice) rather than to selected elements, which
                diggs:TargetMeasurement/testedFraction already expresses on the plan side (built at
                TF1).

                SUBSTITUTES diggs:AbstractInsituTestProcedure DIRECTLY, NOT
                diggs:AbstractLoadTestProcedure (S27). A low-strain impact test applies no sustained
                load and has no reaction system or load-increment schedule - S27's head would be
                entirely inapplicable content, the same reasoning diggs:ThermalIntegrityProfiling
                (S31) follows.

                ONE ASTM STANDARD, TWO FRENCH STANDARDS FOR THE SAME SCOPE. ASTM D5882 names two
                methods within a single document: the Pulse Echo Method (time-domain, "sonic echo")
                and the Transient Response Method (frequency-domain, "impedance" or "impulse
                response") - see testMethod below. French practice, which ASIRI-governed rigid
                inclusion projects are at least as likely to cite as ASTM, splits the same two
                methods into two SEPARATE standards rather than one standard with an internal choice:
                NF P94-160-2 (reflection method) and NF P94-160-4 (impedance method). Cite whichever
                is the governing document for a given instance through the inherited
                testProcedureMethod; testMethod records which of the two physical methods was
                actually used, independent of which standard governs it.

                ASTM D5882 WAS WITHDRAWN BY ASTM IN 2025 WITH NO REPLACEMENT NAMED (a reinstatement
                effort, ASTM work item WK93548, is in progress as of this writing) - flagged in the
                specification registry (registryStatus=withdrawn, no supersededByRef, since none
                exists). It remains the standard this element, and the Essential Parameters
                workbook's own row 7, are written against, and is registered and usable for exactly
                the same reason ASTM D1194 (S28) is: instances citing it, before or after its
                withdrawal, must keep resolving.

                EN 12699 (already registered, S27) is the execution standard that requires integrity
                testing of displacement piles as a QA measure; it does not itself define a test
                method, so - matching diggs:AbstractPlateBearingTestProcedure's BS 8006-1 precedent
                (S28) - it is expected to be cited through diggs:RIProgramBasis/governingStandard
                rather than through this procedure's own testProcedureMethod.

                EQUIPMENT, TRANSDUCER LOCATION AND DATA-ACQUISITION SETTINGS ARE DELIBERATELY NOT
                MODELLED AS NAMED FIELDS. The impact hammer and the motion transducer are both
                Equipment/Sensor objects carried through the inherited testProcedureEquipment,
                classified via the new equipmentClass.xml#low_strain_impact_hammer and the
                pre-existing, unconditioned equipmentClass.xml#accelerometer - no new schema particle
                needed, the same reasoning diggs:AbstractLoadTestProcedureType gives for declining a
                named reactionSystem field. Transducer mounting location and instrument filter/gain
                settings have no precedent anywhere in DIGGS at this level of detail (checked against
                specialty/DeepFoundation.xsd's diggs:PDARecordType, the schema's other structured
                dynamic-test record, which does not model them either); the inherited remark or
                otherProperty carries this where a project wants to record it.

                THE INTERPRETED DEFECT DEPTH IS A RESULT, NOT PROCEDURE CONTENT, per this test
                family's established split (S27/S28). It goes on Test/outcome's ResultSet via the new
                properties.xml#defect_depth, conditioned to this element, exactly as
                properties.xml#critical_creep_load (S27) and #modulus_of_subgrade_reaction (S28)
                are.</documentation>
        </annotation>
    </element>
    <complexType name="LowStrainIntegrityTestType">
        <annotation>
            <documentation>Base type for LowStrainIntegrityTest. See the element's own documentation
                for the full rationale.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>The analysis method used - Pulse Echo Method or Transient
                                Response Method, from lowStrainTestMethod.xml. See this element's own
                                documentation above for how the vocabulary spans the ASTM and French
                                traditions.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="assumedWaveSpeed"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>The one-dimensional stress-wave propagation velocity
                                assumed when converting a reflection's travel time to a depth. The
                                single most consequential input to the test's own interpretation - an
                                assumed value taken from a known pile length and its own measured
                                toe-reflection time where one is available, or from published
                                literature values for the pile/element material otherwise, not a
                                measured material property in its own right.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ThermalIntegrityProfiling" type="diggs:ThermalIntegrityProfilingType"
        abstract="false" substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>A thermal integrity test on a completed cast-in-place concrete deep
                foundation element, per ASTM D7949, relating the heat of hydration generated by the
                curing concrete along the element's length to its as-built cross-section and
                continuity. V2 Post-installation row 8 (RI_V2_New_Parameters_Analysis.md) - the last
                unresolved row of the eleven V2 additions, and the one COMPLEMENTARY to S29's
                diggs:LowStrainIntegrityTest rather than a variant of it: this test characterises
                as-built SHAPE (necking, bulging, cage eccentricity) from a heat signature captured
                once during curing, where S29 characterises DISCONTINUITY from a stress-wave
                reflection captured any time after curing is complete.

                SUBSTITUTES diggs:AbstractInsituTestProcedure DIRECTLY, NOT
                diggs:AbstractLoadTestProcedure (S27) - same reasoning as diggs:LowStrainIntegrityTest
                (S29): no load is applied, so S27's reaction/schedule/increment content model is
                entirely inapplicable.

                RETAINS THE NAME "THERMAL INTEGRITY PROFILING" DESPITE ASTM'S OWN RENAME. ASTM D7949
                was withdrawn in 2023 and reinstated in 2025 as D7949-25 under a broader title,
                "Standard Test Methods for Integrity Testing of Concrete Deep Foundations by Thermal
                Methods," dropping the "Thermal Integrity Profiling" branding the 2014 edition used.
                This element keeps the TIP name because that is what the Essential Parameters
                workbook, this build arc, and the industry (the technique is commercially known as
                TIP(TM)) all call it; ASTM D7949 is cited as the governing standard regardless of
                which edition's title is quoted.

                THREE METHODS, PER THE 2025 EDITION - A THIRD WAS ADDED SINCE THE 2014 EDITION THE
                WORKBOOK WAS WRITTEN AGAINST. Method A: a thermal probe lowered into access ducts
                installed in the element. Method B: multiple embedded thermal sensors (thermistors)
                attached to the reinforcing cage. Method C, new in the 2025 reinstatement: embedded
                fiber-optic cable attached to the cage, giving effectively continuous coverage along
                the length rather than discrete sensor stations. measurementMethod's vocabulary
                (thermalIntegrityProfilingMethod.xml) carries all three.

                NO EUROPEAN OR ISO COUNTERPART EXISTS, CHECKED RATHER THAN ASSUMED - unlike S27, S28
                and S29, this is not a two-tradition case. EN 1536 (bored piles) and EN 1538
                (diaphragm walls) recognise thermal integrity testing as an accepted technique but do
                not define their own competing method; European practice runs the same ASTM D7949
                methodology under those execution standards' general integrity-testing provisions.
                Rigid inclusions are typically full-displacement auger columns within EN 12699's
                scope (already registered, S27), not EN 1536's bored-pile scope, so EN 1536 was not
                added to the registry for this task - there was no clean fit to register, not an
                oversight.

                WIRE/PROBE COUNT AND LAYOUT ARE DELIBERATELY NOT MODELLED AS NAMED FIELDS, same
                reasoning as diggs:LowStrainIntegrityTest's declined transducer-location field (S29):
                each physical sensor is its own Equipment/Sensor object under the inherited
                testProcedureEquipment (classified via the new
                equipmentClass.xml#thermal_integrity_probe for Method A, the pre-existing, unconditioned
                equipmentClass.xml#thermistor for Method B, and the new
                equipmentClass.xml#embedded_fiber_optic_cable for Method C) - count and position are
                implicit in how many are cited and need no separate scalar.

                THE MEASURED TEMPERATURE PROFILE AND THE INTERPRETED EFFECTIVE-RADIUS PROFILE ARE
                RESULTS, NOT PROCEDURE CONTENT, per this test family's established split (S27-S29).
                Per-depth temperature goes on Test/outcome's ResultSet via the pre-existing, generic
                properties.xml#temperature (given a THIRD conditional Occurrence here, since that
                definition already carries two others and diggs:conditionalElementXpath is gathered
                definition-wide and OR'd - see RI_Build_Plan_2.md's standing note on this); the
                interpreted effective radius via the new properties.xml#effective_radius.
                ambientTemperature, by contrast, IS procedure content below - a single environmental
                reading at the time of measurement, not a per-depth profile.</documentation>
        </annotation>
    </element>
    <complexType name="ThermalIntegrityProfilingType">
        <annotation>
            <documentation>Base type for ThermalIntegrityProfiling. See the element's own
                documentation for the full rationale.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="measurementMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>Which of ASTM D7949's three methods was used - thermal
                                probe (Method A), embedded thermal sensor (Method B), or embedded
                                fiber-optic cable (Method C) - from
                                thermalIntegrityProfilingMethod.xml.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cureTimeAtMeasurement"
                        type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>Elapsed time since concrete placement when the reading was
                                taken. The single most consequential timing input to the test's own
                                interpretation: ASTM D7949 requires the measurement be taken near the
                                time of peak temperature, which depends on element size and mix
                                design, so a reading taken too early or too late understates the
                                thermal contrast a defect would otherwise produce.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ambientTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>The ambient (air) temperature at the time of measurement -
                                a single environmental-context reading, not the measured concrete
                                temperature profile itself, which is a result (see this type's own
                                documentation above).</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PumpingTestTimeSeriesPropertyType">
        <annotation>
            <documentation>Property type for pumping test time series references. Used to wrap pumping test time series objects or references in properties.</documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TemporalResult" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
