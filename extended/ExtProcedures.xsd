<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">


    <import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="../core/gml3.2Profile_diggs.xsd"/>

    <element name="DynamicProbeTest" type="diggs:DynamicProbeTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A dynamic probe test procedure, in which a rod, with or without a sampler, is driven
                by an impact hammer. The most common examples are the Standard Penetration Test and
                the Becker Hammer Test.
            </documentation>
        </annotation>
    </element>
    <complexType name="DynamicProbeTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="penetrationTestType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of penetration test performed. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of hammer used for driving, including the mechanism that
                                lifts and drops the hammer assembly. Further details of the sampler,
                                such as cathead diameter or number of turns, belong to the equipment
                                object. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerMass" type="diggs:MassMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The mass of the hammer used to drive the sampler.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerDropHeight" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The height from which the hammer drops.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="hammerEfficiency" type="diggs:DimensionlessMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The energy efficiency of the hammer, also known as the energy ratio.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The length of the sampler barrel.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerInternalDiameter" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The inside diameter of the sampler.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerLinerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the sampler liner, if one is used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="samplerRetainerDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the basket retainer, if one is used.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of sampling rods used for penetration. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodExternalDiameter" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The external diameter of the sampling rods.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodSectionLength" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The length of one rod section.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="rodWeight" type="diggs:ForcePerLengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The weight of the drive rod per unit length.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthCasing" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth of the casing at the time of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="selfWeightPenetration" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The distance the sampler penetrates the soil under its own weight
                                before hammer blows are applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterDepth" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to water at the time of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="totalPenetration" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The total distance the sampler penetrated the soil by the end of the
                                procedure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FlatPlateDilatometerTest" type="diggs:FlatPlateDilatometerTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A flat plate dilatometer test procedure. The blade is forced into the soil, membrane
                facing horizontally, to the test depth and the thrust needed is measured; gas
                pressure then expands a circular steel membrane on one side of the blade, and the
                pressures required to move the membrane to two preset deflections (optionally a
                third) are recorded. The membrane is deflated, the blade is advanced by the
                penetration increment, and the test is repeated.
            </documentation>
        </annotation>
    </element>
    <complexType name="FlatPlateDilatometerTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="bladeThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The thickness of the dilatometer blade.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bladeWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The width of the dilatometer blade.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaA" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The gauge gas pressure inside the membrane, corrected for Zm,
                                required to overcome the stiffness of the membrane and move it
                                inward to a center-expansion of 0.05 mm with only ambient
                                atmospheric pressure acting externally (a negative gauge or suction
                                pressure, recorded as positive).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="deltaB" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The gauge gas pressure inside the membrane, corrected for Zm,
                                required to overcome the stiffness of the membrane and move it
                                outward to a center-expansion of 1.10 mm against only the ambient
                                atmospheric pressure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="membraneType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of thin flat circular steel membrane used for testing;
                                typical types are soft, standard and hard. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionReducerDiameter"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the friction reducer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="frictionReducerLocation"
                        type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance of the friction reducer from the center of the
                                dilatometer membrane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rodDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the rods.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="rodLinearWeight"
                        type="diggs:ForcePerLengthMeasureType">
                        <annotation>
                            <documentation>
                                The weight of the rods per unit length.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="zm" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The gauge pressure deviation from zero when vented to atmosphere: an
                                offset used to correct pressure readings to the true gauge pressure.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituCBRTest" type="diggs:InsituCBRTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                An in-situ California bearing ratio (CBR) test procedure. CBR is a penetration test
                of the mechanical strength of road subgrades and basecourses: the pressure needed to
                penetrate the soil with a plunger of standard area is divided by the pressure needed
                for an equal penetration of a standard crushed rock.
            </documentation>
        </annotation>
    </element>
    <complexType name="InsituCBRTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="penetrationIncrement"
                        type="diggs:CBRIncrementPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                One increment of penetration of the test. Repeat for each increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pistonDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the penetration piston.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="reactionLoadDescription" type="string">
                        <annotation>
                            <documentation>
                                A description of the weight used for the reaction load.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="seatingForce" type="diggs:ForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The force of the reaction system.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="surchargePressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The load imposed by surcharge from the test equipment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="InSituPenetrometerTest"
        substitutionGroup="diggs:AbstractInsituTestProcedure"
        type="diggs:InSituPenetrometerTestType">
        <annotation>
            <documentation>
                An in-situ penetrometer test procedure, which provides an estimate of undrained
                shear strength.
            </documentation>
        </annotation>
    </element>
    <complexType name="InSituPenetrometerTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="reading"
                        type="diggs:ReadingMeasureType">
                        <annotation>
                            <documentation>
                                A penetrometer reading. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituPermeabilityTest" type="diggs:InsituPermeabilityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                An in-situ permeability test procedure, which determines the permeability of a soil
                by constant head, falling head or packer test methods.
            </documentation>
        </annotation>
    </element>
    <complexType name="InsituPermeabilityTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="permeabilityTestType" type="gml:CodeType" default="false"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of permeability test. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthTestZoneTop" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to the top of the test zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthTestZoneBottom" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to the bottom of the test zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="stage" type="integer" minOccurs="0">
                        <annotation>
                            <documentation>
                                The stage number of a multistage packer test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthWaterPreTest" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to water in the borehole or piezometer immediately before
                                the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="diameterTestZone" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The diameter of the test zone.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="diameterCasing" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The diameter of the standpipe or casing.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="averageFlow" type="diggs:VolumePerTimeMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The average flow during the packer test stage.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="depthStandingWater" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The depth to the assumed standing water level.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="appliedHead" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The applied total head of water during the test stage, at the center
                                of the packer test zone.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituResistivityTest" type="diggs:InsituResistivityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                An in-situ electrical resistivity test procedure: multi-electrode measurements made
                on the ground surface or on the surface of an in-place material, from which the
                resistivity of that material is determined. One type serves several survey
                geometries, which differ only in what is stepped from one reading to the next: a
                vertical electrical sounding steps the electrode separation about a fixed array
                center; electrical profiling (constant separation traversing) steps the array along
                a traverse; an azimuthal sounding steps the array orientation about a fixed center;
                a single-separation measurement takes one reading, as is usual for a Wenner probe on
                in-place concrete. They are distinguished by diggs:surveyGeometry and
                diggs:arrayType, and the readings are diggs:ResistivityReading objects in every
                case. Not for tomographic surveys: a multi-electrode survey inverted to a 2-D or 3-D
                resistivity model is a diggs:GeophysicalFieldSurvey with diggs:geophysicalMethod
                "electrical resistivity tomography (ERT)". Not for laboratory measurement:
                resistivity of a specimen removed from the ground (the soil-box method of ASTM G57,
                or AASHTO T288) is diggs:LabResistivityTest. Cite the governing standard or
                standards in diggs:AbstractTestProcedureType/testProcedureMethod; ASTM G57 (Wenner
                array), IEEE Std 81 (earthing design) and ASTM D6431 (subsurface characterization)
                all describe measurements this type carries.
            </documentation>
        </annotation>
    </element>
    <complexType name="InsituResistivityTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testType" type="gml:CodeType">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    note="arrayType for the electrode array configuration and surveyGeometry for how the array was stepped between readings"/>
                            </appinfo>
                            <documentation>DEPRECATED. Use arrayType for the electrode array
                                configuration and surveyGeometry for how the array was stepped
                                between readings. The type of resistivity test.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodeSpacing" type="gml:CodeType">
                        <annotation>
                            <appinfo>
                                <diggs:deprecated since="3.1.0"
                                    replacedBy="diggs:electrodeSpacing"
                                    note="on each diggs:ResistivityReading, as a length"/>
                            </appinfo>
                            <documentation>DEPRECATED. Use electrodeSpacing on each
                                diggs:ResistivityReading, a length with units. The electrode spacing
                                of the survey, as a code.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="arrayType" type="diggs:ArrayTypeEnumExtType">
                        <annotation>
                            <documentation>
                                The electrode array configuration used: for example Wenner (four
                                electrodes at equal separation), Schlumberger (a closely spaced
                                potential pair at the center of a wider, expanding current pair),
                                dipole-dipole (a current dipole and a potential dipole of equal
                                length, separated by a multiple of that length), pole-dipole or
                                gradient. The array determines which geometry properties of
                                diggs:ResistivityReading apply, and which expression converts a
                                measured resistance into an apparent resistivity. Values come from
                                the enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="surveyGeometry" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                How the array was stepped from one reading to the next: for example
                                a vertical electrical sounding (separation expanded about a fixed
                                center), constant separation traversing (fixed separation moved
                                along a line), an azimuthal sounding (orientation rotated about a
                                fixed center) or a single-separation measurement. It states the
                                survey design; each diggs:ResistivityReading records the geometry
                                that resulted. Use the DIGGS dictionary surveyGeometry.xml for the
                                list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="electrodeDepth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The depth to which the electrodes were driven into the surface: the
                                "b" term in the full Wenner expression for apparent resistivity.
                                ASTM G57 requires that it not exceed 5 % of the smallest electrode
                                separation, the condition under which that expression reduces to the
                                common short form. Given once for the procedure, as it is normally
                                constant across a survey.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="reading"
                        type="diggs:ResistivityReadingPropertyType">
                        <annotation>
                            <documentation>
                                An electrode reading of the survey. A sounding has one per
                                separation, a traverse one per position, an azimuthal sounding one
                                per orientation, and a survey that varies more than one of these one
                                per combination. Repeat for each reading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ResistivityReading" type="diggs:ResistivityReadingType" abstract="false">
        <annotation>
            <documentation>
                A single electrode reading within an in-situ resistivity test: the array geometry,
                the resistance measured and the apparent resistivity computed from it. The
                separation geometry is exactly one of three forms, selected by the procedure's
                diggs:arrayType: a Wenner array gives diggs:electrodeSpacing alone, a Schlumberger
                array the pair diggs:currentElectrodeSeparation and
                diggs:potentialElectrodeSeparation, and a dipole-dipole array the pair
                diggs:dipoleLength and diggs:nFactor. Independently of that form, a traverse also
                gives diggs:readingLocation and an azimuthal survey diggs:orientation.
            </documentation>
        </annotation>
    </element>
    <complexType name="ResistivityReadingPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:ResistivityReading object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:ResistivityReading" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="ResistivityReadingType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <choice minOccurs="0">
                        <annotation>
                            <documentation>The separation geometry, in whichever of three mutually
                                exclusive forms matches the procedure's diggs:arrayType. The three
                                forms are never combined on one reading - a Wenner array's single
                                uniform spacing, a Schlumberger array's independently stated current
                                and potential pair separations, and a dipole-dipole array's dipole
                                length and separation multiplier describe the same underlying idea
                                (how far apart the electrodes are) in three shapes that do not share
                                a common representation, which is why this is a choice rather than
                                three independently optional siblings.</documentation>
                        </annotation>
                        <element name="electrodeSpacing" type="diggs:LengthMeasureType">
                            <annotation>
                                <documentation>
                                    The separation between adjacent electrodes, for arrays in which
                                    that separation is uniform: the "a" dimension of a Wenner array,
                                    and the probe spacing of a Wenner probe applied to a concrete
                                    surface.
                                </documentation>
                            </annotation>
                        </element>
                        <sequence>
                            <element name="currentElectrodeSeparation"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The full separation between the two current electrodes, for
                                        arrays in which the current and potential pairs are
                                        separated differently, principally Schlumberger. It is not
                                        the half-separation against which sounding curves are
                                        conventionally plotted.
                                    </documentation>
                                </annotation>
                            </element>
                            <element name="potentialElectrodeSeparation"
                                type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The full separation between the two potential electrodes,
                                        for arrays in which the current and potential pairs are
                                        separated differently, principally Schlumberger. It follows
                                        the same convention as
                                        diggs:ResistivityReadingType/currentElectrodeSeparation.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                        <sequence>
                            <element name="dipoleLength" type="diggs:LengthMeasureType">
                                <annotation>
                                    <documentation>
                                        The length of the current dipole of a dipole-dipole array:
                                        the separation between the two current electrodes, which
                                        equals the separation between the two potential electrodes
                                        (the "a" spacing in the n-a dipole-dipole notation).
                                    </documentation>
                                </annotation>
                            </element>
                            <element name="nFactor" type="double">
                                <annotation>
                                    <documentation>
                                        The separation between the current dipole and the potential
                                        dipole of a dipole-dipole array, as a multiple of
                                        diggs:ResistivityReadingType/dipoleLength (the "n" in the
                                        n-a notation) rather than as a length. The multiplier is
                                        what a survey steps from one reading to the next at a fixed
                                        dipole length.
                                    </documentation>
                                </annotation>
                            </element>
                        </sequence>
                    </choice>
                    <element minOccurs="0" name="orientation" type="diggs:BearingMeasureType">
                        <annotation>
                            <documentation>
                                The bearing of the line along which the electrode array was laid
                                out, for surveys in which orientation is varied or otherwise
                                significant. An array line has no direction, so give the one of its
                                two opposed bearings that falls between 0 and 180 degrees. The
                                reference direction is carried by the refAzimuth attribute of the
                                measure.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="readingLocation" type="diggs:LocationPropertyType">
                        <annotation>
                            <documentation>
                                The position of the array for this reading, normally its center.
                                Give it where readings were taken at different positions,
                                principally constant separation traversing and successive points on
                                a structure. Where every reading shares one position, the sampling
                                feature the test was performed at carries it.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="measuredResistance"
                        type="diggs:ElectricResistanceMeasureType">
                        <annotation>
                            <documentation>
                                The resistance read from the instrument for this reading.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="1" name="apparentResistivity"
                        type="diggs:ElectricalResistivityMeasureType">
                        <annotation>
                            <documentation>
                                The apparent resistivity computed from the measured resistance and
                                the array geometry. It is the resistivity of an equivalent
                                homogeneous medium; where the ground is layered or anisotropic it is
                                not the resistivity of any one layer.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="InsituVaneTest" abstract="false" type="diggs:InsituVaneTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                An in-situ vane shear test procedure, which gives the in-place shearing resistance
                of soft, saturated clays.
            </documentation>
        </annotation>
    </element>
    <complexType name="InsituVaneTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="intactVaneTest" type="diggs:VaneTestPropertyType">
                        <annotation>
                            <documentation>
                                The vane shear test parameters in intact soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="remoldedVaneTest" type="diggs:VaneTestPropertyType"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The vane shear test parameters in remolded soil. Repeat for each
                                test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="torqueRodFriction" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The friction of the torque rod, measured as friction above the slip
                                coupling or as blank rod friction where the rod is in direct contact
                                with the soil.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneBladeThickness" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The thickness of the vane blade.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneDepthBelow" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The depth of the vane beneath the housing or the bottom of the hole:
                                the vector length from the bottom of the hole or housing to the test
                                location.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneShaftDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of the vane shaft.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneSystemType" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of vane system, for example slip coupling, no slip
                                coupling, or vane shoe push/drill. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneTaperAngleBottom"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The taper angle at the bottom of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneTaperAngleTop"
                        type="diggs:PlaneAngleMeasureType">
                        <annotation>
                            <documentation>
                                The taper angle at the top of the vane.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="vaneType" type="diggs:VaneEnumExtType">
                        <annotation>
                            <documentation>
                                The type of vane. Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="VaneEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:VaneEnumType"/>
    </simpleType>
    <simpleType name="VaneEnumType">
        <restriction base="string">
            <enumeration value="double tapered">
                <annotation>
                    <documentation>
                        A vane tapered at both ends.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="rectangular">
                <annotation>
                    <documentation>
                        A rectangular vane, with no taper.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="single tapered">
                <annotation>
                    <documentation>
                        A vane tapered at one end.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="LugeonTest" type="diggs:LugeonTestType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A Lugeon test: an in-situ test widely used to estimate the average hydraulic
                conductivity of rock formations. It is also called a water pressure test or a packer
                test.
            </documentation>
        </annotation>
    </element>
    <complexType mixed="false" name="LugeonTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="depthToGroundWater" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The distance from the ground surface to the top of the saturated
                                zone (the water table).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureMeasurementConfiguration"
                        type="diggs:PressureMeasurementConfigurationEnumType">
                        <annotation>
                            <documentation>
                                How pressure is measured during the test. Values come from the
                                enumerated list.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pressureGaugeHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height above the ground surface of the pressure gauge, if a
                                gauge is used instead of a borehole transducer.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pMax" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The maximum test pressure, chosen not to exceed the in-situ minimum
                                stress so that hydraulic fracturing is avoided.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="lugeonStep"
                        type="diggs:LugeonStepPropertyType">
                        <annotation>
                            <documentation>
                                One step of the test, run at one injection pressure; there are
                                typically five. Repeat for each step.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LugeonStepPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LugeonStep object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:LugeonStep"/>
        </sequence>
    </complexType>
    <element name="LugeonStep" type="diggs:LugeonStepType">
        <annotation>
            <documentation>
                One step of a Lugeon test, run at a single injection pressure.
            </documentation>
        </annotation>
    </element>
    <complexType name="LugeonStepType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element minOccurs="1" name="lugeonStepNumber" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The number of the step: 1 for the first step, 2 for the second, and
                                so on.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The target pressure for the step.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="avgFlowRate" type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The average flow rate for the step, derived from the flow
                                measurements in its time series.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coeffPermeability"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The coefficient of permeability (hydraulic conductivity) computed
                                from the step measurements. It is averaged with the other steps and
                                reported as one of the primary test results.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lugeonValue"
                        type="diggs:VolumePerTimePerPressureLengthMeasureType">
                        <annotation>
                            <documentation>
                                The Lugeon value, a measure of hydraulic conductivity in rock,
                                computed from the step measurements. It is averaged with the other
                                steps and reported as one of the primary test results.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="lugeonStepTimeSeries"
                        type="diggs:LugeonStepTimeSeriesPropertyType" minOccurs="0" maxOccurs="1">
                        <annotation>
                            <documentation>
                                The recorded flow for the step, as a time series.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalElapsedTime" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The total elapsed time of the step: typically 10 minutes, but
                                different if steady-state flow occurs.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="totalVolumeWater" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The total volume of water pumped into the borehole during the step.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LugeonStepTimeSeriesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemporalResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TemporalResult"/>
        </sequence>
    </complexType>
    <simpleType name="PressureMeasurementConfigurationEnumType">
        <restriction base="string">
            <enumeration value="pressure gauge">
                <annotation>
                    <documentation>
                        Pressure is measured with a pressure gauge at the ground surface.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="borehole transducer">
                <annotation>
                    <documentation>
                        Pressure is measured with a transducer in the borehole.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <element name="PressuremeterTest" type="diggs:PressuremeterTestProcedureType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A pressuremeter test procedure. The pressuremeter measures the strength and
                stress-strain properties of all soil types, including soft rock. It is used
                primarily to calculate the bearing capacity and settlement of shallow and deep
                foundations, the deformation of laterally loaded piles and sheet piles, and the
                resistance of anchors.
            </documentation>
        </annotation>
    </element>
    <complexType name="PressuremeterTestProcedureType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element name="pressuremeterType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of pressuremeter. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pressuremeterDiameter" type="diggs:LengthMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The uninflated diameter of the pressuremeter.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="trial" type="diggs:PressuremeterTestTrialPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A loading or reloading trial of the test. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PressuremeterTestTrial" type="diggs:PressuremeterTestTrialType" abstract="false">
        <annotation>
            <documentation>
                The results of one trial of a pressuremeter test.
            </documentation>
        </annotation>
    </element>
    <complexType name="PressuremeterTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:PressuremeterTestTrial object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:PressuremeterTestTrial" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="PressuremeterTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="trialNo" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>
                                The pressuremeter loading or reloading cycle of the trial.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="shearModulus" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The unload or reload shear modulus for the cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="meanStrain" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The mean strain of the cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="strainRange" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The strain range or amplitude of the cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="meanPressure" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The mean pressure of the cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pressureRange" type="diggs:PressureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The pressure range or amplitude of the cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="linearity" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The linearity exponent (Bolton and Whittle, 1999).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PumpingTest" type="diggs:PumpingTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A pumping test, also called an aquifer test: an aquifer is stimulated by constant
                pumping and its response (drawdown) is observed in observation wells.
            </documentation>
        </annotation>
    </element>
    <complexType name="PumpingTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="averagePumpingRate"
                        type="diggs:VolumePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The average pumping rate of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="pumpingTestTimeSeries"
                        type="diggs:PumpingTestTimeSeriesPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A time series recorded during the pumping test. Repeat for each
                                series.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="StaticLoadTest" type="diggs:StaticLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>
                A maintained-load or constant-rate-of-penetration axial compressive load test
                applied directly to a deep foundation element, per ASTM D1143/D1143M or EN ISO
                22477-1 (or their national equivalents). ASTM D1143 names seven loading procedures
                (Quick Test, Maintained Test, Loading in Excess of Maintained Test, Constant Time
                Interval, Constant Rate of Penetration, Constant Movement Increment, Cyclic
                Loading); EN ISO 22477-1 covers only the maintained-load family and excludes the
                constant-rate-of-penetration and cyclic variants. The vocabulary of loadingProcedure
                carries all of ASTM's named options, and its maintained_load entry is the value both
                traditions share. Cite the governing standard through the inherited
                testProcedureMethod: loadingProcedure names the loading method, and
                testProcedureMethod names the standard that specifies it.
            </documentation>
        </annotation>
    </element>
    <complexType name="StaticLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="loadingProcedure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The loading procedure used. See diggs:StaticLoadTest for how the
                                vocabulary spans the ASTM and EN ISO traditions. Use the DIGGS
                                dictionary staticLoadTestProcedure.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RapidLoadTest" type="diggs:RapidLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>
                An axial compressive force-pulse (rapid) load test applied directly to a deep
                foundation element, per ASTM D7383 or EN ISO 22477-10. The loading lasts tens to a
                few hundred milliseconds, between the seconds-to-minutes timescale of
                diggs:StaticLoadTest and the millisecond-or-shorter timescale of
                diggs:DynamicLoadTest, and the measured force pulse needs an inertial and damping
                correction (analysisMethod) to give a load-settlement response. EN ISO 22477-10
                classifies a rapid test by purpose, as an investigation test (a sacrificial pile
                loaded to the ultimate limit state) or a control test (a working pile loaded to a
                specified load above the serviceability limit state); ASTM D7383 does not name the
                distinction, so give testCategory where it applies and leave it out otherwise. The
                two named analysis methods, the Unloading Point Method and its modified form, are
                used by the practitioner communities of both standards.
            </documentation>
        </annotation>
    </element>
    <complexType name="RapidLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testCategory"
                        type="diggs:RapidLoadTestCategoryEnumExtType">
                        <annotation>
                            <documentation>
                                The classification of the test by purpose, as an investigation test
                                or a control test (EN ISO 22477-10). Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pulseDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration of the applied force pulse.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="analysisMethod"
                        type="diggs:RapidLoadTestAnalysisMethodEnumExtType">
                        <annotation>
                            <documentation>
                                The method used to derive an equivalent static load-displacement
                                response from the measured force pulse: the Unloading Point Method
                                or the Modified Unloading Point Method. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="DynamicLoadTest" type="diggs:DynamicLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>
                A high-strain dynamic load test applied directly to a deep foundation element by
                hammer impact, per ASTM D4945 or EN ISO 22477-4. ASTM D4945 is
                strain-and-acceleration ("PDA") impact testing, in US practice almost always paired
                with CAPWAP or an equivalent signal-matching analysis (a form of wave equation
                analysis) to derive static capacity. EN ISO 22477-4 names four methods under one
                standard: dynamic impact testing (the ASTM D4945 method), driving formulae, wave
                equation analysis, and multi-blow dynamic testing (capacity derived from a series of
                blows at different displacement and velocity levels). The vocabulary of testMethod
                carries all four, plus signal_matching for the CAPWAP-style analysis that ASTM
                practice names separately from the base impact method. The results of a dynamic load
                test on a completed element are carried by Test/outcome as a ResultSet of force,
                velocity and capacity values; diggs:PDARecordType belongs to pile driving
                activities.
            </documentation>
        </annotation>
    </element>
    <complexType name="DynamicLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testMethod" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The method used to derive pile resistance. See diggs:DynamicLoadTest
                                for the ASTM and EN ISO correspondence. Use the DIGGS dictionary
                                dynamicLoadTestMethod.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="hammerEnergy" type="diggs:EnergyMeasureType">
                        <annotation>
                            <documentation>
                                The rated or observed energy delivered by the impact hammer for the
                                blows tested. Where a typed record of the hammer is wanted, carry it
                                through the inherited testProcedureEquipment.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LoadTestIncrement" type="diggs:LoadTestIncrementType" abstract="false"
        substitutionGroup="diggs:AbstractProcedureTrial">
        <annotation>
            <documentation>
                One load application during a load test: a staged increment or decrement, a force
                pulse or an impact. The readings taken during it are in incrementTimeSeries.
                holdDuration and stabilizationCriterion are alternative hold criteria, not two ways
                of recording the same fact: holdDuration (a fixed clock time) is how ASTM's Quick
                Test and Constant Time Interval procedures define when to advance to the next
                increment, and stabilizationCriterion (a rate of movement) is how EN ISO 22477-1's
                maintained-load method and ASTM's Maintained Test define it. Give whichever the
                governing procedure uses and leave the other absent.
            </documentation>
        </annotation>
    </element>
    <complexType name="LoadTestIncrementType">
        <complexContent>
            <extension base="diggs:AbstractProcedureTrialType">
                <sequence>
                    <element minOccurs="0" name="incrementNumber" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The sequence number of this increment within the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadingPhase"
                        type="diggs:LoadTestIncrementPhaseEnumExtType">
                        <annotation>
                            <documentation>
                                Whether this increment is part of seating, loading, unloading, or a
                                reload within a cyclic sequence. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="appliedLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The load applied at this increment.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="holdDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The fixed duration the increment was held, where the governing
                                procedure specifies a clock-time hold rather than a movement-rate
                                stabilization criterion. It is the alternative to
                                stabilizationCriterion.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stabilizationCriterion"
                        type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The rate-of-movement threshold that had to be reached before
                                advancing from this increment, where the governing procedure
                                specifies a stabilization criterion rather than a fixed-duration
                                hold. It is the alternative to holdDuration.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="appliedStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The stress applied at this increment, for tests loaded and reported
                                as a stress on a bearing area. Give it alongside, not instead of,
                                appliedLoad.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="incrementTimeSeries"
                        type="diggs:LoadTestIncrementTimeSeriesPropertyType">
                        <annotation>
                            <documentation>
                                The readings taken during this increment, in time order, for example
                                load, movement and temperature at each reading time. The first and
                                last times bound the hold.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="LoadTestIncrementTimeSeriesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemporalResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:TemporalResult"/>
        </sequence>
    </complexType>
    <complexType name="LoadTestIncrementPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:LoadTestIncrement object inline.
            </documentation>
        </annotation>
        <sequence>
            <element maxOccurs="1" minOccurs="1" ref="diggs:LoadTestIncrement"/>
        </sequence>
    </complexType>
    <element name="LateralLoadTest" type="diggs:LateralLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>
                A static lateral (transverse) load-deflection test applied directly to a deep
                foundation element or group, per ASTM D3966/D3966M or the French standard NF
                P94-151. It uses the same reaction system and load-increment schedule as an axial
                load test, so referenceSystem, maxTestLoad and increment (diggs:LoadTestIncrement)
                apply unchanged. ASTM D3966/D3966M names eight loading procedures (standard loading,
                excess loading, cyclic loading, surge loading, reverse loading, reciprocal loading,
                specified lateral movement, combined loading); the vocabulary of loadingProcedure
                carries all eight. No EN ISO 22477 part covers this scope. Cite whichever standard
                governs through the inherited testProcedureMethod. A single pile and a group are not
                distinguished by a field: ASTM D3966/D3966M covers both, and the number of
                diggs:RIColumn features that Test/samplingFeatureRef cites shows which. The measured
                lateral deflection is a result: give it on the ResultSet of Test/outcome with the
                property lateral_deflection from properties.xml (the property settlement is vertical
                only).
            </documentation>
        </annotation>
    </element>
    <complexType name="LateralLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="loadingProcedure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The loading procedure used: one of the eight named procedures of
                                ASTM D3966/D3966M. Use the DIGGS dictionary
                                lateralLoadTestProcedure.xml for the list of values.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadApplicationPoint"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The level on the element at which the lateral load was applied,
                                given as a position. The bending moment induced in the element
                                depends on the eccentricity between this level and the point of
                                fixity in the ground.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AbstractPlateBearingTestProcedure"
        type="diggs:AbstractPlateBearingTestProcedureType" abstract="true"
        substitutionGroup="diggs:AbstractLoadTestProcedure">
        <annotation>
            <documentation>
                Abstract head for a load test applied through a bearing plate rather than directly
                to an axially loaded element: diggs:PlateLoadTest (a single column head) and
                diggs:ZoneLoadTest (a platform over a group of columns). It shares
                diggs:AbstractLoadTestProcedureType (referenceSystem, maxTestLoad, increment) and
                adds the plate (plateDiameter, plateWidth, plateLength, plateArea, plateStiffness),
                the seating load, the level the plate bears at and the load-cycle procedure. It is
                distinct from diggs:StaticLoadTest: ASTM D1143/D1143M and EN ISO 22477-1 measure the
                axial capacity of a pile or column by loading it directly, whereas ASTM D1196, D1195
                and DIN 18134 measure the stiffness of the ground or platform surface by loading it
                through a plate. ASTM D1196 (nonrepetitive static plate load tests) is current; its
                predecessor ASTM D1194 was withdrawn in 2003 but remains in wide use and is
                registered. ASTM D1195 covers the repetitive variant. DIN 18134 prescribes exactly
                two load cycles and reports two moduli, Ev1 (first loading) and Ev2 (second loading,
                after initial compression), whose ratio Ev2/Ev1 is itself a reported
                compaction-quality indicator. The enumeration of loadingProcedure spans all three
                traditions: nonrepetitive, repetitive and two cycle. BS 8006-1 requires a zone load
                test for reinforced-fill and rigid inclusion platform verification but does not
                define the procedure, so a zone load test usually cites both it and the standard it
                is executed to (D1196, D1195 or DIN 18134) through the repeatable inherited
                testProcedureMethod. The moduli are results: give Ev1, Ev2 and the modulus of
                subgrade reaction on the ResultSet of Test/outcome with the properties
                deformation_modulus_first_load, deformation_modulus_second_load and
                modulus_of_subgrade_reaction from properties.xml.
            </documentation>
        </annotation>
    </element>
    <complexType abstract="true" name="AbstractPlateBearingTestProcedureType">
        <annotation>
            <documentation>
                Abstract base type for load tests applied through a bearing plate. Use one of its
                concrete extensions, for example diggs:PlateLoadTest.
            </documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractLoadTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="plateDiameter" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The diameter of a circular bearing plate.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plateWidth" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The width of a rectangular or square bearing plate or loaded
                                footing. Give it with plateLength; a square plate gives the same
                                value for both.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plateLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The length of a rectangular or square bearing plate or loaded
                                footing. Give it with plateWidth.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plateArea" type="diggs:AreaMeasureType">
                        <annotation>
                            <documentation>
                                The bearing area of the plate, for a plate of any shape. Give it
                                alongside, not instead of, plateDiameter or plateWidth and
                                plateLength; where they disagree, the dimensions prevail.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="plateStiffness"
                        type="diggs:PlateBearingTestStiffnessEnumExtType">
                        <annotation>
                            <documentation>
                                Whether the bearing plate behaves as rigid or flexible under load.
                                Values come from the enumerated list, or "Other: xx", where xx is a
                                user-defined term whose meaning differs from every listed value (not
                                a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seatingLoad" type="diggs:ForceMeasureType">
                        <annotation>
                            <documentation>
                                The small load applied to seat the plate before load increments and
                                readings begin.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bearingLevel"
                        type="diggs:PointLocationPropertyType">
                        <annotation>
                            <documentation>
                                The level at which the bearing plate rests, given as a position.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="loadingProcedure"
                        type="diggs:PlateBearingTestProcedureEnumExtType">
                        <annotation>
                            <documentation>
                                The load-cycle procedure used: nonrepetitive, repetitive or two
                                cycle. The enumeration spans the ASTM and DIN traditions described
                                at diggs:AbstractPlateBearingTestProcedure. Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="seatingStress" type="diggs:PressureMeasureType">
                        <annotation>
                            <documentation>
                                The stress applied to seat the plate before increments and readings
                                begin. Give it alongside, not instead of, seatingLoad.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="beddingMaterial" type="string">
                        <annotation>
                            <documentation>
                                A description of the bed the plate was set on: its material and,
                                where reported, grading and thickness (for example "dry medium sand,
                                25 mm maximum" or "gypsum plaster").
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PlateLoadTest" type="diggs:PlateLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractPlateBearingTestProcedure">
        <annotation>
            <documentation>
                A plate-bearing load test on the head of a single deep foundation element, per ASTM
                D1194 (withdrawn in 2003, still in practical use), ASTM D1195/D1196 or DIN 18134. It
                has no fields of its own; diggs:AbstractPlateBearingTestProcedureType carries
                everything it needs. It is distinguished from diggs:ZoneLoadTest by what
                Test/samplingFeatureRef cites: a single diggs:RIColumn here, a
                diggs:LoadTransferPlatform there.
            </documentation>
        </annotation>
    </element>
    <complexType name="PlateLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractPlateBearingTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="ZoneLoadTest" type="diggs:ZoneLoadTestType" abstract="false"
        substitutionGroup="diggs:AbstractPlateBearingTestProcedure">
        <annotation>
            <documentation>
                A large-plate load test on a load transfer platform over a group of rigid inclusion
                columns, per BS 8006-1 (which requires the test), executed to the methodology of
                ASTM D1195/D1196 or DIN 18134 (which define how to run it); cite both, as described
                at diggs:AbstractPlateBearingTestProcedure. Test/samplingFeatureRef cites the
                diggs:LoadTransferPlatform tested. Give loadedFootprint and testedColumnRef where
                the tested area is a subset of the platform.
            </documentation>
        </annotation>
    </element>
    <complexType name="ZoneLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractPlateBearingTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="loadedFootprint"
                        type="diggs:PlanarSurfacePropertyType">
                        <annotation>
                            <documentation>
                                The plan-view extent of the loaded area, where it does not cover the
                                whole of the load transfer platform cited through
                                Test/samplingFeatureRef.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="testedColumnRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <appinfo source="urn:x-gml:targetElement">diggs:RIColumn</appinfo>
                            <documentation>
                                The diggs:RIColumn features that the loaded footprint bears on,
                                where they are a named subset of the platform's columns rather than
                                all of them. Given by reference only. Repeat for each column.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LowStrainIntegrityTest" type="diggs:LowStrainIntegrityTestType" abstract="false"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A low-strain impact integrity test on a completed deep foundation element, per ASTM
                D5882 or the French standards NF P94-160-2 (reflection/sonic-echo method) and NF
                P94-160-4 (impedance method). It is typically applied to a population of production
                elements (commonly around 5 % in US DOT practice) rather than to selected elements.
                It substitutes diggs:AbstractInsituTestProcedure directly, not
                diggs:AbstractLoadTestProcedure, because no sustained load is applied and there is
                no reaction system or load-increment schedule. ASTM D5882 names two methods in one
                document, the Pulse Echo Method (time domain, "sonic echo") and the Transient
                Response Method (frequency domain, "impedance" or "impulse response"); French
                practice splits them into two standards. Cite the governing standard through the
                inherited testProcedureMethod; testMethod records which physical method was used.
                ASTM D5882 was withdrawn by ASTM in 2025 with no replacement named (a reinstatement
                effort, ASTM work item WK93548, was in progress); the specification registry marks
                it withdrawn, and instances that cite it keep resolving. EN 12699 requires integrity
                testing of displacement piles but defines no test method, so cite it through
                diggs:RIProgramBasis/governingStandard rather than testProcedureMethod. The impact
                hammer and the motion transducer are equipment objects carried through the inherited
                testProcedureEquipment, classified with equipmentClass.xml#low_strain_impact_hammer
                and equipmentClass.xml#accelerometer. headPreparation, sensorMounting,
                sensorPositionCount, sensorOffset and impactOffset state how the head was prepared
                and where the transducer and impact were placed, and lengthToDiameterRatio the
                slenderness of the element. State the amplification applied to the record, because
                the height of a reflection can be read only against it: amplificationFunction gives
                its shape, amplificationFactor the equipment setting, and amplificationStart and
                amplificationEnd the depths over which it rises. The other settings a report states
                are filterType, filterCutoff, sharpeningApplied, impactNormalized, recordReference,
                samplingRate, sampleResolution and recordLength; processing specific to one
                equipment goes in otherTestProperty. evaluationSoftware names the software that
                evaluated the record, and the inherited role states who evaluated it. The record is
                the result: the diggs:Test on the element tested has as its outcome the evaluated
                record as a depth-indexed result, whose location is a MultiPoint of the record
                depths along the element and whose ResultSet holds one column per curve sampled at
                those depths: the amplified, normalized velocity
                (properties.xml#normalized_velocity) and, where reported, the force, the time after
                impact (properties.xml#elapsed_time) and a reconstructed relative impedance. Depth
                and time are related by waveSpeed (depth = waveSpeed x time / 2), so a record
                reported against time is stated at the depths that waveSpeed gives, with the time as
                a column. One test with one set of procedure values is one Test, however many
                reflections it shows. Values picked from the record, such as the toe depth, the
                depth of a reflection above it or its relative amplitude, go in
                otherMeasurementProperty or in a column of the result (on every row, or only on the
                row at the depth where picked); the conclusion the tester draws from the whole
                record is measurementSummary. A frequency-domain record has no depth or time domain:
                the mobility of a transient response test (velocity over force against frequency)
                goes in frequencyResponse, a table whose columns its parameters declare, and values
                read from it, such as the characteristic mobility or the dynamic stiffness, go in
                otherMeasurementProperty.
            </documentation>
        </annotation>
    </element>
    <complexType name="LowStrainIntegrityTestType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="testMethod"
                        type="diggs:LowStrainTestMethodEnumExtType">
                        <annotation>
                            <documentation>
                                The analysis method used: pulse_echo (the record is evaluated in the
                                time domain) or transient_response (the ratio of velocity to force
                                is evaluated in the frequency domain). See
                                diggs:LowStrainIntegrityTest for how they relate to the ASTM and
                                French standards. Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="waveSpeed" type="diggs:LengthPerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The one-dimensional stress-wave propagation speed used to convert
                                the travel time of a reflection to a depth. Its howDetermined
                                attribute states how it was obtained: assigned for a value taken
                                from experience or literature for the concrete (the usual case),
                                calculated where it was taken from a known pile length and the
                                measured travel time of the toe reflection.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="referenceLength" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The length of the element that the record was evaluated
                                against - the length entered into the equipment, which marks where
                                the toe reflection is expected. It is not the as-built length of the
                                element, which the sampling feature carries.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="referenceLengthBasis"
                        type="diggs:ReferenceLengthBasisEnumExtType">
                        <annotation>
                            <documentation>
                                What referenceLength measures: as_cast (the whole element as
                                constructed), embedded (the part below the ground surface) or
                                below_sensor (from the sensor position down). Values come from the
                                enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="lengthToDiameterRatio" type="double">
                        <annotation>
                            <documentation>The ratio of the length of the element to its diameter,
                                a number without a unit. The accuracy of a low strain integrity
                                measurement falls as the ratio rises; the Hong Kong Code of
                                Practice for Foundations (s.8.7) states a limit of 30. A limit is
                                checked by a performance criterion on this value.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="averagedImpactCount" type="positiveInteger">
                        <annotation>
                            <documentation>The number of hammer impacts averaged into the record of
                                this test, as reported by the test equipment - one value for the
                                test, not one per result. Averaging suppresses random noise, and
                                the count is the figure a requirement on the minimum number of
                                impacts is checked against.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="amplificationFunction"
                        type="diggs:AmplificationFunctionEnumExtType">
                        <annotation>
                            <documentation>
                                The shape of the gain applied to the record with time after the
                                impact to bring up the reflections weakened by damping: exponential,
                                linear or none. Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="amplificationFactor"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>The setting of the amplification as reported by the test
                                equipment, on the equipment's own scale (the "Amp" of a Piletest
                                record, the magnification factor of a PDI record). A number with no
                                unit of its own, comparable between records of one equipment and
                                one set of settings only.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="amplificationStart" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The depth below the pile head at which the amplification
                                begins to rise from unity.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="amplificationEnd" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The depth below the pile head at which the amplification
                                reaches its maximum - the end of the plotted record.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="recordReference" type="diggs:RecordReferenceEnumExtType">
                        <annotation>
                            <documentation>
                                What time zero of the evaluated record is referenced to:
                                initial_rise (the first rise of the impact pulse from the baseline)
                                or first_peak (the peak of the impact pulse). Depths read from the
                                record are measured from this time. Values come from the enumerated
                                list, or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="impactNormalized" type="boolean">
                        <annotation>
                            <documentation>True where the impact (the force or the pulse) is normalized in the displayed record, so that the height of the impact is not comparable between records.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterType" type="diggs:FilterTypeEnumExtType">
                        <annotation>
                            <documentation>
                                The kind of filter applied to the record: low_pass, high_pass,
                                band_pass or none. The frequency limit is filterCutoff. Values come
                                from the enumerated list, or "Other: xx", where xx is a user-defined
                                term whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="filterCutoff" type="diggs:FrequencyMeasureType">
                        <annotation>
                            <documentation>The cutoff frequency of the filter applied to the record,
                                as reported by the test equipment. For a band-pass filter, the upper
                                limit; a lower limit is stated in otherTestProperty. A filter setting
                                on the equipment's own scale, not a frequency, is stated in
                                otherTestProperty together with the filterType.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sharpeningApplied" type="boolean">
                        <annotation>
                            <documentation>True where a sharpening or similar enhancement was applied to the record to make reflections more distinct.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="samplingRate" type="diggs:FrequencyMeasureType">
                        <annotation>
                            <documentation>The rate at which the transducer signal was digitized.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sampleResolution" type="positiveInteger">
                        <annotation>
                            <documentation>The resolution of the analog-to-digital conversion, in bits.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="recordLength" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>The duration of the digitized record after the impact.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="headPreparation"
                        type="diggs:HeadPreparationEnumExtType">
                        <annotation>
                            <documentation>
                                How the head of the element was prepared before the test:
                                cut_and_ground (cut down to sound concrete and the test surface
                                ground smooth), cut (cut down to sound concrete, not ground), ground
                                (the test surface ground smooth without cutting) or none (tested on
                                the head as found). Values come from the enumerated list, or "Other:
                                xx", where xx is a user-defined term whose meaning differs from
                                every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sensorMounting" type="diggs:SensorMountingEnumExtType">
                        <annotation>
                            <documentation>
                                How the motion transducer was attached to the pile head: wax,
                                adhesive, clamp or hand_held. Values come from the enumerated list,
                                or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="sensorPositionCount" type="positiveInteger">
                        <annotation>
                            <documentation>The number of positions on the pile head at which the motion transducer was placed for this test.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="sensorOffset" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The distance of a transducer position from the centre of the pile head. One element for each position; positions at the same distance are stated once.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="impactOffset" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>The distance from the point of impact to the motion transducer.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" maxOccurs="unbounded" name="frequencyResponse"
                        type="diggs:ResultsPropertyType">
                        <annotation>
                            <documentation>A frequency-domain record of the test as a table: one row
                                per frequency, with columns such as the frequency and the mobility
                                (the velocity transform over the force transform). The columns,
                                their units and their order are declared by the table's parameters.
                                A record evaluated in more than one way carries one table for
                                each.</documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="evaluationSoftware" type="diggs:SoftwareApplicationPropertyType">
                        <annotation>
                            <documentation>The software, and its version, that was used to evaluate the record.</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="LowStrainTestMethodEnumType">
        <restriction base="string">
            <enumeration value="pulse_echo">
                <annotation>
                    <documentation>Pulse Echo Method: the velocity of the pile head, and optionally
                        the force, is evaluated as a function of time. The sonic echo method; the
                        reflection method of NF P94-160-2.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="transient_response">
                <annotation>
                    <documentation>Transient Response Method: the ratio of the velocity transform to
                        the force transform is evaluated as a function of frequency. Requires the
                        force to be measured. The impedance method of NF P94-160-4.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LowStrainTestMethodEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LowStrainTestMethodEnumType"/>
    </simpleType>
    <simpleType name="AmplificationFunctionEnumType">
        <restriction base="string">
            <enumeration value="exponential">
                <annotation>
                    <documentation>The gain rises exponentially with time after the
                        impact.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="linear">
                <annotation>
                    <documentation>The gain rises linearly with time after the
                        impact.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>No amplification is applied.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="AmplificationFunctionEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:AmplificationFunctionEnumType"/>
    </simpleType>
    <simpleType name="ReferenceLengthBasisEnumType">
        <restriction base="string">
            <enumeration value="as_cast">
                <annotation>
                    <documentation>The whole element as constructed, from the pile head to the toe.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="embedded">
                <annotation>
                    <documentation>The part of the element below the ground surface.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="below_sensor">
                <annotation>
                    <documentation>The part of the element from the sensor position down.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ReferenceLengthBasisEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ReferenceLengthBasisEnumType"/>
    </simpleType>
    <simpleType name="RecordReferenceEnumType">
        <restriction base="string">
            <enumeration value="initial_rise">
                <annotation>
                    <documentation>Time zero is the first rise of the impact pulse from the baseline.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="first_peak">
                <annotation>
                    <documentation>Time zero is the peak of the impact pulse.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="RecordReferenceEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:RecordReferenceEnumType"/>
    </simpleType>
    <simpleType name="FilterTypeEnumType">
        <restriction base="string">
            <enumeration value="low_pass">
                <annotation>
                    <documentation>Frequencies above the cutoff are attenuated.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="high_pass">
                <annotation>
                    <documentation>Frequencies below the cutoff are attenuated.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="band_pass">
                <annotation>
                    <documentation>Frequencies outside a band are attenuated.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>No filter is applied.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="FilterTypeEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:FilterTypeEnumType"/>
    </simpleType>
    <simpleType name="HeadPreparationEnumType">
        <restriction base="string">
            <enumeration value="cut_and_ground">
                <annotation>
                    <documentation>Cut down to sound concrete and the test surface ground smooth.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="cut">
                <annotation>
                    <documentation>Cut down to sound concrete; the test surface not ground.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="ground">
                <annotation>
                    <documentation>The test surface ground smooth without cutting.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="none">
                <annotation>
                    <documentation>Tested on the head as found, without preparation.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="HeadPreparationEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:HeadPreparationEnumType"/>
    </simpleType>
    <simpleType name="SensorMountingEnumType">
        <restriction base="string">
            <enumeration value="wax">
                <annotation>
                    <documentation>Fixed to the cleaned head with wax.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="adhesive">
                <annotation>
                    <documentation>Fixed to the cleaned head with an adhesive other than wax.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="clamp">
                <annotation>
                    <documentation>Held to the head by a clamp or bracket.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="hand_held">
                <annotation>
                    <documentation>Held against the head by hand.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="SensorMountingEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:SensorMountingEnumType"/>
    </simpleType>
    <element name="ThermalIntegrityProfiling" type="diggs:ThermalIntegrityProfilingType"
        abstract="false" substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A thermal integrity test on a completed cast-in-place concrete deep foundation
                element, per ASTM D7949, relating the heat of hydration generated by the curing
                concrete along the element to its as-built cross-section and continuity. It
                characterizes as-built shape (necking, bulging, cage eccentricity) from a heat
                signature captured once during curing, where diggs:LowStrainIntegrityTest
                characterizes discontinuity from a stress-wave reflection captured any time after
                curing. It substitutes diggs:AbstractInsituTestProcedure directly, not
                diggs:AbstractLoadTestProcedure, because no load is applied. The name keeps "Thermal
                Integrity Profiling" (commercially, TIP) although ASTM D7949 was withdrawn in 2023
                and reinstated in 2025 as D7949-25 under the broader title "Standard Test Methods
                for Integrity Testing of Concrete Deep Foundations by Thermal Methods"; cite ASTM
                D7949 as the governing standard whichever edition's title is quoted. The 2025
                edition has three methods, all in the enumeration of measurementMethod: Method A, a
                thermal probe lowered into access ducts in the element; Method B, multiple embedded
                thermal sensors (thermistors) attached to the reinforcing cage; Method C, an
                embedded fiber-optic cable attached to the cage, which gives effectively continuous
                coverage along the length. No European or ISO standard defines a competing method:
                EN 1536 (bored piles) and EN 1538 (diaphragm walls) accept thermal integrity testing
                without defining one, and European practice runs the ASTM D7949 methodology. Each
                physical sensor is its own Equipment/Sensor object under the inherited
                testProcedureEquipment, classified with equipmentClass.xml#thermal_integrity_probe
                (Method A), equipmentClass.xml#thermistor (Method B) or
                equipmentClass.xml#embedded_fiber_optic_cable (Method C); their count and position
                follow from how many are cited. The measured temperature profile and the interpreted
                effective-radius profile are results: give the temperature per depth on the
                ResultSet of Test/outcome with properties.xml#temperature, and the effective radius
                with properties.xml#effective_radius. A profile is one Test, because
                measurementMethod, cureTimeAtMeasurement and ambientTemperature are fixed for one
                pass along the element: one Test has a diggs:MultiPointLocation with every depth
                station and one ResultSet with a temperature and effective radius tuple per station,
                as for diggs:StaticConePenetrationTest and unlike a Standard Penetration Test, which
                is one Test per depth.
            </documentation>
        </annotation>
    </element>
    <complexType name="ThermalIntegrityProfilingType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="measurementMethod"
                        type="diggs:ThermalIntegrityProfilingMethodEnumExtType">
                        <annotation>
                            <documentation>
                                Which of the three methods of ASTM D7949 was used: thermal probe
                                (Method A), embedded thermal sensor (Method B) or embedded
                                fiber-optic cable (Method C). Values come from the enumerated list,
                                or "Other: xx", where xx is a user-defined term whose meaning
                                differs from every listed value (not a synonym of one).
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="cureTimeAtMeasurement" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The time elapsed since concrete placement when the reading was
                                taken. ASTM D7949 requires the measurement near the time of peak
                                temperature, which depends on element size and mix design; a reading
                                taken too early or too late understates the thermal contrast a
                                defect would produce.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="ambientTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType">
                        <annotation>
                            <documentation>
                                The ambient (air) temperature at the time of measurement: a single
                                environmental reading, not the measured concrete temperature
                                profile, which is a result.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="PumpingTestTimeSeriesPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:TemporalResult object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:TemporalResult" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <element name="WirelineLog" type="diggs:WirelineLogType"
        substitutionGroup="diggs:AbstractInsituTestProcedure">
        <annotation>
            <documentation>
                A wireline log procedure: a generic test structure for all forms of geophysical data
                collected by wireline methods.
            </documentation>
        </annotation>
    </element>
    <complexType name="WirelineLogType">
        <complexContent>
            <extension base="diggs:AbstractInsituTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="geophysicalFieldSurveyRef"
                        type="diggs:FeatureReferenceType">
                        <annotation>
                            <documentation>
                                The measurement that contains the results obtained during data
                                acquisition, which serve as input to the processing steps that
                                produce the results of this measurement. Given by reference only.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="runNumber" type="string">
                        <annotation>
                            <documentation>
                                The log run number. It should normally be a number, but some legacy
                                systems encode other information in this value.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="bhaRunNumber" type="positiveInteger">
                        <annotation>
                            <documentation>
                                The bottom hole assembly run number associated with this log.
                            </documentation>
                        </annotation>
                    </element>
                    <element maxOccurs="unbounded" minOccurs="0" name="logParameter"
                        type="diggs:ParameterPropertyType">
                        <annotation>
                            <documentation>
                                A parameter that applies to the overall log. Repeat for each
                                parameter.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateImpactValueTest" type="diggs:AggregateImpactValueTestProcedureType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate impact value test procedure. The aggregate impact value represents the
                resistance of aggregates to impact. Aggregate passing the 12.5 mm sieve and retained
                on the 10 mm sieve is placed in three layers in a steel cup on the base of the
                impact testing machine, each layer tamped with 25 blows. A metal hammer of 13.5 to
                14 kg falls freely 380 mm onto the specimen for 15 blows, the crushed aggregate is
                passed through the 2.36 mm sieve, and the impact value is the percentage of the
                sample mass that passes.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateImpactValueTestProcedureType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="particleDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The particle density of the size fraction between 8 mm and 12.5 mm.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="impactValue1" type="diggs:ForcePerForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The aggregate impact value from the first test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="impactValue2" type="diggs:ForcePerForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The aggregate impact value from the second test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="numberOfBlows" type="integer" minOccurs="0">
                        <annotation>
                            <documentation>
                                The number of blows applied to the specimen.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ChalkCrushingValueTest" type="diggs:ChalkCrushingValueTestProcedureType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A chalk crushing value test procedure. The chalk impact crushing test measures the
                rate at which a sample of chalk lumps crushes under impacts from a freefalling
                rammer. The chalk crushing value, with the saturation moisture content of the intact
                chalk lumps, classifies chalk by its behavior as freshly placed fill. The procedure
                is described for a single sample, but the normal procedure is to take the mean of
                six tests on representative samples.
            </documentation>
        </annotation>
    </element>
    <complexType name="ChalkCrushingValueTestProcedureType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="waterContent" type="diggs:ForcePerForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The water (moisture) content of the specimen tested.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="pctGreater10mm"
                        type="diggs:DimensionlessMeasureType">
                        <annotation>
                            <documentation>
                                The fraction of the original sample with particles larger than 10 mm
                                diameter, expressed as a dimensionless value (for example a
                                percentage).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FrostSusceptibilityTest" type="diggs:FrostSusceptibilityTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A frost susceptibility test procedure, which establishes the degree of frost
                susceptibility of unbound sub-base and base materials for pavements.
            </documentation>
        </annotation>
    </element>
    <complexType name="FrostSusceptibilityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="frostHeaveTrial" type="diggs:FrostHeaveTrialPropertyType"
                        minOccurs="0" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                The frost heave measurement for one trial specimen. Repeat for each
                                specimen.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FrostHeaveTrial" type="diggs:FrostHeaveTrialType">
        <annotation>
            <documentation>
                The frost heave measurement of one trial specimen.
            </documentation>
        </annotation>
    </element>
    <complexType name="FrostHeaveTrialType">
        <complexContent>
            <extension base="diggs:AbstractComponentObjectBaseType">
                <sequence>
                    <element minOccurs="0" ref="diggs:specimenRef"/>
                    <element name="frostHeave" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The frost heave of this specimen.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <complexType name="FrostHeaveTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:FrostHeaveTrial object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:FrostHeaveTrial"/>
        </sequence>
    </complexType>
    <element name="LabPenetrometerTest" type="diggs:PocketPenetrometerTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A laboratory penetrometer test procedure, which provides an estimate of undrained
                shear strength.
            </documentation>
        </annotation>
    </element>
    <element name="LabVelocityTest" type="diggs:LabVelocityTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A laboratory velocity test procedure. Shear wave velocity can be measured in the
                laboratory using resonant column tests, bender elements, ultrasonics, torsional
                shear tests and modified triaxial tests.
            </documentation>
        </annotation>
    </element>
    <complexType name="LabVelocityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="testType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of test used to produce the velocity measures. No
                                DIGGS-authored dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LinearShrinkageTest" type="diggs:LinearShrinkageTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A linear shrinkage test procedure. Linear shrinkage is the decrease in length of a
                soil sample when oven-dried, starting from the moisture content of the sample at the
                liquid limit.
            </documentation>
        </annotation>
    </element>
    <complexType name="LinearShrinkageTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="pct424" type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight percentage of the soil tested that passes the 0.425 mm
                                sieve.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="LosAngelesAbrasionTest" type="diggs:LosAngelesAbrasionTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A Los Angeles abrasion test procedure, which indicates the toughness and abrasion
                characteristics of aggregate. A coarse aggregate sample is subjected to abrasion,
                impact and grinding in a rotating steel drum containing a specified number of steel
                spheres. The mass retained on a specified sieve is subtracted from the original mass
                to give the percentage of the total that has broken down and passed through; an L.A.
                abrasion loss of 40 means that 40 % of the original sample passed.
            </documentation>
        </annotation>
    </element>
    <complexType name="LosAngelesAbrasionTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="chargeDescription" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                A description of the ball load, or charge grading.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="MCVTest" type="diggs:MCVTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A moisture condition value (MCV) test procedure. The MCV, determined from a moisture
                condition test, indicates how much compactive effort is needed to compact a soil
                sample at a particular moisture content. A captive weight is dropped a known
                distance onto a sample in a cylindrical mould and the compaction is measured;
                counting the blows needed for the required compaction gives the MCV of the soil at
                that moisture content.
            </documentation>
        </annotation>
    </element>
    <complexType name="MCVTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="typeStabilizer" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of stabilizer used. No DIGGS-authored dictionary currently
                                exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="amtStabilizer" type="diggs:VolumeMeasureType">
                        <annotation>
                            <documentation>
                                The amount of stabilizer added.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="trial" type="diggs:MCVTestTrialPropertyType" minOccurs="0"
                        maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A trial of the test. Repeat for each trial.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="MCVTestTrial" type="diggs:MCVTestTrialType" abstract="false">
        <annotation>
            <documentation>
                The results of one trial of an MCV test.
            </documentation>
        </annotation>
    </element>
    <complexType name="MCVTestTrialPropertyType">
        <annotation>
            <documentation>
                Property type that contains one diggs:MCVTestTrial object inline.
            </documentation>
        </annotation>
        <sequence>
            <element ref="diggs:MCVTestTrial" minOccurs="1" maxOccurs="1"/>
        </sequence>
    </complexType>
    <complexType name="MCVTestTrialType">
        <complexContent>
            <extension base="diggs:AbstractObjectType">
                <sequence>
                    <element name="trialNo" type="positiveInteger" minOccurs="0">
                        <annotation>
                            <documentation>
                                The number of the test cycle.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterContent" type="diggs:ForcePerForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture content of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="interpretationMethod" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The method of interpretation of the test curve. No DIGGS-authored
                                dictionary currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="bulkDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The bulk density measured after the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="mcv" type="double" minOccurs="0">
                        <annotation>
                            <documentation>
                                The measured MCV.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="difference" type="diggs:LengthMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The difference between the initial (n) and final (3n) blows in the
                                rapid assessment test.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="strongerWeaker" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                Whether the material is stronger or weaker than the pre-calibrated
                                standard.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="MaterialGradationTest" type="diggs:MaterialGradationTestType" abstract="false"
        substitutionGroup="diggs:AbstractMaterialTestProcedure">
        <annotation>
            <documentation>
                A particle size (gradation) test procedure on the coarse fraction (greater than silt
                size) of a material sample, primarily used to record the gradation of a grout mix
                aggregate.
            </documentation>
        </annotation>
    </element>
    <complexType name="MaterialGradationTestType">
        <complexContent>
            <extension base="diggs:AbstractMaterialTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="sieveAnalysis"
                        type="diggs:SieveAnalysisPropertyType" maxOccurs="unbounded">
                        <annotation>
                            <documentation>
                                A sieve analysis of the material. Repeat for each analysis.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="MicroDevalTest" type="diggs:MicroDevalTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A Micro-Deval test procedure, an aggregate abrasion test in which the sample
                aggregate is rotated at 100 rpm for a specific time in a Micro-Deval apparatus.
            </documentation>
        </annotation>
    </element>
    <complexType name="MicroDevalTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="testType" type="string" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of test: wet or dry.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coeffSpecimenOne" type="double">
                        <annotation>
                            <documentation>
                                The Micro-Deval coefficient determined for the first specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="coeffSpecimenTwo" type="double">
                        <annotation>
                            <documentation>
                                The Micro-Deval coefficient determined for the second specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="dateControlPolishedStone"
                        type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The date of the control polished stone.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="PointLoadTest" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure" type="diggs:PointLoadTestType">
        <annotation>
            <documentation>
                A point load test procedure, which produces the point load test index (Is50) that
                can be correlated with the uniaxial compressive strength (UCS) of rock.
            </documentation>
        </annotation>
    </element>
    <complexType name="PointLoadTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="type" type="diggs:PointLoadTestEnumExtType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of point load test, axial or diametral. Values come from
                                the enumerated list, or "Other: xx", where xx is a user-defined term
                                whose meaning differs from every listed value (not a synonym of
                                one).
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="PointLoadTestEnumType">
        <restriction base="string">
            <enumeration value="axial">
                <annotation>
                    <documentation>
                        The load is applied along the axis of the specimen.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="diametral">
                <annotation>
                    <documentation>
                        The load is applied across the diameter of the specimen.
                    </documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="PointLoadTestEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:PointLoadTestEnumType"/>
    </simpleType>
    <element name="RelativeDensityTest" type="diggs:RelativeDensityTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A relative density test procedure. Relative density is the ratio, as a percentage,
                of the difference between the maximum index void ratio and the field void ratio of a
                cohesionless, free-draining soil to the difference between its maximum and minimum
                index void ratios.
            </documentation>
        </annotation>
    </element>
    <complexType name="RelativeDensityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="maxDryDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The maximum dry density.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="minDryDensity" type="diggs:DensityOrUnitWeightMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The minimum dry density.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wtPct2" type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight percentage of the sample retained on the 2 mm sieve.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wtPct6.3" type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight percentage of the sample retained on the 6.3 mm sieve.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="wtPct37.5" type="diggs:ForcePerForceMeasureType">
                        <annotation>
                            <documentation>
                                The weight percentage of the sample retained on the 37.5 mm sieve.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="RockPorosityDensityTest" type="diggs:RockPorosityDensityTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A rock porosity and density test procedure, which determines the porosity and
                density of rock.
            </documentation>
        </annotation>
    </element>
    <complexType name="RockPorosityDensityTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="testType" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The type of test. No DIGGS-authored dictionary currently exists for
                                this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="waterContent" type="diggs:ForcePerForceMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The moisture content of the specimen.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="dryingTemperature"
                        type="diggs:ThermodynamicTemperatureMeasureType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The drying temperature used for the water content determination.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="initialSaturation" type="diggs:ForcePerForceMeasureType"
                        minOccurs="0">
                        <annotation>
                            <documentation>
                                The initial degree of saturation.
                            </documentation>
                        </annotation>
                    </element>
                    <choice minOccurs="0">
                        <element name="initiaParticleDensity" type="diggs:DensityOrUnitWeightMeasureType">
                            <annotation>
                                <appinfo>
                                    <diggs:deprecated since="3.1.0" replacedBy="diggs:initialParticleDensity"/>
                                </appinfo>
                                <documentation>
                                    DEPRECATED. Use initialParticleDensity; this name is a
                                    misspelling of it. The initial apparent particle density.
                                </documentation>
                            </annotation>
                        </element>
                        <element name="initialParticleDensity" type="diggs:DensityOrUnitWeightMeasureType">
                            <annotation>
                                <documentation>
                                    The initial apparent particle density. Use this element, not the
                                    deprecated initiaParticleDensity.
                                </documentation>
                            </annotation>
                        </element>
                    </choice>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SchmidtReboundHardnessTest" type="diggs:SchmidtReboundHardnessTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A Schmidt rebound hardness test procedure. A hammer mass is launched against an
                impact plunger, and the amount of rebound, which depends on the hardness of the test
                piece, is shown on a scale of 10 to 100.
            </documentation>
        </annotation>
    </element>
    <complexType name="SchmidtReboundHardnessTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="hammerOrientation" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The orientation of the hammer axis in the test from horizontal,
                                positive downward and negative upward. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="clampingMethod" type="gml:CodeType" minOccurs="0">
                        <annotation>
                            <documentation>
                                The method of clamping the specimen. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="ShoreScleroscopeHardnessTest" type="diggs:ShoreScleroscopeHardnessTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A Shore scleroscope hardness test procedure. A diamond-tipped hammer falls under its
                own weight from a fixed height inside a glass tube onto the test specimen, and the
                height of its rebound is read on a graduated scale of Shore units. The scale is
                divided into 100 parts, which represent the average rebound from pure hardened
                high-carbon steel, and continues above 100 for harder metals.
            </documentation>
        </annotation>
    </element>
    <complexType name="ShoreScleroscopeHardnessTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="hammerDropHeight" type="diggs:LengthMeasureType">
                        <annotation>
                            <documentation>
                                The height from which the hammer drops.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="SuctionTest" type="diggs:SuctionTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A soil suction test procedure. Soil suction measures the free energy of the pore
                water in a soil: in practical terms, the affinity of the soil to retain water. It
                gives information on soil parameters influenced by the soil water, such as volume
                change, deformation and strength.
            </documentation>
        </annotation>
    </element>
    <complexType name="SuctionTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="TensileStrengthTest" substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:TensileStrengthType">
        <annotation>
            <documentation>
                A tensile strength test procedure, for example the Brazil test.
            </documentation>
        </annotation>
    </element>
    <complexType name="TensileStrengthType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element minOccurs="0" name="type" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The type of tensile stress test conducted, for example a Brazil
                                test. No DIGGS-authored dictionary currently exists for this
                                element.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="testDuration" type="diggs:TimeMeasureType">
                        <annotation>
                            <documentation>
                                The duration of the test.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="stressRate" type="diggs:PressurePerTimeMeasureType">
                        <annotation>
                            <documentation>
                                The rate at which stress was applied.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="modeOfFailure" type="gml:CodeType">
                        <annotation>
                            <documentation>
                                The mode of failure of the specimen. No DIGGS-authored dictionary
                                currently exists for this element.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateAbrasionValueTest" type="diggs:AggregateAbrasionValueTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate abrasion value (AAV) test procedure, a measure of the resistance of
                aggregate to surface wear by abrasion. Two specimens are pressed, with a force of
                0.365 newtons per square centimeter, against the surface of a steel disc rotating in
                a horizontal plane, with sand fed by hoppers as the abrasive. After 500 disc
                revolutions the abrasion is measured as the mass loss of the aggregate. The
                percentage loss in mass of the chippings is the AAV, which ranges from about 1 for
                hard flints to over 16 for aggregates normally considered too soft for use in road
                surfacings.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateAbrasionValueTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateCrushingValueTest" type="diggs:AggregateCrushingValueTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate crushing value test procedure, a relative measure of the resistance of
                an aggregate to crushing under a gradually applied compressive load: the mass of
                fines passing the specified sieve as a percentage of the total sample mass.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateCrushingValueTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType"> </extension>
        </complexContent>
    </complexType>
    <element name="AggregateElongationIndexTest" type="diggs:LaboratoryTestProcedureType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate elongation index test procedure. The elongation index is the percentage
                by weight of particles whose greatest dimension (length) is 1.8 times their mean
                dimension. It applies to aggregates larger than 6.3 mm.
            </documentation>
        </annotation>
    </element>
    <element name="AggregateFlakinessIndexTest" type="diggs:LaboratoryTestProcedureType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate flakiness index test procedure. The flakiness index is the percentage
                by weight of aggregate particles whose least dimension is less than 0.6 times their
                mean size.
            </documentation>
        </annotation>
    </element>
    <element name="AggregatePolishedStoneValueTest" type="diggs:AggregatePolishedStoneValueTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A polished stone value test procedure, a measure of the resistance of an aggregate
                to polishing. The aggregate is subjected to a standard polishing process and then
                tested with the Portable Skid Resistance Tester.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregatePolishedStoneValueTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateWaterAbsorptionTest" type="diggs:AggregateWaterAbsorptionTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate water absorption test procedure, which gives an idea of the strength of
                aggregate: aggregates that absorb more water are more porous and are generally
                considered unsuitable unless they prove acceptable in strength, impact and hardness
                tests.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateWaterAbsorptionTestType">
        <complexContent>
            <extension base="diggs:LaboratoryTestProcedureType"> </extension>
        </complexContent>
    </complexType>
    <element name="AggregateTenPercentFinesTest" type="diggs:AggregateTenPercentFinesTestType"
        abstract="false" substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                A ten percent fines test procedure, which produces the Ten Percent Fines Value
                (TPFV) of an aggregate.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateTenPercentFinesTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence>
                    <element name="value1" type="integer" minOccurs="0">
                        <annotation>
                            <documentation>
                                The first TPFV measurement.
                            </documentation>
                        </annotation>
                    </element>
                    <element name="value2" type="integer" minOccurs="0">
                        <annotation>
                            <documentation>
                                The second TPFV measurement.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="AggregateSoundnessTest" type="diggs:AggregateSoundnessTestType" abstract="false"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure">
        <annotation>
            <documentation>
                An aggregate soundness test procedure, which studies the resistance of aggregates to
                weathering by accelerated weathering cycles. Porous aggregates subjected to freezing
                and thawing are likely to disintegrate prematurely, so the aggregate is subjected to
                cycles of alternate wetting in a saturated solution of sodium sulphate or magnesium
                sulphate for 16 to 18 hours and drying in an oven to constant weight. After five
                cycles the loss in weight is determined by sieving out all undersized particles and
                weighing.
            </documentation>
        </annotation>
    </element>
    <complexType name="AggregateSoundnessTestType">
        <complexContent>
            <extension base="diggs:LaboratoryTestProcedureType"> </extension>
        </complexContent>
    </complexType>
    <element abstract="false" name="EnvironmentalScreeningTest"
        substitutionGroup="diggs:AbstractLaboratoryTestProcedure"
        type="diggs:EnvironmentalScreeningTestType">
        <annotation>
            <documentation>
                A procedure for any type of field environmental screening test, such as photo
                ionization or flame ionization tests for gas screening, or XRF testing for metals.
                No specific properties are defined; give the metadata in otherTestProperty.
            </documentation>
        </annotation>
    </element>
    <complexType name="EnvironmentalScreeningTestType">
        <complexContent>
            <extension base="diggs:AbstractLaboratoryTestProcedureType">
                <sequence/>
            </extension>
        </complexContent>
    </complexType>
    <element name="FluidSpecimen" type="diggs:FluidSpecimenType"
        substitutionGroup="diggs:AbstractSpecimen">
        <annotation>
            <documentation>
                A specimen that describes the physical conditions of a fluid sample or samples
                subjected to testing.
            </documentation>
        </annotation>
    </element>
    <complexType name="FluidSpecimenType">
        <complexContent>
            <extension base="diggs:AbstractSpecimenType">
                <sequence>
                    <element minOccurs="0" name="dilutionFactor" type="double">
                        <annotation>
                            <documentation>
                                For fluid samples that must be diluted before testing, the unitless
                                ratio of the total specimen volume to the solute (original sample)
                                volume.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="leachatePreparationDateTime"
                        type="gml:TimePositionType">
                        <annotation>
                            <documentation>
                                The time when a leachate was prepared.
                            </documentation>
                        </annotation>
                    </element>
                    <element minOccurs="0" name="leachatePreparationMethod"
                        type="diggs:SpecificationPropertyType">
                        <annotation>
                            <documentation>
                                The Specification that defines the method of leachate preparation.
                            </documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <simpleType name="RapidLoadTestCategoryEnumType">
        <restriction base="string">
            <enumeration value="investigation test">
                <annotation>
                    <documentation>A sacrificial test element loaded to ultimate limit state to assess its
                        resistance. EN ISO 22477-10.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="control test">
                <annotation>
                    <documentation>A working (non-sacrificial) test element loaded to a specified load in
                        excess of its serviceability limit state, to confirm it behaves as designed.
                        EN ISO 22477-10.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="RapidLoadTestCategoryEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:RapidLoadTestCategoryEnumType"/>
    </simpleType>
    <simpleType name="PlateBearingTestStiffnessEnumType">
        <restriction base="string">
            <enumeration value="rigid">
                <annotation>
                    <documentation>The plate is stiff enough, relative to the ground or platform it bears on,
                        that it distributes load essentially uniformly and does not itself deflect
                        appreciably under test load. The standard steel plate used in ASTM
                        D1195/D1196 and DIN 18134.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="flexible">
                <annotation>
                    <documentation>The plate deflects appreciably under test load, so the bearing pressure it
                        transmits is not uniform across its area.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="PlateBearingTestStiffnessEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:PlateBearingTestStiffnessEnumType"/>
    </simpleType>
    <simpleType name="PlateBearingTestProcedureEnumType">
        <restriction base="string">
            <enumeration value="nonrepetitive">
                <annotation>
                    <documentation>A single load application, in increments, to the maximum test load, without
                        unload/reload cycling. ASTM D1196.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="repetitive">
                <annotation>
                    <documentation>The load applied and removed through repeated cycles to progressively higher
                        levels, used for airport and highway pavement component design. ASTM D1195.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="two cycle">
                <annotation>
                    <documentation>Exactly two load cycles to a prescribed maximum stress, each in not less
                        than six approximately equal stages, reporting a deformation modulus from
                        each cycle (Ev1 from the first, Ev2 from the second) whose ratio indicates
                        the degree of compaction. DIN 18134.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="PlateBearingTestProcedureEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:PlateBearingTestProcedureEnumType"/>
    </simpleType>
    <simpleType name="ThermalIntegrityProfilingMethodEnumType">
        <restriction base="string">
            <enumeration value="thermal probe">
                <annotation>
                    <documentation>Temperature is measured by lowering a thermal probe into access ducts
                        (tubes) installed in the element during construction, taking readings at
                        intervals along the length. ASTM D7949 Method A.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="embedded thermal sensor">
                <annotation>
                    <documentation>Temperature is measured by multiple thermistors attached to the reinforcing
                        cage at several locations around its perimeter and at intervals along its
                        length, cast into the concrete and read out after placement. ASTM D7949
                        Method B.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="embedded fiber optic">
                <annotation>
                    <documentation>Temperature is measured by fiber-optic cable attached to the reinforcing
                        cage and cast into the concrete, giving effectively continuous coverage
                        along the length rather than discrete sensor stations. ASTM D7949 Method C,
                        added in the standard's 2025 reinstatement.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ThermalIntegrityProfilingMethodEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ThermalIntegrityProfilingMethodEnumType"/>
    </simpleType>
    <simpleType name="RapidLoadTestAnalysisMethodEnumType">
        <restriction base="string">
            <enumeration value="unloading point method">
                <annotation>
                    <documentation>Derives an equivalent static load-displacement curve from the measured
                        force-pulse and displacement data by removing velocity-dependent (damping)
                        resistance at the point of maximum displacement, where velocity is
                        momentarily zero. The standard interpretation method for rapid load test
                        data.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="modified unloading point method">
                <annotation>
                    <documentation>A refinement of the Unloading Point Method that additionally accounts for
                        the unloading stiffness of the ground, improving the derived static
                        resistance where the basic method under- or over-predicts it.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="RapidLoadTestAnalysisMethodEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:RapidLoadTestAnalysisMethodEnumType"/>
    </simpleType>
    <simpleType name="LoadTestIncrementPhaseEnumType">
        <restriction base="string">
            <enumeration value="loading">
                <annotation>
                    <documentation>The load is being increased at this increment.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="unloading">
                <annotation>
                    <documentation>The load is being decreased at this increment - e.g. between cycles of a
                        cyclic loading procedure, or during final unloading at the end of the test.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="reload">
                <annotation>
                    <documentation>The load is being reapplied at this increment following an unloading stage
                        within a cyclic loading procedure.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="seating">
                <annotation>
                    <documentation>The increment belongs to the seating or pre-loading cycle applied before the
                        test proper - the seating load being applied or, afterwards, released - and
                        its settlement is not part of the loading curve.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="LoadTestIncrementPhaseEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:LoadTestIncrementPhaseEnumType"/>
    </simpleType>
    <simpleType name="ArrayTypeEnumType">
        <restriction base="string">
            <enumeration value="wenner">
                <annotation>
                    <documentation>
                        Four electrodes in a line at equal separation "a": the outer pair injects
                        current and the inner pair measures potential. Structured through
                        diggs:ResistivityReadingType/electrodeSpacing.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="schlumberger">
                <annotation>
                    <documentation>
                        A closely spaced potential electrode pair at the center of a more widely
                        spaced current electrode pair, the spacing of which increases progressively
                        in a sounding. Structured through
                        diggs:ResistivityReadingType/currentElectrodeSeparation and
                        potentialElectrodeSeparation.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="dipole dipole">
                <annotation>
                    <documentation>
                        A current dipole and a potential dipole of equal length, offset from each
                        other by a multiple (n) of that length, both moved together as the array is
                        stepped. Structured through diggs:ResistivityReadingType/dipoleLength and
                        nFactor.
                    </documentation>
                </annotation>
            </enumeration>
            <enumeration value="pole dipole">
                <annotation>
                    <documentation>One current electrode and a potential dipole, the second current electrode
                        being placed far enough away to be treated as at infinity; the dipole is
                        separated from the current pole by a multiple of the dipole length.</documentation>
                </annotation>
            </enumeration>
            <enumeration value="gradient">
                <annotation>
                    <documentation>Two current electrodes at a fixed wide spacing, with a potential dipole
                        moved between them.</documentation>
                </annotation>
            </enumeration>
        </restriction>
    </simpleType>
    <simpleType name="ArrayTypeEnumExtType">
        <union memberTypes="diggs:OtherNameType diggs:ArrayTypeEnumType"/>
    </simpleType>
</schema>
