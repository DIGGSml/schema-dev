                            <documentation>Frost heave measurement for each trial specimen</documentation>
                        </annotation>
                    </element>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
    <element name="FrostHeaveTrial" type="diggs:FrostHeaveTrialType">
        <annotation>
            <documentation>The frost heave trial property.</documentation>
        </annotation>
    </element>
    <complexType name="FrostHeaveTrialType">
