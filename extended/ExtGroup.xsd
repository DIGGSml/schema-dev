<?xml version="1.0" encoding="utf-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:diggs="http://diggsml.org/schemas/3"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:maxVersion="1.1" vc:minVersion="1.0"
    elementFormDefault="qualified" targetNamespace="http://diggsml.org/schemas/3" version="3.1.0">


    <element name="GroupGroup" substitutionGroup="diggs:AbstractGroup" type="diggs:GroupGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="diggs:groupGroupRef on each member group (diggs:AbstractProjectScopedGroupType)"/>
            </appinfo>
            <documentation>DEPRECATED. Use groupGroupRef on each member group. A feature containing
                references to a group of groups.</documentation>
        </annotation>
    </element>
    <complexType name="GroupGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0" note="diggs:groupGroupRef on each member group"/>
            </appinfo>
            <documentation>DEPRECATED. Use groupGroupRef on each member group. Type of
                diggs:GroupGroup.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" minOccurs="1" ref="diggs:groupRef" />
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="ProjectGroup" substitutionGroup="diggs:AbstractGroup" type="diggs:ProjectGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a concrete group substituting diggs:AbstractProjectGroup, whose member projects cite it through diggs:projectGroupRef"/>
            </appinfo>
            <documentation>DEPRECATED. Use a concrete group substituting diggs:AbstractProjectGroup,
                whose member projects cite it through projectGroupRef. A feature defining a related
                group of projects.</documentation>
        </annotation>
    </element>
    <complexType name="ProjectGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a type deriving from diggs:AbstractProjectGroupType"/>
            </appinfo>
            <documentation>DEPRECATED. Use a type deriving from diggs:AbstractProjectGroupType. Type
                of diggs:ProjectGroup.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" minOccurs="1" ref="diggs:projectRef" />
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="groupRef" type="diggs:FeatureReferenceType">
        <annotation>
            <appinfo source="urn:x-gml:targetElement">diggs:AbstractGroup</appinfo>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="diggs:groupGroupRef on each member group; it points from the member to the group, so it is not a rename of this element"/>
            </appinfo>
            <documentation>DEPRECATED. Use groupGroupRef on each member group. It points the other
                way, from the member up to the group, so it is not a rename of this element. A
                reference from a group to one of its member groups.</documentation>
            <documentation>A property element that supports a value by reference only. The target
                value is indicated in the appinfo element.</documentation>
        </annotation>
    </element>
    <element name="MeasurementGroup" substitutionGroup="diggs:AbstractGroup" type="diggs:SampleGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a concrete group substituting diggs:AbstractMeasurementGroup, whose member measurements cite it through diggs:measurementGroupRef"/>
            </appinfo>
            <documentation>DEPRECATED. Use a concrete group substituting
                diggs:AbstractMeasurementGroup, whose member measurements cite it through
                measurementGroupRef. A feature that references a group of
                measurements.</documentation>
        </annotation>
    </element>
    <complexType name="MeasurementGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a type deriving from diggs:AbstractSampleGroupType"/>
            </appinfo>
            <documentation>DEPRECATED. Use a type deriving from diggs:AbstractSampleGroupType. A
                group type holding sample references; no element is declared with
                it.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" minOccurs="1" ref="diggs:sampleRef" />
                </choice>
            </extension>
        </complexContent>
    </complexType>
    <element name="SampleGroup" substitutionGroup="diggs:AbstractGroup" type="diggs:SampleGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a concrete group substituting diggs:AbstractSampleGroup, whose member samples cite it through diggs:sampleGroupRef"/>
            </appinfo>
            <documentation>DEPRECATED. Use a concrete group substituting diggs:AbstractSampleGroup,
                whose member samples cite it through sampleGroupRef. A feature intended to group
                samples; its type holds measurement references, not sample
                references.</documentation>
        </annotation>
    </element>
    <complexType name="SampleGroupType">
        <annotation>
            <appinfo>
                <diggs:deprecated since="3.1.0"
                    note="a type deriving from diggs:AbstractSampleGroupType or diggs:AbstractMeasurementGroupType"/>
            </appinfo>
            <documentation>DEPRECATED. Use a type deriving from diggs:AbstractSampleGroupType or
                diggs:AbstractMeasurementGroupType. A group type holding measurement references,
                despite its name.</documentation>
        </annotation>
        <complexContent>
            <extension base="diggs:AbstractGroupType">
                <choice>
                    <element maxOccurs="unbounded" minOccurs="1" ref="diggs:measurementRef" />
                </choice>
            </extension>
        </complexContent>
    </complexType>
</schema>